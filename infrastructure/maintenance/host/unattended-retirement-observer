#!/usr/bin/python3
"""Read-only Debian unattended-upgrade retirement observer."""

import base64
import datetime as dt
import hashlib
import json
import os
import stat
import subprocess
import sys

ENV = {"LC_ALL": "C", "LANG": "C", "PATH": "/usr/sbin:/usr/bin:/sbin:/bin"}
MAX_BYTES = 1024 * 1024
UNITS = ("apt-daily.timer", "apt-daily-upgrade.timer", "unattended-upgrades.service")
LOCK_PATHS = {"/var/lib/dpkg/lock", "/var/lib/dpkg/lock-frontend", "/var/lib/apt/lists/lock", "/var/cache/apt/archives/lock"}


def compact(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()


def run(arguments, accepted=(0,), timeout=30):
    result = subprocess.run(arguments, stdin=subprocess.DEVNULL, capture_output=True, env=ENV, timeout=timeout)
    if result.returncode not in accepted or result.stderr or len(result.stdout) > MAX_BYTES:
        raise RuntimeError("retirement observation command failed")
    return result.stdout


def file_record(path):
    try:
        before = os.lstat(path)
    except FileNotFoundError:
        return {"exists": False, "path": path}
    if (not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 or before.st_size > MAX_BYTES or
            before.st_uid != 0 or before.st_gid != 0 or stat.S_IMODE(before.st_mode) & 0o022):
        return {"exists": True, "path": path, "safe": False}
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        after = os.fstat(descriptor)
        if (before.st_dev, before.st_ino, before.st_mode, before.st_size) != (after.st_dev, after.st_ino, after.st_mode, after.st_size):
            raise RuntimeError("retirement file changed during read")
        raw = os.read(descriptor, MAX_BYTES + 1)
        if len(raw) != after.st_size:
            raise RuntimeError("retirement file read differs")
    finally:
        os.close(descriptor)
    return {"content_base64": base64.b64encode(raw).decode(), "exists": True, "gid": after.st_gid,
            "mode": f"{stat.S_IMODE(after.st_mode):04o}", "path": path, "safe": True,
            "sha256": hashlib.sha256(raw).hexdigest(), "size": after.st_size, "uid": after.st_uid}


def observe():
    units = []
    for unit in UNITS:
        raw = run(("/usr/bin/systemctl", "show", unit, "--property=LoadState", "--property=ActiveState", "--property=UnitFileState"))
        values = dict(line.decode().split("=", 1) for line in raw.splitlines() if b"=" in line)
        units.append({"active_state": values.get("ActiveState", "unknown"), "load_state": values.get("LoadState", "unknown"),
                      "name": unit, "unit_file_state": values.get("UnitFileState", "unknown")})
    ps = run(("/bin/ps", "-eo", "pid=,comm=,args="))
    processes = []
    names = {"apt", "apt-get", "dpkg", "unattended-upgrade", "unattended-upgrades"}
    for line in ps.decode("utf-8", "strict").splitlines():
        fields = line.strip().split(None, 2)
        if len(fields) >= 2 and fields[1] in names:
            processes.append({"command": fields[1], "pid": int(fields[0])})
    locks_raw = run(("/usr/bin/lslocks", "--json", "--output", "PATH,PID,COMMAND"))
    locks = []
    for record in json.loads(locks_raw).get("locks", []):
        normalized = {str(key).lower(): value for key, value in record.items()}
        if normalized.get("path") in LOCK_PATHS:
            locks.append({"command": normalized.get("command"), "path": normalized["path"], "pid": normalized.get("pid")})
    material = {"files": [file_record("/etc/apt/apt.conf.d/20auto-upgrades"),
                           file_record("/etc/apt/apt.conf.d/52home-lab-unattended-upgrades")],
                "locks": sorted(locks, key=lambda item: item["path"]), "processes": sorted(processes, key=lambda item: item["pid"]),
                "units": units}
    now = dt.datetime.now(dt.timezone.utc).replace(microsecond=0)
    return {"format": "home-lab-unattended-retirement-observation-v1", "version": 1,
            "host": "debian", "observed_at": now.isoformat().replace("+00:00", "Z"), **material,
            "observation_sha256": hashlib.sha256(compact(material)).hexdigest()}


def main():
    if sys.argv != [sys.argv[0], "observe"]:
        raise SystemExit("usage: unattended-retirement-observer observe")
    os.write(1, compact(observe()) + b"\n")


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        os.write(2, f"unattended-retirement-observer: {error}\n".encode())
        raise SystemExit(1)
