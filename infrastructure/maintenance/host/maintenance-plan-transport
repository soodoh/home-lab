#!/usr/bin/python3 -I
"""Login shell for one fixed reporting-only capability, never a general shell."""

import os
import pwd
import re
import sys

OBSERVER = "/usr/local/libexec/home-lab/maintenance-read-only-observer"
ENV = {"LC_ALL": "C", "LANG": "C", "PATH": "/usr/sbin:/usr/bin:/sbin:/bin"}


def arguments(argv, original_command):
    if len(argv) != 2 or argv[0] != "-c" or original_command:
        raise ValueError("fixed command required")
    match = re.fullmatch(r"observe ([0-9a-f]{64}) ([0-9a-f]{40}) ([0-9a-f]{64})", argv[1])
    if match is None:
        raise ValueError("fixed command required")
    return ["/usr/bin/sudo", "-n", "--", OBSERVER, "observe", *match.groups()]


def main():
    argv = arguments(sys.argv[1:], os.environ.get("SSH_ORIGINAL_COMMAND", ""))
    if pwd.getpwuid(os.getuid()).pw_name != "ansible-maintenance-plan":
        raise ValueError("dedicated reporting identity required")
    descriptor = os.open("/dev/null", os.O_RDONLY)
    try:
        os.dup2(descriptor, 0)
    finally:
        if descriptor != 0:
            os.close(descriptor)
    os.execve(argv[0], argv, ENV)


if __name__ == "__main__":
    try:
        main()
    except Exception:
        os.write(2, b"maintenance-plan-transport: fixed reporting command required\n")
        raise SystemExit(64)
