#!/usr/bin/python3
"""Execute one exact reviewed Debian package lock without replanning or rebooting."""

import datetime as dt
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys

INBOX = Path("/home/ansible-package-apply/.home-lab-plan-inbox")
PLAN_ROOT = Path("/var/lib/home-lab/debian-package/plans")
JOURNAL_ROOT = Path("/var/lib/home-lab/debian-package/journals")
LOCK = Path("/run/lock/home-lab-debian-package.lock")
OBSERVER = Path("/usr/local/libexec/home-lab/package-candidate-observer")
HEX64 = re.compile(r"^[0-9a-f]{64}$")
MAX_BYTES = 262144
ENV = {"DEBIAN_FRONTEND": "noninteractive", "LC_ALL": "C", "LANG": "C", "PATH": "/usr/sbin:/usr/bin:/sbin:/bin"}


def canonical(value):
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def read_file(path, owner, mode, group=None):
    expected_group = owner if group is None else group
    before = os.lstat(path)
    if (not stat.S_ISREG(before.st_mode) or before.st_uid != owner or before.st_gid != expected_group or
            stat.S_IMODE(before.st_mode) != mode or before.st_nlink != 1 or before.st_size > MAX_BYTES):
        raise RuntimeError("package artifact metadata differs")
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        after = os.fstat(descriptor)
        if (before.st_dev, before.st_ino, before.st_mode, before.st_size) != (after.st_dev, after.st_ino, after.st_mode, after.st_size):
            raise RuntimeError("package artifact changed during read")
        raw = os.read(descriptor, MAX_BYTES + 1)
    finally:
        os.close(descriptor)
    value = json.loads(raw)
    if canonical(value) != raw:
        raise RuntimeError("package artifact is not canonical")
    return value, raw


def validate_plan(value, raw, transport_sha, now):
    if sha(raw) != transport_sha:
        raise RuntimeError("package transport hash differs")
    if set(value) != {"format", "version", "host", "lifecycle", "base_commit", "generated_at", "expires_at", "lane",
                      "automatic_apply", "automatic_reboot", "actionable", "authorized", "bindings", "transaction",
                      "blockers", "final_sha256"}:
        raise RuntimeError("package final fields differ")
    material = dict(value); material.pop("final_sha256")
    if value["final_sha256"] != sha(canonical(material)):
        raise RuntimeError("package final hash differs")
    if (value["format"] != "home-lab-package-transaction-final-v1" or value["version"] != 1 or
            value["host"] != "debian" or value["lifecycle"] != "production" or
            value["automatic_apply"] is not False or value["automatic_reboot"] is not False or
            value["actionable"] is not True or value["authorized"] is not False or
            value["blockers"] != ["separate-exact-authorization-required"] or
            value["lane"] not in {"no-restart-safe", "maintenance-window"}):
        raise RuntimeError("package plan authority differs")
    created = dt.datetime.fromisoformat(value["generated_at"].replace("Z", "+00:00"))
    expires = dt.datetime.fromisoformat(value["expires_at"].replace("Z", "+00:00"))
    if created > now or now > expires or expires <= created or (expires - created).total_seconds() > 86400:
        raise RuntimeError("package plan is stale or future-dated")
    bindings = value["bindings"]
    binding_names = {"candidate_transaction_sha256", "review_sha256", "changes_sha256", "contract_sha256",
                     "inventory_sha256", "host_key_fingerprint", "installed_package_set_sha256",
                     "apt_sources_sha256", "apt_keyrings_sha256", "apt_configuration_sha256", "proposal_sha256"}
    if set(bindings) != binding_names or any(HEX64.fullmatch(bindings[name]) is None for name in binding_names - {"host_key_fingerprint"}) or not re.fullmatch(r"SHA256:[A-Za-z0-9+/]{43}", bindings["host_key_fingerprint"]):
        raise RuntimeError("package bindings differ")
    transaction = value["transaction"]
    if set(transaction) != {"changes", "exact_install_specs", "additions", "download_bytes", "disk_delta_bytes",
                            "affected_services", "protected_services", "needrestart_assessment", "reboot_required",
                            "reboot_reasons", "safety_classification"}:
        raise RuntimeError("package transaction fields differ")
    changes = transaction["changes"]; specs = transaction["exact_install_specs"]
    if (not changes or len(changes) != len(specs) or transaction["safety_classification"] != value["lane"] or
            transaction["needrestart_assessment"] not in {"no-protected-restart", "maintenance-window-required"} or
            bindings["changes_sha256"] != sha(canonical(changes)) or
            any(set(item) != {"action", "candidate_version", "name", "origin", "policy_sha256", "previous_version", "security"} or
                item["action"] not in {"install", "upgrade"} or not item["name"] or not item["candidate_version"] or
                not item["origin"] or HEX64.fullmatch(item["policy_sha256"]) is None for item in changes)):
        raise RuntimeError("package transaction shape differs")
    expected = sorted(f'{item["name"]}={item["candidate_version"]}' for item in changes)
    if sorted(specs) != expected or len(set(specs)) != len(specs) or len({item["name"] for item in changes}) != len(changes):
        raise RuntimeError("package exact specs differ")
    return value


def run(arguments, timeout=600, accepted=(0,)):
    result = subprocess.run(arguments, stdin=subprocess.DEVNULL, capture_output=True, env=ENV, timeout=timeout)
    if result.returncode not in accepted or result.stderr:
        raise RuntimeError("package command failed")
    return result


def observe(backend=None):
    if backend is not None:
        return backend.observe()
    result = run((str(OBSERVER), "observe", "debian"), 360)
    return json.loads(result.stdout)


def validate_live(plan, observation):
    bindings = plan["bindings"]
    if (observation.get("version") != 2 or observation.get("host") != "debian" or
            observation.get("installed_status_sha256") != bindings["installed_package_set_sha256"] or
            observation.get("apt_state_hashes", {}).get("sources_sha256") != bindings["apt_sources_sha256"] or
            observation.get("apt_state_hashes", {}).get("keyrings_sha256") != bindings["apt_keyrings_sha256"] or
            observation.get("apt_state_hashes", {}).get("configuration_sha256") != bindings["apt_configuration_sha256"] or
            observation.get("proposal_sha256") != bindings["proposal_sha256"] or
            observation.get("changes") != plan["transaction"]["changes"] or
            not observation.get("apt_tree_safe") or not observation.get("size_parse_complete") or
            observation.get("holds") or observation.get("kept_back") or
            any(path != str(LOCK) for path in observation.get("active_lifecycle_locks", []))):
        raise RuntimeError("package live precondition differs")


def save(path, value, exclusive=False):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700); os.chmod(path.parent, 0o700)
    raw = canonical(value)
    if exclusive:
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    else:
        temporary = path.parent / f".{path.name}.{os.getpid()}.tmp"
        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        os.write(descriptor, raw); os.fchmod(descriptor, 0o600); os.fchown(descriptor, 0, 0); os.fsync(descriptor)
    finally:
        os.close(descriptor)
    if not exclusive:
        os.replace(temporary, path)
    directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
    try: os.fsync(directory)
    finally: os.close(directory)


def install_plan(transport_sha):
    account = __import__("pwd").getpwnam("ansible-package-apply")
    value, raw = read_file(INBOX / f"{transport_sha}.json", account.pw_uid, 0o600, account.pw_gid)
    validate_plan(value, raw, transport_sha, dt.datetime.now(dt.timezone.utc).replace(microsecond=0))
    target = PLAN_ROOT / f"{transport_sha}.json"
    if target.exists():
        existing, existing_raw = read_file(target, 0, 0o600)
        if existing_raw != raw: raise RuntimeError("installed package plan differs")
        return existing
    save(target, value, exclusive=True)
    return value


def apply(transport_sha, backend=None):
    plan = install_plan(transport_sha)
    journal_path = JOURNAL_ROOT / f"{transport_sha}.json"
    if journal_path.exists():
        journal, _ = read_file(journal_path, 0, 0o600)
        if journal.get("status") == "committed": return journal
        raise RuntimeError("incomplete package journal requires recovery")
    current = observe(backend); validate_live(plan, current)
    journal = {"format": "home-lab-debian-package-journal-v1", "plan_sha256": transport_sha,
               "final_sha256": plan["final_sha256"], "automatic_reboot": False, "status": "applying",
               "before_proposal_sha256": current["proposal_sha256"]}
    save(journal_path, journal, exclusive=True)
    specs = plan["transaction"]["exact_install_specs"]
    try:
        if backend is None:
            run(("/usr/bin/apt-get", "--yes", "--no-remove", "--download-only", "install", *specs), 1800)
            validate_live(plan, observe())
            run(("/usr/bin/apt-get", "--yes", "--no-remove", "--no-download", "install", *specs), 3600)
            audit = run(("/usr/bin/dpkg", "--audit"), 120)
            if audit.stdout: raise RuntimeError("dpkg audit is not empty")
            installed = run(("/usr/bin/dpkg-query", "--show", "--showformat=${binary:Package}=${Version}\\n", *[item["name"] for item in plan["transaction"]["changes"]]), 120)
            if sorted(installed.stdout.decode().splitlines()) != sorted(specs): raise RuntimeError("installed package versions differ")
        else:
            backend.apply(specs)
        journal["status"] = "committed"; journal["committed_at"] = dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
        save(journal_path, journal)
        return journal
    except Exception:
        journal["status"] = "failed-manual-recovery-required"; save(journal_path, journal)
        raise


def main():
    request_raw = os.read(0, 1025)
    if len(request_raw) > 1024:
        raise RuntimeError("package transaction request is too large")
    request = json.loads(request_raw)
    if not isinstance(request, dict) or set(request) != {"operation", "plan_sha256"} or request["operation"] not in {"inspect", "prepare", "apply", "recover"} or HEX64.fullmatch(request["plan_sha256"]) is None:
        raise RuntimeError("package transaction request differs")
    digest = request["plan_sha256"]
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    descriptor = os.open(LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if request["operation"] == "inspect":
            present = (PLAN_ROOT / f"{digest}.json").exists(); result = {"present": present}
        elif request["operation"] == "prepare":
            plan = install_plan(digest); validate_live(plan, observe())
            run(("/usr/bin/apt-get", "--yes", "--no-remove", "--download-only", "install", *plan["transaction"]["exact_install_specs"]), 1800)
            validate_live(plan, observe())
            result = {"package_transaction": "prepared", "plan_sha256": digest, "automatic_reboot": False}
        elif request["operation"] == "apply": result = apply(digest)
        else:
            journal, _ = read_file(JOURNAL_ROOT / f"{digest}.json", 0, 0o600); result = journal
    finally: os.close(descriptor)
    os.write(1, canonical(result))


if __name__ == "__main__":
    try: main()
    except Exception as error:
        os.write(2, f"debian-package-transaction: {error}\n".encode()); raise SystemExit(1)
