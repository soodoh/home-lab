{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-lab.invalid/schemas/proxmox-nix-shadow-evidence-v1.json",
  "additionalProperties": false,
  "properties": {
    "ansible": {
      "additionalProperties": false,
      "properties": {
        "reproducible": { "const": true },
        "runs": {
          "items": { "$ref": "#/$defs/ansibleSummary" },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": ["reproducible", "runs"],
      "type": "object"
    },
    "controllerManifest": {
      "additionalProperties": false,
      "properties": {
        "relativePath": { "pattern": "^\\.reconcile/plans/[0-9a-f]{40}/(steady|recovery)/manifest\\.json$", "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "version": { "const": 3 }
      },
      "required": ["relativePath", "sha256", "version"],
      "type": "object"
    },
    "format": { "const": "home-lab-proxmox-nix-shadow-evidence-v1" },
    "git": {
      "additionalProperties": false,
      "properties": {
        "commit": { "$ref": "#/$defs/gitObject" },
        "tree": { "$ref": "#/$defs/gitObject" }
      },
      "required": ["commit", "tree"],
      "type": "object"
    },
    "nix": {
      "additionalProperties": false,
      "properties": {
        "actionCount": { "$ref": "#/$defs/count" },
        "applyEligible": { "type": "boolean" },
        "bindings": { "$ref": "#/$defs/bindings" },
        "blockerCount": { "$ref": "#/$defs/count" },
        "domainCounts": {
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9-]*$": { "$ref": "#/$defs/domainCount" }
          },
          "type": "object"
        },
        "findingCount": { "$ref": "#/$defs/count" },
        "planRawSha256": { "$ref": "#/$defs/sha256" },
        "planRelativePath": { "pattern": "^\\.reconcile/plans/[0-9a-f]{64}\\.json$", "type": "string" },
        "planSha256": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["ready", "blocked"] }
      },
      "required": ["actionCount", "applyEligible", "bindings", "blockerCount", "domainCounts", "findingCount", "planRawSha256", "planRelativePath", "planSha256", "status"],
      "type": "object"
    },
    "observationOrder": {
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [{ "const": "ansible" }, { "const": "nix" }],
      "type": "array"
    },
    "observationsAtomic": { "const": false },
    "phase": { "enum": ["steady", "recovery"] },
    "version": { "const": 1 }
  },
  "required": ["ansible", "controllerManifest", "format", "git", "nix", "observationOrder", "observationsAtomic", "phase", "version"],
  "type": "object",
  "$defs": {
    "ansibleSummary": {
      "additionalProperties": false,
      "properties": {
        "handlerCount": { "$ref": "#/$defs/count" },
        "playCount": { "$ref": "#/$defs/count" },
        "recap": {
          "additionalProperties": false,
          "properties": {
            "changed": { "$ref": "#/$defs/count" },
            "failed": { "const": 0 },
            "host": { "const": "proxmox" },
            "ignored": { "$ref": "#/$defs/count" },
            "ok": { "$ref": "#/$defs/count" },
            "rescued": { "$ref": "#/$defs/count" },
            "skipped": { "$ref": "#/$defs/count" },
            "unreachable": { "const": 0 }
          },
          "required": ["changed", "failed", "host", "ignored", "ok", "rescued", "skipped", "unreachable"],
          "type": "object"
        },
        "taskCount": { "$ref": "#/$defs/count" }
      },
      "required": ["handlerCount", "playCount", "recap", "taskCount"],
      "type": "object"
    },
    "bindings": {
      "additionalProperties": false,
      "properties": {
        "activationEnvelopeSchemaSha256": { "$ref": "#/$defs/sha256" },
        "activatorSha256": { "$ref": "#/$defs/sha256" },
        "bundleContentSha256": { "$ref": "#/$defs/sha256" },
        "bundleFormat": { "const": "home-lab-proxmox-host-bundle-v1" },
        "flakeLockSha256": { "$ref": "#/$defs/sha256" },
        "gitCommit": { "$ref": "#/$defs/gitObject" },
        "gitTree": { "$ref": "#/$defs/gitObject" },
        "observerProtocol": { "const": 4 },
        "observerSha256": { "$ref": "#/$defs/sha256" },
        "packageManifestSha256": { "$ref": "#/$defs/sha256" },
        "planSchemaSha256": { "$ref": "#/$defs/sha256" },
        "privatePreconditionsSchemaSha256": { "$ref": "#/$defs/sha256" },
        "privatePreparationRequestSchemaSha256": { "$ref": "#/$defs/sha256" },
        "privatePreparerSha256": { "$ref": "#/$defs/sha256" },
        "projectionSha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["activationEnvelopeSchemaSha256", "activatorSha256", "bundleContentSha256", "bundleFormat", "flakeLockSha256", "gitCommit", "gitTree", "observerProtocol", "observerSha256", "packageManifestSha256", "planSchemaSha256", "privatePreconditionsSchemaSha256", "privatePreparationRequestSchemaSha256", "privatePreparerSha256", "projectionSha256"],
      "type": "object"
    },
    "count": { "minimum": 0, "type": "integer" },
    "domainCount": {
      "additionalProperties": false,
      "properties": {
        "actions": { "$ref": "#/$defs/count" },
        "blockers": { "$ref": "#/$defs/count" },
        "findings": { "$ref": "#/$defs/count" }
      },
      "required": ["actions", "blockers", "findings"],
      "type": "object"
    },
    "gitObject": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
    "sha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" }
  }
}
