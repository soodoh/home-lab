#cloud-config
hostname: docker-host
manage_etc_hosts: true
disable_root: true
ssh_pwauth: false
users: []
package_update: false
package_upgrade: false
packages:
  - qemu-guest-agent
runcmd:
  - [systemctl, enable, --now, qemu-guest-agent.service]
final_message: Home lab inert first-contact fixture complete; continue through reviewed console or QGA bootstrap.
