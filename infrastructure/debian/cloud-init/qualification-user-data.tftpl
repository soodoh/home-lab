#cloud-config
hostname: debian-lifecycle-qualification
manage_etc_hosts: true
timezone: ${timezone}
locale: ${locale}
package_update: false
package_upgrade: false
users:
  - name: ansible-deploy
    lock_passwd: true
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${qualification_ssh_public_key}
bootcmd:
  - [rm, --force, /etc/resolv.conf]
write_files:
  - path: /etc/resolv.conf
    owner: root:root
    permissions: "0644"
    content: |
      nameserver 1.1.1.1
      nameserver 9.9.9.9
  - path: /etc/systemd/network/10-cloud-init-eth0.network.d/10-public-dns.conf
    owner: root:root
    permissions: "0644"
    content: |
      [DHCPv4]
      UseDNS=no
      [Network]
      DNS=1.1.1.1
      DNS=9.9.9.9
packages:
  - qemu-guest-agent
runcmd:
  - [systemctl, enable, --now, qemu-guest-agent.service]
