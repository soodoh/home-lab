#cloud-config
hostname: debian-lifecycle-qualification
manage_etc_hosts: true
timezone: ${timezone}
locale: ${locale}
package_update: false
package_upgrade: false
users:
  - name: ansible-deploy
    lock_passwd: true
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${qualification_ssh_public_key}
bootcmd:
  - |
    set -eu
    attempt=0
    while [ "$attempt" -lt 60 ]; do
      if /usr/bin/resolvectl status eth0 >/dev/null 2>&1; then
        /usr/bin/resolvectl dns eth0 1.1.1.1 9.9.9.9
        /usr/bin/resolvectl domain eth0 "~."
        exit 0
      fi
      attempt=$((attempt + 1))
      /usr/bin/sleep 1
    done
    exit 1
write_files:
  - path: /etc/systemd/network/10-cloud-init-eth0.network.d/10-public-dns.conf
    owner: root:root
    permissions: "0644"
    content: |
      [DHCPv4]
      UseDNS=no
      [Network]
      DNS=1.1.1.1
      DNS=9.9.9.9
packages:
  - qemu-guest-agent
runcmd:
  - [systemctl, enable, --now, qemu-guest-agent.service]
