#!/bin/sh
set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
unset CDPATH ENV BASH_ENV PYTHONPATH PYTHONHOME PERL5LIB RUBYLIB

if [ "$#" -ne 2 ] || [ "$1" != -c ] || [ -n "${SSH_ORIGINAL_COMMAND-}" ]; then
  exit 64
fi
command=$2
case "$command" in
  restic-recovery\ network-identity)
    exec sudo -n -- /usr/local/libexec/home-lab/proxmox-restic-recovery-transport network-identity
    ;;
  restic-recovery\ stage-snippet\ *)
    digest=${command#restic-recovery stage-snippet }
    case "$digest" in *[!0-9a-f]*|'') exit 64;; esac
    [ "${#digest}" -eq 64 ] || exit 64
    exec sudo -n -- /usr/local/libexec/home-lab/proxmox-restic-recovery-transport stage-snippet "$digest"
    ;;
  restic-recovery\ remove-snippet\ *)
    digest=${command#restic-recovery remove-snippet }
    case "$digest" in *[!0-9a-f]*|'') exit 64;; esac
    [ "${#digest}" -eq 64 ] || exit 64
    exec sudo -n -- /usr/local/libexec/home-lab/proxmox-restic-recovery-transport remove-snippet "$digest"
    ;;
  *) exit 64 ;;
esac
