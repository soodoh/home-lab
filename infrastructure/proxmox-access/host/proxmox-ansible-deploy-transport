#!/bin/sh
set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
unset CDPATH ENV BASH_ENV PYTHONPATH PYTHONHOME PERL5LIB RUBYLIB

if [ "$#" -ne 2 ] || [ "$1" != -c ] || [ -n "${SSH_ORIGINAL_COMMAND-}" ]; then
  exit 64
fi
command=$2
case "$command" in
  stage\ lifecycle-marker\ *)
    digest=${command#stage lifecycle-marker }
    case "$digest" in *[!0-9a-f]*|'') exit 64;; esac
    [ "${#digest}" -eq 64 ] || exit 64
    inbox=/home/ansible-deploy/.home-lab-plan-inbox
    umask 077
    mkdir -p "$inbox"
    [ "$(id -u)" -eq "$(stat -c %u "$inbox")" ] || exit 77
    [ "$(stat -c %a "$inbox")" = 700 ] || exit 77
    target=$inbox/$digest.json
    [ ! -e "$target" ] || exit 73
    tmp=$inbox/.$digest.$$.tmp
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    dd bs=16385 count=1 of="$tmp" 2>/dev/null
    [ "$(wc -c <"$tmp")" -le 16384 ] || exit 65
    [ "$(sha256sum "$tmp" | cut -d' ' -f1)" = "$digest" ] || exit 65
    chmod 0600 "$tmp"
    mv -T "$tmp" "$target"
    trap - EXIT HUP INT TERM
    printf '%s\n' '{"staged":true}'
    ;;
  stage\ package\ *)
    digest=${command#stage package }
    case "$digest" in *[!0-9a-f]*|'') exit 64;; esac
    [ "${#digest}" -eq 64 ] || exit 64
    inbox=/home/ansible-deploy/.home-lab-plan-inbox
    umask 077
    mkdir -p "$inbox"
    [ "$(id -u)" -eq "$(stat -c %u "$inbox")" ] || exit 77
    [ "$(stat -c %a "$inbox")" = 700 ] || exit 77
    target=$inbox/$digest.json
    [ ! -e "$target" ] || exit 73
    tmp=$inbox/.$digest.$$.tmp
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    dd bs=262145 count=1 of="$tmp" 2>/dev/null
    [ "$(wc -c <"$tmp")" -le 262144 ] || exit 65
    [ "$(sha256sum "$tmp" | cut -d' ' -f1)" = "$digest" ] || exit 65
    chmod 0600 "$tmp"
    mv -T "$tmp" "$target"
    trap - EXIT HUP INT TERM
    printf '%s\n' '{"staged":true}'
    ;;
  stage\ reboot\ *)
    digest=${command#stage reboot }
    case "$digest" in *[!0-9a-f]*|'') exit 64;; esac
    [ "${#digest}" -eq 64 ] || exit 64
    inbox=/home/ansible-deploy/.home-lab-plan-inbox
    umask 077
    mkdir -p "$inbox"
    [ "$(id -u)" -eq "$(stat -c %u "$inbox")" ] || exit 77
    [ "$(stat -c %a "$inbox")" = 700 ] || exit 77
    target=$inbox/$digest.json
    [ ! -e "$target" ] || exit 73
    tmp=$inbox/.$digest.$$.tmp
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    dd bs=65537 count=1 of="$tmp" 2>/dev/null
    [ "$(wc -c <"$tmp")" -le 65536 ] || exit 65
    [ "$(sha256sum "$tmp" | cut -d' ' -f1)" = "$digest" ] || exit 65
    chmod 0600 "$tmp"
    mv -T "$tmp" "$target"
    trap - EXIT HUP INT TERM
    printf '%s\n' '{"staged":true}'
    ;;
  stage\ low-risk\ *)
    digest=${command#stage low-risk }
    case "$digest" in *[!0-9a-f]*|'') exit 64;; esac
    [ "${#digest}" -eq 64 ] || exit 64
    inbox=/home/ansible-deploy/.home-lab-plan-inbox
    umask 077
    mkdir -p "$inbox"
    [ "$(id -u)" -eq "$(stat -c %u "$inbox")" ] || exit 77
    [ "$(stat -c %a "$inbox")" = 700 ] || exit 77
    target=$inbox/$digest.json
    [ ! -e "$target" ] || exit 73
    tmp=$inbox/.$digest.$$.tmp
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    dd bs=65537 count=1 of="$tmp" 2>/dev/null
    [ "$(wc -c <"$tmp")" -le 65536 ] || exit 65
    [ "$(sha256sum "$tmp" | cut -d' ' -f1)" = "$digest" ] || exit 65
    chmod 0600 "$tmp"
    mv -T "$tmp" "$target"
    trap - EXIT HUP INT TERM
    printf '%s\n' '{"staged":true}'
    ;;
  inspect\ lifecycle-marker\ *)
    digest=${command#inspect lifecycle-marker }
    case "$digest" in *[!0-9a-f]*|'') exit 64;; esac
    [ "${#digest}" -eq 64 ] || exit 64
    target=/home/ansible-deploy/.home-lab-plan-inbox/$digest.json
    [ -f "$target" ] && [ ! -L "$target" ] || exit 66
    [ "$(sha256sum "$target" | cut -d' ' -f1)" = "$digest" ] || exit 65
    printf '%s\n' '{"present":true}'
    ;;
  inspect\ package\ *)
    digest=${command#inspect package }
    case "$digest" in *[!0-9a-f]*|'') exit 64;; esac
    [ "${#digest}" -eq 64 ] || exit 64
    target=/home/ansible-deploy/.home-lab-plan-inbox/$digest.json
    [ -f "$target" ] && [ ! -L "$target" ] || exit 66
    [ "$(sha256sum "$target" | cut -d' ' -f1)" = "$digest" ] || exit 65
    printf '%s\n' '{"present":true}'
    ;;
  inspect\ reboot\ *)
    digest=${command#inspect reboot }
    case "$digest" in *[!0-9a-f]*|'') exit 64;; esac
    [ "${#digest}" -eq 64 ] || exit 64
    target=/home/ansible-deploy/.home-lab-plan-inbox/$digest.json
    [ -f "$target" ] && [ ! -L "$target" ] || exit 66
    [ "$(sha256sum "$target" | cut -d' ' -f1)" = "$digest" ] || exit 65
    printf '%s\n' '{"present":true}'
    ;;
  inspect\ low-risk\ *)
    digest=${command#inspect low-risk }
    case "$digest" in *[!0-9a-f]*|'') exit 64;; esac
    [ "${#digest}" -eq 64 ] || exit 64
    target=/home/ansible-deploy/.home-lab-plan-inbox/$digest.json
    [ -f "$target" ] && [ ! -L "$target" ] || exit 66
    [ "$(sha256sum "$target" | cut -d' ' -f1)" = "$digest" ] || exit 65
    printf '%s\n' '{"present":true}'
    ;;
  apply\ lifecycle-marker\ *)
    digest=${command#apply lifecycle-marker }
    case "$digest" in *[!0-9a-f]*|'') exit 64;; esac
    [ "${#digest}" -eq 64 ] || exit 64
    printf '{"operation":"apply-lifecycle-marker","plan_sha256":"%s"}\n' "$digest" |
      exec sudo -n -- /usr/local/libexec/home-lab/proxmox-ansible-deploy-activator
    ;;
  prepare\ package\ *)
    digest=${command#prepare package }
    case "$digest" in *[!0-9a-f]*|'') exit 64;; esac
    [ "${#digest}" -eq 64 ] || exit 64
    printf '{"operation":"prepare-package","plan_sha256":"%s"}\n' "$digest" |
      exec sudo -n -- /usr/local/libexec/home-lab/proxmox-ansible-deploy-activator
    ;;
  apply\ package\ *)
    digest=${command#apply package }
    case "$digest" in *[!0-9a-f]*|'') exit 64;; esac
    [ "${#digest}" -eq 64 ] || exit 64
    printf '{"operation":"apply-package","plan_sha256":"%s"}\n' "$digest" |
      exec sudo -n -- /usr/local/libexec/home-lab/proxmox-ansible-deploy-activator
    ;;
  recover\ package\ *)
    digest=${command#recover package }
    case "$digest" in *[!0-9a-f]*|'') exit 64;; esac
    [ "${#digest}" -eq 64 ] || exit 64
    printf '{"operation":"recover-package","plan_sha256":"%s"}\n' "$digest" |
      exec sudo -n -- /usr/local/libexec/home-lab/proxmox-ansible-deploy-activator
    ;;
  prepare\ reboot\ *|apply\ reboot\ *|verify\ reboot\ *)
    operation=${command%% reboot *}
    digest=${command#* reboot }
    case "$digest" in *[!0-9a-f]*|'') exit 64;; esac
    [ "${#digest}" -eq 64 ] || exit 64
    printf '{"operation":"%s-reboot","plan_sha256":"%s"}\n' "$operation" "$digest" |
      exec sudo -n -- /usr/local/libexec/home-lab/proxmox-ansible-deploy-activator
    ;;
  apply\ apt-repositories\ *|recover\ apt-repositories\ *)
    operation=${command%% apt-repositories *}
    digest=${command#* apt-repositories }
    case "$digest" in *[!0-9a-f]*|'') exit 64;; esac
    [ "${#digest}" -eq 64 ] || exit 64
    printf '{"operation":"%s-apt-repositories","plan_sha256":"%s"}\n' "$operation" "$digest" |
      exec sudo -n -- /usr/local/libexec/home-lab/proxmox-ansible-deploy-activator
    ;;
  apply\ chrony-service\ *|recover\ chrony-service\ *)
    operation=${command%% chrony-service *}
    digest=${command#* chrony-service }
    case "$digest" in *[!0-9a-f]*|'') exit 64;; esac
    [ "${#digest}" -eq 64 ] || exit 64
    printf '{"operation":"%s-chrony-service","plan_sha256":"%s"}\n' "$operation" "$digest" |
      exec sudo -n -- /usr/local/libexec/home-lab/proxmox-ansible-deploy-activator
    ;;
  *)
    exit 64
    ;;
esac
