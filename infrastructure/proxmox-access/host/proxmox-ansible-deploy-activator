                "inventory_sha256", "playbook_sha256", "role_sha256", "transport_sha256"):
        if HEX64.fullmatch(value.get(key, "")) is None:
            fail("Tailscale ownership activation binding is invalid")
    created, expires = parse_time(value["created_at"]), parse_time(value["expires_at"])
    now = dt.datetime.now(dt.timezone.utc).replace(microsecond=0)
    if created > now or now > expires or (expires - created).total_seconds() != 1800 or \
            hashlib.sha256(canonical(value)).hexdigest() != digest:
        fail("Tailscale ownership activation freshness or hash differs")
    verify_repo(value)
    bindings = {"activator_sha256": file_hash(Path(__file__)),
                "contract_schema_sha256": file_hash(REPO / "infrastructure/contract/schema.json"),
                "playbook_sha256": file_hash(REPO / "ansible/playbooks/proxmox-network-plan.yml"),
                "role_sha256": file_hash(REPO / "ansible/roles/proxmox_network_lifecycle/tasks/main.yml"),
                "consumer_role_sha256": file_hash(REPO / "ansible/roles/proxmox_network_consumers/tasks/main.yml"),
                "transport_sha256": file_hash(Path("/usr/local/libexec/home-lab/proxmox-ansible-deploy-transport"))}
    if any(value[key] != observed for key, observed in bindings.items()):
        fail("Tailscale ownership activation implementation binding differs")
    current = tailscale_ownership_snapshot()
    transferred = {"current_owner": "ansible", "target_owner": "ansible", "state": "transferred",
                   "parity_required": True, "single_writer": True}
    if current["handoff"] != transferred or value["before"] != current or not current["parity_complete"]:
        fail("Tailscale ownership parity differs")
    return current


def tailscale_ownership_operation(value, digest):
    lock_fd = os.open(TAILSCALE_OWNERSHIP_LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        before = validate_tailscale_ownership_plan(value, digest)
        TAILSCALE_OWNERSHIP_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(TAILSCALE_OWNERSHIP_DIR, 0o700)
        path = TAILSCALE_OWNERSHIP_DIR / f"{digest}.json"
        receipt = {"automatic_reboot": False, "changed": False,
                   "format": "home-lab-proxmox-tailscale-ownership-journal-v1", "plan_sha256": digest,
                   "preferences_match": before["preferences_match"], "protected_values_exported": False,
                   "service_restarted": False, "state_mutated": False, "status": "committed"}
        if path.exists():
            if json.loads(read_fixed(path, 0, 0, 0o600, 65536)) != receipt:
                fail("Tailscale ownership journal differs")
            return {"tailscale_ownership_transaction": "already-committed", "changed": False, "plan_sha256": digest}
        save_package_journal(path, receipt, exclusive=True)
        return {"tailscale_ownership_transaction": "committed", "changed": False, "plan_sha256": digest}
    except BlockingIOError:
        fail("Tailscale ownership lock is active")
    finally:
        os.close(lock_fd)



def boot_configuration_reboot_evidence(unexpected_count):
    snapshot = boot_snapshot()
    if snapshot["source"]["sha256"] != snapshot["expected_source_sha256"] or \
            snapshot["unexpected_vfio_device_count"] != unexpected_count:
        return False
    try:
        root_metadata = os.lstat(BOOT_TRANSACTION_DIR)
        directories = tuple(BOOT_TRANSACTION_DIR.iterdir())
    except OSError:
        return False
    if not stat.S_ISDIR(root_metadata.st_mode) or root_metadata.st_uid != 0 or root_metadata.st_gid != 0 or \
            stat.S_IMODE(root_metadata.st_mode) != 0o700:
        fail("protected boot transaction root differs")
    matching = 0
    observed_initramfs = {(item["role"], item["kernel"], item["path"]): item["sha256"]
                          for item in snapshot["initramfs"]}
    for directory in directories:
        if HEX64.fullmatch(directory.name) is None:
            fail("protected boot transaction entry differs")
        directory_metadata = os.lstat(directory)
        if not stat.S_ISDIR(directory_metadata.st_mode) or directory_metadata.st_uid != 0 or \
                directory_metadata.st_gid != 0 or stat.S_IMODE(directory_metadata.st_mode) != 0o700:
            fail("protected boot transaction directory differs")
        journal_path = directory / "journal.json"
        if not journal_path.exists():
            continue
        try:
            journal = json.loads(read_fixed(journal_path, 0, 0, 0o600, 65536))
        except (OSError, ValueError, json.JSONDecodeError):
            fail("protected boot reboot journal differs")
        if not isinstance(journal, dict) or journal.get("format") != "home-lab-proxmox-protected-boot-journal-v1" or \
                journal.get("status") != "committed" or journal.get("reboot_required") is not True or \
                journal.get("automatic_reboot") is not False or journal.get("protected_values_exported") is not False or \
                journal.get("plan_sha256") != directory.name:
            continue
        source = journal.get("source", {})
        initramfs = journal.get("initramfs")
        if source.get("after_sha256") != snapshot["source"]["sha256"] or \
                not isinstance(initramfs, list) or len(initramfs) != len(observed_initramfs):
            continue
        journal_initramfs = {(item.get("role"), item.get("kernel"), item.get("path")): item.get("after_sha256")
                             for item in initramfs if isinstance(item, dict)}
        if journal_initramfs == observed_initramfs:
            matching += 1
    if matching > 1:
        fail("multiple protected boot reboot journals match")
    return matching == 1


def boot_configuration_reboot_pending():
    return boot_configuration_reboot_evidence(1)


def boot_configuration_reboot_completed():
    return boot_configuration_reboot_evidence(0)


def validate_reboot_plan(value, digest, allow_expired=False):
    keys = {"access_evidence_sha256", "authorized", "automatic_reboot", "backup_attestation_sha256", "commit",
            "console_attested", "contract_sha256", "created_at", "evidence", "expires_at", "expected", "format",
            "host_key_fingerprint", "inventory_sha256", "maintenance_plan_sha256"}
    if not isinstance(value, dict) or set(value) != keys or value["format"] != "home-lab-proxmox-reboot-activation-v1" or \
            value["authorized"] is not False or value["automatic_reboot"] is not False or value["console_attested"] is not True or \
            value["host_key_fingerprint"] != FINGERPRINT or HEX40.fullmatch(value.get("commit", "")) is None:
        fail("reboot activation envelope differs")
    for key in ("access_evidence_sha256", "backup_attestation_sha256", "contract_sha256", "inventory_sha256", "maintenance_plan_sha256"):
        if HEX64.fullmatch(value.get(key, "")) is None:
            fail("reboot activation binding is invalid")
    created, expires = parse_time(value["created_at"]), parse_time(value["expires_at"])
    now = dt.datetime.now(dt.timezone.utc).replace(microsecond=0)
    if created > now or (not allow_expired and now > expires) or (expires - created).total_seconds() != 1800 or \
            hashlib.sha256(canonical(value)).hexdigest() != digest:
        fail("reboot activation freshness or hash differs")
    expected = value["expected"]; evidence = value["evidence"]
    if not isinstance(expected, dict) or set(expected) != {"boot_id", "current_kernel", "target_kernel"} or \
            not isinstance(evidence, dict) or set(evidence) != {"boot_id", "current_kernel", "evidence_sha256", "health", "reboot_indicated", "target_kernel"}:
        fail("reboot evidence shape differs")
    kernel = re.compile(r"[0-9A-Za-z][0-9A-Za-z.+~-]*-pve")
    configuration_reboot = evidence["reboot_indicated"] is True or (
        boot_configuration_reboot_completed() if allow_expired else boot_configuration_reboot_pending())
    if re.fullmatch(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", expected["boot_id"]) is None or \
            kernel.fullmatch(expected["current_kernel"]) is None or kernel.fullmatch(expected["target_kernel"]) is None or \
            evidence["boot_id"] != expected["boot_id"] or evidence["current_kernel"] != expected["current_kernel"] or \
            evidence["target_kernel"] != expected["target_kernel"] or \
            not configuration_reboot or \
            evidence["health"] != {"vm_100": "status: running", "zpool_storage": True} or HEX64.fullmatch(evidence["evidence_sha256"]) is None:
        fail("reboot evidence differs")
    return expected


def reboot_journal_path(digest):
    root = Path("/var/lib/home-lab/reboot-transactions"); root.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = os.lstat(root)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_gid != 0 or stat.S_IMODE(info.st_mode) != 0o700:
        fail("reboot transaction root is unsafe")
    return root / f"{digest}.json"


def reboot_health():
    pool = native(("/usr/sbin/zpool", "status", "-x", "storage"))
    vm = native(("/usr/sbin/qm", "status", "100"))
    system = native(("/usr/bin/systemctl", "is-system-running"), accepted=(0, 1))
    services = ("pveproxy.service", "pvedaemon.service", "pvestatd.service", "pve-firewall.service", "tailscaled.service", "ssh.service", "nfs-server.service", "zfs-zed.service", "chrony.service")
    active = native(("/usr/bin/systemctl", "is-active", *services))
    audit = native(("/usr/bin/dpkg", "--audit"))
    remaining, _ = solver_changes()
    if "is healthy" not in pool.stdout or vm.stdout.strip() != "status: running" or system.stdout.strip() != "running" or \
            active.stdout.splitlines() != ["active"] * len(services) or audit.stdout or audit.stderr or remaining:
        fail("reboot health precondition differs")


def reboot_preconditions(expected):
    if os.uname().release != expected["current_kernel"] or Path("/proc/sys/kernel/random/boot_id").read_text().strip() != expected["boot_id"]:
        fail("reboot current kernel or boot ID differs")
    target = Path("/boot") / f"vmlinuz-{expected['target_kernel']}"; info = os.lstat(target)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_gid != 0:
        fail("target kernel image differs")
    reboot_health()


def reboot_operation(value, digest, operation):
    expected = validate_reboot_plan(value, digest, allow_expired=operation == "verify-reboot")
    verify_repo(value, (
        "infrastructure/proxmox-access/host/proxmox-ansible-deploy-activator",
        "scripts/controller/test-proxmox-boot-configuration-activation.py",
    ) if operation == "verify-reboot" else ())
    lock_fd = os.open("/run/lock/home-lab-proxmox-reboot.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    path = reboot_journal_path(digest); journal = json.loads(path.read_bytes()) if path.exists() else None
    if operation == "prepare-reboot":
        if journal is not None:
            if journal.get("status") == "prepared": return {"reboot_transaction": "already-prepared", "plan_sha256": digest}
            fail("reboot transaction journal already exists")
        reboot_preconditions(expected)
        journal = {"automatic_reboot": False, "boot_id_before": expected["boot_id"], "format": "home-lab-proxmox-reboot-journal-v1",
                   "plan_sha256": digest, "status": "prepared", "target_kernel": expected["target_kernel"]}
        save_package_journal(path, journal, exclusive=True)
        return {"reboot_transaction": "prepared", "plan_sha256": digest}
    if journal is None or journal.get("plan_sha256") != digest or journal.get("target_kernel") != expected["target_kernel"]:
        fail("reboot transaction journal differs")
    if journal.get("status") == "committed":
        return {"reboot_transaction": "already-committed", "plan_sha256": digest, "current_kernel": os.uname().release}
    if operation == "apply-reboot":
        if journal.get("status") != "prepared": fail("reboot transaction is not prepared")
        reboot_preconditions(expected); journal["status"] = "rebooting"; save_package_journal(path, journal)
        native(("/usr/bin/systemctl", "reboot"), timeout=30)
        return {"reboot_transaction": "initiated", "plan_sha256": digest}
    if journal.get("status") != "rebooting" or Path("/proc/sys/kernel/random/boot_id").read_text().strip() == expected["boot_id"] or \
            os.uname().release != expected["target_kernel"]:
        fail("reboot postcondition differs")
    reboot_health(); journal["status"] = "committed"; journal["boot_id_after"] = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    save_package_journal(path, journal)
    return {"reboot_transaction": "committed", "plan_sha256": digest, "current_kernel": os.uname().release}


def main():
    request = read_bounded_stdin(1024)
    operations = {"apply-lifecycle-marker", "prepare-package", "apply-package", "recover-package", "prepare-reboot", "apply-reboot", "verify-reboot", "apply-apt-repositories", "recover-apt-repositories", "apply-chrony-service", "recover-chrony-service", "inspect-boot-configuration", "apply-boot-configuration", "recover-boot-configuration", "apply-boot-ownership", "inspect-storage-lifecycle", "apply-zfs-ownership", "inspect-nfs-lifecycle", "apply-nfs-ownership", "inspect-network-lifecycle", "apply-network-ownership", "inspect-tailscale-lifecycle", "apply-tailscale-ownership"}
    if not isinstance(request, dict) or set(request) != {"operation", "plan_sha256"} or \
            request.get("operation") not in operations or not isinstance(request.get("plan_sha256"), str) or \
            HEX64.fullmatch(request["plan_sha256"]) is None:
        fail("deploy request differs")
    if any(os.path.lexists(path) for path in LOCKS):
        fail("conflicting lifecycle lock is active")
    if request["operation"] == "inspect-boot-configuration":
        if request["plan_sha256"] != "0" * 64:
            fail("protected boot inspection request differs")
        print(json.dumps(boot_snapshot(), sort_keys=True, separators=(",", ":")))
        return
    if request["operation"] == "inspect-storage-lifecycle":
        if request["plan_sha256"] != "0" * 64:
            fail("storage inspection request differs")
        print(json.dumps(zfs_ownership_snapshot(), sort_keys=True, separators=(",", ":")))
        return
    if request["operation"] == "inspect-nfs-lifecycle":
        if request["plan_sha256"] != "0" * 64:
            fail("NFS inspection request differs")
        print(json.dumps(nfs_ownership_snapshot(), sort_keys=True, separators=(",", ":")))
        return
    if request["operation"] == "inspect-network-lifecycle":
        if request["plan_sha256"] != "0" * 64:
            fail("network inspection request differs")
        print(json.dumps(network_ownership_snapshot(), sort_keys=True, separators=(",", ":")))
        return
    if request["operation"] == "inspect-tailscale-lifecycle":
        if request["plan_sha256"] != "0" * 64:
            fail("Tailscale inspection request differs")
        print(json.dumps(tailscale_ownership_snapshot(), sort_keys=True, separators=(",", ":")))
        return
    digest = request["plan_sha256"]
    deploy_account = pwd.getpwnam("ansible-deploy")
    path = INBOX / f"{digest}.json"
    limit = 16384 if request["operation"] == "apply-lifecycle-marker" else 262144
    raw = read_fixed(path, deploy_account.pw_uid, deploy_account.pw_gid, 0o600, limit)
    value = json.loads(raw)
    if raw != canonical(value):
        fail("staged plan is not canonical")
    if request["operation"] == "apply-lifecycle-marker":
        after = validate_plan(value, digest)
        verify_repo(value)
        output = {"lifecycle_marker": install_marker(after), "plan_sha256": digest}
    elif request["operation"] == "apply-apt-repositories":
        output = repository_operation(value, digest)
    elif request["operation"] == "recover-apt-repositories":
        output = recover_repository(value, digest)
    elif request["operation"] == "apply-chrony-service":
        output = chrony_operation(value, digest)
    elif request["operation"] == "recover-chrony-service":
        output = recover_chrony(value, digest)
    elif request["operation"] == "apply-boot-configuration":
        output = boot_operation(value, digest)
    elif request["operation"] == "recover-boot-configuration":
        output = recover_boot(value, digest)
    elif request["operation"] == "apply-boot-ownership":
        output = boot_ownership_operation(value, digest)
    elif request["operation"] == "apply-zfs-ownership":
        output = zfs_ownership_operation(value, digest)
    elif request["operation"] == "apply-nfs-ownership":
        output = nfs_ownership_operation(value, digest)
    elif request["operation"] == "apply-network-ownership":
        output = network_ownership_operation(value, digest)
    elif request["operation"] == "apply-tailscale-ownership":
        output = tailscale_ownership_operation(value, digest)
    elif request["operation"].endswith("-reboot"):
        output = reboot_operation(value, digest, request["operation"])
    else:
        output = package_operation(value, digest, request["operation"])
    print(json.dumps(output, sort_keys=True, separators=(",", ":")))


try:
    main()
except (KeyError, OSError, ValueError, json.JSONDecodeError, subprocess.SubprocessError) as error:
    print(f"proxmox-ansible-deploy-activator: {error}", file=sys.stderr)
    raise SystemExit(65)
