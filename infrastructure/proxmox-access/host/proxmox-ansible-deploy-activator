def zfs_ownership_snapshot():
    handoff, zfs, dataset = zfs_contract_material()
    pool = zfs["pool"]
    health = storage_run(("/usr/sbin/zpool", "list", "-H", "-o", "health", pool)).strip()
    topology = storage_run(("/usr/sbin/zpool", "status", "-P", pool)).splitlines()
    mirror_count = sum(1 for line in topology if re.match(r"^\s+mirror-\d+\s+", line))
    rows = [line.split() for line in topology if re.match(r"^\s+\S+\s+(?:ONLINE|DEGRADED|FAULTED|UNAVAIL|OFFLINE)\s+", line)]
    members = [row for row in rows if row[0].startswith("/dev/disk/by-id/")]
    states = sorted({row[1] for row in rows})
    checksum_errors = sum(1 for row in members if len(row) < 5 or row[-1] != "0")
    raw = storage_run(("/usr/sbin/zfs", "get", "-H", "-o", "property,value",
                       "mountpoint,mounted,sharenfs,canmount,readonly", dataset["name"]))
    properties = dict(line.split("\t", 1) for line in raw.splitlines())
    expected_properties = {**dataset["properties"], "mountpoint": dataset["mountpoint"],
                           "mounted": "yes", "canmount": "on", "readonly": "off"}
    pvesm = storage_run(("/usr/sbin/pvesm", "status", "--storage", pool))
    pve_active = any(line.split() and line.split()[0] == pool and "active" in line for line in pvesm.splitlines())
    vm_running = storage_run(("/usr/sbin/qm", "status", "100")).strip() == "status: running"
    locks = [str(path) for path in LOCKS if os.path.lexists(path)]
    parity = health == "ONLINE" and mirror_count == zfs["mirror_topology"]["count"] and \
        len(members) == zfs["mirror_topology"]["count"] * zfs["mirror_topology"]["width"] and \
        states == ["ONLINE"] and checksum_errors == 0 and properties == expected_properties and \
        pve_active and vm_running and not locks
    return {"active_lifecycle_locks": locks, "dataset_matches": properties == expected_properties,
            "format": "home-lab-proxmox-zfs-ownership-observation-v1", "handoff": handoff,
            "health": health, "member_count": len(members), "member_identities_exported": False,
            "mirror_count": mirror_count, "parity_complete": parity, "protected_values_exported": False,
            "pve_storage_active": pve_active, "topology_states": states, "version": 1,
            "vm_100_running": vm_running}


