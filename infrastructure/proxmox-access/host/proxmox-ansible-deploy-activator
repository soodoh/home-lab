                   "protected_values_exported": False, "source_sha256": before["source"]["sha256"],
                   "status": "committed", "unexpected_vfio_device_count": 0}
        if path.exists():
            if json.loads(read_fixed(path, 0, 0, 0o600, 65536)) != receipt:
                fail("boot ownership journal differs")
            return {"boot_ownership_transaction": "already-committed", "changed": False, "plan_sha256": digest}
