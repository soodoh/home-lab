    vm_running = storage_run(("/usr/sbin/qm", "status", "100")).strip() == "status: running"
    locks = [str(item) for item in LOCKS if os.path.lexists(item)]
    services_match = all(item["active"] and item["enabled"] for item in services.values())
    parity = file_matches and table_matches and services_match and dataset_matches and pve_active and vm_running and not locks
    return {"active_lifecycle_locks": locks, "dataset_matches": dataset_matches,
            "export_file_matches": file_matches, "export_table_matches": table_matches,
            "format": "home-lab-proxmox-nfs-ownership-observation-v1", "handoff": handoff,
            "parity_complete": parity, "protected_values_exported": False, "pve_storage_active": pve_active,
            "services": services, "version": 1, "vm_100_running": vm_running}


def validate_nfs_ownership_plan(value, digest):
    keys = {"activator_sha256", "authorized", "automatic_reboot", "before", "changed", "commit",
            "consumer_parity_verified", "consumer_role_sha256", "contract_schema_sha256", "contract_sha256",
            "created_at", "expires_at", "format", "host_key_fingerprint", "inventory_sha256",
            "playbook_sha256", "protected_values_exported", "role_sha256", "transport_sha256"}
    if not isinstance(value, dict) or set(value) != keys or \
            value["format"] != "home-lab-proxmox-nfs-ownership-activation-v1" or \
            value["authorized"] is not False or value["automatic_reboot"] is not False or \
            value["changed"] is not False or value["consumer_parity_verified"] is not True or \
            value["protected_values_exported"] is not False or value["host_key_fingerprint"] != FINGERPRINT or \
            HEX40.fullmatch(value.get("commit", "")) is None:
        fail("NFS ownership activation envelope differs")
    for key in ("activator_sha256", "consumer_role_sha256", "contract_schema_sha256", "contract_sha256",
                "inventory_sha256", "playbook_sha256", "role_sha256", "transport_sha256"):
        if HEX64.fullmatch(value.get(key, "")) is None:
            fail("NFS ownership activation binding is invalid")
    created, expires = parse_time(value["created_at"]), parse_time(value["expires_at"])
    now = dt.datetime.now(dt.timezone.utc).replace(microsecond=0)
    if created > now or now > expires or (expires - created).total_seconds() != 1800 or \
            hashlib.sha256(canonical(value)).hexdigest() != digest:
        fail("NFS ownership activation freshness or hash differs")
    verify_repo(value)
    bindings = {"activator_sha256": file_hash(Path(__file__)),
                "contract_schema_sha256": file_hash(REPO / "infrastructure/contract/schema.json"),
                "playbook_sha256": file_hash(REPO / "ansible/playbooks/proxmox-storage-plan.yml"),
                "role_sha256": file_hash(REPO / "ansible/roles/proxmox_storage_lifecycle/tasks/main.yml"),
                "consumer_role_sha256": file_hash(REPO / "ansible/roles/proxmox_storage_consumers/tasks/main.yml"),
                "transport_sha256": file_hash(Path("/usr/local/libexec/home-lab/proxmox-ansible-deploy-transport"))}
    if any(value[key] != observed for key, observed in bindings.items()):
        fail("NFS ownership activation implementation binding differs")
    current = nfs_ownership_snapshot()
    transferred = {"current_owner": "ansible", "target_owner": "ansible", "state": "transferred",
                   "parity_required": True, "single_writer": True}
    if current["handoff"] != transferred or value["before"] != current or not current["parity_complete"]:
        fail("NFS ownership parity differs")
    return current


def nfs_ownership_operation(value, digest):
    lock_fd = os.open(NFS_OWNERSHIP_LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        before = validate_nfs_ownership_plan(value, digest)
        NFS_OWNERSHIP_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(NFS_OWNERSHIP_DIR, 0o700)
        path = NFS_OWNERSHIP_DIR / f"{digest}.json"
        receipt = {"automatic_reboot": False, "changed": False,
                   "export_file_matches": before["export_file_matches"],
                   "export_table_matches": before["export_table_matches"],
                   "format": "home-lab-proxmox-nfs-ownership-journal-v1", "plan_sha256": digest,
                   "protected_values_exported": False, "services_match": all(
                       item["active"] and item["enabled"] for item in before["services"].values()),
                   "status": "committed"}
        if path.exists():
            if json.loads(read_fixed(path, 0, 0, 0o600, 65536)) != receipt:
                fail("NFS ownership journal differs")
            return {"nfs_ownership_transaction": "already-committed", "changed": False, "plan_sha256": digest}
        save_package_journal(path, receipt, exclusive=True)
        return {"nfs_ownership_transaction": "committed", "changed": False, "plan_sha256": digest}
    except BlockingIOError:
        fail("NFS ownership lock is active")
    finally:
        os.close(lock_fd)


