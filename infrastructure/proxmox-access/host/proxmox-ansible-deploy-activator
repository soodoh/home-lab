    verify_repo(value)
    if value.get("host_key_fingerprint") != FINGERPRINT or not HEX64.fullmatch(value.get("inventory_sha256", "")) or \
            not TIME.fullmatch(value.get("created_at", "")) or not TIME.fullmatch(value.get("expires_at", "")) or \
            value.get("contract_schema_sha256") != file_hash(REPO / "infrastructure/contract/schema.json") or \
            value.get("role_sha256") != file_hash(REPO / "ansible/roles/proxmox_boot_configuration/tasks/main.yml") or \
            value.get("playbook_sha256") != file_hash(REPO / "ansible/playbooks/proxmox-boot-configuration-plan.yml") or \
            value.get("activator_sha256") != file_hash(Path("/usr/local/libexec/home-lab/proxmox-ansible-deploy-activator")) or \
            value.get("transport_sha256") != file_hash(Path("/usr/local/libexec/home-lab/proxmox-ansible-deploy-transport")):
        fail("protected boot bindings differ")
    if not allow_expired and dt.datetime.now(dt.timezone.utc) > parse_time(value["expires_at"]):
        fail("protected boot activation expired")
    current = boot_snapshot(allow_ready=False)
    if value.get("commit") != current["commit"] or value.get("contract_sha256") != current["contract_sha256"] or \
            (not allow_expired and value.get("before") != current):
        fail("protected boot evidence changed")
    return current


def save_boot_journal(path, value):
    raw = canonical(value)
    temporary = path.with_name(f".journal.{os.getpid()}.tmp")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(descriptor, "wb", closefd=False) as handle:
            handle.write(raw); handle.flush(); os.fsync(handle.fileno())
        os.replace(temporary, path)
        fsync_directory(path.parent)
    finally:
        os.close(descriptor)
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def boot_copy(source, target):
    source_fd = os.open(source, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        target_fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        try:
            while True:
                block = os.read(source_fd, 1024 * 1024)
                if not block:
                    break
                view = memoryview(block)
                while view:
                    written = os.write(target_fd, view)
                    if written < 1:
                        fail("protected boot backup write made no progress")
                    view = view[written:]
            os.fsync(target_fd)
        finally:
            os.close(target_fd)
    finally:
        os.close(source_fd)


def boot_restore(backup, target, mode=0o644):
    content = backup.read_bytes()
    temporary = target.with_name(f".{target.name}.boot-rollback.{os.getpid()}")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    try:
        view = memoryview(content)
        while view:
            written = os.write(descriptor, view)
            if written < 1:
                fail("protected boot rollback write made no progress")
            view = view[written:]
        os.fchmod(descriptor, mode); os.fchown(descriptor, 0, 0); os.fsync(descriptor)
        os.replace(temporary, target); fsync_directory(target.parent)
    finally:
        os.close(descriptor)
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def boot_transaction_paths(digest):
    directory = BOOT_TRANSACTION_DIR / digest
    return directory, directory / "journal.json"


def boot_verify_state(journal, state):
    source_sha = journal["source"]["after_sha256" if state == "committed" else "before_sha256"]
    if file_hash(BOOT_VFIO_PATH) != source_sha:
        return False
    key = "after_sha256" if state == "committed" else "before_sha256"
    return all(file_hash(Path(item["path"])) == item[key] for item in journal["initramfs"])


def acquire_boot_conflict_locks():
    descriptors = []
    for path in (LOW_RISK_LOCK, Path("/run/lock/home-lab-proxmox-package.lock"),
                 Path("/run/lock/home-lab-proxmox-reboot.lock"), Path("/run/lock/home-lab-vfio-recovery.lock")):
        descriptor = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0 or metadata.st_gid != 0 or metadata.st_nlink != 1:
            os.close(descriptor)
            fail("protected boot conflict lock metadata differs")
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except Exception:
            os.close(descriptor)
            for held in descriptors:
                os.close(held)
            raise
        descriptors.append(descriptor)
    return descriptors


def boot_operation(value, digest):
    BOOT_TRANSACTION_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(BOOT_TRANSACTION_DIR, 0o700)
    lock_fd = os.open(BOOT_TRANSACTION_LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    conflict_locks = []
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        conflict_locks = acquire_boot_conflict_locks()
        before = validate_boot_plan(value, digest)
        directory, journal_path = boot_transaction_paths(digest)
        if journal_path.exists():
            journal = json.loads(read_fixed(journal_path, 0, 0, 0o600, 65536))
            if journal.get("status") == "committed" and boot_verify_state(journal, "committed"):
                return {"boot_configuration_transaction": "already-committed", "changed": True,
                        "plan_sha256": digest, "rebooted": False}
            fail("protected boot transaction requires recovery")
        if directory.exists():
            fail("protected boot transaction directory exists without a journal")
        required_root = before["source"]["size"] + sum(item["size"] for item in before["initramfs"]) + 64 * 1024 * 1024
        root_space = os.statvfs(BOOT_TRANSACTION_DIR)
        boot_space = os.statvfs(Path(before["initramfs"][0]["path"]).parent)
        if root_space.f_bavail * root_space.f_frsize < required_root or \
                boot_space.f_bavail * boot_space.f_frsize < max(item["size"] for item in before["initramfs"]) + 64 * 1024 * 1024:
            fail("protected boot transaction free space is insufficient")
        directory.mkdir(mode=0o700)
        fsync_directory(BOOT_TRANSACTION_DIR)
        source_backup = directory / "source.before"
        initramfs_entries = []
        try:
            boot_copy(BOOT_VFIO_PATH, source_backup)
            for item in before["initramfs"]:
                backup = directory / f"initramfs-{item['role']}.before"
                boot_copy(Path(item["path"]), backup)
                initramfs_entries.append({"after_sha256": None, "backup": backup.name,
                                          "before_sha256": item["sha256"], "kernel": item["kernel"],
                                          "path": item["path"], "role": item["role"]})
            fsync_directory(directory)
        except Exception:
            for candidate in (source_backup, *(directory / f"initramfs-{role}.before" for role in ("current", "fallback"))):
                try:
                    os.unlink(candidate)
                except FileNotFoundError:
                    pass
            os.rmdir(directory); fsync_directory(BOOT_TRANSACTION_DIR)
            raise
        journal = {"automatic_reboot": False, "format": "home-lab-proxmox-protected-boot-journal-v1",
                   "initramfs": initramfs_entries, "plan_sha256": digest, "protected_values_exported": False,
                   "reboot_required": True, "source": {"after_sha256": before["expected_source_sha256"],
                   "backup": source_backup.name, "before_sha256": before["source"]["sha256"],
                   "path": str(BOOT_VFIO_PATH)}, "status": "prepared"}
        save_boot_journal(journal_path, journal)
        try:
            _, expected = boot_contract_material()
            if hashlib.sha256(expected).hexdigest() != before["expected_source_sha256"]:
                fail("protected boot expected content changed")
            replace_repository_file(BOOT_VFIO_PATH, expected)
            journal["status"] = "source-updated"; save_boot_journal(journal_path, journal)
            for item in journal["initramfs"]:
                native(("/usr/sbin/update-initramfs", "-u", "-k", item["kernel"]), timeout=600)
            for item in journal["initramfs"]:
                item["after_sha256"] = file_hash(Path(item["path"]))
                if item["after_sha256"] == item["before_sha256"]:
                    fail("retained initramfs did not change")
            if file_hash(BOOT_VFIO_PATH) != before["expected_source_sha256"]:
                fail("protected boot source postcondition differs")
            journal["status"] = "committed"; save_boot_journal(journal_path, journal)
            return {"boot_configuration_transaction": "committed", "changed": True,
                    "plan_sha256": digest, "rebooted": False}
        except Exception:
            try:
                boot_restore(source_backup, BOOT_VFIO_PATH)
                for item in journal["initramfs"]:
                    boot_restore(directory / item["backup"], Path(item["path"]))
                journal["status"] = "rolled-back" if boot_verify_state(journal, "rolled-back") else "rollback-failed"
                save_boot_journal(journal_path, journal)
            except Exception:
                journal["status"] = "rollback-failed"; save_boot_journal(journal_path, journal)
            raise
    finally:
        for descriptor in conflict_locks:
            os.close(descriptor)
        os.close(lock_fd)


def recover_boot(value, digest):
    BOOT_TRANSACTION_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    lock_fd = os.open(BOOT_TRANSACTION_LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    conflict_locks = []
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        conflict_locks = acquire_boot_conflict_locks()
        validate_boot_plan(value, digest, allow_expired=True)
        directory, journal_path = boot_transaction_paths(digest)
        journal = json.loads(read_fixed(journal_path, 0, 0, 0o600, 65536))
        status = journal.get("status")
        if status == "committed" and boot_verify_state(journal, "committed"):
            return {"boot_configuration_transaction": "committed", "changed": True,
                    "plan_sha256": digest, "rebooted": False}
        if status == "rolled-back" and boot_verify_state(journal, "rolled-back"):
            return {"boot_configuration_transaction": "rolled-back", "changed": False,
                    "plan_sha256": digest, "rebooted": False}
        if status not in {"prepared", "source-updated", "rollback-failed"}:
            fail("protected boot journal state differs")
        boot_restore(directory / journal["source"]["backup"], BOOT_VFIO_PATH)
        for item in journal["initramfs"]:
            boot_restore(directory / item["backup"], Path(item["path"]))
        if not boot_verify_state(journal, "rolled-back"):
            journal["status"] = "rollback-failed"; save_boot_journal(journal_path, journal)
            fail("protected boot recovery verification failed")
        journal["status"] = "rolled-back"; save_boot_journal(journal_path, journal)
        return {"boot_configuration_transaction": "rolled-back", "changed": False,
                "plan_sha256": digest, "rebooted": False}
    finally:
        for descriptor in conflict_locks:
            os.close(descriptor)
        os.close(lock_fd)


def validate_boot_ownership_plan(value, digest):
    keys = {"activator_sha256", "authorized", "automatic_reboot", "before", "changed", "commit",
            "contract_schema_sha256", "contract_sha256", "created_at", "expires_at", "format",
            "host_key_fingerprint", "inventory_sha256", "playbook_sha256", "protected_values_exported",
            "role_sha256", "transport_sha256"}
    if not isinstance(value, dict) or set(value) != keys or \
            value["format"] != "home-lab-proxmox-boot-ownership-activation-v1" or \
            value["authorized"] is not False or value["automatic_reboot"] is not False or \
            value["changed"] is not False or value["protected_values_exported"] is not False or \
            value["host_key_fingerprint"] != FINGERPRINT or HEX40.fullmatch(value.get("commit", "")) is None:
        fail("boot ownership activation envelope differs")
    for key in ("activator_sha256", "contract_schema_sha256", "contract_sha256", "inventory_sha256",
                "playbook_sha256", "role_sha256", "transport_sha256"):
        if HEX64.fullmatch(value.get(key, "")) is None:
            fail("boot ownership activation binding is invalid")
    created, expires = parse_time(value["created_at"]), parse_time(value["expires_at"])
    now = dt.datetime.now(dt.timezone.utc).replace(microsecond=0)
    if created > now or now > expires or (expires - created).total_seconds() != 1800 or \
            hashlib.sha256(canonical(value)).hexdigest() != digest:
        fail("boot ownership activation freshness or hash differs")
    verify_repo(value)
    bindings = {
        "activator_sha256": file_hash(Path(__file__)),
        "contract_schema_sha256": file_hash(REPO / "infrastructure/contract/schema.json"),
        "playbook_sha256": file_hash(REPO / "ansible/playbooks/proxmox-boot-configuration-plan.yml"),
        "role_sha256": file_hash(REPO / "ansible/roles/proxmox_boot_configuration/tasks/main.yml"),
        "transport_sha256": file_hash(Path("/usr/local/libexec/home-lab/proxmox-ansible-deploy-transport")),
    }
    if any(value[key] != observed for key, observed in bindings.items()):
        fail("boot ownership activation implementation binding differs")
    material, _ = boot_contract_material()
    if material["handoff"] != {"current_owner": "ansible", "target_owner": "ansible", "state": "transferred",
                                "parity_required": True, "single_writer": True}:
        fail("boot ownership is not transferred to Ansible")
    current = boot_snapshot()
    if value["before"] != current or current["source"]["sha256"] != current["expected_source_sha256"] or \
            current["unexpected_vfio_device_count"] != 0 or \
            current["expected_vfio_devices_bound"] != current["expected_vfio_device_count"]:
        fail("boot ownership parity differs")
    return current


def boot_ownership_operation(value, digest):
    lock_fd = os.open(BOOT_TRANSACTION_LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
