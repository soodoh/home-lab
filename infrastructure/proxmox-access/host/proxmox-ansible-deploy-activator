        return {"boot_ownership_transaction": "committed", "changed": False, "plan_sha256": digest}
    except BlockingIOError:
        fail("protected boot lock is active")
    finally:
        os.close(lock_fd)

def storage_run(arguments, timeout=60):
    result = subprocess.run(arguments, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                            env={"LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "PATH": "/usr/sbin:/usr/bin:/sbin:/bin"},
                            timeout=timeout)
    if result.returncode or result.stderr or len(result.stdout) > 131072:
        fail("storage observation command differs")
    return result.stdout


