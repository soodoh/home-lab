def canonical(value):
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def fail(message):
    raise ValueError(message)


def read_bounded_stdin(limit):
    raw = sys.stdin.buffer.read(limit + 1)
    if len(raw) > limit:
        fail("request exceeds bound")
    value = json.loads(raw)
    if raw != canonical(value):
        fail("request is not canonical")
    return value


def read_fixed(path, expected_uid, expected_gid, expected_mode, limit):
    info = os.lstat(path)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != expected_uid or info.st_gid != expected_gid or \
            stat.S_IMODE(info.st_mode) != expected_mode or info.st_nlink != 1 or info.st_size > limit:
        fail("staged plan metadata differs")
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        raw = os.read(fd, limit + 1)
        if os.read(fd, 1):
            fail("staged plan exceeds bound")
    finally:
        os.close(fd)
    return raw


def parse_time(value):
    if not isinstance(value, str) or TIME.fullmatch(value) is None:
        fail("plan timestamp is invalid")
    return dt.datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=dt.timezone.utc)


def file_hash(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def open_low_risk_lock():
    LOW_RISK_LOCK.parent.mkdir(parents=True, exist_ok=True, mode=0o755)
    descriptor = os.open(LOW_RISK_LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    metadata = os.fstat(descriptor)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0 or metadata.st_gid != 0 or metadata.st_nlink != 1 or \
            stat.S_IMODE(metadata.st_mode) != 0o600:
        os.close(descriptor); fail("low-risk lock metadata differs")
    return descriptor


def git(*args):
    result = subprocess.run(("/usr/bin/git", "-C", str(REPO), *args), stdin=subprocess.DEVNULL,
                            capture_output=True, text=True, timeout=15, check=True)
    if result.stderr or len(result.stdout) > 65536:
        fail("repository binding command differs")
    return result.stdout.strip()


def validate_plan(value, digest):
    expected_keys = {"authorized", "commit", "contract_sha256", "created_at", "expires_at", "format",
                     "host", "host_key_fingerprint", "inventory_sha256", "marker"}
    if not isinstance(value, dict) or set(value) != expected_keys or value["format"] != "home-lab-lifecycle-marker-plan-v1" or \
            value["authorized"] is not False or value["host"] != "proxmox" or value["host_key_fingerprint"] != FINGERPRINT:
        fail("plan envelope differs")
    if not isinstance(value["commit"], str) or HEX40.fullmatch(value["commit"]) is None:
        fail("plan commit is invalid")
    if any(not isinstance(value[key], str) or HEX64.fullmatch(value[key]) is None for key in ("contract_sha256", "inventory_sha256")):
        fail("plan source hash is invalid")
    marker = value["marker"]
    if not isinstance(marker, dict) or set(marker) != {"after", "before", "path"} or marker["path"] != str(MARKER) or marker["before"] != {"exists": False}:
        fail("marker before-state differs")
    after = marker["after"]
    if not isinstance(after, dict) or set(after) != {"source_commit", "state", "updated_at", "version"} or \
            after["version"] != 1 or after["state"] != "production" or after["source_commit"] != value["commit"] or \
            after["updated_at"] != value["created_at"]:
        fail("marker after-state differs")
    created, expires = parse_time(value["created_at"]), parse_time(value["expires_at"])
    now = dt.datetime.now(dt.timezone.utc).replace(microsecond=0)
    if created > now or now > expires or (expires - created).total_seconds() != 1800:
        fail("plan freshness differs")
    if hashlib.sha256(canonical(value)).hexdigest() != digest:
        fail("plan content hash differs")
    return after


def verify_repo(plan, recovery_paths=()):
    head = git("rev-parse", "HEAD")
    clean = not git("status", "--porcelain=v1", "--untracked-files=all")
    exact = head == plan["commit"] and git("rev-parse", "origin/main") == plan["commit"]
    recovered = False
    if recovery_paths and head == git("rev-parse", "origin/main") and clean and head != plan["commit"]:
        ancestor = native(("/usr/bin/git", "-C", str(REPO), "merge-base", "--is-ancestor", plan["commit"], head), accepted=(0, 1))
        changed = tuple(line for line in git("diff", "--name-only", plan["commit"], head).splitlines() if line)
        recovered = ancestor.returncode == 0 and bool(changed) and set(changed).issubset(set(recovery_paths))
    if not clean or (not exact and not recovered):
        fail("repository commit or cleanliness differs")
    if file_hash(REPO / "infrastructure/contract/home-lab.yml") != plan["contract_sha256"] or \
            file_hash(REPO / "ansible/inventory/production.yml") != plan["inventory_sha256"]:
        fail("contract or inventory binding differs")


def verify_low_risk_authority(domain, value):
    key = "apt_repositories" if domain == "apt-repositories" else "chrony_service"
    expected_block = (f"        {key}:\n          current_owner: ansible\n          target_owner: ansible\n"
                      "          state: transferred\n          parity_required: true\n          single_writer: true")
    if expected_block not in (REPO / "infrastructure/contract/home-lab.yml").read_text():
        fail("low-risk domain ownership is not transferred to Ansible")
    projection = json.loads((REPO / "nix/proxmox/projection.json").read_text())
    if domain == "apt-repositories":
        desired_files = {item["path"]: item for item in projection["managedFiles"] if item["path"] in APT_SOURCE_PATHS}
        if tuple(sorted(desired_files)) != tuple(sorted(APT_SOURCE_PATHS)):
            fail("contracted repository projection cardinality differs")
        for item in value["records"]:
            desired = desired_files.get(item["path"])
            if desired is None or item["content"] != desired["content"] or item["after_sha256"] != hashlib.sha256(desired["content"].encode()).hexdigest() or \
                    desired.get("owner") != "root" or desired.get("group") != "root" or desired.get("mode") != "0644":
                fail("repository activation is not bound to contracted content")
        desired_keyrings = {item["path"]: item for item in projection["managedArtifacts"] if item["path"] in APT_KEYRING_PATHS}
        expected_keyrings = [{"path": path, "sha256": desired_keyrings[path]["sha256"],
                              "symlink_target": desired_keyrings[path]["symlinkTarget"]} for path in APT_KEYRING_PATHS]
        if value["keyrings"] != expected_keyrings:
            fail("repository activation is not bound to contracted keyrings")
    else:
        services = {item["name"]: item for item in projection["nativeServices"]}
        if services.get("chrony.service") != {"enabled": True, "name": "chrony.service", "state": "started"} or \
                value["desired"] != {"active": True, "enabled": True}:
            fail("chrony activation is not bound to contracted service state")


def install_marker(after):
    content = canonical(after)
    try:
        existing = os.lstat(MARKER)
    except FileNotFoundError:
        existing = None
    if existing is not None:
        if stat.S_ISREG(existing.st_mode) and existing.st_uid == 0 and existing.st_gid == 0 and \
                stat.S_IMODE(existing.st_mode) == 0o600 and existing.st_nlink == 1 and MARKER.read_bytes() == content:
            return "already-applied"
        fail("marker no longer matches absent before-state")
    parent = MARKER.parent
    parent_info = os.lstat(parent)
    if not stat.S_ISDIR(parent_info.st_mode) or parent_info.st_uid != 0 or parent_info.st_gid != 0 or stat.S_IMODE(parent_info.st_mode) & 0o022:
        fail("marker parent is unsafe")
    temporary = parent / f".{MARKER.name}.{os.getpid()}.tmp"
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        os.write(fd, content); os.fsync(fd)
    finally:
        os.close(fd)
    try:
        os.chown(temporary, 0, 0); os.chmod(temporary, 0o600); os.replace(temporary, MARKER)
        directory = os.open(parent, os.O_RDONLY | os.O_DIRECTORY)
        try: os.fsync(directory)
        finally: os.close(directory)
        info = os.lstat(MARKER)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_gid != 0 or stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1 or MARKER.read_bytes() != content:
            fail("marker postcondition failed")
    except Exception:
        temporary.unlink(missing_ok=True)
        if MARKER.exists() and MARKER.read_bytes() != content:
            MARKER.unlink(missing_ok=True)
        raise
    return "applied"


def native(arguments, accepted=(0,), timeout=300):
    environment = {"DEBIAN_FRONTEND": "noninteractive", "LC_ALL": "C", "PATH": "/usr/sbin:/usr/bin:/sbin:/bin"}
    result = subprocess.run(arguments, stdin=subprocess.DEVNULL, capture_output=True, text=True, env=environment, timeout=timeout)
    if result.returncode not in accepted or len(result.stdout) > 16 * 1024 * 1024 or len(result.stderr) > 1024 * 1024:
        fail("fixed package command failed")
    return result


def installed_inventory():
    result = native(("/usr/bin/dpkg-query", "--show", "--showformat=${binary:Package}\\t${Version}\\n"))
    lines = sorted(line for line in result.stdout.splitlines() if line)
    raw = ("\n".join(lines) + "\n").encode()
    return lines, hashlib.sha256(raw).hexdigest()


def apt_metadata():
    newest_path = None
    newest_mtime = 0
    for directory, subdirectories, files in os.walk("/var/lib/apt/lists"):
        subdirectories[:] = [name for name in subdirectories if name != "partial"]
        for name in files:
            path = os.path.join(directory, name)
            try:
                metadata = os.stat(path, follow_symlinks=False)
            except FileNotFoundError:
                continue
            if not stat.S_ISREG(metadata.st_mode) or int(metadata.st_mtime) <= newest_mtime:
                continue
            newest_path = path
            newest_mtime = int(metadata.st_mtime)
    return newest_path, newest_mtime


def solver_changes():
    result = native(("/usr/bin/apt-get", "--simulate", "--option", "Debug::NoLocking=1", "--option", "APT::Get::Show-Upgraded=true", "dist-upgrade"))
    install_pattern = re.compile(r"^Inst (\S+)(?: \[([^]]+)\])? \((\S+)(?: (.*))?\)$")
    remove_pattern = re.compile(r"^Remv (\S+)(?: \[([^]]+)\])?")
    changes = []
    for line in result.stdout.splitlines():
        match = install_pattern.match(line)
        if match:
            name, previous, candidate, origin = match.groups()
            action = "install" if previous is None else "upgrade"
            if previous is not None:
                comparison = native(("/usr/bin/dpkg", "--compare-versions", candidate, "lt", previous), accepted=(0, 1))
                if comparison.returncode == 0:
                    action = "downgrade"
            changes.append({"action": action, "candidate_version": candidate, "name": name, "origin": origin or "",
                            "previous_version": previous, "security": "security" in (origin or "").lower()})
            continue
        match = remove_pattern.match(line)
        if match:
            name, previous = match.groups()
            changes.append({"action": "remove", "candidate_version": None, "name": name, "origin": "",
                            "previous_version": previous, "security": False})
            continue
        if line.startswith(("Inst ", "Remv ")):
            fail("unrecognized APT solver transition")
    changes.sort(key=lambda item: (item["name"], item["action"], item["candidate_version"] or ""))
    return changes, hashlib.sha256(result.stdout.encode()).hexdigest()


def validate_package_plan(value, digest, allow_expired=False):
    expected_keys = {"access_evidence_sha256", "authorized", "automatic_reboot", "commit", "console_attested",
                     "contract_sha256", "created_at", "expires_at", "format", "host_key_fingerprint", "inventory_sha256",
                     "maintenance_plan_sha256", "proposal"}
    if not isinstance(value, dict) or set(value) != expected_keys or value["format"] != "home-lab-proxmox-package-activation-v1" or \
            value["authorized"] is not False or value["automatic_reboot"] is not False or value["console_attested"] is not True or \
            value["host_key_fingerprint"] != FINGERPRINT:
        fail("package activation envelope differs")
    if HEX40.fullmatch(value.get("commit", "")) is None or any(HEX64.fullmatch(value.get(key, "")) is None for key in ("access_evidence_sha256", "contract_sha256", "inventory_sha256", "maintenance_plan_sha256")):
        fail("package activation binding is invalid")
    created, expires = parse_time(value["created_at"]), parse_time(value["expires_at"])
    now = dt.datetime.now(dt.timezone.utc).replace(microsecond=0)
    if created > now or (not allow_expired and now > expires) or (expires - created).total_seconds() != 1800:
        fail("package activation freshness differs")
    if hashlib.sha256(canonical(value)).hexdigest() != digest:
        fail("package activation content hash differs")
    proposal = value["proposal"]
    required = {"change_counts", "changes", "holds", "host", "installed_inventory_sha256", "metadata_mtime_epoch",
                "metadata_newest_path", "proposal_sha256", "solver"}
    if not isinstance(proposal, dict) or not required.issubset(proposal) or proposal["host"] != "proxmox" or proposal["holds"] != [] or \
            proposal["change_counts"].get("remove") != 0 or proposal["change_counts"].get("downgrade") != 0 or not proposal["changes"]:
        fail("package proposal is not an exact safe set")
    names = set()
    for item in proposal["changes"]:
        if set(item) != {"action", "candidate_version", "name", "origin", "previous_version", "security"} or \
                item["action"] not in {"install", "upgrade"} or not isinstance(item["candidate_version"], str) or \
                re.fullmatch(r"[a-z0-9][a-z0-9+.-]*(?::[a-z0-9]+)?", item["name"]) is None or item["name"] in names:
            fail("package change set is malformed")
        names.add(item["name"])
    if proposal["changes"] != sorted(proposal["changes"], key=lambda item: (item["name"], item["action"], item["candidate_version"] or "")):
        fail("package change set is not sorted")
    return proposal


def package_journal_path(digest):
    root = Path("/var/lib/home-lab/package-transactions")
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = os.lstat(root)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_gid != 0 or stat.S_IMODE(info.st_mode) != 0o700:
        fail("package transaction root is unsafe")
    return root / f"{digest}.json"


def save_package_journal(path, value, exclusive=False):
    raw = canonical(value)
    if exclusive:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        try:
            os.write(fd, raw); os.fsync(fd)
        finally:
            os.close(fd)
        return
    temporary = path.parent / f".{path.name}.{os.getpid()}.tmp"
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        os.write(fd, raw); os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(temporary, path)


def verify_package_preconditions(proposal):
    _, inventory_sha256 = installed_inventory()
    if inventory_sha256 != proposal["installed_inventory_sha256"]:
        fail("installed package inventory changed after planning")
    metadata_path, metadata_mtime = apt_metadata()
    if metadata_path != proposal["metadata_newest_path"] or metadata_mtime != proposal["metadata_mtime_epoch"]:
        fail("APT metadata changed after planning")
    now = int(dt.datetime.now(dt.timezone.utc).timestamp())
    if metadata_mtime < 1 or now - metadata_mtime > 86400:
        fail("APT metadata is stale")
    changes, solver_sha256 = solver_changes()
    if changes != proposal["changes"] or solver_sha256 != proposal["solver"]["stdout_sha256"]:
        fail("apply-time solver differs from the saved exact proposal")


def verify_package_postconditions(proposal):
    for item in proposal["changes"]:
        result = native(("/usr/bin/dpkg-query", "--show", "--showformat=${Version}", item["name"]))
        if result.stdout != item["candidate_version"]:
            fail("package postcondition differs")
    audit = native(("/usr/bin/dpkg", "--audit"))
    if audit.stdout or audit.stderr:
        fail("dpkg audit is not clean")
    remaining, _ = solver_changes()
    if remaining:
        fail("package solver is not empty after apply")


def package_operation(value, digest, operation):
    proposal = validate_package_plan(value, digest, allow_expired=operation == "recover-package")
    if operation != "recover-package":
        verify_repo(value)
    lock_path = "/run/lock/home-lab-proxmox-package.lock"
    lock_fd = os.open(lock_path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    journal_path = package_journal_path(digest)
    journal = json.loads(journal_path.read_bytes()) if journal_path.exists() else None
    if operation == "prepare-package":
        if journal is not None:
            if journal.get("status") == "prepared":
                return {"package_transaction": "already-prepared", "plan_sha256": digest}
            fail("package transaction journal already exists")
        verify_package_preconditions(proposal)
        save_package_journal(journal_path, {"format": "home-lab-proxmox-package-journal-v1", "plan_sha256": digest,
                                            "status": "preparing", "automatic_reboot": False}, exclusive=True)
        native(("/usr/bin/apt-get", "--yes", "--no-remove", "--download-only", "--option", "APT::Get::Show-Upgraded=true", "dist-upgrade"), timeout=1800)
        journal = {"format": "home-lab-proxmox-package-journal-v1", "plan_sha256": digest,
                   "status": "prepared", "automatic_reboot": False}
        save_package_journal(journal_path, journal)
        return {"package_transaction": "prepared", "plan_sha256": digest}
    if journal is None or journal.get("plan_sha256") != digest:
        fail("package transaction journal differs")
    if journal.get("status") == "committed":
        return {"automatic_reboot": False, "package_transaction": "already-committed", "plan_sha256": digest}
    if operation == "recover-package":
        if journal.get("status") != "applying":
            fail("package transaction is not recoverable")
        verify_package_postconditions(proposal)
        journal["status"] = "committed"; save_package_journal(journal_path, journal)
        return {"automatic_reboot": False, "package_transaction": "recovered-committed", "plan_sha256": digest}
    if journal.get("status") != "prepared":
        fail("package transaction is not prepared")
    verify_package_preconditions(proposal)
    journal["status"] = "applying"; save_package_journal(journal_path, journal)
    native(("/usr/bin/apt-get", "--yes", "--no-remove", "--no-download", "--option", "Dpkg::Options::=--force-confold",
            "--option", "APT::Get::Show-Upgraded=true", "dist-upgrade"), timeout=3600)
    verify_package_postconditions(proposal)
    journal["status"] = "committed"; save_package_journal(journal_path, journal)
    return {"automatic_reboot": False, "package_transaction": "committed", "plan_sha256": digest}


def validate_repository_plan(value, digest, allow_expired=False):
    expected_keys = {"authorized", "automatic_reboot", "commit", "contract_sha256", "created_at", "domain",
                     "expires_at", "format", "host", "host_key_fingerprint", "inventory_sha256", "keyrings",
                     "metadata_refresh", "records", "unknown_source_files"}
    if not isinstance(value, dict) or set(value) != expected_keys or \
            value["format"] != "home-lab-proxmox-low-risk-activation-v1" or value["domain"] != "apt-repositories" or \
            value["host"] != "proxmox" or value["host_key_fingerprint"] != FINGERPRINT or \
            value["authorized"] is not False or value["automatic_reboot"] is not False or value["metadata_refresh"] is not False:
        fail("repository activation envelope differs")
    if not isinstance(value["commit"], str) or HEX40.fullmatch(value["commit"]) is None or \
            any(not isinstance(value[name], str) or HEX64.fullmatch(value[name]) is None for name in ("contract_sha256", "inventory_sha256")):
        fail("repository activation source hash differs")
    created, expires = parse_time(value["created_at"]), parse_time(value["expires_at"])
    now = dt.datetime.now(dt.timezone.utc)
    if expires - created != dt.timedelta(seconds=1800) or now < created or (now > expires and not allow_expired):
        fail("repository activation freshness differs")
    if hashlib.sha256(canonical(value)).hexdigest() != digest or value["unknown_source_files"] != []:
        fail("repository activation hash or source cardinality differs")
    if not isinstance(value["records"], list) or len(value["records"]) != len(APT_SOURCE_PATHS):
        fail("repository record cardinality differs")
    records = []
    for item, expected_path in zip(value["records"], APT_SOURCE_PATHS):
        if not isinstance(item, dict) or set(item) != {"after_sha256", "before_sha256", "content", "gid", "mode", "path", "uid"} or \
                item["path"] != expected_path or item["uid"] != 0 or item["gid"] != 0 or item["mode"] != "0644" or \
                not isinstance(item["content"], str) or len(item["content"].encode()) > 16384 or \
                any(not isinstance(item[name], str) or HEX64.fullmatch(item[name]) is None for name in ("before_sha256", "after_sha256")) or \
                hashlib.sha256(item["content"].encode()).hexdigest() != item["after_sha256"]:
            fail("repository record differs")
        records.append(item)
    if not isinstance(value["keyrings"], list) or len(value["keyrings"]) != len(APT_KEYRING_PATHS):
        fail("repository keyring cardinality differs")
    for item, expected_path in zip(value["keyrings"], APT_KEYRING_PATHS):
        if not isinstance(item, dict) or set(item) != {"path", "sha256", "symlink_target"} or item["path"] != expected_path or \
                not isinstance(item["sha256"], str) or HEX64.fullmatch(item["sha256"]) is None or \
                item["symlink_target"] not in (None, "debian-archive-keyring.pgp") or \
                (expected_path != APT_KEYRING_PATHS[0] and item["symlink_target"] is not None) or \
                (expected_path == APT_KEYRING_PATHS[0] and item["symlink_target"] != "debian-archive-keyring.pgp"):
            fail("repository keyring record differs")
    return records


def repository_snapshot(path):
    metadata = os.lstat(path)
    if not stat.S_ISREG(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode) or metadata.st_nlink != 1 or \
            metadata.st_uid != 0 or metadata.st_gid != 0 or stat.S_IMODE(metadata.st_mode) != 0o644:
        fail(f"repository file metadata differs: {path}")
    content = path.read_bytes()
    return content, hashlib.sha256(content).hexdigest()


def verify_repository_keyrings(value):
    for item in value["keyrings"]:
        path = Path(item["path"]); metadata = os.lstat(path); expected_target = item["symlink_target"]
        if expected_target is None:
            content_path = path
            if not stat.S_ISREG(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode):
                fail("repository keyring type differs")
        else:
            if not stat.S_ISLNK(metadata.st_mode) or os.readlink(path) != expected_target or metadata.st_uid != 0 or metadata.st_gid != 0:
                fail("repository keyring symlink differs")
            content_path = path.parent / expected_target
        content_metadata = os.lstat(content_path)
        if not stat.S_ISREG(content_metadata.st_mode) or stat.S_ISLNK(content_metadata.st_mode) or content_metadata.st_nlink != 1 or \
                content_metadata.st_uid != 0 or content_metadata.st_gid != 0 or stat.S_IMODE(content_metadata.st_mode) != 0o644 or \
                hashlib.sha256(content_path.read_bytes()).hexdigest() != item["sha256"]:
            fail("repository keyring content or metadata differs")


def save_low_risk_journal(directory, value):
    LOW_RISK_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    parent_metadata = os.lstat(LOW_RISK_DIR)
    if not stat.S_ISDIR(parent_metadata.st_mode) or stat.S_ISLNK(parent_metadata.st_mode) or parent_metadata.st_uid != 0 or \
            parent_metadata.st_gid != 0 or stat.S_IMODE(parent_metadata.st_mode) != 0o700:
        fail("low-risk journal parent metadata differs")
    if not os.path.lexists(directory): os.mkdir(directory, 0o700)
    metadata = os.lstat(directory)
    if not stat.S_ISDIR(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode) or metadata.st_uid != 0 or metadata.st_gid != 0 or \
            stat.S_IMODE(metadata.st_mode) != 0o700:
        fail("low-risk journal directory metadata differs")
    target = directory / "journal.json"; temporary = directory / ".journal.tmp"
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    try:
        os.write(descriptor, canonical(value)); os.fsync(descriptor)
    finally:
        os.close(descriptor)
    os.replace(temporary, target); os.chown(target, 0, 0); os.chmod(target, 0o600)
    fsync_directory(directory)


def replace_repository_file(path, content):
    temporary = path.parent / f".{path.name}.home-lab.tmp"
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        os.write(descriptor, content); os.fchmod(descriptor, 0o644); os.fchown(descriptor, 0, 0); os.fsync(descriptor)
    finally:
        os.close(descriptor)
    os.replace(temporary, path)
    directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
    try: os.fsync(directory_fd)
    finally: os.close(directory_fd)


def fsync_directory(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try: os.fsync(descriptor)
    finally: os.close(descriptor)


def rollback_repository(directory, records):
    for index, item in reversed(list(enumerate(records))):
        _, current_hash = repository_snapshot(Path(item["path"]))
        if current_hash == item["before_sha256"]:
            continue
        if current_hash != item["after_sha256"] or item["before_sha256"] == item["after_sha256"]:
            fail("repository rollback found unrecognized file state")
        backup = directory / f"before-{index}.bin"; content = read_fixed(backup, 0, 0, 0o600, 16384)
        if hashlib.sha256(content).hexdigest() != item["before_sha256"]:
            fail("repository rollback backup differs")
        replace_repository_file(Path(item["path"]), content)
    for item in records:
        _, current_hash = repository_snapshot(Path(item["path"]))
        if current_hash != item["before_sha256"]:
            fail("repository rollback postcondition differs")


def repository_operation(value, digest):
    lock_descriptor = open_low_risk_lock(); package_locks = []
    try:
        fcntl.flock(lock_descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        records = validate_repository_plan(value, digest); verify_repo(value); verify_low_risk_authority("apt-repositories", value)
        verify_repository_keyrings(value)
        unknown = sorted(name for name in os.listdir("/etc/apt/sources.list.d")
                         if name not in {Path(path).name for path in APT_SOURCE_PATHS[1:]})
        if unknown: fail("unrecognized repository source file is present")
        for lock_path in APT_LOCK_PATHS:
            descriptor = os.open(lock_path, os.O_RDWR | os.O_NOFOLLOW)
            try: fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except Exception: os.close(descriptor); raise
            package_locks.append(descriptor)
        directory = LOW_RISK_DIR / digest; journal_path = directory / "journal.json"
        if os.path.lexists(journal_path):
            existing = json.loads(read_fixed(journal_path, 0, 0, 0o600, 65536))
            if existing.get("plan_sha256") != digest or existing.get("format") != "home-lab-proxmox-low-risk-journal-v1":
                fail("repository journal differs")
            if existing.get("status") == "committed":
                for item in records:
                    _, current_hash = repository_snapshot(Path(item["path"]))
                    if current_hash != item["after_sha256"]: fail("committed repository postcondition differs")
                return {"changed_files": existing.get("changed_files", 0), "plan_sha256": digest,
                        "repository_transaction": "committed"}
            fail("repository transaction requires fixed recovery")
        before = {}
        for item in records:
            path = Path(item["path"]); content, current_hash = repository_snapshot(path)
            if current_hash != item["before_sha256"]: fail("repository before-state changed")
            before[item["path"]] = content
        journal = {"automatic_reboot": False, "domain": "apt-repositories", "format": "home-lab-proxmox-low-risk-journal-v1",
                   "metadata_refresh": False, "plan_sha256": digest,
                   "records": [{"after_sha256": item["after_sha256"], "before_sha256": item["before_sha256"], "path": item["path"]}
                               for item in records], "status": "applying"}
        save_low_risk_journal(directory, journal)
        for index, item in enumerate(records):
            if item["before_sha256"] == item["after_sha256"]: continue
            backup = directory / f"before-{index}.bin"
            descriptor = os.open(backup, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            try: os.write(descriptor, before[item["path"]]); os.fsync(descriptor)
            finally: os.close(descriptor)
        fsync_directory(directory)
        try:
            for item in records:
                if item["before_sha256"] != item["after_sha256"]:
                    replace_repository_file(Path(item["path"]), item["content"].encode())
            if native(["/usr/bin/apt-get", "indextargets"]).returncode != 0: fail("APT rejected repository sources")
            for item in records:
                _, current_hash = repository_snapshot(Path(item["path"]))
                if current_hash != item["after_sha256"]: fail("repository postcondition differs")
        except Exception:
            rollback_repository(directory, records)
            journal["status"] = "rolled-back"; save_low_risk_journal(directory, journal); raise
        changed_files = sum(item["before_sha256"] != item["after_sha256"] for item in records)
        journal["status"] = "committed"; journal["changed_files"] = changed_files; save_low_risk_journal(directory, journal)
        return {"changed_files": changed_files, "plan_sha256": digest, "repository_transaction": "committed"}
    except BlockingIOError:
        fail("low-risk or package manager lock is active")
    finally:
        for descriptor in package_locks: os.close(descriptor)
        os.close(lock_descriptor)


def recover_repository(value, digest):
    lock_descriptor = open_low_risk_lock(); package_locks = []
    try:
        fcntl.flock(lock_descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        records = validate_repository_plan(value, digest, allow_expired=True); verify_repo(value)
        verify_low_risk_authority("apt-repositories", value); verify_repository_keyrings(value)
        unknown = sorted(name for name in os.listdir("/etc/apt/sources.list.d")
                         if name not in {Path(path).name for path in APT_SOURCE_PATHS[1:]})
        if unknown: fail("unrecognized repository source file is present")
        for lock_path in APT_LOCK_PATHS:
            descriptor = os.open(lock_path, os.O_RDWR | os.O_NOFOLLOW)
            try: fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except Exception: os.close(descriptor); raise
            package_locks.append(descriptor)
        directory = LOW_RISK_DIR / digest; journal = json.loads(read_fixed(directory / "journal.json", 0, 0, 0o600, 65536))
        expected_records = [{"after_sha256": item["after_sha256"], "before_sha256": item["before_sha256"], "path": item["path"]}
                            for item in records]
        if journal.get("format") != "home-lab-proxmox-low-risk-journal-v1" or journal.get("plan_sha256") != digest or \
                journal.get("domain") != "apt-repositories" or journal.get("records") != expected_records:
            fail("repository recovery journal differs")
        states = []
        for item in records:
            _, current_hash = repository_snapshot(Path(item["path"]))
            if current_hash not in (item["before_sha256"], item["after_sha256"]):
                fail("repository recovery found unrecognized file state")
            states.append(current_hash)
        if all(current == item["after_sha256"] for current, item in zip(states, records)):
            journal["status"] = "committed"
            journal["changed_files"] = sum(item["before_sha256"] != item["after_sha256"] for item in records)
            save_low_risk_journal(directory, journal)
            return {"plan_sha256": digest, "repository_transaction": "committed"}
        rollback_repository(directory, records)
        journal["status"] = "rolled-back"; save_low_risk_journal(directory, journal)
        return {"plan_sha256": digest, "repository_transaction": "rolled-back"}
    except BlockingIOError:
        fail("low-risk or package manager lock is active")
    finally:
        for descriptor in package_locks: os.close(descriptor)
        os.close(lock_descriptor)


def validate_chrony_plan(value, digest, allow_expired=False):
    keys = {"authorized", "automatic_reboot", "before", "commit", "config_mutation", "contract_sha256", "created_at",
            "desired", "domain", "expires_at", "format", "host", "host_key_fingerprint", "inventory_sha256", "restart_if_healthy"}
    if not isinstance(value, dict) or set(value) != keys or value["format"] != "home-lab-proxmox-low-risk-activation-v1" or \
            value["domain"] != "chrony-service" or value["host"] != "proxmox" or value["host_key_fingerprint"] != FINGERPRINT or \
            value["authorized"] is not False or value["automatic_reboot"] is not False or value["config_mutation"] is not False or \
            value["restart_if_healthy"] is not False or value["desired"] != {"active": True, "enabled": True} or \
            not isinstance(value["before"], dict) or set(value["before"]) != {"active", "enabled"} or \
            any(not isinstance(value["before"][name], bool) for name in ("active", "enabled")):
        fail("chrony activation envelope differs")
    if not isinstance(value["commit"], str) or HEX40.fullmatch(value["commit"]) is None or \
            any(not isinstance(value[name], str) or HEX64.fullmatch(value[name]) is None for name in ("contract_sha256", "inventory_sha256")):
        fail("chrony activation source hash differs")
    created, expires = parse_time(value["created_at"]), parse_time(value["expires_at"]); now = dt.datetime.now(dt.timezone.utc)
    if expires - created != dt.timedelta(seconds=1800) or now < created or (now > expires and not allow_expired) or \
            hashlib.sha256(canonical(value)).hexdigest() != digest:
        fail("chrony activation freshness or hash differs")
    return value["before"]


def chrony_state(require_health=False):
    result = native(["/usr/bin/systemctl", "show", "chrony.service", "--property=ActiveState", "--property=DropInPaths",
                     "--property=FragmentPath", "--property=UnitFileState"])
    values = dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)
    if values.get("FragmentPath") != "/usr/lib/systemd/system/chrony.service" or values.get("DropInPaths") != "" or \
            values.get("ActiveState") not in ("active", "inactive") or values.get("UnitFileState") not in ("enabled", "disabled"):
        fail("chrony unit provenance or state differs")
    state = {"active": values["ActiveState"] == "active", "enabled": values["UnitFileState"] == "enabled"}
    if require_health:
        tracking = native(["/usr/bin/chronyc", "tracking"]); parsed = {}
        for line in tracking.stdout.splitlines():
            if ":" in line:
                key, item = line.split(":", 1); parsed[key.strip()] = item.strip()
        try: stratum = int(parsed.get("Stratum", "0"))
        except ValueError: stratum = 0
        if parsed.get("Leap status") != "Normal" or not 1 <= stratum <= 15:
            fail("chrony tracking health differs")
    return state


def chrony_operation(value, digest):
    lock_descriptor = open_low_risk_lock()
    try:
        fcntl.flock(lock_descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        before = validate_chrony_plan(value, digest); verify_repo(value); verify_low_risk_authority("chrony-service", value)
        directory = LOW_RISK_DIR / digest; journal_path = directory / "journal.json"
        if os.path.lexists(journal_path):
            journal = json.loads(read_fixed(journal_path, 0, 0, 0o600, 65536))
            if journal.get("format") != "home-lab-proxmox-low-risk-journal-v1" or journal.get("plan_sha256") != digest:
                fail("chrony journal differs")
            if journal.get("status") == "committed" and chrony_state(require_health=True) == {"active": True, "enabled": True}:
                return {"changed": journal.get("changed", False), "chrony_transaction": "committed", "plan_sha256": digest}
            fail("chrony transaction requires fixed recovery")
        current = chrony_state(require_health=before["active"])
        if current != before: fail("chrony before-state changed")
        journal = {"automatic_reboot": False, "before": before, "config_mutation": False, "domain": "chrony-service",
                   "format": "home-lab-proxmox-low-risk-journal-v1", "plan_sha256": digest, "restart_if_healthy": False,
                   "status": "applying"}
        save_low_risk_journal(directory, journal); changed = False
        try:
            if not before["enabled"]: native(["/usr/bin/systemctl", "enable", "chrony.service"]); changed = True
            if not before["active"]: native(["/usr/bin/systemctl", "start", "chrony.service"]); changed = True
            if chrony_state(require_health=True) != {"active": True, "enabled": True}: fail("chrony postcondition differs")
        except Exception:
            if not before["active"]: native(["/usr/bin/systemctl", "stop", "chrony.service"])
            if not before["enabled"]: native(["/usr/bin/systemctl", "disable", "chrony.service"])
            journal["status"] = "rolled-back"; save_low_risk_journal(directory, journal); raise
        journal["status"] = "committed"; journal["changed"] = changed; save_low_risk_journal(directory, journal)
        return {"changed": changed, "chrony_transaction": "committed", "plan_sha256": digest}
    except BlockingIOError:
        fail("low-risk lock is active")
    finally:
        os.close(lock_descriptor)


def recover_chrony(value, digest):
    lock_descriptor = open_low_risk_lock()
    try:
        fcntl.flock(lock_descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        before = validate_chrony_plan(value, digest, allow_expired=True); verify_repo(value)
        verify_low_risk_authority("chrony-service", value)
        directory = LOW_RISK_DIR / digest; journal = json.loads(read_fixed(directory / "journal.json", 0, 0, 0o600, 65536))
        if journal.get("format") != "home-lab-proxmox-low-risk-journal-v1" or journal.get("plan_sha256") != digest or \
                journal.get("domain") != "chrony-service" or journal.get("before") != before:
            fail("chrony recovery journal differs")
        current = chrony_state(require_health=False)
        if current == {"active": True, "enabled": True}:
            chrony_state(require_health=True); journal["status"] = "committed"; journal["changed"] = current != before
            save_low_risk_journal(directory, journal)
            return {"chrony_transaction": "committed", "plan_sha256": digest}
        if current["active"] and not before["active"]: native(["/usr/bin/systemctl", "stop", "chrony.service"])
        if current["enabled"] and not before["enabled"]: native(["/usr/bin/systemctl", "disable", "chrony.service"])
        if not current["enabled"] and before["enabled"]: native(["/usr/bin/systemctl", "enable", "chrony.service"])
        if not current["active"] and before["active"]: native(["/usr/bin/systemctl", "start", "chrony.service"])
        if chrony_state(require_health=before["active"]) != before: fail("chrony rollback postcondition differs")
        journal["status"] = "rolled-back"; save_low_risk_journal(directory, journal)
        return {"chrony_transaction": "rolled-back", "plan_sha256": digest}
    except BlockingIOError:
        fail("low-risk lock is active")
    finally:
        os.close(lock_descriptor)


def boot_contract_material(allow_ready=True):
    try:
        import yaml
    except ImportError as error:
        raise ValueError("protected boot contract parser is unavailable") from error
    try:
        contract = yaml.safe_load((REPO / "infrastructure/contract/home-lab.yml").read_text(encoding="utf-8"))
        value = {"handoff": contract["lifecycle"]["hosts"]["proxmox"]["domain_handoffs"]["boot_configuration"],
                 "file": contract["proxmox"]["vfio"]["modprobe_file"],
                 "device_ids": contract["proxmox"]["vfio"]["device_ids"],
                 "soft_dependencies": contract["proxmox"]["vfio"]["soft_dependencies"],
                 "kernels": contract["proxmox"]["kernels"]}
    except (KeyError, OSError, TypeError, yaml.YAMLError) as error:
        raise ValueError("protected boot contract is invalid") from error
    required = {"device_ids", "file", "handoff", "kernels", "soft_dependencies"}
    handoff = value.get("handoff") if isinstance(value, dict) else None
    allowed_handoffs = [("nix", "ansible", "pending")]
    if allow_ready:
        allowed_handoffs.extend((("nix", "ansible", "ready"), ("ansible", "ansible", "transferred")))
    if not isinstance(value, dict) or set(value) != required or not isinstance(handoff, dict) or \
            set(handoff) != {"current_owner", "target_owner", "state", "parity_required", "single_writer"} or \
            (handoff["current_owner"], handoff["target_owner"], handoff["state"]) not in allowed_handoffs or \
            handoff["parity_required"] is not True or handoff["single_writer"] is not True:
        fail("protected boot ownership is not in an allowed handoff state")
    file_policy = value["file"]
    if file_policy != {"kind": "protected-managed-file", "projectable": False,
                       "path": str(BOOT_VFIO_PATH), "owner": "root", "group": "root", "mode": "0644"}:
        fail("protected boot file policy differs")
    device_ids = value["device_ids"]
    dependencies = value["soft_dependencies"]
    kernels = value["kernels"]
    if not isinstance(device_ids, list) or len(device_ids) != 2 or len(set(device_ids)) != 2 or \
            any(re.fullmatch(r"[0-9a-f]{4}:[0-9a-f]{4}", item) is None for item in device_ids) or \
            not isinstance(dependencies, list) or len(dependencies) != 2 or \
            not isinstance(kernels, dict) or set(kernels) != {"current", "fallback", "retention_count", "require_boot_history_proof"} or \
            kernels["retention_count"] != 2 or kernels["require_boot_history_proof"] is not True or \
            any(re.fullmatch(r"[0-9A-Za-z.+~-]+", kernels[name]) is None for name in ("current", "fallback")):
        fail("protected boot material differs")
    lines = ["options vfio-pci ids=" + ",".join(device_ids)]
    for dependency in dependencies:
        if not isinstance(dependency, dict) or set(dependency) != {"module", "pre"} or \
                not isinstance(dependency["module"], str) or not isinstance(dependency["pre"], list) or \
                not dependency["pre"] or any(not isinstance(item, str) for item in dependency["pre"]):
            fail("protected boot dependency differs")
        lines.append("softdep " + dependency["module"] + " pre: " + " ".join(dependency["pre"]))
    return value, ("\n".join(lines) + "\n").encode()


def boot_file_record(path):
    try:
        metadata = os.lstat(path)
    except FileNotFoundError:
        fail("protected boot file is absent")
    if not stat.S_ISREG(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode) or metadata.st_uid != 0 or \
            metadata.st_gid != 0 or metadata.st_nlink != 1 or stat.S_IMODE(metadata.st_mode) != 0o644:
        fail("protected boot file metadata differs")
    return {"gid": metadata.st_gid, "mode": "0644", "mtime_ns": metadata.st_mtime_ns,
            "nlink": metadata.st_nlink, "path": str(path), "sha256": file_hash(path), "size": metadata.st_size,
            "uid": metadata.st_uid}


def boot_snapshot(allow_ready=True):
    if git("status", "--porcelain=v1", "--untracked-files=all"):
        fail("protected boot host checkout is not clean")
    commit = git("rev-parse", "HEAD")
    material, expected = boot_contract_material(allow_ready=allow_ready)
    source = boot_file_record(BOOT_VFIO_PATH)
    initramfs = []
    for role in ("current", "fallback"):
        kernel = material["kernels"][role]
        record = boot_file_record(Path("/boot") / f"initrd.img-{kernel}")
        record.update({"kernel": kernel, "role": role})
        initramfs.append(record)
    expected_ids = set(material["device_ids"])
    expected_bound = 0
    total_bound = 0
    try:
        entries = tuple(Path("/sys/bus/pci/devices").iterdir())
    except OSError:
        fail("protected PCI observation is unavailable")
    for entry in entries:
        try:
            driver = (entry / "driver").resolve(strict=True).name
        except OSError:
            continue
        if driver != "vfio-pci":
            continue
        total_bound += 1
        try:
            identifier = (entry / "vendor").read_text().strip().removeprefix("0x").lower() + ":" + \
                         (entry / "device").read_text().strip().removeprefix("0x").lower()
        except OSError:
            fail("protected PCI identity is unavailable")
        if identifier in expected_ids:
            expected_bound += 1
    return {"commit": commit, "contract_sha256": file_hash(REPO / "infrastructure/contract/home-lab.yml"),
            "expected_source_sha256": hashlib.sha256(expected).hexdigest(),
            "expected_vfio_device_count": len(expected_ids), "expected_vfio_devices_bound": expected_bound,
            "format": "home-lab-proxmox-protected-boot-observation-v1", "initramfs": initramfs,
            "source": source, "unexpected_vfio_device_count": max(0, total_bound - len(expected_ids)), "version": 1}


def validate_boot_plan(value, digest, allow_expired=False):
    required = {"activator_sha256", "authorized", "automatic_reboot", "before", "commit", "contract_schema_sha256",
