{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diloreto.com/schemas/home-lab-v1.json",
  "title": "Home lab infrastructure contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "system_name", "recovery", "network", "proxmox", "storage", "arch", "omada", "tailscale", "aws", "backups"],
  "properties": {
    "version": { "const": 1 },
    "system_name": { "const": "home-lab" },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_max_age_days", "critical_rpo_hours", "critical_rto_hours", "recovery_age_recipient"],
      "properties": {
        "evidence_max_age_days": { "type": "integer", "minimum": 1, "maximum": 365 },
        "critical_rpo_hours": { "type": "integer", "maximum": 24 },
        "critical_rto_hours": { "type": "integer", "maximum": 8 },
        "recovery_age_recipient": { "$ref": "#/$defs/ageRecipient" }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cidr", "gateway", "dns", "bridge", "bridge_port", "ownership", "proxmox", "arch"],
      "properties": {
        "cidr": { "$ref": "#/$defs/cidr" },
        "gateway": { "$ref": "#/$defs/ipv4" },
        "dns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ipv4" } },
        "bridge": { "type": "string", "minLength": 1 },
        "bridge_port": { "type": "string", "minLength": 1 },
        "ownership": { "$ref": "#/$defs/networkOwnership" },
        "proxmox": { "$ref": "#/$defs/host" },
        "arch": { "$ref": "#/$defs/host" }
      }
    },
    "proxmox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "api_endpoint", "vfio", "apt", "services", "access", "ssh", "tailscale", "firewall", "packages", "kernels", "root_cleanup", "vm", "legacy_container"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "api_endpoint": { "type": "string", "pattern": "^https://" },
        "vfio": { "$ref": "#/$defs/vfioPolicy" },
        "apt": { "$ref": "#/$defs/aptPolicy" },
        "services": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/systemdService" } },
        "access": { "$ref": "#/$defs/proxmoxAccessPolicy" },
        "ssh": { "$ref": "#/$defs/proxmoxSshPolicy" },
        "tailscale": { "$ref": "#/$defs/proxmoxTailscalePolicy" },
        "firewall": { "$ref": "#/$defs/proxmoxFirewallPolicy" },
        "packages": { "$ref": "#/$defs/hostPackagePolicy" },
        "kernels": { "$ref": "#/$defs/kernelPolicy" },
        "root_cleanup": { "$ref": "#/$defs/rootCleanupPolicy" },
        "vm": { "$ref": "#/$defs/vm" },
        "legacy_container": { "$ref": "#/$defs/legacyContainer" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zfs", "nfs"],
      "properties": {
        "zfs": { "$ref": "#/$defs/zfs" },
        "nfs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["export", "client", "client_vmid", "mountpoint", "retain_no_root_squash"],
          "properties": {
            "export": { "type": "string", "pattern": "^/" },
            "client": { "$ref": "#/$defs/cidr" },
            "client_vmid": { "const": 100 },
            "mountpoint": { "type": "string", "pattern": "^/" },
            "retain_no_root_squash": { "type": "boolean" }
          }
        }
      }
    },
    "arch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_interface", "user", "games_mountpoint", "repository_snapshot", "packages", "coral"],
      "properties": {
        "network_interface": { "type": "string", "minLength": 1 },
        "user": { "type": "string", "minLength": 1 },
        "games_mountpoint": { "type": "string", "pattern": "^/" },
        "repository_snapshot": { "type": "string", "pattern": "^[0-9]{4}/[0-9]{2}/[0-9]{2}$" },
        "packages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kernel", "docker", "docker_compose", "tailscale"],
          "properties": {
            "kernel": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.arch[0-9]+-[1-9][0-9]*$" },
            "docker": { "type": "string", "pattern": "^[1-9][0-9]*:[0-9]+\\.[0-9]+\\.[0-9]+-[1-9][0-9]*$" },
            "docker_compose": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-[1-9][0-9]*$" },
            "tailscale": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-[1-9][0-9]*$" }
          }
        },
        "coral": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package_version", "dkms_version", "source_commit", "source_tree_sha256", "build_image", "source_date_epoch", "package_sha256"],
          "properties": {
            "package_version": { "type": "string", "pattern": "^r[0-9]+\\.[0-9a-f]+-[1-9][0-9]*$" },
            "dkms_version": { "type": "string", "pattern": "^r[0-9]+\\.[0-9a-f]+$" },
            "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "source_tree_sha256": { "$ref": "#/$defs/sha256" },
            "build_image": { "type": "string", "pattern": "^[^@]+@sha256:[0-9a-f]{64}$" },
            "source_date_epoch": { "type": "integer", "minimum": 1 },
            "package_sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "omada": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller_version", "endpoint", "export_path"],
      "properties": {
        "controller_version": { "type": "string" },
        "endpoint": { "type": "string", "pattern": "^https://" },
        "export_path": { "type": "string", "minLength": 1 }
      }
    },
    "tailscale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_identity", "tags", "required_endpoints"],
      "properties": {
        "owner_identity": { "const": "soodoh@github" },
        "tags": {
          "type": "object",
          "additionalProperties": false,
          "required": ["arch", "proxmox"],
          "properties": {
            "arch": { "type": "string", "pattern": "^tag:" },
            "proxmox": { "type": "string", "pattern": "^tag:" }
          }
        },
        "required_endpoints": { "type": "array", "minItems": 4, "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "aws": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "recovery_region", "state_bucket", "recovery_bucket", "kms_alias"],
      "properties": {
        "region": { "type": "string", "pattern": "^[a-z]{2}-[a-z]+-[0-9]+$" },
        "recovery_region": { "type": "string", "pattern": "^[a-z]{2}-[a-z]+-[0-9]+$" },
        "state_bucket": { "anyOf": [{ "$ref": "#/$defs/bucket" }, { "type": "null" }] },
        "recovery_bucket": { "anyOf": [{ "$ref": "#/$defs/bucket" }, { "type": "null" }] },
        "kms_alias": { "type": "string", "pattern": "^alias/" }
      }
    },
    "backups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_schedule", "local_paths", "estimated_archive_bytes", "remote_schedule", "remote_rpo_hours", "remote_retention_days", "local_retention_days", "home_retention_days", "excluded_classes"],
      "properties": {
        "local_schedule": { "type": "string", "minLength": 9 },
        "local_paths": {
          "type": "array",
          "prefixItems": [
            { "const": "/home/docker/backups" },
            { "const": "/mnt/games/backups" },
            { "const": "/mnt/storage/backups" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "estimated_archive_bytes": { "type": "integer", "minimum": 1000000000 },
        "remote_schedule": { "type": "string", "minLength": 9 },
        "remote_rpo_hours": { "type": "integer", "minimum": 24 },
        "remote_retention_days": { "type": "integer", "minimum": 2 },
        "local_retention_days": { "type": "integer", "minimum": 2 },
        "home_retention_days": { "const": 2 },
        "excluded_classes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  },
  "$defs": {
    "ipv4": { "type": "string", "pattern": "^(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])){3}$" },
    "cidr": { "type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/(3[0-2]|[12]?[0-9])$" },
    "mac": { "type": "string", "pattern": "^([0-9A-F]{2}:){5}[0-9A-F]{2}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha256Digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "ageRecipient": { "type": "string", "pattern": "^age1[0-9a-z]{50,}$" },
    "bucket": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$" },
    "packageName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9+.-]+$" },
    "pveKernelRelease": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-[0-9]+-pve$" },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "magicdns_name", "ipv4", "mac"],
      "properties": {
        "hostname": { "type": "string", "minLength": 1 },
        "magicdns_name": { "type": "string", "minLength": 1 },
        "ipv4": { "$ref": "#/$defs/cidr" },
        "mac": { "$ref": "#/$defs/mac" }
      }
    },
    "networkOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interfaces_file", "snippets_directory", "permitted_active_snippets"],
      "properties": {
        "interfaces_file": { "const": "/etc/network/interfaces" },
        "snippets_directory": { "const": "/etc/network/interfaces.d" },
        "permitted_active_snippets": { "type": "array", "maxItems": 0 }
      }
    },
    "vfioPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modules", "device_ids", "prohibited_modules"],
      "properties": {
        "modules": { "type": "array", "prefixItems": [{ "const": "vfio" }, { "const": "vfio_iommu_type1" }, { "const": "vfio_pci" }], "items": false, "minItems": 3, "maxItems": 3 },
        "device_ids": { "type": "array", "prefixItems": [{ "const": "1ac1:089a" }, { "const": "1002:744c" }, { "const": "1002:ab30" }], "items": false, "minItems": 3, "maxItems": 3, "uniqueItems": true },
        "prohibited_modules": { "type": "array", "prefixItems": [{ "const": "apex" }, { "const": "gasket" }], "items": false, "minItems": 2, "maxItems": 2, "uniqueItems": true }
      }
    },
    "aptRepository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "file", "types", "uris", "suites", "components", "signed_by"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "pattern": "^/etc/apt/sources\\.list\\.d/[a-z0-9-]+\\.sources$" },
        "types": { "type": "array", "prefixItems": [{ "const": "deb" }], "items": false, "minItems": 1, "maxItems": 1 },
        "uris": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^https?://" } },
        "suites": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "components": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "signed_by": { "type": "string", "pattern": "^/usr/share/keyrings/[a-z0-9-]+\\.(gpg|asc)$" }
      }
    },
    "aptKeyring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256", "source_url", "symlink_target"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
        "path": { "type": "string", "pattern": "^/usr/share/keyrings/[a-z0-9-]+\\.(gpg|asc)$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source_url": { "anyOf": [{ "type": "string", "pattern": "^https://" }, { "type": "null" }] },
        "symlink_target": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*\\.(gpg|pgp|asc)$" },
            { "type": "null" }
          ]
        }
      }
    },
    "aptPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories", "permitted_keyrings"],
      "properties": {
        "repositories": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/aptRepository" } },
        "permitted_keyrings": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/aptKeyring" } }
      }
    },
    "systemdService": { "type": "string", "pattern": "^[a-zA-Z0-9@_.:-]+\\.service$" },
    "secretReference": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
    "unixServiceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "home", "shell", "create_home", "password_lock", "groups", "authorized_keys_secret_ref", "authorized_keys_path", "sudoers_path", "sudo_rule"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]*$" },
        "home": { "type": "string", "pattern": "^/home/[a-z_][a-z0-9_-]*$" },
        "shell": { "type": "string", "pattern": "^/" },
        "create_home": { "type": "boolean" },
        "password_lock": { "type": "boolean" },
        "groups": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]*$" } },
        "authorized_keys_secret_ref": { "$ref": "#/$defs/secretReference" },
        "authorized_keys_path": { "type": "string", "pattern": "^/home/[a-z_][a-z0-9_-]*/\\.ssh/authorized_keys$" },
        "sudoers_path": { "anyOf": [{ "type": "string", "pattern": "^/etc/sudoers\\.d/[a-z_][a-z0-9_-]*$" }, { "type": "null" }] },
        "sudo_rule": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
      }
    },
    "humanAccessAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "comment", "group", "home", "shell", "password_lock", "supplementary_groups", "remove_authorized_keys", "sudoers_path", "sudo_rule"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]*$" },
        "comment": { "type": "string", "minLength": 1 },
        "group": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]*$" },
        "home": { "type": "string", "pattern": "^/home/[a-z_][a-z0-9_-]*$" },
        "shell": { "type": "string", "pattern": "^/" },
        "password_lock": { "type": "boolean" },
        "supplementary_groups": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]*$" } },
        "remove_authorized_keys": { "type": "boolean" },
        "sudoers_path": { "type": "string", "pattern": "^/etc/sudoers\\.d/[a-z_][a-z0-9_-]*$" },
        "sudo_rule": { "type": "string", "minLength": 1 }
      }
    },
    "pveAcl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "role": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]+$" }
      }
    },
    "pveRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "privileges"],
      "properties": {
        "role": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]+$" },
        "privileges": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z]+(\\.[A-Za-z]+)+$" } }
      }
    },
    "pveApiAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "token_name", "token_path", "privilege_separation", "primary_acl_path", "role", "privileges", "additional_acls"],
      "properties": {
        "user": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]*@(pam|pve)$" },
        "token_name": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "token_path": { "type": "string", "pattern": "^/root/\\.config/home-lab/[a-z0-9-]+\\.env$" },
        "privilege_separation": { "type": "boolean" },
        "primary_acl_path": { "type": "string", "pattern": "^/" },
        "role": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]+$" },
        "privileges": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z]+(\\.[A-Za-z]+)+$" } },
        "additional_acls": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/pveAcl" } }
      }
    },
    "proxmoxAccessPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_accounts", "human_accounts", "pve"],
      "properties": {
        "service_accounts": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/unixServiceAccount" } },
        "human_accounts": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/humanAccessAccount" } },
        "pve": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accounts", "additional_roles"],
          "properties": {
            "accounts": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/pveApiAccount" } },
            "additional_roles": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/pveRole" } }
          }
        }
      }
    },
    "proxmoxSshPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "config_path", "pubkey_authentication", "password_authentication", "kbd_interactive_authentication", "permit_root_login", "allow_users"],
      "properties": {
        "service": { "$ref": "#/$defs/systemdService" },
        "config_path": { "const": "/etc/ssh/sshd_config.d/60-home-lab.conf" },
        "pubkey_authentication": { "type": "boolean" },
        "password_authentication": { "type": "boolean" },
        "kbd_interactive_authentication": { "type": "boolean" },
        "permit_root_login": { "enum": ["yes", "no", "prohibit-password", "forced-commands-only"] },
        "allow_users": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]*$" } }
      }
    },
    "proxmoxTailscalePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "service", "hostname", "advertise_tag", "advertise_routes", "accept_dns", "accept_routes", "netfilter_mode", "ssh", "auth_key_secret_ref"],
      "properties": {
        "package": { "$ref": "#/$defs/packageName" },
        "service": { "$ref": "#/$defs/systemdService" },
        "hostname": { "type": "string", "minLength": 1 },
        "advertise_tag": { "type": "string", "pattern": "^tag:[a-z0-9-]+$" },
        "advertise_routes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/cidr" } },
        "accept_dns": { "type": "boolean" },
        "accept_routes": { "type": "boolean" },
        "netfilter_mode": { "enum": ["on", "nodivert", "off"] },
        "ssh": { "type": "boolean" },
        "auth_key_secret_ref": { "$ref": "#/$defs/secretReference" }
      }
    },
    "firewallRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "action", "source", "protocol", "destination_port", "log"],
      "properties": {
        "direction": { "enum": ["IN", "OUT"] },
        "action": { "enum": ["ACCEPT", "DROP", "REJECT"] },
        "source": { "$ref": "#/$defs/cidr" },
        "protocol": { "enum": ["tcp", "udp"] },
        "destination_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "log": { "enum": ["nolog", "info", "warning", "err", "crit", "alert", "emerg"] }
      }
    },
    "proxmoxFirewallPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_path", "options", "rules"],
      "properties": {
        "config_path": { "const": "/etc/pve/firewall/cluster.fw" },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enable", "policy_in", "policy_out"],
          "properties": {
            "enable": { "type": "boolean" },
            "policy_in": { "enum": ["ACCEPT", "DROP", "REJECT"] },
            "policy_out": { "enum": ["ACCEPT", "DROP", "REJECT"] }
          }
        },
        "rules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/firewallRule" } }
      }
    },
    "hostPackagePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "prohibited", "permitted_manual"],
      "properties": {
        "required": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/packageName" } },
        "prohibited": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/packageName" } },
        "permitted_manual": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/packageName" } }
      }
    },
    "kernelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "fallback", "retention_count", "require_boot_history_proof"],
      "properties": {
        "current": { "$ref": "#/$defs/pveKernelRelease" },
        "fallback": { "$ref": "#/$defs/pveKernelRelease" },
        "retention_count": { "type": "integer", "minimum": 1, "maximum": 2 },
        "require_boot_history_proof": { "type": "boolean" }
      }
    },
    "rootCleanupPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_shell", "preserve_paths", "remove_paths", "inspect_roots"],
      "properties": {
        "approved_shell": { "const": "/bin/bash" },
        "preserve_paths": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^/" } },
        "remove_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^/" } },
        "inspect_roots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^/" } }
      }
    },
    "rootDisk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datastore", "interface", "size_gb", "iothread"],
      "properties": {
        "datastore": { "type": "string", "minLength": 1 },
        "interface": { "type": "string", "pattern": "^(scsi|sata|virtio|ide)[0-9]+$" },
        "size_gb": { "type": "integer", "minimum": 1 },
        "iothread": { "type": "boolean" }
      }
    },
    "gamesDisk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "by_id_secret_ref", "filesystem_uuid", "backup", "discard", "iothread", "ssd"],
      "properties": {
        "interface": { "type": "string", "pattern": "^(scsi|sata|virtio|ide)[0-9]+$" },
        "by_id_secret_ref": { "const": "HOMELAB_GAMES_DISK_BY_ID" },
        "filesystem_uuid": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
        "backup": { "type": "boolean" },
        "discard": { "type": "string", "enum": ["ignore", "on"] },
        "iothread": { "type": "boolean" },
        "ssd": { "type": "boolean" }
      }
    },
    "pciDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bdf", "vendor_device", "mapping"],
      "properties": {
        "bdf": { "type": "string", "pattern": "^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\\.[0-7]$" },
        "vendor_device": { "type": "string", "pattern": "^[0-9a-f]{4}:[0-9a-f]{4}$" },
        "iommu_group": { "type": "integer", "minimum": 0 },
        "subsystem_id": { "type": "string", "pattern": "^[0-9a-f]{4}:[0-9a-f]{4}$" },
        "mapping": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
        "pcie": { "type": "boolean" },
        "xvga": { "type": "boolean" },
        "required_driver": { "type": "string", "minLength": 1 }
      }
    },
    "usbDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "vendor_device", "mapping"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "vendor_device": { "type": "string", "pattern": "^[0-9a-f]{4}:[0-9a-f]{4}$" },
        "mapping": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
        "serial_secret_ref": { "type": "string", "pattern": "^HOMELAB_[A-Z0-9_]+_USB_SERIAL$" },
        "usb3": { "type": "boolean" }
      }
    },
    "serialUsbDevice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor_device", "mapping", "serial_secret_ref"],
      "properties": {
        "vendor_device": { "type": "string", "pattern": "^[0-9a-f]{4}:[0-9a-f]{4}$" },
        "mapping": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
        "serial_secret_ref": { "type": "string", "pattern": "^HOMELAB_[A-Z0-9_]+_USB_SERIAL$" }
      }
    },
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vmid", "name", "hardware_attachment_mode", "desired_protection", "on_boot", "started", "boot_order", "cpu", "memory_mb", "machine", "smbios_uuid", "root_disk", "games_disk", "pci", "usb", "cloud_image"],
      "properties": {
        "vmid": { "const": 100 },
        "name": { "const": "arch" },
        "hardware_attachment_mode": { "type": "string", "enum": ["raw", "managed"] },
        "desired_protection": { "const": true },
        "on_boot": { "const": true },
        "started": { "type": "boolean" },
        "boot_order": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(scsi|sata|virtio|ide|net)[0-9]+$" } },
        "cpu": { "type": "object", "additionalProperties": false, "required": ["cores", "sockets", "type", "kvm_arguments"], "properties": { "cores": { "const": 24 }, "sockets": { "const": 1 }, "type": { "const": "host" }, "kvm_arguments": { "type": "string" } } },
        "memory_mb": { "const": 65536 },
        "machine": { "const": "q35" },
        "smbios_uuid": { "type": "string" },
        "root_disk": { "$ref": "#/$defs/rootDisk" },
        "games_disk": { "$ref": "#/$defs/gamesDisk" },
        "pci": { "type": "object", "additionalProperties": false, "required": ["coral", "gpu", "gpu_audio", "host_igpu"], "properties": { "coral": { "$ref": "#/$defs/pciDevice" }, "gpu": { "$ref": "#/$defs/pciDevice" }, "gpu_audio": { "$ref": "#/$defs/pciDevice" }, "host_igpu": { "$ref": "#/$defs/pciDevice" } } },
        "usb": { "type": "object", "additionalProperties": false, "required": ["zigbee", "zwave", "bluetooth"], "properties": { "zigbee": { "$ref": "#/$defs/serialUsbDevice" }, "zwave": { "$ref": "#/$defs/serialUsbDevice" }, "bluetooth": { "$ref": "#/$defs/usbDevice" } } },
        "cloud_image": { "type": "object", "additionalProperties": false, "required": ["version", "url", "sha256", "signature_url"], "properties": { "version": { "type": "string" }, "url": { "type": "string", "pattern": "^https://" }, "sha256": { "$ref": "#/$defs/sha256" }, "signature_url": { "type": "string", "pattern": "^https://" } } }
      }
    },
    "legacyContainer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vmid", "name", "mac", "retired"],
      "properties": {
        "vmid": { "const": 101 },
        "name": { "const": "tailscale-gateway" },
        "mac": { "$ref": "#/$defs/mac" },
        "retired": { "const": true }
      }
    },
    "zfsMember01": { "$ref": "#/$defs/zfsMember", "type": "object", "properties": { "secret_ref": { "const": "HOMELAB_ZFS_MEMBER_01_BY_ID" }, "mirror": { "const": 0 } } },
    "zfsMember02": { "$ref": "#/$defs/zfsMember", "type": "object", "properties": { "secret_ref": { "const": "HOMELAB_ZFS_MEMBER_02_BY_ID" }, "mirror": { "const": 0 } } },
    "zfsMember03": { "$ref": "#/$defs/zfsMember", "type": "object", "properties": { "secret_ref": { "const": "HOMELAB_ZFS_MEMBER_03_BY_ID" }, "mirror": { "const": 1 } } },
    "zfsMember04": { "$ref": "#/$defs/zfsMember", "type": "object", "properties": { "secret_ref": { "const": "HOMELAB_ZFS_MEMBER_04_BY_ID" }, "mirror": { "const": 1 } } },
    "zfsMember05": { "$ref": "#/$defs/zfsMember", "type": "object", "properties": { "secret_ref": { "const": "HOMELAB_ZFS_MEMBER_05_BY_ID" }, "mirror": { "const": 2 } } },
    "zfsMember06": { "$ref": "#/$defs/zfsMember", "type": "object", "properties": { "secret_ref": { "const": "HOMELAB_ZFS_MEMBER_06_BY_ID" }, "mirror": { "const": 2 } } },
    "zfsMember07": { "$ref": "#/$defs/zfsMember", "type": "object", "properties": { "secret_ref": { "const": "HOMELAB_ZFS_MEMBER_07_BY_ID" }, "mirror": { "const": 3 } } },
    "zfsMember08": { "$ref": "#/$defs/zfsMember", "type": "object", "properties": { "secret_ref": { "const": "HOMELAB_ZFS_MEMBER_08_BY_ID" }, "mirror": { "const": 3 } } },
    "zfsMember09": { "$ref": "#/$defs/zfsMember", "type": "object", "properties": { "secret_ref": { "const": "HOMELAB_ZFS_MEMBER_09_BY_ID" }, "mirror": { "const": 4 } } },
    "zfsMember10": { "$ref": "#/$defs/zfsMember", "type": "object", "properties": { "secret_ref": { "const": "HOMELAB_ZFS_MEMBER_10_BY_ID" }, "mirror": { "const": 4 } } },
    "zfsMember11": { "$ref": "#/$defs/zfsMember", "type": "object", "properties": { "secret_ref": { "const": "HOMELAB_ZFS_MEMBER_11_BY_ID" }, "mirror": { "const": 5 } } },
    "zfsMember12": { "$ref": "#/$defs/zfsMember", "type": "object", "properties": { "secret_ref": { "const": "HOMELAB_ZFS_MEMBER_12_BY_ID" }, "mirror": { "const": 5 } } },
    "zfsMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_ref", "mirror"],
      "properties": {
        "secret_ref": { "type": "string", "pattern": "^HOMELAB_ZFS_MEMBER_[0-9]{2}_BY_ID$" },
        "mirror": { "type": "integer", "minimum": 0, "maximum": 5 }
      }
    },
    "zfs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pool", "pool_guid_secret_ref", "expected_health", "corrected_checksum_baseline", "arc_max_bytes", "pve_storage", "dataset", "mountpoint", "members"],
      "properties": {
        "pool": { "const": "storage" },
        "pool_guid_secret_ref": { "const": "HOMELAB_ZFS_POOL_GUID" },
        "expected_health": { "const": "ONLINE" },
        "corrected_checksum_baseline": { "type": "integer", "minimum": 0 },
        "arc_max_bytes": { "const": 68719476736 },
        "pve_storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "pool", "mountpoint", "content", "nodes"],
          "properties": {
            "id": { "const": "storage" },
            "type": { "const": "zfspool" },
            "pool": { "const": "storage" },
            "mountpoint": { "const": "/storage" },
            "content": { "type": "array", "prefixItems": [{ "const": "images" }, { "const": "rootdir" }], "items": false, "minItems": 2, "maxItems": 2, "uniqueItems": true },
            "nodes": { "type": "array", "prefixItems": [{ "const": "proxmox" }], "items": false, "minItems": 1, "maxItems": 1 }
          }
        },
        "dataset": { "const": "storage/docker" },
        "mountpoint": { "const": "/storage/docker" },
        "members": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "prefixItems": [
            { "$ref": "#/$defs/zfsMember01" }, { "$ref": "#/$defs/zfsMember02" },
            { "$ref": "#/$defs/zfsMember03" }, { "$ref": "#/$defs/zfsMember04" },
            { "$ref": "#/$defs/zfsMember05" }, { "$ref": "#/$defs/zfsMember06" },
            { "$ref": "#/$defs/zfsMember07" }, { "$ref": "#/$defs/zfsMember08" },
            { "$ref": "#/$defs/zfsMember09" }, { "$ref": "#/$defs/zfsMember10" },
            { "$ref": "#/$defs/zfsMember11" }, { "$ref": "#/$defs/zfsMember12" }
          ],
          "items": false
        }
      }
    }
  }
}
