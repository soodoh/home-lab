{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "architecture", "provenance", "packages"],
  "properties": {
    "version": { "const": 1 },
    "architecture": { "const": "amd64" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installedInventory", "solverResult"],
      "properties": {
        "installedInventory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "sha256", "installedRecords"],
          "properties": {
            "format": { "const": "dpkg-query-status-tsv-v1" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "installedRecords": { "type": "integer", "minimum": 1 }
          }
        },
        "solverResult": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "sha256", "changes"],
          "properties": {
            "format": { "const": "apt-get-simulate-v1" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "changes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["action", "name", "previousVersion", "version"],
                "properties": {
                  "action": { "enum": ["install", "remove", "upgrade"] },
                  "name": { "$ref": "#/$defs/packageName" },
                  "previousVersion": { "anyOf": [{ "$ref": "#/$defs/debianVersion" }, { "type": "null" }] },
                  "version": { "anyOf": [{ "$ref": "#/$defs/debianVersion" }, { "type": "null" }] }
                },
                "oneOf": [
                  {
                    "properties": {
                      "action": { "const": "install" },
                      "previousVersion": { "type": "null" },
                      "version": { "$ref": "#/$defs/debianVersion" }
                    }
                  },
                  {
                    "properties": {
                      "action": { "const": "upgrade" },
                      "previousVersion": { "$ref": "#/$defs/debianVersion" },
                      "version": { "$ref": "#/$defs/debianVersion" }
                    }
                  },
                  {
                    "properties": {
                      "action": { "const": "remove" },
                      "previousVersion": { "$ref": "#/$defs/debianVersion" },
                      "version": { "type": "null" }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": { "$ref": "#/$defs/packageName" },
          "version": { "$ref": "#/$defs/debianVersion" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "packageName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9+.-]+(:[a-z0-9][a-z0-9-]*)?$" },
    "debianVersion": {
      "type": "string",
      "pattern": "^([0-9]+:)?[0-9][0-9A-Za-z.+:~]*(-[0-9A-Za-z.+~]+)*$"
    }
  }
}
