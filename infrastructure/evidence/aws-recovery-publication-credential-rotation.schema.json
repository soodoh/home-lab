{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canonical_ciphertext_sha256",
    "canonical_key_id_sha256",
    "completed_at",
    "create_key_receipt_sha256",
    "create_plan_sha256",
    "deactivate_key_receipt_sha256",
    "deactivate_plan_sha256",
    "delete_key_receipt_sha256",
    "delete_plan_sha256",
    "failed_attempts",
    "independent_recovery_decryption",
    "key_count",
    "key_status",
    "object_bytes",
    "object_ciphertext_sha256",
    "object_key_sha256",
    "old_key_id_sha256",
    "old_key_state",
    "policy_document_sha256",
    "principal_arn_sha256",
    "rotation_capability_enable_plan_sha256",
    "rotation_capability_removal_plan_sha256",
    "rotation_capability_state",
    "s3_qualification",
    "sts_qualification",
    "version"
  ],
  "properties": {
    "canonical_ciphertext_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "canonical_key_id_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "completed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "create_key_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "create_plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "deactivate_key_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "deactivate_plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "delete_key_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "delete_plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "failed_attempts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["effect", "plan_sha256", "postcondition"],
        "properties": {
          "effect": { "type": "string", "minLength": 1 },
          "plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "postcondition": { "type": "string", "minLength": 1 }
        }
      }
    },
    "independent_recovery_decryption": { "const": "passed" },
    "key_count": { "const": 1 },
    "key_status": { "const": "Active" },
    "object_bytes": { "const": 114746920 },
    "object_ciphertext_sha256": { "const": "4b62aaa4857ec68822392752d3cce758af981e106b79d8cb969cd6538bb14164" },
    "object_key_sha256": { "const": "597d15ebe79ac54dbdd3a787867bf44c38379901e3dbd33a6e16d36898307324" },
    "old_key_id_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "old_key_state": { "const": "Deleted" },
    "policy_document_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "principal_arn_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rotation_capability_enable_plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rotation_capability_removal_plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rotation_capability_state": { "const": "absent" },
    "s3_qualification": { "const": "kms-checksum-head-passed" },
    "sts_qualification": { "const": "passed" },
    "version": { "const": 1 }
  }
}
