  "type": "object",
  "additionalProperties": false,
  "required": ["version", "format", "observed_at", "base_commit", "operation", "vmid", "resource", "source_root", "provider", "provider_refresh_result", "plan_sha256", "plan_json_sha256", "state_sha256", "actionable", "authorized", "apply_requires_separate_exact_authorization", "blockers"],
  "properties": {
