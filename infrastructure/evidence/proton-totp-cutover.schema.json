{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authentication_mode",
    "daily_timer",
    "games_snapshot",
    "interruption",
    "maintenance_timer",
    "nfs_snapshot",
    "pending",
    "policy_sha256",
    "production_lock_absent",
    "proton_snapshot",
    "qualification_evidence_sha256",
    "recovery_bundle_evidence_sha256",
    "repositories_ready",
    "snapshot_time",
    "source_commit",
    "transition_evidence_sha256",
    "verified_at",
    "version"
  ],
  "properties": {
    "authentication_mode": { "const": "totp" },
    "daily_timer": { "$ref": "#/$defs/timer" },
    "games_snapshot": { "$ref": "#/$defs/hash" },
    "interruption": { "const": false },
    "maintenance_timer": { "$ref": "#/$defs/timer" },
    "nfs_snapshot": { "$ref": "#/$defs/hash" },
    "pending": { "const": 0 },
    "policy_sha256": { "$ref": "#/$defs/hash" },
    "production_lock_absent": { "const": true },
    "proton_snapshot": { "$ref": "#/$defs/hash" },
    "qualification_evidence_sha256": { "$ref": "#/$defs/hash" },
    "recovery_bundle_evidence_sha256": { "$ref": "#/$defs/hash" },
    "repositories_ready": { "const": true },
    "snapshot_time": { "$ref": "#/$defs/timestamp" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "transition_evidence_sha256": { "$ref": "#/$defs/hash" },
    "verified_at": { "$ref": "#/$defs/timestamp" },
    "version": { "const": 1 }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "timer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "enabled", "persistent"],
      "properties": {
        "active": { "const": true },
        "enabled": { "const": true },
        "persistent": { "const": false }
      }
    }
  }
}
