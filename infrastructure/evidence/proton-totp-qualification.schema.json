{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authentication_mode",
    "cache_fields",
    "chunker_polynomial",
    "clock_synchronized",
    "installed_config_sha256",
    "local_transition_evidence_sha256",
    "otp_secret_key_present",
    "production_lock_retained",
    "provider_probe",
    "provider_requests",
    "repository_id",
    "source_commit",
    "timers_stopped",
    "transaction_sha256",
    "verified_at",
    "version"
  ],
  "properties": {
    "authentication_mode": { "const": "totp" },
    "cache_fields": { "const": 4 },
    "chunker_polynomial": { "const": "255a608adc8769" },
    "clock_synchronized": { "const": true },
    "installed_config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "local_transition_evidence_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "otp_secret_key_present": { "const": true },
    "production_lock_retained": { "const": true },
    "provider_probe": { "const": "restic-cat-config" },
    "provider_requests": { "const": 1 },
    "repository_id": { "const": "d1faa9cd772dd13275b8d4db376c2bbba0b82a9415a28b0d03a8b17e37b7fb7e" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "timers_stopped": { "const": true },
    "transaction_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "verified_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "version": { "const": 1 }
  }
}
