{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "format", "purpose", "principal", "endpoint", "api_token", "ca_pem"],
  "properties": {
    "version": { "const": 1 },
    "format": { "const": "home-lab-disposable-pve-api-credentials-v1" },
    "purpose": { "enum": ["plan", "apply"] },
    "principal": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,31}@[a-z][a-z0-9_-]{1,15}![a-z][a-z0-9_-]{1,31}$" },
    "endpoint": { "type": "string", "pattern": "^https://[a-zA-Z0-9][a-zA-Z0-9.-]{0,252}:8006/api2/json$" },
    "api_token": { "type": "string", "minLength": 32, "maxLength": 1024 },
    "ca_pem": { "type": "string", "minLength": 64, "maxLength": 65536 }
  }
}
