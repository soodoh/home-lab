   elif "lock: " in subprocess.run(["/usr/sbin/qm","config","9900","--current"],stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,text=True).stdout: cleanup_failed=True
  if cleanup_failed: fail("host-key extraction cleanup failed")

