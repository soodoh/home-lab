{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-lab.invalid/vm-100/isolated-restore-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "completedAt", "result", "backupArchive", "verifierSha256", "isolatedTarget", "restore"],
  "properties": {
    "format": {"const": "home-lab-vm-100-isolated-restore-evidence-v1"},
    "completedAt": {"$ref": "#/$defs/timestamp"},
    "result": {"const": "passed"},
    "backupArchive": {
      "type": "object", "additionalProperties": false,
      "required": ["archiveName", "sha256", "sizeBytes"],
      "properties": {
        "archiveName": {"type": "string", "pattern": "^daily-local-backup-[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}\\.tar\\.gz\\.gpg$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "sizeBytes": {"type": "integer", "minimum": 1}
      }
    },
    "verifierSha256": {"$ref": "#/$defs/sha256"},
    "isolatedTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "independentEnvironment", "productionFilesystemsMounted", "emptyBefore", "removedAfter"],
      "properties": {"path": {"type": "string", "pattern": "^/[^\\n]{0,1023}$"}, "independentEnvironment": {"const": true}, "productionFilesystemsMounted": {"const": false}, "emptyBefore": {"const": true}, "removedAfter": {"const": true}}
    },
    "restore": {
      "type": "object", "additionalProperties": false,
      "required": ["result", "memberCount", "fileCount", "byteCount"],
      "properties": {
        "result": {"const": "passed"},
        "memberCount": {"type": "integer", "minimum": 1},
        "fileCount": {"type": "integer", "minimum": 1},
        "byteCount": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
