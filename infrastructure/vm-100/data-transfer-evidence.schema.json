{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-lab.invalid/vm-100/data-transfer-evidence.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["format", "phase", "startedAt", "completedAt", "status", "failureStage", "failureReason", "manifestSha256", "bindingsSha256", "rsyncVersion", "candidateBefore", "candidateAfter", "candidateObservationError", "entries"],
  "properties": {
    "format": {"const": "home-lab-vm-100-data-transfer-evidence-v1"}, "phase": {"const": "precopy"},
    "startedAt": {"$ref": "#/$defs/timestamp"}, "completedAt": {"$ref": "#/$defs/timestamp"},
    "status": {"enum": ["succeeded", "failed"]},
    "failureStage": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "failureReason": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "manifestSha256": {"$ref": "#/$defs/sha256"}, "bindingsSha256": {"$ref": "#/$defs/sha256"},
    "rsyncVersion": {"anyOf": [{"type": "string", "pattern": "^rsync  version [0-9]+(\\.[0-9]+){1,3}  protocol version [0-9]+$"}, {"type": "null"}]},
    "candidateBefore": {"anyOf": [{"$ref": "#/$defs/candidate"}, {"type": "null"}]},
    "candidateAfter": {"anyOf": [{"$ref": "#/$defs/candidate"}, {"type": "null"}]},
    "candidateObservationError": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "entries": {"type": "array", "maxItems": 34, "items": {"$ref": "#/$defs/entry"}}
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "succeeded"}}, "required": ["status"]},
    "then": {"properties": {"failureStage": {"type": "null"}, "failureReason": {"type": "null"}, "rsyncVersion": {"type": "string"}, "candidateBefore": {"$ref": "#/$defs/candidate"}, "candidateAfter": {"$ref": "#/$defs/candidate"}, "candidateObservationError": {"type": "null"}, "entries": {"type": "array", "minItems": 34, "maxItems": 34}}},
    "else": {"properties": {"failureStage": {"type": "string"}, "failureReason": {"type": "string"}}}
  }],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "mount": {"type": "object", "additionalProperties": false, "required": ["device", "filesystem", "mountTarget", "mountId"], "properties": {"device": {"type": "string"}, "filesystem": {"type": "string"}, "mountTarget": {"type": "string"}, "mountId": {"type": "integer", "minimum": 1}}},
    "root": {"type": "object", "additionalProperties": false, "required": ["device", "inode", "uid", "gid", "mode"], "properties": {"device": {"type": "integer", "minimum": 0}, "inode": {"type": "integer", "minimum": 1}, "uid": {"type": "integer", "minimum": 0}, "gid": {"type": "integer", "minimum": 0}, "mode": {"type": "string", "pattern": "^[0-7]{4}$"}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["sourceMount", "destinationMount", "sourceRoot", "destinationRoot"], "properties": {"sourceMount": {"$ref": "#/$defs/mount"}, "destinationMount": {"$ref": "#/$defs/mount"}, "sourceRoot": {"$ref": "#/$defs/root"}, "destinationRoot": {"$ref": "#/$defs/root"}}},
    "file": {"type": "object", "additionalProperties": false, "required": ["sha256", "bytes", "lines"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 0}, "lines": {"type": "integer", "minimum": 0}}},
    "capacityCheck": {"type": "object", "additionalProperties": false, "required": ["availableBytes", "availableInodes", "reserveBytes", "requiredWriteBytes", "requiredInodes"], "properties": {"availableBytes": {"type": "integer", "minimum": 0}, "availableInodes": {"type": "integer", "minimum": 0}, "reserveBytes": {"type": "integer", "minimum": 1}, "requiredWriteBytes": {"type": "integer", "minimum": 0}, "requiredInodes": {"type": "integer", "minimum": 0}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["capacityBytes", "reserveBytes", "mount", "deviceAncestry"], "properties": {"capacityBytes": {"type": "integer", "minimum": 1}, "reserveBytes": {"type": "integer", "minimum": 1}, "mount": {"$ref": "#/$defs/mount"}, "deviceAncestry": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "string"}}}},
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "logicalName", "source", "destination", "writeArgvSha256", "startedAt", "completedAt", "exitCode", "stdout", "stderr", "before", "after", "observationError", "capacityBefore", "status"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 33}, "logicalName": {"type": ["string", "null"]}, "source": {"type": "string", "pattern": "^/"}, "destination": {"type": "string", "pattern": "^/"}, "writeArgvSha256": {"$ref": "#/$defs/sha256"}, "startedAt": {"$ref": "#/$defs/timestamp"}, "completedAt": {"$ref": "#/$defs/timestamp"},
        "exitCode": {"type": ["integer", "null"]}, "stdout": {"anyOf": [{"$ref": "#/$defs/file"}, {"type": "null"}]}, "stderr": {"anyOf": [{"$ref": "#/$defs/file"}, {"type": "null"}]}, "before": {"anyOf": [{"$ref": "#/$defs/observation"}, {"type": "null"}]}, "after": {"anyOf": [{"$ref": "#/$defs/observation"}, {"type": "null"}]}, "observationError": {"type": ["string", "null"], "minLength": 1, "maxLength": 512}, "capacityBefore": {"anyOf": [{"$ref": "#/$defs/capacityCheck"}, {"type": "null"}]}, "status": {"enum": ["succeeded", "failed"]}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "succeeded"}}, "required": ["status"]},
        "then": {"properties": {"exitCode": {"const": 0}, "stdout": {"$ref": "#/$defs/file"}, "stderr": {"$ref": "#/$defs/file"}, "before": {"$ref": "#/$defs/observation"}, "after": {"$ref": "#/$defs/observation"}, "observationError": {"type": "null"}, "capacityBefore": {"$ref": "#/$defs/capacityCheck"}}},
        "else": {"not": {"properties": {"exitCode": {"const": 0}, "before": {"$ref": "#/$defs/observation"}, "after": {"$ref": "#/$defs/observation"}, "observationError": {"type": "null"}}, "required": ["exitCode", "before", "after", "observationError"]}}
      }]
    }
  }
}
