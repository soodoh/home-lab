{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-lab.invalid/schemas/vm-100-ephemeral-qualification-v4.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["architecture", "bootstrapImportPassed", "bootstrapSha256", "cleanupPassed", "closureVerificationPassed", "commit", "disposableProductUuidSha256", "disposableVmId", "exportSha256", "exporterSha256", "format", "helperSha256", "hostAttestationSha256", "installerPath", "manifestSha256", "nixVersion", "observedAt", "qualificationRequestSha256", "result", "runnerSha256", "toplevel", "trustedPublicKeySha256"],
  "properties": {
    "architecture": {"const": "x86_64-linux"},
    "bootstrapImportPassed": {"const": true},
    "bootstrapSha256": {"$ref": "#/$defs/sha256"},
    "cleanupPassed": {"const": true},
    "closureVerificationPassed": {"const": true},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "disposableProductUuidSha256": {"$ref": "#/$defs/sha256"},
    "disposableVmId": {"const": 9900},
    "exportSha256": {"$ref": "#/$defs/sha256"},
    "exporterSha256": {"$ref": "#/$defs/sha256"},
    "format": {"const": "home-lab-vm-100-ephemeral-qualification-v4"},
    "helperSha256": {"$ref": "#/$defs/sha256"},
    "hostAttestationSha256": {"$ref": "#/$defs/sha256"},
    "installerPath": {"$ref": "#/$defs/storePath"},
    "manifestSha256": {"$ref": "#/$defs/sha256"},
    "nixVersion": {"const": "2.34.8"},
    "observedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "qualificationRequestSha256": {"$ref": "#/$defs/sha256"},
    "result": {"const": "passed"},
    "runnerSha256": {"$ref": "#/$defs/sha256"},
    "toplevel": {"$ref": "#/$defs/storePath"},
    "trustedPublicKeySha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "storePath": {"type": "string", "pattern": "^/nix/store/[0-9a-df-np-sv-z]{32}-[^/\\u0000]+$"}
  }
}
