{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-lab.invalid/schemas/vm-100-install-qualification-authorization-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["commit", "confirmation", "format", "hostAttestationSha256", "mode", "vmId"],
  "properties": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "confirmation": {"const": "install-disposable-vmid-9900-scsi2-reviewed"},
    "format": {"const": "home-lab-vm-100-install-qualification-authorization-v1"},
    "hostAttestationSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mode": {"const": "install"},
    "vmId": {"const": 9900}
  }
}
