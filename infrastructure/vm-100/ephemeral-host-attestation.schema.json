{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-lab.invalid/schemas/vm-100-ephemeral-host-attestation-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["bios", "candidateSerial", "candidateSizeBytes", "collectedAt", "commit", "format", "machine", "productUuid", "pveConfigSha256", "result", "vmId"],
  "properties": {
    "bios": {"const": "seabios"},
    "candidateSerial": {"const": "QUAL-NIXOS-128G"},
    "candidateSizeBytes": {"const": 137438953472},
    "collectedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "format": {"const": "home-lab-vm-100-ephemeral-host-attestation-v1"},
    "machine": {"const": "q35"},
    "productUuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "pveConfigSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result": {"const": "passed"},
    "vmId": {"const": 9900}
  }
}
