      ],
      "properties": {
        "containers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/container"
          },
          "minItems": 41,
          "maxItems": 41,
          "uniqueItems": true
        },
        "writers": {
          "type": "array",
