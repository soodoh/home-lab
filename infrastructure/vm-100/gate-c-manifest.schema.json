    "backupMount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "filesystem",
        "filesystemUuid",
        "mountTarget",
        "mountId"
      ],
      "properties": {
        "device": {
          "type": "string",
          "maxLength": 1024
        },
        "filesystem": {
          "$ref": "#/$defs/name"
        },
        "mountTarget": {
          "$ref": "#/$defs/path"
        },
        "mountId": {
          "type": "integer",
          "minimum": 1
        },
        "filesystemUuid": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Fa-f0-9][A-Fa-f0-9-]{0,127}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "filesystem": {
                "enum": [
                  "nfs",
                  "nfs4"
                ]
              }
            },
            "required": [
              "filesystem"
            ]
          },
          "then": {
            "properties": {
              "device": {
                "type": "string",
                "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9.-]{0,252}|[0-9A-Fa-f:]+):/[A-Za-z0-9_./@+-]{0,1023}$"
              },
              "filesystemUuid": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[A-Fa-f0-9][A-Fa-f0-9-]{0,127}$"
              }
            }
          },
          "else": {
            "properties": {
              "device": {
                "type": "string",
                "pattern": "^/dev/[A-Za-z0-9_./:@+-]{1,1018}$"
              },
              "filesystemUuid": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9][A-Fa-f0-9-]{0,127}$"
              }
            }
          }
        }
      ]
    }
  }
