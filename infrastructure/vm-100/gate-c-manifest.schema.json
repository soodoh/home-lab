    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "collectedAt",
        "desiredInventorySha256",
        "runtimeInventorySha256",
        "candidateInventorySha256",
        "sourceDockerRoot",
        "candidateQualification",
        "candidate",
        "copyEntries",
        "backupEvidence",
        "operationalMetadata"
      ],
      "properties": {
        "format": {
          "const": "home-lab-vm-100-gate-c-collection-v1"
        },
        "collectedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "desiredInventorySha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtimeInventorySha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidateInventorySha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceDockerRoot": {
          "const": "/var/lib/docker"
        },
        "candidateQualification": {
          "$ref": "#/$defs/candidateQualification"
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "copyEntries": {
          "type": "array",
          "minItems": 34,
          "maxItems": 34,
          "items": {
            "$ref": "#/$defs/collectedEntry"
          }
        },
        "backupEvidence": {
          "$ref": "#/$defs/backups"
        },
        "operationalMetadata": {
          "$ref": "#/$defs/operational"
        }
      }
