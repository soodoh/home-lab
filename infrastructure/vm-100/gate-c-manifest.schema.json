              "const": "--itemize-changes"
            },
            {
              "const": "--"
            },
            {
              "type": "string",
              "pattern": "/$"
            },
            {
              "type": "string",
              "pattern": "/\\.$"
            }
          ]
        },
        "checksumArgv": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "prefixItems": [
            {
              "const": "rsync"
            },
            {
              "const": "-aHAXSx"
            },
            {
              "const": "--numeric-ids"
            },
            {
              "const": "--delete"
            },
            {
              "const": "--delete-delay"
            },
            {
              "const": "--dry-run"
            },
            {
              "const": "--checksum"
            },
            {
              "const": "--itemize-changes"
            },
            {
              "const": "--"
            },
            {
              "type": "string",
              "pattern": "/$"
            },
            {
              "type": "string",
              "pattern": "/\\.$"
            }
          ]
        }
      }
    },
    "backupReplica": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "archiveName",
        "sidecarName",
        "sha256",
        "sizeBytes",
        "mtime",
        "mount"
      ],
      "properties": {
        "path": {
          "enum": [
            "/home/docker/backups",
            "/mnt/games/backups",
            "/mnt/storage/backups"
          ]
        },
        "archiveName": {
          "type": "string",
          "pattern": "^daily-local-backup-[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}\\.tar\\.gz\\.gpg$"
        },
        "sidecarName": {
          "type": "string",
          "pattern": "^daily-local-backup-[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}\\.tar\\.gz\\.gpg\\.sha256$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "mtime": {
          "$ref": "#/$defs/timestamp"
        },
        "mount": {
          "$ref": "#/$defs/backupMount"
        }
      }
    },
    "backups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxAgeSeconds",
        "replicas"
      ],
      "properties": {
        "maxAgeSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "replicas": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/backupReplica"
          }
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
