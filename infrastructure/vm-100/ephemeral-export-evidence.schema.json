{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-lab.invalid/schemas/vm-100-ephemeral-export-evidence-v4.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifacts", "closurePathCount", "commit", "format", "helperSha256", "mode", "qualificationHostAttestationSha256", "requestSha256", "result", "system"],
  "properties": {
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["bootstrap", "export", "manifest"], "properties": {"bootstrap": {"$ref": "#/$defs/metric"}, "export": {"$ref": "#/$defs/metric"}, "manifest": {"$ref": "#/$defs/metric"}}},
    "closurePathCount": {"type": "integer", "minimum": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "format": {"const": "home-lab-vm-100-ephemeral-export-evidence-v4"},
    "helperSha256": {"$ref": "#/$defs/sha256"},
    "mode": {"enum": ["qualification", "live-inspect"]},
    "qualificationHostAttestationSha256": {"$ref": "#/$defs/sha256"},
    "requestSha256": {"$ref": "#/$defs/sha256"},
    "result": {"const": "passed"},
    "system": {"const": "x86_64-linux"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "metric": {"type": "object", "additionalProperties": false, "required": ["bytes", "sha256"], "properties": {"bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}}
}
