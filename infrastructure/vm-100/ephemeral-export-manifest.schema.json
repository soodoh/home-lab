{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-lab.invalid/schemas/vm-100-ephemeral-export-manifest-v5.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifacts", "bootstrapPaths", "bootstrapStorePath", "closure", "closureBytes", "commit", "composeArtifactSha256", "flakeLockSha256", "format", "helperSha256", "inspectionRequestSha256", "installerAttribute", "installerPath", "mode", "nixVersion", "qualificationEvidenceSha256", "qualificationHostAttestationSha256", "requestSha256", "resources", "system", "toplevel", "toplevelAttribute", "trustedKeyName", "trustedPublicKey"],
  "properties": {
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["bootstrap", "export"], "properties": {"bootstrap": {"$ref": "#/$defs/metric"}, "export": {"$ref": "#/$defs/metric"}}},
    "bootstrapPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/storePath"}},
    "bootstrapStorePath": {"$ref": "#/$defs/storePath"},
    "closure": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/closureEntry"}},
    "closureBytes": {"type": "integer", "minimum": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "composeArtifactSha256": {"const": "aa550bfd004366bf85f58b661ed26d2a3ba3b72d5f01e4286b6d05117352f086"},
    "flakeLockSha256": {"$ref": "#/$defs/sha256"},
    "format": {"const": "home-lab-vm-100-ephemeral-export-manifest-v5"},
    "helperSha256": {"$ref": "#/$defs/sha256"},
    "inspectionRequestSha256": {"$ref": "#/$defs/sha256"},
    "installerAttribute": {"const": "packages.x86_64-linux.vm-100-candidate-install"},
    "installerPath": {"$ref": "#/$defs/storePath"},
    "mode": {"enum": ["qualification", "live-inspect"]},
    "nixVersion": {"const": "2.34.8"},
    "qualificationEvidenceSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "qualificationHostAttestationSha256": {"$ref": "#/$defs/sha256"},
    "requestSha256": {"$ref": "#/$defs/sha256"},
    "resources": {"type": "object", "additionalProperties": false, "required": ["headroomBytes", "requiredInodes", "tmpfsBytes"], "properties": {"headroomBytes": {"type": "integer", "minimum": 1073741824}, "requiredInodes": {"type": "integer", "minimum": 1}, "tmpfsBytes": {"type": "integer", "minimum": 1}}},
    "system": {"const": "x86_64-linux"},
    "toplevel": {"$ref": "#/$defs/storePath"},
    "toplevelAttribute": {"const": "nixosConfigurations.vm-100-candidate.config.system.build.toplevel"},
    "trustedKeyName": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "trustedPublicKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+:[A-Za-z0-9+/=]+$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "storePath": {"type": "string", "pattern": "^/nix/store/[0-9a-df-np-sv-z]{32}-[^/\\u0000]+$"},
    "metric": {"type": "object", "additionalProperties": false, "required": ["bytes", "sha256"], "properties": {"bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "closureEntry": {"type": "object", "additionalProperties": false, "required": ["narHash", "narSize", "path", "references", "registrationSize", "signatures"], "properties": {"narHash": {"type": "string", "pattern": "^sha256-[A-Za-z0-9+/=]+$"}, "narSize": {"type": "integer", "minimum": 0}, "path": {"$ref": "#/$defs/storePath"}, "references": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/storePath"}}, "registrationSize": {"type": "integer", "minimum": 0}, "signatures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+:.+$"}}}}
  },
  "allOf": [
    {"if": {"properties": {"mode": {"const": "qualification"}}}, "then": {"properties": {"qualificationEvidenceSha256": {"type": "null"}}}},
    {"if": {"properties": {"mode": {"const": "live-inspect"}}}, "then": {"properties": {"qualificationEvidenceSha256": {"$ref": "#/$defs/sha256"}}}}
  ]
}
