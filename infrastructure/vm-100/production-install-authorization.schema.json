{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-lab.invalid/schemas/vm-100-production-install-authorization-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidateToplevel", "confirmation", "device", "diskoScript", "format", "hostAttestationSha256", "mode", "nixosInstall", "productionInspectionEvidenceSha256", "qualifiedColdBootEvidenceSha256", "qualifiedCommit", "qualifiedInstallEvidenceSha256", "serial", "sizeBytes", "transportCommit", "transportManifestSha256", "transportQualificationEvidenceSha256", "vmId"],
  "properties": {
    "candidateToplevel": {"$ref": "#/$defs/storePath"},
    "confirmation": {"const": "install-production-vm-100-scsi2-reviewed"},
    "device": {"const": "/dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_drive-scsi2"},
    "diskoScript": {"$ref": "#/$defs/storePath"},
    "format": {"const": "home-lab-vm-100-production-install-authorization-v1"},
    "hostAttestationSha256": {"$ref": "#/$defs/sha256"},
    "mode": {"const": "install"},
    "nixosInstall": {"type": "string", "pattern": "^/nix/store/[0-9a-df-np-sv-z]{32}-nixos-install/bin/nixos-install$"},
    "productionInspectionEvidenceSha256": {"$ref": "#/$defs/sha256"},
    "qualifiedColdBootEvidenceSha256": {"$ref": "#/$defs/sha256"},
    "qualifiedCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "qualifiedInstallEvidenceSha256": {"$ref": "#/$defs/sha256"},
    "serial": {"const": "QUAL-NIXOS-128G"},
    "sizeBytes": {"const": 137438953472},
    "transportCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "transportManifestSha256": {"$ref": "#/$defs/sha256"},
    "transportQualificationEvidenceSha256": {"$ref": "#/$defs/sha256"},
    "vmId": {"const": 100}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "storePath": {"type": "string", "pattern": "^/nix/store/[0-9a-df-np-sv-z]{32}-[^/\\u0000]+$"}
  }
}
