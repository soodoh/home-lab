{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-lab.invalid/schemas/vm-100-install-cold-boot-qualification-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["bootId", "candidateToplevel", "commit", "format", "guestEvidenceSha256", "installEvidenceSha256", "observedAt", "result", "serial", "sizeBytes", "startPlanSha256", "vmId"],
  "properties": {
    "bootId": {"type": "string", "format": "uuid"},
    "candidateToplevel": {"type": "string", "pattern": "^/nix/store/[0-9a-df-np-sv-z]{32}-nixos-system-archlinux-26\\.05\\.[^/]+$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "format": {"const": "home-lab-vm-100-install-cold-boot-qualification-v1"},
    "guestEvidenceSha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guest-boot-id.json", "guest-current-system.json", "guest-disk-serial.json", "guest-docker-active.json", "guest-docker-enabled.json", "guest-failed-units.json", "guest-root-mount.json"],
      "properties": {
        "guest-boot-id.json": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "guest-current-system.json": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "guest-disk-serial.json": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "guest-docker-active.json": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "guest-docker-enabled.json": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "guest-failed-units.json": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "guest-root-mount.json": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "installEvidenceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observedAt": {"type": "string", "format": "date-time"},
    "result": {"const": "passed"},
    "serial": {"const": "QUAL-NIXOS-128G"},
    "sizeBytes": {"const": 137438953472},
    "startPlanSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vmId": {"const": 9900}
  }
}
