{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-lab.invalid/schemas/authentik-desired.schema.json",
  "title": "Import-first Authentik desired state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "sourceInventory",
    "applications",
    "applicationPolicyBindings",
    "authenticatorValidateStages",
    "customBlueprints",
    "customFlows",
    "flowStageBindings",
    "oauthProviders",
    "proxyProviders",
    "scopeMappings",
    "certificates",
    "ldapProviders",
    "rbacRoles",
    "serviceAccounts",
    "ldapSearchPermissions",
    "serviceApplicationBindings",
    "outposts",
    "retainedOAuthProviders"
  ],
  "properties": {
    "$schema": {
      "const": "./desired.schema.json"
    },
    "schemaVersion": {
      "const": 3
    },
    "sourceInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capturedAt",
        "complete",
        "applicationsSha256",
        "proxyProvidersSha256",
        "oauthProvidersSha256",
        "applicationPolicyBindingsSha256",
        "customConfigurationSha256"
      ],
      "properties": {
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "complete": {
          "type": "boolean"
        },
        "applicationsSha256": {
          "$ref": "#/$defs/sha256"
        },
        "proxyProvidersSha256": {
          "$ref": "#/$defs/sha256"
        },
        "oauthProvidersSha256": {
          "$ref": "#/$defs/sha256"
        },
        "applicationPolicyBindingsSha256": {
          "$ref": "#/$defs/sha256"
        },
        "customConfigurationSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "applications": {
      "type": "object",
      "minProperties": 24,
      "maxProperties": 24,
      "additionalProperties": {
        "$ref": "#/$defs/application"
      }
    },
    "proxyProviders": {
      "type": "object",
      "minProperties": 19,
      "maxProperties": 19,
      "propertyNames": {
        "pattern": "^(?:[1-9][0-9]*|[a-z0-9]+(?:-[a-z0-9]+)*)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/proxyProvider"
      }
    },
    "oauthProviders": {
      "type": "object",
      "maxProperties": 5,
      "propertyNames": {
        "pattern": "^[1-9][0-9]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/oauthProvider"
      },
      "minProperties": 5
    },
    "customBlueprints": {
      "type": "object",
      "maxProperties": 1,
      "propertyNames": {
        "const": "custom-configuration"
      },
      "additionalProperties": {
        "$ref": "#/$defs/customBlueprint"
      }
    },
    "applicationPolicyBindings": {
      "type": "object",
      "minProperties": 28,
      "maxProperties": 28,
      "propertyNames": {
        "$ref": "#/$defs/uuid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/applicationPolicyBinding"
      }
    },
    "authenticatorValidateStages": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "propertyNames": {
        "const": "passwordless-webauthn"
      },
      "additionalProperties": {
        "$ref": "#/$defs/authenticatorValidateStage"
      }
    },
    "customFlows": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 2,
      "additionalProperties": {
        "$ref": "#/$defs/customFlow"
      }
    },
    "flowStageBindings": {
      "type": "object",
      "minProperties": 5,
      "maxProperties": 5,
      "propertyNames": {
        "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[a-z0-9]+(?:-[a-z0-9]+)*)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/flowStageBinding"
      }
    },
    "scopeMappings": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "propertyNames": {
        "const": "vaultwarden-email"
      },
      "additionalProperties": {
        "$ref": "#/$defs/scopeMapping"
      }
    },
    "certificates": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/certificate"
      }
    },
    "ldapProviders": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/ldapProvider"
      }
    },
    "rbacRoles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/rbacRole"
      }
    },
    "serviceAccounts": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 2,
      "additionalProperties": {
        "$ref": "#/$defs/serviceAccount"
      }
    },
    "ldapSearchPermissions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/ldapSearchPermission"
      }
    },
    "serviceApplicationBindings": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 2,
      "additionalProperties": {
        "$ref": "#/$defs/serviceApplicationBinding"
      }
    },
    "outposts": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/outpost"
      }
    },
    "retainedOAuthProviders": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "uuidArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/uuid"
      }
    },
    "numberArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "slug",
        "uuid",
        "group",
        "provider_id",
        "provider_type",
        "backchannel_provider_ids",
        "meta_launch_url",
        "meta_icon",
        "meta_description",
        "meta_publisher",
        "policy_engine_mode",
        "open_in_new_tab",
        "meta_hide",
        "import_existing"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "uuid": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "group": {
          "type": "string"
        },
        "provider_id": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          ]
        },
        "provider_type": {
          "enum": [
            "ldap",
            "oauth2",
            "proxy"
          ]
        },
        "backchannel_provider_ids": {
          "$ref": "#/$defs/numberArray"
        },
        "meta_launch_url": {
          "type": "string"
        },
        "meta_icon": {
          "type": "string"
        },
        "meta_description": {
          "type": "string"
        },
        "meta_publisher": {
          "type": "string"
        },
        "policy_engine_mode": {
          "enum": [
            "all",
            "any"
          ]
        },
        "open_in_new_tab": {
          "type": "boolean"
        },
        "meta_hide": {
          "type": "boolean"
        },
        "import_existing": {
          "type": "boolean"
        }
      }
    },
    "proxyProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pk",
        "name",
        "authentication_flow",
        "authorization_flow",
        "invalidation_flow",
        "internal_host",
        "external_host",
        "internal_host_ssl_validation",
        "skip_path_regex",
        "basic_auth_enabled",
        "basic_auth_user_attribute",
        "basic_auth_password_attribute",
        "intercept_header_auth",
        "mode",
        "cookie_domain",
        "access_token_validity",
        "refresh_token_validity",
        "property_mappings",
        "jwt_federation_sources",
        "jwt_federation_providers",
        "import_existing"
      ],
      "properties": {
        "pk": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "authentication_flow": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorization_flow": {
          "$ref": "#/$defs/uuid"
        },
        "invalidation_flow": {
          "$ref": "#/$defs/uuid"
        },
        "internal_host": {
          "type": "string",
          "pattern": "^https?://"
        },
        "external_host": {
          "type": "string",
          "pattern": "^https://"
        },
        "internal_host_ssl_validation": {
          "type": "boolean"
        },
        "skip_path_regex": {
          "type": "string"
        },
        "basic_auth_enabled": {
          "type": "boolean"
        },
        "basic_auth_user_attribute": {
          "type": "string"
        },
        "basic_auth_password_attribute": {
          "type": "string"
        },
        "intercept_header_auth": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "proxy",
            "forward_single",
            "forward_domain"
          ]
        },
        "cookie_domain": {
          "type": "string"
        },
        "access_token_validity": {
          "type": "string",
          "minLength": 1
        },
        "refresh_token_validity": {
          "type": "string",
          "minLength": 1
        },
        "property_mappings": {
          "$ref": "#/$defs/uuidArray"
        },
        "jwt_federation_sources": {
          "$ref": "#/$defs/uuidArray"
        },
        "jwt_federation_providers": {
          "$ref": "#/$defs/numberArray"
        },
        "import_existing": {
          "type": "boolean"
        }
      }
    },
    "oauthProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pk",
        "name",
        "authentication_flow",
        "authorization_flow",
        "invalidation_flow",
        "client_id",
        "client_type",
        "allowed_redirect_uris",
        "access_code_validity",
        "access_token_validity",
        "refresh_token_validity",
        "refresh_token_threshold",
        "include_claims_in_id_token",
        "issuer_mode",
        "sub_mode",
        "property_mappings",
        "signing_key",
        "encryption_key",
        "grant_types",
        "logout_method",
        "logout_uri",
        "jwt_federation_sources",
        "jwt_federation_providers"
      ],
      "properties": {
        "pk": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "authentication_flow": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorization_flow": {
          "$ref": "#/$defs/uuid"
        },
        "invalidation_flow": {
          "$ref": "#/$defs/uuid"
        },
        "client_id": {
          "type": "string",
          "minLength": 1
        },
        "client_type": {
          "enum": [
            "confidential",
            "public"
          ]
        },
        "allowed_redirect_uris": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "matching_mode",
              "redirect_uri_type",
              "url"
            ],
            "properties": {
              "matching_mode": {
                "enum": [
                  "strict",
                  "regex"
                ]
              },
              "redirect_uri_type": {
                "enum": [
                  "authorization",
                  "logout"
                ]
              },
              "url": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "access_code_validity": {
          "type": "string",
          "minLength": 1
        },
        "access_token_validity": {
          "type": "string",
          "minLength": 1
        },
        "refresh_token_validity": {
          "type": "string",
          "minLength": 1
        },
        "refresh_token_threshold": {
          "type": "string",
          "minLength": 1
        },
        "include_claims_in_id_token": {
          "type": "boolean"
        },
        "issuer_mode": {
          "enum": [
            "global",
            "per_provider"
          ]
        },
        "sub_mode": {
          "enum": [
            "hashed_user_id",
            "user_id",
            "user_uuid",
            "user_username",
            "user_email",
            "user_upn"
          ]
        },
        "property_mappings": {
          "$ref": "#/$defs/uuidArray"
        },
        "signing_key": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "encryption_key": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "grant_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "logout_method": {
          "enum": [
            "backchannel",
            "frontchannel"
          ]
        },
        "logout_uri": {
          "type": "string"
        },
        "jwt_federation_sources": {
          "$ref": "#/$defs/uuidArray"
        },
        "jwt_federation_providers": {
          "$ref": "#/$defs/numberArray"
        }
      }
    },
    "customBlueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "content_file",
        "context",
        "enabled"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "content_file": {
          "type": "string",
          "pattern": "^blueprints/[a-z0-9][a-z0-9-]*\\.yaml$"
        },
        "context": {
          "type": "object"
        },
        "enabled": {
          "const": true
        }
      }
    },
    "nullableUuid": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "applicationPolicyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_slug",
        "enabled",
        "failure_result",
        "group",
        "negate",
        "order",
        "pk",
        "policy",
        "timeout",
        "user"
      ],
      "properties": {
        "application_slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "enabled": {
          "type": "boolean"
        },
        "failure_result": {
          "type": "boolean"
        },
        "group": {
          "$ref": "#/$defs/nullableUuid"
        },
        "negate": {
          "type": "boolean"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "pk": {
          "$ref": "#/$defs/uuid"
        },
        "policy": {
          "$ref": "#/$defs/nullableUuid"
        },
        "timeout": {
          "type": "integer",
          "minimum": 0
        },
        "user": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "authenticatorValidateStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pk",
        "name",
        "not_configured_action",
        "configuration_stages",
        "device_classes",
        "email_otp_throttling_factor",
        "last_auth_threshold",
        "sms_otp_throttling_factor",
        "static_otp_throttling_factor",
        "totp_otp_throttling_factor",
        "webauthn_allowed_device_types",
        "webauthn_hints",
        "webauthn_user_verification"
      ],
      "properties": {
        "pk": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "const": "Passwordless WebAuthn"
        },
        "not_configured_action": {
          "enum": [
            "skip",
            "deny",
            "configure"
          ]
        },
        "configuration_stages": {
          "$ref": "#/$defs/uuidArray"
        },
        "device_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "email_otp_throttling_factor": {
          "type": "number",
          "minimum": 0
        },
        "last_auth_threshold": {
          "type": "string",
          "minLength": 1
        },
        "sms_otp_throttling_factor": {
          "type": "number",
          "minimum": 0
        },
        "static_otp_throttling_factor": {
          "type": "number",
          "minimum": 0
        },
        "totp_otp_throttling_factor": {
          "type": "number",
          "minimum": 0
        },
        "webauthn_allowed_device_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "webauthn_hints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "webauthn_user_verification": {
          "enum": [
            "required",
            "preferred",
            "discouraged"
          ]
        }
      }
    },
    "customFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "slug",
        "designation",
        "authentication",
        "background",
        "compatibility_mode",
        "denied_action",
        "layout",
        "policy_engine_mode",
        "import_existing"
      ],
      "properties": {
        "pk": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "designation": {
          "enum": [
            "authentication",
            "authorization",
            "invalidation",
            "enrollment",
            "unenrollment",
            "recovery",
            "stage_configuration"
          ]
        },
        "authentication": {
          "type": "string",
          "minLength": 1
        },
        "background": {
          "type": "string"
        },
        "compatibility_mode": {
          "type": "boolean"
        },
        "denied_action": {
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "type": "string",
          "minLength": 1
        },
        "policy_engine_mode": {
          "enum": [
            "all",
            "any"
          ]
        },
        "import_existing": {
          "type": "boolean"
        }
      }
    },
    "flowStageBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_ref",
        "order",
        "evaluate_on_plan",
        "invalid_response_action",
        "policy_engine_mode",
        "re_evaluate_policies",
        "flow_ref",
        "import_existing"
      ],
      "properties": {
        "pk": {
          "$ref": "#/$defs/uuid"
        },
        "stage_ref": {
          "enum": [
            "passwordless-webauthn",
            "default-authentication-identification",
            "default-authentication-password",
            "default-authentication-login"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "evaluate_on_plan": {
          "type": "boolean"
        },
        "invalid_response_action": {
          "enum": [
            "retry",
            "restart",
            "restart_with_context"
          ]
        },
        "policy_engine_mode": {
          "enum": [
            "all",
            "any"
          ]
        },
        "re_evaluate_policies": {
          "type": "boolean"
        },
        "flow_ref": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "import_existing": {
          "type": "boolean"
        }
      }
    },
    "scopeMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pk",
        "name",
        "scope_name",
        "description",
        "expression"
      ],
      "properties": {
        "pk": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "const": "Vaultwarden Email Scope"
        },
        "scope_name": {
          "const": "email"
        },
        "description": {
          "type": "string"
        },
        "expression": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "certificate_file"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "certificate_file": {
          "type": "string",
          "pattern": "^[a-z0-9-]+[.]pem$"
        }
      }
    },
    "ldapProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "base_dn",
        "bind_flow_ref",
        "unbind_flow_slug",
        "bind_mode",
        "search_mode",
        "certificate_ref",
        "tls_server_name",
        "mfa_support",
        "uid_start_number",
        "gid_start_number"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "base_dn": {
          "type": "string",
          "minLength": 1
        },
        "bind_flow_ref": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "unbind_flow_slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "bind_mode": {
          "const": "direct"
        },
        "search_mode": {
          "const": "direct"
        },
        "certificate_ref": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "tls_server_name": {
          "const": "authentik-ldap"
        },
        "mfa_support": {
          "type": "boolean"
        },
        "uid_start_number": {
          "type": "integer",
          "minimum": 1
        },
        "gid_start_number": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "rbacRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "username",
        "name",
        "path",
        "type",
        "is_active",
        "role_refs",
        "password_ref"
      ],
      "properties": {
        "username": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "service_account"
        },
        "is_active": {
          "const": true
        },
        "role_refs": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "password_ref": {
          "oneOf": [
            {
              "const": "ldap-bind"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ldapSearchPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_ref",
        "permission"
      ],
      "properties": {
        "role_ref": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "permission": {
          "const": "authentik_providers_ldap.search_full_directory"
        }
      }
    },
    "serviceApplicationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_slug",
        "user_ref",
        "order",
        "enabled",
        "negate",
        "failure_result",
        "timeout"
      ],
      "properties": {
        "application_slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "user_ref": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "enabled": {
          "type": "boolean"
        },
        "negate": {
          "type": "boolean"
        },
        "failure_result": {
          "type": "boolean"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "outpost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "provider_refs",
        "config"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "ldap"
        },
        "provider_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "config": {
          "type": "object"
        }
      }
    }
  }
}
