{
  "proxmox_endpoint": "https://proxmox:8006/api2/json",
  "proxmox_vm": {
    "boot_order": [
      "scsi3",
      "net0"
    ],
    "cloud_init": {
      "datastore": "local",
      "drive_datastore": "local-lvm",
      "drive_interface": "ide2",
      "meta_data_snippet_path": "/var/lib/vz/snippets/vm-100-debian-meta.yaml",
      "network_data_snippet_path": "/var/lib/vz/snippets/vm-100-debian-network.yaml",
      "user_data_snippet_path": "/var/lib/vz/snippets/vm-100-debian-user.yaml"
    },
    "network": {
      "bridge": "vmbr0",
      "docker_host_mac": "BC:24:11:89:19:5A"
    },
    "node": "proxmox",
    "vm": {
      "cpu": {
        "cores": 24,
        "kvm_arguments": "-cpu 'host,-hypervisor,kvm=off'",
        "sockets": 1,
        "type": "host"
      },
      "desired_protection": true,
      "games_disk": {
        "backup": false,
        "discard": "on",
        "interface": "scsi1",
        "iothread": true,
        "ssd": true
      },
      "hardware_attachment_mode": "managed",
      "machine": "q35",
      "memory_mb": 65536,
      "name": "docker-host",
      "on_boot": true,
      "pci": {
        "gpu": {
          "bdf": "0000:03:00.0",
          "iommu_group": 14,
          "mapping": "rx-7900-xtx",
          "pcie": true,
          "subsystem_id": "1043:0506",
          "vendor_device": "1002:744c",
          "xvga": true
        },
        "gpu_audio": {
          "bdf": "0000:03:00.1",
          "iommu_group": 15,
          "mapping": "rx-7900-xtx-audio",
          "pcie": true,
          "subsystem_id": "1002:ab30",
          "vendor_device": "1002:ab30"
        }
      },
      "retired_disk_slot": {
        "datastore": "local-lvm",
        "interface": "scsi0",
        "iothread": true,
        "size_gb": 550
      },
      "started": true,
      "state_disk": {
        "backup": true,
        "datastore": "local-lvm",
        "discard": "ignore",
        "interface": "scsi2",
        "iothread": true,
        "serial": "QUAL-NIXOS-128G",
        "size_gb": 128,
        "ssd": false
      },
      "usb": {
        "bluetooth": {
          "host": "0bda:a729",
          "mapping": "realtek-bluetooth",
          "usb3": true,
          "vendor_device": "0bda:a729"
        },
        "zigbee": {
          "mapping": "zigbee-cp210x",
          "vendor_device": "10c4:ea60"
        },
        "zwave": {
          "mapping": "zwave-cp210x",
          "vendor_device": "10c4:ea60"
        }
      },
      "vmid": 100
    }
  }
}
