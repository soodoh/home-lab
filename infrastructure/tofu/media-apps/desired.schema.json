{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-lab.invalid/schemas/media-apps-desired.schema.json",
  "title": "Import-first media application desired state",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "sourceInventory", "sonarrRootFolders", "radarrRootFolders", "radarr4kRootFolders", "prowlarrTags", "prowlarrSyncProfiles"],
  "properties": {
    "$schema": { "const": "./desired.schema.json" },
    "schemaVersion": { "const": 1 },
    "sourceInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capturedAt", "sha256"],
      "properties": {
        "capturedAt": { "type": "string", "format": "date-time" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "sonarrRootFolders": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 2,
      "additionalProperties": { "$ref": "#/$defs/rootFolder" }
    },
    "radarrRootFolders": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/rootFolder" }
    },
    "radarr4kRootFolders": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/rootFolder" }
    },
    "prowlarrTags": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 4,
      "additionalProperties": { "$ref": "#/$defs/tag" }
    },
    "prowlarrSyncProfiles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/syncProfile" }
    }
  },
  "$defs": {
    "importId": { "type": "integer", "minimum": 1 },
    "rootFolder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["importId", "path"],
      "properties": {
        "importId": { "$ref": "#/$defs/importId" },
        "path": { "type": "string", "pattern": "^/data/" }
      }
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["importId", "label"],
      "properties": {
        "importId": { "$ref": "#/$defs/importId" },
        "label": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      }
    },
    "syncProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["importId", "name", "enableRss", "enableInteractiveSearch", "enableAutomaticSearch", "minimumSeeders"],
      "properties": {
        "importId": { "$ref": "#/$defs/importId" },
        "name": { "type": "string", "minLength": 1 },
        "enableRss": { "type": "boolean" },
        "enableInteractiveSearch": { "type": "boolean" },
        "enableAutomaticSearch": { "type": "boolean" },
        "minimumSeeders": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
