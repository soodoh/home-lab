{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-lab.invalid/schemas/vm-100-application-imports.schema.json",
  "title": "VM 100 application OpenTofu import inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "capturedAt",
    "sourceRevision",
    "providerPins",
    "imports",
    "excludedSurface",
    "evidence"
  ],
  "properties": {
    "$schema": {
      "const": "./vm-100-application-imports.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "providerPins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authentik", "sonarr", "radarr", "prowlarr"],
      "properties": {
        "authentik": { "const": "2026.5.1" },
        "sonarr": { "const": "3.4.2" },
        "radarr": { "const": "2.4.0" },
        "prowlarr": { "const": "3.2.1" }
      }
    },
    "imports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["root", "resourceAddress", "importId", "class"],
        "properties": {
          "root": {
            "enum": ["authentik", "media-apps"]
          },
          "resourceAddress": {
            "type": "string",
            "minLength": 1
          },
          "importId": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "enum": ["application", "proxy-provider", "root-folder", "tag", "sync-profile"]
          },
          "provider": {
            "enum": ["sonarr", "radarr", "radarr.radarr_4k", "prowlarr"]
          },
          "providerId": {
            "type": "integer",
            "minimum": 1
          },
          "providerType": {
            "enum": ["oauth2", "proxy"]
          },
          "path": {
            "type": "string",
            "pattern": "^/data/"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "excludedSurface": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["application", "class", "count", "reason"],
        "properties": {
          "application": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arrInventorySha256",
        "authentikApplicationInventorySha256",
        "authentikProxyInventorySha256",
        "recyclarrOverlapSha256"
      ],
      "properties": {
        "arrInventorySha256": { "$ref": "#/$defs/sha256" },
        "authentikApplicationInventorySha256": { "$ref": "#/$defs/sha256" },
        "authentikProxyInventorySha256": { "$ref": "#/$defs/sha256" },
        "recyclarrOverlapSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
