{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diloreto.com/schemas/home-lab-vm-100-scaffold-v1.json",
  "title": "Secret-free VM 100 NixOS base projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "vmid",
    "hostName",
    "networkIdentity",
    "system",
    "stateVersion",
    "deploymentAuthority",
    "nixosActivationEnabled",
    "workloadIdentity",
    "access",
    "networking",
    "storage",
    "hardware"
  ],
  "oneOf": [
    {
      "properties": {
        "deploymentAuthority": { "const": "arch" },
        "nixosActivationEnabled": { "const": false }
      }
    },
    {
      "properties": {
        "deploymentAuthority": { "const": "migration-in-progress" },
        "nixosActivationEnabled": { "const": false }
      }
    },
    {
      "properties": {
        "deploymentAuthority": { "const": "nixos" },
        "nixosActivationEnabled": { "const": true }
      }
    }
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "vmid": {
      "const": 100
    },
    "hostName": {
      "const": "archlinux"
    },
    "networkIdentity": {
      "const": "docker-host"
    },
    "system": {
      "const": "x86_64-linux"
    },
    "stateVersion": {
      "const": "26.05"
    },
    "deploymentAuthority": {
      "enum": [
        "arch",
        "migration-in-progress",
        "nixos"
      ]
    },
    "nixosActivationEnabled": {
      "type": "boolean"
    },
    "workloadIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user",
        "uid",
        "primaryGroup",
        "gid",
        "home",
        "shell",
        "supplementaryGroups"
      ],
      "properties": {
        "user": {
          "const": "docker"
        },
        "uid": {
          "const": 1000
        },
        "primaryGroup": {
          "const": "docker"
        },
        "gid": {
          "const": 1000
        },
        "home": {
          "const": "/home/docker"
        },
        "shell": {
          "const": "/bin/bash"
        },
        "supplementaryGroups": {
          "type": "array",
          "prefixItems": [
            {
              "const": "input"
            },
            {
              "const": "render"
            },
            {
              "const": "uucp"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opensshEnabled",
        "authorizedLoginKeys",
        "passwordAuthentication",
        "keyboardInteractiveAuthentication",
        "permitRootLogin",
        "allowTcpForwarding",
        "x11Forwarding"
      ],
      "properties": {
        "opensshEnabled": {
          "const": true
        },
        "authorizedLoginKeys": {
          "const": 0
        },
        "passwordAuthentication": {
          "const": false
        },
        "keyboardInteractiveAuthentication": {
          "const": false
        },
        "permitRootLogin": {
          "const": false
        },
        "allowTcpForwarding": {
          "const": false
        },
        "x11Forwarding": {
          "const": false
        }
      }
    },
    "networking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface",
        "matchMac",
        "ipv4",
        "gateway",
        "dns",
        "dhcp"
      ],
      "properties": {
        "interface": {
          "const": "ens18"
        },
        "matchMac": {
          "const": "BC:24:11:89:19:5A"
        },
        "ipv4": {
          "const": "192.168.0.100/24"
        },
        "gateway": {
          "const": "192.168.0.1"
        },
        "dns": {
          "type": "array",
          "prefixItems": [
            {
              "const": "1.1.1.1"
            }
          ],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "dhcp": {
          "const": false
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "games",
        "shared"
      ],
      "properties": {
        "games": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mountpoint",
            "filesystem",
            "filesystemUuid",
            "label",
            "options"
          ],
          "properties": {
            "mountpoint": {
              "const": "/mnt/games"
            },
            "filesystem": {
              "const": "ext4"
            },
            "filesystemUuid": {
              "const": "31602ce7-0054-498a-9f24-f51ca491e7b3"
            },
            "label": {
              "const": "games"
            },
            "options": {
              "type": "array",
              "prefixItems": [
                {
                  "const": "noatime"
                }
              ],
              "items": false,
              "minItems": 1,
              "maxItems": 1
            }
          }
        },
        "shared": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mountpoint",
            "filesystem",
            "source",
            "options"
          ],
          "properties": {
            "mountpoint": {
              "const": "/mnt/storage"
            },
            "filesystem": {
              "const": "nfs4"
            },
            "source": {
              "const": "192.168.0.123:/storage/docker"
            },
            "options": {
              "type": "array",
              "prefixItems": [
                {
                  "const": "defaults"
                }
              ],
              "items": false,
              "minItems": 1,
              "maxItems": 1
            }
          }
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernelModules",
        "gpu",
        "bluetooth",
        "input",
        "serial",
        "tun",
        "qemuGuestAgent",
        "sysctls"
      ],
      "properties": {
        "kernelModules": {
          "type": "array",
          "prefixItems": [
            {
              "const": "uhid"
            },
            {
              "const": "uinput"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vendorDevice",
            "renderNode",
            "runtimePowerManagement"
          ],
          "properties": {
            "vendorDevice": {
              "const": "1002:744c"
            },
            "renderNode": {
              "const": "/dev/dri/renderD128"
            },
            "runtimePowerManagement": {
              "const": false
            }
          }
        },
        "bluetooth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vendorDevice"
          ],
          "properties": {
            "vendorDevice": {
              "const": "0bda:a729"
            }
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "group",
            "mode"
          ],
          "properties": {
            "group": {
              "const": "input"
            },
            "mode": {
              "const": "0660"
            }
          }
        },
        "serial": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vendor_device",
            "group",
            "mode",
            "protected_symlinks"
          ],
          "properties": {
            "vendor_device": {
              "const": "10c4:ea60"
            },
            "group": {
              "const": "uucp"
            },
            "mode": {
              "const": "0660"
            },
            "protected_symlinks": {
              "type": "array",
              "prefixItems": [
                {
                  "const": "/dev/zigbee"
                },
                {
                  "const": "/dev/zwave"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "tun": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "const": "/dev/net/tun"
            }
          }
        },
        "qemuGuestAgent": {
          "const": true
        },
        "sysctls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fs.inotify.max_user_instances",
            "fs.inotify.max_user_watches",
            "user.max_user_namespaces"
          ],
          "properties": {
            "fs.inotify.max_user_instances": {
              "const": 1024
            },
            "fs.inotify.max_user_watches": {
              "const": 1048576
            },
            "user.max_user_namespaces": {
              "const": 28633
            }
          }
        }
      }
    }
  }
}
