{
  "$defs": {
    "attestation": {
      "additionalProperties": false,
      "properties": {
        "expectedCount": {
          "minimum": 0,
          "type": "integer"
        },
        "keyedAttestation": {
          "$ref": "#/$defs/sha256"
        },
        "matches": {
          "const": true
        }
      },
      "required": [
        "expectedCount",
        "matches",
        "keyedAttestation"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "time": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "token": {
      "maxLength": 128,
      "minLength": 16,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    }
  },
  "$id": "private-preconditions.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actionManifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "attestations": {
      "additionalProperties": false,
      "properties": {
        "protectedAccess": {
          "$ref": "#/$defs/attestation"
        },
        "protectedHardware": {
          "$ref": "#/$defs/attestation"
        }
      },
      "required": [
        "protectedAccess",
        "protectedHardware"
      ],
      "type": "object"
    },
    "bindings": {
      "additionalProperties": false,
      "properties": {
        "activationEnvelopeSchemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "activatorSha256": {
          "$ref": "#/$defs/sha256"
        },
        "bundleContentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "flakeLockSha256": {
          "$ref": "#/$defs/sha256"
        },
        "gitCommit": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        "gitTree": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        "observerSha256": {
          "$ref": "#/$defs/sha256"
        },
        "packageManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "planSchemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "privatePreconditionsSchemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "projectionSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "bundleContentSha256",
        "gitCommit",
        "observerSha256",
        "activatorSha256",
        "privatePreconditionsSchemaSha256",
        "activationEnvelopeSchemaSha256",
        "flakeLockSha256",
        "packageManifestSha256",
        "planSchemaSha256",
        "projectionSha256",
        "gitTree"
      ],
      "type": "object"
    },
    "challenge": {
      "$ref": "#/$defs/token"
    },
    "createdAt": {
      "$ref": "#/$defs/time"
    },
    "format": {
      "const": "home-lab-proxmox-private-preconditions-v1"
    },
    "hostSession": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "sidecarMac": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "id",
        "sidecarMac"
      ],
      "type": "object"
    },
    "operatorGates": {
      "additionalProperties": false,
      "properties": {
        "backupsConfirmed": {
          "type": "boolean"
        },
        "consoleConfirmed": {
          "type": "boolean"
        },
        "lanRollbackConfirmed": {
          "type": "boolean"
        },
        "noConcurrentMutationConfirmed": {
          "const": true
        }
      },
      "required": [
        "consoleConfirmed",
        "lanRollbackConfirmed",
        "backupsConfirmed",
        "noConcurrentMutationConfirmed"
      ],
      "type": "object"
    },
    "packageSession": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "completeInstalledMapSha256": {
              "$ref": "#/$defs/sha256"
            },
            "handle": {
              "$ref": "#/$defs/token"
            },
            "keyedSimulationAttestation": {
              "$ref": "#/$defs/sha256"
            },
            "validUntil": {
              "$ref": "#/$defs/time"
            }
          },
          "required": [
            "handle",
            "validUntil",
            "keyedSimulationAttestation",
            "completeInstalledMapSha256"
          ],
          "type": "object"
        }
      ]
    },
    "planSha256": {
      "$ref": "#/$defs/sha256"
    },
    "validUntil": {
      "$ref": "#/$defs/time"
    }
  },
  "required": [
    "format",
    "actionManifestSha256",
    "planSha256",
    "bindings",
    "createdAt",
    "validUntil",
    "challenge",
    "hostSession",
    "attestations",
    "operatorGates",
    "packageSession"
  ],
  "type": "object"
}
