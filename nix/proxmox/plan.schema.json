{
  "$defs": {
    "action": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/state"
        },
        "approvalRequired": {
          "type": "boolean"
        },
        "before": {
          "$ref": "#/$defs/state"
        },
        "dependsOn": {
          "items": {
            "$ref": "#/$defs/sha256"
          },
          "maxItems": 1,
          "type": "array"
        },
        "domain": {
          "enum": [
            "managed-files",
            "managed-fragments",
            "managed-artifacts",
            "packages",
            "services"
          ]
        },
        "id": {
          "$ref": "#/$defs/sha256"
        },
        "kind": {
          "enum": [
            "replace-file",
            "ensure-fragment",
            "install-artifact",
            "reconcile-package-set",
            "reconcile-service"
          ]
        },
        "postconditions": {
          "items": {
            "$ref": "#/$defs/postcondition"
          },
          "minItems": 1,
          "type": "array"
        },
        "preconditionSha256": {
          "$ref": "#/$defs/sha256"
        },
        "rebootRequired": {
          "type": "boolean"
        },
        "safetyClass": {
          "enum": [
            "guarded",
            "reboot-bound",
            "protected-session",
            "access-critical",
            "data-critical"
          ]
        },
        "sequence": {
          "minimum": 1,
          "type": "integer"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "watchdogRequired": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "sequence",
        "domain",
        "kind",
        "target",
        "safetyClass",
        "rebootRequired",
        "watchdogRequired",
        "approvalRequired",
        "before",
        "after",
        "preconditionSha256",
        "postconditions",
        "dependsOn"
      ],
      "type": "object"
    },
    "bindings": {
      "additionalProperties": false,
      "properties": {
        "activationEnvelopeSchemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "activatorSha256": {
          "$ref": "#/$defs/sha256"
        },
        "bundleContentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "bundleFormat": {
          "const": "home-lab-proxmox-host-bundle-v1"
        },
        "flakeLockSha256": {
          "$ref": "#/$defs/sha256"
        },
        "gitCommit": {
          "$ref": "#/$defs/gitObject"
        },
        "gitTree": {
          "$ref": "#/$defs/gitObject"
        },
        "observerProtocol": {
          "const": 4
        },
        "observerSha256": {
          "$ref": "#/$defs/sha256"
        },
        "packageManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "planSchemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "privatePreconditionsSchemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "privatePreparationRequestSchemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "privatePreparerSha256": {
          "$ref": "#/$defs/sha256"
        },
        "projectionSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "gitCommit",
        "gitTree",
        "flakeLockSha256",
        "projectionSha256",
        "bundleContentSha256",
        "bundleFormat",
        "observerProtocol",
        "observerSha256",
        "packageManifestSha256",
        "activationEnvelopeSchemaSha256",
        "activatorSha256",
        "planSchemaSha256",
        "privatePreconditionsSchemaSha256",
        "privatePreparerSha256",
        "privatePreparationRequestSchemaSha256"
      ],
      "type": "object"
    },
    "domain": {
      "enum": [
        "identity",
        "managed-files",
        "managed-fragments",
        "managed-artifacts",
        "packages",
        "services",
        "accounts",
        "tailscale",
        "pve-access",
        "pve-firewall",
        "pve-storage",
        "storage",
        "health",
        "audit-absence",
        "opentofu",
        "protected-hardware",
        "protected-access"
      ]
    },
    "freshness": {
      "additionalProperties": false,
      "properties": {
        "completedAt": {
          "$ref": "#/$defs/time"
        },
        "maxAgeSeconds": {
          "const": 1800
        },
        "observedAt": {
          "$ref": "#/$defs/time"
        },
        "validUntil": {
          "$ref": "#/$defs/time"
        }
      },
      "required": [
        "observedAt",
        "completedAt",
        "validUntil",
        "maxAgeSeconds"
      ],
      "type": "object"
    },
    "gitObject": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z0-9-]+$",
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "id": {
          "$ref": "#/$defs/sha256"
        },
        "kind": {
          "enum": [
            "audit",
            "blocker",
            "drift",
            "opentofu"
          ]
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "domain",
        "code",
        "target",
        "detail"
      ],
      "type": "object"
    },
    "observedState": {
      "additionalProperties": false,
      "properties": {
        "domainStatuses": {
          "additionalProperties": false,
          "properties": {
            "accounts": {
              "$ref": "#/$defs/status"
            },
            "auditAbsence": {
              "$ref": "#/$defs/status"
            },
            "flatcarDiagnostics": {
              "$ref": "#/$defs/status"
            },
            "health": {
              "$ref": "#/$defs/status"
            },
            "managedArtifacts": {
              "$ref": "#/$defs/status"
            },
            "managedFiles": {
              "$ref": "#/$defs/status"
            },
            "managedFragments": {
              "$ref": "#/$defs/status"
            },
            "packages": {
              "$ref": "#/$defs/status"
            },
            "protectedAccess": {
              "$ref": "#/$defs/status"
            },
            "protectedHardware": {
              "$ref": "#/$defs/status"
            },
            "pveAccess": {
              "$ref": "#/$defs/status"
            },
            "pveFirewall": {
              "$ref": "#/$defs/status"
            },
            "pveStorage": {
              "$ref": "#/$defs/status"
            },
            "services": {
              "$ref": "#/$defs/status"
            },
            "storage": {
              "$ref": "#/$defs/status"
            },
            "tailscale": {
              "$ref": "#/$defs/status"
            },
            "vm": {
              "$ref": "#/$defs/status"
            }
          },
          "required": [
            "accounts",
            "auditAbsence",
            "flatcarDiagnostics",
            "health",
            "managedArtifacts",
            "managedFiles",
            "managedFragments",
            "packages",
            "protectedAccess",
            "protectedHardware",
            "pveAccess",
            "pveFirewall",
            "pveStorage",
            "services",
            "storage",
            "tailscale",
            "vm"
          ],
          "type": "object"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "sha256",
        "domainStatuses"
      ],
      "type": "object"
    },
    "postcondition": {
      "additionalProperties": false,
      "properties": {
        "expected": {
          "$ref": "#/$defs/state"
        },
        "type": {
          "const": "state-equals"
        }
      },
      "required": [
        "type",
        "expected"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "state": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "boolean"
        },
        "commentMatches": {
          "type": "boolean"
        },
        "contentMatches": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "exists": {
          "type": "boolean"
        },
        "expectedGroupsMatch": {
          "type": "boolean"
        },
        "groupMatches": {
          "type": "boolean"
        },
        "home": {
          "type": "string"
        },
        "loginShell": {
          "type": "string"
        },
        "matchCount": {
          "minimum": 0,
          "type": "integer"
        },
        "mode": {
          "type": "string"
        },
        "ownerMatches": {
          "type": "boolean"
        },
        "passwordLocked": {
          "type": "boolean"
        },
        "primaryGroupMatches": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "absent",
            "present"
          ]
        },
        "symlinkTargetMatches": {
          "type": "boolean"
        },
        "type": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "status": {
      "enum": [
        "complete",
        "unavailable"
      ]
    },
    "target": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "path": {
              "pattern": "^/(?!etc/pve(?:/|$))",
              "type": "string"
            },
            "type": {
              "enum": [
                "file",
                "file-fragment",
                "artifact"
              ]
            }
          },
          "required": [
            "type",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "enum": [
                "package-set",
                "service"
              ]
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        }
      ]
    },
    "time": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  },
  "$id": "plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/action"
      },
      "type": "array"
    },
    "applyEligible": {
      "type": "boolean"
    },
    "bindings": {
      "$ref": "#/$defs/bindings"
    },
    "blockers": {
      "items": {
        "$ref": "#/$defs/issue"
      },
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/issue"
      },
      "type": "array"
    },
    "format": {
      "const": "home-lab-proxmox-plan-v1"
    },
    "freshness": {
      "$ref": "#/$defs/freshness"
    },
    "mode": {
      "enum": [
        "steady",
        "fixture"
      ]
    },
    "observedState": {
      "$ref": "#/$defs/observedState"
    },
    "planSha256": {
      "$ref": "#/$defs/sha256"
    },
    "privatePreconditionsRequired": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "ready",
        "blocked",
        "fixture"
      ]
    }
  },
  "required": [
    "format",
    "status",
    "applyEligible",
    "mode",
    "bindings",
    "freshness",
    "observedState",
    "findings",
    "actions",
    "blockers",
    "privatePreconditionsRequired",
    "planSha256"
  ],
  "type": "object"
}
