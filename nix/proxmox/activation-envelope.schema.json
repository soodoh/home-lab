{
  "$id": "activation-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "action": {"$ref": "plan.schema.json#/$defs/action"},
    "gitObject": {"pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$", "type": "string"},
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "token": {"maxLength": 128, "minLength": 16, "pattern": "^[A-Za-z0-9_-]+$", "type": "string"}
  },
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "actions": {"items": {"$ref": "#/$defs/action"}, "type": "array"},
        "bindings": {
          "additionalProperties": false,
          "properties": {
            "activatorSha256": {"$ref": "#/$defs/sha256"},
            "bundleContentSha256": {"$ref": "#/$defs/sha256"},
            "gitCommit": {"$ref": "#/$defs/gitObject"},
            "gitTree": {"$ref": "#/$defs/gitObject"}
          },
          "required": ["bundleContentSha256", "gitCommit", "gitTree", "activatorSha256"],
          "type": "object"
        },
        "hostSessionId": {"$ref": "#/$defs/token"},
        "operation": {"const": "begin"},
        "planSha256": {"$ref": "#/$defs/sha256"},
        "privatePreconditions": {"$ref": "private-preconditions.schema.json"},
        "protocol": {"const": 4},
        "startedAt": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"}
      },
      "required": ["operation", "protocol", "planSha256", "hostSessionId", "startedAt", "bindings", "privatePreconditions", "actions"],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "action": {"$ref": "#/$defs/action"},
        "hostSessionId": {"$ref": "#/$defs/token"},
        "operation": {"const": "action"},
        "planSha256": {"$ref": "#/$defs/sha256"},
        "protocol": {"const": 4}
      },
      "required": ["operation", "protocol", "planSha256", "hostSessionId", "action"],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "hostSessionId": {"$ref": "#/$defs/token"},
        "operation": {"const": "commit"},
        "planSha256": {"$ref": "#/$defs/sha256"},
        "protocol": {"const": 4},
        "verifiedActionIds": {"items": {"$ref": "#/$defs/sha256"}, "type": "array"}
      },
      "required": ["operation", "protocol", "planSha256", "hostSessionId", "verifiedActionIds"],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "hostSessionId": {"$ref": "#/$defs/token"},
        "operation": {"const": "rollback"},
        "planSha256": {"$ref": "#/$defs/sha256"},
        "protocol": {"const": 4}
      },
      "required": ["operation", "protocol", "planSha256", "hostSessionId"],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "hostSessionId": {"$ref": "#/$defs/token"},
        "operation": {"const": "status"},
        "planSha256": {"$ref": "#/$defs/sha256"},
        "protocol": {"const": 4}
      },
      "required": ["operation", "protocol", "planSha256", "hostSessionId"],
      "type": "object"
    }
  ]
}
