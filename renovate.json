{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "tooling-manual"
  ],
  "prConcurrentLimit": 5,
  "timezone": "America/Los_Angeles",
  "platformAutomerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Keep unadmitted updates manual and ungrouped, overriding inherited monorepo grouping",
      "matchPackageNames": ["*"],
      "groupName": null,
      "automerge": false
    },
    {
      "matchDepTypes": [
        "dependencies",
        "devDependencies"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Keep unadmitted Docker updates manual; only explicit routine rules override this default",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true,
      "groupName": null,
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "labels": ["compose-manual"],
      "automerge": false
    },
    {
      "description": "Batch all versioned Compose non-major updates, including databases, into one routine PR",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchCurrentValue": "/^v?[0-9]+(?:\\.[0-9]+){1,3}(?:-(?:alpine[0-9.]*|apache|ubi[0-9]+|openssl))?$/",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "routine Compose images",
      "groupSlug": "routine-compose-images",
      "automerge": true,
      "labels": ["compose-routine"]
    },
    {
      "description": "Include digest-only updates to the existing Wolf stable Compose image in the routine batch",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchFileNames": ["services/gaming.yml"],
      "matchPackageNames": ["ghcr.io/games-on-whales/wolf"],
      "matchCurrentValue": "stable",
      "matchUpdateTypes": ["digest"],
      "groupName": "routine Compose images",
      "groupSlug": "routine-compose-images",
      "automerge": true,
      "labels": ["compose-routine"]
    },
    {
      "description": "Include digest-only updates to the existing Wolf UI main channel in the routine batch",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "matchFileNames": ["services/data/wolf/security.json"],
      "matchPackageNames": ["ghcr.io/games-on-whales/wolf-ui"],
      "matchCurrentValue": "main",
      "matchUpdateTypes": ["digest"],
      "groupName": "routine Compose images",
      "groupSlug": "routine-compose-images",
      "automerge": true,
      "labels": ["compose-routine"]
    },
    {
      "description": "Include digest-only updates to the existing Wolf spawned application edge channels in the routine batch",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "matchFileNames": ["services/data/wolf/security.json"],
      "matchPackageNames": ["ghcr.io/games-on-whales/steam", "ghcr.io/games-on-whales/es-de"],
      "matchCurrentValue": "edge",
      "matchUpdateTypes": ["digest"],
      "groupName": "routine Compose images",
      "groupSlug": "routine-compose-images",
      "automerge": true,
      "labels": ["compose-routine"]
    },
    {
      "description": "Track qBittorrent application releases: strict SemVer rejects zero-padded Ubuntu tags; exclude year-style tags and the obsolete 14.3.9 alias",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/linuxserver/qbittorrent/"
      ],
      "versioning": "semver",
      "allowedVersions": "!/^v?(?:[0-9]{4,}\\.|14\\.3\\.9$)/",
      "groupName": null,
      "groupSlug": null,
      "separateMinorPatch": true
    },
    {
      "description": "Require tracker compatibility review for qBittorrent minor and major upgrades; patch and digest updates remain automatic in separate PRs",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/linuxserver/qbittorrent/"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false,
      "labels": ["compose-manual"]
    },
    {
      "description": "Group non-major CI-only Python validators without admitting shared deployment dependencies",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["controller/requirements-ci.txt", "controller/requirements-fixtures.txt"],
      "matchPackageNames": ["ansible-lint", "yamllint", "jsonschema", "requests"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "development and CI tooling",
      "groupSlug": "development-ci-tooling",
      "automerge": true,
      "labels": ["tooling-routine"]
    },
    {
      "description": "Include non-major updates to the CI Renovate validator",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["npm"],
      "matchFileNames": [".github/workflows/**"],
      "matchPackageNames": ["renovate"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "development and CI tooling",
      "groupSlug": "development-ci-tooling",
      "automerge": true,
      "labels": ["tooling-routine"]
    },
    {
      "description": "Include versioned GitHub Action references, not runtime inputs, runners or branch refs",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "matchDatasources": ["github-tags"],
      "matchFileNames": [".github/workflows/**", ".github/actions/**"],
      "matchCurrentValue": "/^v?[0-9]+(?:\\.[0-9]+){0,2}$/",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "development and CI tooling",
      "groupSlug": "development-ci-tooling",
      "automerge": true,
      "labels": ["tooling-routine"]
    },
    {
      "description": "Include non-major local JavaScript development dependencies exercised by CI",
      "matchManagers": ["npm", "bun"],
      "matchDatasources": ["npm"],
      "matchFileNames": ["package.json"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "development and CI tooling",
      "groupSlug": "development-ci-tooling",
      "automerge": true,
      "labels": ["tooling-routine"]
    },
    {
      "description": "Automerge non-major shared Ansible source pins; installation on managed hosts remains separately approved",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["controller/requirements.txt"],
      "matchPackageNames": ["ansible-core"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "development and CI tooling",
      "groupSlug": "development-ci-tooling",
      "automerge": true,
      "labels": ["tooling-routine"]
    },
    {
      "description": "Automerge the tested controller collections without installing them on docker-host",
      "matchManagers": ["ansible-galaxy"],
      "matchFileNames": ["ansible/collections/requirements.yml"],
      "matchPackageNames": ["community.docker", "community.general", "community.sops"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "development and CI tooling",
      "groupSlug": "development-ci-tooling",
      "automerge": true,
      "labels": ["tooling-routine"]
    },
    {
      "description": "Admit tested Python and OpenTofu workflow inputs, not arbitrary Action inputs or runners",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["uses-with"],
      "matchFileNames": [".github/workflows/ci.yml"],
      "matchPackageNames": ["actions/python-versions", "opentofu/opentofu"],
      "matchDatasources": ["github-releases"],
      "matchCurrentValue": "/^v?[0-9]+(?:\\.[0-9]+){1,2}$/",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "development and CI tooling",
      "groupSlug": "development-ci-tooling",
      "automerge": true,
      "labels": ["tooling-routine"]
    },
    {
      "description": "Admit the Node runtime exercised by CI",
      "matchManagers": ["nvm"],
      "matchFileNames": [".nvmrc"],
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "development and CI tooling",
      "groupSlug": "development-ci-tooling",
      "automerge": true,
      "labels": ["tooling-routine"]
    },
    {
      "description": "Admit the Bun package-manager pin exercised by frozen-lockfile CI",
      "matchManagers": ["npm", "bun"],
      "matchFileNames": ["package.json"],
      "matchDepTypes": ["packageManager"],
      "matchPackageNames": ["bun"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "development and CI tooling",
      "groupSlug": "development-ci-tooling",
      "automerge": true,
      "labels": ["tooling-routine"]
    },
    {
      "description": "Resolve root runtime constraints against OpenTofu rather than Terraform",
      "matchManagers": ["terraform"],
      "matchFileNames": ["infrastructure/tofu/**/versions.tf"],
      "matchDepTypes": ["required_version"],
      "overrideDepName": "opentofu",
      "overridePackageName": "opentofu/opentofu"
    },
    {
      "description": "Admit non-major OpenTofu root runtime constraints, independently of provider updates",
      "matchManagers": ["terraform"],
      "matchFileNames": ["infrastructure/tofu/**/versions.tf"],
      "matchDepTypes": ["required_version"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "development and CI tooling",
      "groupSlug": "development-ci-tooling",
      "automerge": true,
      "labels": ["tooling-routine"]
    },
    {
      "description": "Admit the natively tested SOPS release/checksum pair; host installation remains manual",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["github-release-attachments"],
      "matchFileNames": ["ansible/roles/compose_schedule/defaults/main.yml"],
      "matchPackageNames": ["getsops/sops"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "development and CI tooling",
      "groupSlug": "development-ci-tooling",
      "automerge": true,
      "labels": ["tooling-routine"]
    },
    {
      "description": "Classify provider PRs separately from runtime constraints and Compose",
      "matchManagers": ["terraform"],
      "matchDatasources": ["terraform-provider"],
      "labels": ["tofu-provider"]
    },
    {
      "description": "Automerge non-major provider source and locks; live plans and applies still require independent approval",
      "matchManagers": ["terraform"],
      "matchDatasources": ["terraform-provider"],
      "matchFileNames": ["infrastructure/tofu/**/versions.tf"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "OpenTofu providers",
      "groupSlug": "opentofu-providers",
      "automerge": true,
      "labels": ["tofu-provider"]
    },
    {
      "description": "Never infer automatic approval for major releases",
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "groupSlug": null,
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track annotated workflow tooling versions not extracted by native managers",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>npm|github-tags) depName=(?<depName>[^\\s]+)\\s+(?:[A-Z_]+_VERSION|version): (?<currentValue>[^\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Update the SOPS release tag and Linux amd64 asset checksum together",
      "managerFilePatterns": ["/^ansible/roles/compose_schedule/defaults/main\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=github-release-attachments depName=getsops/sops\\s+compose_schedule_sops_version: (?<currentValue>v[0-9.]+)\\s+compose_schedule_sops_sha256: (?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "getsops/sops",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^services/data/wolf/security\\.json$/"],
      "matchStrings": [
        "\"image\"\\s*:\\s*\"(?<depName>ghcr\\.io/games-on-whales/[^:\"]+):(?<currentValue>[^@\" ]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)services/[^/]+\\.ya?ml$/"
    ]
  }
}
