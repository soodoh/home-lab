{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "matchDepTypes": [
        "dependencies",
        "devDependencies"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Keep Docker updates isolated and manually reviewed",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true,
      "groupName": null,
      "separateMinorPatch": true,
      "minimumReleaseAge": "3 days",
      "automerge": false
    },
    {
      "description": "Mark the sole stateless Compose deployment canary",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/flaresolverr/flaresolverr"
      ],
      "labels": [
        "dependencies",
        "compose-canary"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Require an explicit migration for PostgreSQL major releases",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "postgres"
      ],
      "allowedVersions": "/^18(?:$|\\.|-)/"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/linuxserver/qbittorrent/"
      ],
      "allowedVersions": "/^5\\.[0-9]+\\.[0-9]+$/",
      "enabled": true
    },
    {
      "description": "Create candidate-only host lifecycle release updates",
      "matchManagers": [
        "custom.regex"
      ],
      "labels": [
        "dependencies",
        "host-maintenance-candidate"
      ],
      "groupName": null,
      "automerge": false
    },
    {
      "description": "Keep OpenTofu provider locks candidate-only and separately reviewed",
      "matchManagers": [
        "terraform"
      ],
      "labels": [
        "dependencies",
        "host-maintenance-candidate",
        "tofu-provider"
      ],
      "automerge": false
    }
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)services/[^/]+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible/collections/requirements\\.yml$/",
        "/^ansible/group_vars/docker_host\\.yml$/",
        "/^infrastructure/contract/home-lab\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s+(?:[a-z]+_)?version:\\s+[\\\"']?(?<currentValue>[^\\s\\\"']+)"
      ],
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^infrastructure/contract/home-lab\\.yml$/"
      ],
      "matchStrings": [
        "url: https://cloud\\.debian\\.org/images/cloud/trixie/(?<currentValue>[0-9]{8}-[0-9]+)/debian-13-generic-amd64-[0-9]{8}-[0-9]+\\.qcow2"
      ],
      "depNameTemplate": "debian-trixie-generic-cloud",
      "datasourceTemplate": "custom.debian-cloud-images",
      "versioningTemplate": "loose"
    }
  ],
  "customDatasources": {
    "debian-cloud-images": {
      "defaultRegistryUrlTemplate": "https://cloud.debian.org/images/cloud/trixie/",
      "format": "plain",
      "transformTemplates": [
        "{ \"releases\": $map(releases[$contains(version, \"href=\")], function($v) { { \"version\": $match($v.version, /([0-9]{8}-[0-9]+)/).groups[0] } }) }"
      ]
    }
  }
}
