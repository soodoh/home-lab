#!/bin/sh
set -eu

no_prune=${LOCAL_BACKUP_NO_PRUNE:-0}
no_prune_file=${LOCAL_BACKUP_NO_PRUNE_FILE:-}
case "$no_prune" in
  0|1) ;;
  *) echo "local_backup_replication=failed reason=no_prune_invalid" >&2; exit 1 ;;
esac
case "$no_prune_file" in
  ''|/tmp/.local-backup-no-prune) ;;
  *) echo "local_backup_replication=failed reason=no_prune_file_invalid" >&2; exit 1 ;;
esac
if [ -n "$no_prune_file" ] && [ -e "$no_prune_file" ]; then
  [ -f "$no_prune_file" ] && [ ! -L "$no_prune_file" ] || {
    echo "local_backup_replication=failed reason=no_prune_file_unsafe" >&2
    exit 1
  }
  no_prune=1
fi
archive=${COMMAND_RUNTIME_ARCHIVE_FILEPATH:?COMMAND_RUNTIME_ARCHIVE_FILEPATH is required}
basename=${archive##*/}
printf '%s\n' "$basename" | grep -Eq \
  '^daily-local-backup-[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}\.tar\.gz\.gpg$' || {
  echo "local_backup_replication=failed reason=archive_name_invalid" >&2
  exit 1
}

expected_sha256=$(sha256sum "$archive" | awk '{print $1}')
case "$expected_sha256" in
  [0-9a-f][0-9a-f][0-9a-f][0-9a-f]*) ;;
  *) echo "local_backup_replication=failed reason=checksum_invalid" >&2; exit 1 ;;
esac
[ "${#expected_sha256}" -eq 64 ]

for destination in /archive /replica-games; do
  [ -d "$destination" ] && [ ! -L "$destination" ] || {
    echo "local_backup_replication=failed reason=destination_invalid" >&2
    exit 1
  }
  target="$destination/$basename"
  if [ "$target" != "$archive" ]; then
    temporary="$destination/.$basename.partial.$$"
    rm -f -- "$temporary"
    cp -- "$archive" "$temporary"
    actual_sha256=$(sha256sum "$temporary" | awk '{print $1}')
    [ "$actual_sha256" = "$expected_sha256" ] || {
      rm -f -- "$temporary"
      echo "local_backup_replication=failed reason=replica_checksum_mismatch" >&2
      exit 1
    }
    chmod 0600 "$temporary"
    mv -f -- "$temporary" "$target"
  else
    actual_sha256=$(sha256sum "$target" | awk '{print $1}')
    [ "$actual_sha256" = "$expected_sha256" ] || {
      echo "local_backup_replication=failed reason=primary_checksum_mismatch" >&2
      exit 1
    }
    chmod 0600 "$target"
  fi

  checksum_temporary="$destination/.$basename.sha256.partial.$$"
  printf '%s  %s\n' "$expected_sha256" "$basename" >"$checksum_temporary"
  chmod 0600 "$checksum_temporary"
  mv -f -- "$checksum_temporary" "$target.sha256"
done

prune_destination() {
  destination=$1
  retention_days=$2
  retention_minutes=$((retention_days * 24 * 60))
  find "$destination" -maxdepth 1 -type f \
    -name 'daily-local-backup-????-??-??T??-??-??.tar.gz.gpg' \
    -mmin "+$retention_minutes" \
    -exec sh -c 'for archive do rm -f -- "$archive" "$archive.sha256"; done' sh {} +
  for checksum in "$destination"/daily-local-backup-*.tar.gz.gpg.sha256; do
    [ -e "$checksum" ] || continue
    [ -f "${checksum%.sha256}" ] || rm -f -- "$checksum"
  done
}

if [ "$no_prune" -eq 0 ]; then
  prune_destination /replica-games 7
  prune_destination /archive 7
else
  printf 'local_backup_pruning=disabled mode=validation\n'
  if [ -n "$no_prune_file" ] && [ -f "$no_prune_file" ] && [ ! -L "$no_prune_file" ]; then
    rm -f -- "$no_prune_file"
  fi
fi

printf 'local_backup_replication=verified destinations=2\n'
