{
  "version": 1,
  "common_paths": [
    "/etc/docker-compose/production.env"
  ],
  "groups": {
    "identity": {
      "services": ["postgres", "redis", "authentik-server", "authentik-worker"],
      "paths": [
        "/srv/home-lab-state/authentik-data/postgresql",
        "/srv/home-lab-state/authentik-data/media",
        "/srv/home-lab-state/authentik-data/custom-templates",
        "/srv/home-lab-state/authentik-data/certs/live",
        "/srv/home-lab-state/authentik-data/certs/archive"
      ]
    },
    "books": {
      "services": ["bookshelf", "calibre", "calibre-web-automated", "tachidesk", "caro-tachidesk"],
      "paths": [
        "/srv/home-lab-state/bookshelf-data",
        "/srv/home-lab-state/calibre-data/config",
        "/srv/home-lab-state/calibre-data/plugins",
        "/srv/home-lab-state/calibre-data/books",
        "/srv/home-lab-state/calibre-web-data",
        "/srv/home-lab-state/caro-tachidesk-data",
        "/srv/home-lab-state/tachidesk-data"
      ]
    },
    "media": {
      "services": ["jellyfin", "seerr", "gluetun", "flaresolverr", "prowlarr", "recyclarr", "sonarr", "radarr", "radarr-4k", "unpackerr", "qbittorrent", "sabnzbd"],
      "paths": [
        "/srv/home-lab-state/gluetun-data",
        "/srv/home-lab-state/jellyfin-data/config",
        "/srv/home-lab-state/seerr-data",
        "/srv/home-lab-state/prowlarr-data",
        "/srv/home-lab-state/qbittorrent-data",
        "/srv/home-lab-state/radarr-4k-data",
        "/srv/home-lab-state/radarr-data",
        "/srv/home-lab-state/recyclarr-data/configs",
        "/srv/home-lab-state/recyclarr-data/includes",
        "/srv/home-lab-state/recyclarr-data/settings.yml",
        "/srv/home-lab-state/sabnzbd-data",
        "/srv/home-lab-state/sonarr-data"
      ]
    },
    "nextcloud": {
      "services": ["nextcloud-db", "nextcloud-redis", "nextcloud", "nextcloud-cron"],
      "paths": [
        "/srv/home-lab-state/nextcloud-db-data",
        "/srv/home-lab-state/nextcloud-config",
        "/srv/home-lab-state/nextcloud-custom-apps",
        "/srv/home-lab-state/nextcloud-themes"
      ]
    },
    "home-automation": {
      "services": ["homeassistant", "zwave", "mosquitto", "frigate"],
      "paths": [
        "/srv/home-lab-state/frigate-data",
        "/srv/home-lab-state/mosquitto-data/config",
        "/srv/home-lab-state/mosquitto-data/data",
        "/srv/home-lab-state/zwave-data",
        "/srv/home-lab-state/hass-data"
      ]
    },
    "infrastructure": {
      "services": ["omada", "ddns-updater", "caddy"],
      "paths": [
        "/srv/home-lab-state/ddns-updater-data",
        "/srv/home-lab-state/omada-data/data",
        "/home/docker/.ssh"
      ]
    },
    "applications": {
      "services": ["vaultwarden", "vikunja", "litellm", "cli-proxy-api", "openfit", "karaoke-eternal"],
      "paths": [
        "/srv/home-lab-state/karaoke-eternal-data",
        "/srv/home-lab-state/litellm-data",
        "/srv/home-lab-state/cli-proxy-api/auths",
        "/srv/home-lab-state/openfit-data",
        "/srv/home-lab-state/vaultwarden-data",
        "/srv/home-lab-state/vikunja-data"
      ]
    },
    "gaming": {
      "services": ["wolf"],
      "paths": [
        "/mnt/games/wolf/cfg",
        "/mnt/games/wolf/profile-data/paul/WolfES-DE/.config",
        "/mnt/games/wolf/profile-data/paul/WolfES-DE/.local/share",
        "/mnt/games/wolf/profile-data/paul/WolfES-DE/ES-DE"
      ]
    }
  }
}
