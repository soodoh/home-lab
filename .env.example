# shellcheck disable=SC2034  # Sourced by the operator; variables are used by child tools.
# Copy to gitignored .env, chmod 0600 .env, and fill in controller-local values.
# Shell syntax: quote values containing $, #, spaces, or other shell metacharacters.
# These are separate plan (read-oriented) and apply (write-capable) identities.
# Do not add fresh host observations, decrypted SOPS values, or generated session files.
SOPS_AGE_KEY_FILE=/protected/path/to/age-identity
TF_BACKEND_BUCKET=
AUTHENTIK_PLAN_TOKEN=
AUTHENTIK_APPLY_TOKEN=
TAILSCALE_PLAN_ID=
TAILSCALE_PLAN_SECRET=
TAILSCALE_APPLY_ID=
TAILSCALE_APPLY_SECRET=
OMADA_PLAN_USERNAME=
OMADA_PLAN_PASSWORD=
OMADA_APPLY_USERNAME=
OMADA_APPLY_PASSWORD=

# Reserved for the unified deploy entry point; the current helper does not use these yet.
# Use the full PROXMOX_VE_API_TOKEN value (token identity and secret), not just its secret.
PROXMOX_PLAN_TOKEN=
PROXMOX_APPLY_TOKEN=
