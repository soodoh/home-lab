# shellcheck disable=SC2034  # Sourced by the operator; variables are used by child tools.
# Copy to gitignored .env, chmod 0600 .env, and fill in controller-local values.
# Shell syntax: quote values containing $, #, spaces, or other shell metacharacters.
# These are separate plan (read-oriented) and apply (write-capable) identities.
# Do not add fresh host observations, decrypted SOPS values, or generated session files.
SOPS_AGE_KEY_FILE=/protected/path/to/age-identity
TF_BACKEND_BUCKET=
# Native storage reads require an independently approved scoped mutating grant;
# Datastore.Allocate also permits volume deletion. Do not treat this as read-only.
PROXMOX_PLAN_TOKEN=
PROXMOX_APPLY_TOKEN=
# Optional independent owner credentials for proxmox-access only. These must not
# be either managed automation token. Use an independently owned state bucket
# outside ordinary controller object-write and bucket-policy authority.
PROXMOX_ACCESS_BACKEND_BUCKET=
PROXMOX_ACCESS_PLAN_TOKEN=
PROXMOX_ACCESS_APPLY_TOKEN=
AUTHENTIK_PLAN_TOKEN=
AUTHENTIK_APPLY_TOKEN=
TAILSCALE_PLAN_ID=
TAILSCALE_PLAN_SECRET=
TAILSCALE_APPLY_ID=
TAILSCALE_APPLY_SECRET=
OMADA_PLAN_USERNAME=
OMADA_PLAN_PASSWORD=
OMADA_APPLY_USERNAME=
OMADA_APPLY_PASSWORD=
