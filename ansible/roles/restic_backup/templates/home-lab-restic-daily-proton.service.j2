[Unit]
Description=Home Lab Restic daily Proton replication
Requires=home-lab-restic-daily-local.service
After=home-lab-restic-daily-local.service network-online.target

[Service]
Type=oneshot
User=restic-proton
Group=restic-proton
UMask=0077
ExecStart={{ restic_systemd.runner_path }} daily-proton
TimeoutStartSec=12h
KillSignal=SIGINT
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
InaccessiblePaths=/srv/home-lab-state /mnt/storage /home/docker /etc/docker-compose
TemporaryFileSystem=/mnt/games:ro
BindReadOnlyPaths={{ restic_systemd.games_repository_path }}
BindPaths={{ restic_systemd.games_repository_path }}/locks
ReadOnlyPaths=/etc/home-lab/restic
ReadWritePaths=/var/lib/restic-proton {{ restic_systemd.lock_path }}
