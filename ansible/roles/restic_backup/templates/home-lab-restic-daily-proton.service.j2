[Unit]
Description=Home Lab proton repository reconciliation
After=network-online.target
Wants=network-online.target
RequiresMountsFor={{ restic_systemd.games_mountpoint }}

[Service]
Type=oneshot
User=restic-proton
Group=restic-proton
UMask=0077
ExecStart={{ restic_systemd.runner_path }} daily-proton
TimeoutStartSec=12h
TimeoutStopSec=5min
KillSignal=SIGINT
# Runner forwards one interrupt to Restic; keep its backend alive for lock cleanup.
KillMode=mixed
NoNewPrivileges=true
# UUID admission needs device metadata, never raw-device access.
DevicePolicy=closed
CapabilityBoundingSet=~CAP_MKNOD CAP_SYS_RAWIO
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
InaccessiblePaths=/srv/home-lab-state /etc/docker-compose
TemporaryFileSystem=/mnt/games:ro
BindReadOnlyPaths={{ restic_systemd.games_repository_path }}
BindPaths={{ restic_systemd.games_repository_path }}/locks
ReadOnlyPaths=/etc/home-lab/restic
ReadWritePaths={{ restic_systemd.games_repository_path }}/locks /run/lock /var/lib/restic-proton
