[Unit]
Description=Home Lab Restic daily local snapshot and NFS copy
RequiresMountsFor={{ restic_systemd.games_mountpoint }}
After=docker.service network-online.target
Wants=network-online.target
Before=home-lab-restic-daily-proton.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0027
ExecStart={{ restic_systemd.runner_path }} daily-local
TimeoutStartSec=8h
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths={{ restic_systemd.games_mountpoint }}/restic {{ restic_systemd.nfs_mountpoint }}/restic /var/lib/home-lab-restic /var/cache/home-lab-restic {{ restic_systemd.lock_path }} /run/docker.sock
