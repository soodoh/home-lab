[Unit]
Description=Home Lab Restic daily local snapshot and NFS copy
RequiresMountsFor={{ backups.restic.repositories.games.mountpoint }}
After=docker.service network-online.target
Wants=network-online.target
Before=home-lab-restic-daily-proton.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0027
ExecStart={{ backups.restic.runner.path }} daily-local
TimeoutStartSec=8h
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths={{ backups.restic.repositories.games.mountpoint }}/restic {{ backups.restic.repositories.nfs.mountpoint }}/restic /var/lib/home-lab-restic /var/cache/home-lab-restic {{ backups.restic.runner.lock_path }} /run/docker.sock
