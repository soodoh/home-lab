[Unit]
Description=Home Lab complete local capture
RequiresMountsFor={{ restic_systemd.games_mountpoint }} {{ restic_systemd.nfs_mountpoint }}
After=docker.service network-online.target
Wants=network-online.target
OnSuccess=home-lab-restic-replication.target
StartLimitIntervalSec=12h
StartLimitBurst=3

[Service]
Type=oneshot
User=root
Group=root
UMask=0027
ExecStart={{ restic_systemd.runner_path }} daily-local
# Preserve the 8h capture/upload budget plus the 13h completion command budget.
TimeoutStartSec=24h
Restart=on-failure
RestartSec=10min
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths={{ restic_systemd.games_mountpoint }}/restic {{ restic_systemd.games_mountpoint }}/home-lab-backup /var/lib/home-lab-restic /var/cache/home-lab-restic /run/lock /run/docker.sock
TimeoutStopSec=5min
