[Unit]
Description=Recover services interrupted by a Restic snapshot window
After=docker.service
ConditionPathExists={{ restic_systemd.journal_path }}

[Service]
Type=oneshot
User=root
Group=root
UMask=0027
ExecStart={{ restic_systemd.runner_path }} recover
TimeoutStartSec=15m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=-{{ restic_systemd.games_repository_path }} -{{ restic_systemd.nfs_repository_path }} /var/lib/home-lab-restic /var/cache/home-lab-restic /run/lock /run/docker.sock

[Install]
WantedBy=multi-user.target
