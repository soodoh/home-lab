# Disable SATA link power saving only on the reviewed motherboard controller.
# Match PCI identity rather than boot-dependent scsi_host numbers.
ACTION=="add", SUBSYSTEM=="scsi_host", KERNELS=="0000:0d:00.0", ATTRS{vendor}=="0x1022", ATTRS{device}=="0x43f6", ATTR{link_power_management_policy}="max_performance"
