[Unit]
Description=Snapshot-only backup RPC over the Tailscale interface
# tailscaled starts after basic.target, so this is not an early boot socket.
DefaultDependencies=no
After=tailscaled.service
Requires=tailscaled.service
Before=shutdown.target
Conflicts=shutdown.target

[Socket]
ListenStream={{ zfs_backup_snapshot_tailscale_ipv4 }}:2444
BindToDevice=tailscale0
FreeBind=yes
Accept=yes
MaxConnections=4
MaxConnectionsPerSource=2
Backlog=4

[Install]
WantedBy=multi-user.target
