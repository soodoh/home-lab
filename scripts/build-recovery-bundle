#!/usr/bin/env bash
set -euo pipefail
umask 077

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

output=
omada_export=.local/omada/export.json
current_lock=
previous_lock=
evidence_file=
while (($#)); do
  case "$1" in
    --output) output=${2:?}; shift 2 ;;
    --omada-export) omada_export=${2:?}; shift 2 ;;
    --current-image-lock) current_lock=${2:?}; shift 2 ;;
    --previous-image-lock) previous_lock=${2:?}; shift 2 ;;
    --recovery-evidence) evidence_file=${2:?}; shift 2 ;;
    *) exit 64 ;;
  esac
done
[[ $output == *.tar.gz.age ]]
[[ -f $omada_export && -f $current_lock && -f $previous_lock && -f $evidence_file ]]
for command in age git jq node python3; do
  command -v "$command" >/dev/null || { echo "missing command: $command" >&2; exit 69; }
done
[[ -z $(git status --porcelain --untracked-files=all) ]]
commit=$(git rev-parse HEAD)
jq -e --arg commit "$commit" '.schema == 1 and .commit == $commit' "$evidence_file" >/dev/null
for lock in "$current_lock" "$previous_lock"; do
  jq -e '.schema == 1 and (.images | type == "array" and length > 0)' "$lock" >/dev/null
done

contract_json=$(node --input-type=module - <<'NODE'
import fs from "node:fs";
import { load } from "js-yaml";
process.stdout.write(JSON.stringify(load(fs.readFileSync("infrastructure/contract/home-lab.yml", "utf8"))));
NODE
)
recovery_recipient=$(jq -r '.recovery.recovery_age_recipient' <<<"$contract_json")
[[ $recovery_recipient == age1* ]]
evidence_max_age_days=$(jq -r '.recovery.evidence_max_age_days' <<<"$contract_json")
EVIDENCE_FILE="$evidence_file" EVIDENCE_MAX_AGE_DAYS="$evidence_max_age_days" python3 - <<'PY'
import os
from pathlib import Path
import time

age_seconds = time.time() - Path(os.environ["EVIDENCE_FILE"]).stat().st_mtime
if age_seconds < 0 or age_seconds > float(os.environ["EVIDENCE_MAX_AGE_DAYS"]) * 86400:
    raise SystemExit("recovery evidence is stale")
PY

workspace=$(mktemp -d)
cleanup() { rm -rf "$workspace"; }
trap cleanup EXIT INT TERM
mkdir -p "$workspace/bundle/private" "$workspace/bundle/evidence"
git archive HEAD | tar -xf - -C "$workspace/bundle"
install -m 0600 "$omada_export" "$workspace/bundle/private/omada-export.json"
install -m 0600 "$current_lock" "$workspace/bundle/evidence/current-images.json"
install -m 0600 "$previous_lock" "$workspace/bundle/evidence/previous-images.json"
install -m 0600 "$evidence_file" "$workspace/bundle/evidence/recovery-proof.json"

jq -n \
  --arg commit "$commit" \
  --arg arch_image_version "$(jq -r '.proxmox.vm.cloud_image.version' <<<"$contract_json")" \
  --arg arch_image_sha256 "$(jq -r '.proxmox.vm.cloud_image.sha256' <<<"$contract_json")" \
  '{schema: 1, commit: $commit, arch_image_version: $arch_image_version,
    arch_image_sha256: $arch_image_sha256}' \
  >"$workspace/bundle/RECOVERY-METADATA.json"

(
  cd "$workspace/bundle"
  find . -type f -print0 \
    | LC_ALL=C sort -z \
    | xargs -0 shasum -a 256 >"$workspace/MANIFEST.sha256"
)
install -m 0600 "$workspace/MANIFEST.sha256" "$workspace/bundle/MANIFEST.sha256"

BUNDLE_ROOT="$workspace/bundle" BUNDLE_ARCHIVE="$workspace/bundle.tar.gz" python3 - <<'PY'
import gzip
import os
from pathlib import Path
import tarfile

root = Path(os.environ["BUNDLE_ROOT"])
with open(os.environ["BUNDLE_ARCHIVE"], "wb") as raw:
    with gzip.GzipFile(fileobj=raw, mode="wb", mtime=0) as compressed:
        with tarfile.open(fileobj=compressed, mode="w") as archive:
            for path in sorted(root.rglob("*"), key=lambda item: item.as_posix()):
                info = archive.gettarinfo(path, arcname=path.relative_to(root).as_posix())
                info.mtime = 0
                info.uid = 0
                info.gid = 0
                info.uname = "root"
                info.gname = "root"
                if path.is_file():
                    with path.open("rb") as stream:
                        archive.addfile(info, stream)
                else:
                    archive.addfile(info)
PY

mkdir -p "$(dirname "$output")"
age --recipient "$recovery_recipient" --output "$output" "$workspace/bundle.tar.gz"
chmod 0600 "$output"
echo "recovery_bundle_sha256=$(shasum -a 256 "$output" | awk '{print $1}')"
