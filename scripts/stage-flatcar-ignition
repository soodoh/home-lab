#!/bin/bash
set -euo pipefail

readonly IGNITION_VERSION=3.4.0
readonly EXPECTED_SHA256=55c4f9f09369473790cd39a24ba78111afd4e35f3ff0a70df0c9d82ac4c4583f
readonly EXPECTED_SIZE=75565
readonly PREVIOUS_SHA256=28b483e3ecb82e9b16bb0f6cee7c4331fd45e47fd85d3492d5492b13c615a0d4
readonly PREVIOUS_SIZE=75538
readonly STORAGE_PARENT=/var/lib/vz
readonly STORAGE_ROOT=$STORAGE_PARENT/snippets
readonly TARGET=$STORAGE_ROOT/vm-100-flatcar.ign
readonly PENDING=$STORAGE_ROOT/.vm-100-flatcar.ign.pending
readonly LOCK=/run/lock/home-lab-flatcar-ignition-stage.lock
readonly CONFIRMATION=stage-reviewed-vm-100-flatcar-ignition
readonly PATH=/usr/sbin:/usr/bin:/sbin:/bin

fail() {
  echo "error: $*" >&2
  exit 1
}

emit() {
  local state=$1
  printf '{"ignitionVersion":"%s","path":"%s","sha256":"%s","size":%s,"state":"%s"}\n' \
    "$IGNITION_VERSION" "$TARGET" "$EXPECTED_SHA256" "$EXPECTED_SIZE" "$state"
}

require_parent() {
  [[ -d $STORAGE_PARENT && ! -L $STORAGE_PARENT ]] || fail "Proxmox local storage root is absent or unsafe"
  [[ $(stat -c %U:%G "$STORAGE_PARENT") == root:root ]] || fail "Proxmox local storage ownership differs"
  [[ $(stat -c %a "$STORAGE_PARENT") =~ ^(755|750|700)$ ]] || fail "Proxmox local storage permissions differ"
}

require_storage() {
  [[ -d $STORAGE_ROOT && ! -L $STORAGE_ROOT ]] || fail "Proxmox snippets directory is unsafe"
  [[ $(stat -c %U:%G "$STORAGE_ROOT") == root:root ]] || fail "Proxmox snippets ownership differs"
  [[ $(stat -c %a "$STORAGE_ROOT") == 755 ]] || fail "Proxmox snippets permissions differ"
}

inspect_target() {
  if [[ ! -e $TARGET && ! -L $TARGET ]]; then
    emit absent
    return 2
  fi
  [[ -f $TARGET && ! -L $TARGET ]] || fail "Ignition target is not a regular non-symlink file"
  [[ $(stat -c %U:%G:%a:%s "$TARGET") == root:root:600:$EXPECTED_SIZE ]] || fail "Ignition metadata differs"
  local actual
  actual=$(sha256sum "$TARGET" | awk '{print $1}')
  [[ $actual == "$EXPECTED_SHA256" ]] || fail "Ignition digest differs; refusing replacement"
  emit verified
}

validate_ignition() {
  python3 - "$1" "$IGNITION_VERSION" <<'PY'
import json
import sys

with open(sys.argv[1], "rb") as handle:
    value = json.load(handle)
if not isinstance(value, dict) or set(value) - {"ignition", "passwd", "storage", "systemd"}:
    raise SystemExit("Ignition contains an unexpected top-level key")
ignition = value.get("ignition")
if not isinstance(ignition, dict) or ignition.get("version") != sys.argv[2]:
    raise SystemExit("Ignition version differs")
PY
}

[[ $# -eq 1 && $1 =~ ^(check|stage)$ ]] || fail "usage: scripts/stage-flatcar-ignition <check|stage>"
[[ $(id -u) -eq 0 ]] || fail "Ignition staging requires root"
require_parent

if [[ $1 == check ]]; then
  if [[ ! -e $STORAGE_ROOT && ! -L $STORAGE_ROOT ]]; then
    emit storage-absent
    exit 2
  fi
  require_storage
  inspect_target
  exit $?
fi

[[ ${HOME_LAB_FLATCAR_IGNITION_CONFIRMED:-} == "$CONFIRMATION" ]] || fail "exact Ignition staging confirmation is required"
[[ $(ps -o tty= -p "$$" | tr -d ' ') =~ ^tty[0-9]+$ ]] || fail "Ignition staging requires a physical Proxmox console"
exec 9>"$LOCK"
flock -n 9 || fail "another Ignition staging operation holds the lock"
if [[ ! -e $STORAGE_ROOT && ! -L $STORAGE_ROOT ]]; then
  install -d -o root -g root -m 0755 "$STORAGE_ROOT"
fi
require_storage
[[ ! -e $PENDING && ! -L $PENDING ]] || fail "a pending Ignition file requires manual reconciliation"

replacement=false
if [[ -e $TARGET || -L $TARGET ]]; then
  [[ -f $TARGET && ! -L $TARGET ]] || fail "Ignition target is not a regular non-symlink file"
  existing_metadata=$(stat -c %U:%G:%a:%s "$TARGET")
  existing_actual=$(sha256sum "$TARGET" | awk '{print $1}')
  if [[ $existing_metadata == root:root:600:$EXPECTED_SIZE && $existing_actual == "$EXPECTED_SHA256" ]]; then
    emit verified
    exit 0
  fi
  [[ $existing_metadata == root:root:600:$PREVIOUS_SIZE ]] || fail "existing Ignition metadata is not the exact replaceable revision"
  [[ $existing_actual == "$PREVIOUS_SHA256" ]] || fail "existing Ignition digest is not the exact replaceable revision"
  replacement=true
fi

cleanup() {
  rm -f -- "$PENDING"
}
trap cleanup EXIT

umask 077
head -c "$((EXPECTED_SIZE + 1))" > "$PENDING"
[[ $(stat -c %s "$PENDING") -eq $EXPECTED_SIZE ]] || fail "Ignition size differs"
actual=$(sha256sum "$PENDING" | awk '{print $1}')
[[ $actual == "$EXPECTED_SHA256" ]] || fail "Ignition digest differs"
validate_ignition "$PENDING"
chown root:root "$PENDING"
chmod 0600 "$PENDING"
if [[ $replacement == true ]]; then
  mv -f -- "$PENDING" "$TARGET"
else
  ln "$PENDING" "$TARGET"
  rm "$PENDING"
fi
sync -f "$STORAGE_ROOT"
trap - EXIT
inspect_target
