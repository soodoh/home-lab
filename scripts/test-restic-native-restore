#!/usr/bin/env bash
# Real capture archive production and Restic recovery in a private Linux mount namespace.
# CI/disposable Linux only; never a production-host validation command.
set -euo pipefail
umask 077
[[ $EUID == 0 && $(uname -s) == Linux && ! -e /etc/home-lab ]] || exit 64
[[ ${RESTIC_NATIVE_TEST_DISPOSABLE:-false} == true ]] || exit 64
[[ $# == 1 || $# == 2 ]] || exit 64
repo_root=$(cd "$(dirname "$0")/.." && pwd -P)
restic_source=$(realpath -- "$1")
if [[ $# == 1 ]]; then
  exec unshare --mount --fork --propagation private -- "$0" "$restic_source" "$(readlink /proc/self/ns/mnt)"
fi
[[ $(readlink /proc/self/ns/mnt) != "$2" ]] || exit 64
work=$(mktemp -d "${TMPDIR:-/tmp}/restic-native-test.XXXXXXXX")
snapshot_targets=()
cleanup() {
  status=$?
  trap - EXIT
  for target in "${snapshot_targets[@]}"; do
    if mountpoint -q "$target"; then umount "$target"; fi
  done
  mountpoint -q /srv && umount /srv
  mountpoint -q /mnt && umount /mnt
  rm -rf -- "$work"
  exit "$status"
}
trap cleanup EXIT
mkdir -m 0700 "$work/mnt" "$work/srv" "$work/bin" "$work/recovery"
mount --bind "$work/mnt" /mnt
mount --bind "$work/srv" /srv
install -m 0755 "$restic_source" "$work/bin/restic"
cp "$repo_root/scripts/restore-critical-backup" "$repo_root/scripts/recovery-scope.py" \
  "$repo_root/scripts/prepare-restic-files.py" "$work/bin/"
chmod 0755 "$work/bin/restore-critical-backup" "$work/bin/recovery-scope.py"
export PATH="$work/bin:$PATH"
export RESTIC_REPOSITORY=/mnt/games/restic/home-lab
export RESTIC_PASSWORD_FILE="$work/password"
export RESTIC_CACHE_DIR="$work/cache"
printf '%s\n' 'synthetic-native-restic-test-password' >"$RESTIC_PASSWORD_FILE"
mkdir -p /mnt/games/restic /srv/home-lab-state/{common,books,unselected} /srv/home-lab-recovery
chmod 0700 /srv/home-lab-recovery
printf '%s\n' 'synthetic-common' >/srv/home-lab-state/common/value
printf '%s\n' 'synthetic-selected-book' >/srv/home-lab-state/books/value
printf '%s\n' 'synthetic-unselected' >/srv/home-lab-state/unselected/value
cat >"$work/recovery/groups.json" <<'JSON'
{"version":1,"common_paths":["/srv/home-lab-state/common"],"groups":{
  "books":{"services":["book-app"],"paths":["/srv/home-lab-state/books","/mnt/storage/media/tachidesk","/mnt/storage/media/books","/mnt/storage/media/uchiyomi/downloads"]},
  "other":{"services":["other-app"],"paths":["/srv/home-lab-state/unselected","/mnt/storage/media/frigate/exports"]},
  "wolf":{"services":["wolf"],"paths":["/mnt/games/roms","/mnt/games/wolf"]}
}}
JSON
policy_sha=$(printf 'synthetic-policy' | sha256sum | cut -d' ' -f1)
artifact_sha=$(printf 'synthetic-artifact' | sha256sum | cut -d' ' -f1)
restic init >/dev/null 2>&1
restic backup /srv/home-lab-state --tag cadence=daily --tag "policy=$policy_sha" --tag "artifact=$artifact_sha" >/dev/null 2>&1
snapshot=$(restic snapshots --json | jq -er '.[0].id')
export RECOVERY_RESTIC_REPOSITORY=$RESTIC_REPOSITORY RECOVERY_RESTIC_PASSWORD_FILE=$RESTIC_PASSWORD_FILE
export RECOVERY_EXPECTED_RESTIC_REPOSITORY_ID
RECOVERY_EXPECTED_RESTIC_REPOSITORY_ID=$(restic cat config | jq -er .id)
export RECOVERY_EXPECTED_POLICY_SHA256=$policy_sha RECOVERY_EXPECTED_COMPOSE_ARTIFACT_SHA256=$artifact_sha
export RECOVERY_EXPECTED_RESTIC_SHA256
RECOVERY_EXPECTED_RESTIC_SHA256=$(sha256sum "$work/bin/restic" | cut -d' ' -f1)
for scope in books all; do
  export RECOVERY_TARGET="/srv/home-lab-recovery/restic-$scope"
  mkdir -m 0700 "$RECOVERY_TARGET"
  selection=(--recovery-group books)
  [[ $scope != all ]] || selection=(--all)
  output=$("$work/bin/restore-critical-backup" --restic-snapshot-id "$snapshot" --confirmed-empty-target "${selection[@]}")
  [[ $output == recovery_restore=verified* && $output != *synthetic-selected-book* ]]
  for selected in common books; do
    cmp "/srv/home-lab-state/$selected/value" "$RECOVERY_TARGET/srv/home-lab-state/$selected/value"
  done
  if [[ $scope == books ]]; then
    [[ ! -e $RECOVERY_TARGET/srv/home-lab-state/unselected ]]
  else
    cmp /srv/home-lab-state/unselected/value "$RECOVERY_TARGET/srv/home-lab-state/unselected/value"
  fi
  [[ ! -e $RECOVERY_TARGET.proof-lock ]]
done
# Use real staging and ready-manifest publication, substituting only application
# and writer I/O. The frozen views are projected before native Restic reads.
artifact_file="$work/artifact.sha256"
printf '%s\n' "$artifact_sha" >"$artifact_file"
capture=$(python3 - "$repo_root" "$artifact_file" "$policy_sha" <<'PY'
from contextlib import ExitStack
import json
from pathlib import Path
import runpy
import shutil
import sys
from types import SimpleNamespace
from unittest.mock import patch

repo, artifact_file = map(Path, sys.argv[1:3])
runner = runpy.run_path(str(repo / 'scripts/restic-backup'))
adapter = SimpleNamespace(**runpy.run_path(str(repo / 'scripts/restic-capture-files.py')))
settings = json.loads((repo / 'services/data/restic/policy.json').read_text())['capture']
stage = Path(settings['stage'])
stage.parent.mkdir(mode=0o700)
adapter.fresh_stage(stage, 0)
policy = {'runner': {'artifact_hash_path': str(artifact_file)}, 'capture': {'radio_max_age_seconds': 0}}
capture = runner['LocalCapture'](policy)
plan = SimpleNamespace(sources=SimpleNamespace(zfs=(), state=()), cold_names=['books'],
                       maintenance_names=[], state_names=[], zfs_names=[],
                       databases=[{'name': 'example.sql', 'engine': 'mariadb'}])

def capture_fixture(_adapter, workspace, _plan):
    files = workspace / 'files/srv/home-lab-state'
    shutil.copytree('/srv/home-lab-state', files)
    (files / 'books/link').symlink_to('../common/value')
    (workspace / 'databases/example.sql').write_bytes(b'synthetic-logical-export')
    (workspace / 'native/example.archive').write_bytes(b'synthetic-opaque-native-export')
    return []

with patch.object(capture, '_capture_online', capture_fixture), patch.object(capture, '_pause_writers'), \
        patch.object(adapter, 'radio_check'), ExitStack() as attachments:
    capture._stage_fresh(adapter, stage, plan, sys.argv[3], attachments)
print(stage)
PY
)
# Simulate three immutable views from one source snapshot at the archive paths.
# The broker tests cover NFS identity; here read-only bind mounts prove that
# real Restic includes separately mounted roots and can restore without them.
for root in tachidesk books frigate/exports uchiyomi/downloads; do
  live="/mnt/storage/media/$root"
  frozen="$work/snapshot/$root"
  target="$capture/files$live"
  mkdir -p "$live" "$frozen" "$target"
  printf 'frozen %s\n' "$root" >"$live/value"
  cp -a "$live/value" "$frozen/"
  rm -- "$live/value"
  printf 'new %s\n' "$root" >"$live/new"
  snapshot_targets+=("$target")
  mount --bind "$frozen" "$target"
  mount -o remount,bind,ro "$target"
done
python3 - "$repo_root" "$capture" <<'PY'
import json, pathlib, runpy, subprocess, sys
repo, stage = map(pathlib.Path, sys.argv[1:3])
adapter = runpy.run_path(str(repo / 'scripts/restic-capture-files.py'))
policy = json.loads((repo / 'services/data/restic/policy.json').read_text())
roots = adapter['capture_sources'](policy['capture']).live_games
for root in roots:
    root.mkdir(parents=True, exist_ok=True)
    (root / 'fixture').write_bytes(b'protected')
profile = next(root.parent.parent for root in roots if root.name == 'retroarch')
excluded = ['/mnt/games/wolf/cfg/backtrace.previous.dump',
            str(profile / '.steam/steam/steamapps/common/game/install'),
            str(profile / '.steam/steam/steamapps/compatdata/123/pfx/save'),
            str(profile / '.config/retroarch/assets/test'),
            str(profile / '.config/rpcs3/dev_hdd0/game/test')]
for name in excluded:
    path = pathlib.Path(name)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.touch()
rom = pathlib.Path('/mnt/games/roms')
projection = stage / 'files' / rom.relative_to('/')
missing = pathlib.Path('/mnt/games/synthetic-missing-source')
try:
    with adapter['live_games_mounted']([*roots, missing], stage):
        raise AssertionError('missing source admitted')
except adapter['CaptureError'] as exc:
    assert str(exc) == 'source_missing'
assert not projection.exists(), 'partial projection after preflight failure'
with adapter['live_games_mounted'](roots, stage):
    assert projection.joinpath('fixture').samefile(rom / 'fixture'), 'must mount, not copy'
    try:
        (projection / 'blocked').touch()
    except OSError:
        pass
    else:
        raise AssertionError('live archive view writable')
    (rom / 'fixture').write_bytes(b'new live bytes')
    flags = ['--exclude=' + pattern for pattern in adapter['state_snapshot_exclusions'](
        stage, repo / 'services/data/restic/excludes')]
    manifest = json.loads((stage / 'manifest.json').read_text())
    tags = [f'--tag={name}={manifest[name]}' for name in ('capture', 'policy', 'artifact')]
    subprocess.run(['restic', 'backup', str(stage), '--tag', 'cadence=daily', '--tag', 'format=full-v2',
                    *tags, *flags], check=True, capture_output=True)
assert not any(projection.iterdir()), 'temporary view still mounted or contains a copy'
(rom / 'fixture').unlink()
PY
snapshot=$(restic snapshots --json --tag format=full-v2 | jq -er '.[0].id')
for target in "${snapshot_targets[@]}"; do umount "$target"; done
rm -rf -- "$work/snapshot"
export RECOVERY_TARGET=/srv/home-lab-recovery/restic-incomplete
mkdir -m 0700 "$RECOVERY_TARGET"
if "$work/bin/restore-critical-backup" --restic-snapshot-id "$snapshot" --confirmed-empty-target --all >"$work/refused.log" 2>&1; then
  echo 'incomplete snapshot was admitted' >&2
  exit 1
fi
restic tag --add complete=full-v2 "$snapshot" >/dev/null 2>&1
snapshot=$(restic snapshots --json --tag complete=full-v2 | jq -er '.[0].id')
for scope in books all; do
  export RECOVERY_TARGET="/srv/home-lab-recovery/restic-v2-$scope"
  mkdir -m 0700 "$RECOVERY_TARGET"
  selection=(--recovery-group books)
  [[ $scope != all ]] || selection=(--all)
  output=$("$work/bin/restore-critical-backup" --restic-snapshot-id "$snapshot" --confirmed-empty-target "${selection[@]}")
  [[ $output == recovery_restore=verified* ]]
  cmp /srv/home-lab-state/common/value "$RECOVERY_TARGET/srv/home-lab-state/common/value"
  cmp /srv/home-lab-state/books/value "$RECOVERY_TARGET/srv/home-lab-state/books/value"
  cmp "$capture/databases/example.sql" "$RECOVERY_TARGET/recovery-exports/databases/example.sql"
  cmp "$capture/native/example.archive" "$RECOVERY_TARGET/recovery-exports/native/example.archive"
  [[ ! -L $RECOVERY_TARGET/srv/home-lab-state/books/link ]]
  jq -e --arg policy "$policy_sha" --arg artifact "$artifact_sha" '
    .policy == $policy and .artifact == $artifact and .databases[0].name == "example.sql"
    and .symlinks["/srv/home-lab-state/books/link"] == "../common/value"
  ' "$RECOVERY_TARGET/recovery-exports/manifest.json" >/dev/null
  [[ ! -e $RECOVERY_TARGET/mnt/games/home-lab-backup/capture ]]
  for root in tachidesk books uchiyomi/downloads; do
    printf 'frozen %s\n' "$root" | cmp - "$RECOVERY_TARGET/mnt/storage/media/$root/value"
    [[ ! -e $RECOVERY_TARGET/mnt/storage/media/$root/new ]]
  done
  if [[ $scope == books ]]; then
    [[ ! -e $RECOVERY_TARGET/srv/home-lab-state/unselected ]]
    [[ ! -e $RECOVERY_TARGET/mnt/storage/media/frigate/exports ]]
  else
    printf 'frozen frigate/exports\n' | cmp - "$RECOVERY_TARGET/mnt/storage/media/frigate/exports/value"
  fi
done
export RECOVERY_TARGET=/srv/home-lab-recovery/restic-v2-wolf
mkdir -m 0700 "$RECOVERY_TARGET"
"$work/bin/restore-critical-backup" --restic-snapshot-id "$snapshot" --confirmed-empty-target --recovery-group wolf >/dev/null
printf 'new live bytes' | cmp - "$RECOVERY_TARGET/mnt/games/roms/fixture"
profile="$RECOVERY_TARGET/mnt/games/wolf/profile-data/paul/WolfES-DE"
for dir in ES-DE .config/retroarch .config/dolphin-emu .local/share/dolphin-emu .config/rpcs3 .local/share/xemu; do
  printf 'protected' | cmp - "$profile/$dir/fixture"
done
[[ ! -e $profile/.steam && ! -e $profile/.config/retroarch/assets/test && ! -e $profile/.config/rpcs3/dev_hdd0/game/test ]]
printf 'protected' | cmp - "$RECOVERY_TARGET/mnt/games/wolf/cfg/fixture"
[[ ! -e $RECOVERY_TARGET/mnt/games/wolf/cfg/backtrace.previous.dump && ! -e $RECOVERY_TARGET/mnt/storage/media/books/value ]]
# Reject unknown and conflicting formats before writing even a selective restore.
restic tag --add format=future "$snapshot" >/dev/null 2>&1
snapshot=$(restic snapshots --json --tag format=future | jq -er '.[0].id')
for format in conflicting unknown; do
  if [[ $format == unknown ]]; then
    restic tag --remove format=full-v2 --remove complete=full-v2 "$snapshot" >/dev/null 2>&1
    snapshot=$(restic snapshots --json --tag format=future | jq -er '.[0].id')
  fi
  for scope in books all; do
    export RECOVERY_TARGET="/srv/home-lab-recovery/restic-$format-$scope"
    mkdir -m 0700 "$RECOVERY_TARGET"
    selection=(--recovery-group books)
    [[ $scope != all ]] || selection=(--all)
    if "$work/bin/restore-critical-backup" --restic-snapshot-id "$snapshot" --confirmed-empty-target \
      "${selection[@]}" >"$work/refused.log" 2>&1; then
      echo 'unsupported snapshot format was admitted' >&2
      exit 1
    fi
    grep -q 'unsupported or conflicting capture format' "$work/refused.log"
    [[ -z $(find "$RECOVERY_TARGET" -mindepth 1 -print -quit) ]]
    [[ ! -e $RECOVERY_TARGET.proof-lock ]]
  done
done
printf 'native_restic_restore=verified legacy-and-full-v2 selective-and-complete\n'
