#!/usr/bin/env bash
set -euo pipefail
umask 077

usage() {
  echo "usage: application-api-tunnels <start|stop> SOCKET" >&2
  exit 64
}

(($# == 2)) || usage
operation=$1
socket=$2

: "${HOMELAB_APPLICATION_TUNNEL_HOST:?}"
: "${HOMELAB_APPLICATION_TUNNEL_USER:?}"
: "${HOMELAB_APPLICATION_TUNNEL_IDENTITY:?}"
[[ $HOMELAB_APPLICATION_TUNNEL_HOST =~ ^[A-Za-z0-9.-]+$ ]]
[[ $HOMELAB_APPLICATION_TUNNEL_USER =~ ^[a-z_][a-z0-9_-]*$ ]]
[[ $HOMELAB_APPLICATION_TUNNEL_IDENTITY == /* ]]
[[ -f $HOMELAB_APPLICATION_TUNNEL_IDENTITY && ! -L $HOMELAB_APPLICATION_TUNNEL_IDENTITY ]]
[[ $(stat -f '%u %Lp' "$HOMELAB_APPLICATION_TUNNEL_IDENTITY") == "$(id -u) 600" ]]
[[ $socket == "$PWD/.reconcile/"* && $socket != *'/../'* ]]

remote="$HOMELAB_APPLICATION_TUNNEL_USER@$HOMELAB_APPLICATION_TUNNEL_HOST"
ssh_base=(
  ssh -T -o BatchMode=yes -o ConnectTimeout=10
  -o ClearAllForwardings=yes
  -i "$HOMELAB_APPLICATION_TUNNEL_IDENTITY"
)

case "$operation" in
  start)
    [[ ! -e $socket ]]
    gluetun_ip=$("${ssh_base[@]}" "$remote" \
      "sudo -n docker inspect gluetun --format '{{range .NetworkSettings.Networks}}{{println .IPAddress}}{{end}}' | head -n 1")
    [[ $gluetun_ip =~ ^(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.)[0-9.]+$ ]]
    python3 - "$gluetun_ip" <<'PY'
import ipaddress
import sys
value = ipaddress.ip_address(sys.argv[1])
if value.version != 4 or not value.is_private:
    raise SystemExit("application tunnel target must be private IPv4")
PY
    ssh -f -N -M -S "$socket" \
      -o BatchMode=yes -o ConnectTimeout=10 -o ExitOnForwardFailure=yes \
      -o ControlMaster=yes -o ControlPersist=no \
      -i "$HOMELAB_APPLICATION_TUNNEL_IDENTITY" \
      -L "127.0.0.1:18989:${gluetun_ip}:8989" \
      -L "127.0.0.1:17878:${gluetun_ip}:7878" \
      -L "127.0.0.1:17879:${gluetun_ip}:7879" \
      -L "127.0.0.1:19696:${gluetun_ip}:9696" \
      "$remote"
    ssh -S "$socket" -O check "$remote" >/dev/null 2>&1
    echo "application_api_tunnels=started"
    ;;
  stop)
    if [[ -S $socket ]]; then
      ssh -S "$socket" -O exit "$remote" >/dev/null 2>&1 || true
    fi
    rm -f "$socket"
    echo "application_api_tunnels=stopped"
    ;;
  *) usage ;;
esac
