#!/usr/bin/env bash
set -euo pipefail
umask 077

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
fork_url=https://github.com/soodoh/terraform-provider-omada.git
fork_commit=11ba9d9bddbc017239cc79e006315e7be9267925
fork_version=0.10.4-fork.4
work_dir=$repo_root/.local/omada-provider-fork
source_dir=${OMADA_PROVIDER_FORK_SOURCE:-$work_dir/source}
bin_dir=$work_dir/bin
config_file=$work_dir/tofurc

for command in git go; do
  command -v "$command" >/dev/null || {
    echo "required Omada provider fork command is unavailable: $command" >&2
    exit 69
  }
done

install -d -m 0700 "$work_dir" "$bin_dir"

if [[ -n ${OMADA_PROVIDER_FORK_SOURCE:-} ]]; then
  [[ -d $source_dir/.git && ! -L $source_dir ]]
  [[ $(git -C "$source_dir" rev-parse HEAD) == "$fork_commit" ]]
  git -C "$source_dir" diff --quiet
  git -C "$source_dir" diff --cached --quiet
else
  if [[ ! -d $source_dir/.git ]]; then
    rm -rf "$source_dir"
    git clone --filter=blob:none --no-checkout "$fork_url" "$source_dir" >/dev/null 2>&1
  fi
  [[ $(git -C "$source_dir" remote get-url origin) == "$fork_url" ]]
  git -C "$source_dir" fetch --depth=1 origin "$fork_commit" >/dev/null 2>&1
  git -C "$source_dir" checkout --detach --force "$fork_commit" >/dev/null 2>&1
  git -C "$source_dir" clean -dffx >/dev/null
fi

[[ $(git -C "$source_dir" rev-parse HEAD) == "$fork_commit" ]]
source_status=$(git -C "$source_dir" status --porcelain=v1 --untracked-files=all --ignored=matching)
[[ -z $source_status ]] || {
  echo "Omada provider fork source must be an exact clean checkout" >&2
  exit 65
}

tmp_binary=$bin_dir/terraform-provider-omada.tmp
(
  cd "$source_dir"
  go build -trimpath -ldflags "-s -w -X main.version=$fork_version" -o "$tmp_binary"
)
chmod 0755 "$tmp_binary"
mv -f "$tmp_binary" "$bin_dir/terraform-provider-omada"

cat >"$config_file" <<EOF
provider_installation {
  # Temporary fork override for omada_client_alias. Keep the upstream source
  # address so existing state identities remain stable during the fork period.
  dev_overrides {
    "registry.terraform.io/wncservices/omada" = "$bin_dir"
  }
  direct {}
}
EOF
chmod 0600 "$config_file"
printf '%s\n' "$config_file"
