#!/usr/bin/env python3
"""Create the canonical Proton Restic repository from the healthy games source."""
from __future__ import annotations

from datetime import datetime, timezone
from importlib.machinery import SourceFileLoader
import json
import os
from pathlib import Path
import re

BASE_PATH = (
    Path(os.environ["HOME_LAB_CANONICAL_PROTON_BASE"])
    if os.environ.get("HOME_LAB_CANONICAL_PROTON_TESTING") == "1"
    else Path("/usr/local/libexec/home-lab/cleanup-damaged-proton-restic-v1")
)
B = SourceFileLoader("proton_cleanup_base", str(BASE_PATH)).load_module()
ROOT = Path("/var/lib/restic-proton")
JOURNAL_ROOT = ROOT / "canonical-proton-creation"
TARGET_REPOSITORY = "rclone:proton-backup:Backups/home-lab-restic"
TARGET_DIRECTORY = "home-lab-restic/"
DAMAGED_REPOSITORY = "rclone:proton-backup:Backups/home-lab-restic-v2"
DAMAGED_DIRECTORY = "home-lab-restic-v2/"
DAMAGED_ID = "98d792c009c01e06b8b39aab5112f0392050e9c533d1882e9c0d87727884ea25"
BROKEN_PACK = "a1f72495c2ca8a84c76fb7843e2ebcd35f6b8d675bb8121a736c4c3622f1e669"
SOURCE_ID = "b15627185df9b10a95b5dffe7d194dbccdba6ba4eb8a038ee03e750fedbde08f"
SOURCE_SNAPSHOT = "edd4f507cec382e6fae48e2690ffa53ae7ef7a61e24581983975631cbe5a32e2"
TRASH_PLAN = "53898e93b53264768b090d4b00e7e3add22e822efa5c7fa1bb6fc0b97e0f8a90"
TRASH_STATE = ROOT / "proton-trash-cleanup" / TRASH_PLAN / "state.json"
PLAN_FORMAT = "home-lab-canonical-proton-creation-plan-v1"
AUTH_FORMAT = "home-lab-canonical-proton-creation-authorization-v1"
RECEIPT_FORMAT = "home-lab-canonical-proton-creation-receipt-v1"
HEX = re.compile(r"^[0-9a-f]{64}$")


def fail(reason: str) -> None:
    raise SystemExit(f"canonical_proton_creation=failed reason={reason}")


def module_and_policy():
    module, policy, policy_sha256 = B.module_and_policy()
    proton = policy["repositories"]["proton"]
    games = policy["repositories"]["games"]
    if proton.get("path") != DAMAGED_REPOSITORY or proton.get("id") != DAMAGED_ID or games.get("id") != SOURCE_ID:
        fail("policy-boundary")
    return module, policy, policy_sha256


def command(module, argv: list[str], environment: dict[str, str], label: str, timeout: int = 600):
    result = module.run(argv, environment=environment, timeout=timeout)
    if result.returncode:
        fail(f"{label}-{result.returncode}-{B.sha(result.stderr.encode())}")
    return result.stdout


def summary(stdout: str) -> dict:
    try:
        values = [json.loads(line) for line in stdout.splitlines() if line]
    except json.JSONDecodeError as error:
        raise SystemExit("canonical_proton_creation=failed reason=check-json") from error
    matches = [item for item in values if item.get("message_type") == "summary"]
    if len(matches) != 1:
        fail("check-summary-count")
    return matches[0]


def exact_parent_listing(module, policy: dict, environment: dict[str, str], rclone: str) -> tuple[list[str], str]:
    config = module.rooted("/var/lib/restic-proton/rclone.conf")
    stdout = command(module, [rclone, "lsf", "--dirs-only", "--config", str(config), "proton-backup:Backups"], environment, "parent-listing")
    entries = [line for line in stdout.splitlines() if line]
    if any("/" in entry.rstrip("/") or entry in {".", ".."} for entry in entries):
        fail("parent-listing-shape")
    return entries, B.sha(stdout.encode())


def source_proof(module, policy: dict, environment: dict[str, str], restic: str) -> dict:
    repository = module.repository(policy, "games")
    config = json.loads(command(module, [restic, "-r", repository, "cat", "config"], environment, "source-config"))
    snapshots = json.loads(command(module, [restic, "-r", repository, "snapshots", "--json", SOURCE_SNAPSHOT], environment, "source-snapshot"))
    required = {"cadence=daily", f"policy={policy['first_run']['source_policy_sha256']}", f"artifact={policy['first_run']['artifact_sha256']}"}
    if config.get("id") != SOURCE_ID or not isinstance(config.get("chunker_polynomial"), str):
        fail("source-identity")
    if len(snapshots) != 1 or snapshots[0].get("id") != SOURCE_SNAPSHOT or snapshots[0].get("original") not in {None, ""} or not required <= set(snapshots[0].get("tags") or []):
        fail("source-lineage")
    checked = command(module, [restic, "-r", repository, "check", "--json", "--read-data"], environment, "source-full-check", 14400)
    B.validate_check_summary(checked)
    return {"repository_id": SOURCE_ID, "snapshot_id": SOURCE_SNAPSHOT, "chunker_polynomial": config["chunker_polynomial"], "full_read_data_check": "zero-errors"}


def damaged_proof(module, environment: dict[str, str], restic: str) -> dict:
    config = json.loads(command(module, [restic, "-r", DAMAGED_REPOSITORY, "cat", "config"], environment, "damaged-config"))
    result = module.run([restic, "-r", DAMAGED_REPOSITORY, "check", "--json"], environment=environment, timeout=3600)
    observed = summary(result.stdout)
    expected = {"message_type": "summary", "num_errors": 1, "broken_packs": [BROKEN_PACK], "suggest_repair_index": False, "suggest_prune": False}
    if config.get("id") != DAMAGED_ID or result.returncode != 1 or observed != expected:
        fail("damaged-proof")
    return {"repository": DAMAGED_REPOSITORY, "repository_id": DAMAGED_ID, "broken_pack": BROKEN_PACK, "check_summary": observed}


def trash_state_proof() -> dict:
    state, raw = B.load_private(TRASH_STATE)
    if state.get("format") != "home-lab-proton-trash-cleanup-receipt-v1" or state.get("status") != "cleanup-started" or state.get("plan_sha256") != TRASH_PLAN:
        fail("trash-state")
    return {"plan_sha256": TRASH_PLAN, "state_sha256": B.sha(raw), "status": "cleanup-started"}


def timers_stopped(module) -> list[str]:
    units = ["home-lab-restic-daily.timer", "home-lab-restic-maintenance.timer"]
    for unit in units:
        result = module.run(["/usr/bin/systemctl", "is-active", unit], environment={}, timeout=30)
        if result.stdout.strip() != "inactive":
            fail(f"timer-active-{unit}")
    return units


def observe_locked(module, policy: dict, policy_sha256: str) -> dict:
    restic, rclone = module.command_paths(policy)
    B.reject_processes(restic, rclone)
    destination_environment = module.credential_environment(policy, "proton", "games")
    source_environment = module.credential_environment(policy, "games")
    directories, listing_sha = exact_parent_listing(module, policy, destination_environment, rclone)
    target = module.run([restic, "-r", TARGET_REPOSITORY, "cat", "config"], environment=destination_environment, timeout=300)
    if target.returncode == 0:
        target_state = {"present": True, "repository_id": json.loads(target.stdout).get("id")}
    else:
        target_state = {"present": False}
    return {
        "format": "home-lab-canonical-proton-creation-observation-v1",
        "helper_sha256": B.sha(Path(__file__).read_bytes()),
        "base_helper_sha256": B.sha(BASE_PATH.read_bytes()),
        "runner_sha256": B.sha(B.RUNNER.read_bytes()),
        "policy_sha256": policy_sha256,
        "active_directories": directories,
        "active_directories_sha256": listing_sha,
        "target": target_state,
        "source": source_proof(module, policy, source_environment, restic),
        "damaged": damaged_proof(module, destination_environment, restic),
        "trash_transaction": trash_state_proof(),
        "stopped_timers": timers_stopped(module),
    }


def observe() -> None:
    B.require_identity()
    module, policy, policy_sha256 = module_and_policy()
    descriptor = B.acquire_lock(module, policy)
    try:
        print(B.canonical(observe_locked(module, policy, policy_sha256)).decode(), end="")
    finally:
        os.close(descriptor)


def validate_plan(path: Path) -> tuple[dict, str, datetime]:
    plan, raw = B.load_private(path)
    digest = B.sha(raw)
    try:
        created = datetime.fromisoformat(plan["created_at"].replace("Z", "+00:00"))
        expires = datetime.fromisoformat(plan["expires_at"].replace("Z", "+00:00"))
    except (KeyError, TypeError, ValueError) as error:
        raise SystemExit("canonical_proton_creation=failed reason=plan-time") from error
    action = {"kind": "create-canonical-proton-repository", "target": TARGET_REPOSITORY, "source_repository_id": SOURCE_ID, "source_snapshot_id": SOURCE_SNAPSHOT, "preserve_damaged_repository": DAMAGED_REPOSITORY}
    if set(plan) != {"format", "commit", "contract_sha256", "created_at", "expires_at", "host_observation", "action", "blockers", "authorized"} or plan.get("format") != PLAN_FORMAT or path.name != f"canonical-proton-creation-{digest}.json" or plan.get("action") != action or plan.get("blockers") != ["remote-repository-creation-authorization-required"] or plan.get("authorized") is not False or expires <= created or (expires-created).total_seconds() > 86400:
        fail("plan-binding")
    return plan, digest, expires


def validate_authorization(path: Path, digest: str, plan: dict) -> tuple[str, datetime, datetime]:
    value, raw = B.load_private(path)
    auth_digest = B.sha(raw)
    try:
        created = datetime.fromisoformat(value["created_at"].replace("Z", "+00:00"))
        expires = datetime.fromisoformat(value["expires_at"].replace("Z", "+00:00"))
    except (KeyError, TypeError, ValueError) as error:
        raise SystemExit("canonical_proton_creation=failed reason=authorization-time") from error
    expected = {"format": AUTH_FORMAT, "plan_sha256": digest, "created_at": value.get("created_at"), "expires_at": value.get("expires_at"), "confirmation": f"authorize-create-canonical-proton-repository-{digest}", "authorized": True}
    if value != expected or expires <= created or (expires-created).total_seconds() > 900 or expires > datetime.fromisoformat(plan["expires_at"].replace("Z", "+00:00")):
        fail("authorization-binding")
    return auth_digest, created, expires


def target_proof(module, environment: dict[str, str], restic: str, expected_id: str | None = None, *, require_snapshot: bool = True) -> tuple[dict, str]:
    config = json.loads(command(module, [restic, "-r", TARGET_REPOSITORY, "cat", "config"], environment, "target-config"))
    repository_id = config.get("id")
    if HEX.fullmatch(str(repository_id or "")) is None or repository_id in {DAMAGED_ID, SOURCE_ID} or (expected_id and repository_id != expected_id):
        fail("target-proof")
    proof = {"repository_id": repository_id, "chunker_polynomial": config.get("chunker_polynomial")}
    if require_snapshot:
        snapshots = json.loads(command(module, [restic, "-r", TARGET_REPOSITORY, "snapshots", "--json"], environment, "target-snapshots"))
        matches = [item for item in snapshots if item.get("original") == SOURCE_SNAPSHOT]
        if len(matches) != 1 or HEX.fullmatch(str(matches[0].get("id", ""))) is None:
            fail("target-proof")
        proof |= {"snapshot_id": matches[0]["id"], "original_snapshot_id": SOURCE_SNAPSHOT}
    return proof, config.get("chunker_polynomial")


def validate_receipt(receipt: dict, state: dict, digest: str, auth_digest: str) -> None:
    expected = {"format", "status", "plan_sha256", "authorization_sha256", "authorization_history", "started_at", "initialized_at", "copied_at", "committed_at", "target", "source", "damaged_repository_preserved", "structural_check", "full_read_data_check"}
    history = receipt.get("authorization_history")
    target = receipt.get("target", {})
    if set(receipt) != expected or receipt.get("format") != RECEIPT_FORMAT or receipt.get("status") != "committed" or receipt.get("plan_sha256") != digest or receipt.get("authorization_sha256") != auth_digest or not isinstance(history, list) or not history or history[-1] != auth_digest or set(target) != {"repository_id", "snapshot_id", "original_snapshot_id", "chunker_polynomial"} or HEX.fullmatch(str(target.get("repository_id", ""))) is None or target.get("repository_id") in {SOURCE_ID, DAMAGED_ID} or HEX.fullmatch(str(target.get("snapshot_id", ""))) is None or target.get("original_snapshot_id") != SOURCE_SNAPSHOT or not isinstance(target.get("chunker_polynomial"), str) or receipt.get("source") != {"repository_id": SOURCE_ID, "snapshot_id": SOURCE_SNAPSHOT} or receipt.get("damaged_repository_preserved") != {"repository": DAMAGED_REPOSITORY, "repository_id": DAMAGED_ID, "broken_pack": BROKEN_PACK} or receipt.get("structural_check") != "zero-errors" or receipt.get("full_read_data_check") != "zero-errors":
        fail("receipt-binding")
    try:
        timestamps = [datetime.fromisoformat(receipt[key].replace("Z", "+00:00")) for key in ("started_at", "initialized_at", "copied_at", "committed_at")]
    except (AttributeError, ValueError) as error:
        raise SystemExit("canonical_proton_creation=failed reason=receipt-time") from error
    if timestamps != sorted(timestamps) or (state.get("status") == "committed" and state != receipt):
        fail("receipt-state")


def apply(plan_path: Path, authorization_path: Path) -> None:
    B.require_identity()
    plan, digest, plan_expires = validate_plan(plan_path)
    auth_digest, auth_created, auth_expires = validate_authorization(authorization_path, digest, plan)
    if os.environ.get("CANONICAL_PROTON_CREATION_CONFIRMED") != f"create-canonical-proton-repository-{digest}-{auth_digest}":
        fail("exact-confirmation")
    module, policy, policy_sha256 = module_and_policy()
    descriptor = B.acquire_lock(module, policy)
    try:
        B.require_private_directory(JOURNAL_ROOT)
        journal = JOURNAL_ROOT / digest
        if not os.path.lexists(journal):
            journal.mkdir(mode=0o700)
            B.fsync_directory(JOURNAL_ROOT)
        B.require_private_directory(journal)
        state = B.current_state(journal)
        receipt_path = journal / "receipt.json"
        if os.path.lexists(receipt_path):
            if state is None:
                fail("receipt-without-state")
            receipt, raw = B.load_private(receipt_path)
            validate_receipt(receipt, state, digest, auth_digest)
            restic, rclone = module.command_paths(policy)
            B.reject_processes(restic, rclone)
            environment = module.credential_environment(policy, "proton", "games")
            target, _ = target_proof(module, environment, restic, receipt["target"]["repository_id"])
            if target != receipt["target"]:
                fail("receipt-postcondition-target")
            structural = command(module, [restic, "-r", TARGET_REPOSITORY, "check", "--json"], environment, "receipt-structural-check", 3600)
            B.validate_check_summary(structural)
            full = command(module, [restic, "-r", TARGET_REPOSITORY, "check", "--json", "--read-data"], environment, "receipt-full-check", 14400)
            B.validate_check_summary(full)
            directories, _ = exact_parent_listing(module, policy, environment, rclone)
            if directories != [DAMAGED_DIRECTORY, TARGET_DIRECTORY]:
                fail("receipt-postcondition-directories")
            damaged = damaged_proof(module, environment, restic)
            if damaged["repository_id"] != DAMAGED_ID or damaged["broken_pack"] != BROKEN_PACK:
                fail("receipt-postcondition-damaged")
            if state != receipt:
                B.write_private(journal / "state.json", receipt)
            print(B.canonical({"status": "committed", "plan_sha256": digest, "receipt_sha256": B.sha(raw)}).decode(), end="")
            return
        now = datetime.now(timezone.utc)
        if auth_created > now or now > auth_expires or now > plan_expires:
            fail("fresh-authorization-required")
        restic, rclone = module.command_paths(policy)
        B.reject_processes(restic, rclone)
        environment = module.credential_environment(policy, "proton", "games")
        environment["RESTIC_FROM_REPOSITORY"] = module.repository(policy, "games")
        current = observe_locked(module, policy, policy_sha256)
        for key in ("helper_sha256", "base_helper_sha256", "runner_sha256", "policy_sha256", "source", "damaged", "trash_transaction", "stopped_timers"):
            if current.get(key) != plan["host_observation"].get(key):
                fail(f"current-precondition-{key}")
        if state is None:
            if current != plan["host_observation"] or current["target"] != {"present": False} or current["active_directories"] != [DAMAGED_DIRECTORY]:
                fail("precondition-observation")
            state = {"format": RECEIPT_FORMAT, "status": "creation-started", "plan_sha256": digest, "authorization_sha256": auth_digest, "authorization_history": [auth_digest], "started_at": now.replace(microsecond=0).isoformat().replace("+00:00", "Z")}
            B.write_private(journal / "state.json", state, exclusive=True)
        elif state.get("format") != RECEIPT_FORMAT or state.get("plan_sha256") != digest or state.get("status") not in {"creation-started", "initialized", "copied"} or not isinstance(state.get("authorization_history"), list) or not state["authorization_history"] or state["authorization_history"][-1] != state.get("authorization_sha256"):
            fail("resume-state")
        if state["authorization_sha256"] != auth_digest:
            state = {**state, "authorization_sha256": auth_digest, "authorization_history": [*state["authorization_history"], auth_digest]}
            B.write_private(journal / "state.json", state)
        source = current["source"]
        if current["active_directories"] not in ([DAMAGED_DIRECTORY], [DAMAGED_DIRECTORY, TARGET_DIRECTORY]) or source["repository_id"] != SOURCE_ID or source["snapshot_id"] != SOURCE_SNAPSHOT:
            fail("current-precondition")
        if state["status"] == "creation-started":
            if current["target"] == {"present": False}:
                command(module, [restic, "-r", TARGET_REPOSITORY, "init", "--from-repo", module.repository(policy, "games"), "--copy-chunker-params"], environment, "target-init", 1800)
            target, chunker = target_proof(module, environment, restic, require_snapshot=False)
            if chunker != source["chunker_polynomial"]:
                fail("target-chunker")
            state = {**state, "status": "initialized", "initialized_at": datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z"), "target_repository_id": target["repository_id"]}
            B.write_private(journal / "state.json", state)
        target, chunker = target_proof(module, environment, restic, state["target_repository_id"]) if state["status"] != "initialized" else ({}, source["chunker_polynomial"])
        if state["status"] == "initialized":
            command(module, [restic, "-r", TARGET_REPOSITORY, "copy", "--from-repo", module.repository(policy, "games"), SOURCE_SNAPSHOT], environment, "target-copy", 10800)
            target, chunker = target_proof(module, environment, restic, state["target_repository_id"])
            if chunker != source["chunker_polynomial"]:
                fail("target-chunker")
            state = {**state, "status": "copied", "copied_at": datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z"), "target_snapshot_id": target["snapshot_id"]}
            B.write_private(journal / "state.json", state)
        target, _ = target_proof(module, environment, restic, state["target_repository_id"])
        if target["snapshot_id"] != state["target_snapshot_id"]:
            fail("target-snapshot-drift")
        structural = command(module, [restic, "-r", TARGET_REPOSITORY, "check", "--json"], environment, "target-structural-check", 3600)
        B.validate_check_summary(structural)
        full = command(module, [restic, "-r", TARGET_REPOSITORY, "check", "--json", "--read-data"], environment, "target-full-check", 14400)
        B.validate_check_summary(full)
        directories, _ = exact_parent_listing(module, policy, environment, rclone)
        if directories != [DAMAGED_DIRECTORY, TARGET_DIRECTORY]:
            fail("postcondition-directories")
        damaged = damaged_proof(module, environment, restic)
        receipt = {
            "format": RECEIPT_FORMAT, "status": "committed", "plan_sha256": digest, "authorization_sha256": auth_digest, "authorization_history": state["authorization_history"],
            "started_at": state["started_at"], "initialized_at": state["initialized_at"], "copied_at": state["copied_at"],
            "committed_at": datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z"),
            "target": target, "source": {"repository_id": SOURCE_ID, "snapshot_id": SOURCE_SNAPSHOT},
            "damaged_repository_preserved": {"repository": DAMAGED_REPOSITORY, "repository_id": damaged["repository_id"], "broken_pack": damaged["broken_pack"]},
            "structural_check": "zero-errors", "full_read_data_check": "zero-errors",
        }
        raw = B.write_private(receipt_path, receipt, exclusive=True)
        B.write_private(journal / "state.json", receipt)
        print(B.canonical({"status": "committed", "plan_sha256": digest, "receipt_sha256": B.sha(raw)}).decode(), end="")
    finally:
        os.close(descriptor)


def main() -> None:
    parser = __import__("argparse").ArgumentParser()
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("observe")
    apply_parser = commands.add_parser("apply")
    apply_parser.add_argument("plan", type=Path)
    apply_parser.add_argument("authorization", type=Path)
    args = parser.parse_args()
    if args.command == "observe":
        observe()
    else:
        apply(args.plan.resolve(), args.authorization.resolve())


if __name__ == "__main__":
    main()
