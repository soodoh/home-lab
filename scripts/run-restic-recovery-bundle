#!/usr/bin/env python3
import argparse
import hashlib
import io
import json
import os
from pathlib import Path
import re
import shutil
import signal
import stat
import subprocess
import tarfile
import tempfile

HEX = re.compile(r"^[0-9a-f]{64}$")
EXPECTED_MODES = {
    "MANIFEST.json": 0o600,
    "README": 0o600,
    "bin/rclone": 0o755,
    "bin/restic": 0o755,
    "bin/restore-critical-backup": 0o755,
    "metadata.json": 0o600,
    "private/proton-login-password": 0o600,
    "private/proton-username": 0o600,
    "private/restic-password": 0o600,
}
ALLOWED = set(EXPECTED_MODES)


def digest(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def canonical(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def fail(message: str) -> None:
    raise ValueError(message)


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--expected-plaintext-sha256", required=True)
    parser.add_argument("--expected-snapshot-id", required=True)
    parser.add_argument("--expected-original-snapshot-id", required=True)
    parser.add_argument("--expected-repository-id", required=True)
    parser.add_argument("--expected-policy-sha256", required=True)
    parser.add_argument("--expected-artifact-sha256", required=True)
    parser.add_argument("--target", required=True)
    arguments = parser.parse_args()
    for value in (
        arguments.expected_plaintext_sha256, arguments.expected_snapshot_id,
        arguments.expected_original_snapshot_id, arguments.expected_repository_id,
        arguments.expected_policy_sha256, arguments.expected_artifact_sha256,
    ):
        if not HEX.fullmatch(value):
            fail("recovery proof identity differs")
    if os.environ.get("RECOVERY_DISPOSABLE_VM_CONFIRMED") != "fresh-disposable-vm-without-host-tokens":
        fail("disposable recovery VM confirmation is required")
    forbidden = (
        Path("/etc/home-lab/restic"), Path("/var/lib/restic-proton"),
        Path("/var/lib/home-lab-restic"), Path("/srv/home-lab-state"),
    )
    if any(path.exists() or path.is_symlink() for path in forbidden):
        fail("host recovery state is visible inside the disposable VM")
    target = Path(arguments.target)
    if str(target) != "/srv/home-lab-recovery/restic-proton-proof":
        fail("recovery proof target differs")
    parent = target.parent
    parent_metadata = parent.lstat()
    target_metadata = target.lstat()
    if (not stat.S_ISDIR(parent_metadata.st_mode) or parent_metadata.st_uid != os.geteuid()
            or stat.S_IMODE(parent_metadata.st_mode) != 0o700 or parent.is_symlink()
            or not stat.S_ISDIR(target_metadata.st_mode) or target_metadata.st_uid != os.geteuid()
            or stat.S_IMODE(target_metadata.st_mode) != 0o700 or target.is_symlink()
            or any(target.iterdir())):
        fail("recovery proof target metadata differs")
    workspace_parent = Path("/var/tmp/restic-recovery")
    workspace_parent_metadata = workspace_parent.lstat()
    if (not stat.S_ISDIR(workspace_parent_metadata.st_mode)
            or workspace_parent_metadata.st_uid != os.geteuid()
            or stat.S_IMODE(workspace_parent_metadata.st_mode) != 0o700
            or workspace_parent.is_symlink()):
        fail("recovery workspace metadata differs")

    chunks = []
    size = 0
    while True:
        chunk = os.read(0, min(1024 * 1024, 512 * 1024 * 1024 + 1 - size))
        if not chunk:
            break
        chunks.append(chunk)
        size += len(chunk)
        if size > 512 * 1024 * 1024:
            break
    plaintext = b"".join(chunks)
    if size > 512 * 1024 * 1024 or digest(plaintext) != arguments.expected_plaintext_sha256:
        fail("recovery bundle plaintext identity differs")
    workspace = Path(tempfile.mkdtemp(prefix="bundle.", dir=workspace_parent))
    workspace.chmod(0o700)
    child = None
    prior_handlers = {}

    def interrupt(signum: int, _frame: object) -> None:
        if child is not None and child.poll() is None:
            os.killpg(child.pid, signal.SIGTERM)
            try:
                child.wait(timeout=10)
            except subprocess.TimeoutExpired:
                os.killpg(child.pid, signal.SIGKILL)
                child.wait()
        shutil.rmtree(workspace, ignore_errors=True)
        raise SystemExit(128 + signum)

    for signum in (signal.SIGINT, signal.SIGTERM):
        prior_handlers[signum] = signal.signal(signum, interrupt)
    try:
        with tarfile.open(fileobj=io.BytesIO(plaintext), mode="r:") as archive:
            members = archive.getmembers()
            if {member.name for member in members} != ALLOWED or len(members) != len(ALLOWED):
                fail("recovery bundle members differ")
            contents = {}
            modes = {}
            for member in members:
                if (not member.isfile() or member.uid != 0 or member.gid != 0
                        or member.uname != "root" or member.gname != "root"
                        or member.mtime != 0 or member.name.startswith("/")
                        or member.mode != EXPECTED_MODES.get(member.name)
                        or ".." in Path(member.name).parts):
                    fail("recovery bundle member metadata differs")
                stream = archive.extractfile(member)
                if stream is None:
                    fail("recovery bundle member is unreadable")
                contents[member.name] = stream.read()
                modes[member.name] = member.mode
        manifest = json.loads(contents["MANIFEST.json"])
        if set(manifest) != ALLOWED - {"MANIFEST.json"}:
            fail("recovery bundle manifest differs")
        for name, expected in manifest.items():
            if set(expected) != {"mode", "sha256", "size"}:
                fail("recovery bundle manifest fields differ")
            if (expected["sha256"] != digest(contents[name])
                    or expected["size"] != len(contents[name])
                    or expected["mode"] != format(modes[name], "04o")):
                fail("recovery bundle content differs")
        metadata = json.loads(contents["metadata.json"])
        if canonical(metadata) != contents["metadata.json"] or type(metadata.get("version")) is not int or metadata["version"] != 1:
            fail("recovery bundle metadata encoding differs")
        bindings = {
            "artifact_sha256": arguments.expected_artifact_sha256,
            "original_snapshot_id": arguments.expected_original_snapshot_id,
            "policy_sha256": arguments.expected_policy_sha256,
            "repository": "rclone:proton_backup:Backups/home-lab-restic",
            "repository_id": arguments.expected_repository_id,
            "snapshot_id": arguments.expected_snapshot_id,
        }
        if any(metadata.get(key) != value for key, value in bindings.items()):
            fail("recovery bundle bindings differ")
        for name in sorted(ALLOWED):
            destination = workspace / name
            destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            descriptor = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, modes[name])
            try:
                os.fchmod(descriptor, modes[name])
                with os.fdopen(descriptor, "wb", closefd=False) as stream:
                    if stream.write(contents[name]) != len(contents[name]):
                        raise OSError("short recovery bundle write")
                    stream.flush()
                    os.fsync(descriptor)
            finally:
                os.close(descriptor)
        environment = {
            "HOME": str(workspace),
            "LANG": "C.UTF-8",
            "LC_ALL": "C.UTF-8",
            "PATH": f"{workspace / 'bin'}:/usr/bin:/bin",
            "RECOVERY_TARGET": str(target),
            "RECOVERY_RESTIC_REPOSITORY": metadata["repository"],
            "RECOVERY_RESTIC_PASSWORD_FILE": str(workspace / "private/restic-password"),
            "RECOVERY_EXPECTED_RESTIC_REPOSITORY_ID": metadata["repository_id"],
            "RECOVERY_EXPECTED_POLICY_SHA256": metadata["policy_sha256"],
            "RECOVERY_EXPECTED_COMPOSE_ARTIFACT_SHA256": metadata["artifact_sha256"],
            "RECOVERY_EXPECTED_RESTIC_SHA256": metadata["restic_sha256"],
            "RECOVERY_EXPECTED_RCLONE_SHA256": metadata["rclone_sha256"],
            "RECOVERY_EXPECTED_ORIGINAL_SNAPSHOT_ID": metadata["original_snapshot_id"],
            "RCLONE_CONFIG_PROTON_BACKUP_TYPE": "protondrive",
            "RCLONE_CONFIG_PROTON_BACKUP_USERNAME": contents["private/proton-username"].decode().rstrip("\n"),
            "RCLONE_CONFIG_PROTON_BACKUP_PASSWORD": contents["private/proton-login-password"].decode().rstrip("\n"),
            "RCLONE_CONFIG_PROTON_BACKUP_REPLACE_EXISTING_DRAFT": "true",
            "RCLONE_CONFIG_PROTON_BACKUP_ENABLE_CACHING": "false",
        }
        blocked_signals = {signal.SIGINT, signal.SIGTERM}
        signal.pthread_sigmask(signal.SIG_BLOCK, blocked_signals)
        try:
            child = subprocess.Popen(
                [str(workspace / "bin/restore-critical-backup"), "--restic-snapshot-id", metadata["snapshot_id"], "--confirmed-empty-target"],
                env=environment,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                start_new_session=True,
            )
        finally:
            signal.pthread_sigmask(signal.SIG_UNBLOCK, blocked_signals)
        stdout, _ = child.communicate()
        if child.returncode != 0 or stdout != f"recovery_restore=verified backend=restic snapshot={metadata['snapshot_id']}\n":
            fail("isolated Restic restore failed")
        file_count = 0
        byte_count = 0
        for directory, names, files in os.walk(target, followlinks=False):
            for name in names + files:
                path = Path(directory, name)
                value = path.lstat()
                if stat.S_ISLNK(value.st_mode):
                    fail("restored proof target contains a symlink")
                if stat.S_ISREG(value.st_mode):
                    file_count += 1
                    byte_count += value.st_size
        evidence = {
            "bytes": byte_count,
            "files": file_count,
            "original_snapshot_id": metadata["original_snapshot_id"],
            "plaintext_sha256": arguments.expected_plaintext_sha256,
            "repository_id": metadata["repository_id"],
            "snapshot_id": metadata["snapshot_id"],
            "state": "restored-verified",
            "version": 1,
        }
        print(json.dumps(evidence, sort_keys=True, separators=(",", ":")))
    finally:
        for signum, handler in prior_handlers.items():
            signal.signal(signum, handler)
        shutil.rmtree(workspace, ignore_errors=True)


if __name__ == "__main__":
    main()
