#!/bin/bash
set -euo pipefail

readonly CONFIRMATION=prepare-reviewed-vm-100-debian-packages

[[ $# -eq 0 ]] || { echo "usage: scripts/run-debian-package-preparation" >&2; exit 1; }
[[ -t 0 ]] || { echo "Debian package preparation requires confirmation from an interactive physical console" >&2; exit 1; }
printf 'Type the exact confirmation to verify Debian packages and prepare the guarded physical-reboot return to Arch:\n%s\n' "$CONFIRMATION" >&2
IFS= read -r confirmation
[[ $confirmation == "$CONFIRMATION" ]] || { echo "exact Debian package-preparation confirmation is required" >&2; exit 1; }
export HOME_LAB_DEBIAN_QUALIFICATION_CONFIRMED=$CONFIRMATION
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
exec "$root/scripts/qualify-debian-inert"
