#!/usr/bin/env python3
"""Safely install a newly rotated Proxmox tofu-plan API token."""

from __future__ import annotations

import getpass
import json
import os
from pathlib import Path
import re
import stat
import tempfile

CONFIG_DIR = Path.home() / ".config/home-lab/controller"
FILES = ("plan-credentials.json", "apply-credentials.json")
FIELDS = ("PROXMOX_PLAN_API_TOKEN", "PROXMOX_VE_API_TOKEN")
TOKEN_PATTERN = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")


def fail(reason: str) -> None:
    raise SystemExit(f"proxmox_plan_token_rotation=failed reason={reason}")


def main() -> None:
    if (
        not CONFIG_DIR.is_dir()
        or CONFIG_DIR.is_symlink()
        or CONFIG_DIR.stat().st_uid != os.getuid()
        or stat.S_IMODE(CONFIG_DIR.stat().st_mode) != 0o700
    ):
        fail("controller_config_directory_unsafe")

    paths = [CONFIG_DIR / name for name in FILES]
    documents: list[dict[str, object]] = []
    for path in paths:
        if (
            not path.is_file()
            or path.is_symlink()
            or path.stat().st_uid != os.getuid()
            or stat.S_IMODE(path.stat().st_mode) != 0o600
        ):
            fail(f"credential_file_unsafe:{path.name}")
        document = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(document, dict) or any(field not in document for field in FIELDS):
            fail(f"credential_fields_missing:{path.name}")
        documents.append(document)

    secret = getpass.getpass("New tofu-plan UUID value (input hidden): ")
    if TOKEN_PATTERN.fullmatch(secret) is None:
        fail("token_format_invalid")
    token = f"root@pam!tofu-plan={secret}"

    for path, document in zip(paths, documents, strict=True):
        for field in FIELDS:
            document[field] = token
        descriptor, temporary_name = tempfile.mkstemp(dir=CONFIG_DIR, prefix=f".{path.name}.")
        temporary = Path(temporary_name)
        try:
            with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
                json.dump(document, stream, sort_keys=True)
                stream.write("\n")
                stream.flush()
                os.fsync(stream.fileno())
            os.chmod(temporary, 0o600)
            os.replace(temporary, path)
        finally:
            temporary.unlink(missing_ok=True)

    token = ""
    secret = ""
    print("proxmox_plan_token_rotation=updated files=2")


if __name__ == "__main__":
    main()
