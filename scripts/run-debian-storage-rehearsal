#!/bin/bash
set -euo pipefail

readonly CONFIRMATION=rehearse-reviewed-vm-100-debian-storage-readonly

[[ $# -eq 0 ]] || { echo "usage: scripts/run-debian-storage-rehearsal" >&2; exit 1; }
[[ -t 0 ]] || { echo "Debian storage rehearsal requires confirmation from an interactive physical console" >&2; exit 1; }
printf 'Type the exact confirmation to mount state, games, and NFS only read-only for rehearsal:\n%s\n' "$CONFIRMATION" >&2
IFS= read -r confirmation
[[ $confirmation == "$CONFIRMATION" ]] || { echo "exact Debian storage-rehearsal confirmation is required" >&2; exit 1; }
export HOME_LAB_DEBIAN_QUALIFICATION_CONFIRMED=$CONFIRMATION
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
exec "$root/scripts/qualify-debian-inert"
