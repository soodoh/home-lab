#!/usr/bin/env python3
"""Run one transaction-bound Proton quota observation without remote mutation."""

from configparser import ConfigParser, Error as ConfigError
from datetime import datetime, timezone
import grp
import hashlib
import json
import os
from pathlib import Path
import pwd
import re
import signal
import stat
import subprocess
import sys
import time

RCLONE = Path("/usr/local/bin/rclone")
RUNUSER = Path("/usr/sbin/runuser")
CONFIG = Path("/var/lib/restic-proton/rclone.conf")
CACHE = Path("/var/lib/restic-proton/cache")
MUTEX = Path("/run/lock/home-lab-backup.lock")
APPLY_LOCK = Path("/var/lib/iac-ansible-production.lock")
EVIDENCE_PARENT = Path("/var/lib/home-lab-restic")
STATIC_KEYS = {"type", "username", "password", "replace_existing_draft", "enable_caching", "original_file_size"}
CACHE_KEYS = {"client_uid", "client_access_token", "client_refresh_token", "client_salted_key_pass"}


class QuotaError(RuntimeError):
    """A controlled quota diagnostic failure."""


def fail(reason: str) -> None:
    if re.fullmatch(r"[a-z0-9_.-]+", reason) is None:
        reason = "invalid_failure_reason"
    raise QuotaError(reason)


def digest(content: bytes) -> str:
    return hashlib.sha256(content).hexdigest()


def digest_file(path: Path) -> str:
    return digest(path.read_bytes())


def require_regular(path: Path, uid: int, gid: int, mode: int) -> bytes:
    try:
        metadata = path.lstat()
        content = path.read_bytes()
    except OSError:
        fail(f"{path.name}_absent")
    if path.is_symlink() or not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
        fail(f"{path.name}_type")
    if metadata.st_uid != uid or metadata.st_gid != gid or stat.S_IMODE(metadata.st_mode) != mode:
        fail(f"{path.name}_metadata")
    return content


def require_directory(path: Path, uid: int, gid: int, mode: int) -> None:
    try:
        metadata = path.lstat()
    except OSError:
        fail(f"{path.name}_absent")
    if path.is_symlink() or not stat.S_ISDIR(metadata.st_mode):
        fail(f"{path.name}_type")
    if metadata.st_uid != uid or metadata.st_gid != gid or stat.S_IMODE(metadata.st_mode) != mode:
        fail(f"{path.name}_metadata")


def write_all(descriptor: int, content: bytes) -> None:
    remaining = memoryview(content)
    while remaining:
        written = os.write(descriptor, remaining)
        if written <= 0:
            fail("evidence_write")
        remaining = remaining[written:]


def atomic_json(path: Path, value: dict[str, object], replace: bool) -> str:
    content = (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
    if not replace:
        try:
            descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        except FileExistsError:
            fail("prior_quota_diagnostic")
        completed = False
        try:
            os.fchown(descriptor, 0, 0)
            os.fchmod(descriptor, 0o600)
            write_all(descriptor, content)
            os.fsync(descriptor)
            completed = True
        finally:
            os.close(descriptor)
            if not completed:
                try:
                    path.unlink()
                except FileNotFoundError:
                    pass
    else:
        temporary = path.with_name(f".{path.name}.final")
        try:
            try:
                descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            except FileExistsError:
                fail("quota_finalizer_present")
            try:
                os.fchown(descriptor, 0, 0)
                os.fchmod(descriptor, 0o600)
                write_all(descriptor, content)
                os.fsync(descriptor)
            finally:
                os.close(descriptor)
            os.replace(temporary, path)
        finally:
            try:
                temporary.unlink()
            except FileNotFoundError:
                pass
    directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
    require_regular(path, 0, 0, 0o600)
    return digest(content)


def terminate_group(process: subprocess.Popen[bytes]) -> None:
    try:
        group = os.getpgid(process.pid)
    except ProcessLookupError:
        group = process.pid
    try:
        os.killpg(group, signal.SIGTERM)
    except ProcessLookupError:
        process.poll()
        return
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        process.poll()
        try:
            os.killpg(group, 0)
        except ProcessLookupError:
            return
        except PermissionError:
            if process.poll() is not None:
                return
        time.sleep(0.05)
    try:
        os.killpg(group, signal.SIGKILL)
    except ProcessLookupError:
        process.poll()
        return
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        process.poll()
        try:
            os.killpg(group, 0)
        except ProcessLookupError:
            return
        except PermissionError:
            if process.poll() is not None:
                return
        time.sleep(0.05)
    fail("rclone_process_group_survived")


def bounded(
    command: list[str],
    environment: dict[str, str],
    timeout: float = 600,
) -> subprocess.CompletedProcess[bytes]:
    def interrupted(_signum: int, _frame: object) -> None:
        raise InterruptedError

    previous_handlers = {
        signum: signal.signal(signum, interrupted)
        for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM)
    }
    process: subprocess.Popen[bytes] | None = None
    try:
        process = subprocess.Popen(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=environment,
            start_new_session=True,
        )
        try:
            stdout, stderr = process.communicate(timeout=timeout)
        except BaseException:
            try:
                terminate_group(process)
            finally:
                try:
                    process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    pass
            raise
    finally:
        for signum, handler in previous_handlers.items():
            signal.signal(signum, handler)
    if process is None:
        fail("rclone_exec")
    return subprocess.CompletedProcess(command, process.returncode, stdout, stderr)


def require_no_processes() -> None:
    for process in ("restic", "rclone"):
        result = subprocess.run(
            ["/usr/bin/pgrep", "--exact", process],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            env={"LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "PATH": "/usr/bin:/bin"},
        )
        if result.returncode not in {0, 1}:
            fail("process_inspection")
        if result.returncode == 0:
            fail("backup_process_present")


def validate_post_state(
    config_raw: bytes,
    transaction: str,
    expected_rclone: str,
    service_uid: int,
    service_gid: int,
) -> None:
    drift = False
    checks = (
        lambda: require_no_processes(),
        lambda: require_directory(CONFIG.parent, service_uid, service_gid, 0o700),
        lambda: require_regular(CONFIG, service_uid, service_gid, 0o600),
        lambda: require_directory(CACHE, service_uid, service_gid, 0o700),
        lambda: require_regular(RCLONE, 0, 0, 0o755),
        lambda: require_directory(APPLY_LOCK, 0, 0, 0o700),
        lambda: require_regular(APPLY_LOCK / "owner", 0, 0, 0o600),
    )
    results: list[object] = []
    for check in checks:
        try:
            results.append(check())
        except (OSError, QuotaError):
            drift = True
            results.append(None)
    config_after, owner_after = results[2], results[6]
    try:
        if (
            config_after != config_raw
            or any(CACHE.iterdir())
            or digest_file(RCLONE) != expected_rclone
            or not isinstance(owner_after, bytes)
            or digest(owner_after) != transaction
        ):
            drift = True
    except OSError:
        drift = True
    if drift:
        fail("artifact_drift")


def main() -> None:
    try:
        if len(sys.argv) != 5 or os.getuid() != 0 or os.getgid() != 0:
            fail("usage")
        transaction, expected_script, expected_config, expected_rclone = sys.argv[1:]
        if any(re.fullmatch(r"[0-9a-f]{64}", value) is None for value in sys.argv[1:]):
            fail("usage")
        if digest_file(Path(__file__)) != expected_script:
            fail("script_hash")
        service = pwd.getpwnam("restic-proton")
        service_group = grp.getgrnam("restic-proton")
        if service.pw_uid != 60000 or service.pw_gid != 60000 or service_group.gr_gid != 60000:
            fail("service_identity")
        require_regular(RCLONE, 0, 0, 0o755)
        if digest_file(RCLONE) != expected_rclone:
            fail("rclone_hash")
        require_regular(RUNUSER, 0, 0, 0o755)
        require_regular(MUTEX, 0, service_group.gr_gid, 0o660)
        require_no_processes()
        require_directory(APPLY_LOCK, 0, 0, 0o700)
        owner = require_regular(APPLY_LOCK / "owner", 0, 0, 0o600)
        try:
            owner_lines = owner.decode("utf-8").splitlines()
        except UnicodeDecodeError:
            fail("lock_owner")
        if (
            digest(owner) != transaction
            or owner_lines.count("controller=ansible-deploy") != 1
            or owner_lines.count("operation=proton-qualification") != 1
            or len(owner_lines) != 3
        ):
            fail("lock_owner")
        require_directory(CONFIG.parent, service.pw_uid, service.pw_gid, 0o700)
        config_raw = require_regular(CONFIG, service.pw_uid, service.pw_gid, 0o600)
        if digest(config_raw) != expected_config:
            fail("config_hash")
        parser = ConfigParser(interpolation=None)
        try:
            parser.read_string(config_raw.decode("utf-8"))
        except (UnicodeDecodeError, ConfigError):
            fail("config_shape")
        if parser.sections() != ["proton-backup"] or set(parser["proton-backup"]) != STATIC_KEYS:
            fail("config_shape")
        remote = parser["proton-backup"]
        if (
            remote.get("type") != "protondrive"
            or remote.get("replace_existing_draft") != "true"
            or remote.get("enable_caching") != "true"
            or remote.get("original_file_size") != "true"
            or CACHE_KEYS & set(remote)
        ):
            fail("config_shape")
        require_directory(CACHE, service.pw_uid, service.pw_gid, 0o700)
        if any(CACHE.iterdir()):
            fail("cache_not_empty")
        require_directory(EVIDENCE_PARENT, 0, 0, 0o750)
        evidence_path = EVIDENCE_PARENT / f"proton-quota-diagnostic-{transaction}.json"
        marker = {
            "config_sha256": expected_config,
            "started_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "stable_rclone_sha256": expected_rclone,
            "state": "started",
            "transaction_sha256": transaction,
            "version": 1,
        }
        atomic_json(evidence_path, marker, replace=False)
        environment = {
            "HOME": "/var/lib/restic-proton",
            "LANG": "C.UTF-8",
            "LC_ALL": "C.UTF-8",
            "PATH": "/usr/local/bin:/usr/bin:/bin",
            "RCLONE_CONFIG_PROTON_BACKUP_TYPE": "protondrive",
            "RCLONE_CONFIG_PROTON_BACKUP_USERNAME": remote["username"],
            "RCLONE_CONFIG_PROTON_BACKUP_PASSWORD": remote["password"],
            "RCLONE_CONFIG_PROTON_BACKUP_REPLACE_EXISTING_DRAFT": "true",
            "RCLONE_CONFIG_PROTON_BACKUP_ENABLE_CACHING": "false",
            "RCLONE_CONFIG_PROTON_BACKUP_ORIGINAL_FILE_SIZE": "true",
        }
        command = [
            str(RUNUSER), "--preserve-environment", "--user", "restic-proton", "--",
            str(RCLONE), "--config", "/dev/null", "--cache-dir", str(CACHE),
            "--log-level", "ERROR", "--stats", "0", "--retries", "1", "--low-level-retries", "1",
            "--protondrive-enable-caching=false", "about", "proton_backup:", "--json",
        ]
        try:
            result = bounded(command, environment)
            if result.returncode != 0:
                fail(f"rclone_rc_{result.returncode}_stderr_sha256_{digest(result.stderr)}")
            try:
                quota = json.loads(result.stdout)
            except (UnicodeDecodeError, json.JSONDecodeError):
                fail("quota_shape")
            if not isinstance(quota, dict):
                fail("quota_shape")
            try:
                observed = {name: quota[name] for name in ("total", "used", "free")}
            except KeyError:
                fail("quota_shape")
            if any(isinstance(value, bool) or not isinstance(value, int) or value < 0 for value in observed.values()):
                fail("quota_shape")
        finally:
            validate_post_state(
                config_raw,
                transaction,
                expected_rclone,
                service.pw_uid,
                service.pw_gid,
            )
        evidence = {
            **marker,
            **observed,
            "observed_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "operation": "about",
            "provider_requests": 1,
            "rclone_rc": result.returncode,
            "state": "observed",
            "stderr_sha256": digest(result.stderr),
            "stdout_sha256": digest(result.stdout),
        }
        evidence_hash = atomic_json(evidence_path, evidence, replace=True)
        print(f"proton_quota_diagnostic=observed evidence_sha256={evidence_hash}")
    except QuotaError as error:
        print(f"proton_quota_diagnostic=failed reason={error}", file=sys.stderr)
        raise SystemExit(1) from None
    except (OSError, KeyError, subprocess.SubprocessError):
        print("proton_quota_diagnostic=failed reason=local_operation", file=sys.stderr)
        raise SystemExit(1) from None


if __name__ == "__main__":
    main()
