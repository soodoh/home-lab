#!/bin/bash
set -euo pipefail

readonly VMID=100
readonly INTERFACE=ide2
readonly DATASTORE=local-lvm
readonly CICUSTOM=local:snippets/vm-100-flatcar.ign
readonly EXPECTED_EFFECTIVE_SCSI3='local-lvm:vm-100-disk-2,backup=1,cache=none,discard=ignore,iothread=1,replicate=1,serial=HOME-LAB-FLATCAR-64G,size=64G,ssd=0'
readonly EXPECTED_RUNNING_SCSI3='local-lvm:vm-100-disk-2,size=64G'
readonly CONFIRMATION=attach-reviewed-vm-100-flatcar-ignition
readonly RECONCILIATION_ROOT=/var/lib/home-lab/reconciliation
readonly PATH=/usr/sbin:/usr/bin:/sbin:/bin

fail() {
  echo "error: $*" >&2
  exit 1
}

config_value() {
  local file=$1 key=$2
  awk -F ': ' -v key="$key" '$1 == key { sub(/^[^:]+: /, ""); print; found=1 } END { if (!found) exit 1 }' "$file"
}

protected_hash() {
  grep -Ev '^(cicustom|digest|ide2|scsi3):' "$1" | sha256sum | awk '{print $1}'
}

verify_effective_drive() {
  local value
  value=$(config_value "$1" "$INTERFACE") || return 1
  [[ $value == local-lvm:vm-100-cloudinit,* ]] || return 1
  [[ ,$value, == *,media=cdrom,* ]]
}

verify_effective_ide2() {
  verify_effective_drive "$1" || return 1
  [[ $(config_value "$1" cicustom) == "user=$CICUSTOM" ]]
}

verify_running_ide2() {
  if ! config_value "$1" "$INTERFACE" >/dev/null 2>&1; then
    if config_value "$1" cicustom >/dev/null 2>&1; then
      return 1
    fi
    return 0
  fi
  verify_effective_drive "$1" || return 1
  if config_value "$1" cicustom >/dev/null 2>&1; then
    [[ $(config_value "$1" cicustom) == "user=$CICUSTOM" ]]
  fi
}

[[ $# -eq 0 ]] || fail "usage: scripts/attach-flatcar-ignition"
[[ $(id -u) -eq 0 ]] || fail "Ignition attachment requires root"
[[ ${HOME_LAB_FLATCAR_IGNITION_ATTACH_CONFIRMED:-} == "$CONFIRMATION" ]] || fail "exact Ignition attachment confirmation is required"
[[ $(ps -o tty= -p "$$" | tr -d ' ') =~ ^tty[0-9]+$ ]] || fail "Ignition attachment requires a physical Proxmox console"
[[ -d $RECONCILIATION_ROOT && ! -L $RECONCILIATION_ROOT ]] || fail "reconciliation lock root is absent or unsafe"
[[ ! -e $RECONCILIATION_ROOT/apply.lock ]] || fail "a protected Proxmox apply is active"
[[ ! -e /var/lib/iac-ansible-production.lock ]] || fail "Ansible host ownership is active"
exec 9>"$RECONCILIATION_ROOT/operation.lock"
flock -n 9 || fail "another protected Proxmox operation holds the lock"
exec 8>/run/lock/home-lab-flatcar-ignition-attach.lock
flock -n 8 || fail "another Ignition attachment holds the lock"
exec 7>/run/lock/home-lab-vfio-recovery.lock
flock -n 7 || fail "VFIO recovery is active"

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
[[ $(git branch --show-current) == main ]] || fail "repository is not on main"
[[ -z $(git status --porcelain) ]] || fail "repository is not clean"
scripts/stage-flatcar-image check >/dev/null
scripts/stage-flatcar-ignition check >/dev/null
[[ $(qm status "$VMID") == "status: running" ]] || fail "VM 100 is not running"

before=$(mktemp --tmpdir=/run home-lab-ignition-before.XXXXXX)
before_current=$(mktemp --tmpdir=/run home-lab-ignition-before-current.XXXXXX)
after=$(mktemp --tmpdir=/run home-lab-ignition-after.XXXXXX)
after_current=$(mktemp --tmpdir=/run home-lab-ignition-after-current.XXXXXX)
cleanup() {
  rm -f -- "$before" "$before_current" "$after" "$after_current"
}
trap cleanup EXIT
chmod 0600 "$before" "$before_current" "$after" "$after_current"
qm config "$VMID" > "$before"
qm config "$VMID" --current 1 > "$before_current"

for key in scsi0 scsi1 scsi2; do
  [[ $(config_value "$before" "$key") == $(config_value "$before_current" "$key") ]] || fail "$key has a pending change"
done
[[ $(config_value "$before" scsi3) == "$EXPECTED_EFFECTIVE_SCSI3" ]] || fail "effective scsi3 differs"
[[ $(config_value "$before_current" scsi3) == "$EXPECTED_RUNNING_SCSI3" || $(config_value "$before_current" scsi3) == "$EXPECTED_EFFECTIVE_SCSI3" ]] || fail "running scsi3 differs"
[[ $(config_value "$before" boot) == "order=scsi0;net0" ]] || fail "Arch boot order differs"
[[ $(config_value "$before" protection) == 1 ]] || fail "VM 100 protection differs"
! config_value "$before" lock >/dev/null 2>&1 || fail "VM 100 has an active Proxmox configuration lock"
! grep -Eq '^unused[0-9]+:' "$before" || fail "an unused disk requires reconciliation"
[[ $(protected_hash "$before") == $(protected_hash "$before_current") ]] || fail "VM 100 has pending protected configuration"

drive_missing=true
cicustom_missing=true
if config_value "$before" "$INTERFACE" >/dev/null 2>&1; then
  verify_effective_drive "$before" || fail "existing cloud-init drive differs"
  drive_missing=false
fi
if config_value "$before" cicustom >/dev/null 2>&1; then
  [[ $(config_value "$before" cicustom) == "user=$CICUSTOM" ]] || fail "existing cicustom differs"
  cicustom_missing=false
fi
verify_running_ide2 "$before_current" || fail "running Ignition attachment differs"

mutation_started=false
on_error() {
  result=$?
  if [[ $mutation_started == true ]]; then
    echo "error: Ignition attachment is incomplete; the cloud-init drive is preserved for explicit reconciliation" >&2
  fi
  exit "$result"
}
trap on_error ERR

if [[ $drive_missing == true || $cicustom_missing == true ]]; then
  mutation_started=true
fi
if [[ $drive_missing == true ]]; then
  qm set "$VMID" --ide2 "$DATASTORE:cloudinit"
fi
if [[ $cicustom_missing == true ]]; then
  qm set "$VMID" --cicustom "user=$CICUSTOM"
fi
qm config "$VMID" > "$after"
qm config "$VMID" --current 1 > "$after_current"

verify_effective_ide2 "$after" || fail "effective Ignition attachment differs"
verify_running_ide2 "$after_current" || fail "running Ignition attachment differs"
[[ $(config_value "$before" scsi3) == $(config_value "$after" scsi3) ]] || fail "effective scsi3 changed"
[[ $(config_value "$before_current" scsi3) == $(config_value "$after_current" scsi3) ]] || fail "running scsi3 changed"
[[ $(protected_hash "$before") == $(protected_hash "$after") ]] || fail "protected VM configuration changed"
[[ $(protected_hash "$before_current") == $(protected_hash "$after_current") ]] || fail "running protected VM configuration changed"
! grep -Eq '^unused[0-9]+:' "$after" || fail "an unexpected unused disk remains"
[[ $(qm status "$VMID") == "status: running" ]] || fail "VM 100 stopped during Ignition attachment"
activation=active
verify_effective_ide2 "$after_current" || activation=pending-reboot
mutation_started=false
trap - ERR

printf '{"bootOrder":"scsi0;net0","configurationActivation":"%s","cicustom":"user=%s","interface":"%s","state":"verified","vmStatus":"running","vmid":%s}\n' \
  "$activation" "$CICUSTOM" "$INTERFACE" "$VMID"
