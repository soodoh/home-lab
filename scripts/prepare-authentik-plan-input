#!/usr/bin/env bash
set -euo pipefail
umask 077

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

[[ ${TF_VAR_authentik_enable_management:-false} == true ]] || exit 0
: "${AUTHENTIK_URL:?AUTHENTIK_URL is required when Authentik management is enabled}"
: "${AUTHENTIK_TOKEN:?AUTHENTIK_TOKEN is required when Authentik management is enabled}"
: "${SOPS_AGE_KEY_FILE:?SOPS_AGE_KEY_FILE is required when Authentik management is enabled}"
: "${TF_VAR_authentik_client_secrets_path:?TF_VAR_authentik_client_secrets_path is required}"
[[ $AUTHENTIK_URL == https://auth.diloreto.com ]]
[[ $TF_VAR_authentik_client_secrets_path = /* ]]
[[ ! -e $TF_VAR_authentik_client_secrets_path && ! -L $TF_VAR_authentik_client_secrets_path ]]
for command in jq python3 sops; do
  command -v "$command" >/dev/null || { echo "missing command: $command" >&2; exit 69; }
done

SOPS_KEY_FILE=$SOPS_AGE_KEY_FILE python3 - <<'PY'
import os
import stat
from pathlib import Path

path = Path(os.environ["SOPS_KEY_FILE"])
if not path.is_file() or path.is_symlink():
    raise SystemExit("SOPS age identity must be a regular file")
metadata = path.stat()
if metadata.st_uid != os.getuid() or stat.S_IMODE(metadata.st_mode) != 0o600:
    raise SystemExit("SOPS age identity must be owned by the controller user with mode 0600")
PY

client_secrets_parent=$(dirname "$TF_VAR_authentik_client_secrets_path")
[[ -d $client_secrets_parent && ! -L $client_secrets_parent ]]
[[ $(stat -f '%Lp' "$client_secrets_parent" 2>/dev/null || stat -c '%a' "$client_secrets_parent") == 700 ]]
client_secrets=$(mktemp "$client_secrets_parent/client-secrets.XXXXXX")
trap 'rm -f "$client_secrets"' EXIT INT TERM
SOPS_AGE_KEY_FILE=$SOPS_AGE_KEY_FILE sops --decrypt --output-type json \
  infrastructure/tofu/authentik/client-secrets.sops.json >"$client_secrets"
jq -e '
  .schemaVersion == 2 and
  (.oauthProviders | type == "object" and (keys | sort) == ["15", "21", "37", "47", "49"]) and
  all(.oauthProviders[];
    type == "object" and
    (keys == ["client_secret"]) and
    (.client_secret | type == "string" and length > 0 and . != "REPLACE-DURING-BOOTSTRAP")) and
  (.ldap | type == "object" and (keys == ["bind_password", "certificate_private_key"]) and
    (.bind_password | type == "string" and length >= 48) and
    (.certificate_private_key | type == "string" and startswith("-----BEGIN PRIVATE KEY-----")))
' "$client_secrets" >/dev/null
chmod 0600 "$client_secrets"
mv "$client_secrets" "$TF_VAR_authentik_client_secrets_path"
trap - EXIT INT TERM
