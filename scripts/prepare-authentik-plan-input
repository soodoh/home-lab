#!/usr/bin/env bash
set -euo pipefail
umask 077

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

[[ ${TF_VAR_authentik_enable_management:-false} == true ]] || exit 0
: "${AUTHENTIK_URL:?AUTHENTIK_URL is required when Authentik management is enabled}"
: "${AUTHENTIK_TOKEN:?AUTHENTIK_TOKEN is required when Authentik management is enabled}"
: "${SOPS_AGE_KEY_FILE:?SOPS_AGE_KEY_FILE is required when Authentik management is enabled}"
: "${TF_VAR_authentik_client_secrets_path:?TF_VAR_authentik_client_secrets_path is required}"
: "${TF_VAR_authentik_signing_keys_path:?TF_VAR_authentik_signing_keys_path is required}"
[[ $AUTHENTIK_URL == https://auth.diloreto.com ]]
for target in "$TF_VAR_authentik_client_secrets_path" "$TF_VAR_authentik_signing_keys_path"; do
  [[ $target = /* && ! -e $target && ! -L $target ]]
done
[[ $TF_VAR_authentik_client_secrets_path != "$TF_VAR_authentik_signing_keys_path" ]]
for command in jq python3 sops; do
  command -v "$command" >/dev/null || { echo "missing command: $command" >&2; exit 69; }
done

SOPS_KEY_FILE=$SOPS_AGE_KEY_FILE python3 - <<'PY'
import os
import stat
from pathlib import Path

path = Path(os.environ["SOPS_KEY_FILE"])
if not path.is_file() or path.is_symlink():
    raise SystemExit("SOPS age identity must be a regular file")
metadata = path.stat()
if metadata.st_uid != os.getuid() or stat.S_IMODE(metadata.st_mode) != 0o600:
    raise SystemExit("SOPS age identity must be owned by the controller user with mode 0600")
PY

client_secrets_parent=$(dirname "$TF_VAR_authentik_client_secrets_path")
signing_keys_parent=$(dirname "$TF_VAR_authentik_signing_keys_path")
for parent in "$client_secrets_parent" "$signing_keys_parent"; do
  [[ -d $parent && ! -L $parent ]]
  [[ $(stat -c '%a' "$parent" 2>/dev/null || stat -f '%Lp' "$parent") == 700 ]]
done
client_secrets=$(mktemp "$client_secrets_parent/client-secrets.XXXXXX")
signing_keys=""
trap 'rm -f "$client_secrets" "$signing_keys"' EXIT INT TERM
signing_keys=$(mktemp "$signing_keys_parent/signing-keys.XXXXXX")
SOPS_AGE_KEY_FILE=$SOPS_AGE_KEY_FILE sops --decrypt --output-type json \
  infrastructure/tofu/authentik/client-secrets.sops.json >"$client_secrets"
jq -e --slurpfile desired infrastructure/tofu/authentik/desired.json '
  .schemaVersion == 2 and
  (.oauthProviders | type == "object" and (keys | sort) == ($desired[0].oauthProviders | keys | sort)) and
  all(.oauthProviders[];
    type == "object" and
    (keys == ["client_secret"]) and
    (.client_secret | type == "string" and length > 0 and . != "REPLACE-DURING-BOOTSTRAP")) and
  (.ldap | type == "object" and (keys == ["bind_password", "certificate_private_key"]) and
    (.bind_password | type == "string" and length >= 48) and
    (.certificate_private_key | type == "string" and startswith("-----BEGIN PRIVATE KEY-----")))
' "$client_secrets" >/dev/null

SOPS_AGE_KEY_FILE=$SOPS_AGE_KEY_FILE sops --decrypt --output-type json \
  infrastructure/tofu/authentik/signing-keys.sops.json >"$signing_keys"
jq -e --slurpfile desired infrastructure/tofu/authentik/desired.json '
  .schemaVersion == 1 and
  (.certificates | type == "object" and (keys | sort) == ($desired[0].signingCertificates | keys | sort)) and
  all(.certificates[];
    type == "object" and (keys == ["private_key"]) and
    (.private_key | type == "string" and test("^-----BEGIN (RSA |EC )?PRIVATE KEY-----")))
' "$signing_keys" >/dev/null

# Masked OAuth secrets or an unreadable signing key would propose false
# updates even when the SOPS values are already live. Refuse both cases.
python3 scripts/check-authentik-secret-readability.py
chmod 0600 "$client_secrets" "$signing_keys"
mv "$client_secrets" "$TF_VAR_authentik_client_secrets_path"
mv "$signing_keys" "$TF_VAR_authentik_signing_keys_path"
trap - EXIT INT TERM
