#!/usr/bin/env python3
"""Promote the exact qualified Proton Restic repository to its canonical path."""
from __future__ import annotations

from datetime import datetime, timezone
from importlib.machinery import SourceFileLoader
import json
import os
from pathlib import Path
import re
import subprocess

BASE_PATH = Path(os.environ["HOME_LAB_PROTON_PROMOTION_BASE"]) if os.environ.get("HOME_LAB_PROTON_PROMOTION_TESTING") == "1" else Path("/usr/local/libexec/home-lab/cleanup-damaged-proton-restic-v1")
B = SourceFileLoader("proton_promotion_base", str(BASE_PATH)).load_module()
ROOT = Path("/var/lib/restic-proton")
JOURNAL_ROOT = ROOT / "qualified-proton-promotion"
BETA = ROOT / "upload-diagnostic/rclone-beta"
BETA_STATE = ROOT / "upload-diagnostic/restic-beta-state.json"
SOURCE = "rclone:proton-backup:Diagnostics/restic-beta-10267"
SOURCE_REMOTE = "proton-backup:Diagnostics/restic-beta-10267"
TARGET = "rclone:proton-backup:Backups/home-lab-restic"
TARGET_REMOTE = "proton-backup:Backups/home-lab-restic"
V2 = "rclone:proton-backup:Backups/home-lab-restic-v2"
SOURCE_ID = "dce8dbc3cde106047631317a09257c23ee5eab4d9ece5f88d52108ae384a8503"
SOURCE_SNAPSHOT = "a42e4694ac164d62bb1c815144ea6407f70ab1e8ee91c54f293b2acdb77dcfea"
ORIGINAL_SNAPSHOT = "edd4f507cec382e6fae48e2690ffa53ae7ef7a61e24581983975631cbe5a32e2"
TARGET_FAILED_ID = "485946d1d9139ca58ac9110832203455aa474c1ca390ae53685f8ca7ca5e12ab"
TARGET_BROKEN_PACK = "392b7b680b6a25aaab2779fd1a49b6b8be213bcfde46f9429262edb3741db63c"
V2_ID = "98d792c009c01e06b8b39aab5112f0392050e9c533d1882e9c0d87727884ea25"
V2_BROKEN_PACK = "a1f72495c2ca8a84c76fb7843e2ebcd35f6b8d675bb8121a736c4c3622f1e669"
BETA_SHA256 = "acd2c7aca2996c884a8cd0012b27d74213bc7d02c514d9711166b5023e51ca49"
STABLE_SHA256 = "f3f9aff817f9766029e50adf9a7963c169e475b8f10c7927823568a0d9443db7"
TRASH_PLAN = "53898e93b53264768b090d4b00e7e3add22e822efa5c7fa1bb6fc0b97e0f8a90"
TRASH_STATE = ROOT / "proton-trash-cleanup" / TRASH_PLAN / "state.json"
CANONICAL_PLAN = "6c128f8498c87fa070685f79608296855508b97818098a1300e77740a4ee58eb"
CANONICAL_STATE = ROOT / "canonical-proton-creation" / CANONICAL_PLAN / "state.json"
PLAN_FORMAT = "home-lab-qualified-proton-promotion-plan-v1"
AUTH_FORMAT = "home-lab-qualified-proton-promotion-authorization-v1"
RECEIPT_FORMAT = "home-lab-qualified-proton-promotion-receipt-v1"
HEX = re.compile(r"^[0-9a-f]{64}$")
GIT_COMMIT = re.compile(r"^[0-9a-f]{40}$")


def fail(reason: str) -> None:
    raise SystemExit(f"qualified_proton_promotion=failed reason={reason}")


def command(module, argv: list[str], environment: dict[str, str], label: str, timeout: int = 600) -> str:
    result = module.run(argv, environment=environment, timeout=timeout)
    if result.returncode:
        fail(f"{label}-{result.returncode}-{B.sha(result.stderr.encode())}")
    return result.stdout


def mutation_command(rclone: str, config: Path, environment: dict[str, str], argv: list[str], label: str) -> None:
    allowed = [
        [rclone, "purge", "--config", str(config), TARGET_REMOTE],
        [rclone, "moveto", "--config", str(config), SOURCE_REMOTE, TARGET_REMOTE],
    ]
    if argv not in allowed:
        fail("mutation-command-scope")
    merged = {"PATH":"/usr/local/bin:/usr/bin:/bin","HOME":"/var/empty","LC_ALL":"C","TZ":"UTC"}
    merged.update(environment)
    try:
        result = subprocess.run(argv, env=merged, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=3600, check=False)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise SystemExit(f"qualified_proton_promotion=failed reason={label}-execution") from error
    if result.returncode:
        fail(f"{label}-{result.returncode}-{B.sha(result.stderr.encode())}")


def load_policy(*, deployed: bool):
    module, policy, digest = B.module_and_policy()
    proton = policy["repositories"]["proton"]
    tools = policy["tools"]["rclone"]
    repository_identity = (proton.get("path"), proton.get("id"))
    if repository_identity not in {(V2, V2_ID), (TARGET, SOURCE_ID)} or policy.get("schedule", {}).get("state") not in ({"incident-suspended"} if deployed else {None, "incident-suspended"}):
        fail("policy-boundary")
    if deployed and (tools.get("installed_sha256") != BETA_SHA256 or tools.get("version") != "1.76.0-beta.10267.220fe7619"):
        fail("deployed-tool-policy")
    return module, policy, digest


def check_summary(stdout: str) -> dict:
    try:
        values = [json.loads(line) for line in stdout.splitlines() if line]
    except json.JSONDecodeError as error:
        raise SystemExit("qualified_proton_promotion=failed reason=check-json") from error
    matches = [item for item in values if item.get("message_type") == "summary"]
    if len(matches) != 1:
        fail("check-summary")
    return matches[0]


def restic_prefix(restic: str, repository: str) -> list[str]:
    return [restic, "-o", f"rclone.program={BETA}", "-r", repository]


def repository_proof(module, restic: str, environment: dict[str, str], repository: str, expected_id: str, expected_snapshot: str | None = None) -> dict:
    prefix = restic_prefix(restic, repository)
    config = json.loads(command(module, [*prefix, "cat", "config"], environment, "repository-config"))
    if config.get("id") != expected_id or not isinstance(config.get("chunker_polynomial"), str):
        fail("repository-identity")
    proof = {"repository_id": expected_id, "chunker_polynomial": config["chunker_polynomial"]}
    if expected_snapshot:
        snapshots = json.loads(command(module, [*prefix, "snapshots", "--json", expected_snapshot], environment, "repository-snapshot"))
        if len(snapshots) != 1 or snapshots[0].get("id") != expected_snapshot or snapshots[0].get("original") != ORIGINAL_SNAPSHOT:
            fail("repository-snapshot")
        proof |= {"snapshot_id": expected_snapshot, "original_snapshot_id": ORIGINAL_SNAPSHOT}
    return proof


def broken_proof(module, restic: str, environment: dict[str, str], repository: str, expected_id: str, broken_pack: str) -> dict:
    repository_proof(module, restic, environment, repository, expected_id)
    result = module.run([*restic_prefix(restic, repository), "check", "--json"], environment=environment, timeout=3600)
    observed = check_summary(result.stdout)
    expected = {"message_type":"summary","num_errors":1,"broken_packs":[broken_pack],"suggest_repair_index":False,"suggest_prune":False}
    if result.returncode != 1 or observed != expected:
        fail("broken-proof")
    return {"repository_id": expected_id, "broken_pack": broken_pack, "check_summary": observed}


def private_state(path: Path, expected_format: str, expected_status: str, expected_plan: str | None = None) -> dict:
    value, raw = B.load_private(path)
    if value.get("format") != expected_format or value.get("status") != expected_status or (expected_plan and value.get("plan_sha256") != expected_plan):
        fail("retained-state")
    return {"path": str(path), "sha256": B.sha(raw), "status": expected_status}


def timers(module, expected_unit_state: str | None = None) -> list[dict]:
    values = []
    for unit in ("home-lab-restic-daily.timer", "home-lab-restic-maintenance.timer"):
        result = module.run(["/usr/bin/systemctl", "show", "--property=ActiveState", "--property=UnitFileState", "--value", unit], environment={}, timeout=30)
        if result.returncode or result.stdout.splitlines()[0] != "inactive" or (expected_unit_state and result.stdout.splitlines()[1] != expected_unit_state):
            fail("timer-state")
        values.append({"unit":unit,"active":"inactive","unit_file":result.stdout.splitlines()[1]})
    return values


def reject_processes(module, restic: str, rclone: str) -> None:
    B.reject_processes(restic, rclone)
    result = module.run(["/usr/bin/pgrep", "--full", str(BETA)], environment={}, timeout=30)
    if result.returncode == 0 or result.returncode not in {0, 1}:
        fail("beta-process")


def candidate_state() -> dict:
    value, raw = B.load_private(BETA_STATE)
    expected = {"status":"verified","repository_id":SOURCE_ID,"snapshot_id":SOURCE_SNAPSHOT,"source_snapshot_id":ORIGINAL_SNAPSHOT,"beta_sha256":BETA_SHA256,"full_read_data_check":"zero-errors"}
    if any(value.get(key) != expected_value for key, expected_value in expected.items()):
        fail("candidate-state")
    return {"sha256":B.sha(raw), **expected}


def observe_locked(module, policy: dict, policy_sha256: str, *, deployed: bool, full_check: bool = True) -> dict:
    restic, system_rclone = module.command_paths(policy)
    reject_processes(module, restic, system_rclone)
    if B.sha(BETA.read_bytes()) != BETA_SHA256:
        fail("beta-binary")
    installed_sha = B.sha(Path(system_rclone).read_bytes())
    environment = module.credential_environment(policy, "proton", "games")
    candidate = repository_proof(module, restic, environment, SOURCE, SOURCE_ID, SOURCE_SNAPSHOT)
    if full_check:
        checked = command(module, [*restic_prefix(restic, SOURCE), "check", "--json", "--read-data"], environment, "candidate-full-check", 14400)
        B.validate_check_summary(checked)
    candidate |= {"full_read_data_check":"zero-errors" if full_check else "retained-qualified"}
    return {
        "format":"home-lab-qualified-proton-promotion-observation-v1",
        "helper_sha256":B.sha(Path(__file__).read_bytes()),
        "base_helper_sha256":B.sha(BASE_PATH.read_bytes()),
        "policy_sha256":policy_sha256,
        "installed_rclone_sha256":installed_sha,
        "beta_sha256":BETA_SHA256,
        "candidate":candidate,
        "candidate_state":candidate_state(),
        "failed_canonical":broken_proof(module, restic, environment, TARGET, TARGET_FAILED_ID, TARGET_BROKEN_PACK),
        "damaged_v2":broken_proof(module, restic, environment, V2, V2_ID, V2_BROKEN_PACK),
        "trash_state":private_state(TRASH_STATE, "home-lab-proton-trash-cleanup-receipt-v1", "cleanup-started", TRASH_PLAN),
        "canonical_state":private_state(CANONICAL_STATE, "home-lab-canonical-proton-creation-receipt-v1", "copied", CANONICAL_PLAN),
        "timers":timers(module, "disabled" if deployed else None),
    }


def observe() -> None:
    B.require_identity()
    module, policy, policy_sha256 = load_policy(deployed=False)
    descriptor = B.acquire_lock(module, policy)
    try:
        print(B.canonical(observe_locked(module, policy, policy_sha256, deployed=False)).decode(), end="")
    finally:
        os.close(descriptor)


def validate_plan(path: Path, *, allow_expired: bool = False) -> tuple[dict, str, datetime]:
    plan, raw = B.load_private(path)
    digest = B.sha(raw)
    try:
        created = datetime.fromisoformat(plan["created_at"].replace("Z", "+00:00"))
        expires = datetime.fromisoformat(plan["expires_at"].replace("Z", "+00:00"))
    except (KeyError, TypeError, ValueError) as error:
        raise SystemExit("qualified_proton_promotion=failed reason=plan-time") from error
    action = {"kind":"promote-qualified-proton-repository","install_rclone_sha256":BETA_SHA256,"retire_to_trash":TARGET,"move_from":SOURCE,"move_to":TARGET,"preserve":V2}
    now = datetime.now(timezone.utc)
    if (set(plan) != {"format","commit","contract_sha256","deployed_policy_sha256","created_at","expires_at","host_observation","action","blockers","authorized"}
            or plan.get("format") != PLAN_FORMAT or path.name != f"qualified-proton-promotion-{digest}.json"
            or GIT_COMMIT.fullmatch(str(plan.get("commit", ""))) is None or HEX.fullmatch(str(plan.get("contract_sha256", ""))) is None or HEX.fullmatch(str(plan.get("deployed_policy_sha256", ""))) is None
            or plan.get("action") != action or plan.get("blockers") != ["exact-proton-promotion-authorization-required"]
            or plan.get("authorized") is not False or expires <= created or (expires-created).total_seconds() > 86400
            or created > now or (not allow_expired and now > expires)):
        fail("plan-binding")
    return plan, digest, expires


def validate_authorization(path: Path, digest: str, plan: dict) -> tuple[str, datetime]:
    value, raw = B.load_private(path); auth_digest = B.sha(raw)
    try: expires = datetime.fromisoformat(value["expires_at"].replace("Z", "+00:00")); created = datetime.fromisoformat(value["created_at"].replace("Z", "+00:00"))
    except (KeyError, TypeError, ValueError) as error: raise SystemExit("qualified_proton_promotion=failed reason=authorization-time") from error
    expected = {"format":AUTH_FORMAT,"plan_sha256":digest,"created_at":value.get("created_at"),"expires_at":value.get("expires_at"),"confirmation":f"authorize-qualified-proton-promotion-{digest}","authorized":True}
    if value != expected or expires <= created or (expires-created).total_seconds() > 900 or expires > datetime.fromisoformat(plan["expires_at"].replace("Z", "+00:00")):
        fail("authorization-binding")
    return auth_digest, expires


def directory_entries(module, rclone: str, environment: dict[str, str], parent: str) -> list[str]:
    config = module.rooted("/var/lib/restic-proton/rclone.conf")
    stdout = command(module, [rclone, "lsf", "--dirs-only", "--config", str(config), parent], environment, "directory-listing")
    entries = [line for line in stdout.splitlines() if line]
    if any("/" in entry.rstrip("/") or entry in {".", ".."} for entry in entries) or len(entries) != len(set(entries)):
        fail("directory-listing-shape")
    return entries


def require_directory_absent(module, rclone: str, environment: dict[str, str], parent: str, name: str, label: str) -> None:
    if name in directory_entries(module, rclone, environment, parent):
        fail(label)


def directory_present(module, rclone: str, environment: dict[str, str], parent: str, name: str) -> bool:
    return name in directory_entries(module, rclone, environment, parent)


def mutation_disposition(status: str, target_present: bool, source_present: bool) -> str:
    if status == "canonical-retirement-started":
        if target_present and source_present:
            return "execute"
        if not target_present and source_present:
            return "adopt"
    elif status == "candidate-move-started":
        if source_present and not target_present:
            return "execute"
        if target_present and not source_present:
            return "adopt"
    fail("mutation-resume-namespace")


def retained_postconditions(module, restic: str, environment: dict[str, str], prior: dict) -> None:
    broken_proof(module, restic, environment, V2, V2_ID, V2_BROKEN_PACK)
    if (private_state(TRASH_STATE, "home-lab-proton-trash-cleanup-receipt-v1", "cleanup-started", TRASH_PLAN) != prior["trash_state"]
            or private_state(CANONICAL_STATE, "home-lab-canonical-proton-creation-receipt-v1", "copied", CANONICAL_PLAN) != prior["canonical_state"]):
        fail("retained-journal-drift")


def validate_receipt(receipt: dict, digest: str) -> None:
    required = {"format", "status", "plan_sha256", "authorization_sha256", "started_at", "retired_at", "moved_at", "committed_at", "target", "source_absent", "structural_check", "full_read_data_check", "damaged_v2_preserved"}
    target = receipt.get("target", {})
    if (set(receipt) != required or receipt.get("format") != RECEIPT_FORMAT or receipt.get("status") != "committed"
            or receipt.get("plan_sha256") != digest or HEX.fullmatch(str(receipt.get("authorization_sha256", ""))) is None
            or target.get("repository_id") != SOURCE_ID or target.get("snapshot_id") != SOURCE_SNAPSHOT
            or target.get("original_snapshot_id") != ORIGINAL_SNAPSHOT or not isinstance(target.get("chunker_polynomial"), str)
            or receipt.get("source_absent") is not True or receipt.get("structural_check") != "zero-errors"
            or receipt.get("full_read_data_check") != "zero-errors"
            or receipt.get("damaged_v2_preserved") != {"repository_id": V2_ID, "broken_pack": V2_BROKEN_PACK}):
        fail("receipt-binding")
    try:
        times = [datetime.fromisoformat(receipt[key].replace("Z", "+00:00")) for key in ("started_at", "retired_at", "moved_at", "committed_at")]
    except (AttributeError, ValueError) as error:
        raise SystemExit("qualified_proton_promotion=failed reason=receipt-time") from error
    if times != sorted(times):
        fail("receipt-time-order")


def apply(plan_path: Path, authorization_path: Path) -> None:
    B.require_identity()
    plan, digest, plan_expires = validate_plan(plan_path, allow_expired=True)
    auth_digest, auth_expires = validate_authorization(authorization_path, digest, plan)
    if os.environ.get("QUALIFIED_PROTON_PROMOTION_CONFIRMED") != f"promote-qualified-proton-repository-{digest}-{auth_digest}":
        fail("exact-confirmation")
    module, policy, policy_sha256 = load_policy(deployed=True)
    if plan.get("deployed_policy_sha256") != policy_sha256:
        fail("deployed-contract")
    descriptor = B.acquire_lock(module, policy)
    try:
        B.require_private_directory(JOURNAL_ROOT)
        journal = JOURNAL_ROOT / digest
        if not os.path.lexists(journal):
            journal.mkdir(mode=0o700)
            B.fsync_directory(JOURNAL_ROOT)
        B.require_private_directory(journal)
        state = B.current_state(journal)
        receipt_path = journal / "receipt.json"
        restic, rclone = module.command_paths(policy)
        environment = module.credential_environment(policy, "proton", "games")
        reject_processes(module, restic, rclone)
        if B.sha(Path(rclone).read_bytes()) != BETA_SHA256:
            fail("installed-beta")
        prior = plan["host_observation"]
        if os.path.lexists(receipt_path):
            receipt, raw = B.load_private(receipt_path)
            validate_receipt(receipt, digest)
            target = repository_proof(module, restic, environment, TARGET, SOURCE_ID, SOURCE_SNAPSHOT)
            if target != receipt["target"]:
                fail("receipt-target-drift")
            require_directory_absent(module, rclone, environment, "proton-backup:Diagnostics", "restic-beta-10267/", "receipt-source-present")
            full = command(module, [*restic_prefix(restic, TARGET), "check", "--json", "--read-data"], environment, "receipt-full-check", 14400)
            B.validate_check_summary(full)
            retained_postconditions(module, restic, environment, prior)
            if state != receipt:
                B.write_private(journal / "state.json", receipt)
            print(B.canonical({"status":"committed","plan_sha256":digest,"receipt_sha256":B.sha(raw)}).decode(), end="")
            return
        now = datetime.now(timezone.utc)
        if now > auth_expires or now > plan_expires:
            fail("fresh-authorization-required")
        if (B.sha(Path(__file__).read_bytes()) != prior["helper_sha256"] or B.sha(BASE_PATH.read_bytes()) != prior["base_helper_sha256"]
                or B.sha(BETA.read_bytes()) != prior["beta_sha256"] or candidate_state() != prior["candidate_state"]):
            fail("current-precondition-local")
        retained_postconditions(module, restic, environment, prior)
        target_present = directory_present(module, rclone, environment, "proton-backup:Backups", "home-lab-restic/")
        source_present = directory_present(module, rclone, environment, "proton-backup:Diagnostics", "restic-beta-10267/")
        if state is None:
            if not target_present or not source_present:
                fail("initial-namespace")
            current = observe_locked(module, policy, policy_sha256, deployed=True, full_check=True)
            for key in ("helper_sha256", "base_helper_sha256", "beta_sha256", "candidate", "candidate_state", "failed_canonical", "damaged_v2", "trash_state", "canonical_state"):
                if current.get(key) != prior.get(key):
                    fail(f"current-precondition-{key}")
            state = {"format":RECEIPT_FORMAT,"status":"started","plan_sha256":digest,"authorization_sha256":auth_digest,"started_at":now.replace(microsecond=0).isoformat().replace("+00:00","Z")}
            B.write_private(journal / "state.json", state, exclusive=True)
        elif state.get("format") != RECEIPT_FORMAT or state.get("plan_sha256") != digest or state.get("status") not in {"started", "canonical-retirement-started", "failed-canonical-retired", "candidate-move-started", "candidate-moved"}:
            fail("resume-state")
        if state.get("authorization_sha256") != auth_digest:
            state = {**state, "authorization_sha256": auth_digest}
            B.write_private(journal / "state.json", state)
        if state["status"] == "started":
            if not target_present or not source_present:
                fail("started-namespace")
            failed = broken_proof(module, restic, environment, TARGET, TARGET_FAILED_ID, TARGET_BROKEN_PACK)
            candidate = repository_proof(module, restic, environment, SOURCE, SOURCE_ID, SOURCE_SNAPSHOT)
            checked = command(module, [*restic_prefix(restic, SOURCE), "check", "--json", "--read-data"], environment, "candidate-resume-full-check", 14400)
            B.validate_check_summary(checked)
            if failed != prior["failed_canonical"] or {**candidate, "full_read_data_check":"zero-errors"} != prior["candidate"]:
                fail("started-precondition")
            state = {**state, "status":"canonical-retirement-started", "retirement_started_at":datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00","Z")}
            B.write_private(journal / "state.json", state)
        if state["status"] == "canonical-retirement-started":
            target_present = directory_present(module, rclone, environment, "proton-backup:Backups", "home-lab-restic/")
            source_present = directory_present(module, rclone, environment, "proton-backup:Diagnostics", "restic-beta-10267/")
            disposition = mutation_disposition(state["status"], target_present, source_present)
            if disposition == "execute":
                broken_proof(module, restic, environment, TARGET, TARGET_FAILED_ID, TARGET_BROKEN_PACK)
                config = module.rooted("/var/lib/restic-proton/rclone.conf")
                mutation_command(rclone, config, environment, [rclone, "purge", "--config", str(config), TARGET_REMOTE], "retire-failed-canonical")
                require_directory_absent(module, rclone, environment, "proton-backup:Backups", "home-lab-restic/", "failed-canonical-present")
            else:
                repository_proof(module, restic, environment, SOURCE, SOURCE_ID, SOURCE_SNAPSHOT)
            state = {key:value for key,value in state.items() if key != "retirement_started_at"}
            state = {**state, "status":"failed-canonical-retired", "retired_at":datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00","Z")}
            B.write_private(journal / "state.json", state)
        if state["status"] == "failed-canonical-retired":
            target_present = directory_present(module, rclone, environment, "proton-backup:Backups", "home-lab-restic/")
            source_present = directory_present(module, rclone, environment, "proton-backup:Diagnostics", "restic-beta-10267/")
            if target_present or not source_present:
                fail("retired-namespace")
            repository_proof(module, restic, environment, SOURCE, SOURCE_ID, SOURCE_SNAPSHOT)
            state = {**state, "status":"candidate-move-started", "move_started_at":datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00","Z")}
            B.write_private(journal / "state.json", state)
        if state["status"] == "candidate-move-started":
            target_present = directory_present(module, rclone, environment, "proton-backup:Backups", "home-lab-restic/")
            source_present = directory_present(module, rclone, environment, "proton-backup:Diagnostics", "restic-beta-10267/")
            disposition = mutation_disposition(state["status"], target_present, source_present)
            if disposition == "execute":
                repository_proof(module, restic, environment, SOURCE, SOURCE_ID, SOURCE_SNAPSHOT)
                config = module.rooted("/var/lib/restic-proton/rclone.conf")
                mutation_command(rclone, config, environment, [rclone, "moveto", "--config", str(config), SOURCE_REMOTE, TARGET_REMOTE], "move-qualified-candidate")
                require_directory_absent(module, rclone, environment, "proton-backup:Diagnostics", "restic-beta-10267/", "source-still-present")
            else:
                repository_proof(module, restic, environment, TARGET, SOURCE_ID, SOURCE_SNAPSHOT)
            state = {key:value for key,value in state.items() if key != "move_started_at"}
            state = {**state, "status":"candidate-moved", "moved_at":datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00","Z")}
            B.write_private(journal / "state.json", state)
        require_directory_absent(module, rclone, environment, "proton-backup:Diagnostics", "restic-beta-10267/", "source-still-present")
        target = repository_proof(module, restic, environment, TARGET, SOURCE_ID, SOURCE_SNAPSHOT)
        structural = command(module, [*restic_prefix(restic, TARGET), "check", "--json"], environment, "target-structural-check", 3600)
        B.validate_check_summary(structural)
        full = command(module, [*restic_prefix(restic, TARGET), "check", "--json", "--read-data"], environment, "target-full-check", 14400)
        B.validate_check_summary(full)
        retained_postconditions(module, restic, environment, prior)
        receipt = {**state,"status":"committed","committed_at":datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00","Z"),"target":target,"source_absent":True,"structural_check":"zero-errors","full_read_data_check":"zero-errors","damaged_v2_preserved":{"repository_id":V2_ID,"broken_pack":V2_BROKEN_PACK}}
        validate_receipt(receipt, digest)
        raw = B.write_private(receipt_path, receipt, exclusive=True)
        B.write_private(journal / "state.json", receipt)
        print(B.canonical({"status":"committed","plan_sha256":digest,"receipt_sha256":B.sha(raw)}).decode(), end="")
    finally:
        os.close(descriptor)


def main() -> None:
    parser=__import__("argparse").ArgumentParser(); commands=parser.add_subparsers(dest="command",required=True); commands.add_parser("observe"); execute=commands.add_parser("apply"); execute.add_argument("plan",type=Path); execute.add_argument("authorization",type=Path); args=parser.parse_args()
    observe() if args.command == "observe" else apply(args.plan.resolve(),args.authorization.resolve())

if __name__ == "__main__": main()
