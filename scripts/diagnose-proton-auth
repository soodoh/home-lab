#!/usr/bin/env python3
"""Run one transaction-bound, redacted Proton authentication diagnostic."""

from configparser import ConfigParser, Error as ConfigError
from datetime import datetime, timezone
import grp
import hashlib
import json
import io
import os
from pathlib import Path
import pwd
import re
import stat
import signal
import subprocess
import sys
import tempfile
import time


RCLONE = Path("/usr/local/bin/rclone")
RUNUSER = Path("/usr/sbin/runuser")
ENV = Path("/usr/bin/env")
FLOCK = Path("/usr/bin/flock")
INSTALL = Path("/usr/bin/install")
POLICY = Path("/etc/home-lab/restic-policy.json")
CONFIG = Path("/var/lib/restic-proton/rclone.conf")
CACHE = Path("/var/lib/restic-proton/cache")
MUTEX = Path("/run/lock/home-lab-backup.lock")
APPLY_LOCK = Path("/var/lib/iac-ansible-production.lock")
EVIDENCE_PARENT = Path("/var/lib/home-lab-restic")
RESULT = Path("/var/lib/restic-proton/proton-qualification-result.json")
HOST_EVIDENCE = EVIDENCE_PARENT / "proton-qualification.json"
INSTALLED_CIPHERTEXT = Path("/etc/home-lab/restic/production.sops.env")
REMOTE_DIRECTORY = "Backups/.home-lab-rclone-qualification"
STATIC_KEYS = {
    "type",
    "username",
    "password",
    "mailbox_password",
    "replace_existing_draft",
    "enable_caching",
    "original_file_size",
}
PASSWORD_ONLY_KEYS = STATIC_KEYS - {"mailbox_password"}
LEGACY_TOTP_KEY = "otp_secret_key"
CACHE_KEYS = {
    "client_uid",
    "client_access_token",
    "client_refresh_token",
    "client_salted_key_pass",
}
CATEGORIES = {
    "reachable",
    "api_captcha",
    "invalid_credentials",
    "two_factor_rejected",
    "account_key_incompatible",
    "rate_limited",
    "network_failure",
    "rclone_unclassified",
}


class DiagnosticError(RuntimeError):
    """A controlled local diagnostic failure."""


def digest_bytes(content: bytes) -> str:
    return hashlib.sha256(content).hexdigest()


def digest_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def fail(reason: str) -> None:
    if re.fullmatch(r"[a-z0-9_.-]+", reason) is None:
        reason = "invalid_failure_reason"
    raise DiagnosticError(reason)


def require_regular(path: Path, uid: int, gid: int, mode: int) -> os.stat_result:
    try:
        metadata = path.lstat()
    except OSError:
        fail(f"{path.name}_absent")
    if path.is_symlink() or not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
        fail(f"{path.name}_type")
    if metadata.st_uid != uid or metadata.st_gid != gid or stat.S_IMODE(metadata.st_mode) != mode:
        fail(f"{path.name}_metadata")
    return metadata


def require_directory(path: Path, uid: int, gid: int, mode: int) -> os.stat_result:
    try:
        metadata = path.lstat()
    except OSError:
        fail(f"{path.name}_absent")
    if path.is_symlink() or not stat.S_ISDIR(metadata.st_mode):
        fail(f"{path.name}_type")
    if metadata.st_uid != uid or metadata.st_gid != gid or stat.S_IMODE(metadata.st_mode) != mode:
        fail(f"{path.name}_metadata")
    return metadata


def load_policy(service_gid: int) -> dict[str, object]:
    require_regular(POLICY, 0, service_gid, 0o440)
    try:
        policy = json.loads(POLICY.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        fail("policy_invalid")
    if not isinstance(policy, dict):
        fail("policy_invalid")
    qualification = policy.get("qualification")
    credentials = policy.get("credentials")
    repositories = policy.get("repositories")
    if (
        policy.get("migration_state") != "inert"
        or not isinstance(qualification, dict)
        or qualification.get("state") != "ready"
        or qualification.get("remote_directory") != REMOTE_DIRECTORY
        or not isinstance(qualification.get("username_sha256"), str)
        or credentials != {"bootstrap_enabled": True, "state": "provisioned"}
        or not isinstance(repositories, dict)
        or any(not isinstance(value, dict) or value.get("id") is not None for value in repositories.values())
    ):
        fail("policy_state")
    return policy


def validate_lock(expected_transaction: str) -> bytes:
    require_directory(APPLY_LOCK, 0, 0, 0o700)
    try:
        entries = sorted(path.name for path in APPLY_LOCK.iterdir())
    except OSError:
        fail("apply_lock_contents")
    if entries != ["owner"]:
        fail("apply_lock_contents")
    owner = APPLY_LOCK / "owner"
    require_regular(owner, 0, 0, 0o600)
    try:
        content = owner.read_bytes()
        lines = content.decode("utf-8").splitlines()
    except (OSError, UnicodeDecodeError):
        fail("apply_lock_owner")
    if (
        lines.count("controller=ansible-deploy") != 1
        or lines.count("operation=proton-qualification") != 1
        or len([line for line in lines if re.fullmatch(r"started=[0-9]{4}-[0-9]{2}-[0-9]{2}T.*", line)]) != 1
        or len(lines) != 3
        or digest_bytes(content) != expected_transaction
    ):
        fail("apply_lock_owner")
    return content


def parser_from_config() -> ConfigParser:
    parser = ConfigParser(interpolation=None)
    try:
        with CONFIG.open(encoding="utf-8") as stream:
            parser.read_file(stream)
    except (OSError, UnicodeDecodeError, ConfigError):
        fail("rclone_config_invalid")
    return parser


def validate_config(
    service_uid: int,
    service_gid: int,
    username_sha256: str,
    allow_legacy_totp: bool = False,
) -> dict[str, str]:
    require_regular(CONFIG, service_uid, service_gid, 0o600)
    parser = parser_from_config()
    if parser.sections() != ["proton-backup"]:
        fail("rclone_config_identity")
    remote = parser["proton-backup"]
    keys = set(remote)
    required_static = STATIC_KEYS - {"mailbox_password"}
    allowed = STATIC_KEYS | CACHE_KEYS
    if allow_legacy_totp:
        allowed.add(LEGACY_TOTP_KEY)
    if not required_static <= keys or not keys <= allowed:
        fail("rclone_config_fields")
    if any(not value or "\x00" in value or "\n" in value for value in remote.values()):
        fail("rclone_config_values")
    if (
        remote.get("type") != "protondrive"
        or remote.get("replace_existing_draft") != "true"
        or remote.get("enable_caching") != "true"
        or remote.get("original_file_size") != "true"
        or digest_bytes(remote.get("username", "").encode()) != username_sha256
    ):
        fail("rclone_config_static_identity")
    cache_present = CACHE_KEYS & keys
    if cache_present and cache_present != CACHE_KEYS:
        fail("rclone_auth_cache_partial")
    static_keys = STATIC_KEYS | ({LEGACY_TOTP_KEY} if allow_legacy_totp else set())
    return {key: remote[key] for key in sorted(static_keys & keys)}


def classify(returncode: int, stderr: bytes) -> str:
    if returncode in {0, 3}:
        return "reachable"
    text = stderr.decode("utf-8", errors="replace")
    if re.search(r"Code=9001|complete CAPTCHA", text):
        return "api_captcha"
    if re.search(r"Code=8002|Incorrect login credentials", text):
        return "invalid_credentials"
    if re.search(r"two-factor|2fa|totp|one-time password", text, re.IGNORECASE):
        return "two_factor_rejected"
    if re.search(r"missing signature|wrong type|invalid data: user ID signature", text, re.IGNORECASE):
        return "account_key_incompatible"
    if re.search(r"Code=429|Status=429|Too Many Requests", text):
        return "rate_limited"
    if re.search(r"network is unreachable|connection refused|no such host|i/o timeout|TLS handshake timeout|x509:", text, re.IGNORECASE):
        return "network_failure"
    return "rclone_unclassified"


def parse_rotation_dotenv(raw: bytes) -> dict[str, str]:
    try:
        lines = raw.decode("utf-8").splitlines()
    except UnicodeDecodeError:
        fail("rotation_dotenv_encoding")
    values: dict[str, str] = {}
    wanted = {
        "RESTIC_LOCAL_PASSWORD",
        "RESTIC_PROTON_PASSWORD",
        "PROTON_BACKUP_USERNAME",
        "PROTON_BACKUP_PASSWORD",
        "PROTON_BACKUP_MAILBOX_PASSWORD",
    }
    for line in lines:
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        if key == "PROTON_BACKUP_TOTP_SEED":
            fail("proton_totp_seed_forbidden")
        if key in wanted:
            values[key] = value
    required = wanted - {"PROTON_BACKUP_MAILBOX_PASSWORD"}
    if not required <= values.keys() or any(not value or "\x00" in value or "\n" in value for value in values.values()):
        fail("rotation_dotenv_values")
    password = values["PROTON_BACKUP_PASSWORD"]
    if len(password.encode("utf-8")) < 40 or not password.isascii() or not password.isalnum():
        fail("proton_login_password_rotation_policy")
    if password in {values["RESTIC_LOCAL_PASSWORD"], values["RESTIC_PROTON_PASSWORD"]}:
        fail("proton_login_password_not_distinct")
    return values


def obscure(value: str) -> str:
    result = subprocess.run(
        [str(RCLONE), "obscure", "-"],
        check=False,
        input=(value + "\n").encode(),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=30,
        env=controlled_environment(),
    )
    if result.returncode != 0:
        fail(f"rclone_obscure_rc_{result.returncode}_stderr_sha256_{digest_bytes(result.stderr)}")
    try:
        obscured = result.stdout.decode("ascii").strip()
    except UnicodeDecodeError:
        fail("rclone_obscure_output")
    if not obscured or "\n" in obscured:
        fail("rclone_obscure_output")
    return obscured


def atomic_config(parser: ConfigParser, uid: int, gid: int) -> None:
    descriptor, temporary_name = tempfile.mkstemp(prefix=".rclone.conf.", dir=CONFIG.parent)
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, 0o600)
        os.fchown(descriptor, uid, gid)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            parser.write(stream)
            stream.flush()
            os.fsync(stream.fileno())
        temporary.replace(CONFIG)
        directory_descriptor = os.open(CONFIG.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_descriptor)
        finally:
            os.close(directory_descriptor)
    finally:
        if temporary.exists():
            temporary.unlink()
    require_regular(CONFIG, uid, gid, 0o600)


def atomic_json(path: Path, value: dict[str, object], replace: bool) -> str:
    content = (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
    if not replace:
        try:
            descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except FileExistsError:
            fail("prior_diagnostic_evidence")
        try:
            os.fchown(descriptor, 0, 0)
            with os.fdopen(descriptor, "wb") as stream:
                stream.write(content)
                stream.flush()
                os.fsync(stream.fileno())
        except BaseException:
            try:
                os.close(descriptor)
            except OSError:
                pass
            raise
    else:
        descriptor, temporary_name = tempfile.mkstemp(prefix=".proton-auth-diagnostic.", dir=path.parent)
        temporary = Path(temporary_name)
        try:
            os.fchmod(descriptor, 0o600)
            os.fchown(descriptor, 0, 0)
            with os.fdopen(descriptor, "wb") as stream:
                stream.write(content)
                stream.flush()
                os.fsync(stream.fileno())
            temporary.replace(path)
        finally:
            if temporary.exists():
                temporary.unlink()
    directory_descriptor = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory_descriptor)
    finally:
        os.close(directory_descriptor)
    require_regular(path, 0, 0, 0o600)
    return digest_bytes(content)


def controlled_environment() -> dict[str, str]:
    return {
        "HOME": "/var/lib/restic-proton",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "PATH": "/usr/local/bin:/usr/bin:/bin",
    }


def terminate_process_group(process: subprocess.Popen[bytes]) -> None:
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    deadline = time.monotonic() + 10
    while True:
        process.poll()
        try:
            os.killpg(process.pid, 0)
        except (ProcessLookupError, PermissionError):
            break
        if time.monotonic() >= deadline:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            break
        time.sleep(0.1)
    try:
        process.wait(timeout=10)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait(timeout=10)


def bounded_subprocess(
    command: list[str],
    timeout: int,
    environment: dict[str, str],
    input_data: bytes | None = None,
    inherit_stdin: bool = False,
) -> subprocess.CompletedProcess[bytes]:
    def interrupted(_signum: int, _frame: object) -> None:
        raise InterruptedError

    if input_data is not None and inherit_stdin:
        raise ValueError("input_data and inherit_stdin are mutually exclusive")
    previous_handlers = {
        signum: signal.getsignal(signum)
        for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM)
    }
    for signum in previous_handlers:
        signal.signal(signum, interrupted)
    process = subprocess.Popen(
        command,
        stdin=None if inherit_stdin else (subprocess.PIPE if input_data is not None else subprocess.DEVNULL),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=environment,
        start_new_session=True,
    )
    try:
        if inherit_stdin:
            stdout, stderr = process.communicate(timeout=timeout)
        else:
            stdout, stderr = process.communicate(input=input_data, timeout=timeout)
    except BaseException:
        terminate_process_group(process)
        raise
    finally:
        for signum, handler in previous_handlers.items():
            signal.signal(signum, handler)
    return subprocess.CompletedProcess(command, process.returncode, stdout, stderr)


def require_no_backup_processes() -> None:
    for process in ("restic", "rclone"):
        result = subprocess.run(
            ["/usr/bin/pgrep", "--exact", process],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=30,
            env=controlled_environment(),
        )
        if result.returncode != 1:
            fail("concurrent_backup_process")


def run_under_lock(expected_transaction: str, expected_script_sha256: str) -> None:
    if os.getuid() != 0 or os.getgid() != 0:
        fail("identity")
    service = pwd.getpwnam("restic-proton")
    service_group = grp.getgrnam("restic-proton")
    if service.pw_uid != 60000 or service.pw_gid != 60000 or service_group.gr_gid != 60000:
        fail("service_identity")
    if digest_file(Path(__file__)) != expected_script_sha256:
        fail("diagnostic_script_hash")
    require_regular(MUTEX, 0, service_group.gr_gid, 0o660)
    require_directory(EVIDENCE_PARENT, 0, 0, 0o750)
    require_directory(CONFIG.parent, service.pw_uid, service.pw_gid, 0o700)
    require_directory(CACHE, service.pw_uid, service.pw_gid, 0o700)
    require_regular(RCLONE, 0, 0, 0o755)
    require_regular(RUNUSER, 0, 0, 0o755)
    require_regular(ENV, 0, 0, 0o755)
    require_regular(INSTALL, 0, 0, 0o755)
    policy = load_policy(service_group.gr_gid)
    qualification = policy["qualification"]
    tools = policy.get("tools")
    if not isinstance(tools, dict) or not isinstance(tools.get("rclone"), dict):
        fail("tool_policy")
    rclone_policy = tools["rclone"]
    if digest_file(RCLONE) != rclone_policy.get("installed_sha256"):
        fail("rclone_hash")
    helper = Path("/usr/local/libexec/home-lab/qualify-proton-backup")
    require_regular(helper, 0, service_group.gr_gid, 0o750)
    if digest_file(helper) != qualification.get("helper_sha256"):
        fail("qualification_helper_hash")
    owner_content = validate_lock(expected_transaction)
    require_no_backup_processes()
    static_before = validate_config(service.pw_uid, service.pw_gid, qualification["username_sha256"])
    recovery_evidence = EVIDENCE_PARENT / f"proton-qualification-recovery-{expected_transaction}.json"
    evidence_path = EVIDENCE_PARENT / f"proton-auth-diagnostic-{expected_transaction}.json"
    for path in (RESULT, HOST_EVIDENCE, recovery_evidence, evidence_path):
        if path.exists() or path.is_symlink():
            fail("prior_transaction_evidence")
    started_at = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    marker = {
        "account_username_sha256": qualification["username_sha256"],
        "started_at": started_at,
        "state": "started",
        "transaction_sha256": expected_transaction,
        "version": 1,
    }
    atomic_json(evidence_path, marker, replace=False)
    launch_marker = CACHE / f".proton-auth-diagnostic-launch-{expected_transaction}"
    if launch_marker.exists() or launch_marker.is_symlink():
        fail("prior_launch_marker")
    marker_command = [
        str(RUNUSER),
        "--user",
        "restic-proton",
        "--",
        str(ENV),
        "-i",
        "HOME=/var/lib/restic-proton",
        "LANG=C.UTF-8",
        "LC_ALL=C.UTF-8",
        "PATH=/usr/local/bin:/usr/bin:/bin",
        str(INSTALL),
        "--mode",
        "0600",
        "/dev/null",
        str(launch_marker),
    ]
    marker_result = subprocess.run(
        marker_command,
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        timeout=30,
        env=controlled_environment(),
    )
    if marker_result.returncode != 0:
        fail(f"service_launch_marker_rc_{marker_result.returncode}_stderr_sha256_{digest_bytes(marker_result.stderr)}")
    require_regular(launch_marker, service.pw_uid, service.pw_gid, 0o600)
    command = [
        str(RUNUSER),
        "--user",
        "restic-proton",
        "--",
        str(ENV),
        "-i",
        "HOME=/var/lib/restic-proton",
        "LANG=C.UTF-8",
        "LC_ALL=C.UTF-8",
        "PATH=/usr/local/bin:/usr/bin:/bin",
        str(RCLONE),
        "--config",
        str(CONFIG),
        "--cache-dir",
        str(CACHE),
        "--log-level",
        "ERROR",
        "--stats",
        "0",
        "--retries",
        "1",
        "--low-level-retries",
        "1",
        "lsjson",
        f"proton-backup:{REMOTE_DIRECTORY}",
        "--max-depth",
        "1",
    ]
    try:
        result = subprocess.run(
            command,
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=600,
            env=controlled_environment(),
        )
    except subprocess.SubprocessError:
        fail("rclone_local_operation")
    if result.stderr.startswith(b"runuser:") or result.returncode in {126, 127}:
        fail("rclone_exec")
    launch_marker.unlink()
    cache_descriptor = os.open(CACHE, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(cache_descriptor)
    finally:
        os.close(cache_descriptor)
    category = classify(result.returncode, result.stderr)
    if category not in CATEGORIES:
        fail("diagnostic_category")
    static_after = validate_config(service.pw_uid, service.pw_gid, qualification["username_sha256"])
    if static_after != static_before:
        fail("rclone_config_static_drift")
    if validate_lock(expected_transaction) != owner_content:
        fail("apply_lock_owner_drift")
    evidence = {
        "account_username_sha256": qualification["username_sha256"],
        "category": category,
        "observed_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "operation": "lsjson",
        "remote_directory": REMOTE_DIRECTORY,
        "rclone_rc": result.returncode,
        "state": "observed",
        "stderr_sha256": digest_bytes(result.stderr),
        "stdout_sha256": digest_bytes(result.stdout),
        "transaction_sha256": expected_transaction,
        "version": 1,
    }
    evidence_sha256 = atomic_json(evidence_path, evidence, replace=True)
    if validate_lock(expected_transaction) != owner_content:
        fail("apply_lock_owner_drift")
    print(f"proton_auth_diagnostic=observed category={category} evidence_sha256={evidence_sha256}")


def load_auth_diagnostic_evidence(expected_transaction: str, expected_sha256: str) -> dict[str, object]:
    path = EVIDENCE_PARENT / f"proton-auth-diagnostic-{expected_transaction}.json"
    require_regular(path, 0, 0, 0o600)
    try:
        content = path.read_bytes()
        evidence = json.loads(content)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        fail("auth_diagnostic_evidence_invalid")
    expected_keys = {
        "account_username_sha256",
        "category",
        "observed_at",
        "operation",
        "remote_directory",
        "rclone_rc",
        "state",
        "stderr_sha256",
        "stdout_sha256",
        "transaction_sha256",
        "version",
    }
    if (
        not isinstance(evidence, dict)
        or set(evidence) != expected_keys
        or digest_bytes(content) != expected_sha256
        or evidence.get("transaction_sha256") != expected_transaction
        or evidence.get("state") != "observed"
        or evidence.get("operation") != "lsjson"
        or evidence.get("remote_directory") != REMOTE_DIRECTORY
        or evidence.get("category") == "reachable"
    ):
        fail("auth_diagnostic_evidence_invalid")
    return evidence


def load_credential_rotation_evidence(
    expected_transaction: str,
    expected_auth_sha256: str,
    expected_sha256: str,
) -> dict[str, object]:
    path = EVIDENCE_PARENT / f"proton-credential-rotation-{expected_transaction}.json"
    require_regular(path, 0, 0, 0o600)
    try:
        content = path.read_bytes()
        evidence = json.loads(content)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        fail("credential_rotation_evidence_invalid")
    expected_keys = {
        "account_username_sha256",
        "auth_diagnostic_evidence_sha256",
        "cache_invalidation",
        "password_rotation",
        "rotated_at",
        "state",
        "transaction_sha256",
        "version",
    }
    if (
        not isinstance(evidence, dict)
        or set(evidence) != expected_keys
        or digest_bytes(content) != expected_sha256
        or evidence.get("auth_diagnostic_evidence_sha256") != expected_auth_sha256
        or evidence.get("cache_invalidation") != "pass"
        or evidence.get("password_rotation") != "pass"
        or evidence.get("state") != "rotated"
        or evidence.get("transaction_sha256") != expected_transaction
        or evidence.get("version") != 1
    ):
        fail("credential_rotation_evidence_invalid")
    return evidence


def run_password_only_transition_under_lock(
    expected_transaction: str,
    expected_script_sha256: str,
    expected_auth_evidence_sha256: str,
    expected_rotation_evidence_sha256: str,
) -> None:
    if os.getuid() != 0 or os.getgid() != 0:
        fail("identity")
    service = pwd.getpwnam("restic-proton")
    service_group = grp.getgrnam("restic-proton")
    if service.pw_uid != 60000 or service.pw_gid != 60000 or service_group.gr_gid != 60000:
        fail("service_identity")
    if digest_file(Path(__file__)) != expected_script_sha256:
        fail("diagnostic_script_hash")
    require_regular(MUTEX, 0, service_group.gr_gid, 0o660)
    require_directory(EVIDENCE_PARENT, 0, 0, 0o750)
    require_directory(CONFIG.parent, service.pw_uid, service.pw_gid, 0o700)
    owner_content = validate_lock(expected_transaction)
    require_no_backup_processes()
    policy = load_policy(service_group.gr_gid)
    qualification = policy["qualification"]
    auth_evidence = load_auth_diagnostic_evidence(expected_transaction, expected_auth_evidence_sha256)
    rotation_evidence = load_credential_rotation_evidence(
        expected_transaction,
        expected_auth_evidence_sha256,
        expected_rotation_evidence_sha256,
    )
    if (
        auth_evidence.get("account_username_sha256") != qualification.get("username_sha256")
        or rotation_evidence.get("account_username_sha256") != qualification.get("username_sha256")
    ):
        fail("password_only_account_identity")
    recovery_evidence = EVIDENCE_PARENT / f"proton-qualification-recovery-{expected_transaction}.json"
    for path in (RESULT, HOST_EVIDENCE, recovery_evidence):
        if path.exists() or path.is_symlink():
            fail("prior_transaction_evidence")
    transition_path = EVIDENCE_PARENT / f"proton-password-only-transition-{expected_transaction}.json"
    marker_keys = {
        "account_username_sha256",
        "auth_diagnostic_evidence_sha256",
        "credential_rotation_evidence_sha256",
        "started_at",
        "state",
        "transaction_sha256",
        "version",
    }
    resuming = transition_path.exists() or transition_path.is_symlink()
    if not resuming:
        validate_config(
            service.pw_uid,
            service.pw_gid,
            qualification["username_sha256"],
            allow_legacy_totp=True,
        )
        initial_keys = set(parser_from_config()["proton-backup"])
        if CACHE_KEYS & initial_keys:
            fail("password_only_auth_cache_present")
        if LEGACY_TOTP_KEY not in initial_keys:
            fail("password_only_legacy_field_absent")
    if resuming:
        require_regular(transition_path, 0, 0, 0o600)
        try:
            marker = json.loads(transition_path.read_bytes())
        except (OSError, UnicodeDecodeError, json.JSONDecodeError):
            fail("password_only_transition_evidence_invalid")
        if (
            not isinstance(marker, dict)
            or set(marker) != marker_keys
            or marker.get("account_username_sha256") != qualification.get("username_sha256")
            or marker.get("auth_diagnostic_evidence_sha256") != expected_auth_evidence_sha256
            or marker.get("credential_rotation_evidence_sha256") != expected_rotation_evidence_sha256
            or marker.get("state") != "started"
            or marker.get("transaction_sha256") != expected_transaction
            or marker.get("version") != 1
        ):
            fail("password_only_transition_evidence_invalid")
    else:
        marker = {
            "account_username_sha256": qualification["username_sha256"],
            "auth_diagnostic_evidence_sha256": expected_auth_evidence_sha256,
            "credential_rotation_evidence_sha256": expected_rotation_evidence_sha256,
            "started_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "state": "started",
            "transaction_sha256": expected_transaction,
            "version": 1,
        }
        atomic_json(transition_path, marker, replace=False)
    parser = parser_from_config()
    keys_before = set(parser["proton-backup"])
    cache_present = CACHE_KEYS & keys_before
    if cache_present:
        fail("password_only_auth_cache_present")
    if LEGACY_TOTP_KEY in keys_before:
        static_before = validate_config(
            service.pw_uid,
            service.pw_gid,
            qualification["username_sha256"],
            allow_legacy_totp=True,
        )
        parser.remove_option("proton-backup", LEGACY_TOTP_KEY)
        atomic_config(parser, service.pw_uid, service.pw_gid)
        expected_static_after = {key: value for key, value in static_before.items() if key != LEGACY_TOTP_KEY}
    else:
        expected_static_after = validate_config(service.pw_uid, service.pw_gid, qualification["username_sha256"])
    static_after = validate_config(service.pw_uid, service.pw_gid, qualification["username_sha256"])
    if static_after != expected_static_after or LEGACY_TOTP_KEY in parser_from_config()["proton-backup"]:
        fail("password_only_static_config_drift")
    if CACHE_KEYS & set(parser_from_config()["proton-backup"]):
        fail("password_only_auth_cache_present")
    if validate_lock(expected_transaction) != owner_content:
        fail("apply_lock_owner_drift")
    evidence = {
        "account_username_sha256": qualification["username_sha256"],
        "auth_diagnostic_evidence_sha256": expected_auth_evidence_sha256,
        "cache_state": "absent",
        "credential_rotation_evidence_sha256": expected_rotation_evidence_sha256,
        "provider_requests": 0,
        "removed_field": LEGACY_TOTP_KEY,
        "state": "password-only",
        "transaction_sha256": expected_transaction,
        "transitioned_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "version": 1,
    }
    evidence_sha256 = atomic_json(transition_path, evidence, replace=True)
    if validate_lock(expected_transaction) != owner_content:
        fail("apply_lock_owner_drift")
    print(f"proton_password_only_transition=passed evidence_sha256={evidence_sha256}")


def supervise_password_only_transition(
    expected_transaction: str,
    expected_script_sha256: str,
    expected_auth_evidence_sha256: str,
    expected_rotation_evidence_sha256: str,
) -> None:
    if os.getuid() != 0 or os.getgid() != 0:
        fail("identity")
    if digest_file(Path(__file__)) != expected_script_sha256:
        fail("diagnostic_script_hash")
    service_gid = grp.getgrnam("restic-proton").gr_gid
    require_regular(MUTEX, 0, service_gid, 0o660)
    command = [
        str(FLOCK),
        "--exclusive",
        "--nonblock",
        "--conflict-exit-code",
        "75",
        "--",
        str(MUTEX),
        "/usr/bin/python3",
        str(Path(__file__)),
        "password-only-under-lock",
        expected_transaction,
        expected_script_sha256,
        expected_auth_evidence_sha256,
        expected_rotation_evidence_sha256,
    ]
    result = subprocess.run(
        command,
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=120,
        env=controlled_environment(),
    )
    if result.returncode == 75:
        fail("backup_mutex_busy")
    if result.returncode != 0:
        controlled = re.fullmatch(rb"proton_auth_diagnostic=failed reason=([a-z0-9_.-]+)\n?", result.stderr)
        if controlled is not None:
            fail(controlled.group(1).decode("ascii"))
        fail(f"password_only_subprocess_rc_{result.returncode}_stderr_sha256_{digest_bytes(result.stderr)}")
    try:
        output = result.stdout.decode("ascii").strip()
    except UnicodeDecodeError:
        fail("password_only_output")
    if re.fullmatch(r"proton_password_only_transition=passed evidence_sha256=[0-9a-f]{64}", output) is None:
        fail("password_only_output")
    print(output)


def load_exact_json(path: Path, expected_sha256: str, expected_keys: set[str], reason: str) -> dict[str, object]:
    require_regular(path, 0, 0, 0o600)
    try:
        content = path.read_bytes()
        evidence = json.loads(content)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        fail(reason)
    if not isinstance(evidence, dict) or set(evidence) != expected_keys or digest_bytes(content) != expected_sha256:
        fail(reason)
    return evidence


def load_password_only_evidence(
    expected_transaction: str,
    expected_transition_sha256: str,
    expected_deployment_sha256: str,
    username_sha256: str,
) -> tuple[dict[str, object], dict[str, object]]:
    transition = load_exact_json(
        EVIDENCE_PARENT / f"proton-password-only-transition-{expected_transaction}.json",
        expected_transition_sha256,
        {
            "account_username_sha256",
            "auth_diagnostic_evidence_sha256",
            "cache_state",
            "credential_rotation_evidence_sha256",
            "provider_requests",
            "removed_field",
            "state",
            "transaction_sha256",
            "transitioned_at",
            "version",
        },
        "password_only_transition_evidence_invalid",
    )
    if (
        transition.get("account_username_sha256") != username_sha256
        or transition.get("cache_state") != "absent"
        or transition.get("provider_requests") != 0
        or transition.get("removed_field") != LEGACY_TOTP_KEY
        or transition.get("state") != "password-only"
        or transition.get("transaction_sha256") != expected_transaction
        or transition.get("version") != 1
    ):
        fail("password_only_transition_evidence_invalid")
    deployment = load_exact_json(
        EVIDENCE_PARENT / f"proton-password-only-deployment-{expected_transaction}.json",
        expected_deployment_sha256,
        {
            "account_username_sha256",
            "bootstrap_helper_sha256",
            "ciphertext_sha256",
            "credential_materialization",
            "deployed_at",
            "policy_sha256",
            "provider_requests",
            "qualification_helper_sha256",
            "state",
            "transaction_sha256",
            "transition_evidence_sha256",
            "version",
        },
        "password_only_deployment_evidence_invalid",
    )
    if (
        deployment.get("account_username_sha256") != username_sha256
        or deployment.get("credential_materialization") != "noop"
        or deployment.get("provider_requests") != 0
        or deployment.get("state") != "deployed"
        or deployment.get("transaction_sha256") != expected_transaction
        or deployment.get("transition_evidence_sha256") != expected_transition_sha256
        or deployment.get("version") != 1
    ):
        fail("password_only_deployment_evidence_invalid")
    return transition, deployment


def run_beta_under_lock(
    expected_transaction: str,
    expected_script_sha256: str,
    beta_path: Path,
    expected_beta_sha256: str,
    expected_beta_version: str,
    expected_transition_sha256: str,
    expected_deployment_sha256: str,
) -> None:
    if os.getuid() != 0 or os.getgid() != 0:
        fail("identity")
    service = pwd.getpwnam("restic-proton")
    service_group = grp.getgrnam("restic-proton")
    if service.pw_uid != 60000 or service.pw_gid != 60000 or service_group.gr_gid != 60000:
        fail("service_identity")
    if digest_file(Path(__file__)) != expected_script_sha256:
        fail("diagnostic_script_hash")
    require_regular(MUTEX, 0, service_group.gr_gid, 0o660)
    require_directory(EVIDENCE_PARENT, 0, 0, 0o750)
    require_directory(CONFIG.parent, service.pw_uid, service.pw_gid, 0o700)
    require_directory(CACHE, service.pw_uid, service.pw_gid, 0o700)
    require_regular(beta_path, 0, service_group.gr_gid, 0o750)
    if digest_file(beta_path) != expected_beta_sha256:
        fail("beta_rclone_hash")
    policy = load_policy(service_group.gr_gid)
    qualification = policy["qualification"]
    proton = policy.get("proton")
    tools = policy.get("tools")
    if (
        not isinstance(proton, dict)
        or proton.get("authentication_mode") != "password-only"
        or not isinstance(tools, dict)
        or not isinstance(tools.get("rclone"), dict)
        or digest_file(RCLONE) != tools["rclone"].get("installed_sha256")
    ):
        fail("beta_policy")
    owner_content = validate_lock(expected_transaction)
    require_no_backup_processes()
    load_password_only_evidence(
        expected_transaction,
        expected_transition_sha256,
        expected_deployment_sha256,
        qualification["username_sha256"],
    )
    static_config = validate_config(service.pw_uid, service.pw_gid, qualification["username_sha256"])
    installed_parser = parser_from_config()
    installed_remote = installed_parser["proton-backup"]
    if (
        "mailbox_password" in static_config
        or CACHE_KEYS & set(installed_remote)
        or set(static_config) != STATIC_KEYS - {"mailbox_password"}
    ):
        fail("beta_config_state")
    config_before = CONFIG.read_bytes()
    version_result = subprocess.run(
        [
            str(RUNUSER),
            "--preserve-environment",
            "--user",
            "restic-proton",
            "--",
            str(beta_path),
            "version",
        ],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=30,
        env=controlled_environment(),
    )
    if version_result.returncode != 0:
        fail(f"beta_version_rc_{version_result.returncode}_stderr_sha256_{digest_bytes(version_result.stderr)}")
    try:
        first_line = version_result.stdout.decode("utf-8").splitlines()[0]
    except (UnicodeDecodeError, IndexError):
        fail("beta_version_output")
    if first_line != f"rclone v{expected_beta_version}":
        fail("beta_version_output")
    recovery_evidence = EVIDENCE_PARENT / f"proton-qualification-recovery-{expected_transaction}.json"
    evidence_path = EVIDENCE_PARENT / f"proton-beta-diagnostic-{expected_transaction}.json"
    for path in (RESULT, HOST_EVIDENCE, recovery_evidence, evidence_path):
        if path.exists() or path.is_symlink():
            fail("prior_beta_transaction_evidence")
    started_at = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    marker = {
        "account_username_sha256": qualification["username_sha256"],
        "beta_binary_sha256": expected_beta_sha256,
        "beta_version": expected_beta_version,
        "started_at": started_at,
        "state": "started",
        "transaction_sha256": expected_transaction,
        "version": 1,
    }
    atomic_json(evidence_path, marker, replace=False)
    launch_marker = CACHE / f".proton-beta-diagnostic-launch-{expected_transaction}"
    if launch_marker.exists() or launch_marker.is_symlink():
        fail("prior_beta_launch_marker")
    marker_result = subprocess.run(
        [
            str(RUNUSER),
            "--user",
            "restic-proton",
            "--",
            str(INSTALL),
            "--mode",
            "0600",
            "/dev/null",
            str(launch_marker),
        ],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        timeout=30,
        env=controlled_environment(),
    )
    if marker_result.returncode != 0:
        fail(f"beta_launch_marker_rc_{marker_result.returncode}_stderr_sha256_{digest_bytes(marker_result.stderr)}")
    require_regular(launch_marker, service.pw_uid, service.pw_gid, 0o600)
    beta_environment = controlled_environment()
    beta_environment.update(
        {
            "RCLONE_CONFIG_PROTON_BACKUP_TYPE": "protondrive",
            "RCLONE_CONFIG_PROTON_BACKUP_USERNAME": installed_remote["username"],
            "RCLONE_CONFIG_PROTON_BACKUP_PASSWORD": installed_remote["password"],
            "RCLONE_CONFIG_PROTON_BACKUP_REPLACE_EXISTING_DRAFT": "true",
            "RCLONE_CONFIG_PROTON_BACKUP_ENABLE_CACHING": "false",
            "RCLONE_CONFIG_PROTON_BACKUP_ORIGINAL_FILE_SIZE": "true",
        }
    )
    command = [
        str(RUNUSER),
        "--preserve-environment",
        "--user",
        "restic-proton",
        "--",
        str(beta_path),
        "--config",
        "/dev/null",
        "--cache-dir",
        str(CACHE),
        "--log-level",
        "ERROR",
        "--stats",
        "0",
        "--retries",
        "1",
        "--low-level-retries",
        "1",
        "--protondrive-enable-caching=false",
        "lsjson",
        f"proton-backup:{REMOTE_DIRECTORY}",
        "--max-depth",
        "1",
    ]
    try:
        result = bounded_subprocess(command, 600, beta_environment)
    except subprocess.SubprocessError:
        fail("beta_rclone_local_operation")
    if result.stderr.startswith(b"runuser:") or result.returncode in {126, 127}:
        fail("beta_rclone_exec")
    launch_marker.unlink()
    cache_descriptor = os.open(CACHE, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(cache_descriptor)
    finally:
        os.close(cache_descriptor)
    category = classify(result.returncode, result.stderr)
    if category not in CATEGORIES:
        fail("beta_diagnostic_category")
    if (
        CONFIG.read_bytes() != config_before
        or digest_file(RCLONE) != tools["rclone"].get("installed_sha256")
    ):
        fail("beta_installed_artifact_drift")
    if validate_lock(expected_transaction) != owner_content:
        fail("apply_lock_owner_drift")
    evidence = {
        "account_username_sha256": qualification["username_sha256"],
        "beta_binary_sha256": expected_beta_sha256,
        "beta_version": expected_beta_version,
        "category": category,
        "config_source": "environment-only",
        "credential_cache": "disabled",
        "observed_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "operation": "lsjson",
        "provider_requests": 1,
        "remote_directory": REMOTE_DIRECTORY,
        "rclone_rc": result.returncode,
        "stable_rclone_unchanged": "pass",
        "state": "observed",
        "stderr_sha256": digest_bytes(result.stderr),
        "stdout_sha256": digest_bytes(result.stdout),
        "transaction_sha256": expected_transaction,
        "version": 1,
    }
    evidence_sha256 = atomic_json(evidence_path, evidence, replace=True)
    if validate_lock(expected_transaction) != owner_content:
        fail("apply_lock_owner_drift")
    print(f"proton_beta_diagnostic=observed category={category} evidence_sha256={evidence_sha256}")


def supervise_beta(
    expected_transaction: str,
    expected_script_sha256: str,
    beta_path: Path,
    expected_beta_sha256: str,
    expected_beta_version: str,
    expected_transition_sha256: str,
    expected_deployment_sha256: str,
) -> None:
    if os.getuid() != 0 or os.getgid() != 0:
        fail("identity")
    if digest_file(Path(__file__)) != expected_script_sha256:
        fail("diagnostic_script_hash")
    service_gid = grp.getgrnam("restic-proton").gr_gid
    require_regular(MUTEX, 0, service_gid, 0o660)
    command = [
        str(FLOCK),
        "--exclusive",
        "--nonblock",
        "--conflict-exit-code",
        "75",
        "--",
        str(MUTEX),
        "/usr/bin/python3",
        str(Path(__file__)),
        "beta-under-lock",
        expected_transaction,
        expected_script_sha256,
        str(beta_path),
        expected_beta_sha256,
        expected_beta_version,
        expected_transition_sha256,
        expected_deployment_sha256,
    ]
    result = bounded_subprocess(command, 660, controlled_environment())
    if result.returncode == 75:
        fail("backup_mutex_busy")
    if result.returncode != 0:
        controlled = re.fullmatch(rb"proton_auth_diagnostic=failed reason=([a-z0-9_.-]+)\n?", result.stderr)
        if controlled is not None:
            fail(controlled.group(1).decode("ascii"))
        fail(f"beta_subprocess_rc_{result.returncode}_stderr_sha256_{digest_bytes(result.stderr)}")
    try:
        output = result.stdout.decode("ascii").strip()
    except UnicodeDecodeError:
        fail("beta_output")
    if re.fullmatch(r"proton_beta_diagnostic=observed category=[a-z_]+ evidence_sha256=[0-9a-f]{64}", output) is None:
        fail("beta_output")
    print(output)


def run_rotation_under_lock(
    expected_transaction: str,
    expected_script_sha256: str,
    expected_auth_evidence_sha256: str,
    raw_dotenv: bytes,
) -> None:
    if os.getuid() != 0 or os.getgid() != 0:
        fail("identity")
    service = pwd.getpwnam("restic-proton")
    service_group = grp.getgrnam("restic-proton")
    if service.pw_uid != 60000 or service.pw_gid != 60000 or service_group.gr_gid != 60000:
        fail("service_identity")
    if digest_file(Path(__file__)) != expected_script_sha256:
        fail("diagnostic_script_hash")
    require_regular(MUTEX, 0, service_group.gr_gid, 0o660)
    require_directory(EVIDENCE_PARENT, 0, 0, 0o750)
    require_directory(CONFIG.parent, service.pw_uid, service.pw_gid, 0o700)
    require_regular(RCLONE, 0, 0, 0o755)
    policy = load_policy(service_group.gr_gid)
    qualification = policy["qualification"]
    tools = policy.get("tools")
    if not isinstance(tools, dict) or not isinstance(tools.get("rclone"), dict):
        fail("tool_policy")
    if digest_file(RCLONE) != tools["rclone"].get("installed_sha256"):
        fail("rclone_hash")
    owner_content = validate_lock(expected_transaction)
    require_no_backup_processes()
    auth_evidence = load_auth_diagnostic_evidence(expected_transaction, expected_auth_evidence_sha256)
    if auth_evidence.get("account_username_sha256") != qualification.get("username_sha256"):
        fail("auth_diagnostic_account_identity")
    values = parse_rotation_dotenv(raw_dotenv)
    if digest_bytes(values["PROTON_BACKUP_USERNAME"].encode()) != qualification.get("username_sha256"):
        fail("rotation_account_identity")
    static_before = validate_config(service.pw_uid, service.pw_gid, qualification["username_sha256"])
    if ("mailbox_password" in static_before) != ("PROTON_BACKUP_MAILBOX_PASSWORD" in values):
        fail("rotation_mailbox_mode")
    new_obscured_password = obscure(values["PROTON_BACKUP_PASSWORD"])
    rotation_evidence_path = EVIDENCE_PARENT / f"proton-credential-rotation-{expected_transaction}.json"
    if rotation_evidence_path.exists() or rotation_evidence_path.is_symlink():
        fail("prior_rotation_evidence")
    marker = {
        "account_username_sha256": qualification["username_sha256"],
        "auth_diagnostic_evidence_sha256": expected_auth_evidence_sha256,
        "started_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "state": "started",
        "transaction_sha256": expected_transaction,
        "version": 1,
    }
    atomic_json(rotation_evidence_path, marker, replace=False)
    parser = parser_from_config()
    remote = parser["proton-backup"]
    remote["password"] = new_obscured_password
    for key in CACHE_KEYS:
        remote.pop(key, None)
    atomic_config(parser, service.pw_uid, service.pw_gid)
    static_after = validate_config(service.pw_uid, service.pw_gid, qualification["username_sha256"])
    for key, value in static_before.items():
        if key != "password" and static_after.get(key) != value:
            fail("rotation_static_config_drift")
    if static_after.get("password") != new_obscured_password:
        fail("rotation_password_update")
    if CACHE_KEYS & set(parser_from_config()["proton-backup"]):
        fail("rotation_cache_invalidation")
    if validate_lock(expected_transaction) != owner_content:
        fail("apply_lock_owner_drift")
    evidence = {
        "account_username_sha256": qualification["username_sha256"],
        "auth_diagnostic_evidence_sha256": expected_auth_evidence_sha256,
        "cache_invalidation": "pass",
        "password_rotation": "pass",
        "rotated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "state": "rotated",
        "transaction_sha256": expected_transaction,
        "version": 1,
    }
    evidence_sha256 = atomic_json(rotation_evidence_path, evidence, replace=True)
    if validate_lock(expected_transaction) != owner_content:
        fail("apply_lock_owner_drift")
    print(f"proton_credential_rotation=passed evidence_sha256={evidence_sha256}")


def supervise_rotation(
    expected_transaction: str,
    expected_script_sha256: str,
    expected_auth_evidence_sha256: str,
    raw_dotenv: bytes,
) -> None:
    if os.getuid() != 0 or os.getgid() != 0:
        fail("identity")
    if len(raw_dotenv) == 0 or len(raw_dotenv) > 1024 * 1024:
        fail("rotation_dotenv_size")
    if digest_file(Path(__file__)) != expected_script_sha256:
        fail("diagnostic_script_hash")
    service_gid = grp.getgrnam("restic-proton").gr_gid
    require_regular(MUTEX, 0, service_gid, 0o660)
    command = [
        str(FLOCK),
        "--exclusive",
        "--nonblock",
        "--conflict-exit-code",
        "75",
        "--",
        str(MUTEX),
        "/usr/bin/python3",
        str(Path(__file__)),
        "rotate-under-lock",
        expected_transaction,
        expected_script_sha256,
        expected_auth_evidence_sha256,
    ]
    result = subprocess.run(
        command,
        check=False,
        input=raw_dotenv,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=120,
        env=controlled_environment(),
    )
    if result.returncode == 75:
        fail("backup_mutex_busy")
    if result.returncode != 0:
        controlled = re.fullmatch(rb"proton_auth_diagnostic=failed reason=([a-z0-9_.-]+)\n?", result.stderr)
        if controlled is not None:
            fail(controlled.group(1).decode("ascii"))
        fail(f"rotation_subprocess_rc_{result.returncode}_stderr_sha256_{digest_bytes(result.stderr)}")
    try:
        output = result.stdout.decode("ascii").strip()
    except UnicodeDecodeError:
        fail("rotation_output")
    if re.fullmatch(r"proton_credential_rotation=passed evidence_sha256=[0-9a-f]{64}", output) is None:
        fail("rotation_output")
    print(output)


def parse_exact_dotenv(raw: bytes, reason: str) -> dict[str, str]:
    if not raw or len(raw) > 1024 * 1024 or b"\x00" in raw:
        fail(reason)
    try:
        lines = raw.decode("utf-8").splitlines()
    except UnicodeDecodeError:
        fail(reason)
    values: dict[str, str] = {}
    for line in lines:
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            fail(reason)
        key, value = line.split("=", 1)
        if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key) is None or key in values:
            fail(reason)
        if not value or "\x00" in value or "\n" in value:
            fail(reason)
        values[key] = value
    if not values:
        fail(reason)
    return values


def parse_account_reset_payload(raw: bytes) -> tuple[dict[str, str], dict[str, str]]:
    if len(raw) > 2 * 1024 * 1024 or raw.count(b"\x00") != 1:
        fail("account_reset_dotenv_framing")
    old_raw, new_raw = raw.split(b"\x00", 1)
    old_values = parse_exact_dotenv(old_raw, "account_reset_old_dotenv")
    new_values = parse_exact_dotenv(new_raw, "account_reset_new_dotenv")
    if set(old_values) != set(new_values):
        fail("account_reset_dotenv_keys")
    changed = {key for key in old_values if old_values[key] != new_values[key]}
    if changed != {"PROTON_BACKUP_PASSWORD"}:
        fail("account_reset_dotenv_delta")
    required = {
        "RESTIC_LOCAL_PASSWORD",
        "RESTIC_PROTON_PASSWORD",
        "PROTON_BACKUP_USERNAME",
        "PROTON_BACKUP_PASSWORD",
    }
    if not required <= new_values.keys():
        fail("account_reset_dotenv_values")
    if "PROTON_BACKUP_TOTP_SEED" in new_values or "PROTON_BACKUP_MAILBOX_PASSWORD" in new_values:
        fail("account_reset_authentication_mode")
    password = new_values["PROTON_BACKUP_PASSWORD"]
    if len(password.encode("utf-8")) < 40 or not password.isascii() or not password.isalnum():
        fail("account_reset_password_policy")
    if password in {new_values["RESTIC_LOCAL_PASSWORD"], new_values["RESTIC_PROTON_PASSWORD"]}:
        fail("account_reset_password_not_distinct")
    return old_values, new_values


def config_content(parser: ConfigParser) -> bytes:
    stream = io.StringIO()
    parser.write(stream)
    return stream.getvalue().encode("utf-8")


def require_empty_cache(service_uid: int, service_gid: int) -> None:
    require_directory(CACHE, service_uid, service_gid, 0o700)
    try:
        entries = list(CACHE.iterdir())
    except OSError:
        fail("account_reset_cache_state")
    if entries:
        fail("account_reset_cache_state")


def load_beta_evidence(
    expected_transaction: str,
    expected_sha256: str,
    expected_binary_sha256: str,
    expected_version: str,
    username_sha256: str,
) -> dict[str, object]:
    evidence = load_exact_json(
        EVIDENCE_PARENT / f"proton-beta-diagnostic-{expected_transaction}.json",
        expected_sha256,
        {
            "account_username_sha256",
            "beta_binary_sha256",
            "beta_version",
            "category",
            "config_source",
            "credential_cache",
            "observed_at",
            "operation",
            "provider_requests",
            "remote_directory",
            "rclone_rc",
            "stable_rclone_unchanged",
            "state",
            "stderr_sha256",
            "stdout_sha256",
            "transaction_sha256",
            "version",
        },
        "beta_evidence_invalid",
    )
    if (
        evidence.get("account_username_sha256") != username_sha256
        or evidence.get("beta_binary_sha256") != expected_binary_sha256
        or evidence.get("beta_version") != expected_version
        or evidence.get("category") == "reachable"
        or evidence.get("config_source") != "environment-only"
        or evidence.get("credential_cache") != "disabled"
        or evidence.get("operation") != "lsjson"
        or evidence.get("provider_requests") != 1
        or evidence.get("remote_directory") != REMOTE_DIRECTORY
        or evidence.get("stable_rclone_unchanged") != "pass"
        or evidence.get("state") != "observed"
        or evidence.get("transaction_sha256") != expected_transaction
        or evidence.get("version") != 1
    ):
        fail("beta_evidence_invalid")
    return evidence


def run_account_reset_under_lock(
    expected_transaction: str,
    expected_script_sha256: str,
    target_ciphertext: Path,
    expected_target_ciphertext_sha256: str,
    expected_prior_config_sha256: str,
    expected_auth_evidence_sha256: str,
    expected_rotation_evidence_sha256: str,
    expected_transition_evidence_sha256: str,
    expected_deployment_evidence_sha256: str,
    expected_beta_evidence_sha256: str,
    expected_beta_binary_sha256: str,
    expected_beta_version: str,
    raw_payload: bytes,
) -> None:
    if os.getuid() != 0 or os.getgid() != 0:
        fail("identity")
    service = pwd.getpwnam("restic-proton")
    service_group = grp.getgrnam("restic-proton")
    if service.pw_uid != 60000 or service.pw_gid != 60000 or service_group.gr_gid != 60000:
        fail("service_identity")
    if digest_file(Path(__file__)) != expected_script_sha256:
        fail("diagnostic_script_hash")
    require_regular(MUTEX, 0, service_group.gr_gid, 0o660)
    require_directory(EVIDENCE_PARENT, 0, 0, 0o750)
    require_directory(CONFIG.parent, service.pw_uid, service.pw_gid, 0o700)
    require_regular(RCLONE, 0, 0, 0o755)
    require_regular(INSTALLED_CIPHERTEXT, 0, 0, 0o400)
    require_regular(target_ciphertext, 0, 0, 0o600)
    if digest_file(target_ciphertext) != expected_target_ciphertext_sha256:
        fail("account_reset_target_ciphertext_hash")
    owner_content = validate_lock(expected_transaction)
    require_no_backup_processes()
    require_empty_cache(service.pw_uid, service.pw_gid)
    policy = load_policy(service_group.gr_gid)
    qualification = policy["qualification"]
    proton = policy.get("proton")
    tools = policy.get("tools")
    if (
        not isinstance(proton, dict)
        or proton.get("authentication_mode") != "password-only"
        or not isinstance(tools, dict)
        or not isinstance(tools.get("rclone"), dict)
        or digest_file(RCLONE) != tools["rclone"].get("installed_sha256")
    ):
        fail("account_reset_policy")
    old_values, new_values = parse_account_reset_payload(raw_payload)
    username_sha256 = qualification.get("username_sha256")
    if (
        not isinstance(username_sha256, str)
        or digest_bytes(new_values["PROTON_BACKUP_USERNAME"].encode()) != username_sha256
    ):
        fail("account_reset_account_identity")
    auth = load_auth_diagnostic_evidence(expected_transaction, expected_auth_evidence_sha256)
    rotation = load_credential_rotation_evidence(
        expected_transaction,
        expected_auth_evidence_sha256,
        expected_rotation_evidence_sha256,
    )
    transition, deployment = load_password_only_evidence(
        expected_transaction,
        expected_transition_evidence_sha256,
        expected_deployment_evidence_sha256,
        username_sha256,
    )
    load_beta_evidence(
        expected_transaction,
        expected_beta_evidence_sha256,
        expected_beta_binary_sha256,
        expected_beta_version,
        username_sha256,
    )
    prior_ciphertext_sha256 = digest_file(INSTALLED_CIPHERTEXT)
    if (
        auth.get("account_username_sha256") != username_sha256
        or rotation.get("account_username_sha256") != username_sha256
        or transition.get("auth_diagnostic_evidence_sha256") != expected_auth_evidence_sha256
        or transition.get("credential_rotation_evidence_sha256") != expected_rotation_evidence_sha256
        or deployment.get("transition_evidence_sha256") != expected_transition_evidence_sha256
        or deployment.get("ciphertext_sha256") != prior_ciphertext_sha256
    ):
        fail("account_reset_evidence_chain")
    static_config = validate_config(service.pw_uid, service.pw_gid, username_sha256)
    installed_parser = parser_from_config()
    if (
        set(static_config) != PASSWORD_ONLY_KEYS
        or set(installed_parser["proton-backup"]) != PASSWORD_ONLY_KEYS
        or CACHE_KEYS & set(installed_parser["proton-backup"])
    ):
        fail("account_reset_config_state")
    current_config_sha256 = digest_file(CONFIG)
    evidence_path = EVIDENCE_PARENT / f"proton-account-reset-reconciliation-{expected_transaction}.json"
    attestation = "disposable-account-reset-without-data-recovery"
    claim_keys = {
        "account_username_sha256",
        "account_reset_attestation",
        "auth_diagnostic_evidence_sha256",
        "beta_evidence_sha256",
        "credential_rotation_evidence_sha256",
        "deployment_evidence_sha256",
        "prior_ciphertext_sha256",
        "prior_config_sha256",
        "started_at",
        "state",
        "target_ciphertext_sha256",
        "target_config_sha256",
        "transaction_sha256",
        "transition_evidence_sha256",
        "version",
    }
    fixed = {
        "account_username_sha256": username_sha256,
        "account_reset_attestation": attestation,
        "auth_diagnostic_evidence_sha256": expected_auth_evidence_sha256,
        "beta_evidence_sha256": expected_beta_evidence_sha256,
        "credential_rotation_evidence_sha256": expected_rotation_evidence_sha256,
        "deployment_evidence_sha256": expected_deployment_evidence_sha256,
        "prior_ciphertext_sha256": prior_ciphertext_sha256,
        "prior_config_sha256": expected_prior_config_sha256,
        "target_ciphertext_sha256": expected_target_ciphertext_sha256,
        "transaction_sha256": expected_transaction,
        "transition_evidence_sha256": expected_transition_evidence_sha256,
        "version": 1,
    }
    resuming = evidence_path.exists() or evidence_path.is_symlink()
    marker: dict[str, object]
    if resuming:
        require_regular(evidence_path, 0, 0, 0o600)
        try:
            marker = json.loads(evidence_path.read_bytes())
        except (OSError, UnicodeDecodeError, json.JSONDecodeError):
            fail("account_reset_evidence_invalid")
        if not isinstance(marker, dict):
            fail("account_reset_evidence_invalid")
        final_keys = claim_keys | {
            "cache_state",
            "config_reconciliation",
            "installed_config_sha256",
            "provider_requests",
            "reconciled_at",
        }
        if marker.get("state") == "reconciled":
            if (
                set(marker) != final_keys
                or any(marker.get(key) != value for key, value in fixed.items())
                or marker.get("cache_state") != "absent"
                or marker.get("config_reconciliation") != "pass"
                or marker.get("provider_requests") != 0
                or marker.get("installed_config_sha256") != current_config_sha256
                or marker.get("target_config_sha256") != current_config_sha256
            ):
                fail("account_reset_evidence_invalid")
            require_empty_cache(service.pw_uid, service.pw_gid)
            if validate_lock(expected_transaction) != owner_content:
                fail("apply_lock_owner_drift")
            print(f"proton_account_reset_reconciliation=passed evidence_sha256={digest_file(evidence_path)}")
            return
        if (
            set(marker) != claim_keys
            or any(marker.get(key) != value for key, value in fixed.items())
            or marker.get("state") != "started"
            or re.fullmatch(r"[0-9a-f]{64}", str(marker.get("target_config_sha256", ""))) is None
        ):
            fail("account_reset_evidence_invalid")
        if current_config_sha256 == marker["target_config_sha256"]:
            target_config_sha256 = current_config_sha256
            target_parser = None
        elif current_config_sha256 == expected_prior_config_sha256:
            target_parser = parser_from_config()
            target_parser["proton-backup"]["password"] = obscure(new_values["PROTON_BACKUP_PASSWORD"])
            target_config_sha256 = digest_bytes(config_content(target_parser))
            marker["target_config_sha256"] = target_config_sha256
            atomic_json(evidence_path, marker, replace=True)
        else:
            fail("account_reset_config_resume_state")
    else:
        if current_config_sha256 != expected_prior_config_sha256:
            fail("account_reset_prior_config_hash")
        target_parser = parser_from_config()
        target_parser["proton-backup"]["password"] = obscure(new_values["PROTON_BACKUP_PASSWORD"])
        target_config_sha256 = digest_bytes(config_content(target_parser))
        marker = {
            **fixed,
            "started_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "state": "started",
            "target_config_sha256": target_config_sha256,
        }
        atomic_json(evidence_path, marker, replace=False)
    if target_parser is not None:
        atomic_config(target_parser, service.pw_uid, service.pw_gid)
    installed_config_sha256 = digest_file(CONFIG)
    if installed_config_sha256 != target_config_sha256:
        fail("account_reset_config_reconciliation")
    static_after = validate_config(service.pw_uid, service.pw_gid, username_sha256)
    if set(static_after) != PASSWORD_ONLY_KEYS or set(parser_from_config()["proton-backup"]) != PASSWORD_ONLY_KEYS:
        fail("account_reset_static_config_drift")
    require_empty_cache(service.pw_uid, service.pw_gid)
    if digest_file(INSTALLED_CIPHERTEXT) != prior_ciphertext_sha256:
        fail("account_reset_prior_ciphertext_drift")
    if validate_lock(expected_transaction) != owner_content:
        fail("apply_lock_owner_drift")
    evidence = {
        **fixed,
        "cache_state": "absent",
        "config_reconciliation": "pass",
        "installed_config_sha256": installed_config_sha256,
        "provider_requests": 0,
        "reconciled_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "started_at": marker["started_at"],
        "state": "reconciled",
        "target_config_sha256": target_config_sha256,
    }
    evidence_sha256 = atomic_json(evidence_path, evidence, replace=True)
    if validate_lock(expected_transaction) != owner_content:
        fail("apply_lock_owner_drift")
    print(f"proton_account_reset_reconciliation=passed evidence_sha256={evidence_sha256}")


def supervise_account_reset(
    expected_transaction: str,
    expected_script_sha256: str,
    target_ciphertext: Path,
    expected_target_ciphertext_sha256: str,
    expected_prior_config_sha256: str,
    expected_auth_evidence_sha256: str,
    expected_rotation_evidence_sha256: str,
    expected_transition_evidence_sha256: str,
    expected_deployment_evidence_sha256: str,
    expected_beta_evidence_sha256: str,
    expected_beta_binary_sha256: str,
    expected_beta_version: str,
) -> None:
    if os.getuid() != 0 or os.getgid() != 0:
        fail("identity")
    if digest_file(Path(__file__)) != expected_script_sha256:
        fail("diagnostic_script_hash")
    service_gid = grp.getgrnam("restic-proton").gr_gid
    require_regular(MUTEX, 0, service_gid, 0o660)
    require_regular(target_ciphertext, 0, 0, 0o600)
    if digest_file(target_ciphertext) != expected_target_ciphertext_sha256:
        fail("account_reset_target_ciphertext_hash")
    command = [
        str(FLOCK),
        "--exclusive",
        "--nonblock",
        "--conflict-exit-code",
        "75",
        "--",
        str(MUTEX),
        "/usr/bin/python3",
        str(Path(__file__)),
        "account-reset-under-lock",
        expected_transaction,
        expected_script_sha256,
        str(target_ciphertext),
        expected_target_ciphertext_sha256,
        expected_prior_config_sha256,
        expected_auth_evidence_sha256,
        expected_rotation_evidence_sha256,
        expected_transition_evidence_sha256,
        expected_deployment_evidence_sha256,
        expected_beta_evidence_sha256,
        expected_beta_binary_sha256,
        expected_beta_version,
    ]
    result = bounded_subprocess(command, 180, controlled_environment(), inherit_stdin=True)
    if result.returncode == 75:
        fail("backup_mutex_busy")
    if result.returncode != 0:
        controlled = re.fullmatch(rb"proton_auth_diagnostic=failed reason=([a-z0-9_.-]+)\n?", result.stderr)
        if controlled is not None:
            fail(controlled.group(1).decode("ascii"))
        fail(f"account_reset_subprocess_rc_{result.returncode}_stderr_sha256_{digest_bytes(result.stderr)}")
    try:
        output = result.stdout.decode("ascii").strip()
    except UnicodeDecodeError:
        fail("account_reset_output")
    if re.fullmatch(r"proton_account_reset_reconciliation=passed evidence_sha256=[0-9a-f]{64}", output) is None:
        fail("account_reset_output")
    print(output)


def supervise(expected_transaction: str, expected_script_sha256: str) -> None:
    if os.getuid() != 0 or os.getgid() != 0:
        fail("identity")
    if digest_file(Path(__file__)) != expected_script_sha256:
        fail("diagnostic_script_hash")
    service_gid = grp.getgrnam("restic-proton").gr_gid
    require_regular(MUTEX, 0, service_gid, 0o660)
    command = [
        str(FLOCK),
        "--exclusive",
        "--nonblock",
        "--conflict-exit-code",
        "75",
        "--",
        str(MUTEX),
        "/usr/bin/python3",
        str(Path(__file__)),
        "under-lock",
        expected_transaction,
        expected_script_sha256,
    ]
    result = subprocess.run(
        command,
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=660,
        env=controlled_environment(),
    )
    if result.returncode == 75:
        fail("backup_mutex_busy")
    if result.returncode != 0:
        controlled = re.fullmatch(rb"proton_auth_diagnostic=failed reason=([a-z0-9_.-]+)\n?", result.stderr)
        if controlled is not None:
            fail(controlled.group(1).decode("ascii"))
        fail(f"diagnostic_subprocess_rc_{result.returncode}_stderr_sha256_{digest_bytes(result.stderr)}")
    try:
        output = result.stdout.decode("ascii").strip()
    except UnicodeDecodeError:
        fail("diagnostic_output")
    if re.fullmatch(r"proton_auth_diagnostic=observed category=[a-z_]+ evidence_sha256=[0-9a-f]{64}", output) is None:
        fail("diagnostic_output")
    print(output)


def local_exception_reason(error: Exception) -> str:
    trace = error.__traceback__
    while trace is not None and trace.tb_next is not None:
        trace = trace.tb_next
    exception_name = re.sub(r"[^a-z0-9]+", "_", type(error).__name__.lower()).strip("_")
    function_name = "unknown" if trace is None else re.sub(
        r"[^a-z0-9]+", "_", trace.tb_frame.f_code.co_name.lower()
    ).strip("_")
    line_number = 0 if trace is None else trace.tb_lineno
    return f"local_exception_{exception_name}_{function_name}_{line_number}"


def main() -> None:
    try:
        if len(sys.argv) < 2:
            fail("usage")
        action = sys.argv[1]
        if action in {"supervise", "under-lock"}:
            if len(sys.argv) != 4:
                fail("usage")
            expected_transaction = sys.argv[2]
            expected_script_sha256 = sys.argv[3]
            if re.fullmatch(r"[0-9a-f]{64}", expected_transaction) is None or re.fullmatch(r"[0-9a-f]{64}", expected_script_sha256) is None:
                fail("usage")
            if action == "supervise":
                supervise(expected_transaction, expected_script_sha256)
            else:
                run_under_lock(expected_transaction, expected_script_sha256)
            return
        if action in {"beta-supervise", "beta-under-lock"}:
            if len(sys.argv) != 9:
                fail("usage")
            expected_transaction = sys.argv[2]
            expected_script_sha256 = sys.argv[3]
            beta_path = Path(sys.argv[4])
            expected_beta_sha256 = sys.argv[5]
            expected_beta_version = sys.argv[6]
            expected_transition_sha256 = sys.argv[7]
            expected_deployment_sha256 = sys.argv[8]
            hashes = (
                expected_transaction,
                expected_script_sha256,
                expected_beta_sha256,
                expected_transition_sha256,
                expected_deployment_sha256,
            )
            if (
                any(re.fullmatch(r"[0-9a-f]{64}", value) is None for value in hashes)
                or re.fullmatch(r"[0-9A-Za-z.-]+", expected_beta_version) is None
                or beta_path != Path(f"/var/tmp/rclone-beta-{expected_transaction}")
            ):
                fail("usage")
            arguments = (
                expected_transaction,
                expected_script_sha256,
                beta_path,
                expected_beta_sha256,
                expected_beta_version,
                expected_transition_sha256,
                expected_deployment_sha256,
            )
            if action == "beta-supervise":
                supervise_beta(*arguments)
            else:
                run_beta_under_lock(*arguments)
            return
        if action in {"password-only-supervise", "password-only-under-lock"}:
            if len(sys.argv) != 6:
                fail("usage")
            values = sys.argv[2:6]
            if any(re.fullmatch(r"[0-9a-f]{64}", value) is None for value in values):
                fail("usage")
            expected_transaction, expected_script_sha256, expected_auth_evidence_sha256, expected_rotation_evidence_sha256 = values
            if action == "password-only-supervise":
                supervise_password_only_transition(
                    expected_transaction,
                    expected_script_sha256,
                    expected_auth_evidence_sha256,
                    expected_rotation_evidence_sha256,
                )
            else:
                run_password_only_transition_under_lock(
                    expected_transaction,
                    expected_script_sha256,
                    expected_auth_evidence_sha256,
                    expected_rotation_evidence_sha256,
                )
            return
        if action in {"account-reset-supervise", "account-reset-under-lock"}:
            if len(sys.argv) != 14:
                fail("usage")
            expected_transaction = sys.argv[2]
            expected_script_sha256 = sys.argv[3]
            target_ciphertext = Path(sys.argv[4])
            expected_target_ciphertext_sha256 = sys.argv[5]
            expected_prior_config_sha256 = sys.argv[6]
            expected_auth_evidence_sha256 = sys.argv[7]
            expected_rotation_evidence_sha256 = sys.argv[8]
            expected_transition_evidence_sha256 = sys.argv[9]
            expected_deployment_evidence_sha256 = sys.argv[10]
            expected_beta_evidence_sha256 = sys.argv[11]
            expected_beta_binary_sha256 = sys.argv[12]
            expected_beta_version = sys.argv[13]
            hashes = (
                expected_transaction,
                expected_script_sha256,
                expected_target_ciphertext_sha256,
                expected_prior_config_sha256,
                expected_auth_evidence_sha256,
                expected_rotation_evidence_sha256,
                expected_transition_evidence_sha256,
                expected_deployment_evidence_sha256,
                expected_beta_evidence_sha256,
                expected_beta_binary_sha256,
            )
            if (
                any(re.fullmatch(r"[0-9a-f]{64}", value) is None for value in hashes)
                or re.fullmatch(r"[0-9A-Za-z.-]+", expected_beta_version) is None
                or target_ciphertext != Path(f"/run/proton-account-reset-{expected_transaction}.sops.env")
            ):
                fail("usage")
            arguments = (
                expected_transaction,
                expected_script_sha256,
                target_ciphertext,
                expected_target_ciphertext_sha256,
                expected_prior_config_sha256,
                expected_auth_evidence_sha256,
                expected_rotation_evidence_sha256,
                expected_transition_evidence_sha256,
                expected_deployment_evidence_sha256,
                expected_beta_evidence_sha256,
                expected_beta_binary_sha256,
                expected_beta_version,
            )
            if action == "account-reset-supervise":
                supervise_account_reset(*arguments)
            else:
                raw_payload = sys.stdin.buffer.read(2 * 1024 * 1024 + 1)
                run_account_reset_under_lock(*arguments, raw_payload)
            return
        if action not in {"rotate-supervise", "rotate-under-lock"} or len(sys.argv) != 5:
            fail("usage")
        expected_transaction = sys.argv[2]
        expected_script_sha256 = sys.argv[3]
        expected_auth_evidence_sha256 = sys.argv[4]
        if any(re.fullmatch(r"[0-9a-f]{64}", value) is None for value in (expected_transaction, expected_script_sha256, expected_auth_evidence_sha256)):
            fail("usage")
        raw_dotenv = sys.stdin.buffer.read(1024 * 1024 + 1)
        if action == "rotate-supervise":
            supervise_rotation(expected_transaction, expected_script_sha256, expected_auth_evidence_sha256, raw_dotenv)
        else:
            run_rotation_under_lock(expected_transaction, expected_script_sha256, expected_auth_evidence_sha256, raw_dotenv)
    except DiagnosticError as error:
        print(f"proton_auth_diagnostic=failed reason={error}", file=sys.stderr)
        raise SystemExit(1) from None
    except (OSError, KeyError, subprocess.SubprocessError):
        print("proton_auth_diagnostic=failed reason=local_operation", file=sys.stderr)
        raise SystemExit(1) from None
    except Exception as error:
        print(f"proton_auth_diagnostic=failed reason={local_exception_reason(error)}", file=sys.stderr)
        raise SystemExit(1) from None


if __name__ == "__main__":
    main()
