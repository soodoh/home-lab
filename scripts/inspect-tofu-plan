#!/usr/bin/env bash
set -euo pipefail

if (($# < 1)); then
  echo "usage: $0 <saved-plan> [policy arguments...]" >&2
  exit 64
fi

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
plan=$1
plan="$(cd "$(dirname "$plan")" && pwd)/$(basename "$plan")"
shift
tofu_chdir=${TOFU_PLAN_CHDIR:-}
umask 077
json=$(mktemp)
chmod 0600 "$json"
trap 'rm -f "$json"' EXIT

if [[ -n $tofu_chdir ]]; then
  tofu -chdir="$tofu_chdir" show -json "$plan" >"$json"
else
  tofu show -json "$plan" >"$json"
fi
# The approval is bound to these exact saved-plan bytes, not an address that can
# be reused for a future, different plan. Do not print the plan or its JSON.
plan_sha256=$(python3 - "$plan" <<'PY'
import hashlib
import sys

checksum = hashlib.sha256()
with open(sys.argv[1], "rb") as plan:
    for chunk in iter(lambda: plan.read(1024 * 1024), b""):
        checksum.update(chunk)
print(checksum.hexdigest())
PY
)
printf 'saved_plan_sha256=%s\n' "$plan_sha256"
plan_root=unknown
if [[ -n $tofu_chdir ]] && [[ $(cd "$tofu_chdir" && pwd -P) == "$repo_root/infrastructure/tofu/aws-foundation" ]]; then
  plan_root=aws-foundation
fi
python3 "$repo_root/infrastructure/policy/inspect-plan.py" "$json" "$@" \
  --saved-plan-sha256="$plan_sha256" --plan-root="$plan_root"
