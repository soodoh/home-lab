#!/bin/bash
set -Eeuo pipefail

readonly CONFIRMATION=recover-reviewed-proxmox-firewall-after-boot
readonly SOURCE=infrastructure/proxmox-firewall/host/proxmox-firewall-policy.json
readonly TARGET=/usr/local/share/home-lab/proxmox-firewall-policy.json
readonly EXPECTED_SHA256=5d19ca638c2d5b73cf75a64ceeef35acb957f25f357618db1dc48c1c67eede57
readonly PREVIOUS_SHA256=275423d9d861387584d33f1b079c379b45280c7f49eb064ce7430da0bae44f97
readonly TRANSACTION=/usr/local/libexec/home-lab/proxmox-firewall-transaction

[[ $# -eq 0 ]] || { echo "usage: scripts/recover-proxmox-firewall-after-boot" >&2; exit 1; }
[[ $(id -u) -eq 0 && -t 0 ]] || { echo "firewall boot recovery requires an interactive physical root console" >&2; exit 1; }
printf 'Type the exact confirmation to canonicalize the unchanged firewall policy and finish boot recovery:\n%s\n' "$CONFIRMATION" >&2
IFS= read -r confirmation
[[ $confirmation == "$CONFIRMATION" ]] || { echo "exact firewall recovery confirmation is required" >&2; exit 1; }
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
[[ $(git branch --show-current) == main && -z $(git status --porcelain) ]] || { echo "repository must be clean on main" >&2; exit 1; }
git fetch --quiet origin "+refs/heads/main:refs/remotes/origin/main"
[[ $(git rev-parse HEAD) == $(git rev-parse origin/main) ]] || { echo "repository is not at origin/main" >&2; exit 1; }
[[ $(sha256sum "$SOURCE" | awk '{print $1}') == "$EXPECTED_SHA256" ]] || { echo "canonical source policy digest differs" >&2; exit 1; }
installed_sha=$(sha256sum "$TARGET" | awk '{print $1}')
[[ $installed_sha == "$PREVIOUS_SHA256" || $installed_sha == "$EXPECTED_SHA256" ]] || { echo "installed policy is not an exact replaceable revision" >&2; exit 1; }
python3 - "$SOURCE" "$TARGET" <<'PY'
import json
import sys
from pathlib import Path
source = json.loads(Path(sys.argv[1]).read_bytes())
target = json.loads(Path(sys.argv[2]).read_bytes())
if source != target:
    raise SystemExit("firewall policy semantics differ")
PY
[[ $(qm status 100) == "status: running" ]] || { echo "VM 100 is not running" >&2; exit 1; }
[[ $(qm guest cmd 100 get-osinfo | jq -er .id) == arch ]] || { echo "VM 100 is not running Arch" >&2; exit 1; }
jq -e '.state == "boot-recovery-active" and .decision == "commit"' /var/lib/home-lab/firewall-transaction/journal.json >/dev/null
systemctl stop home-lab-proxmox-firewall-rollback.timer home-lab-proxmox-firewall-rollback.service home-lab-proxmox-firewall-config-recovery.service
[[ -z $(fuser /var/lib/home-lab/reconciliation/operation.lock /var/lib/iac-ansible-production.lock 2>/dev/null || true) ]] || { echo "a protected operation lock is active" >&2; exit 1; }
pending=$TARGET.pending
trap 'rm -f -- "$pending"' EXIT
[[ ! -e $pending && ! -L $pending ]] || { echo "pending policy target requires reconciliation" >&2; exit 1; }
install -o root -g root -m 0644 "$SOURCE" "$pending"
mv -T "$pending" "$TARGET"
[[ $(sha256sum "$TARGET" | awk '{print $1}') == "$EXPECTED_SHA256" ]] || { echo "installed canonical policy digest differs" >&2; exit 1; }
result=$($TRANSACTION boot-config-recover)
jq -e '.status == "boot-commit-config-verified"' <<< "$result" >/dev/null
systemctl reset-failed home-lab-proxmox-firewall-config-recovery.service
systemctl start home-lab-proxmox-firewall-post-recovery.service
result=$($TRANSACTION status)
jq -e '.status == "committed"' <<< "$result" >/dev/null
[[ $(systemctl is-active pve-firewall.service) == active ]]
[[ $(systemctl is-active proxmox-firewall.service) == active ]]
[[ $(pve-firewall status) == "Status: enabled/running" ]]
echo "Proxmox firewall boot recovery committed; Arch production remains running"
