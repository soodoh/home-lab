#!/usr/bin/env python3
"""Run one bounded, redacted Proton Drive backend qualification."""

from configparser import ConfigParser, Error as ConfigError
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import pwd
import re
import secrets
import stat
import subprocess
import sys
import tempfile


RCLONE = Path("/usr/local/bin/rclone")
POLICY = Path("/etc/home-lab/restic-policy.json")
CONFIG = Path("/var/lib/restic-proton/rclone.conf")
CACHE = Path("/var/lib/restic-proton/cache")
RESULT = Path("/var/lib/restic-proton/proton-qualification-result.json")
INSTALLED_HELPER = Path("/usr/local/libexec/home-lab/qualify-proton-backup")
REMOTE = "proton-backup:"
STATIC_KEYS = {
    "type",
    "username",
    "password",
    "mailbox_password",
    "replace_existing_draft",
    "enable_caching",
    "original_file_size",
}
CACHE_KEYS = {
    "client_uid",
    "client_access_token",
    "client_refresh_token",
    "client_salted_key_pass",
}
ALLOWED_COMMANDS = {"about", "cat", "copyto", "deletefile", "lsjson", "moveto", "rmdir"}
EXPECTED_MISSING_CODES = {3, 4}


class QualificationError(RuntimeError):
    """A redacted qualification failure."""


def digest_bytes(content: bytes) -> str:
    return hashlib.sha256(content).hexdigest()


def digest_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def controlled_environment() -> dict[str, str]:
    return {
        "HOME": "/var/lib/restic-proton",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "PATH": "/usr/local/bin:/usr/bin:/bin",
    }


def validate_tools(policy: dict[str, object], qualification_helper: Path = Path(__file__)) -> None:
    qualification = policy.get("qualification")
    tools = policy.get("tools")
    if not isinstance(qualification, dict) or not isinstance(tools, dict) or not isinstance(tools.get("rclone"), dict):
        fail("tool_policy")
    rclone_policy = tools["rclone"]
    if digest_file(qualification_helper) != qualification.get("helper_sha256"):
        fail("qualification_helper_hash")
    if digest_file(RCLONE) != rclone_policy.get("installed_sha256"):
        fail("rclone_hash")
    version = subprocess.run(
        [str(RCLONE), "version"],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=30,
        env=controlled_environment(),
    )
    if version.returncode != 0:
        fail(f"rclone_version_rc_{version.returncode}_stderr_sha256_{digest_bytes(version.stderr)}")
    try:
        first_line = version.stdout.decode("utf-8").splitlines()[0]
    except (UnicodeDecodeError, IndexError):
        fail("rclone_version_output")
    if first_line != rclone_policy.get("version_output_prefix"):
        fail("rclone_version_output")


def fail(reason: str) -> None:
    raise QualificationError(reason)


def safe_regular(path: Path, uid: int, gid: int, mode: int) -> None:
    try:
        metadata = path.lstat()
    except OSError:
        fail(f"{path.name}_absent")
    if path.is_symlink() or not path.is_file() or metadata.st_nlink != 1:
        fail(f"{path.name}_type")
    if metadata.st_uid != uid or metadata.st_gid != gid or stat.S_IMODE(metadata.st_mode) != mode:
        fail(f"{path.name}_metadata")


def safe_directory(path: Path, uid: int, gid: int, mode: int) -> None:
    try:
        metadata = path.lstat()
    except OSError:
        fail(f"{path.name}_absent")
    if path.is_symlink() or not path.is_dir():
        fail(f"{path.name}_type")
    if metadata.st_uid != uid or metadata.st_gid != gid or stat.S_IMODE(metadata.st_mode) != mode:
        fail(f"{path.name}_metadata")


def load_policy() -> dict[str, object]:
    safe_regular(POLICY, 0, os.getgid(), 0o440)
    try:
        policy = json.loads(POLICY.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        fail("policy_invalid")
    if not isinstance(policy, dict):
        fail("policy_invalid")
    return policy


def parser_from_config() -> ConfigParser:
    parser = ConfigParser(interpolation=None)
    try:
        with CONFIG.open(encoding="utf-8") as stream:
            parser.read_file(stream)
    except (OSError, UnicodeDecodeError, ConfigError):
        fail("rclone_config_invalid")
    return parser


def validate_config(
    policy: dict[str, object],
    require_cache: bool | None = None,
    allow_partial_cache: bool = False,
) -> ConfigParser:
    safe_regular(CONFIG, os.getuid(), os.getgid(), 0o600)
    parser = parser_from_config()
    if parser.sections() != ["proton-backup"]:
        fail("rclone_config_identity")
    remote = parser["proton-backup"]
    keys = set(remote)
    if not keys <= STATIC_KEYS | CACHE_KEYS:
        fail("rclone_config_fields")
    required_static = STATIC_KEYS - {"mailbox_password"}
    if not required_static <= keys:
        fail("rclone_config_fields")
    if any(not value or "\x00" in value or "\n" in value for value in remote.values()):
        fail("rclone_config_values")
    if (
        remote.get("type") != "protondrive"
        or remote.get("replace_existing_draft") != "true"
        or remote.get("enable_caching") != "true"
        or remote.get("original_file_size") != "true"
        or not remote.get("password")
    ):
        fail("rclone_config_static_identity")
    qualification = policy.get("qualification")
    if not isinstance(qualification, dict):
        fail("qualification_policy")
    expected_username = qualification.get("username_sha256")
    username = remote.get("username", "")
    if not isinstance(expected_username, str) or digest_bytes(username.encode()) != expected_username:
        fail("proton_account_identity")
    cache_present = CACHE_KEYS & keys
    if cache_present and cache_present != CACHE_KEYS and not allow_partial_cache:
        fail("rclone_auth_cache_partial")
    if require_cache is True and cache_present != CACHE_KEYS:
        fail("rclone_auth_cache_absent")
    if require_cache is False and cache_present:
        fail("rclone_auth_cache_present")
    return parser


def atomic_config(parser: ConfigParser) -> None:
    descriptor, temporary_name = tempfile.mkstemp(prefix=".rclone.conf.", dir=CONFIG.parent)
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, 0o600)
        os.fchown(descriptor, os.getuid(), os.getgid())
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            parser.write(stream)
            stream.flush()
            os.fsync(stream.fileno())
        temporary.replace(CONFIG)
        directory_descriptor = os.open(CONFIG.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_descriptor)
        finally:
            os.close(directory_descriptor)
    finally:
        if temporary.exists():
            temporary.unlink()
    safe_regular(CONFIG, os.getuid(), os.getgid(), 0o600)


def invalidate_auth_cache(policy: dict[str, object]) -> None:
    parser = validate_config(policy, allow_partial_cache=True)
    if not (CACHE_KEYS & set(parser["proton-backup"])):
        validate_config(policy, require_cache=False)
        return
    for key in CACHE_KEYS:
        parser.remove_option("proton-backup", key)
    atomic_config(parser)
    validate_config(policy, require_cache=False)


def rclone(arguments: list[str], label: str, accepted_codes: set[int] | None = None) -> subprocess.CompletedProcess[bytes]:
    if not arguments or arguments[0] not in ALLOWED_COMMANDS:
        fail("rclone_command_forbidden")
    command = [
        str(RCLONE),
        "--config",
        str(CONFIG),
        "--cache-dir",
        str(CACHE),
        "--log-level",
        "ERROR",
        "--stats",
        "0",
        "--retries",
        "1",
        "--low-level-retries",
        "1",
        *arguments,
    ]
    result = subprocess.run(
        command,
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=600,
        env=controlled_environment(),
    )
    expected = accepted_codes if accepted_codes is not None else {0}
    if result.returncode not in expected:
        stderr_hash = digest_bytes(result.stderr)
        fail(f"{label}_rc_{result.returncode}_stderr_sha256_{stderr_hash}")
    return result


def parsed_json(result: subprocess.CompletedProcess[bytes], label: str) -> object:
    try:
        return json.loads(result.stdout)
    except (UnicodeDecodeError, json.JSONDecodeError):
        fail(f"{label}_output")


def json_type(value: object) -> str:
    if value is None:
        return "null"
    if isinstance(value, bool):
        return "boolean"
    if isinstance(value, list):
        return "array"
    if isinstance(value, dict):
        return "object"
    if isinstance(value, str):
        return "string"
    if isinstance(value, int):
        return "integer"
    if isinstance(value, float):
        return "number"
    return "unknown"


def require_remote_absent(path: str, label: str) -> None:
    result = rclone(["cat", path], label, EXPECTED_MISSING_CODES)
    if result.stdout:
        fail(f"{label}_unexpected_content")


def qualification_inventory(path: str) -> tuple[bool, list[str]]:
    result = rclone(["lsjson", path, "--max-depth", "1"], "qualification_directory", {0, 3})
    if result.returncode == 3 and not result.stdout.strip():
        return False, []
    try:
        value = json.loads(result.stdout)
    except (UnicodeDecodeError, json.JSONDecodeError):
        fail(
            f"qualification_directory_rc_{result.returncode}_invalid_json_"
            f"bytes_{len(result.stdout)}_sha256_{digest_bytes(result.stdout)}"
        )
    if value is None:
        return False, []
    if result.returncode == 3 or not isinstance(value, list):
        fail(f"qualification_directory_rc_{result.returncode}_{json_type(value)}")
    entries: list[str] = []
    for item in value:
        if not isinstance(item, dict) or not isinstance(item.get("Path"), str) or item.get("IsDir") is not False:
            fail("qualification_directory_entry")
        entries.append(item["Path"])
    return True, entries


def require_empty_qualification_directory(path: str) -> None:
    _exists, entries = qualification_inventory(path)
    if entries:
        fail("qualification_directory_not_empty")


def quota(policy: dict[str, object]) -> dict[str, int]:
    result = rclone(["about", REMOTE, "--json"], "about")
    value = parsed_json(result, "about")
    if not isinstance(value, dict):
        fail("quota_shape")
    try:
        observed = {name: value[name] for name in ("total", "used", "free")}
    except KeyError:
        fail("quota_shape")
    if any(isinstance(item, bool) or not isinstance(item, int) or item < 0 for item in observed.values()):
        fail("quota_shape")
    repositories = policy.get("repositories")
    proton = policy.get("proton")
    if not isinstance(repositories, dict) or not isinstance(repositories.get("proton"), dict) or not isinstance(proton, dict):
        fail("quota_policy")
    minimum_total = repositories["proton"].get("minimum_allocated_bytes")
    minimum_free = proton.get("minimum_free_bytes")
    if (
        not isinstance(minimum_total, int)
        or not isinstance(minimum_free, int)
        or observed["total"] < minimum_total
        or observed["free"] < minimum_free
    ):
        fail("quota_gate")
    return observed


def write_result(evidence: dict[str, object]) -> str:
    content = (json.dumps(evidence, sort_keys=True, separators=(",", ":")) + "\n").encode()
    descriptor, temporary_name = tempfile.mkstemp(prefix=".proton-qualification.", dir=RESULT.parent)
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, 0o600)
        os.fchown(descriptor, os.getuid(), os.getgid())
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        temporary.replace(RESULT)
        directory_descriptor = os.open(RESULT.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_descriptor)
        finally:
            os.close(directory_descriptor)
    finally:
        if temporary.exists():
            temporary.unlink()
    safe_regular(RESULT, os.getuid(), os.getgid(), 0o600)
    return digest_bytes(content)


def require_policy(policy: dict[str, object]) -> dict[str, object]:
    qualification = policy.get("qualification")
    credentials = policy.get("credentials")
    repositories = policy.get("repositories")
    proton = policy.get("proton")
    if (
        policy.get("migration_state") != "inert"
        or not isinstance(qualification, dict)
        or qualification.get("state") != "ready"
        or not isinstance(credentials, dict)
        or credentials != {"bootstrap_enabled": True, "state": "provisioned"}
        or not isinstance(repositories, dict)
        or any(not isinstance(value, dict) or value.get("id") is not None for value in repositories.values())
        or not isinstance(proton, dict)
        or proton.get("exclusive_client") is not True
        or proton.get("authentication_mode") != "password-only"
        or proton.get("trash_cleanup") != "manual-only"
    ):
        fail("qualification_policy")
    return qualification


def inspect_remote_qualification(policy: dict[str, object], qualification: dict[str, object]) -> None:
    validate_config(policy, require_cache=False)
    remote_directory = qualification.get("remote_directory")
    if remote_directory != "Backups/.home-lab-rclone-qualification":
        fail("qualification_fixture_policy")
    try:
        exists, entries = qualification_inventory(f"{REMOTE}{remote_directory}")
        if exists or entries:
            fail("qualification_remote_not_absent")
    finally:
        invalidate_auth_cache(policy)
    print("proton_qualification_remote=absent")


def recover_remote_qualification(
    policy: dict[str, object],
    qualification: dict[str, object],
    transaction_sha256: str,
) -> None:
    validate_config(policy, require_cache=False)
    remote_directory = qualification.get("remote_directory")
    if remote_directory != "Backups/.home-lab-rclone-qualification":
        fail("qualification_fixture_policy")
    remote_path = f"{REMOTE}{remote_directory}"
    try:
        exists, entries = qualification_inventory(remote_path)
        allowed = {"fixture.bin", "fixture-renamed.bin"}
        if not set(entries) <= allowed or len(entries) != len(set(entries)):
            fail("qualification_recovery_scope")
        for name in sorted(entries):
            rclone(["deletefile", f"{remote_path}/{name}"], f"recover_{name.replace('.', '_')}")
        if exists:
            rclone(["rmdir", remote_path], "recover_empty_directory")
        remaining_exists, remaining_entries = qualification_inventory(remote_path)
        if remaining_exists or remaining_entries:
            fail("qualification_recovery_incomplete")
        evidence = {
            "account_username_sha256": qualification["username_sha256"],
            "recovered_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "recovered_files": sorted(entries),
            "remote_cleanup": "pass",
            "state": "recovered",
            "transaction_sha256": transaction_sha256,
            "version": 1,
        }
    finally:
        invalidate_auth_cache(policy)
    evidence_sha256 = write_result(evidence)
    print(f"proton_qualification_recovery=passed evidence_sha256={evidence_sha256}")


def main() -> None:
    try:
        if len(sys.argv) < 2 or sys.argv[1] not in {"inspect", "qualify", "recover", "recover-installed"}:
            fail("usage")
        action = sys.argv[1]
        if action == "recover-installed":
            if (
                len(sys.argv) != 4
                or re.fullmatch(r"[0-9a-f]{64}", sys.argv[2]) is None
                or re.fullmatch(r"[0-9a-f]{64}", sys.argv[3]) is None
                or digest_file(Path(__file__)) != sys.argv[3]
            ):
                fail("usage")
            transaction_sha256 = sys.argv[2]
        elif action == "recover":
            if len(sys.argv) != 3 or re.fullmatch(r"[0-9a-f]{64}", sys.argv[2]) is None:
                fail("usage")
            transaction_sha256 = sys.argv[2]
        elif len(sys.argv) != 2:
            fail("usage")
        identity = pwd.getpwnam("restic-proton")
        if os.getuid() != identity.pw_uid or os.getgid() != identity.pw_gid or identity.pw_uid != 60000 or identity.pw_gid != 60000:
            fail("identity")
        safe_directory(CONFIG.parent, os.getuid(), os.getgid(), 0o700)
        safe_directory(CACHE, os.getuid(), os.getgid(), 0o700)
        safe_regular(RCLONE, 0, 0, 0o755)
        if action == "recover-installed":
            safe_regular(INSTALLED_HELPER, 0, identity.pw_gid, 0o750)
        if action in {"qualify", "recover", "recover-installed"} and RESULT.exists():
            fail("prior_result_present")
        policy = load_policy()
        qualification = require_policy(policy)
        validate_tools(policy, INSTALLED_HELPER if action == "recover-installed" else Path(__file__))
        if qualification.get("result_path") != str(RESULT):
            fail("qualification_result_path")
        remote_directory = qualification.get("remote_directory")
        fixture_bytes = qualification.get("fixture_bytes")
        range_offset = qualification.get("range_offset")
        range_count = qualification.get("range_count")
        if (
            remote_directory != "Backups/.home-lab-rclone-qualification"
            or fixture_bytes != 4096
            or range_offset != 1024
            or range_count != 1024
        ):
            fail("qualification_fixture_policy")
        if action == "inspect":
            inspect_remote_qualification(policy, qualification)
            return
        if action in {"recover", "recover-installed"}:
            recover_remote_qualification(policy, qualification, transaction_sha256)
            return
        try:
            object_path = f"{REMOTE}{remote_directory}/fixture.bin"
            renamed_path = f"{REMOTE}{remote_directory}/fixture-renamed.bin"
            invalidate_auth_cache(policy)
            observed_quota = quota(policy)
            validate_config(policy, require_cache=True)
            require_empty_qualification_directory(f"{REMOTE}{remote_directory}")
            require_remote_absent(object_path, "initial_object")
            require_remote_absent(renamed_path, "initial_renamed_object")
            with tempfile.TemporaryDirectory(prefix="proton-qualification-", dir=CONFIG.parent) as directory:
                local = Path(directory)
                first = secrets.token_bytes(fixture_bytes)
                second = secrets.token_bytes(fixture_bytes)
                if first == second:
                    fail("fixture_randomness")
                first_path = local / "fixture-first.bin"
                second_path = local / "fixture-second.bin"
                first_path.write_bytes(first)
                second_path.write_bytes(second)
                first_path.chmod(0o600)
                second_path.chmod(0o600)
                rclone(["copyto", str(first_path), object_path], "copy_first")
                downloaded_first = rclone(["cat", object_path], "read_first").stdout
                if downloaded_first != first:
                    fail("first_content")
                rclone(["copyto", str(second_path), object_path], "replace_draft")
                downloaded_second = rclone(["cat", object_path], "read_second").stdout
                if downloaded_second != second or len(downloaded_second) != fixture_bytes:
                    fail("replacement_content")
                ranged = rclone(
                    ["cat", object_path, "--offset", str(range_offset), "--count", str(range_count)],
                    "range_read",
                ).stdout
                if ranged != second[range_offset:range_offset + range_count]:
                    fail("range_content")
                rclone(["moveto", object_path, renamed_path], "move")
                require_remote_absent(object_path, "moved_source")
                if rclone(["cat", renamed_path], "read_renamed").stdout != second:
                    fail("renamed_content")
                rclone(["deletefile", renamed_path], "delete_exact_file")
                require_remote_absent(renamed_path, "deleted_object")
                rclone(["rmdir", f"{REMOTE}{remote_directory}"], "remove_empty_directory")
                evidence = {
                    "account_username_sha256": qualification["username_sha256"],
                    "minimum_allocated_bytes": policy["repositories"]["proton"]["minimum_allocated_bytes"],
                    "observed_total_bytes": observed_quota["total"],
                    "cache_invalidation": "pass",
                    "fixture_bytes": fixture_bytes,
                    "fixture_sha256": digest_bytes(second),
                    "free_bytes": observed_quota["free"],
                    "operations": ["about", "lsjson", "copyto", "cat", "moveto", "deletefile", "rmdir"],
                    "original_file_size": "pass",
                    "password_reauthentication": "pass",
                    "range_count": range_count,
                    "range_offset": range_offset,
                    "remote_cleanup": "pass",
                    "replace_existing_draft": "pass",
                    "state": "qualified",
                    "trash_cleanup": "manual-only",
                    "used_bytes": observed_quota["used"],
                    "verified_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                    "version": 1,
                }
        finally:
            invalidate_auth_cache(policy)
        evidence_sha256 = write_result(evidence)
        print(f"proton_qualification=passed evidence_sha256={evidence_sha256}")
    except QualificationError as error:
        print(f"proton_qualification=failed reason={error}", file=sys.stderr)
        raise SystemExit(1) from None
    except (OSError, subprocess.SubprocessError):
        print("proton_qualification=failed reason=local_operation", file=sys.stderr)
        raise SystemExit(1) from None


if __name__ == "__main__":
    main()
