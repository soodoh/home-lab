#!/usr/bin/env bash
set -euo pipefail
set +x
umask 077

[[ $# == 0 ]] || { echo 'usage: scripts/check-omada-mail' >&2; exit 64; }
repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
for command in sops jq; do
  command -v "$command" >/dev/null || { echo "missing command: $command" >&2; exit 69; }
done
if ! sops --decrypt --output-type json "$repo_root/secrets/omada-mail.sops.json" 2>/dev/null |
    jq -e -f "$repo_root/scripts/omada-mail-input.jq" >/dev/null 2>&1; then
  echo 'Omada mail source could not be decrypted or failed validation; no values printed.' >&2
  exit 1
fi
printf 'omada_mail_source=valid activation=not_performed\n'
