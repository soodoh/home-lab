#!/usr/bin/env bash
# Synthetic active-vs-retained prefix proof. Never run on a managed host.
set -euo pipefail
umask 077
[[ ${WOLF_ACTIVE_BACKUP_TEST_DISPOSABLE:-} == true && $EUID == 0 && $(uname -s) == Linux && ! -e /etc/home-lab ]]
root=$(cd "$(dirname "$0")/.." && pwd -P)
if [[ ${1:-} != private ]]; then
  [[ $# == 1 ]]
  exec unshare --mount --propagation private -- bash "$0" private "$(realpath -- "$1")"
fi
[[ $(readlink /proc/self/ns/mnt) != "$(readlink /proc/1/ns/mnt)" ]]
restic=$2
[[ $("$restic" version) == 'restic 0.19.1 '* ]]
w=$(mktemp -d /tmp/wolf-active-fixture.XXXXXXXX)
mounts=()
cleanup() {
  rc=$?
  trap - EXIT
  set +e
  for (( idx=${#mounts[@]}-1; idx>=0; idx-- )); do
    p=${mounts[$idx]}
    if findmnt -n --mountpoint "$p" >/dev/null; then umount --recursive "$p" || exit 2; fi
  done
  rm -rf -- "$w"
  exit "$rc"
}
trap cleanup EXIT
mount -t tmpfs -o size=12m,nodev,nosuid tmpfs /mnt
mounts+=(/mnt)
base=/mnt/games/wolf
apps="$base/profile-data/fake/Steam/.steam/steam/steamapps"
legacy="$apps/compatdata/117"
second="$apps/compatdata/118"
save='pfx/drive_c/users/steamuser/Saved Games'
mkdir -p "$legacy/$save" "$second/$save" "$apps/common/title" "$base/cfg" "$w/state" "$w/frozen" "$w/fallback/files" "$w/snapshot/files"
printf 'STALE-ROLLBACK\n' > "$legacy/$save/slot1"
printf 'OTHER-TITLE\n' > "$second/$save/slot1"
printf 'GAME-INSTALL\n' > "$apps/common/title/game.bin"
truncate -s 64MiB "$w/state.img"
mkfs.ext4 -q -F "$w/state.img"
mount -t ext4 -o loop "$w/state.img" "$w/state"
mounts+=("$w/state")
active="$w/state/wolf-pilot/compatdata/117"
mkdir -p "$active/$save" "$active/pfx/drive_c/Program Files/Install"
printf 'ACTIVE-PILOT\n' > "$active/$save/slot1"
printf 'ACTIVE-REGISTRY\n' > "$active/pfx/user.reg"
printf 'NOT-A-BACKUP-INPUT\n' > "$active/pfx/drive_c/Program Files/Install/game.bin"
ln -s slot1 "$active/$save/slot-link"
export FIXTURE_BASE="$base" FIXTURE_LEGACY="$legacy"
export FIXTURE_ADAPTER="$root/scripts/restic-capture-files.py" FIXTURE_EXCLUDES="$root/services/data/restic/excludes"
export FIXTURE_WORK="$w" FIXTURE_SAVE="$save"

# Existing helper, deliberately unbound: demonstrate the silent stale baseline.
python3 - <<'PY'
import os, runpy
from pathlib import Path
adapter = runpy.run_path(os.environ['FIXTURE_ADAPTER'])
paths, _ = adapter['wolf_paths'](Path(os.environ['FIXTURE_BASE']))
root = Path(os.environ['FIXTURE_LEGACY'])
save = root / os.environ['FIXTURE_SAVE'] / 'slot1'
assert str(save.parent) in paths and save.read_text() == 'STALE-ROLLBACK\n'
print('unmodified_backup_would_select_retained_prefix=yes')
PY

FIXTURE_UUID=$(findmnt -n --mountpoint "$w/state" -o UUID)
export FIXTURE_UUID
[[ $FIXTURE_UUID =~ ^[0-9a-f-]{36}$ ]]
verify_active() {
  python3 - "$1" <<'PY'
import os, runpy, sys
from pathlib import Path
adapter = runpy.run_path(os.environ['FIXTURE_ADAPTER'])
state = Path(os.environ['FIXTURE_WORK']) / 'state'
verify = adapter['verify_wolf_pilot']
verify.__globals__['STATE_BASE'] = state
policy = {'capture': {'mounts': [{'path': str(state), 'identity': {'fstype': 'ext4', 'uuid': os.environ['FIXTURE_UUID']}}]}}
step = {'wolf': os.environ['FIXTURE_BASE'], 'wolf_pilot': {'profile': ['fake', 'Steam'], 'app_id': '117'}}
expected = sys.argv[1]
if expected == 'wrong-uuid':
    policy['capture']['mounts'][0]['identity']['uuid'] = '00000000-0000-0000-0000-000000000000'
    expected = 'wolf_pilot_state_identity'
try:
    actual = verify(policy, step)
except adapter['CaptureError'] as exc:
    assert str(exc) == expected, str(exc)
else:
    assert expected == 'admitted', 'unexpectedly admitted an invalid binding'
    assert actual == (Path(os.environ['FIXTURE_LEGACY']), state / 'wolf-pilot/compatdata/117')
PY
}
verify_active wolf_pilot_mount_identity
mkdir -p "$w/state/wolf-pilot/compatdata/118"
mount --bind "$w/state/wolf-pilot/compatdata/118" "$legacy"
mounts+=("$legacy")
mount -o remount,bind,ro "$legacy"
verify_active wolf_pilot_mount_identity
umount "$legacy"
mount --bind "$active" "$legacy"
verify_active wolf_pilot_mount_identity
mount -o remount,bind,ro "$legacy"
verify_active wrong-uuid
verify_active admitted
mount --bind "$active/$save" "$legacy/$save"
mounts+=("$legacy/$save")
verify_active wolf_pilot_nested_mount
umount "$legacy/$save"
verify_active admitted
printf 'binding_missing_writable_wrong_source_or_nested=refused\n'
python3 - <<'PY'
import json, os, runpy
from pathlib import Path
adapter = runpy.run_path(os.environ['FIXTURE_ADAPTER'])
root = Path(os.environ['FIXTURE_LEGACY'])
work = Path(os.environ['FIXTURE_WORK'])
paths, links = adapter['wolf_paths'](Path(os.environ['FIXTURE_BASE']))
selected = [Path(path).relative_to(root).as_posix() for path in paths if Path(path).is_relative_to(root)]
save = os.environ['FIXTURE_SAVE']
assert set(selected) == {'pfx/user.reg', save, save + '/slot1'}
assert links[str(root / save / 'slot-link')]['resolved'] == str(root / save / 'slot1')
copy, plan = adapter['wolf_snapshot_selection'](root, paths, links, 'a' * 32)
assert not any(Path(path).is_relative_to(root) for path in copy)
receipt = work / 'snapshot' / adapter['WOLF_SNAPSHOT_RECEIPT']
receipt.write_text(json.dumps(plan))
receipt.chmod(0o600)
adapter['copy_paths'](paths, work / 'fallback/files', os.environ['FIXTURE_EXCLUDES'])
assert (work / 'fallback/files' / root.relative_to('/') / save / 'slot1').read_text() == 'ACTIVE-PILOT\n'
assert (work / 'fallback/files' / root.relative_to('/') / save / 'slot-link').is_symlink()
print('existing_rsync_fallback_reads_active_prefix=verified')
PY
umount "$legacy"
[[ $(< "$legacy/$save/slot1") == STALE-ROLLBACK ]]
umount "$w/state"
cp --sparse=always "$w/state.img" "$w/frozen.img"
mount -t ext4 -o loop "$w/state.img" "$w/state"
printf 'NEWER-LIVE\n' > "$active/$save/slot1"
mount -t ext4 -o ro,noload,nosuid,nodev,noexec,loop "$w/frozen.img" "$w/frozen"
mounts+=("$w/frozen")

# Exercise the real production projection, including receipt mismatch and
# reattachment using the same receipt after the live prefix has changed.
python3 - <<'PY'
import json, os, runpy
from pathlib import Path
adapter = runpy.run_path(os.environ['FIXTURE_ADAPTER'])
work = Path(os.environ['FIXTURE_WORK'])
mount = adapter['wolf_snapshot_mount']
mount.__globals__['STATE_BASE'] = work / 'state'
root, stage = work / 'frozen', work / 'snapshot'
dev = root.stat().st_dev
args = (root, stage, f'{os.major(dev)}:{os.minor(dev)}', 'a' * 32)
step = {'wolf': os.environ['FIXTURE_BASE'], 'wolf_pilot': {'profile': ['fake', 'Steam'], 'app_id': '117', 'snapshot': True}}
policy = {'capture': {'cold': [step], 'state_snapshot': True, 'zfs': True}}
receipt = stage / adapter['WOLF_SNAPSHOT_RECEIPT']
plan = json.loads(receipt.read_text())
receipt.unlink()
try:
    mount(policy, *args)
except adapter['CaptureError'] as exc:
    assert str(exc) == 'wolf_pilot_snapshot_receipt', str(exc)
else:
    raise AssertionError('missing receipt admitted')
for bad, reason in [({**plan, 'capture': 'b' * 32}, 'wolf_pilot_snapshot_receipt'),
                    ({**plan, 'members': ['user.reg', 'system.reg']}, 'wolf_pilot_snapshot_selection_mismatch')]:
    receipt.write_text(json.dumps(bad))
    receipt.chmod(0o600)
    try:
        mount(policy, *args)
    except adapter['CaptureError'] as exc:
        assert str(exc) == reason, str(exc)
    else:
        raise AssertionError('bad receipt admitted')
receipt.write_text(json.dumps(plan))
first = mount(policy, *args)
assert len(first) == 2
adapter['state_snapshot_unmount'](first)
second = mount(policy, *args)
assert second == first
(work / 'mounts.json').write_text(json.dumps(list(map(str, second))))
print('snapshot_receipt_and_reattachment=verified')
PY
mapfile -t projections < <(python3 -c 'import json,sys; print("\n".join(json.load(open(sys.argv[1]))))' "$w/mounts.json")
[[ ${#projections[@]} == 2 ]]
mounts+=("${projections[@]}")
export RESTIC_PASSWORD=synthetic-only RESTIC_FROM_PASSWORD=synthetic-only RESTIC_CACHE_DIR="$w/cache"
for view in fallback snapshot; do
  export RESTIC_REPOSITORY="$w/$view-repo"
  "$restic" init >/dev/null
  (cd "$w/$view" && "$restic" backup ./files >/dev/null)
  if [[ $view == snapshot ]]; then
    for path in "${projections[@]}"; do umount "$path"; done
    umount "$w/frozen"
    rm -- "$w/frozen.img"
  fi
  for replica in primary replica-a replica-b; do
    if [[ $replica != primary ]]; then
      export RESTIC_REPOSITORY="$w/$view-$replica"
      "$restic" init --from-repo "$w/$view-repo" --copy-chunker-params >/dev/null
      "$restic" copy --from-repo "$w/$view-repo" >/dev/null
    fi
    target="$w/restore-$view-$replica"
    "$restic" restore latest --verify --target "$target" >/dev/null
    p="$target/files$legacy"
    [[ $(< "$p/$save/slot1") == ACTIVE-PILOT && $(< "$p/pfx/user.reg") == ACTIVE-REGISTRY ]]
    [[ $(readlink "$p/$save/slot-link") == slot1 && $(< "$p/$save/slot-link") == ACTIVE-PILOT ]]
    [[ ! -e "$p/pfx/drive_c/Program Files" && ! -e "$target/files$apps/common/title/game.bin" ]]
    if [[ $view == fallback ]]; then
      [[ $(< "$target/files$second/$save/slot1") == OTHER-TITLE ]]
    else
      [[ ! -e "$target/files$second" ]]
    fi
    printf 'restore_verified path=%s replica=%s\n' "$view" "$replica"
  done
done
[[ $(< "$legacy/$save/slot1") == STALE-ROLLBACK && $(< "$active/$save/slot1") == NEWER-LIVE ]]
printf 'active_source_backup_qualification=verified\n'
