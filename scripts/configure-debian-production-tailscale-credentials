#!/bin/bash
set -euo pipefail
umask 077

config_dir=$HOME/.config/home-lab/controller
credential_file=$config_dir/tailscale-cutover-credentials.json
pending=$config_dir/.tailscale-cutover-credentials.json.pending
expected_metadata=$(printf '%s:%s:700' "$(id -un)" "$(id -gn)")
actual_metadata=absent
[[ -d $config_dir && ! -L $config_dir ]] && actual_metadata=$(stat -f '%Su:%Sg:%Lp' "$config_dir")

[[ $# -eq 0 ]] || { echo "usage: scripts/configure-debian-production-tailscale-credentials" >&2; exit 1; }
[[ -t 0 ]] || { echo "Tailscale cutover credential configuration requires an interactive terminal" >&2; exit 1; }
[[ $actual_metadata == "$expected_metadata" ]] || { printf 'controller config directory is absent or unsafe: path=%s expected=%s actual=%s\n' "$config_dir" "$expected_metadata" "$actual_metadata" >&2; exit 1; }
[[ ! -e $credential_file && ! -L $credential_file && ! -e $pending && ! -L $pending ]] || { echo "Tailscale cutover credentials already exist or require reconciliation" >&2; exit 1; }
read -r -p 'Tailscale cutover OAuth client ID: ' client_id </dev/tty
read -r -s -p 'Tailscale cutover OAuth client secret: ' client_secret </dev/tty
printf '\n' >/dev/tty
[[ -n $client_id && $client_id != *$'\n'* && -n $client_secret && $client_secret != *$'\n'* ]] || { echo "Tailscale OAuth credentials must be nonempty single-line values" >&2; exit 1; }
jq -cn --arg client_id "$client_id" --arg client_secret "$client_secret" '{TAILSCALE_OAUTH_CLIENT_ID:$client_id,TAILSCALE_OAUTH_CLIENT_SECRET:$client_secret}' > "$pending"
chmod 0600 "$pending"
mv "$pending" "$credential_file"
unset client_id client_secret
printf 'tailscale_cutover_credentials=configured\n'
