#!/usr/bin/env bash
set -euo pipefail
umask 077

mode=${1:-}
case "$mode" in inspect|apply) ;;
  *) exit 64 ;;
esac
if [[ $mode == apply ]]; then
  [[ ${ARCH_ROOT_DISK_GROWTH_CONFIRMED:-} == grow-reviewed-docker-root-disk ]]
fi

root_source=$(findmnt --noheadings --output SOURCE --target / | xargs)
root_fstype=$(findmnt --noheadings --output FSTYPE --target / | xargs)
[[ $root_source == /dev/sda1 && $root_fstype == ext4 ]]
[[ $(lsblk --noheadings --output PKNAME /dev/sda1 | xargs) == sda ]]
[[ $(lsblk --nodeps --noheadings --output TYPE /dev/sda | xargs) == disk ]]
[[ $(lsblk --noheadings --output TYPE /dev/sda1 | xargs) == part ]]
[[ $(lsblk --noheadings --output TYPE /dev/sda | grep -c '^part$') == 1 ]]

filesystem_size_bytes() {
  local metadata block_count block_size
  metadata=$(LC_ALL=C tune2fs -l /dev/sda1 2>/dev/null)
  block_count=$(awk -F: '$1 == "Block count" {gsub(/[[:space:]]/, "", $2); print $2; exit}' <<<"$metadata")
  block_size=$(awk -F: '$1 == "Block size" {gsub(/[[:space:]]/, "", $2); print $2; exit}' <<<"$metadata")
  [[ $block_count =~ ^[0-9]+$ && $block_size =~ ^[0-9]+$ ]]
  printf '%s\n' "$((block_count * block_size))"
}

desired_disk_bytes=$((550 * 1024 * 1024 * 1024))
disk_tolerance_bytes=$((64 * 1024 * 1024))
tolerance_bytes=$((2 * 1024 * 1024 * 1024))
observed_partition_bytes=$((400 * 1024 * 1024 * 1024))
minimum_partition_bytes=$((desired_disk_bytes - tolerance_bytes))
maximum_partition_bytes=$((desired_disk_bytes + disk_tolerance_bytes))
minimum_filesystem_bytes=$((desired_disk_bytes - (2 * tolerance_bytes)))
disk_bytes=$(blockdev --getsize64 /dev/sda)
partition_bytes=$(blockdev --getsize64 /dev/sda1)
filesystem_bytes=$(filesystem_size_bytes)
((disk_bytes >= desired_disk_bytes && disk_bytes <= desired_disk_bytes + disk_tolerance_bytes)) || {
  echo "root_disk_growth=failed reason=virtual_disk_identity_mismatch" >&2
  exit 1
}

partition_requires_growth=false
if ((partition_bytes >= minimum_partition_bytes && partition_bytes <= maximum_partition_bytes)); then
  if ((filesystem_bytes >= minimum_filesystem_bytes && filesystem_bytes <= partition_bytes)); then
    printf 'root_disk_growth=converged\n'
    exit 0
  fi
elif ((
  partition_bytes >= observed_partition_bytes - tolerance_bytes &&
  partition_bytes <= observed_partition_bytes + tolerance_bytes
)); then
  partition_requires_growth=true
else
  echo "root_disk_growth=failed reason=partition_geometry_mismatch" >&2
  exit 1
fi
if [[ $mode == inspect ]]; then
  printf 'root_disk_growth=pending\n'
  exit 2
fi

if [[ $partition_requires_growth == true ]]; then
  growpart /dev/sda 1 >/dev/null
fi
resize2fs /dev/sda1 >/dev/null
partition_bytes=$(blockdev --getsize64 /dev/sda1)
filesystem_bytes=$(filesystem_size_bytes)
((partition_bytes >= minimum_partition_bytes && partition_bytes <= maximum_partition_bytes))
((filesystem_bytes >= minimum_filesystem_bytes && filesystem_bytes <= partition_bytes))
printf 'root_disk_growth=verified\n'
