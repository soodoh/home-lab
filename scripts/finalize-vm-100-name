#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

readonly VMID=100
readonly EXPECTED_CURRENT_NAME=arch
readonly DESIRED_NAME=docker-host
readonly CONFIRMATION=rename-reviewed-vm-100-to-docker-host
readonly OPERATION_LOCK=/var/lib/home-lab/reconciliation/operation.lock
readonly APPLY_LOCK=/var/lib/home-lab/reconciliation/apply.lock
readonly ANSIBLE_LOCK=/var/lib/iac-ansible-production.lock
readonly EVIDENCE=/var/lib/home-lab/retirement/vm-100-name-finalized.json

fail() { echo "vm_name_finalization=failed reason=$*" >&2; exit 1; }
config_value() { qm config "$VMID" | awk -F': ' -v key="$1" '$1 == key {print $2}'; }

[[ $(id -u) -eq 0 ]] || fail root_required
for command in awk flock jq qm stat; do command -v "$command" >/dev/null || fail "missing_command_$command"; done
[[ -c /dev/tty ]] || fail physical_console_tty_required
[[ -f $OPERATION_LOCK && ! -L $OPERATION_LOCK ]] || fail operation_lock_unsafe
[[ $(stat -c '%U:%G:%a' "$OPERATION_LOCK") == root:root:600 ]] || fail operation_lock_metadata
[[ ! -e $APPLY_LOCK && ! -e $ANSIBLE_LOCK ]] || fail another_apply_lock_exists
exec 9>>"$OPERATION_LOCK"
[[ $(stat -Lc '%d:%i' "$OPERATION_LOCK") == $(stat -Lc '%d:%i' /proc/$$/fd/9) ]] || fail operation_lock_identity_changed
flock -n 9 || fail operation_lock_held

[[ $(qm status "$VMID" | awk '{print $2}') == running ]] || fail vm_not_running
[[ $(config_value name) == "$EXPECTED_CURRENT_NAME" ]] || fail current_name_differs
[[ $(config_value boot) == 'order=scsi3;net0' ]] || fail boot_order_differs
[[ $(config_value protection) == 1 ]] || fail protection_differs
[[ -z $(config_value scsi0) && -z $(config_value unused0) ]] || fail retired_disk_reference_present
scsi1_before=$(config_value scsi1)
scsi2_before=$(config_value scsi2)
scsi3_before=$(config_value scsi3)
[[ -n $scsi1_before && -n $scsi2_before && -n $scsi3_before ]] || fail protected_disk_missing

guest=$(qm guest exec "$VMID" -- /bin/bash -lc "test \"\$(hostname)\" = docker-host && test \"\$(docker ps -q | wc -l)\" -eq 41 && test \"\$(docker ps --filter health=unhealthy -q | wc -l)\" -eq 0")
jq -e '.exitcode == 0' <<<"$guest" >/dev/null || fail guest_health_failed
printf 'Type the exact confirmation:\n%s\n' "$CONFIRMATION" >/dev/tty
IFS= read -r value </dev/tty
[[ $value == "$CONFIRMATION" ]] || fail confirmation_invalid

qm set "$VMID" --name "$DESIRED_NAME" >/dev/null
[[ $(config_value name) == "$DESIRED_NAME" ]] || fail name_not_finalized
[[ $(config_value protection) == 1 ]] || fail protection_changed
[[ $(config_value boot) == 'order=scsi3;net0' ]] || fail boot_order_changed
[[ $(config_value scsi1) == "$scsi1_before" ]] || fail scsi1_changed
[[ $(config_value scsi2) == "$scsi2_before" ]] || fail scsi2_changed
[[ $(config_value scsi3) == "$scsi3_before" ]] || fail scsi3_changed
[[ -z $(config_value scsi0) && -z $(config_value unused0) ]] || fail retired_disk_reference_restored

install -d -o root -g root -m 0700 "$(dirname "$EVIDENCE")"
tmp=$(mktemp "${EVIDENCE}.XXXXXX")
jq -n --arg observedAt "$(date -u +%FT%TZ)" '{schemaVersion:1,observedAt:$observedAt,vmid:100,previousName:"arch",name:"docker-host",boot:"order=scsi3;net0",protection:true,scsi0:null,unused0:null,scsi1Changed:false,scsi2Changed:false,scsi3Changed:false,containers:41,unhealthy:0}' >"$tmp"
chown root:root "$tmp"
chmod 0600 "$tmp"
mv "$tmp" "$EVIDENCE"
echo vm_name_finalization=complete
