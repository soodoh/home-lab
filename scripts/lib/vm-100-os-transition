#!/bin/bash
# Shared guarded transition primitives for VM 100 candidate operating systems.
# Callers must define VMID, ARCH_BOOT, VFIO_CONFIRMATION, RECONCILIATION_ROOT,
# DIAGNOSTIC_ROOT, and RESTORE_LOG before sourcing this file.

fail() {
  echo "error: $*" >&2
  return 1
}

vm_status() {
  qm status "$VMID" | awk '{print $2}'
}

wait_for_status() {
  local expected=$1 timeout=$2
  for ((second = 0; second < timeout; second += 2)); do
    [[ $(vm_status) == "$expected" ]] && return 0
    sleep 2
  done
  return 1
}

wait_for_agent() {
  local timeout=$1
  for ((second = 0; second < timeout; second += 3)); do
    qm guest cmd "$VMID" ping >/dev/null 2>&1 && return 0
    sleep 3
  done
  return 1
}

os_id() {
  qm guest cmd "$VMID" get-osinfo 2>/dev/null | jq -er '.id'
}

acquire_transition_locks() {
  [[ ${locks_held:-false} == false ]] || return 0
  exec 9>"$RECONCILIATION_ROOT/operation.lock"
  flock -n 9 || return 1
  exec 8>/run/lock/home-lab-flatcar-first-boot.lock
  if ! flock -n 8; then
    flock -u 9
    exec 9>&-
    return 1
  fi
  locks_held=true
}

release_transition_locks() {
  [[ ${locks_held:-false} == true ]] || return 0
  flock -u 8
  exec 8>&-
  flock -u 9
  exec 9>&-
  locks_held=false
}

exec_without_transition_lock_fds() (
  exec 8>&-
  exec 9>&-
  exec "$@"
)

start_with_recovery() {
  local result
  if exec_without_transition_lock_fds qm start "$VMID"; then
    return 0
  else
    result=$?
  fi
  wait_for_status running 15 && return 0
  [[ $(vm_status) == stopped ]] || return "$result"
  exec_without_transition_lock_fds /usr/local/sbin/home-lab-vfio-recover recover --confirm "$VFIO_CONFIRMATION"
  exec_without_transition_lock_fds qm start "$VMID" || wait_for_status running 15
}

start_without_lock_inheritance() {
  start_with_recovery
}

start_console_capture() {
  install -d -o root -g root -m 0700 "$DIAGNOSTIC_ROOT"
  install -o root -g root -m 0600 /dev/null "$CONSOLE_LOG"
  for ((attempt = 0; attempt < 20; attempt += 1)); do
    [[ -S $SERIAL_SOCKET ]] && break
    sleep 1
  done
  [[ -S $SERIAL_SOCKET ]] || return 1
  exec_without_transition_lock_fds timeout 630 socat -u "UNIX-CONNECT:$SERIAL_SOCKET" - > "$CONSOLE_LOG" 2>&1 &
  console_pid=$!
}

start_console_capture_without_lock_inheritance() {
  start_console_capture
}

stop_console_capture() {
  if [[ -n ${console_pid:-} ]]; then
    kill "$console_pid" 2>/dev/null || true
    wait "$console_pid" 2>/dev/null || true
    console_pid=
  fi
}

write_diagnostic_json() {
  local target=$1 state=$2 detail_stage=$3 ping_state=$4 ssh_state=$5 agent_state=$6 console_sha=$7
  local temporary
  temporary=$(mktemp --tmpdir="$DIAGNOSTIC_ROOT" .first-boot-diagnostic.XXXXXX)
  jq -cn --arg agent "$agent_state" --arg consoleSha256 "$console_sha" --arg ping "$ping_state" \
    --arg ssh "$ssh_state" --arg stage "$detail_stage" --arg state "$state" \
    '{agent:$agent,consoleSha256:$consoleSha256,ping:$ping,ssh:$ssh,stage:$stage,state:$state,vmid:100}' > "$temporary"
  chmod 0600 "$temporary"
  chown root:root "$temporary"
  mv -f -- "$temporary" "$target"
}

restore_arch() {
  local restored=true restore_stage=shutdown-candidate
  echo "Restoring the Arch boot path" >&2
  if [[ $(vm_status) != stopped ]]; then
    timeout 15 qm guest cmd "$VMID" shutdown >/dev/null 2>&1 || timeout 75 qm shutdown "$VMID" --timeout 60 || true
    if ! wait_for_status stopped 30; then
      restore_stage=force-stop-candidate
      qm stop "$VMID" || restored=false
      wait_for_status stopped 30 || restored=false
    fi
  fi
  restore_stage=wait-candidate-stopped
  wait_for_status stopped 30 || restored=false
  if [[ $restored == true ]] && declare -F prepare_arch_restore >/dev/null; then
    restore_stage=prepare-arch-restore
    prepare_arch_restore || restored=false
  fi
  restore_stage=set-arch-boot
  qm set "$VMID" --boot "$ARCH_BOOT" --vga none || restored=false
  if [[ $restored == true && ${ARCH_RESTORE_REQUIRES_HOST_REBOOT:-false} == true ]]; then
    restore_stage=verify-arch-reboot-path
    [[ $(vm_status) == stopped ]] || restored=false
    [[ $(qm config "$VMID" | awk -F ': ' '$1 == "boot" { print $2 }') == "$ARCH_BOOT" ]] || restored=false
    [[ $(qm config "$VMID" | awk -F ': ' '$1 == "onboot" { print $2 }') == 1 ]] || restored=false
    if [[ $restored == true ]]; then
      write_diagnostic_json "$RESTORE_LOG" arch-reboot-prepared complete unknown unknown unavailable empty
      echo "Exact Arch boot path prepared; a physical Proxmox host reboot is required" >&2
      return 0
    fi
  fi
  if [[ $restored == true ]]; then
    restore_stage=start-arch
    start_without_lock_inheritance || true
    restore_stage=wait-arch-running
    if wait_for_status running 120; then
      acquire_transition_locks || restored=false
    else
      restored=false
    fi
  fi
  if [[ $restored == true ]]; then
    restore_stage=wait-arch-agent
    wait_for_agent 600 || restored=false
  fi
  if [[ $restored == true ]]; then
    restore_stage=verify-arch-identity
    [[ $(os_id) == arch ]] || restored=false
  fi
  if [[ $restored == true ]] && declare -F verify_arch_post_restore >/dev/null; then
    restore_stage=verify-arch-workloads
    verify_arch_post_restore || restored=false
  fi
  if [[ $restored == true ]]; then
    write_diagnostic_json "$RESTORE_LOG" arch-restored complete reachable reachable ready empty
    echo "Arch production boot path restored" >&2
    return 0
  fi
  write_diagnostic_json "$RESTORE_LOG" arch-restore-incomplete "$restore_stage" unknown unknown unknown empty
  echo "critical: automatic Arch restoration did not complete at stage $restore_stage; remain at the physical console" >&2
  return 1
}
