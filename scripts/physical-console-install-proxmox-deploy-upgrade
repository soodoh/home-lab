#!/usr/bin/env bash
set -euo pipefail

if [[ $(id -u) -ne 0 ]]; then
  echo "must run directly as root" >&2
  exit 77
fi
case "$(tty)" in
  /dev/tty[0-9]*) ;;
  *) echo "physical /dev/ttyN console required" >&2; exit 77 ;;
esac
if [[ $# -ne 7 ]]; then
  echo "usage: $0 PLAN_SHA256 AUTHORIZATION_SHA256 COMMIT OLD_ACTIVATOR_SHA256 NEW_ACTIVATOR_SHA256 OLD_TRANSPORT_SHA256 NEW_TRANSPORT_SHA256" >&2
  exit 64
fi
plan_sha256=$1
authorization_sha256=$2
commit=$3
old_activator_sha256=$4
new_activator_sha256=$5
old_transport_sha256=$6
new_transport_sha256=$7
for value in "$plan_sha256" "$authorization_sha256" "$old_activator_sha256" "$new_activator_sha256" "$old_transport_sha256" "$new_transport_sha256"; do
  [[ $value =~ ^[0-9a-f]{64}$ ]] || exit 64
done
[[ $commit =~ ^[0-9a-f]{40}$ ]] || exit 64

repo=/root/home-lab
helper_root=/usr/local/libexec/home-lab
activator=$helper_root/proxmox-ansible-deploy-activator
transport=$helper_root/proxmox-ansible-deploy-transport
source_activator=$repo/infrastructure/proxmox-access/host/proxmox-ansible-deploy-activator
source_transport=$repo/infrastructure/proxmox-access/host/proxmox-ansible-deploy-transport
transaction_root=/var/lib/home-lab/deploy-upgrade-transactions/$plan_sha256
lock=/run/lock/home-lab-proxmox-deploy-upgrade.lock

exec 9>"$lock"
flock -n 9 || { echo "deploy upgrade lock is active" >&2; exit 75; }
for active in /var/lib/home-lab/reconciliation/apply.lock /var/lib/iac-ansible-production.lock /var/lib/home-lab/firewall-transaction/active.json; do
  [[ ! -e $active ]] || { echo "conflicting lifecycle lock is active: $active" >&2; exit 75; }
done
[[ -d $repo/.git && ! -L $repo ]] || exit 77
[[ -z $(git -C "$repo" status --porcelain=v1 --untracked-files=all) ]] || { echo "repository is dirty" >&2; exit 65; }
git -C "$repo" fetch --quiet origin main
[[ $(git -C "$repo" rev-parse origin/main) == "$commit" ]] || { echo "origin/main differs" >&2; exit 65; }
git -C "$repo" merge --ff-only "$commit"
[[ $(git -C "$repo" rev-parse HEAD) == "$commit" ]] || exit 65
[[ $(sha256sum "$activator" | cut -d' ' -f1) == "$old_activator_sha256" ]] || { echo "installed activator differs" >&2; exit 65; }
[[ $(sha256sum "$transport" | cut -d' ' -f1) == "$old_transport_sha256" ]] || { echo "installed transport differs" >&2; exit 65; }
[[ $(sha256sum "$source_activator" | cut -d' ' -f1) == "$new_activator_sha256" ]] || { echo "source activator differs" >&2; exit 65; }
[[ $(sha256sum "$source_transport" | cut -d' ' -f1) == "$new_transport_sha256" ]] || { echo "source transport differs" >&2; exit 65; }

umask 077
mkdir -p "$transaction_root"
chmod 0700 "$transaction_root"
[[ ! -e $transaction_root/committed.json ]] || { echo "transaction already committed" >&2; exit 73; }
cp --preserve=mode,ownership,timestamps "$activator" "$transaction_root/activator.before"
cp --preserve=mode,ownership,timestamps "$transport" "$transaction_root/transport.before"
chmod 0600 "$transaction_root/activator.before" "$transaction_root/transport.before"

changed=false
rollback() {
  if [[ $changed == true ]]; then
    install -o root -g root -m 0755 "$transaction_root/activator.before" "$activator"
    install -o root -g root -m 0755 "$transaction_root/transport.before" "$transport"
    sync -f "$helper_root"
  fi
}
trap rollback ERR HUP INT TERM
install -o root -g root -m 0755 "$source_activator" "$activator.new"
install -o root -g root -m 0755 "$source_transport" "$transport.new"
sync "$activator.new" "$transport.new"
changed=true
mv -T "$activator.new" "$activator"
mv -T "$transport.new" "$transport"
sync -f "$helper_root"
[[ $(sha256sum "$activator" | cut -d' ' -f1) == "$new_activator_sha256" ]]
[[ $(sha256sum "$transport" | cut -d' ' -f1) == "$new_transport_sha256" ]]
[[ $(stat -c '%u:%g:%a:%h' "$activator") == 0:0:755:1 ]]
[[ $(stat -c '%u:%g:%a:%h' "$transport") == 0:0:755:1 ]]

observation=$(runuser -u ansible-deploy -- env SSH_ORIGINAL_COMMAND='observe package-lifecycle' "$transport")
printf '%s' "$observation" | python3 -c 'import json,sys; v=json.load(sys.stdin); assert v["format"] == "home-lab-proxmox-package-ownership-observation-v1" and v["parity_complete"] is True and v["protected_values_exported"] is False and not v["active_lifecycle_locks"] and not v["active_apt_locks"]'

PLAN_SHA256=$plan_sha256 AUTHORIZATION_SHA256=$authorization_sha256 COMMIT=$commit \
ACTIVATOR_SHA256=$new_activator_sha256 TRANSPORT_SHA256=$new_transport_sha256 \
python3 - "$transaction_root/committed.json" <<'PY'
import json, os, pathlib, sys
path = pathlib.Path(sys.argv[1])
value = {
    "activator_sha256": os.environ["ACTIVATOR_SHA256"],
    "authorization_sha256": os.environ["AUTHORIZATION_SHA256"],
    "changed": True,
    "commit": os.environ["COMMIT"],
    "format": "home-lab-proxmox-deploy-upgrade-install-v1",
    "plan_sha256": os.environ["PLAN_SHA256"],
    "transport_sha256": os.environ["TRANSPORT_SHA256"],
}
raw = (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
with os.fdopen(fd, "wb") as handle:
    handle.write(raw)
    handle.flush()
    os.fsync(handle.fileno())
directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
try:
    os.fsync(directory)
finally:
    os.close(directory)
print(json.dumps(value, sort_keys=True))
PY
trap - ERR HUP INT TERM
