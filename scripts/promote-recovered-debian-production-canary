#!/bin/bash
set -euo pipefail

readonly CONFIRMATION=promote-reviewed-vm-100-debian-canary-forensic-evidence

[[ $# -eq 0 ]] || { echo "usage: scripts/promote-recovered-debian-production-canary" >&2; exit 1; }
[[ -t 0 ]] || { echo "Recovered Debian production canary promotion requires an interactive physical console" >&2; exit 1; }
printf 'Type the exact confirmation to promote the recovered canary after forensic review:\n%s\n' "$CONFIRMATION" >&2
IFS= read -r confirmation
[[ $confirmation == "$CONFIRMATION" ]] || { echo "exact recovered-canary promotion confirmation is required" >&2; exit 1; }
export HOME_LAB_DEBIAN_QUALIFICATION_CONFIRMED=$CONFIRMATION
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
exec "$root/scripts/qualify-debian-inert"
