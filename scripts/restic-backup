#!/usr/bin/env python3
"""Small consistency adapter around native Restic and Docker Compose commands."""

from __future__ import annotations

import fcntl
from contextlib import ExitStack
import hashlib
import json
import importlib.util
import shutil
import signal
from datetime import datetime, timezone
import uuid
import os
import pwd
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any

SUBCOMMANDS = {"preflight", "daily-local", "daily-nfs", "daily-proton", "diagnose-proton", "maintenance", "status", "recover", "expire-snapshots"}
SNAPSHOT_ID = re.compile(r"^[0-9a-f]{64}$")


class WorkflowError(RuntimeError):
    pass


def fail(reason: str) -> None:
    print(f"restic_backup=failed reason={reason}", file=sys.stderr)
    raise SystemExit(1)


def testing() -> bool:
    return os.environ.get("HOME_LAB_RESTIC_TESTING") == "1"


def rooted(path: str) -> Path:
    candidate = Path(path)
    if testing():
        return Path(os.environ["HOME_LAB_RESTIC_TEST_ROOT"]).resolve() / candidate.relative_to("/")
    return candidate


def require_regular(
    path: Path,
    modes: set[int],
    owners: set[int] | None = None,
    groups: set[int] | None = None,
) -> None:
    if not testing():
        for parent in path.parents:
            if parent == Path("/"):
                break
            try:
                if parent.is_symlink():
                    raise WorkflowError("protected_parent_symlink")
            except OSError as error:
                raise WorkflowError("protected_parent_missing") from error
    try:
        metadata = path.lstat()
    except OSError as error:
        raise WorkflowError("protected_file_missing") from error
    if path.is_symlink() or not path.is_file() or metadata.st_nlink != 1:
        raise WorkflowError("protected_file_type")
    if metadata.st_mode & 0o777 not in modes:
        raise WorkflowError("protected_file_mode")
    if owners is not None and metadata.st_uid not in owners:
        raise WorkflowError("protected_file_owner")
    if groups is not None and metadata.st_gid not in groups:
        raise WorkflowError("protected_file_group")


def load_policy() -> tuple[dict[str, Any], str]:
    path = rooted("/etc/home-lab/restic-policy.json")
    require_regular(path, {0o440, 0o600, 0o640, 0o644}, None if testing() else {0})
    raw = path.read_bytes()
    try:
        policy = json.loads(raw)
    except json.JSONDecodeError as error:
        raise WorkflowError("policy_json") from error
    if not isinstance(policy, dict) or policy.get("policy_version") != 1:
        raise WorkflowError("policy_schema")
    return policy, hashlib.sha256(raw).hexdigest()


def run(
    arguments: list[str], *, environment: dict[str, str] | None = None, timeout: int = 7200,
) -> subprocess.CompletedProcess[str]:
    if not arguments or any(not isinstance(argument, str) or not argument for argument in arguments):
        raise WorkflowError("command_shape")
    merged = {"PATH": "/usr/local/bin:/usr/bin:/bin", "HOME": "/var/empty", "LC_ALL": "C", "TZ": "UTC"}
    if environment:
        merged.update(environment)
    try:
        return subprocess.run(
            arguments,
            check=False,
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            env=merged,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise WorkflowError("command_execution") from error


def require_success(result: subprocess.CompletedProcess[str], reason: str) -> None:
    if result.returncode != 0:
        raise WorkflowError("restic_partial_source" if result.returncode == 3 else reason)


def report_phase(phase: str, started: float) -> None:
    print(f"restic_backup=phase name={phase} seconds={time.monotonic() - started:.1f}")


def proton_identity() -> tuple[int, int]:
    if testing():
        return os.getuid(), os.getgid()
    try:
        record = pwd.getpwnam("restic-proton")
    except KeyError as error:
        raise WorkflowError("proton_identity_missing") from error
    return record.pw_uid, record.pw_gid


def fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def durable_unlink(path: Path) -> None:
    path.unlink(missing_ok=True)
    fsync_directory(path.parent)


def atomic_json(path: Path, value: object, mode: int = 0o600) -> None:
    if testing():
        path.parent.mkdir(parents=True, exist_ok=True)
    parent_metadata = path.parent.lstat()
    if path.parent.is_symlink() or not path.parent.is_dir() or parent_metadata.st_uid not in {0, os.getuid()} or parent_metadata.st_mode & 0o022:
        raise WorkflowError("evidence_parent_metadata")
    if path.exists():
        require_regular(path, {mode}, {os.getuid()}, {parent_metadata.st_gid})
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, mode)
        os.fchown(descriptor, -1, parent_metadata.st_gid)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(value, stream, sort_keys=True, separators=(",", ":"))
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        temporary.replace(path)
        fsync_directory(path.parent)
    finally:
        temporary.unlink(missing_ok=True)


def read_json(path: Path, default: object) -> object:
    if path.is_symlink():
        raise WorkflowError('protected_file_type')
    if not path.exists():
        return default
    parent = path.parent.lstat()
    require_regular(path, {0o600}, {os.getuid()}, {parent.st_gid})
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise WorkflowError("evidence_json") from error


def repository_environment(policy: dict[str, Any], destination: str, source: str | None = None) -> dict[str, str]:
    credential_root = rooted("/etc/home-lab/restic/credentials")
    local_password = credential_root / "local-password"
    proton_password = credential_root / "proton-password"
    selected = local_password if policy["repositories"][destination]["password"] == "local" else proton_password
    require_regular(selected, {0o400, 0o440}, None if testing() else {0})
    confined = destination == "proton" or (not testing() and os.geteuid() != 0)
    cache = rooted(policy["runner"]["proton_cache_path"] if confined else policy["runner"]["local_cache_path"])
    cache_metadata = cache.lstat()
    expected_owner = proton_identity()[0] if confined else 0
    if cache.is_symlink() or not cache.is_dir() or cache_metadata.st_uid != expected_owner or cache_metadata.st_mode & 0o777 != 0o700:
        raise WorkflowError("cache_metadata")
    environment = {"RESTIC_PASSWORD_FILE": str(selected), "RESTIC_CACHE_DIR": str(cache)}
    if source is not None:
        source_password = local_password if policy["repositories"][source]["password"] == "local" else proton_password
        require_regular(source_password, {0o400, 0o440}, None if testing() else {0})
        environment["RESTIC_FROM_PASSWORD_FILE"] = str(source_password)
    if destination == "proton":
        config = rooted("/var/lib/restic-proton/rclone.conf")
        require_regular(config, {0o600}, None if testing() else {proton_identity()[0]})
        environment.update({"RCLONE_CONFIG": str(config), "HOME": str(config.parent)})
    return environment


def restic_result(
    policy: dict[str, Any], name: str, arguments: list[str], *, source: str | None = None,
    timeout: int = 7200,
) -> subprocess.CompletedProcess[str]:
    command = [policy["tools"]["restic"]["installed_path"], "--repo", policy["repositories"][name]["path"]]
    if source is not None:
        command.extend(["--from-repo", policy["repositories"][source]["path"]])
    environment = repository_environment(policy, name, source)
    if name == 'proton' and os.geteuid() == 0 and not testing():
        command = ['/usr/sbin/runuser', '--user', 'restic-proton', '--', '/usr/bin/env',
                   *[f'{k}={v}' for k, v in environment.items()], *command]
        environment = {}
    return run([*command, *arguments], environment=environment, timeout=timeout)


def verify_repository(policy: dict[str, Any], name: str) -> dict[str, Any]:
    result = restic_result(policy, name, ["cat", "config"])
    require_success(result, f"repository_open_{name}")
    try:
        config = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise WorkflowError(f"repository_id_{name}") from error
    if not isinstance(config, dict) or config.get("id") != policy["repositories"][name]["id"]:
        raise WorkflowError(f"repository_id_{name}")
    if not isinstance(config.get("chunker_polynomial"), str):
        raise WorkflowError(f"repository_chunker_{name}")
    return config


def preflight(policy: dict[str, Any], names: list[str]) -> None:
    if not testing():
        for name in set(names) & {'games', 'nfs'}:
            repository = policy['repositories'][name]
            identity = {'fstype': repository['filesystem']}
            identity['uuid' if name == 'games' else 'source'] = repository.get('filesystem_uuid', repository.get('mount_source'))
            mount = {'path': repository['path'], 'identity': identity}
            if name == 'nfs':
                mount['bind_root'] = repository['mountpoint']
            verify_sources({'capture': {'mounts': [mount]}})
    configs = {name: verify_repository(policy, name) for name in names}
    if "games" in configs:
        chunker = configs["games"]["chunker_polynomial"]
        if any(config["chunker_polynomial"] != chunker for config in configs.values()):
            raise WorkflowError("repository_chunker_mismatch")


def compose(policy: dict[str, Any], arguments: list[str]) -> subprocess.CompletedProcess[str]:
    command = policy["runner"].get("compose_command") or [
        "/usr/bin/docker", "compose", "--project-name", "docker-compose",
        "--project-directory", "/srv/docker-compose/current", "--env-file", "/etc/docker-compose/production.env",
        "--file", "/srv/docker-compose/current/docker-compose.yml",
    ]
    return run([*command, *arguments], timeout=300)


def declared_services(policy: dict[str, Any]) -> set[str]:
    result = compose(policy, ["config", "--services"])
    require_success(result, "service_declaration")
    services = result.stdout.splitlines()
    if not services or len(services) != len(set(services)) or any(
        re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_.-]*", service) is None for service in services
    ):
        raise WorkflowError("service_declaration_output")
    return set(services)


def service_container(policy: dict[str, Any], service: str) -> str:
    result = compose(policy, ["ps", "--all", "--quiet", service])
    require_success(result, "service_inventory")
    containers = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    if len(containers) != 1 or re.fullmatch(r"[0-9a-f]{64}", containers[0]) is None:
        raise WorkflowError("service_inventory_output")
    return containers[0]


def service_running(policy: dict[str, Any], service: str) -> bool:
    result = run(["/usr/bin/docker", "inspect", "--format", "{{.State.Running}}", service_container(policy, service)], timeout=30)
    require_success(result, "service_inventory")
    if result.stdout.strip() not in {"true", "false"}:
        raise WorkflowError("service_inventory_output")
    return result.stdout.strip() == "true"


def service_healthy(policy: dict[str, Any], service: str) -> bool:
    try:
        container = service_container(policy, service)
    except WorkflowError:
        return False
    result = run([
        "/usr/bin/docker", "inspect", "--format",
        "{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}", container,
    ], timeout=30)
    return result.returncode == 0 and result.stdout.strip() in {"healthy", "running"}


def nextcloud_healthy(policy):
    try:
        container = service_container(policy, 'nextcloud')
        result = run(['/usr/bin/docker', 'exec', '--user', 'www-data', container,
                      'php', '/var/www/html/occ', 'status', '--output=json'], timeout=30)
        value = json.loads(result.stdout)
        data = rooted('/mnt/storage/media/nextcloud/data')
        marker = any((data / name).is_file() and not (data / name).is_symlink()
                     for name in ('.ncdata', '.ocdata'))
        return (result.returncode == 0 and value.get('installed') is True and marker and
                value.get('maintenance') is False and value.get('needsDbUpgrade') is False)
    except (WorkflowError, ValueError, AttributeError):
        return False


def journal_path(policy: dict[str, Any]) -> Path:
    return rooted(policy["runner"]["journal_path"])


def restart_recorded(policy: dict[str, Any], journal: dict[str, Any]) -> None:
    running = set(journal.get("running_services", []))
    stop_order = journal.get("stop_order", [*policy["stop_groups"]["applications"], *policy["stop_groups"]["databases"]])
    for service in reversed(stop_order):
        if service in running:
            require_success(compose(policy, ["start", service]), "service_restart")
            if service == "gluetun":
                # Its network-namespace clients require a healthy VPN before start.
                deadline = time.monotonic() + (3 if testing() else 300)
                while time.monotonic() < deadline:
                    if service_healthy(policy, service):
                        break
                    time.sleep(0.1 if testing() else 5)
                else:
                    raise WorkflowError("service_health")
    deadline = time.monotonic() + (3 if testing() else 300)
    while time.monotonic() < deadline:
        if (all(service_healthy(policy, service) for service in running) and
                ('nextcloud' not in running or nextcloud_healthy(policy))):
            durable_unlink(journal_path(policy))
            return
        time.sleep(0.1 if testing() else 5)
    raise WorkflowError("service_health")


def recover_interruption(policy: dict[str, Any]) -> None:
    value = read_json(journal_path(policy), {})
    if value:
        if not isinstance(value, dict) or value.get("version") != 1 or not isinstance(value.get("running_services"), list):
            raise WorkflowError("journal_schema")
        if value.get('owner') != policy.get('_owner'):
            raise WorkflowError('journal_owner')
        allowed = set(policy['stop_groups']['applications'] + policy['stop_groups']['databases'])
        running = value['running_services']
        order = value.get('stop_order', list(allowed))
        if (not isinstance(order, list) or any(not isinstance(s, str) or s not in allowed for s in running + order)
                or len(set(running)) != len(running) or len(set(order)) != len(order)
                or not set(running) <= set(order)):
            raise WorkflowError('journal_schema')
        restart_recorded(policy, value)


def restic_backup_time(value):
    # Restic accepts a zone-less, whole-second timestamp; run() pins TZ=UTC.
    stamp = datetime.fromisoformat(value.replace('Z', '+00:00'))
    if stamp.tzinfo is None:
        raise WorkflowError('capture_time')
    return stamp.astimezone(timezone.utc).strftime('%Y-%m-%d %H:%M:%S')


def artifact_hash(policy: dict[str, Any]) -> str:
    path = rooted(policy["runner"]["artifact_hash_path"])
    require_regular(path, {0o440, 0o444, 0o600, 0o640, 0o644}, None if testing() else {0})
    value = path.read_text(encoding="utf-8").strip()
    if SNAPSHOT_ID.fullmatch(value) is None:
        raise WorkflowError("artifact_hash")
    return value


def parse_backup_snapshot(result: subprocess.CompletedProcess[str]) -> str:
    snapshot = None
    for line in result.stdout.splitlines():
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            continue
        if message.get("message_type") == "summary":
            snapshot = message.get("snapshot_id")
    if not isinstance(snapshot, str) or SNAPSHOT_ID.fullmatch(snapshot) is None:
        raise WorkflowError("snapshot_id_missing")
    return snapshot


def same_capture(source, candidate):
    # Native Restic tag rewrites IDs; copy preserves the earliest original ID.
    return (candidate.get('original') == source.get('original', source['id'])
            and set(candidate.get('tags', [])) == set(source.get('tags', []))
            and all(candidate.get(k) == source.get(k) for k in ('time', 'tree', 'paths')))


def copy_snapshot(policy, source, destination, snapshot):
    # Let healthy transfers use the replica unit's full budget. Systemd bounds
    # the complete reconciliation, including inventory and retries, to 12h.
    require_success(restic_result(policy, destination, ['copy', snapshot['id']], source=source,
                                  timeout=12 * 3600), 'copy_' + destination)
    matches = [row for row in inventory(policy, destination) if same_capture(snapshot, row)]
    if len(matches) != 1:
        raise WorkflowError('snapshot_mapping')
    return matches[0]['id']


def capture_adapter(policy):
    path = Path(__file__).with_name('restic-capture-files.py')
    if hashlib.sha256(path.read_bytes()).hexdigest() != policy['capture']['adapter_sha256']:
        raise WorkflowError('capture_adapter_identity')
    if not testing():
        require_regular(path, {0o755}, {0})
    spec = importlib.util.spec_from_file_location('capture_files', path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def verify_sources(policy):
    # A mounted fallback directory is not a valid source. Match native mount
    # identities before reading or stopping anything.
    for mount in policy['capture']['mounts']:
        result = run(['/usr/bin/findmnt', '--json', '--nofsroot', '--target', mount['path'],
                      '--output', 'TARGET,FSTYPE,SOURCE,UUID'])
        require_success(result, 'source_mount')
        entries = json.loads(result.stdout).get('filesystems', [])
        if len(entries) != 1:
            raise WorkflowError('source_mount_identity')
        identity = dict(mount['identity'])
        if 'bind_root' in mount:
            # nfs-utils reports a systemd-bound repository as export/subtree.
            # Admit only the two exact target/source pairs, never arbitrary
            # suffixes, another repository or the whole export bound here.
            root = Path(mount['bind_root'])
            relative = Path(mount['path']).relative_to(root)
            if str(relative) == '.' or identity.get('fstype') != 'nfs4':
                raise WorkflowError('source_mount_identity')
            identity['target'] = str(root)
            if entries[0].get('target') == mount['path']:
                identity['target'] = mount['path']
                identity['source'] = identity['source'].rstrip('/') + '/' + str(relative)
        if any(entries[0].get(k) != v for k, v in identity.items()):
            raise WorkflowError('source_mount_identity')


def wolf_siblings(paths):
    ids = run(['/usr/bin/docker', 'ps', '--quiet', '--no-trunc'])
    require_success(ids, 'writer_inventory')
    selected = []
    for cid in ids.stdout.splitlines():
        if not SNAPSHOT_ID.fullmatch(cid):
            raise WorkflowError('writer_identity')
        result = run(['/usr/bin/docker', 'inspect', '--format', '{{json .Mounts}}', cid])
        require_success(result, 'writer_inventory')
        mounts = json.loads(result.stdout)
        if any(m.get('RW') and any(Path(m.get('Source', '/')).is_relative_to(p)
               or Path(p).is_relative_to(m.get('Source', '/')) for p in paths) for m in mounts):
            selected.append(cid)
    return selected


def verify_wolf_available(policy, adapter, step, declared):
    if not set(step['services']) <= declared:
        raise WorkflowError('capture_service_missing')
    own = {service_container(policy, s) for s in step['services']}
    if any(c not in own for c in wolf_siblings([step['wolf']])):
        raise WorkflowError('wolf_active_writer')
    for service in step['services']:
        if service_running(policy, service):
            adapter.wolf_idle(service_container(policy, service))


def zfs_state(policy, stage):
    adapter = capture_adapter(policy)
    value = read_json(stage / 'zfs-source.json', {})
    if (not isinstance(value, dict) or
            set(value) != {'version', 'capture', 'owner', 'production_owner', 'running_services', 'record'} or
            value['version'] != 1 or not isinstance(value['capture'], str) or
            re.fullmatch('[0-9a-f]{32}', value['capture']) is None or
            value['owner'] != hashlib.sha256(value['capture'].encode()).hexdigest() or
            value['production_owner'] != policy.get('_owner') or
            not isinstance(value['running_services'], list) or
            len(value['running_services']) != len(set(value['running_services'])) or
            not set(value['running_services']) <= {'nextcloud', 'nextcloud-cron'}):
        raise WorkflowError('snapshot_state')
    if value['record'] is not None:
        adapter.zfs_record(adapter.zfs_spec(policy), value['record'],
                           capture=value['capture'], owner=value['owner'])
    return value


def zfs_ready(policy, adapter, stage):
    value = zfs_state(policy, stage)
    if value['record'] is None:
        raise WorkflowError('snapshot_receipt_missing')
    spec = adapter.zfs_spec(policy)
    if time.time() - value['record']['created'] >= spec['expiry_seconds']:
        raise WorkflowError('snapshot_expired_cleanup_required')
    record = adapter.zfs_record(spec, adapter.zfs_call(spec, {
        'action': 'ready', 'capture': value['capture'], 'owner': value['owner'],
        'guid': value['record']['guid'],
    }), capture=value['capture'], owner=value['owner'])
    if record != value['record']:
        raise WorkflowError('snapshot_replaced')
    adapter.zfs_mount(spec, record, stage)


def zfs_release(policy, adapter, stage, backup):
    if not policy['capture'].get('zfs'):
        return
    value = zfs_state(policy, stage)
    if value['record'] is None:
        raise WorkflowError('snapshot_receipt_missing')
    adapter.zfs_unmount(stage)
    result = adapter.zfs_call(adapter.zfs_spec(policy), {
        'action': 'complete', 'capture': value['capture'], 'owner': value['owner'],
        'guid': value['record']['guid'], 'backup': backup,
    })
    if result.get('deleted') is not True:
        raise WorkflowError('snapshot_retained')


def snapshot_readers_present(stage):
    target = str(stage / 'files/mnt/storage/media/nextcloud/data')
    for process in Path('/proc').iterdir():
        if not process.name.isdigit():
            continue
        try:
            # Do not read arbitrary process arguments/environments. Only native
            # Restic mount namespaces are relevant; replica readers do not mount
            # this source. This also catches orphaned manual-backup children.
            if (process / 'comm').read_text().strip() != 'restic':
                continue
            if any(line.split()[4] == target for line in (process / 'mountinfo').read_text().splitlines()):
                return True
        except (FileNotFoundError, ProcessLookupError):
            continue
    return False


def expire_snapshots(policy):
    """Native hourly cleanup, serialized with capture and blocked by any owner.

    No owner is adopted or released here. Recovery must succeed first. Only a
    scheduled producer's known namespace/receipt may be abandoned after 72h.
    """
    if rooted(policy['runner']['deploy_lock_path']).exists():
        raise WorkflowError('snapshot_owner_requires_inspection')
    adapter = capture_adapter(policy)
    spec = adapter.zfs_spec(policy)
    verify_sources(policy)
    stage = rooted(policy['capture']['stage'])
    if stage.exists():
        metadata = stage.lstat()
        if stage.is_symlink() or not stage.is_dir() or metadata.st_uid != os.geteuid() or metadata.st_mode & 0o777 != 0o700:
            raise WorkflowError('snapshot_stage_metadata')
    if not testing():
        active = run(['/usr/bin/systemctl', 'show', 'home-lab-restic-daily-local.service',
                      '--property=ActiveState', '--value'], timeout=20)
        if (active.returncode or active.stdout.strip() not in {'inactive', 'failed'} or
                snapshot_readers_present(stage)):
            raise WorkflowError('snapshot_job_active')
    recover_interruption(policy)
    state = zfs_state(policy, stage) if (stage / 'zfs-source.json').exists() else None
    manifest = read_json(stage / 'manifest.json', {}) if stage.exists() else {}
    completed = qualified(inventory(policy, 'games'))
    records = adapter.zfs_inventory(spec)
    if state and not any(row['capture'] == state['capture'] for row in records):
        matches = [row for row in completed if 'capture=' + state['capture'] in row.get('tags', [])]
        if len(matches) != 1:
            raise WorkflowError('snapshot_missing_requires_inspection')
        if manifest and (('policy=' + manifest['policy']) not in matches[0].get('tags', []) or
                         ('artifact=' + manifest['artifact']) not in matches[0].get('tags', [])):
            raise WorkflowError('snapshot_completion_identity')
        # A successful destroy may have lost its acknowledgement. Complete is
        # idempotent, but still withdraws any exact leftover export before the
        # verified retry set is removed.
        zfs_release(policy, adapter, stage, matches[0]['id'])
        shutil.rmtree(stage)
        state, manifest = None, {}
        print('restic_backup=snapshot_cleanup outcome=complete')
    for record in records:
        token = record['capture']
        if record['owner'] != hashlib.sha256(token.encode()).hexdigest():
            raise WorkflowError('snapshot_owner_requires_inspection')
        if stage.exists() and (state is None or state['capture'] != token):
            raise WorkflowError('previous_capture_requires_inspection')
        matches = [row for row in completed if 'capture=' + token in row.get('tags', [])]
        if len(matches) > 1:
            raise WorkflowError('completion_mapping')
        if not matches and time.time() - record['created'] < spec['expiry_seconds']:
            continue
        # All captured writers remain as recorded; intentionally stopped services
        # stay stopped. A remote orphan with no local journal must pass the more
        # conservative requirement that both known Nextcloud writers are healthy.
        running = state['running_services'] if state else ['nextcloud', 'nextcloud-cron']
        if (any(not service_healthy(policy, service) for service in running) or
                ('nextcloud' in running and not nextcloud_healthy(policy))):
            raise WorkflowError('snapshot_recovery_not_verified')
        if state and state['record'] is not None and state['record'] != record:
            raise WorkflowError('snapshot_replaced')
        if matches and manifest and (('policy=' + manifest['policy']) not in matches[0].get('tags', []) or
                                     ('artifact=' + manifest['artifact']) not in matches[0].get('tags', [])):
            raise WorkflowError('snapshot_completion_identity')
        adapter.zfs_unmount(stage)
        action = {'action': 'complete' if matches else 'abandon', 'capture': token,
                  'owner': record['owner'], 'guid': record['guid']}
        if matches:
            action['backup'] = matches[0]['id']
        if adapter.zfs_call(spec, action).get('deleted') is not True:
            raise WorkflowError('snapshot_retained')
        if state:
            # The source is terminal and its unqualified retry set is explicitly
            # abandoned, never tagged complete or admitted to deployment.
            shutil.rmtree(stage)
            state = None
        print('restic_backup=snapshot_cleanup outcome=' + ('complete' if matches else 'abandoned'))


def cold_capture(policy, adapter, step, stage, declared):
    services = [s for s in step['services'] if s in declared]
    if len(services) != len(step['services']):
        raise WorkflowError('capture_service_missing')
    paths = list(step['paths'])
    links = {}
    if step.get('wolf'):
        more, links = adapter.wolf_paths(step['wolf'])
        paths.extend(more)
        verify_wolf_available(policy, adapter, step, declared)
    for path in paths:
        adapter.safe_source(path)
    running = [s for s in services if service_running(policy, s)]
    snapshot = step.get('snapshot') == 'zfs'
    if snapshot:
        if (set(services) != {'nextcloud', 'nextcloud-cron'} or
                adapter.ZFS_DATA_PATH not in paths or (stage / 'zfs-source.json').exists()):
            raise WorkflowError('snapshot_scope')
        paths.remove(adapter.ZFS_DATA_PATH)
        token = policy['_capture']
        state = {'version': 1, 'capture': token, 'owner': hashlib.sha256(token.encode()).hexdigest(),
                 'production_owner': policy.get('_owner'), 'running_services': running, 'record': None}
        atomic_json(stage / 'zfs-source.json', state)
    journal = {'version': 1, 'running_services': running, 'stop_order': services,
               'started_at': int(time.time()), 'owner': policy.get('_owner')}
    atomic_json(journal_path(policy), journal, 0o600)
    try:
        if running:
            require_success(compose(policy, ['stop', '--timeout', '120', *running]), 'service_stop')
        if any(service_running(policy, s) for s in services):
            raise WorkflowError('writer_not_stopped')
        if step.get('wolf') and wolf_siblings([step['wolf']]):
            # Recheck after shutting down its native launch authority. Do not
            # stop/recreate ephemeral game containers or infer daemon quiescence
            # from the exit of a Docker CLI caller.
            raise WorkflowError('wolf_active_writer')
        adapter.retry(lambda: adapter.copy_paths(paths, stage / 'files', rooted(policy['runner']['exclude_file_path'])))
        for dump in step.get('databases', []):
            adapter.retry(lambda: adapter.database_dump(dump, stage / 'databases' / dump['name']))
        if snapshot:
            adapter.command(['/usr/bin/sync', '--file-system', '/mnt/storage'])
            spec = adapter.zfs_spec(policy)
            # Intent precedes the side effect. A lost acknowledgement retains it;
            # there is no automatic re-create or fallback to mutable live data.
            state['record'] = adapter.zfs_record(spec, adapter.zfs_call(spec, {
                'action': 'create', 'capture': state['capture'], 'owner': state['owner'],
            }), capture=state['capture'], owner=state['owner'])
            atomic_json(stage / 'zfs-source.json', state)
    finally:
        restart_recorded(policy, journal)
    return links


def daily_local(policy: dict[str, Any], policy_hash: str) -> None:
    recover_interruption(policy)
    preflight(policy, ['games'])
    verify_sources(policy)
    adapter = capture_adapter(policy)
    settings = policy['capture']
    stage = rooted(settings['stage'])
    if stage.exists():
        manifest = read_json(stage / 'manifest.json', {})
        if (manifest.get('version') != 2 or manifest.get('policy') != policy_hash
                or manifest.get('artifact') != artifact_hash(policy)
                or manifest.get('owner') != policy.get('_owner')):
            raise WorkflowError('previous_capture_requires_inspection')
    else:
        declared = declared_services(policy)
        try:
            # Refuse ordinary gaming activity before leaving incomplete staging
            # or interrupting unrelated applications. Recheck at Wolf's window.
            for step in settings['cold']:
                if step.get('wolf'):
                    verify_wolf_available(policy, adapter, step, declared)
            adapter.radio_check(Path('/'), settings['radio_max_age_seconds'])
            if settings.get('zfs') and adapter.zfs_inventory(adapter.zfs_spec(policy), require_admissible=True):
                raise WorkflowError('previous_snapshot_requires_inspection')
            adapter.capacity_check(policy)
        except adapter.CaptureError as error:
            raise WorkflowError(str(error)) from None
        stage = adapter.fresh_stage(stage, settings['reserve_bytes'])
        manifest = None
    token = manifest['capture'] if manifest else uuid.uuid4().hex
    policy['_capture'] = token
    try:
        if manifest:
            completed = [r for r in qualified(inventory(policy, 'games')) if 'capture=' + token in r.get('tags', [])]
            if len(completed) > 1:
                raise WorkflowError('completion_mapping')
            if completed:
                zfs_release(policy, adapter, stage, completed[0]['id'])
                shutil.rmtree(stage)
                print(f"restic_backup=local snapshot={completed[0]['id']}")
                return
        if manifest is None:
            captured_at = datetime.now(timezone.utc).isoformat()
            links = {}
            captures = []
            for step in settings['cold']:
                started = time.monotonic()
                began = datetime.now(timezone.utc).isoformat()
                links.update(cold_capture(policy, adapter, step, stage, declared))
                captures.append({'name': step['name'], 'started_at': began,
                                 'finished_at': datetime.now(timezone.utc).isoformat()})
                report_phase('cold_capture_' + step['name'], started)
            online_started = datetime.now(timezone.utc).isoformat()
            for path in settings['live_files']:
                adapter.retry(lambda: adapter.copy_paths(
                    [path], stage / 'files', rooted(policy['runner']['exclude_file_path']),
                    online_sqlite=path.startswith(settings['jellyfin'].rstrip('/') + '/')))
            for path in settings['online_json']:
                adapter.acme_store(Path(path), stage / 'files' / path.lstrip('/'))
            auth = settings['cli_auth']
            adapter.cli_auth(auth, stage / 'files' / auth.lstrip('/'))
            adapter.jellyfin(Path(settings['jellyfin']), stage / 'native/jellyfin.zip')
            # Auxiliary plugin databases also get online backup semantics.
            jelly = Path(settings['jellyfin'])
            for db in [*jelly.glob('data/*.db'), *jelly.glob('plugins/**/*.db')]:
                if db.name != 'jellyfin.db':
                    adapter.retry(lambda: adapter.sqlite_backup(db, stage / 'files' / str(db).lstrip('/')))
            adapter.radio_check(stage / 'files', settings['radio_max_age_seconds'])
            manifest = {'version': 2, 'capture': token, 'captured_at': captured_at, 'artifact': artifact_hash(policy),
                        'owner': policy.get('_owner'), 'policy': policy_hash, 'links': links,
                        'captures': [*captures, {'name': 'online', 'started_at': online_started,
                                                'finished_at': datetime.now(timezone.utc).isoformat()}],
                        'databases': [d for s in settings['cold'] for d in s.get('databases', [])]}
            if settings.get('zfs'):
                manifest['zfs_source'] = zfs_state(policy, stage)['record']
            # A ready manifest is also a crash-recovery promise. Flush staged
            # files/metadata on this filesystem before publishing that promise.
            adapter.command(['/usr/bin/sync', '--file-system', str(stage)])
            atomic_json(stage / 'manifest.json', manifest, 0o600)
        if settings.get('zfs'):
            zfs_ready(policy, adapter, stage)
        captured_at = manifest['captured_at']
        args = ['backup', '--json', '--time', restic_backup_time(captured_at), '--tag', 'format=full-v2',
                '--tag', 'cadence=daily', '--tag', 'capture=' + token,
                '--tag', 'policy=' + policy_hash, '--tag', 'artifact=' + manifest['artifact']]
        if policy.get('_owner'):
            args.extend(['--tag', 'owner=' + policy['_owner']])
        args.append(str(stage))
        result = None
        for attempt in range(3):
            result = restic_result(policy, 'games', args)
            if result.returncode == 0:
                break
            if result.returncode == 3:
                raise WorkflowError('restic_partial_source')
            if attempt < 2:
                time.sleep(10)
        require_success(result, 'backup')
        snapshot = parse_backup_snapshot(result)
        if settings.get('zfs'):
            state = zfs_state(policy, stage)
            current = adapter.zfs_record(adapter.zfs_spec(policy), adapter.zfs_call(adapter.zfs_spec(policy), {
                'action': 'inspect', 'capture': state['capture'], 'owner': state['owner'],
            }), capture=state['capture'], owner=state['owner'])
            if current != state['record']:
                raise WorkflowError('snapshot_replaced')
        # Only verified exit-0 captures are eligible. Tagging changes the ID before
        # replication; a crash here leaves ineligible snapshots, never false success.
        # Copies hold shared source locks for up to their 12h service budget.
        # Wait natively within this invocation, not through rate-limited restarts;
        # allow subprocess headroom beyond the lock wait. All writers are resumed.
        require_success(restic_result(policy, 'games', [
            'tag', '--retry-lock', '12h', '--add', 'complete=full-v2', snapshot,
        ], timeout=13 * 3600), 'capture_completion')
        completed = [r for r in qualified(inventory(policy, 'games')) if 'capture=' + token in r.get('tags', [])]
        if len(completed) != 1:
            raise WorkflowError('completion_mapping')
        zfs_release(policy, adapter, stage, completed[0]['id'])
        shutil.rmtree(stage)
        print(f"restic_backup=local snapshot={completed[0]['id']}")
    except adapter.CaptureError as error:
        raise WorkflowError(str(error)) from None
    finally:
        if settings.get('zfs'):
            adapter.zfs_unmount(stage)


def inventory(policy, name):
    result = restic_result(policy, name, ['snapshots', '--json'])
    require_success(result, 'snapshot_inventory')
    rows = json.loads(result.stdout)
    if not isinstance(rows, list) or any(not isinstance(r, dict) or not SNAPSHOT_ID.fullmatch(r.get('id', '')) for r in rows):
        raise WorkflowError('snapshot_inventory')
    return rows


def qualified(records):
    return [r for r in records if {'complete=full-v2', 'format=full-v2', 'cadence=daily'} <= set(r.get('tags', []))]


def replication_sources(records):
    # Historical daily snapshots predate format tags. Preserve their replica-safe
    # lifecycle without ever admitting incomplete or unknown formatted captures.
    return qualified(records) + [r for r in records if 'cadence=daily' in r.get('tags', [])
                                 and not any(t.startswith('format=') for t in r.get('tags', []))]


def reconcile(policy, destination):
    preflight(policy, ['games', destination])
    sources = replication_sources(inventory(policy, 'games'))
    copies = inventory(policy, destination)
    for source in sorted(sources, key=lambda r: r['time']):
        matches = [r for r in copies if same_capture(source, r)]
        if len(matches) > 1:
            raise WorkflowError('snapshot_mapping')
        if not matches:
            for attempt in range(3):
                try:
                    copy_snapshot(policy, 'games', destination, source)
                    break
                except WorkflowError:
                    if attempt == 2:
                        raise
                    time.sleep(10)


def finish_retention(policy):
    """Resume exact replica deletions only after their source IDs disappeared.

    The caller holds the exclusive repository gate. Persisted IDs are bound to
    repository identities; no retention decision is reconstructed from ancestry
    after the source snapshot has been removed.
    """
    path = journal_path(policy).with_name('retention.json')
    pending = read_json(path, None)
    if pending is None and not path.exists():
        return
    names = ('games', 'nfs', 'proton')
    repositories = {name: policy['repositories'][name]['id'] for name in names}
    if (not isinstance(pending, dict) or pending.get('version') != 1
            or pending.get('repositories') != repositories
            or not isinstance(pending.get('snapshots'), list)):
        raise WorkflowError('retention_journal_schema')
    seen = {name: set() for name in names}
    for row in pending['snapshots']:
        if (not isinstance(row, dict) or set(row) != set(names)
                or any(not isinstance(row[name], str) or not SNAPSHOT_ID.fullmatch(row[name])
                       or row[name] in seen[name] for name in names)):
            raise WorkflowError('retention_journal_schema')
        for name in names:
            seen[name].add(row[name])
    remaining = {row['id'] for row in inventory(policy, 'games')}
    removed = [row for row in pending['snapshots'] if row['games'] not in remaining]
    for name in names[1:]:
        present = {row['id'] for row in inventory(policy, name)}
        ids = [row[name] for row in removed if row[name] in present]
        if ids:
            require_success(restic_result(policy, name, ['forget', *ids]), 'forget_copy')
            if set(ids) & {row['id'] for row in inventory(policy, name)}:
                raise WorkflowError('forget_copy_verify')
    durable_unlink(path)


def maintenance(policy: dict[str, Any]) -> None:
    scope = os.environ.get("HOME_LAB_RESTIC_MAINTENANCE_SCOPE")
    if journal_path(policy).exists() or rooted(policy['capture']['stage']).exists():
        raise WorkflowError('capture_pending')
    if scope not in {"local", "proton"}:
        raise WorkflowError("maintenance_scope")
    names = ['games', 'nfs', 'proton'] if scope == 'local' else ['proton']
    preflight(policy, names)
    subset = policy['retention']['read_data_subset']
    if scope == 'local':
        finish_retention(policy)
        records = inventory(policy, 'games')
        sources = replication_sources(records)
        replicas = {name: inventory(policy, name) for name in ('nfs', 'proton')}
        snapshots = []
        for source in sources:
            selected = {'games': source['id']}
            for name, rows in replicas.items():
                matches = [r for r in rows if same_capture(source, r)]
                if len(matches) != 1:
                    raise WorkflowError('retention_replication_pending')
                selected[name] = matches[0]['id']
            snapshots.append(selected)
        # Publish exact replica IDs before native source expiry. A crash before
        # expiry preserves every copy; a crash afterwards can resume deletion.
        atomic_json(journal_path(policy).with_name('retention.json'), {
            'version': 1, 'repositories': {name: policy['repositories'][name]['id'] for name in names},
            'snapshots': snapshots,
        })
        keep = policy['retention']
        retention = ['--group-by', keep['group_by'], '--keep-daily', str(keep['keep_daily']),
                     '--keep-weekly', str(keep['keep_weekly']), '--keep-monthly', str(keep['keep_monthly'])]
        # Native keep-tag protects every formatted capture during the legacy
        # pass, including incomplete/unknown formats that require inspection.
        legacy = ['forget', '--tag', 'cadence=daily', *retention]
        for tag in sorted({t for r in records for t in r.get('tags', []) if t.startswith('format=')}):
            legacy.extend(['--keep-tag', tag])
        require_success(restic_result(policy, 'games', legacy), 'forget_legacy')
        require_success(restic_result(policy, 'games', [
            'forget', '--tag', 'cadence=daily,format=full-v2,complete=full-v2', *retention]), 'forget_games')
        finish_retention(policy)
        for name in names:
            require_success(restic_result(policy, name, ['prune', '--max-repack-size', keep['prune_max_repack_size'],
                                                        '--max-unused', keep['prune_max_unused']]), 'prune')
    for name in names:
        require_success(restic_result(policy, name, ['check', '--read-data-subset', subset]), 'repository_check')
    print(f"restic_backup=maintenance scope={scope} repositories={len(names)} subset={subset}")


def diagnose_proton(policy: dict[str, Any]) -> None:
    preflight(policy, ["games", "proton"])
    require_success(restic_result(policy, "proton", ["check"]), "repository_check_proton")
    print("restic_backup=diagnose_proton repository_check=passed mutation=false")


def status(policy: dict[str, Any], policy_hash: str) -> None:
    repositories_ready = all(
        isinstance(value.get("id"), str) and SNAPSHOT_ID.fullmatch(value["id"])
        for value in policy["repositories"].values()
    )
    interruption = journal_path(policy).exists()
    artifact = artifact_hash(policy) if not testing() else "testing"
    print(
        f"restic_backup=status migration={policy['migration_state']} policy={policy_hash} "
        f"artifact={artifact} repositories_ready={str(repositories_ready).lower()} "
        f"interruption={str(interruption).lower()}"
    )


def capture_namespace():
    """Native mount isolation for manual as well as systemd-driven captures."""
    if os.stat('/proc/self/ns/mnt').st_ino == os.stat('/proc/1/ns/mnt').st_ino:
        os.execv('/usr/bin/unshare', ['/usr/bin/unshare', '--mount', '--propagation', 'private',
                                    '--', sys.executable, str(Path(__file__).resolve()), *sys.argv[1:]])
    require_success(run(['/usr/bin/mount', '-n', '--make-rprivate', '/'], timeout=30), 'private_mount_namespace')


def main() -> None:
    os.umask(0o077)
    if len(sys.argv) not in (2, 3, 4) or sys.argv[1] not in SUBCOMMANDS:
        fail('fixed_subcommand_required')
    wait_for_copy = len(sys.argv) == 3
    if wait_for_copy and sys.argv[1:] != ['daily-nfs', '--wait']:
        fail('wait_argument')
    owner = None
    if len(sys.argv) == 4:
        if sys.argv[1] != 'daily-local' or sys.argv[2] != '--owner-sha256' or not SNAPSHOT_ID.fullmatch(sys.argv[3]):
            fail('owner_argument')
        owner = sys.argv[3]
    def interrupted(_number, _frame):
        raise WorkflowError('interrupted')
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGINT, interrupted)
    try:
        command = sys.argv[1]
        if command == 'daily-local' and not testing():
            capture_namespace()
        copying = command in {'daily-nfs', 'daily-proton'}
        with ExitStack() as stack:
            gate = rooted('/run/lock/home-lab-restic-repositories.lock')
            require_regular(gate, {0o660}, None if testing() else {0})
            gate_stream = stack.enter_context(gate.open('a+'))
            # Maintenance queues behind healthy readers instead of leaving a
            # failed unit that blocks admission after replication has finished.
            # Its native systemd start timeout bounds both this wait and the work.
            # Strict admission wraps daily-nfs --wait in native timeout, allowing
            # an existing transfer to finish before a fresh inventory/reconcile.
            flags = fcntl.LOCK_EX if command == 'maintenance' else fcntl.LOCK_SH
            if command != 'maintenance' and not wait_for_copy:
                flags |= fcntl.LOCK_NB
            try:
                fcntl.flock(gate_stream, flags)
            except BlockingIOError:
                if command == 'expire-snapshots':
                    print('restic_backup=snapshot_cleanup deferred=repository_maintenance')
                    return
                raise
            # Tool convergence publishes this fence, then drains all shared
            # readers through an exclusive barrier before replacing anything.
            # Check under the gate and read policy only after admission, so a
            # delayed caller cannot carry pre-update configuration across it.
            fence = rooted('/var/lib/home-lab-restic/tools-updating')
            if copying and (fence.exists() or fence.is_symlink()):
                raise WorkflowError('tools_update_active')
            policy, policy_hash = load_policy()
            policy['_owner'] = owner
            lock = rooted(policy["runner"]["lock_path"])
            if testing():
                lock.parent.mkdir(parents=True, exist_ok=True)
            if lock.exists():
                require_regular(lock, {0o660}, None if testing() else {0})
            elif not testing():
                raise WorkflowError("lock_path_missing")
            selected_lock = rooted('/run/lock/home-lab-restic-' + command + '.lock') if copying else lock
            require_regular(selected_lock, {0o660}, None if testing() else {0})
            stream = stack.enter_context(selected_lock.open('a+'))
            try:
                fcntl.flock(stream, fcntl.LOCK_EX if wait_for_copy else fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError as error:
                if command == 'expire-snapshots':
                    print('restic_backup=snapshot_cleanup deferred=active_capture')
                    return
                raise WorkflowError("concurrent_operation") from error
            deploy_lock = rooted(policy["runner"]["deploy_lock_path"])
            if deploy_lock.exists() and not copying:
                if deploy_lock.is_symlink() or not deploy_lock.is_dir():
                    raise WorkflowError('deploy_lock_type')
                if owner is None and command == 'recover':
                    # Boot recovery may resume only this capture's recorded
                    # services, never adopt/release the retained production lock.
                    journal = read_json(journal_path(policy), {})
                    owner = journal.get('owner') if isinstance(journal, dict) else None
                if not isinstance(owner, str) or SNAPSHOT_ID.fullmatch(owner) is None:
                    raise WorkflowError('concurrent_deploy')
                require_regular(deploy_lock / 'owner', {0o600}, None if testing() else {0})
                if hashlib.sha256((deploy_lock / 'owner').read_bytes()).hexdigest() != owner:
                    raise WorkflowError('concurrent_deploy')
                policy['_owner'] = owner
            elif owner is not None:
                raise WorkflowError('owner_missing')
            command = sys.argv[1]
            if command == 'recover':
                recover_interruption(policy)
            elif command == "preflight":
                recover_interruption(policy)
                preflight(policy, ["games"])
                verify_sources(policy)
                print("restic_backup=preflight_passed")
            elif command == "daily-local":
                daily_local(policy, policy_hash)
            elif command == "daily-nfs":
                reconcile(policy, 'nfs')
            elif command == "daily-proton":
                reconcile(policy, 'proton')
            elif command == "maintenance":
                maintenance(policy)
            elif command == 'expire-snapshots':
                expire_snapshots(policy)
            elif command == "diagnose-proton":
                diagnose_proton(policy)
            else:
                status(policy, policy_hash)
    except (WorkflowError, KeyError, TypeError, ValueError, OSError) as error:
        fail(str(error) if isinstance(error, WorkflowError) else "internal_validation")


if __name__ == "__main__":
    main()
