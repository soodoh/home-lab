#!/usr/bin/env python3
"""Small consistency adapter around native Restic and Docker Compose commands."""

from __future__ import annotations

import fcntl
import hashlib
import json
import os
import pwd
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any

SUBCOMMANDS = {"preflight", "daily-local", "daily-proton", "diagnose-proton", "maintenance", "status"}
SNAPSHOT_ID = re.compile(r"^[0-9a-f]{64}$")


class WorkflowError(RuntimeError):
    pass


def fail(reason: str) -> None:
    print(f"restic_backup=failed reason={reason}", file=sys.stderr)
    raise SystemExit(1)


def testing() -> bool:
    return os.environ.get("HOME_LAB_RESTIC_TESTING") == "1"


def rooted(path: str) -> Path:
    candidate = Path(path)
    if testing():
        return Path(os.environ["HOME_LAB_RESTIC_TEST_ROOT"]).resolve() / candidate.relative_to("/")
    return candidate


def require_regular(
    path: Path,
    modes: set[int],
    owners: set[int] | None = None,
    groups: set[int] | None = None,
) -> None:
    if not testing():
        for parent in path.parents:
            if parent == Path("/"):
                break
            try:
                if parent.is_symlink():
                    raise WorkflowError("protected_parent_symlink")
            except OSError as error:
                raise WorkflowError("protected_parent_missing") from error
    try:
        metadata = path.lstat()
    except OSError as error:
        raise WorkflowError("protected_file_missing") from error
    if path.is_symlink() or not path.is_file() or metadata.st_nlink != 1:
        raise WorkflowError("protected_file_type")
    if metadata.st_mode & 0o777 not in modes:
        raise WorkflowError("protected_file_mode")
    if owners is not None and metadata.st_uid not in owners:
        raise WorkflowError("protected_file_owner")
    if groups is not None and metadata.st_gid not in groups:
        raise WorkflowError("protected_file_group")


def load_policy() -> tuple[dict[str, Any], str]:
    path = rooted("/etc/home-lab/restic-policy.json")
    require_regular(path, {0o440, 0o600, 0o640, 0o644}, None if testing() else {0})
    raw = path.read_bytes()
    try:
        policy = json.loads(raw)
    except json.JSONDecodeError as error:
        raise WorkflowError("policy_json") from error
    if not isinstance(policy, dict) or policy.get("policy_version") != 1:
        raise WorkflowError("policy_schema")
    return policy, hashlib.sha256(raw).hexdigest()


def run(
    arguments: list[str], *, environment: dict[str, str] | None = None, timeout: int = 7200,
) -> subprocess.CompletedProcess[str]:
    if not arguments or any(not isinstance(argument, str) or not argument for argument in arguments):
        raise WorkflowError("command_shape")
    merged = {"PATH": "/usr/local/bin:/usr/bin:/bin", "HOME": "/var/empty", "LC_ALL": "C", "TZ": "UTC"}
    if environment:
        merged.update(environment)
    try:
        return subprocess.run(
            arguments,
            check=False,
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            env=merged,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise WorkflowError("command_execution") from error


def require_success(result: subprocess.CompletedProcess[str], reason: str) -> None:
    if result.returncode != 0:
        raise WorkflowError("restic_partial_source" if result.returncode == 3 else reason)


def proton_identity() -> tuple[int, int]:
    if testing():
        return os.getuid(), os.getgid()
    try:
        record = pwd.getpwnam("restic-proton")
    except KeyError as error:
        raise WorkflowError("proton_identity_missing") from error
    return record.pw_uid, record.pw_gid


def shared_state_owners() -> set[int]:
    proton_uid, _ = proton_identity()
    return {0, os.getuid(), proton_uid}


def fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def durable_unlink(path: Path) -> None:
    path.unlink(missing_ok=True)
    fsync_directory(path.parent)


def atomic_json(path: Path, value: object, mode: int = 0o640) -> None:
    if testing():
        path.parent.mkdir(parents=True, exist_ok=True)
    parent_metadata = path.parent.lstat()
    if path.parent.is_symlink() or not path.parent.is_dir() or parent_metadata.st_uid not in {0, os.getuid()} or parent_metadata.st_mode & 0o002:
        raise WorkflowError("evidence_parent_metadata")
    if path.exists():
        require_regular(path, {mode}, shared_state_owners(), {parent_metadata.st_gid})
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, mode)
        os.fchown(descriptor, -1, parent_metadata.st_gid)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(value, stream, sort_keys=True, separators=(",", ":"))
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        temporary.replace(path)
        fsync_directory(path.parent)
    finally:
        temporary.unlink(missing_ok=True)


def read_json(path: Path, default: object) -> object:
    if not path.exists():
        return default
    parent = path.parent.lstat()
    require_regular(path, {0o600, 0o640, 0o660}, shared_state_owners(), {parent.st_gid})
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise WorkflowError("evidence_json") from error


def repository_environment(policy: dict[str, Any], destination: str, source: str | None = None) -> dict[str, str]:
    credential_root = rooted("/etc/home-lab/restic/credentials")
    local_password = credential_root / "local-password"
    proton_password = credential_root / "proton-password"
    selected = local_password if policy["repositories"][destination]["password"] == "local" else proton_password
    require_regular(selected, {0o400, 0o440}, None if testing() else {0})
    confined = destination == "proton" or (not testing() and os.geteuid() != 0)
    cache = rooted(policy["runner"]["proton_cache_path"] if confined else policy["runner"]["local_cache_path"])
    cache_metadata = cache.lstat()
    expected_owner = os.getuid() if confined else 0
    if cache.is_symlink() or not cache.is_dir() or cache_metadata.st_uid != expected_owner or cache_metadata.st_mode & 0o777 != 0o700:
        raise WorkflowError("cache_metadata")
    environment = {"RESTIC_PASSWORD_FILE": str(selected), "RESTIC_CACHE_DIR": str(cache)}
    if source is not None:
        source_password = local_password if policy["repositories"][source]["password"] == "local" else proton_password
        require_regular(source_password, {0o400, 0o440}, None if testing() else {0})
        environment["RESTIC_FROM_PASSWORD_FILE"] = str(source_password)
    if destination == "proton":
        config = rooted("/var/lib/restic-proton/rclone.conf")
        require_regular(config, {0o600}, None if testing() else {os.getuid()})
        environment.update({"RCLONE_CONFIG": str(config), "HOME": str(config.parent)})
    return environment


def restic_result(
    policy: dict[str, Any], name: str, arguments: list[str], *, source: str | None = None,
) -> subprocess.CompletedProcess[str]:
    command = [policy["tools"]["restic"]["installed_path"], "--repo", policy["repositories"][name]["path"]]
    if source is not None:
        command.extend(["--from-repo", policy["repositories"][source]["path"]])
    return run([*command, *arguments], environment=repository_environment(policy, name, source))


def verify_repository(policy: dict[str, Any], name: str) -> dict[str, Any]:
    result = restic_result(policy, name, ["cat", "config"])
    require_success(result, f"repository_open_{name}")
    try:
        config = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise WorkflowError(f"repository_id_{name}") from error
    if not isinstance(config, dict) or config.get("id") != policy["repositories"][name]["id"]:
        raise WorkflowError(f"repository_id_{name}")
    if not isinstance(config.get("chunker_polynomial"), str):
        raise WorkflowError(f"repository_chunker_{name}")
    return config


def preflight(policy: dict[str, Any], names: list[str]) -> None:
    configs = {name: verify_repository(policy, name) for name in names}
    if "games" in configs:
        chunker = configs["games"]["chunker_polynomial"]
        if any(config["chunker_polynomial"] != chunker for config in configs.values()):
            raise WorkflowError("repository_chunker_mismatch")


def compose(policy: dict[str, Any], arguments: list[str]) -> subprocess.CompletedProcess[str]:
    command = policy["runner"].get("compose_command") or [
        "/usr/bin/docker", "compose", "--project-name", "docker-compose",
        "--project-directory", "/srv/docker-compose/current", "--env-file", "/etc/docker-compose/production.env",
        "--file", "/srv/docker-compose/current/docker-compose.yml",
    ]
    return run([*command, *arguments], timeout=300)


def service_container(policy: dict[str, Any], service: str) -> str:
    result = compose(policy, ["ps", "--all", "--quiet", service])
    require_success(result, "service_inventory")
    containers = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    if len(containers) != 1 or re.fullmatch(r"[0-9a-f]{64}", containers[0]) is None:
        raise WorkflowError("service_inventory_output")
    return containers[0]


def service_running(policy: dict[str, Any], service: str) -> bool:
    result = run(["/usr/bin/docker", "inspect", "--format", "{{.State.Running}}", service_container(policy, service)], timeout=30)
    require_success(result, "service_inventory")
    if result.stdout.strip() not in {"true", "false"}:
        raise WorkflowError("service_inventory_output")
    return result.stdout.strip() == "true"


def service_healthy(policy: dict[str, Any], service: str) -> bool:
    try:
        container = service_container(policy, service)
    except WorkflowError:
        return False
    result = run([
        "/usr/bin/docker", "inspect", "--format",
        "{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}", container,
    ], timeout=30)
    return result.returncode == 0 and result.stdout.strip() in {"healthy", "running"}


def journal_path(policy: dict[str, Any]) -> Path:
    return rooted(policy["runner"]["journal_path"])


def restart_recorded(policy: dict[str, Any], journal: dict[str, Any]) -> None:
    running = set(journal.get("running_services", []))
    stop_order = [*policy["stop_groups"]["applications"], *policy["stop_groups"]["databases"]]
    for service in reversed(stop_order):
        if service in running:
            require_success(compose(policy, ["start", service]), "service_restart")
    deadline = time.monotonic() + (3 if testing() else 300)
    while time.monotonic() < deadline:
        if all(service_healthy(policy, service) for service in running):
            durable_unlink(journal_path(policy))
            return
        time.sleep(0.1 if testing() else 5)
    raise WorkflowError("service_health")


def recover_interruption(policy: dict[str, Any]) -> None:
    value = read_json(journal_path(policy), {})
    if value:
        if not isinstance(value, dict) or value.get("version") != 1 or not isinstance(value.get("running_services"), list):
            raise WorkflowError("journal_schema")
        restart_recorded(policy, value)


def artifact_hash(policy: dict[str, Any]) -> str:
    path = rooted(policy["runner"]["artifact_hash_path"])
    require_regular(path, {0o440, 0o444, 0o600, 0o640, 0o644}, None if testing() else {0})
    value = path.read_text(encoding="utf-8").strip()
    if SNAPSHOT_ID.fullmatch(value) is None:
        raise WorkflowError("artifact_hash")
    return value


def parse_backup_snapshot(result: subprocess.CompletedProcess[str]) -> str:
    snapshot = None
    for line in result.stdout.splitlines():
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            continue
        if message.get("message_type") == "summary":
            snapshot = message.get("snapshot_id")
    if not isinstance(snapshot, str) or SNAPSHOT_ID.fullmatch(snapshot) is None:
        raise WorkflowError("snapshot_id_missing")
    return snapshot


def snapshot_mapping(policy: dict[str, Any], destination: str, source_id: str) -> str:
    result = restic_result(policy, destination, ["snapshots", "--json"])
    require_success(result, "snapshot_verify")
    try:
        snapshots = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise WorkflowError("snapshot_json") from error
    matches = [entry.get("id") for entry in snapshots if isinstance(entry, dict) and entry.get("original") == source_id]
    if len(matches) != 1 or not isinstance(matches[0], str) or SNAPSHOT_ID.fullmatch(matches[0]) is None:
        raise WorkflowError("snapshot_mapping")
    return matches[0]


def copy_snapshot(policy: dict[str, Any], source: str, destination: str, snapshot: str) -> str:
    result = restic_result(policy, destination, ["copy", snapshot], source=source)
    require_success(result, f"copy_{destination}")
    return snapshot_mapping(policy, destination, snapshot)


def select_current_snapshot(records: object, required_tags: set[str]) -> str:
    if not isinstance(records, list) or len(records) != 1 or not isinstance(records[0], dict):
        raise WorkflowError("current_snapshot_missing")
    record = records[0]
    snapshot = record.get("id")
    tags = record.get("tags")
    if not isinstance(snapshot, str) or SNAPSHOT_ID.fullmatch(snapshot) is None:
        raise WorkflowError("current_snapshot_identity")
    if not isinstance(tags, list) or any(not isinstance(tag, str) for tag in tags) or not required_tags <= set(tags):
        raise WorkflowError("current_snapshot_tags")
    return snapshot


def current_snapshot(policy: dict[str, Any], policy_hash: str, artifact: str) -> str:
    required = {"cadence=daily", f"policy={policy_hash}", f"artifact={artifact}"}
    result = restic_result(policy, "games", ["snapshots", "--json", "--latest", "1", "--tag", ",".join(sorted(required))])
    require_success(result, "current_snapshot_lookup")
    try:
        records = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise WorkflowError("current_snapshot_json") from error
    return select_current_snapshot(records, required)


def retention(policy: dict[str, Any], name: str) -> None:
    keep = policy["retention"]
    forget = [
        "forget", "--keep-daily", str(keep["keep_daily"]),
        "--keep-weekly", str(keep["keep_weekly"]), "--keep-monthly", str(keep["keep_monthly"]),
        "--group-by", keep["group_by"], "--tag", ",".join(keep["required_tags"]),
    ]
    require_success(restic_result(policy, name, forget), f"forget_{name}")
    prune = ["prune", "--max-repack-size", keep["prune_max_repack_size"], "--max-unused", keep["prune_max_unused"]]
    require_success(restic_result(policy, name, prune), f"prune_{name}")


def daily_local(policy: dict[str, Any], policy_hash: str) -> None:
    recover_interruption(policy)
    preflight(policy, ["games"])
    artifact = artifact_hash(policy)
    stop_order = [*policy["stop_groups"]["applications"], *policy["stop_groups"]["databases"]]
    running = [service for service in stop_order if service_running(policy, service)]
    journal = {"version": 1, "running_services": running, "started_at": int(time.time())}
    atomic_json(journal_path(policy), journal, 0o600)
    snapshot = None
    try:
        for service in stop_order:
            if service in running:
                require_success(compose(policy, ["stop", "--timeout", "120", service]), "service_stop")
        tags = ["cadence=daily", f"policy={policy_hash}", f"artifact={artifact}"]
        arguments = [
            "backup", "--json", "--files-from", str(rooted(policy["runner"]["files_from_path"])),
            "--exclude-file", str(rooted(policy["runner"]["exclude_file_path"])),
        ]
        for tag in tags:
            arguments.extend(["--tag", tag])
        result = restic_result(policy, "games", arguments)
        require_success(result, "backup")
        snapshot = parse_backup_snapshot(result)
    finally:
        restart_recorded(policy, journal)
    if snapshot is None:
        raise WorkflowError("snapshot_not_committed")
    preflight(policy, ["games", "nfs"])
    nfs_snapshot = copy_snapshot(policy, "games", "nfs", snapshot)
    print(f"restic_backup=local source_snapshot={snapshot} nfs_snapshot={nfs_snapshot}")


def daily_proton(policy: dict[str, Any], policy_hash: str) -> None:
    preflight(policy, ["games", "proton"])
    artifact = artifact_hash(policy)
    source = current_snapshot(policy, policy_hash, artifact)
    proton_snapshot = copy_snapshot(policy, "games", "proton", source)
    print(f"restic_backup=proton source_snapshot={source} proton_snapshot={proton_snapshot}")


def maintenance(policy: dict[str, Any]) -> None:
    scope = os.environ.get("HOME_LAB_RESTIC_MAINTENANCE_SCOPE")
    if scope not in {"local", "proton"}:
        raise WorkflowError("maintenance_scope")
    names = ["games", "nfs"] if scope == "local" else ["proton"]
    preflight(policy, ["games", *[name for name in names if name != "games"]])
    subset = policy["retention"]["read_data_subset"]
    for name in names:
        retention(policy, name)
        require_success(
            restic_result(policy, name, ["check", "--read-data-subset", subset]),
            f"repository_check_{name}",
        )
    print(f"restic_backup=maintenance scope={scope} repositories={len(names)} subset={subset}")


def diagnose_proton(policy: dict[str, Any]) -> None:
    preflight(policy, ["games", "proton"])
    require_success(restic_result(policy, "proton", ["check"]), "repository_check_proton")
    print("restic_backup=diagnose_proton repository_check=passed mutation=false")


def status(policy: dict[str, Any], policy_hash: str) -> None:
    repositories_ready = all(
        isinstance(value.get("id"), str) and SNAPSHOT_ID.fullmatch(value["id"])
        for value in policy["repositories"].values()
    )
    interruption = journal_path(policy).exists()
    artifact = artifact_hash(policy) if not testing() else "testing"
    print(
        f"restic_backup=status migration={policy['migration_state']} policy={policy_hash} "
        f"artifact={artifact} repositories_ready={str(repositories_ready).lower()} "
        f"interruption={str(interruption).lower()}"
    )


def main() -> None:
    if len(sys.argv) != 2 or sys.argv[1] not in SUBCOMMANDS:
        fail("fixed_subcommand_required")
    try:
        policy, policy_hash = load_policy()
        lock = rooted(policy["runner"]["lock_path"])
        if testing():
            lock.parent.mkdir(parents=True, exist_ok=True)
        if lock.exists():
            require_regular(lock, {0o660}, None if testing() else {0})
        elif not testing():
            raise WorkflowError("lock_path_missing")
        with lock.open("a+", encoding="utf-8") as stream:
            try:
                fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError as error:
                raise WorkflowError("concurrent_operation") from error
            deploy_lock = rooted(policy["runner"]["deploy_lock_path"])
            if deploy_lock.exists():
                if deploy_lock.is_symlink() or not deploy_lock.is_dir():
                    raise WorkflowError("deploy_lock_type")
                raise WorkflowError("concurrent_deploy")
            command = sys.argv[1]
            if command == "preflight":
                recover_interruption(policy)
                preflight(policy, ["games", "nfs"])
                print("restic_backup=preflight_passed")
            elif command == "daily-local":
                daily_local(policy, policy_hash)
            elif command == "daily-proton":
                daily_proton(policy, policy_hash)
            elif command == "maintenance":
                maintenance(policy)
            elif command == "diagnose-proton":
                diagnose_proton(policy)
            else:
                status(policy, policy_hash)
    except (WorkflowError, KeyError, TypeError, ValueError, OSError) as error:
        fail(str(error) if isinstance(error, WorkflowError) else "internal_validation")


if __name__ == "__main__":
    main()
