#!/usr/bin/env python3
"""Small consistency adapter around native Restic and Docker Compose commands."""

from __future__ import annotations

import fcntl
from contextlib import ExitStack, contextmanager
from functools import cache
import hashlib
import json
import importlib.util
import shutil
import signal
from datetime import datetime, timezone
import uuid
import os
import pwd
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from types import SimpleNamespace
from typing import Any, Callable, NamedTuple

SUBCOMMANDS = {"preflight", "daily-local", "daily-nfs", "daily-proton", "diagnose-proton", "maintenance", "status", "recover", "expire-snapshots"}
# Leave headroom for the replica unit's authoritative five-minute stop budget.
COPY_STOP_GRACE_SECONDS = 240
# Leave headroom under home-lab-restic-daily-local.service's TimeoutStopSec=5min.
RESTART_HEALTH_DEADLINE_SECONDS = 240
RECOVER_HEALTH_DEADLINE_SECONDS = 300
NEXTCLOUD_DATA_ROOT = '/mnt/storage/media/nextcloud/data'
SNAPSHOT_ID = re.compile(r"^[0-9a-f]{64}$")
SNAPSHOT_EVIDENCE_SHA256 = 'adda400082d8dee921feb1221b7de4e013e83610f1aab43d0578453081fc4dda'
# Single-threaded process deadline applied only to runner subprocesses via run()
# (currently _restart); adapter probes manage their own timeouts.
_COMMAND_DEADLINE: float | None = None


@contextmanager
def _command_deadline(deadline: float | None):
    """Clamp runner run() subprocess timeouts to one shared monotonic deadline."""
    global _COMMAND_DEADLINE
    previous = _COMMAND_DEADLINE
    if deadline is not None:
        _COMMAND_DEADLINE = deadline if previous is None else min(previous, deadline)
    try:
        yield
    finally:
        _COMMAND_DEADLINE = previous


class WorkflowError(RuntimeError):
    pass


def fail(reason: str) -> None:
    print(f"restic_backup=failed reason={reason}", file=sys.stderr)
    raise SystemExit(1)


def testing() -> bool:
    return os.environ.get("HOME_LAB_RESTIC_TESTING") == "1"


def rooted(path: str) -> Path:
    candidate = Path(path)
    if testing():
        return Path(os.environ["HOME_LAB_RESTIC_TEST_ROOT"]).resolve() / candidate.relative_to("/")
    return candidate


def require_regular(
    path: Path,
    modes: set[int],
    owners: set[int] | None = None,
    groups: set[int] | None = None,
) -> None:
    if not testing():
        for parent in path.parents:
            if parent == Path("/"):
                break
            try:
                if parent.is_symlink():
                    raise WorkflowError("protected_parent_symlink")
            except OSError as error:
                raise WorkflowError("protected_parent_missing") from error
    try:
        metadata = path.lstat()
    except OSError as error:
        raise WorkflowError("protected_file_missing") from error
    if path.is_symlink() or not path.is_file() or metadata.st_nlink != 1:
        raise WorkflowError("protected_file_type")
    if metadata.st_mode & 0o777 not in modes:
        raise WorkflowError("protected_file_mode")
    if owners is not None and metadata.st_uid not in owners:
        raise WorkflowError("protected_file_owner")
    if groups is not None and metadata.st_gid not in groups:
        raise WorkflowError("protected_file_group")


def load_policy() -> tuple[dict[str, Any], str]:
    path = rooted("/etc/home-lab/restic-policy.json")
    require_regular(path, {0o440, 0o600, 0o640, 0o644}, None if testing() else {0})
    raw = path.read_bytes()
    try:
        policy = json.loads(raw)
    except json.JSONDecodeError as error:
        raise WorkflowError("policy_json") from error
    if not isinstance(policy, dict) or policy.get("policy_version") != 1:
        raise WorkflowError("policy_schema")
    return policy, hashlib.sha256(raw).hexdigest()


def run(
    arguments: list[str], *, environment: dict[str, str] | None = None, timeout: int | float = 7200,
    graceful_interrupt: bool = False,
) -> subprocess.CompletedProcess[str]:
    if not arguments or any(not isinstance(argument, str) or not argument for argument in arguments):
        raise WorkflowError("command_shape")
    if _COMMAND_DEADLINE is not None:
        remaining = _COMMAND_DEADLINE - time.monotonic()
        if remaining <= 0:
            raise WorkflowError("command_execution")
        timeout = min(timeout, remaining)
    merged = {"PATH": "/usr/local/bin:/usr/bin:/bin", "HOME": "/var/empty", "LC_ALL": "C", "TZ": "UTC"}
    if environment:
        merged.update(environment)
    try:
        if graceful_interrupt:
            return run_copy_process(arguments, merged, timeout)
        return subprocess.run(
            arguments,
            check=False,
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            env=merged,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise WorkflowError("command_execution") from error


def run_copy_process(arguments, environment, timeout):
    # Separate foreground-terminal signals from the child. Replica units use
    # KillMode=mixed: only this runner gets the initial signal; systemd still
    # owns final cgroup-wide escalation. Restic must keep rclone alive long
    # enough to remove its own repository locks before closing the backend.
    with subprocess.Popen(arguments, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, text=True, env=environment,
                          start_new_session=True) as child:
        def kill_owned_group():
            try:
                os.killpg(child.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            child.communicate()

        def stop_child():
            try:
                child.send_signal(signal.SIGINT)
            except ProcessLookupError:
                pass
            try:
                child.communicate(timeout=COPY_STOP_GRACE_SECONDS)
            except subprocess.TimeoutExpired:
                kill_owned_group()
                raise WorkflowError('copy_stop_timeout') from None
            except BaseException:
                kill_owned_group()
                raise

        try:
            stdout, stderr = child.communicate(timeout=timeout)
        except WorkflowError as error:
            if str(error) == 'interrupted':
                stop_child()
            else:
                kill_owned_group()
            raise
        except subprocess.TimeoutExpired:
            stop_child()
            raise WorkflowError('command_execution') from None
        except BaseException:
            kill_owned_group()
            raise
        return subprocess.CompletedProcess(arguments, child.returncode, stdout, stderr)


def require_success(result: subprocess.CompletedProcess[str], reason: str) -> None:
    if result.returncode != 0:
        raise WorkflowError("restic_partial_source" if result.returncode == 3 else reason)


def report_phase(phase: str, started: float) -> None:
    print(f"restic_backup=phase name={phase} seconds={time.monotonic() - started:.1f}", flush=True)


def proton_identity() -> tuple[int, int]:
    if testing():
        return os.getuid(), os.getgid()
    try:
        record = pwd.getpwnam("restic-proton")
    except KeyError as error:
        raise WorkflowError("proton_identity_missing") from error
    return record.pw_uid, record.pw_gid


def fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def durable_unlink(path: Path) -> None:
    path.unlink(missing_ok=True)
    fsync_directory(path.parent)


def atomic_json(path: Path, value: object, mode: int = 0o600) -> None:
    if testing():
        path.parent.mkdir(parents=True, exist_ok=True)
    parent_metadata = path.parent.lstat()
    if path.parent.is_symlink() or not path.parent.is_dir() or parent_metadata.st_uid not in {0, os.getuid()} or parent_metadata.st_mode & 0o022:
        raise WorkflowError("evidence_parent_metadata")
    if path.exists():
        require_regular(path, {mode}, {os.getuid()}, {parent_metadata.st_gid})
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, mode)
        os.fchown(descriptor, -1, parent_metadata.st_gid)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(value, stream, sort_keys=True, separators=(",", ":"))
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        temporary.replace(path)
        fsync_directory(path.parent)
    finally:
        temporary.unlink(missing_ok=True)


def read_json(path: Path, default: object) -> object:
    if path.is_symlink():
        raise WorkflowError('protected_file_type')
    if not path.exists():
        return default
    parent = path.parent.lstat()
    require_regular(path, {0o600}, {os.getuid()}, {parent.st_gid})
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise WorkflowError("evidence_json") from error


def repository_environment(policy: dict[str, Any], destination: str, source: str | None = None) -> dict[str, str]:
    credential_root = rooted("/etc/home-lab/restic/credentials")
    local_password = credential_root / "local-password"
    proton_password = credential_root / "proton-password"
    selected = local_password if policy["repositories"][destination]["password"] == "local" else proton_password
    require_regular(selected, {0o400, 0o440}, None if testing() else {0})
    confined = destination == "proton" or (not testing() and os.geteuid() != 0)
    cache = rooted(policy["runner"]["proton_cache_path"] if confined else policy["runner"]["local_cache_path"])
    cache_metadata = cache.lstat()
    expected_owner = proton_identity()[0] if confined else 0
    if cache.is_symlink() or not cache.is_dir() or cache_metadata.st_uid != expected_owner or cache_metadata.st_mode & 0o777 != 0o700:
        raise WorkflowError("cache_metadata")
    environment = {"RESTIC_PASSWORD_FILE": str(selected), "RESTIC_CACHE_DIR": str(cache)}
    if source is not None:
        source_password = local_password if policy["repositories"][source]["password"] == "local" else proton_password
        require_regular(source_password, {0o400, 0o440}, None if testing() else {0})
        environment["RESTIC_FROM_PASSWORD_FILE"] = str(source_password)
    if destination == "proton":
        config = rooted("/var/lib/restic-proton/rclone.conf")
        require_regular(config, {0o600}, None if testing() else {proton_identity()[0]})
        environment.update({"RCLONE_CONFIG": str(config), "HOME": str(config.parent)})
    return environment


def restic_result(
    policy: dict[str, Any], name: str, arguments: list[str], *, source: str | None = None,
    timeout: int = 7200,
) -> subprocess.CompletedProcess[str]:
    command = [policy["tools"]["restic"]["installed_path"], "--repo", policy["repositories"][name]["path"]]
    if source is not None:
        # Native copy's --no-lock applies only to the read-only source; the
        # destination still takes an append lock. The runner holds the shared
        # repository gate against maintenance for the entire transfer.
        command.extend(["--from-repo", policy["repositories"][source]["path"], "--no-lock"])
    elif name == 'games' and (arguments[:1] == ['snapshots'] or arguments == ['cat', 'config']):
        # These metadata reads also run under the gate and must work in the
        # replica services' read-only source mount.
        command.append('--no-lock')
    environment = repository_environment(policy, name, source)
    if name == 'proton' and os.geteuid() == 0 and not testing():
        command = ['/usr/sbin/runuser', '--user', 'restic-proton', '--', '/usr/bin/env',
                   *[f'{k}={v}' for k, v in environment.items()], *command]
        environment = {}
    options = {'graceful_interrupt': True} if source is not None else {}
    return run([*command, *arguments], environment=environment, timeout=timeout, **options)


def verify_repository(policy: dict[str, Any], name: str) -> dict[str, Any]:
    result = restic_result(policy, name, ["cat", "config"])
    require_success(result, f"repository_open_{name}")
    try:
        config = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise WorkflowError(f"repository_id_{name}") from error
    if not isinstance(config, dict) or config.get("id") != policy["repositories"][name]["id"]:
        raise WorkflowError(f"repository_id_{name}")
    if not isinstance(config.get("chunker_polynomial"), str):
        raise WorkflowError(f"repository_chunker_{name}")
    return config


def preflight(policy: dict[str, Any], names: list[str]) -> None:
    if not testing():
        for name in set(names) & {'games', 'nfs'}:
            repository = policy['repositories'][name]
            identity = {'fstype': repository['filesystem']}
            identity['uuid' if name == 'games' else 'source'] = repository.get('filesystem_uuid', repository.get('mount_source'))
            mount = {'path': repository['path'], 'identity': identity}
            if name == 'nfs':
                mount['bind_root'] = repository['mountpoint']
            verify_sources({'capture': {'mounts': [mount]}})
    configs = {name: verify_repository(policy, name) for name in names}
    if "games" in configs:
        chunker = configs["games"]["chunker_polynomial"]
        if any(config["chunker_polynomial"] != chunker for config in configs.values()):
            raise WorkflowError("repository_chunker_mismatch")


def compose(policy: dict[str, Any], arguments: list[str]) -> subprocess.CompletedProcess[str]:
    command = policy["runner"].get("compose_command") or [
        "/usr/bin/docker", "compose", "--project-name", "docker-compose",
        "--project-directory", "/srv/docker-compose/current", "--env-file", "/etc/docker-compose/production.env",
        "--file", "/srv/docker-compose/current/docker-compose.yml",
    ]
    return run([*command, *arguments], timeout=300)


def declared_services(policy: dict[str, Any]) -> set[str]:
    result = compose(policy, ["config", "--services"])
    require_success(result, "service_declaration")
    services = result.stdout.splitlines()
    if not services or len(services) != len(set(services)) or any(
        re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_.-]*", service) is None for service in services
    ):
        raise WorkflowError("service_declaration_output")
    return set(services)


def service_container(policy: dict[str, Any], service: str) -> str:
    result = compose(policy, ["ps", "--all", "--quiet", service])
    require_success(result, "service_inventory")
    containers = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    if len(containers) != 1 or re.fullmatch(r"[0-9a-f]{64}", containers[0]) is None:
        raise WorkflowError("service_inventory_output")
    return containers[0]


def running_service_container(policy: dict[str, Any], service: str) -> str | None:
    container = service_container(policy, service)
    result = run(["/usr/bin/docker", "inspect", "--format", "{{.State.Running}}", container], timeout=30)
    require_success(result, "service_inventory")
    if result.stdout.strip() not in {"true", "false"}:
        raise WorkflowError("service_inventory_output")
    return container if result.stdout.strip() == "true" else None


def service_running(policy: dict[str, Any], service: str) -> bool:
    return running_service_container(policy, service) is not None


def service_healthy(policy: dict[str, Any], service: str) -> bool:
    try:
        container = service_container(policy, service)
        result = run([
            "/usr/bin/docker", "inspect", "--format",
            "{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}", container,
        ], timeout=30)
    except WorkflowError as error:
        if str(error) == 'interrupted':
            raise
        return False
    return result.returncode == 0 and result.stdout.strip() in {"healthy", "running"}


def nextcloud_data_marker() -> bool:
    data = rooted(NEXTCLOUD_DATA_ROOT)
    try:
        return any(not (candidate := data / name).is_symlink() and candidate.is_file()
                   for name in ('.ncdata', '.ocdata'))
    except OSError:
        return False


def nextcloud_status(policy, service='nextcloud', *, container: str | None = None):
    if container is None:
        container = service_container(policy, service)
    result = run(['/usr/bin/docker', 'exec', '--user', 'www-data', container,
                  'php', '/var/www/html/occ', 'status', '--output=json'], timeout=30)
    if result.returncode != 0:
        raise WorkflowError('nextcloud_status')
    try:
        value = json.loads(result.stdout)
    except ValueError as error:
        raise WorkflowError('nextcloud_status') from error
    if not isinstance(value, dict):
        raise WorkflowError('nextcloud_status')
    return value


def _nextcloud_status_matches(status: dict[str, Any] | None, *, maintenance: bool) -> bool:
    return bool(
        status
        and status.get('installed') is True
        and status.get('maintenance') is maintenance
        and status.get('needsDbUpgrade') is False
    )


def _nextcloud_status_ready(status: dict[str, Any] | None) -> bool:
    return _nextcloud_status_matches(status, maintenance=False) and nextcloud_data_marker()


def nextcloud_healthy(policy):
    try:
        return _nextcloud_status_ready(nextcloud_status(policy))
    except WorkflowError as error:
        if str(error) == 'interrupted':
            raise
        return False


class MaintenanceExit(NamedTuple):
    disabled: bool
    ready: bool


def _nextcloud_with_fallback(
    policy, action: Callable[[str, str], Any], *, default: Any = False, allow_fallback: bool = False,
) -> Any:
    services = ('nextcloud', 'nextcloud-cron') if allow_fallback else ('nextcloud',)
    for service in services:
        try:
            container = running_service_container(policy, service)
            if container is None:
                continue
            return action(service, container)
        except WorkflowError as error:
            if str(error) == 'interrupted':
                raise
    return default


def _exit_nextcloud_maintenance(policy, *, allow_fallback: bool = False) -> MaintenanceExit:
    def exit_on(service: str, container: str) -> MaintenanceExit:
        status = nextcloud_maintenance(policy, False, service, container=container)
        return MaintenanceExit(True, _nextcloud_status_ready(status))
    return _nextcloud_with_fallback(policy, exit_on, default=MaintenanceExit(False, False), allow_fallback=allow_fallback)


def _nextcloud_maintenance_verified(policy, *, allow_fallback: bool = False) -> bool:
    def check_on(service: str, container: str) -> bool:
        return _nextcloud_status_ready(nextcloud_status(policy, service, container=container))
    return _nextcloud_with_fallback(policy, check_on, allow_fallback=allow_fallback)


def nextcloud_maintenance(policy, enabled: bool, service: str = 'nextcloud', *, container: str | None = None) -> dict[str, Any]:
    if container is None:
        container = service_container(policy, service)
    flag = '--on' if enabled else '--off'
    result = run(['/usr/bin/docker', 'exec', '--user', 'www-data', container,
                  'php', '/var/www/html/occ', 'maintenance:mode', flag], timeout=60)
    if result.returncode != 0:
        raise WorkflowError('nextcloud_maintenance_' + ('on' if enabled else 'off'))
    status = nextcloud_status(policy, service, container=container)
    if status.get('maintenance') is not enabled:
        raise WorkflowError('nextcloud_maintenance_verify')
    return status


def _nextcloud_running_container(lookup: Callable[[str], str | None], service: str = 'nextcloud') -> str:
    """Resolve the required running Nextcloud container, failing closed as nextcloud_not_running."""
    try:
        container = lookup(service)
    except WorkflowError as error:
        if str(error) != 'service_inventory_output':
            raise
        container = None
    if container is None:
        # Fail closed: Nextcloud containers use restart: always, so a
        # transient absence cannot be treated as a quiescent state;
        # nextcloud-cron fallback is reserved for recovery exit only.
        raise WorkflowError('nextcloud_not_running')
    return container


def _prepare_nextcloud_maintenance(policy, _step) -> str:
    container = _nextcloud_running_container(lambda s: running_service_container(policy, s), 'nextcloud')
    status = nextcloud_status(policy, 'nextcloud', container=container)
    if status.get('installed') is not True or status.get('needsDbUpgrade') is not False:
        raise WorkflowError('nextcloud_not_ready')
    if status.get('maintenance') is not False:
        raise WorkflowError('nextcloud_maintenance_already_active')
    if not nextcloud_data_marker():
        raise WorkflowError('nextcloud_not_ready')
    return 'nextcloud'


def _running_container_lookup(policy: dict[str, Any]) -> Callable[[str], str | None]:
    """Resolve and cache running container IDs for maintenance probes."""
    cached: dict[str, str] = {}

    def lookup(service: str) -> str | None:
        container = cached.get(service)
        if container is not None:
            result = run(["/usr/bin/docker", "inspect", "--format", "{{.State.Running}}", container], timeout=30)
            if result.returncode == 0 and result.stdout.strip() == "true":
                return container
            cached.pop(service, None)
        container = running_service_container(policy, service)
        if container is not None:
            cached[service] = container
        return container

    return lookup


def _call_adapter_probe(adapter, probe: Callable[..., Any], *args: Any) -> Any:
    """Translate adapter CaptureError at the maintenance probe boundary."""
    try:
        return probe(*args)
    except adapter.CaptureError as error:
        raise WorkflowError(str(error)) from None


def _wait_nextcloud_web_maintenance(adapter, lookup: Callable[[str], str | None], target: str) -> None:
    """Wait until Apache's mod_php OPcache observes maintenance mode on status.php.

    CLI `occ maintenance:mode --on` writes config.php but cannot invalidate
    Apache's shared OPcache (`opcache.revalidate_freq=60` in the official image).
    """
    deadline = time.monotonic() + (3 if testing() else 90)
    while True:
        container = _nextcloud_running_container(lookup, target)
        try:
            status = _call_adapter_probe(adapter, adapter.nextcloud_web_status, container)
        except WorkflowError as error:
            if str(error) != 'nextcloud_web_status':
                raise
            status = {}
        if _nextcloud_status_matches(status, maintenance=True):
            return
        if time.monotonic() >= deadline:
            raise WorkflowError('nextcloud_maintenance_web_verify')
        time.sleep(0.1 if testing() else 2)


def _drain_nextcloud_writers(adapter, step: dict[str, Any], lookup: Callable[[str], str | None]) -> None:
    """Wait for already-running cron jobs, open write handles and DB transactions.

    Requires two consecutive quiet samples to catch in-flight requests between
    file writes and database queries.
    """
    deadline = time.monotonic() + (3 if testing() else 120)
    services = set(step.get('services', ()))
    databases = [dump for dump in step.get('databases', ()) if dump.get('engine') == 'mariadb']
    quiet_samples = 0
    while True:
        drained = True
        if 'nextcloud-cron' in services:
            cron_container = lookup('nextcloud-cron')
            if cron_container is not None and _call_adapter_probe(adapter, adapter.nextcloud_cron_busy, cron_container):
                drained = False
        if drained and 'nextcloud' in services:
            web_container = _nextcloud_running_container(lookup, 'nextcloud')
            if _call_adapter_probe(adapter, adapter.nextcloud_write_fds_busy, web_container):
                drained = False
        if drained:
            for dump in databases:
                if not _call_adapter_probe(adapter, adapter.mariadb_idle, dump['container']):
                    drained = False
                    break
        if drained:
            quiet_samples += 1
            if quiet_samples >= 2:
                return
        else:
            quiet_samples = 0
        if time.monotonic() >= deadline:
            raise WorkflowError('nextcloud_writer_drain_timeout')
        time.sleep(0.1 if testing() else 0.5)


def _enter_nextcloud_maintenance(
    policy, adapter, step, target: str, on_begin: Callable[[], None] | None = None,
) -> None:
    lookup = _running_container_lookup(policy)
    container = _nextcloud_running_container(lookup, target)
    if on_begin is not None:
        on_begin()
    nextcloud_maintenance(policy, True, target, container=container)
    _wait_nextcloud_web_maintenance(adapter, lookup, target)
    _drain_nextcloud_writers(adapter, step, lookup)


def _verify_nextcloud_maintenance_active(policy, adapter, target: str) -> None:
    container = _nextcloud_running_container(lambda s: running_service_container(policy, s), target)
    status = nextcloud_status(policy, target, container=container)
    if not _nextcloud_status_matches(status, maintenance=True):
        raise WorkflowError('nextcloud_maintenance_lost')
    web_status = _call_adapter_probe(adapter, adapter.nextcloud_web_status, container)
    if not _nextcloud_status_matches(web_status, maintenance=True):
        raise WorkflowError('nextcloud_maintenance_lost')


class MaintenanceHandler(NamedTuple):
    prepare: Callable[[dict[str, Any], dict[str, Any]], str]
    enter: Callable[[dict[str, Any], Any, dict[str, Any], str, Callable[[], None] | None], None]
    verify_active: Callable[[dict[str, Any], Any, str], None]
    exit: Callable[..., MaintenanceExit]
    verified: Callable[..., bool]
    healthy: Callable[[dict[str, Any]], bool]


MAINTENANCE_HANDLERS = {
    'nextcloud': MaintenanceHandler(
        prepare=_prepare_nextcloud_maintenance,
        enter=_enter_nextcloud_maintenance,
        verify_active=_verify_nextcloud_maintenance_active,
        exit=_exit_nextcloud_maintenance,
        verified=_nextcloud_maintenance_verified,
        healthy=nextcloud_healthy,
    ),
}


def _policy_maintenance_names(policy: dict[str, Any]) -> list[str]:
    capture = policy.get('capture')
    if capture is None:
        return []
    if not isinstance(capture, dict):
        raise WorkflowError('maintenance_capture_scope')
    steps = capture.get('maintenance', [])
    if not isinstance(steps, list) or any(
        not isinstance(step, dict) or not isinstance(step.get('name'), str) or not step['name']
        for step in steps
    ):
        raise WorkflowError('maintenance_capture_scope')
    return [step['name'] for step in steps]


def journal_path(policy: dict[str, Any]) -> Path:
    return rooted(policy["runner"]["journal_path"])


def restic_backup_time(value):
    # Restic accepts a zone-less, whole-second timestamp; run() pins TZ=UTC.
    stamp = datetime.fromisoformat(value.replace('Z', '+00:00'))
    if stamp.tzinfo is None:
        raise WorkflowError('capture_time')
    return stamp.astimezone(timezone.utc).strftime('%Y-%m-%d %H:%M:%S')


def artifact_hash(policy: dict[str, Any]) -> str:
    path = rooted(policy["runner"]["artifact_hash_path"])
    require_regular(path, {0o440, 0o444, 0o600, 0o640, 0o644}, None if testing() else {0})
    value = path.read_text(encoding="utf-8").strip()
    if SNAPSHOT_ID.fullmatch(value) is None:
        raise WorkflowError("artifact_hash")
    return value


def parse_backup_snapshot(result: subprocess.CompletedProcess[str]) -> str:
    snapshot = None
    for line in result.stdout.splitlines():
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            continue
        if message.get("message_type") == "summary":
            snapshot = message.get("snapshot_id")
    if not isinstance(snapshot, str) or SNAPSHOT_ID.fullmatch(snapshot) is None:
        raise WorkflowError("snapshot_id_missing")
    return snapshot


@cache
def snapshot_evidence():
    path = Path(__file__).with_name('restic_snapshot_evidence.py')
    if __name__ == '__main__' and not testing():
        require_regular(path, {0o644}, {0})
    source = path.read_bytes()
    if hashlib.sha256(source).hexdigest() != SNAPSHOT_EVIDENCE_SHA256:
        raise WorkflowError('snapshot_evidence_identity')
    module = SimpleNamespace()
    exec(compile(source, str(path), 'exec', dont_inherit=True), vars(module))
    return module


def same_capture(source, candidate):
    return snapshot_evidence().same_copy(source, candidate)


def copy_snapshot(policy, source, destination, snapshot):
    # Let healthy transfers use the replica unit's full budget. Systemd bounds
    # the complete reconciliation, including inventory and retries, to 12h.
    require_success(restic_result(policy, destination, ['copy', snapshot['id']], source=source,
                                  timeout=12 * 3600), 'copy_' + destination)
    matches = [row for row in inventory(policy, destination) if same_capture(snapshot, row)]
    if len(matches) != 1:
        raise WorkflowError('snapshot_mapping')
    return matches[0]['id']


def capture_adapter(policy):
    path = Path(__file__).with_name('restic-capture-files.py')
    if hashlib.sha256(path.read_bytes()).hexdigest() != policy['capture']['adapter_sha256']:
        raise WorkflowError('capture_adapter_identity')
    if not testing():
        require_regular(path, {0o755}, {0})
    spec = importlib.util.spec_from_file_location('capture_files', path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def verify_sources(policy):
    # A mounted fallback directory is not a valid source. Match native mount
    # identities before reading or stopping anything.
    for mount in policy['capture']['mounts']:
        result = run(['/usr/bin/findmnt', '--json', '--nofsroot', '--target', mount['path'],
                      '--output', 'TARGET,FSTYPE,SOURCE,UUID'])
        require_success(result, 'source_mount')
        entries = json.loads(result.stdout).get('filesystems', [])
        if len(entries) != 1:
            raise WorkflowError('source_mount_identity')
        identity = dict(mount['identity'])
        if 'bind_root' in mount:
            # nfs-utils reports a systemd-bound repository as export/subtree.
            # Admit only the two exact target/source pairs, never arbitrary
            # suffixes, another repository or the whole export bound here.
            root = Path(mount['bind_root'])
            relative = Path(mount['path']).relative_to(root)
            if str(relative) == '.' or identity.get('fstype') != 'nfs4':
                raise WorkflowError('source_mount_identity')
            identity['target'] = str(root)
            if entries[0].get('target') == mount['path']:
                identity['target'] = mount['path']
                identity['source'] = identity['source'].rstrip('/') + '/' + str(relative)
        if any(entries[0].get(k) != v for k, v in identity.items()):
            raise WorkflowError('source_mount_identity')


class LocalCapture:
    """One local capture under the runner's locks, including recovery and expiry."""

    def __init__(self, policy: dict[str, Any]):
        self.policy = policy

    def preflight(self) -> None:
        self.recover()
        preflight(self.policy, ['games'])
        verify_sources(self.policy)

    def recover(self) -> None:
        policy = self.policy
        value = read_json(journal_path(policy), {})
        if value:
            if not isinstance(value, dict) or value.get("version") != 1 or not isinstance(value.get("running_services"), list):
                raise WorkflowError("journal_schema")
            if value.get('owner') != policy.get('_owner'):
                raise WorkflowError('journal_owner')
            allowed = set(policy['stop_groups']['applications'] + policy['stop_groups']['databases'])
            allowed_maintenance = set(_policy_maintenance_names(policy))
            running = value['running_services']
            order = value.get('stop_order', list(allowed))
            maintenance = value.get('maintenance_services', [])
            if (not isinstance(order, list) or not isinstance(maintenance, list)
                    or any(not isinstance(s, str) or s not in allowed for s in running + order)
                    or any(not isinstance(s, str) or s not in allowed_maintenance or s not in MAINTENANCE_HANDLERS
                           for s in maintenance)
                    or len(set(running)) != len(running) or len(set(order)) != len(order)
                    or len(set(maintenance)) != len(maintenance)
                    or not set(running) <= set(order)):
                raise WorkflowError('journal_schema')
            self._restart(value, allow_fallback=True, deadline_seconds=RECOVER_HEALTH_DEADLINE_SECONDS)

    def _start_stopped_services(
        self, running: set[str], stop_order: list[str], *,
        deadline: float | None = None, deadline_seconds: int = RESTART_HEALTH_DEADLINE_SECONDS,
    ) -> WorkflowError | None:
        policy = self.policy
        restart_error: WorkflowError | None = None
        for service in reversed(stop_order):
            if service in running:
                try:
                    require_success(compose(policy, ["start", service]), "service_restart")
                except WorkflowError as error:
                    if str(error) == 'interrupted':
                        raise
                    if service == 'gluetun':
                        restart_error = error
                        break
                    # A failed application must not strand the rest of the pause set.
                    restart_error = restart_error or WorkflowError('service_restart')
                    continue
                if service == "gluetun":
                    # Its network-namespace clients require a healthy VPN before start.
                    wait_deadline = (
                        deadline if deadline is not None
                        else time.monotonic() + (3 if testing() else deadline_seconds)
                    )
                    while (remaining := wait_deadline - time.monotonic()) > 0:
                        if service_healthy(policy, service):
                            break
                        time.sleep(min(0.1 if testing() else 5, remaining))
                    else:
                        restart_error = WorkflowError("service_health")
                        break
        return restart_error

    def _restart(
        self, journal: dict[str, Any], *, allow_fallback: bool = False,
        deadline_seconds: int = RESTART_HEALTH_DEADLINE_SECONDS,
    ) -> None:
        policy = self.policy
        running = set(journal.get("running_services", []))
        stop_order = journal.get("stop_order", [*policy["stop_groups"]["applications"], *policy["stop_groups"]["databases"]])
        maintenance = list(journal.get("maintenance_services", []))
        if len(set(maintenance)) != len(maintenance) or any(service not in MAINTENANCE_HANDLERS for service in maintenance):
            raise WorkflowError('journal_schema')
        deadline = time.monotonic() + (3 if testing() else deadline_seconds)
        with _command_deadline(deadline):
            disabled: set[str] = set()
            verified: set[str] = set()
            # Track services whose exit() already ran this tick so a
            # (disabled=True, ready=False) or failed attempt sleeps before
            # re-probing. Run the initial maintenance exit before starting
            # stopped services so a stalled VPN restart cannot starve it.
            attempted_exit: set[str] = set()
            for service in maintenance:
                attempted_exit.add(service)
                outcome = MAINTENANCE_HANDLERS[service].exit(policy, allow_fallback=allow_fallback)
                if outcome.disabled:
                    disabled.add(service)
                if outcome.ready:
                    verified.add(service)
            restart_error = self._start_stopped_services(running, stop_order, deadline=deadline)
            if restart_error is not None and len(disabled) == len(maintenance):
                raise restart_error
            while True:
                for service in maintenance:
                    if service in disabled or service in attempted_exit:
                        continue
                    attempted_exit.add(service)
                    outcome = MAINTENANCE_HANDLERS[service].exit(policy, allow_fallback=allow_fallback)
                    if outcome.disabled:
                        disabled.add(service)
                    if outcome.ready:
                        verified.add(service)
                if len(disabled) == len(maintenance):
                    if restart_error is not None:
                        raise restart_error
                    if all(service_healthy(policy, service) for service in running):
                        maintenance_ok = all(
                            service in verified or (
                                service not in attempted_exit
                                and MAINTENANCE_HANDLERS[service].verified(policy, allow_fallback=allow_fallback)
                            )
                            for service in maintenance
                        )
                        nextcloud_ok = 'nextcloud' not in running or nextcloud_healthy(policy)
                        if maintenance_ok and nextcloud_ok:
                            durable_unlink(journal_path(policy))
                            return
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    break
                time.sleep(min(0.1 if testing() else 5, remaining))
                attempted_exit.clear()
                verified.clear()
        if restart_error is not None:
            raise restart_error
        raise WorkflowError("service_health")

    def _read_manifest(self, stage):
        manifest = read_json(stage / 'manifest.json', None)
        if (not isinstance(manifest, dict) or manifest.get('version') != 2
                or not isinstance(manifest.get('capture'), str)
                or re.fullmatch('[0-9a-f]{32}', manifest['capture']) is None
                or any(not isinstance(manifest.get(key), str) or not SNAPSHOT_ID.fullmatch(manifest[key])
                       for key in ('policy', 'artifact'))
                or 'owner' not in manifest or manifest['owner'] != self.policy.get('_owner')):
            raise WorkflowError('previous_capture_requires_inspection')
        return manifest

    @staticmethod
    def _completed(rows, token, manifest=None):
        # Do not turn a conflicting or ambiguous completion into absence.
        evidence = snapshot_evidence()
        matches = []
        for row in rows:
            tags = evidence.tags(row)
            if 'capture=' + token not in tags:
                continue
            if len(evidence.format_tags(tags)) > 1:
                raise WorkflowError('snapshot_completion_identity')
            if evidence.daily_kind(tags) == 'complete':
                matches.append(row)
        if len(matches) > 1:
            raise WorkflowError('completion_mapping')
        if not matches:
            return None
        row = matches[0]
        if manifest is not None:
            for key in ('capture', 'policy', 'artifact', 'owner'):
                value = manifest[key]
                expected = {f'{key}={value}'} if value is not None else set()
                if {tag for tag in row['tags'] if tag.startswith(key + '=')} != expected:
                    raise WorkflowError('snapshot_completion_identity')
        return row['id']

    def _zfs_intent(self, adapter, stage):
        policy = self.policy
        value = read_json(stage / 'zfs-source.json', {})
        required = {'version', 'capture', 'owner', 'production_owner', 'running_services', 'record'}
        allowed_maintenance = set(_policy_maintenance_names(policy))
        maintenance = value.get('maintenance_services', []) if isinstance(value, dict) else []
        if (not isinstance(value, dict) or
                not required <= set(value) or set(value) - required > {'maintenance_services'} or
                value['version'] != 1 or not isinstance(value['capture'], str) or
                re.fullmatch('[0-9a-f]{32}', value['capture']) is None or
                value['owner'] != hashlib.sha256(value['capture'].encode()).hexdigest() or
                value['production_owner'] != policy.get('_owner') or
                not isinstance(value['running_services'], list) or
                any(not isinstance(service, str) for service in value['running_services']) or
                len(value['running_services']) != len(set(value['running_services'])) or
                not set(value['running_services']) <= set(policy['stop_groups']['applications']) or
                not isinstance(maintenance, list) or
                any(not isinstance(service, str) for service in maintenance) or
                len(maintenance) != len(set(maintenance)) or
                not set(maintenance) <= allowed_maintenance):
            raise WorkflowError('snapshot_state')
        if value['record'] is not None:
            adapter.zfs_record(adapter.zfs_spec(policy), value['record'],
                               capture=value['capture'], owner=value['owner'])
        return value

    def _state_receipt(self, adapter, stage, zfs):
        value = read_json(stage / 'state-source.json', None)
        if value is None or zfs is None:
            raise WorkflowError('state_snapshot_receipt_missing')
        # Both sources belong to the same writer pause and capture.
        return adapter.state_snapshot_record(self.policy, value, zfs['capture'], zfs['owner'])

    def _ready_receipts(self, adapter, stage, manifest):
        settings = self.policy['capture']
        zfs = None
        if settings.get('zfs'):
            zfs = self._zfs_intent(adapter, stage)
            if zfs['record'] is None:
                raise WorkflowError('snapshot_receipt_missing')
        if (zfs['record'] if zfs else None) != manifest.get('zfs_source') or (
                zfs and zfs['capture'] != manifest['capture']):
            raise WorkflowError('zfs_snapshot_manifest_mismatch')
        state = self._state_receipt(adapter, stage, zfs) if settings.get('state_snapshot') else None
        if state != manifest.get('state_source'):
            raise WorkflowError('state_snapshot_manifest_mismatch')
        return zfs, state

    def _open_zfs(self, adapter, stage, value):
        spec = adapter.zfs_spec(self.policy)
        if time.time() - value['record']['created'] >= spec['expiry_seconds']:
            raise WorkflowError('snapshot_expired_cleanup_required')
        record = adapter.zfs_record(spec, adapter.zfs_call(spec, {
            'action': 'ready', 'capture': value['capture'], 'owner': value['owner'],
            'guid': value['record']['guid'],
        }), capture=value['capture'], owner=value['owner'])
        if record != value['record']:
            raise WorkflowError('snapshot_replaced')
        adapter.zfs_mount(spec, record, stage)

    def _state_request(self, adapter, record, action):
        payload = {'action': action, 'capture': record['capture'], 'owner': record['owner']}
        if action != 'state-inspect':
            payload['id'] = record['id']
        result = adapter.zfs_call(adapter.zfs_spec(self.policy), payload)
        if action in {'state-complete', 'state-abandon'}:
            if result != {'deleted': True}:
                raise WorkflowError('state_snapshot_retained')
        elif result != record:
            raise WorkflowError('state_snapshot_replaced')

    def _open_state(self, adapter, stage, record, attachments, paths):
        self._state_request(adapter, record, 'state-ready')
        attachments.enter_context(adapter.state_snapshot_attached(self.policy, record, stage, paths))

    def _release_sources(self, adapter, stage, zfs_record, state_record, *, backup):
        if state_record is not None:
            if not adapter.state_device_idle() or adapter.state_attachment_path(stage).exists():
                raise WorkflowError('state_snapshot_attachment_requires_inspection')
            self._state_request(adapter, state_record, 'state-complete' if backup else 'state-abandon')
        if zfs_record is not None:
            adapter.zfs_unmount(stage)
            request = {'action': 'complete' if backup else 'abandon', 'capture': zfs_record['capture'],
                       'owner': zfs_record['owner'], 'guid': zfs_record['guid']}
            if backup:
                request['backup'] = backup
            if adapter.zfs_call(adapter.zfs_spec(self.policy), request).get('deleted') is not True:
                raise WorkflowError('snapshot_retained')

    def _finish_completed(self, adapter, stage, zfs_record, state_record, backup, *, discard_stage=True):
        self._release_sources(adapter, stage, zfs_record, state_record, backup=backup)
        if discard_stage:
            shutil.rmtree(stage)

    def _finish_ready(self, adapter, stage, manifest, backup):
        zfs, state = self._ready_receipts(adapter, stage, manifest)
        self._finish_completed(adapter, stage, zfs['record'] if zfs else None, state, backup)

    def run(self, policy_hash: str) -> None:
        self.preflight()
        policy = self.policy
        settings = policy['capture']
        stage = rooted(settings['stage'])
        adapter = capture_adapter(policy)
        attachments = ExitStack()
        zfs_opening = False
        try:
            if stage.exists():
                manifest = self._read_manifest(stage)
                if manifest['policy'] != policy_hash or manifest['artifact'] != artifact_hash(policy):
                    raise WorkflowError('previous_capture_requires_inspection')
                backup = self._completed(inventory(policy, 'games'), manifest['capture'], manifest)
                if backup:
                    self._finish_ready(adapter, stage, manifest, backup)
                    print(f'restic_backup=local snapshot={backup}')
                    return
                # The policy digest binds mount selection. Never replan against
                # current Compose or take new snapshots on a ready retry.
                sources = adapter.capture_sources(settings)
                zfs, state = self._ready_receipts(adapter, stage, manifest)
                if state is not None:
                    self._open_state(adapter, stage, state, attachments, sources.state)
            else:
                plan = self._prepare(adapter, stage)
                sources = plan.sources
                manifest, zfs, state = self._stage_fresh(adapter, stage, plan, policy_hash, attachments)
            if zfs is not None:
                zfs_opening = True
                self._open_zfs(adapter, stage, zfs)
            if sources.live_games:
                # These paths are deliberately live on retries.
                attachments.enter_context(adapter.live_games_mounted(sources.live_games, stage))
            backup = self._upload(adapter, stage, manifest, sources, zfs, state, attachments)
            self._finish_ready(adapter, stage, manifest, backup)
            zfs_opening = False
            print(f'restic_backup=local snapshot={backup}')
        except adapter.CaptureError as error:
            raise WorkflowError(str(error)) from None
        finally:
            try:
                attachments.close()
            finally:
                if zfs_opening:
                    adapter.zfs_unmount(stage)

    def _prepare(self, adapter, stage):
        policy = self.policy
        settings = policy['capture']
        plan = adapter.capture_plan(policy, declared_services(policy))
        adapter.radio_check(Path('/'), settings['radio_max_age_seconds'])
        if plan.sources.zfs:
            adapter.zfs_verify_broker_scope(policy)
            if adapter.zfs_inventory(adapter.zfs_spec(policy), require_admissible=True):
                raise WorkflowError('previous_snapshot_requires_inspection')
        if plan.sources.state:
            adapter.state_snapshot_preflight(policy, stage)
        self._prepare_maintenance(plan)
        adapter.capacity_check(plan, stage, settings['reserve_bytes'], policy['runner']['exclude_file_path'])
        adapter.fresh_stage(stage, settings['reserve_bytes'])
        return plan

    def _stage_fresh(self, adapter, stage, plan, policy_hash, attachments):
        policy = self.policy
        token = uuid.uuid4().hex
        captured_at = datetime.now(timezone.utc).isoformat()
        captures = self._capture_online(adapter, stage, plan)
        began = datetime.now(timezone.utc).isoformat()
        self._pause_writers(adapter, plan, stage, token)
        finished = datetime.now(timezone.utc).isoformat()
        shared_names = [*plan.cold_names, *plan.maintenance_names]
        captures.extend({'name': name, 'started_at': began, 'finished_at': finished} for name in shared_names)
        zfs = self._zfs_intent(adapter, stage) if plan.sources.zfs else None
        if zfs is not None:
            if zfs['record'] is None:
                raise WorkflowError('snapshot_receipt_missing')
            if zfs['capture'] != token:
                raise WorkflowError('snapshot_replaced')
        state = self._state_receipt(adapter, stage, zfs) if plan.sources.state else None
        # Verify the same frozen radio view Restic will read, once writers have resumed.
        if state is not None:
            self._open_state(adapter, stage, state, attachments, plan.sources.state)
        adapter.radio_check(stage / 'files', policy['capture']['radio_max_age_seconds'],
                            snapshot_scratch=stage if plan.sources.state else None)
        manifest = {'version': 2, 'capture': token, 'captured_at': captured_at, 'artifact': artifact_hash(policy),
                    'owner': policy.get('_owner'), 'policy': policy_hash, 'links': {}, 'captures': captures,
                    'databases': plan.databases}
        zfs_created = None
        if zfs is not None:
            manifest['zfs_source'] = zfs['record']
            manifest['zfs_paths'] = plan.sources.zfs
            zfs_created = zfs['record']['created']
            zfs_only = [name for name in plan.zfs_names if name not in plan.state_names]
            if zfs_only:
                zfs_captured = datetime.fromtimestamp(zfs_created, timezone.utc).isoformat()
                captures.extend({'name': name, 'started_at': zfs_captured, 'finished_at': zfs_captured}
                                for name in zfs_only)
        if state is not None:
            manifest['state_source'] = state
            state_created = state['created']
            captured = datetime.fromtimestamp(state_created, timezone.utc).isoformat()
            zfs_names = set(plan.zfs_names)
            for name in plan.state_names:
                if zfs_created is not None and name in zfs_names:
                    started_at = datetime.fromtimestamp(min(zfs_created, state_created), timezone.utc).isoformat()
                    finished_at = datetime.fromtimestamp(max(zfs_created, state_created), timezone.utc).isoformat()
                else:
                    started_at, finished_at = captured, captured
                captures.append({'name': name, 'started_at': started_at, 'finished_at': finished_at})
        # A ready manifest is a crash-recovery promise: flush staged data first.
        adapter.command(['/usr/bin/sync', '--file-system', str(stage)])
        atomic_json(stage / 'manifest.json', manifest, 0o600)
        return manifest, zfs, state

    def _capture_online(self, adapter, stage, plan):
        policy = self.policy
        captures = []
        online_clock = time.monotonic()
        online_started = datetime.now(timezone.utc).isoformat()
        excludes = rooted(policy['runner']['exclude_file_path'])
        for step in plan.online:
            started = time.monotonic()
            began = datetime.now(timezone.utc).isoformat()
            if step.get('native') == 'postgres':
                spec = step['databases'][0]
                verified_roots: dict[str, dict] = {}
                adapter.retry(lambda: adapter.online_postgres(
                    step['paths'], stage / 'files', excludes,
                    spec=spec, target=stage / 'databases' / spec['name'],
                    verified=verified_roots))
            elif step.get('native') == 'mosquitto':
                container = service_container(policy, step['service'])
                running = service_running(policy, step['service'])
                adapter.retry(lambda: adapter.mosquitto(
                    step, stage / 'files', excludes, container=container, running=running))
            else:
                adapter.retry(lambda: adapter.online_tree(
                    step['paths'], stage / 'files', excludes,
                    sqlite_paths=step.get('sqlite', []), json_roots=step.get('json_roots', []),
                    ephemeral=step.get('ephemeral', [])))
            captures.append({'name': step['name'], 'started_at': began,
                             'finished_at': datetime.now(timezone.utc).isoformat()})
            report_phase('online_capture_' + step['name'], started)
        for path in plan.online_stores:
            adapter.stable_store(Path(path), stage / 'files' / path.lstrip('/'))
        for path in plan.live_files:
            adapter.retry(lambda: adapter.copy_paths(
                [path], stage / 'files', excludes, online_sqlite=path.startswith(plan.jellyfin.rstrip('/') + '/')))
        for path in plan.online_json:
            adapter.acme_store(Path(path), stage / 'files' / path.lstrip('/'))
        auth = plan.cli_auth
        adapter.cli_auth(auth, stage / 'files' / auth.lstrip('/'))
        jelly = Path(plan.jellyfin)
        adapter.jellyfin(jelly, stage / 'native/jellyfin.zip')
        # Auxiliary plugin databases also get online backup semantics.
        for db in [*jelly.glob('data/*.db'), *jelly.glob('plugins/**/*.db')]:
            if db.name != 'jellyfin.db':
                adapter.retry(lambda: adapter.sqlite_backup(db, stage / 'files' / str(db).lstrip('/')))
        report_phase('online_capture_total', online_clock)
        captures.append({'name': 'online', 'started_at': online_started,
                         'finished_at': datetime.now(timezone.utc).isoformat()})
        return captures

    def _prepare_maintenance(self, plan) -> tuple[list[str], dict[str, str]]:
        active: list[str] = []
        targets: dict[str, str] = {}
        for step in plan.maintenance:
            handler = MAINTENANCE_HANDLERS.get(step['name'])
            if handler is None:
                raise WorkflowError('maintenance_capture_scope')
            targets[step['name']] = handler.prepare(self.policy, step)
            active.append(step['name'])
        return active, targets

    def _enter_maintenance(
        self, adapter, plan, targets: dict[str, str], entered: set[str] | None = None,
    ) -> None:
        if not targets:
            return
        started = time.monotonic()
        for step in plan.maintenance:
            name = step['name']
            on_begin = (lambda name=name: entered.add(name)) if entered is not None else None
            MAINTENANCE_HANDLERS[name].enter(self.policy, adapter, step, targets[name], on_begin)
        report_phase('maintenance_enter', started)

    def _verify_maintenance_active(self, adapter, plan, targets: dict[str, str]) -> None:
        for step in plan.maintenance:
            MAINTENANCE_HANDLERS[step['name']].verify_active(self.policy, adapter, targets[step['name']])

    def _take_shared_snapshots(self, adapter, plan, stage, state: dict[str, Any]) -> None:
        policy = self.policy
        started = time.monotonic()
        adapter.command(['/usr/bin/sync', '--file-system', '/mnt/storage'])
        spec = adapter.zfs_spec(policy)
        # Persist intent before the side effect. Lost acknowledgement retains
        # it for inspection; never recapture from mutable live data.
        atomic_json(stage / 'zfs-source.json', state)
        state['record'] = adapter.zfs_record(spec, adapter.zfs_call(spec, {
            'action': 'create', 'capture': state['capture'], 'owner': state['owner'],
        }), capture=state['capture'], owner=state['owner'])
        atomic_json(stage / 'zfs-source.json', state)
        report_phase('zfs_snapshot', started)
        if plan.sources.state:
            started = time.monotonic()
            adapter.command(['/usr/bin/sync', '--file-system', '/srv/home-lab-state'])
            response = adapter.zfs_call(spec, {'action': 'state-create', 'capture': state['capture'],
                                              'owner': state['owner']})
            receipt = adapter.state_snapshot_record(policy, response, state['capture'], state['owner'])
            atomic_json(stage / 'state-source.json', receipt)
            report_phase('state_snapshot', started)

    def _pause_writers(self, adapter, plan, stage, token):
        policy = self.policy
        services = plan.pause_services
        for path in (*plan.precopy, *plan.paused_copy, *plan.sources.zfs, *plan.sources.state):
            adapter.safe_source(path)
        excludes = rooted(policy['runner']['exclude_file_path'])
        baseline = None
        if plan.precopy:
            started = time.monotonic()
            baseline = adapter.retry(lambda: adapter.precopy(plan.precopy, stage / 'files', excludes))
            report_phase('precopy_local', started)
        running = [s for s in services if service_running(policy, s)]
        active_maintenance, maintenance_targets = self._prepare_maintenance(plan)
        if plan.sources.zfs:
            if (stage / 'zfs-source.json').exists():
                raise WorkflowError('snapshot_scope')
            state = {'version': 1, 'capture': token, 'owner': hashlib.sha256(token.encode()).hexdigest(),
                     'production_owner': policy.get('_owner'), 'running_services': running, 'record': None}
            if active_maintenance:
                state['maintenance_services'] = active_maintenance
        journal = {'version': 1, 'running_services': running, 'stop_order': services,
                   'started_at': int(time.time()), 'owner': policy.get('_owner')}
        if active_maintenance:
            journal['maintenance_services'] = active_maintenance
        atomic_json(journal_path(policy), journal, 0o600)
        entered_maintenance: set[str] = set()
        interrupted = time.monotonic()
        try:
            if running:
                require_success(compose(policy, ['stop', '--timeout', '120', *running]), 'service_stop')
            if any(service_running(policy, s) for s in services):
                raise WorkflowError('writer_not_stopped')
            if running:
                report_phase('shutdown', interrupted)
            self._enter_maintenance(adapter, plan, maintenance_targets, entered_maintenance)
            if plan.precopy or plan.paused_copy:
                started = time.monotonic()
                if plan.precopy:
                    adapter.retry(lambda: adapter.finish_copy(plan.precopy, stage / 'files', excludes, baseline=baseline))
                if plan.paused_copy:
                    adapter.retry(lambda: adapter.copy_paths(plan.paused_copy, stage / 'files', excludes))
                report_phase('final_copy_local', started)
            dumps = (*plan.cold_dumps, *plan.maintenance_dumps)
            if dumps:
                started = time.monotonic()
                for dump in dumps:
                    adapter.retry(lambda dump=dump: adapter.database_dump(dump, stage / 'databases' / dump['name']))
                report_phase('sql_exports', started)
            if plan.sources.zfs:
                self._verify_maintenance_active(adapter, plan, maintenance_targets)
                self._take_shared_snapshots(adapter, plan, stage, state)
            self._verify_maintenance_active(adapter, plan, maintenance_targets)
        finally:
            started = time.monotonic()
            remaining_maintenance = [s for s in active_maintenance if s in entered_maintenance]
            restart_journal = dict(journal)
            if active_maintenance:
                restart_journal['maintenance_services'] = remaining_maintenance
            if running and remaining_maintenance != active_maintenance:
                try:
                    atomic_json(journal_path(policy), restart_journal, 0o600)
                except (WorkflowError, OSError) as error:
                    if isinstance(error, WorkflowError) and str(error) == 'interrupted':
                        raise
            self._restart(restart_journal)
            report_phase('maintenance_exit' if remaining_maintenance and not running else 'restart', started)
            report_phase('interruption_shared', interrupted)

    def _upload(self, adapter, stage, manifest, sources, zfs, state, attachments):
        policy = self.policy
        evidence = snapshot_evidence()
        captured_at = manifest['captured_at']
        args = ['backup', '--json', '--time', restic_backup_time(captured_at), '--tag', evidence.FULL,
                '--tag', evidence.DAILY, '--tag', 'capture=' + manifest['capture'],
                '--tag', 'policy=' + manifest['policy'], '--tag', 'artifact=' + manifest['artifact']]
        if manifest['owner']:
            args.extend(['--tag', 'owner=' + manifest['owner']])
        if sources.state or sources.live_games:
            args.extend('--exclude=' + pattern for pattern in adapter.state_snapshot_exclusions(
                stage, rooted(policy['runner']['exclude_file_path'])))
        args.append(str(stage))
        result = None
        started = time.monotonic()
        for attempt in range(3):
            result = restic_result(policy, 'games', args)
            if result.returncode == 0:
                break
            if result.returncode == 3:
                raise WorkflowError('restic_partial_source')
            if attempt < 2:
                time.sleep(10)
        require_success(result, 'backup')
        snapshot = parse_backup_snapshot(result)
        report_phase('restic_backup', started)
        if zfs is not None:
            spec = adapter.zfs_spec(policy)
            adapter.zfs_verify_mounts(zfs['record'], stage)
            current = adapter.zfs_record(spec, adapter.zfs_call(spec, {
                'action': 'inspect', 'capture': zfs['capture'], 'owner': zfs['owner'],
            }), capture=zfs['capture'], owner=zfs['owner'])
            if current != zfs['record']:
                raise WorkflowError('snapshot_replaced')
        if state is not None:
            self._state_request(adapter, state, 'state-inspect')
        # Drop the local overlay and all live binds before granting completion.
        attachments.close()
        # Tagging changes only this provisional snapshot ID. Replica readers
        # use published IDs and cannot hold up completion or source release.
        require_success(restic_result(policy, 'games', [
            'tag', '--retry-lock', '1m', '--add', evidence.COMPLETE, snapshot,
        ], timeout=120), 'capture_completion')
        backup = self._completed(inventory(policy, 'games'), manifest['capture'], manifest)
        if not backup:
            raise WorkflowError('completion_mapping')
        return backup

    def expire(self) -> None:
        """Reconcile completed or expired sources without adopting any owner."""
        policy = self.policy
        if rooted(policy['runner']['deploy_lock_path']).exists():
            raise WorkflowError('snapshot_owner_requires_inspection')
        adapter = capture_adapter(policy)
        spec = adapter.zfs_spec(policy)
        verify_sources(policy)
        stage = rooted(policy['capture']['stage'])
        if stage.exists():
            metadata = stage.lstat()
            if stage.is_symlink() or not stage.is_dir() or metadata.st_uid != os.geteuid() or metadata.st_mode & 0o777 != 0o700:
                raise WorkflowError('snapshot_stage_metadata')
        if not testing():
            active = run(['/usr/bin/systemctl', 'show', 'home-lab-restic-daily-local.service',
                          '--property=ActiveState', '--value'], timeout=20)
            if (active.returncode or active.stdout.strip() not in {'inactive', 'failed'} or
                    self._snapshot_readers_present(stage, adapter)):
                raise WorkflowError('snapshot_job_active')
        self.recover()
        path = stage / 'manifest.json'
        manifest = self._read_manifest(stage) if path.exists() or path.is_symlink() else None
        state_record = None
        if manifest is not None:
            zfs, state_record = self._ready_receipts(adapter, stage, manifest)
        else:
            path = stage / 'zfs-source.json'
            zfs = self._zfs_intent(adapter, stage) if path.exists() or path.is_symlink() else None
        rows = inventory(policy, 'games')
        records = adapter.zfs_inventory(spec)
        if zfs and not any(row['capture'] == zfs['capture'] for row in records):
            backup = self._completed(rows, zfs['capture'], manifest)
            if not backup:
                raise WorkflowError('snapshot_missing_requires_inspection')
            if zfs['record'] is None:
                raise WorkflowError('snapshot_receipt_missing')
            if manifest is None and policy['capture'].get('state_snapshot'):
                state_record = self._state_receipt(adapter, stage, zfs)
            # A lost destroy acknowledgement can finish without reopening the source.
            self._finish_completed(adapter, stage, zfs['record'], state_record, backup)
            zfs, manifest, state_record = None, None, None
            print('restic_backup=snapshot_cleanup outcome=complete')
        for record in records:
            token = record['capture']
            if record['owner'] != hashlib.sha256(token.encode()).hexdigest():
                raise WorkflowError('snapshot_owner_requires_inspection')
            if stage.exists() and (zfs is None or zfs['capture'] != token):
                raise WorkflowError('previous_capture_requires_inspection')
            backup = self._completed(rows, token, manifest)
            if not backup and time.time() - record['created'] < spec['expiry_seconds']:
                continue
            # Without local intent, require every known paused/maintenance writer healthy.
            # Snapshot deletion intentionally requires the primary nextcloud web service
            # to pass nextcloud_healthy(), even if boot recovery exited maintenance via cron.
            running = zfs['running_services'] if zfs else policy['stop_groups']['applications']
            maintenance = (zfs.get('maintenance_services', []) if zfs
                           else _policy_maintenance_names(policy))
            if (any(not service_healthy(policy, service) for service in running) or
                    ('nextcloud' in running and not nextcloud_healthy(policy)) or
                    any(service not in MAINTENANCE_HANDLERS or not MAINTENANCE_HANDLERS[service].healthy(policy)
                        for service in maintenance)):
                raise WorkflowError('snapshot_recovery_not_verified')
            if zfs and zfs['record'] is not None and zfs['record'] != record:
                raise WorkflowError('snapshot_replaced')
            if manifest is None and policy['capture'].get('state_snapshot'):
                state_record = self._state_receipt(adapter, stage, zfs)
            if backup:
                self._finish_completed(adapter, stage, record, state_record, backup, discard_stage=zfs is not None)
            else:
                self._release_sources(adapter, stage, record, state_record, backup=None)
                if zfs:
                    shutil.rmtree(stage)
            if zfs:
                zfs, manifest, state_record = None, None, None
            print('restic_backup=snapshot_cleanup outcome=' + ('complete' if backup else 'abandoned'))

    @staticmethod
    def _snapshot_readers_present(stage, adapter):
        targets = set(map(str, adapter.snapshot_mounts(stage)))
        for process in Path('/proc').iterdir():
            if not process.name.isdigit():
                continue
            try:
                # Do not read arbitrary process arguments/environments. Only native
                # Restic mount namespaces are relevant; replica readers do not mount
                # this source. This also catches orphaned manual-backup children.
                if (process / 'comm').read_text().strip() != 'restic':
                    continue
                if any(line.split()[4] in targets for line in (process / 'mountinfo').read_text().splitlines()):
                    return True
            except (FileNotFoundError, ProcessLookupError):
                continue
        return False


def inventory(policy, name):
    result = restic_result(policy, name, ['snapshots', '--json'])
    require_success(result, 'snapshot_inventory')
    rows = json.loads(result.stdout)
    if not isinstance(rows, list) or any(not isinstance(r, dict) or not SNAPSHOT_ID.fullmatch(r.get('id', '')) for r in rows):
        raise WorkflowError('snapshot_inventory')
    return rows


def replication_sources(records):
    # Historical daily snapshots remain eligible for replicas and expiry, not admission.
    evidence = snapshot_evidence()
    return [row for row in records if evidence.daily_kind(evidence.tags(row)) is not None]


def reconcile(policy, destination):
    preflight(policy, ['games', destination])
    sources = replication_sources(inventory(policy, 'games'))
    copies = inventory(policy, destination)
    for source in sorted(sources, key=lambda r: r['time']):
        matches = [r for r in copies if same_capture(source, r)]
        if len(matches) > 1:
            raise WorkflowError('snapshot_mapping')
        if not matches:
            for attempt in range(3):
                try:
                    copy_snapshot(policy, 'games', destination, source)
                    break
                except WorkflowError as error:
                    if str(error) in {'interrupted', 'copy_stop_timeout'} or attempt == 2:
                        raise
                    time.sleep(10)


class ReplicaExpiry:
    """Expire replicated daily history while holding the exclusive repository gate."""

    destinations = ('nfs', 'proton')
    repositories = ('games', *destinations)

    def __init__(self, policy):
        self.policy = policy
        self.journal = journal_path(policy).with_name('retention.json')

    def run(self) -> bool:
        self._finish_pending()
        records = inventory(self.policy, 'games')
        sources = replication_sources(records)
        replicas = {name: inventory(self.policy, name) for name in self.destinations}
        bindings = []
        for source in sources:
            selected = {'games': source['id']}
            for name, rows in replicas.items():
                matches = [row for row in rows if same_capture(source, row)]
                if len(matches) > 1:
                    raise WorkflowError('snapshot_mapping')
                if matches:
                    selected[name] = matches[0]['id']
            bindings.append(selected)
        if any(len(row) != len(self.repositories) for row in bindings):
            return False
        # Bind exact IDs before native expiry, using the same one-to-one check
        # on publication and replay. After expiry ancestry cannot reconstruct them.
        pending = {'version': 1, 'repositories': self._repository_ids(), 'snapshots': bindings}
        self._bound_snapshots(pending)
        atomic_json(self.journal, pending)
        self._expire_local(records, sources)
        self._finish_pending()
        return True

    def _repository_ids(self):
        return {name: self.policy['repositories'][name]['id'] for name in self.repositories}

    def _bound_snapshots(self, pending):
        names = self.repositories
        if (not isinstance(pending, dict) or pending.get('version') != 1
                or pending.get('repositories') != self._repository_ids()
                or not isinstance(pending.get('snapshots'), list)):
            raise WorkflowError('retention_journal_schema')
        seen = {name: set() for name in names}
        for row in pending['snapshots']:
            if (not isinstance(row, dict) or set(row) != set(names)
                    or any(not isinstance(row[name], str) or not SNAPSHOT_ID.fullmatch(row[name])
                           or row[name] in seen[name] for name in names)):
                raise WorkflowError('retention_journal_schema')
            for name in names:
                seen[name].add(row[name])
        return pending['snapshots']

    def _finish_pending(self):
        pending = read_json(self.journal, None)
        if pending is None and not self.journal.exists():
            return
        bindings = self._bound_snapshots(pending)
        remaining = {row['id'] for row in inventory(self.policy, 'games')}
        removed = [row for row in bindings if row['games'] not in remaining]
        for name in self.destinations:
            present = {row['id'] for row in inventory(self.policy, name)}
            ids = [row[name] for row in removed if row[name] in present]
            if ids:
                require_success(restic_result(self.policy, name, ['forget', *ids]), 'forget_copy')
                if set(ids) & {row['id'] for row in inventory(self.policy, name)}:
                    raise WorkflowError('forget_copy_verify')
        durable_unlink(self.journal)

    def _expire_local(self, records, sources):
        keep = self.policy['retention']
        retention = ['--group-by', keep['group_by'], '--keep-daily', str(keep['keep_daily']),
                     '--keep-weekly', str(keep['keep_weekly']), '--keep-monthly', str(keep['keep_monthly'])]
        evidence = snapshot_evidence()
        tags_by_id = {row['id']: evidence.tags(row) for row in records}
        conflicts = {sid for sid, tags in tags_by_id.items()
                     if evidence.DAILY in tags and len(evidence.format_tags(tags)) > 1}
        legacy = ['forget', '--tag', evidence.DAILY, *retention]
        # Native keep-tag protects every formatted capture during the legacy pass.
        for tag in sorted({tag for tags in tags_by_id.values() for tag in evidence.format_tags(tags)}):
            legacy.extend(['--keep-tag', tag])
        complete = ['forget', '--tag', ','.join((evidence.DAILY, evidence.FULL, evidence.COMPLETE)), *retention]
        for kind, args, reason in (('legacy', legacy, 'forget_legacy'), ('complete', complete, 'forget_games')):
            eligible = {row['id'] for row in sources if evidence.daily_kind(tags_by_id[row['id']]) == kind}
            self._forget_class(args, eligible, conflicts, reason)

    def _forget_class(self, arguments, eligible, conflicts, reason):
        if not conflicts:
            require_success(restic_result(self.policy, 'games', arguments), reason)
            return
        # A conflicting tag must not cause deletion or consume retention quota.
        # Keep that group intact and use native decisions for the other groups.
        result = restic_result(self.policy, 'games', [*arguments, '--dry-run', '--json'])
        require_success(result, reason)
        removals = []
        for group in json.loads(result.stdout) or []:
            keep = group['keep'] or []
            remove = group['remove'] or []
            if any(row['id'] in conflicts for row in keep + remove):
                continue
            removals.extend(row['id'] for row in remove)
        if not set(removals) <= eligible:
            raise WorkflowError('retention_unbound_removal')
        if removals:
            require_success(restic_result(self.policy, 'games', ['forget', *removals]), reason)


def maintenance(policy: dict[str, Any]) -> None:
    scope = os.environ.get("HOME_LAB_RESTIC_MAINTENANCE_SCOPE")
    if journal_path(policy).exists() or rooted(policy['capture']['stage']).exists():
        raise WorkflowError('capture_pending')
    if scope not in {"local", "proton"}:
        raise WorkflowError("maintenance_scope")
    names = ReplicaExpiry.repositories if scope == 'local' else ('proton',)
    preflight(policy, names)
    keep = policy['retention']
    subset = keep['read_data_subset']
    if scope == 'local':
        if not ReplicaExpiry(policy).run():
            print('restic_backup=maintenance deferred=replication_pending')
            return
        for name in names:
            require_success(restic_result(policy, name, ['prune', '--max-repack-size', keep['prune_max_repack_size'],
                                                        '--max-unused', keep['prune_max_unused']]), 'prune')
    for name in names:
        require_success(restic_result(policy, name, ['check', '--read-data-subset', subset]), 'repository_check')
    print(f"restic_backup=maintenance scope={scope} repositories={len(names)} subset={subset}")


def diagnose_proton(policy: dict[str, Any]) -> None:
    preflight(policy, ["games", "proton"])
    require_success(restic_result(policy, "proton", ["check"]), "repository_check_proton")
    print("restic_backup=diagnose_proton repository_check=passed mutation=false")


def status(policy: dict[str, Any], policy_hash: str) -> None:
    repositories_ready = all(
        isinstance(value.get("id"), str) and SNAPSHOT_ID.fullmatch(value["id"])
        for value in policy["repositories"].values()
    )
    interruption = journal_path(policy).exists()
    artifact = artifact_hash(policy) if not testing() else "testing"
    print(
        f"restic_backup=status migration={policy['migration_state']} policy={policy_hash} "
        f"artifact={artifact} repositories_ready={str(repositories_ready).lower()} "
        f"interruption={str(interruption).lower()}"
    )


def capture_namespace():
    """Native mount isolation for manual as well as systemd-driven captures."""
    if os.stat('/proc/self/ns/mnt').st_ino == os.stat('/proc/1/ns/mnt').st_ino:
        os.execv('/usr/bin/unshare', ['/usr/bin/unshare', '--mount', '--propagation', 'private',
                                    '--', sys.executable, str(Path(__file__).resolve()), *sys.argv[1:]])
    require_success(run(['/usr/bin/mount', '-n', '--make-rprivate', '/'], timeout=30), 'private_mount_namespace')


def main() -> None:
    os.umask(0o077)
    if len(sys.argv) not in (2, 4) or sys.argv[1] not in SUBCOMMANDS:
        fail('fixed_subcommand_required')
    owner = None
    if len(sys.argv) == 4:
        if sys.argv[1] != 'daily-local' or sys.argv[2] != '--owner-sha256' or not SNAPSHOT_ID.fullmatch(sys.argv[3]):
            fail('owner_argument')
        owner = sys.argv[3]
    def interrupted(_number, _frame):
        raise WorkflowError('interrupted')
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGINT, interrupted)
    try:
        command = sys.argv[1]
        if command == 'daily-local' and not testing():
            capture_namespace()
        copying = command in {'daily-nfs', 'daily-proton'}
        with ExitStack() as stack:
            gate = rooted('/run/lock/home-lab-restic-repositories.lock')
            require_regular(gate, {0o660}, None if testing() else {0})
            gate_stream = stack.enter_context(gate.open('a+'))
            # Maintenance queues behind healthy readers instead of leaving a
            # failed unit that blocks admission after replication has finished.
            # Its native systemd start timeout bounds both this wait and the work.
            flags = fcntl.LOCK_EX if command == 'maintenance' else fcntl.LOCK_SH | fcntl.LOCK_NB
            try:
                fcntl.flock(gate_stream, flags)
            except BlockingIOError:
                if command == 'expire-snapshots':
                    print('restic_backup=snapshot_cleanup deferred=repository_maintenance')
                    return
                raise
            # Tool convergence publishes this fence, then drains all shared
            # readers through an exclusive barrier before replacing anything.
            # Check under the gate and read policy only after admission, so a
            # delayed caller cannot carry pre-update configuration across it.
            fence = rooted('/var/lib/home-lab-restic/tools-updating')
            if copying and (fence.exists() or fence.is_symlink()):
                raise WorkflowError('tools_update_active')
            policy, policy_hash = load_policy()
            policy['_owner'] = owner
            lock = rooted(policy["runner"]["lock_path"])
            if testing():
                lock.parent.mkdir(parents=True, exist_ok=True)
            if lock.exists():
                require_regular(lock, {0o660}, None if testing() else {0})
            elif not testing():
                raise WorkflowError("lock_path_missing")
            selected_lock = rooted('/run/lock/home-lab-restic-' + command + '.lock') if copying else lock
            require_regular(selected_lock, {0o660}, None if testing() else {0})
            stream = stack.enter_context(selected_lock.open('a+'))
            try:
                fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError as error:
                if command == 'expire-snapshots':
                    print('restic_backup=snapshot_cleanup deferred=active_capture')
                    return
                if command == 'maintenance':
                    print('restic_backup=maintenance deferred=backup_owner')
                    return
                raise WorkflowError("concurrent_operation") from error
            deploy_lock = rooted(policy["runner"]["deploy_lock_path"])
            if deploy_lock.exists() and not copying:
                if deploy_lock.is_symlink() or not deploy_lock.is_dir():
                    raise WorkflowError('deploy_lock_type')
                if command == 'maintenance':
                    print('restic_backup=maintenance deferred=production_owner')
                    return
                if owner is None and command == 'recover':
                    # Boot recovery may resume only this capture's recorded
                    # services, never adopt/release the retained production lock.
                    journal = read_json(journal_path(policy), {})
                    owner = journal.get('owner') if isinstance(journal, dict) else None
                if not isinstance(owner, str) or SNAPSHOT_ID.fullmatch(owner) is None:
                    raise WorkflowError('concurrent_deploy')
                require_regular(deploy_lock / 'owner', {0o600}, None if testing() else {0})
                if hashlib.sha256((deploy_lock / 'owner').read_bytes()).hexdigest() != owner:
                    raise WorkflowError('concurrent_deploy')
                policy['_owner'] = owner
            elif owner is not None:
                raise WorkflowError('owner_missing')
            if command in {'daily-local', 'daily-nfs', 'daily-proton', 'expire-snapshots', 'maintenance'}:
                snapshot_evidence()
            if command in {'recover', 'preflight', 'daily-local', 'expire-snapshots'}:
                capture = LocalCapture(policy)
                if command == 'recover':
                    capture.recover()
                elif command == 'preflight':
                    capture.preflight()
                    print('restic_backup=preflight_passed')
                elif command == 'daily-local':
                    capture.run(policy_hash)
                else:
                    capture.expire()
            elif command == "daily-nfs":
                reconcile(policy, 'nfs')
            elif command == "daily-proton":
                reconcile(policy, 'proton')
            elif command == "maintenance":
                maintenance(policy)
            elif command == "diagnose-proton":
                diagnose_proton(policy)
            else:
                status(policy, policy_hash)
    except (WorkflowError, KeyError, TypeError, ValueError, OSError) as error:
        fail(str(error) if isinstance(error, WorkflowError) else "internal_validation")


if __name__ == "__main__":
    main()
