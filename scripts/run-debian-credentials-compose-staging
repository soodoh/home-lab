#!/bin/bash
set -euo pipefail

readonly CONFIRMATION=stage-reviewed-vm-100-debian-credentials-compose-offline

[[ $# -eq 0 ]] || { echo "usage: scripts/run-debian-credentials-compose-staging" >&2; exit 1; }
[[ -t 0 ]] || { echo "Debian credential and Compose staging requires an interactive physical console" >&2; exit 1; }
printf 'Type the exact confirmation to stage credentials and validate Compose without starting Docker:\n%s\n' "$CONFIRMATION" >&2
IFS= read -r confirmation
[[ $confirmation == "$CONFIRMATION" ]] || { echo "exact Debian credential-staging confirmation is required" >&2; exit 1; }
export HOME_LAB_DEBIAN_QUALIFICATION_CONFIRMED=$CONFIRMATION
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
exec "$root/scripts/qualify-debian-inert"
