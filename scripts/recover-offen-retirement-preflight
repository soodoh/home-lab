#!/usr/bin/env python3
"""Recover the exact rolled-back preflight transaction without widening lock clearance."""
from __future__ import annotations

import fcntl
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import stat
import subprocess
import sys

OLD_MANIFEST_SHA256 = "73da02cd3917f2aa3f5a0eee6c355b825456d3f825f9b0c087c8b322c18b012e"
HELPER = Path("/usr/local/libexec/home-lab/retire-offen-local")
MANIFEST = Path("/etc/home-lab/offen-retirement-manifest.json")
TRANSACTION = Path("/var/lib/home-lab-restic/offen-retirement/local")
ROLLED_BACK = Path(f"/var/lib/home-lab-restic/offen-retirement/rolled-back-{OLD_MANIFEST_SHA256[:16]}")
MUTEX = Path("/run/lock/home-lab-backup.lock")


def fail(reason: str) -> None:
    raise SystemExit(f"offen_retirement_preflight_recovery=failed reason={reason}")


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def regular_private(path: Path, mode: int) -> bool:
    try:
        value = path.lstat()
    except FileNotFoundError:
        return False
    return stat.S_ISREG(value.st_mode) and value.st_uid == 0 and value.st_nlink == 1 and not path.is_symlink() and stat.S_IMODE(value.st_mode) == mode


def main() -> None:
    if os.geteuid() != 0 or len(sys.argv) != 2 or sys.argv[1] != OLD_MANIFEST_SHA256:
        fail("authorization_invalid")
    if not regular_private(MANIFEST, 0o400) or sha256(MANIFEST) != OLD_MANIFEST_SHA256:
        fail("installed_manifest_invalid")
    manifest = json.loads(MANIFEST.read_text())
    if not regular_private(HELPER, 0o750) or sha256(HELPER) != manifest.get("tools", {}).get("local_helper_sha256"):
        fail("installed_helper_invalid")
    if ROLLED_BACK.exists() or ROLLED_BACK.is_symlink() or not TRANSACTION.is_dir() or TRANSACTION.is_symlink():
        fail("transaction_topology_invalid")

    loader = importlib.machinery.SourceFileLoader("retire_offen_local_recovery", str(HELPER))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        fail("helper_import_invalid")
    helper = importlib.util.module_from_spec(spec)
    loader.exec_module(helper)
    helper.MANIFEST = MANIFEST
    helper.TRANSACTION = TRANSACTION
    helper.OWNER = TRANSACTION / "owner.json"
    helper.ACTION_PLAN = TRANSACTION / "action-plan.json"
    helper.JOURNAL = TRANSACTION / "journal.jsonl"
    helper.FINAL_RESULT = TRANSACTION / "final-result.json"

    with MUTEX.open("a+") as mutex:
        fcntl.flock(mutex, fcntl.LOCK_EX)
        policy = json.loads(Path("/etc/home-lab/restic-policy.json").read_text())
        restic_journal = Path(policy.get("runner", {}).get("journal_path", ""))
        if not restic_journal.is_absolute() or restic_journal.exists() or restic_journal.is_symlink():
            fail("restic_journal_state_invalid")
        plan, plan_hash, _owner_hash = helper.load_saved_transaction(manifest, OLD_MANIFEST_SHA256)
        events = helper.journal_events()
        rollback_events = [item for item in events if item.get("event") == "rollback_complete"]
        if rollback_events != [{"event": "rollback_complete", "action_plan_sha256": plan_hash}]:
            fail("rollback_evidence_invalid")
        if any(item.get("event") == "irreversible_unlink_started" for item in events):
            fail("irreversible_state_forbidden")
        helper.verify_status_under_lock(manifest)
        helper.verify_mounts(manifest)
        helper.verify_archives(manifest, OLD_MANIFEST_SHA256, False)
        helper.verify_containers(manifest, OLD_MANIFEST_SHA256, False)
        for change in plan["container_renames"]:
            original = subprocess.run(
                ["docker", "inspect", "--format", "{{.Id}}", change["from"]],
                text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            )
            renamed = subprocess.run(
                ["docker", "inspect", change["to"]],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
            if original.returncode != 0 or original.stdout.strip() != change["container_id"] or renamed.returncode == 0:
                fail("rollback_container_identity_invalid")
        TRANSACTION.rename(ROLLED_BACK)
        descriptor = os.open(ROLLED_BACK.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    print(f"offen_retirement_preflight_recovery=rolled-back-retained manifest_sha256={OLD_MANIFEST_SHA256}")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, json.JSONDecodeError):
        fail("controlled_failure")
