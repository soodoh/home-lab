#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
uid=$(id -u)
gid=$(id -g)
source="$work/production.env"
destination="$work/credentials"

cat >"$source" <<'EOF'
MYSQL_PASSWORD='application password # fixture'
MYSQL_ROOT_PASSWORD="root-password-fixture"
EOF
chmod 0600 "$source"

common=(
  "$repo_root/scripts/materialize-compose-secret-files.py"
  --dotenv "$source"
  --directory "$destination"
  --owner-uid "$uid"
  --group-gid "$gid"
  --secret MYSQL_PASSWORD=nextcloud-mysql-password
  --secret MYSQL_ROOT_PASSWORD=nextcloud-mariadb-root-password
)

"${common[@]}" >/dev/null
"${common[@]}" --check >/dev/null
[[ $(stat -f '%Lp' "$destination/nextcloud-mysql-password" 2>/dev/null || stat -c '%a' "$destination/nextcloud-mysql-password") == 600 ]]
[[ $(cat "$destination/nextcloud-mysql-password") == 'application password # fixture' ]]
[[ $(cat "$destination/nextcloud-mariadb-root-password") == 'root-password-fixture' ]]

rm "$destination/nextcloud-mysql-password"
ln -s /dev/null "$destination/nextcloud-mysql-password"
if "${common[@]}" >/dev/null 2>&1; then
  echo "symlink destination unexpectedly passed" >&2
  exit 1
fi
rm "$destination/nextcloud-mysql-password"
printf fixture >"$work/hardlink-source"
chmod 0600 "$work/hardlink-source"
ln "$work/hardlink-source" "$destination/nextcloud-mysql-password"
if "${common[@]}" >/dev/null 2>&1; then
  echo "hard-link destination unexpectedly passed" >&2
  exit 1
fi

missing="$work/missing.env"
printf 'MYSQL_PASSWORD=fixture\n' >"$missing"
chmod 0600 "$missing"
if "$repo_root/scripts/materialize-compose-secret-files.py" \
  --dotenv "$missing" --directory "$work/missing-credentials" \
  --owner-uid "$uid" --group-gid "$gid" \
  --secret MYSQL_ROOT_PASSWORD=nextcloud-mariadb-root-password >/dev/null 2>&1; then
  echo "missing secret key unexpectedly passed" >&2
  exit 1
fi

if "$repo_root/scripts/check-sops-env.py" \
  "$repo_root/secrets/production.sops.env" \
  "$repo_root/secrets/production.env.keys" \
  "$repo_root/secrets/production.env.layout.json" \
  age1wrongrecipient >/dev/null 2>&1; then
  echo "wrong SOPS recipient unexpectedly passed" >&2
  exit 1
fi

echo "compose secret file fixtures passed"
