#!/usr/bin/env bash
set -euo pipefail
umask 077

mode=${1:-}
case "$mode" in --check|--apply|--verify) ;; *) exit 64 ;; esac
[[ $EUID -eq 0 ]]
for command in apt-cache apt-get modinfo pveversion qm pct zfs zpool; do
  command -v "$command" >/dev/null || { echo "missing command: $command" >&2; exit 69; }
done

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
kernel_release=$(awk '$1 == "current:" {print $2; exit}' \
  "$repo_root/infrastructure/contract/home-lab.yml")
[[ $kernel_release =~ ^[0-9]+\.[0-9]+\.[0-9]+-[0-9]+-pve$ ]]
kernel_package_version=${kernel_release%-pve}
kernel_family=$(sed -E 's/^([0-9]+\.[0-9]+).*/\1/' <<<"$kernel_release")
kernel_package="proxmox-kernel-$kernel_family"
zfs_package_version=2.4.3-pve1
packages=(
  "$kernel_package=$kernel_package_version"
  "zfsutils-linux=$zfs_package_version"
  "zfs-zed=$zfs_package_version"
)

require_runtime_health() {
  [[ $(zpool list -H -o health storage) == ONLINE ]]
  qm status 100 | grep -q 'status: running'
  pct status 101 | grep -q 'status: running'
}

require_versions_available() {
  apt-cache show "$kernel_package=$kernel_package_version" >/dev/null
  apt-cache show "zfsutils-linux=$zfs_package_version" >/dev/null
  apt-cache show "zfs-zed=$zfs_package_version" >/dev/null
}

if [[ $mode == --check ]]; then
  require_runtime_health
  require_versions_available
  apt-get --simulate install --only-upgrade -- "${packages[@]}"
  printf 'proxmox_zfs_migration=check-only target_kernel=%s target_zfs=%s\n' \
    "$kernel_release" "$zfs_package_version"
  exit 0
fi

if [[ $mode == --apply ]]; then
  [[ ${PROXMOX_ZFS_MIGRATION_CONFIRMED:-} == install-reviewed-zfs-and-kernel-packages ]]
  [[ ${PROXMOX_CONSOLE_CONFIRMED:-} == true ]]
  require_runtime_health
  apt-get update
  require_versions_available
  DEBIAN_FRONTEND=noninteractive apt-get install --yes --only-upgrade -- "${packages[@]}"
  dpkg-query -W -f='${Version}' "$kernel_package" | grep -qx "$kernel_package_version"
  dpkg-query -W -f='${Version}' zfsutils-linux | grep -qx "$zfs_package_version"
  dpkg-query -W -f='${Version}' zfs-zed | grep -qx "$zfs_package_version"
  require_runtime_health
  printf 'proxmox_zfs_migration=packages-installed reboot-required target_kernel=%s\n' "$kernel_release"
  exit 0
fi

[[ $(uname -r) == "$kernel_release" ]]
userspace_version=$(zfs version | awk -F- '$1 == "zfs" && $2 != "kmod" {print $2 "-" $3}')
module_version=$(modinfo -F version zfs)
[[ $userspace_version == "$zfs_package_version" ]]
[[ $module_version == "$zfs_package_version" ]]
require_runtime_health
printf 'proxmox_zfs_migration=verified kernel=%s zfs=%s\n' "$kernel_release" "$zfs_package_version"
