#!/usr/bin/env bash
set -euo pipefail
umask 077

usage() {
  echo "usage: grow-proxmox-vm-root-disk <inspect|apply>" >&2
  exit 64
}

(($# == 1)) || usage
action=$1
[[ $action == inspect || $action == apply ]] || usage
[[ $EUID == 0 ]] || { echo "root privileges are required" >&2; exit 77; }
: "${HOMELAB_GAMES_DISK_BY_ID:?protected games disk identity is required}"
[[ $HOMELAB_GAMES_DISK_BY_ID == /dev/disk/by-id/* ]]

vm_id=100
disk_interface=scsi0
expected_volume=local-lvm:vm-100-disk-0
source_size=400
target_size=550
lock_file=/run/lock/home-lab-vm-100-root-disk-growth.lock

exec 9>"$lock_file"
flock -x 9

inspect_state() {
  local config status protection root_disk games_disk root_volume root_size
  config=$(qm config "$vm_id")
  status=$(qm status "$vm_id")
  [[ $status == "status: running" ]]
  protection=$(awk -F ': ' '$1 == "protection" {print $2; exit}' <<<"$config")
  root_disk=$(awk -F ': ' -v interface="$disk_interface" '$1 == interface {print $2; exit}' <<<"$config")
  games_disk=$(awk -F ': ' '$1 == "scsi1" {print $2; exit}' <<<"$config")
  [[ $protection == 1 ]]
  [[ $root_disk == "$expected_volume,"* ]]
  [[ $games_disk == "$HOMELAB_GAMES_DISK_BY_ID,"* ]]
  root_volume=${root_disk%%,*}
  [[ $root_volume == "$expected_volume" ]]
  root_size=$(tr ',' '\n' <<<"$root_disk" | awk -F= '$1 == "size" {sub(/G$/, "", $2); print $2; exit}')
  [[ $root_size =~ ^[0-9]+$ ]]
  if ((root_size == target_size)); then
    echo "proxmox_vm_root_disk=converged size_gib=$target_size"
    return 0
  fi
  if ((root_size == source_size)); then
    echo "proxmox_vm_root_disk=growth-required from_gib=$source_size to_gib=$target_size"
    return 2
  fi
  echo "unexpected VM root-disk size" >&2
  return 1
}

set +e
inspect_state
state=$?
set -e
if [[ $action == inspect ]]; then
  exit "$state"
fi
[[ ${PROXMOX_ROOT_DISK_GROWTH_CONFIRMED:-} == grow-reviewed-docker-root-disk ]] || {
  echo "exact Proxmox root-disk growth confirmation is required" >&2
  exit 77
}
if ((state == 0)); then
  exit 0
fi
((state == 2)) || exit "$state"

qm resize "$vm_id" "$disk_interface" "${target_size}G" >/dev/null
inspect_state
