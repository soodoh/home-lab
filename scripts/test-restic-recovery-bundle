#!/usr/bin/env bash
set -euo pipefail
repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -m 0700 "$work/out"

for name in restic rclone; do
  cat >"$work/$name" <<SH
#!/usr/bin/env bash
if [[ \${1:-} == obscure ]]; then cat >/dev/null; printf 'obscured-fixture\\n'; exit 0; fi
echo $name
SH
  chmod 0755 "$work/$name"
done
cat >"$work/restore-critical-backup" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
[[ $1 == --restic-snapshot-id && $3 == --confirmed-empty-target ]]
[[ $RECOVERY_RESTIC_REPOSITORY == rclone:proton_backup:Backups/home-lab-restic ]]
if [[ $RECOVERY_TARGET == *interrupt* ]]; then sleep 60; fi
mkdir -p "$RECOVERY_TARGET/srv/home-lab-state"
printf verified >"$RECOVERY_TARGET/srv/home-lab-state/fixture"
printf 'recovery_restore=verified backend=restic snapshot=%s\n' "$2"
SH
chmod 0755 "$work/restore-critical-backup"
cat >"$work/age" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
[[ $1 == --encrypt && $2 == --recipient && $# == 3 ]]
[[ ${FAIL_AGE:-false} != true ]] || exit 1
printf '%s\n' "$3"
cat
SH
chmod 0755 "$work/age"

sha() { sha256sum "$1" | awk '{print $1}'; }
restic_sha=$(sha "$work/restic")
rclone_sha=$(sha "$work/rclone")
runner_sha=$(sha "$work/restore-critical-backup")
age_sha=$(sha "$work/age")
cat >"$work/metadata.json" <<JSON
{"artifact_sha256":"$(printf 'a%.0s' {1..64})","first_run_evidence_sha256":"$(printf 'b%.0s' {1..64})","original_snapshot_id":"edd4f507cec382e6fae48e2690ffa53ae7ef7a61e24581983975631cbe5a32e2","policy_sha256":"09f86d94190f0020488bad8285d60ef42f26a4e285992be1973e38fd3387e5a6","qualification_evidence_sha256":"$(printf 'c%.0s' {1..64})","rclone_sha256":"$rclone_sha","repository":"rclone:proton_backup:Backups/home-lab-restic","repository_id":"d1faa9cd772dd13275b8d4db376c2bbba0b82a9415a28b0d03a8b17e37b7fb7e","restic_sha256":"$restic_sha","restore_runner_sha256":"$runner_sha","snapshot_id":"95be7e9b0a03cedd06340fdcf63055c67205c3a6c28687ffd2dc99e733bfa71e","version":1}
JSON
chmod 0600 "$work/metadata.json"
recipient_a=age1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq
recipient_b=age1pppppppppppppppppppppppppppppppppppppppppppppppppppppppp
common=(
  RECOVERY_BUNDLE_RESTIC_PASSWORD=fixture-restic-password-longer-than-thirty-two-bytes
  RECOVERY_BUNDLE_PROTON_USERNAME=fixture-user
  RECOVERY_BUNDLE_PROTON_LOGIN_PASSWORD=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmn1234567890
)
build() {
  local recipient=$1 output=$2
  env "${common[@]}" "$repo_root/scripts/build-restic-recovery-bundle" \
    --metadata "$work/metadata.json" --restic "$work/restic" --rclone "$work/rclone" \
    --restore-runner "$work/restore-critical-backup" --age "$work/age" --age-sha256 "$age_sha" \
    --recipient "$recipient" --output "$output"
}
result_a=$(build "$recipient_a" "$work/out/a.age")
result_b=$(build "$recipient_b" "$work/out/b.age")
RESULT_A="$result_a" RESULT_B="$result_b" CIPHERTEXT_A="$work/out/a.age" python3 - <<'PY'
import hashlib
import io
import json
import os
import tarfile
a=json.loads(os.environ["RESULT_A"]); b=json.loads(os.environ["RESULT_B"])
assert a["state"] == b["state"] == "encrypted"
assert a["plaintext_sha256"] == b["plaintext_sha256"]
assert a["ciphertext_sha256"] != b["ciphertext_sha256"]
assert a["recipient_sha256"] != b["recipient_sha256"]
raw=open(os.environ["CIPHERTEXT_A"], "rb").read().split(b"\n", 1)[1]
with tarfile.open(fileobj=io.BytesIO(raw), mode="r:") as archive:
    members=archive.getmembers()
    assert [member.name for member in members] == sorted(member.name for member in members)
    assert all(member.uid == member.gid == member.mtime == 0 and member.isfile() for member in members)
    manifest=json.load(archive.extractfile("MANIFEST.json"))
    for name, expected in manifest.items():
        content=archive.extractfile(name).read()
        assert len(content) == expected["size"]
        assert hashlib.sha256(content).hexdigest() == expected["sha256"]
PY
[[ $(stat -f '%Lp' "$work/out/a.age" 2>/dev/null || stat -c '%a' "$work/out/a.age") == 600 ]]

recovery_parent="$work/recovery"
recovery_target="$recovery_parent/restic-proton-proof"
workspace_parent="$work/run-restic-recovery"
mkdir -m 0700 "$recovery_parent" "$recovery_target" "$workspace_parent"
CONSUMER_SOURCE="$repo_root/scripts/run-restic-recovery-bundle" CONSUMER_TARGET="$work/run-restic-recovery-bundle" \
  RECOVERY_TARGET="$recovery_target" WORKSPACE_PARENT="$workspace_parent" python3 - <<'PY'
import os
from pathlib import Path
source=Path(os.environ["CONSUMER_SOURCE"]).read_text()
source=source.replace("/srv/home-lab-recovery/restic-proton-proof", os.environ["RECOVERY_TARGET"])
source=source.replace("/var/tmp/restic-recovery", os.environ["WORKSPACE_PARENT"])
target=Path(os.environ["CONSUMER_TARGET"])
target.write_text(source)
target.chmod(0o755)
PY
tail -n +2 "$work/out/a.age" >"$work/plaintext.tar"
plaintext_sha=$(python3 -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest())' "$work/plaintext.tar")
consumer_output=$(umask 077; RECOVERY_DISPOSABLE_VM_CONFIRMED=fresh-disposable-vm-without-host-tokens \
  "$work/run-restic-recovery-bundle" --expected-plaintext-sha256 "$plaintext_sha" \
  --expected-snapshot-id 95be7e9b0a03cedd06340fdcf63055c67205c3a6c28687ffd2dc99e733bfa71e \
  --expected-original-snapshot-id edd4f507cec382e6fae48e2690ffa53ae7ef7a61e24581983975631cbe5a32e2 \
  --expected-repository-id d1faa9cd772dd13275b8d4db376c2bbba0b82a9415a28b0d03a8b17e37b7fb7e \
  --expected-policy-sha256 09f86d94190f0020488bad8285d60ef42f26a4e285992be1973e38fd3387e5a6 \
  --expected-artifact-sha256 "$(printf 'a%.0s' {1..64})" --target "$recovery_target" <"$work/plaintext.tar")
CONSUMER_OUTPUT="$consumer_output" python3 - <<'PY'
import json,os
value=json.loads(os.environ["CONSUMER_OUTPUT"])
assert value["state"] == "restored-verified" and value["files"] == 1
PY
[[ $(cat "$recovery_target/srv/home-lab-state/fixture") == verified ]]
[[ -z $(find "$workspace_parent" -mindepth 1 -print -quit) ]]

totp_secret=JBSWY3DPEHPK3PXP
env "${common[@]}" RECOVERY_BUNDLE_PROTON_TOTP_SECRET="$totp_secret" \
  "$repo_root/scripts/build-restic-recovery-bundle" \
  --metadata "$work/metadata.json" --restic "$work/restic" --rclone "$work/rclone" \
  --restore-runner "$work/restore-critical-backup" --age "$work/age" --age-sha256 "$age_sha" \
  --recipient "$recipient_a" --output "$work/out/totp.age" >/dev/null
tail -n +2 "$work/out/totp.age" >"$work/totp-plaintext.tar"
TOTP_TAR="$work/totp-plaintext.tar" TOTP_SECRET="$totp_secret" python3 - <<'PY'
import io,os,tarfile
raw=open(os.environ["TOTP_TAR"],"rb").read()
with tarfile.open(fileobj=io.BytesIO(raw),mode="r:") as archive:
    names={member.name for member in archive.getmembers()}
    assert "private/proton-totp-seed" in names
    assert archive.extractfile("private/proton-totp-seed").read().decode().rstrip("\n") == os.environ["TOTP_SECRET"]
PY
totp_parent="$work/totp-recovery"
totp_target="$totp_parent/restic-proton-proof"
totp_workspace="$work/totp-run-restic-recovery"
mkdir -m 0700 "$totp_parent" "$totp_target" "$totp_workspace"
CONSUMER_SOURCE="$repo_root/scripts/run-restic-recovery-bundle" CONSUMER_TARGET="$work/run-totp-restic-recovery-bundle" \
  RECOVERY_TARGET="$totp_target" WORKSPACE_PARENT="$totp_workspace" python3 - <<'PY'
import os
from pathlib import Path
source=Path(os.environ["CONSUMER_SOURCE"]).read_text()
source=source.replace("/srv/home-lab-recovery/restic-proton-proof",os.environ["RECOVERY_TARGET"])
source=source.replace("/var/tmp/restic-recovery",os.environ["WORKSPACE_PARENT"])
target=Path(os.environ["CONSUMER_TARGET"]); target.write_text(source); target.chmod(0o755)
PY
totp_plaintext_sha=$(sha "$work/totp-plaintext.tar")
RECOVERY_DISPOSABLE_VM_CONFIRMED=fresh-disposable-vm-without-host-tokens \
  "$work/run-totp-restic-recovery-bundle" --expected-plaintext-sha256 "$totp_plaintext_sha" \
  --expected-snapshot-id 95be7e9b0a03cedd06340fdcf63055c67205c3a6c28687ffd2dc99e733bfa71e \
  --expected-original-snapshot-id edd4f507cec382e6fae48e2690ffa53ae7ef7a61e24581983975631cbe5a32e2 \
  --expected-repository-id d1faa9cd772dd13275b8d4db376c2bbba0b82a9415a28b0d03a8b17e37b7fb7e \
  --expected-policy-sha256 09f86d94190f0020488bad8285d60ef42f26a4e285992be1973e38fd3387e5a6 \
  --expected-artifact-sha256 "$(printf 'a%.0s' {1..64})" --target "$totp_target" \
  <"$work/totp-plaintext.tar" >/dev/null
[[ $(cat "$totp_target/srv/home-lab-state/fixture") == verified ]]
[[ -z $(find "$totp_workspace" -mindepth 1 -print -quit) ]]

interrupt_parent="$work/interrupt-recovery"
interrupt_target="$interrupt_parent/restic-proton-proof"
interrupt_workspace="$work/interrupt-run-restic-recovery"
mkdir -m 0700 "$interrupt_parent" "$interrupt_target" "$interrupt_workspace"
CONSUMER_SOURCE="$repo_root/scripts/run-restic-recovery-bundle" CONSUMER_TARGET="$work/run-interrupted-restic-recovery-bundle" \
  RECOVERY_TARGET="$interrupt_target" WORKSPACE_PARENT="$interrupt_workspace" python3 - <<'PY'
import os
from pathlib import Path
source=Path(os.environ["CONSUMER_SOURCE"]).read_text()
source=source.replace("/srv/home-lab-recovery/restic-proton-proof", os.environ["RECOVERY_TARGET"])
source=source.replace("/var/tmp/restic-recovery", os.environ["WORKSPACE_PARENT"])
target=Path(os.environ["CONSUMER_TARGET"])
target.write_text(source)
target.chmod(0o755)
PY
RECOVERY_DISPOSABLE_VM_CONFIRMED=fresh-disposable-vm-without-host-tokens \
  "$work/run-interrupted-restic-recovery-bundle" --expected-plaintext-sha256 "$plaintext_sha" \
  --expected-snapshot-id 95be7e9b0a03cedd06340fdcf63055c67205c3a6c28687ffd2dc99e733bfa71e \
  --expected-original-snapshot-id edd4f507cec382e6fae48e2690ffa53ae7ef7a61e24581983975631cbe5a32e2 \
  --expected-repository-id d1faa9cd772dd13275b8d4db376c2bbba0b82a9415a28b0d03a8b17e37b7fb7e \
  --expected-policy-sha256 09f86d94190f0020488bad8285d60ef42f26a4e285992be1973e38fd3387e5a6 \
  --expected-artifact-sha256 "$(printf 'a%.0s' {1..64})" --target "$interrupt_target" \
  <"$work/plaintext.tar" >/dev/null 2>&1 &
consumer_pid=$!
for _ in {1..100}; do
  find "$interrupt_workspace" -path '*/private/restic-password' -print -quit | grep -q . && break
  sleep 0.05
done
find "$interrupt_workspace" -path '*/private/restic-password' -print -quit | grep -q .
kill -TERM "$consumer_pid"
if wait "$consumer_pid"; then
  echo 'interrupted recovery consumer unexpectedly passed' >&2
  exit 1
fi
[[ -z $(find "$interrupt_workspace" -mindepth 1 -print -quit) ]]

if env "${common[@]}" RECOVERY_BUNDLE_PROTON_MAILBOX_PASSWORD=forbidden \
  "$repo_root/scripts/build-restic-recovery-bundle" --metadata "$work/metadata.json" \
  --restic "$work/restic" --rclone "$work/rclone" --restore-runner "$work/restore-critical-backup" \
  --age "$work/age" --age-sha256 "$age_sha" --recipient "$recipient_a" --output "$work/out/forbidden.age" >/dev/null 2>&1; then
  echo 'forbidden recovery bundle field unexpectedly passed' >&2
  exit 1
fi
[[ ! -e $work/out/forbidden.age ]]

if env "${common[@]}" FAIL_AGE=true "$repo_root/scripts/build-restic-recovery-bundle" \
  --metadata "$work/metadata.json" --restic "$work/restic" --rclone "$work/rclone" \
  --restore-runner "$work/restore-critical-backup" --age "$work/age" --age-sha256 "$age_sha" \
  --recipient "$recipient_a" --output "$work/out/failed.age" >/dev/null 2>&1; then
  echo 'failed age encryption unexpectedly passed' >&2
  exit 1
fi
[[ ! -e $work/out/failed.age ]]

cp "$work/out/a.age" "$work/out/existing.age"
existing_sha=$(sha "$work/out/existing.age")
if build "$recipient_b" "$work/out/existing.age" >/dev/null 2>&1; then
  echo 'existing bundle destination unexpectedly replaced' >&2
  exit 1
fi
[[ $(sha "$work/out/existing.age") == "$existing_sha" ]]

printf 'restic recovery bundle fixtures passed\n'
