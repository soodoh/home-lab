#!/usr/bin/env python3
"""Guarded, crash-resumable local half of the exact Offen retirement."""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import sys

MANIFEST = Path("/etc/home-lab/offen-retirement-manifest.json")
TRANSACTION = Path("/var/lib/home-lab-restic/offen-retirement/local")
STAGED_EVIDENCE = Path("/etc/home-lab/offen-retirement-staged-evidence.json")
FINAL_RESULT = Path("/var/lib/home-lab-restic/offen-retirement/local-final-result.json")
MUTEX = Path("/run/lock/home-lab-backup.lock")
OWNER = TRANSACTION / "owner.json"
ACTION_PLAN = TRANSACTION / "action-plan.json"
JOURNAL = TRANSACTION / "journal.jsonl"
HEX64 = set("0123456789abcdef")


def fail(reason: str) -> None:
    raise SystemExit(f"offen_retirement_local=failed reason={reason}")


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for block in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def canonical(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def run(command: list[str]) -> str:
    return subprocess.run(command, check=True, text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.strip()


def load_manifest(expected: str) -> tuple[dict, str]:
    if len(expected) != 64 or set(expected) - HEX64:
        fail("manifest_confirmation_invalid")
    if not MANIFEST.is_file() or MANIFEST.is_symlink():
        fail("manifest_identity_invalid")
    actual = sha256(MANIFEST)
    if actual != expected:
        fail("manifest_hash_differs")
    value = json.loads(MANIFEST.read_text())
    local = value.get("local", {})
    if sha256(Path(__file__)) != value.get("tools", {}).get("local_helper_sha256"):
        fail("helper_hash_differs")
    if value.get("state") != "retirement-planned" or len(local.get("archives", [])) != 12 or len(local.get("metadata_files", [])) != 8:
        fail("manifest_scope_invalid")
    return value, actual


def tombstone(path: Path, manifest_hash: str) -> Path:
    return path.with_name(f".{path.name}.offen-retirement-{manifest_hash[:16]}")


def verify_status() -> None:
    status = run(["/usr/local/libexec/home-lab/restic-backup", "status"])
    required = ("migration=active", "repositories_ready=true", "pending=0", "interruption=false")
    if not all(item in status.split() for item in required):
        fail("restic_status_invalid")
    for unit in ("home-lab-restic-daily.timer", "home-lab-restic-maintenance.timer"):
        if run(["systemctl", "is-active", unit]) != "active" or run(["systemctl", "is-enabled", unit]) != "enabled":
            fail("restic_timer_invalid")
        if run(["systemctl", "show", "-p", "Persistent", "--value", unit]) != "no":
            fail("persistent_timer_forbidden")
    if run(["systemctl", "is-enabled", "home-lab-restic-recover.service"]) != "enabled":
        fail("recovery_service_invalid")


def verify_status_under_lock(manifest: dict) -> None:
    policy_path = Path("/etc/home-lab/restic-policy.json")
    if not policy_path.is_file() or policy_path.is_symlink():
        fail("restic_policy_invalid")
    policy = json.loads(policy_path.read_text())
    repositories = policy.get("repositories", {})
    expected_ids = manifest.get("restic_repositories", {})
    observed_ids = {
        name: value.get("id")
        for name, value in repositories.items()
        if isinstance(name, str) and isinstance(value, dict)
    } if isinstance(repositories, dict) else {}
    if policy.get("migration_state") != "active" or observed_ids != expected_ids:
        fail("restic_policy_state_invalid")
    runner = policy.get("runner", {})
    accepted_path = Path(runner.get("accepted_path", ""))
    journal_path = Path(runner.get("journal_path", ""))
    if (not accepted_path.is_absolute() or not accepted_path.is_file()
            or accepted_path.is_symlink() or not journal_path.is_absolute() or journal_path.exists()):
        fail("restic_transaction_state_invalid")
    accepted = json.loads(accepted_path.read_text())
    if not isinstance(accepted, dict) or accepted.get("version") != 1 or accepted.get("pending") != []:
        fail("restic_pending_state_invalid")


def verify_mounts(manifest: dict) -> None:
    for item in manifest["local"]["mounts"]:
        output = run(["findmnt", "--noheadings", "--output", "FSTYPE,SOURCE", "--target", item["mountpoint"]])
        filesystem, source = output.split(maxsplit=1)
        if filesystem != item["filesystem"]:
            fail("mount_filesystem_differs")
        if filesystem == "ext4":
            observed = run(["findmnt", "--noheadings", "--output", "UUID", "--target", item["mountpoint"]])
        else:
            observed = source
        if observed != item["identity"]:
            fail("mount_identity_differs")


def verify_file(path: Path, item: dict) -> None:
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or path.is_symlink():
        fail("archive_metadata_invalid")
    if info.st_size != item["bytes"] or sha256(path) != item["sha256"]:
        fail("archive_identity_differs")


def retirement_files(manifest: dict) -> list[dict]:
    return [{"kind": "archive", **item} for item in manifest["local"]["archives"]] + [
        {"kind": "metadata", **item} for item in manifest["local"]["metadata_files"]
    ]


def verify_archives(manifest: dict, manifest_hash: str, allow_tombstones: bool, allow_removed: bool = False) -> None:
    archive_by_path = {Path(item["path"]): item for item in manifest["local"]["archives"]}
    metadata_by_path = {Path(item["path"]): item for item in manifest["local"]["metadata_files"]}
    protected_paths = {Path(item["path"]) for item in manifest["local"]["protected_directories"]}
    for expected in manifest["local"]["protected_directories"]:
        directory = Path(expected["path"])
        if not directory.exists():
            if allow_removed:
                continue
            fail("protected_directory_invalid")
        if not directory.is_dir() or directory.is_symlink():
            fail("protected_directory_invalid")
        info = directory.lstat()
        if info.st_uid != expected["uid"] or info.st_gid != expected["gid"] or stat.S_IMODE(info.st_mode) != int(expected["mode"], 8):
            fail("protected_directory_metadata_differs")
        allowed = {path.name for path in archive_by_path if path.parent == directory}
        if allow_tombstones:
            allowed |= {tombstone(path, manifest_hash).name for path in archive_by_path if path.parent == directory}
        if {entry.name for entry in directory.iterdir()} - allowed:
            fail("protected_directory_has_unexpected_entry")
    top_roots = {path.parent for path in archive_by_path if path.parent not in protected_paths}
    expected_top_archives = {path for path in archive_by_path if path.parent in top_roots}
    expected_top_metadata = set(metadata_by_path)
    for root in top_roots:
        observed_archives = {path for path in root.glob("daily-local-backup-*.tar.gz.gpg") if ".offen-retirement-" not in path.name}
        observed_metadata = {path for path in root.glob("daily-local-backup-*.tar.gz.gpg.sha256") if ".offen-retirement-" not in path.name}
        if observed_archives != {path for path in expected_top_archives if path.parent == root and path.exists()}:
            fail("unmanifested_archive_found")
        if observed_metadata != {path for path in expected_top_metadata if path.parent == root and path.exists()}:
            fail("unmanifested_metadata_found")
    for item in retirement_files(manifest):
        path = Path(item["path"])
        renamed = tombstone(path, manifest_hash)
        candidates = [candidate for candidate in (path, renamed) if candidate.exists() or candidate.is_symlink()]
        if not candidates and allow_removed:
            continue
        if len(candidates) != 1:
            fail("archive_state_ambiguous")
        if candidates[0] == renamed and not allow_tombstones:
            fail("unexpected_tombstone")
        verify_file(candidates[0], item)
        if item["kind"] == "metadata":
            fields = candidates[0].read_text().strip().split()
            if fields != [item["expected_archive_sha256"], Path(item["archive_path"]).name]:
                fail("checksum_metadata_invalid")


def container_state(service: str, manifest_hash: str) -> tuple[str, str, str]:
    original = service
    renamed = f"offen-retirement-{manifest_hash[:16]}-{service}"
    existing = []
    for name in (original, renamed):
        result = subprocess.run(["docker", "inspect", name], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        if result.returncode == 0:
            existing.append((name, result.stdout))
    if len(existing) != 1:
        fail("container_state_ambiguous")
    name, raw = existing[0]
    value = json.loads(raw)[0]
    labels = value["Config"]["Labels"]
    if (value["State"]["Running"]
            or labels.get("com.docker.compose.service") != service
            or labels.get("com.docker.compose.project") != "docker-compose"
            or labels.get("com.docker.compose.project.working_dir") != "/srv/docker-compose/current"):
        fail("container_identity_invalid")
    return name, value["Image"], value["Id"]


def verify_containers(manifest: dict, manifest_hash: str, allow_renamed: bool, allow_removed: bool = False) -> None:
    expected_digest = manifest["compose"]["image"].split("@sha256:", 1)[1]
    for service in manifest["compose"]["services"]:
        names = (service, f"offen-retirement-{manifest_hash[:16]}-{service}")
        found = []
        for name in names:
            result = subprocess.run(["docker", "inspect", name], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            if result.returncode == 0:
                found.append((name, json.loads(result.stdout)[0]))
        if not found and allow_removed:
            continue
        if len(found) != 1:
            fail("container_state_ambiguous")
        name, value = found[0]
        if name != service and not allow_renamed:
            fail("unexpected_renamed_container")
        labels = value["Config"]["Labels"]
        if (value["State"]["Running"] or labels.get("com.docker.compose.service") != service
                or labels.get("com.docker.compose.project") != "docker-compose"
                or labels.get("com.docker.compose.project.working_dir") != "/srv/docker-compose/current"):
            fail("container_identity_invalid")
        inspect = json.loads(run(["docker", "image", "inspect", value["Image"]]))[0]
        if not any(item.endswith("@sha256:" + expected_digest) for item in (inspect.get("RepoDigests") or [])):
            fail("offen_image_identity_differs")


def action_plan(manifest: dict, manifest_hash: str) -> dict:
    return {
        "version": 1,
        "manifest_sha256": manifest_hash,
        "container_renames": [
            {
                "from": service,
                "to": f"offen-retirement-{manifest_hash[:16]}-{service}",
                "container_id": container_state(service, manifest_hash)[2],
            }
            for service in manifest["compose"]["services"]
        ],
        "file_renames": [{"kind": item["kind"], "from": item["path"], "to": str(tombstone(Path(item["path"]), manifest_hash))} for item in retirement_files(manifest)],
    }


def append(event: dict) -> None:
    TRANSACTION.mkdir(parents=True, exist_ok=True, mode=0o700)
    flags = os.O_WRONLY | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0)
    if JOURNAL.exists() or JOURNAL.is_symlink():
        _regular_private(JOURNAL)
        descriptor = os.open(JOURNAL, flags)
    else:
        descriptor = os.open(JOURNAL, flags | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, "ab", buffering=0) as target:
        target.write(canonical(event))
        os.fsync(target.fileno())


def create_owner(manifest_hash: str, plan: dict, plan_hash: str) -> None:
    TRANSACTION.mkdir(parents=True, exist_ok=True, mode=0o700)
    plan_bytes = canonical(plan)
    if ACTION_PLAN.exists():
        if ACTION_PLAN.read_bytes() != plan_bytes:
            fail("action_plan_differs")
    else:
        descriptor = os.open(ACTION_PLAN, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(descriptor, "wb", buffering=0) as target:
            target.write(plan_bytes); os.fsync(target.fileno())
    value = {"operation": "offen-retirement-local", "manifest_sha256": manifest_hash, "action_plan_sha256": plan_hash}
    if OWNER.exists():
        if OWNER.read_bytes() != canonical(value):
            fail("transaction_owner_differs")
        return
    descriptor = os.open(OWNER, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, "wb", buffering=0) as target:
        target.write(canonical(value)); os.fsync(target.fileno())
    os.fsync(os.open(TRANSACTION, os.O_RDONLY | os.O_DIRECTORY))


def _regular_private(path: Path) -> bytes:
    info = path.lstat()
    if (not stat.S_ISREG(info.st_mode) or path.is_symlink() or info.st_nlink != 1
            or info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o600):
        fail("transaction_artifact_metadata_invalid")
    return path.read_bytes()


def load_saved_transaction(manifest: dict, manifest_hash: str) -> tuple[dict, str, str]:
    if not ACTION_PLAN.exists() or not OWNER.exists():
        fail("transaction_artifacts_absent")
    plan_raw = _regular_private(ACTION_PLAN)
    owner_raw = _regular_private(OWNER)
    plan = json.loads(plan_raw)
    owner = json.loads(owner_raw)
    if plan_raw != canonical(plan) or owner_raw != canonical(owner):
        fail("transaction_artifact_not_canonical")
    plan_hash = hashlib.sha256(plan_raw).hexdigest()
    owner_hash = hashlib.sha256(owner_raw).hexdigest()
    expected_files = [
        {"kind": item["kind"], "from": item["path"], "to": str(tombstone(Path(item["path"]), manifest_hash))}
        for item in retirement_files(manifest)
    ]
    containers = plan.get("container_renames")
    if (set(plan) != {"version", "manifest_sha256", "container_renames", "file_renames"}
            or plan.get("version") != 1 or plan.get("manifest_sha256") != manifest_hash
            or plan.get("file_renames") != expected_files or not isinstance(containers, list)
            or len(containers) != len(manifest["compose"]["services"])):
        fail("saved_action_plan_scope_invalid")
    for service, change in zip(manifest["compose"]["services"], containers, strict=True):
        if (set(change) != {"from", "to", "container_id"} or change.get("from") != service
                or change.get("to") != f"offen-retirement-{manifest_hash[:16]}-{service}"
                or not isinstance(change.get("container_id"), str)
                or len(change["container_id"].removeprefix("sha256:")) != 64
                or set(change["container_id"].removeprefix("sha256:")) - HEX64):
            fail("saved_container_plan_invalid")
    expected_owner = {
        "operation": "offen-retirement-local",
        "manifest_sha256": manifest_hash,
        "action_plan_sha256": plan_hash,
    }
    if owner != expected_owner:
        fail("transaction_owner_differs")
    return plan, plan_hash, owner_hash


def require_apply_complete(plan_hash: str) -> list[dict]:
    events = journal_events()
    completed = [item for item in events if item.get("event") == "apply_complete"]
    if len(completed) != 1 or completed[0] != {"event": "apply_complete", "action_plan_sha256": plan_hash}:
        fail("authoritative_apply_complete_absent")
    return events


def verify_every_item_tombstoned(manifest: dict, manifest_hash: str, plan: dict) -> None:
    for item, change in zip(retirement_files(manifest), plan["file_renames"], strict=True):
        source, target = Path(change["from"]), Path(change["to"])
        if source.exists() or source.is_symlink() or not target.exists() or target.is_symlink():
            fail("staged_file_state_invalid")
        verify_file(target, item)
        if item["kind"] == "metadata":
            fields = target.read_text().strip().split()
            if fields != [item["expected_archive_sha256"], Path(item["archive_path"]).name]:
                fail("checksum_metadata_invalid")
    for change in plan["container_renames"]:
        if subprocess.run(["docker", "inspect", change["from"]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            fail("original_container_retained")
        result = subprocess.run(["docker", "inspect", "--format", "{{.Id}}", change["to"]], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        if result.returncode != 0 or result.stdout.strip() != change["container_id"]:
            fail("staged_container_state_invalid")


def mutate_apply(manifest: dict, manifest_hash: str) -> None:
    if OWNER.exists() or ACTION_PLAN.exists():
        plan, plan_hash, _owner_hash = load_saved_transaction(manifest, manifest_hash)
    else:
        plan = action_plan(manifest, manifest_hash)
        plan_hash = hashlib.sha256(canonical(plan)).hexdigest()
        create_owner(manifest_hash, plan, plan_hash)
    verify_status_under_lock(manifest); verify_mounts(manifest)
    verify_archives(manifest, manifest_hash, True); verify_containers(manifest, manifest_hash, True)
    for change in plan["container_renames"]:
        inspected = subprocess.run(["docker", "inspect", "--format", "{{.Id}}", change["from"]], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        if inspected.returncode == 0:
            if inspected.stdout.strip() != change["container_id"]:
                fail("container_id_differs")
            append({"event": "container_rename_started", **change})
            run(["docker", "rename", change["from"], change["to"]])
            append({"event": "container_renamed", **change})
    for change in plan["file_renames"]:
        source, target = Path(change["from"]), Path(change["to"])
        if source.exists():
            append({"event": "file_rename_started", **change})
            source.rename(target)
            descriptor = os.open(target.parent, os.O_RDONLY | os.O_DIRECTORY); os.fsync(descriptor); os.close(descriptor)
            append({"event": "file_renamed", **change})
    verify_archives(manifest, manifest_hash, True); verify_containers(manifest, manifest_hash, True)
    verify_every_item_tombstoned(manifest, manifest_hash, plan)
    if not any(item.get("event") == "apply_complete" for item in journal_events()):
        append({"event": "apply_complete", "action_plan_sha256": plan_hash})
    require_apply_complete(plan_hash)
    print(f"offen_retirement_local=staged action_plan_sha256={plan_hash}")


def rollback(manifest: dict, manifest_hash: str) -> None:
    if any(item.get("event") == "irreversible_unlink_started" for item in journal_events()):
        fail("rollback_forbidden")
    plan, plan_hash, _owner_hash = load_saved_transaction(manifest, manifest_hash)
    require_apply_complete(plan_hash)
    verify_every_item_tombstoned(manifest, manifest_hash, plan)
    files_by_path = {item["path"]: item for item in retirement_files(manifest)}
    for change in reversed(plan["file_renames"]):
        source, target = Path(change["from"]), Path(change["to"])
        if source.exists() or source.is_symlink() or not target.exists() or target.is_symlink():
            fail("rollback_file_state_invalid")
        verify_file(target, files_by_path[change["from"]])
        append({"event": "file_rollback_started", **change}); target.rename(source); append({"event": "file_rolled_back", **change})
    for change in reversed(plan["container_renames"]):
        if subprocess.run(["docker", "inspect", change["from"]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            fail("rollback_container_state_invalid")
        inspected = subprocess.run(["docker", "inspect", "--format", "{{.Id}}", change["to"]], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        if inspected.returncode != 0 or inspected.stdout.strip() != change["container_id"]:
            fail("rollback_container_identity_differs")
        append({"event": "container_rollback_started", **change}); run(["docker", "rename", change["to"], change["from"]]); append({"event": "container_rolled_back", **change})
    verify_archives(manifest, manifest_hash, False)
    verify_containers(manifest, manifest_hash, False)
    append({"event": "rollback_complete", "action_plan_sha256": plan_hash})
    print("offen_retirement_local=rolled-back")


def journal_events() -> list[dict]:
    if not JOURNAL.exists() or JOURNAL.is_symlink():
        return []
    raw = _regular_private(JOURNAL)
    return [json.loads(line) for line in raw.decode().splitlines() if line]


def write_final_result(manifest: dict, manifest_hash: str, evidence_hash: str, plan_hash: str, owner_hash: str) -> None:
    value = {
        "version": 1,
        "phase": "local-finalized",
        "manifest_sha256": manifest_hash,
        "finalizing_evidence_sha256": evidence_hash,
        "action_plan_sha256": plan_hash,
        "transaction_owner_sha256": owner_hash,
        "archive_files_removed": len(manifest["local"]["archives"]),
        "metadata_files_removed": len(manifest["local"]["metadata_files"]),
        "containers_removed": manifest["compose"]["services"],
        "protected_directories_removed": len(manifest["local"]["protected_directories"]),
        "image_removed": True,
    }
    FINAL_RESULT.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary = FINAL_RESULT.with_suffix(".tmp")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(descriptor, "wb", buffering=0) as target:
        target.write(canonical(value)); os.fsync(target.fileno())
    os.replace(temporary, FINAL_RESULT)
    directory = os.open(FINAL_RESULT.parent, os.O_RDONLY | os.O_DIRECTORY); os.fsync(directory); os.close(directory)


def finalize(manifest: dict, manifest_hash: str, evidence_hash: str) -> None:
    if len(evidence_hash) != 64 or set(evidence_hash) - HEX64:
        fail("finalize_authorization_invalid")
    if not STAGED_EVIDENCE.is_file() or STAGED_EVIDENCE.is_symlink() or sha256(STAGED_EVIDENCE) != evidence_hash:
        fail("retirement_evidence_invalid")
    staged = json.loads(STAGED_EVIDENCE.read_text())
    plan, plan_hash, owner_hash = load_saved_transaction(manifest, manifest_hash)
    events = require_apply_complete(plan_hash)
    if (staged.get("version") != 1 or staged.get("phase") != "retirement-finalizing"
            or staged.get("manifest_sha256") != manifest_hash
            or staged.get("aws_object_absent") is not True
            or staged.get("bundle_b_preserved") is not True
            or staged.get("delete_authorization_removed") is not True
            or staged.get("lifecycle_converged") is not True
            or staged.get("local_action_plan_sha256") != plan_hash
            or staged.get("local_transaction_owner_sha256") != owner_hash):
        fail("retirement_evidence_semantics_invalid")
    irreversible_events = [item for item in events if item.get("event") == "irreversible_unlink_started"]
    if len(irreversible_events) > 1 or (irreversible_events and irreversible_events[0].get("evidence_sha256") != evidence_hash):
        fail("irreversible_authorization_differs")
    irreversible = bool(irreversible_events)
    verify_status_under_lock(manifest); verify_mounts(manifest)
    verify_archives(manifest, manifest_hash, True, irreversible)
    verify_containers(manifest, manifest_hash, True, irreversible)
    if not irreversible:
        verify_every_item_tombstoned(manifest, manifest_hash, plan)
        append({"event": "irreversible_unlink_started", "evidence_sha256": evidence_hash})
    files_by_path = {item["path"]: item for item in retirement_files(manifest)}
    for change in plan["file_renames"]:
        item = files_by_path[change["from"]]
        source, target = Path(change["from"]), Path(change["to"])
        if source.exists() or source.is_symlink():
            fail("original_file_reappeared")
        if target.exists() or target.is_symlink():
            verify_file(target, item)
            append({"event": "file_unlink_started", "kind": item["kind"], "path": item["path"]})
            target.unlink()
            append({"event": "file_unlinked", "kind": item["kind"], "path": item["path"]})
        else:
            current_events = journal_events()
            if any(event.get("event") == "file_unlinked" and event.get("path") == item["path"] for event in current_events):
                pass
            elif any(event.get("event") == "file_unlink_started" and event.get("path") == item["path"] for event in current_events):
                append({"event": "file_unlinked", "kind": item["kind"], "path": item["path"], "adopted_after_response_loss": True})
            else:
                fail("unattested_file_absence")
    for change in plan["container_renames"]:
        if subprocess.run(["docker", "inspect", change["from"]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            fail("original_container_reappeared")
        result = subprocess.run(["docker", "inspect", "--format", "{{.Id}}", change["to"]], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        if result.returncode == 0:
            if result.stdout.strip() != change["container_id"]:
                fail("container_id_differs")
            append({"event": "container_remove_started", "service": change["from"], "container_id": result.stdout.strip()})
            run(["docker", "rm", change["to"]])
            append({"event": "container_removed", "service": change["from"], "container_id": change["container_id"]})
        else:
            current_events = journal_events()
            if any(event.get("event") == "container_removed" and event.get("service") == change["from"] and event.get("container_id") == change["container_id"] for event in current_events):
                pass
            elif any(event.get("event") == "container_remove_started" and event.get("service") == change["from"] and event.get("container_id") == change["container_id"] for event in current_events):
                append({"event": "container_removed", "service": change["from"], "container_id": change["container_id"], "adopted_after_response_loss": True})
            else:
                fail("unattested_container_absence")
    for expected in manifest["local"]["protected_directories"]:
        directory = Path(expected["path"])
        if directory.exists():
            append({"event": "protected_directory_remove_started", "path": str(directory)})
            directory.rmdir()
            append({"event": "protected_directory_removed", "path": str(directory)})
        else:
            current_events = journal_events()
            if any(event.get("event") == "protected_directory_removed" and event.get("path") == str(directory) for event in current_events):
                pass
            elif any(event.get("event") == "protected_directory_remove_started" and event.get("path") == str(directory) for event in current_events):
                append({"event": "protected_directory_removed", "path": str(directory), "adopted_after_response_loss": True})
            else:
                fail("unattested_protected_directory_absence")
    image = manifest["compose"]["image"]
    image_result = subprocess.run(["docker", "image", "inspect", image], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    if image_result.returncode == 0:
        image_id = json.loads(image_result.stdout)[0]["Id"]
        if run(["docker", "ps", "--all", "--quiet", "--filter", f"ancestor={image_id}"]):
            fail("offen_image_still_referenced")
        append({"event": "image_remove_started", "image_sha256": image_id.removeprefix("sha256:")})
        run(["docker", "image", "rm", image_id])
        append({"event": "image_removed", "image_sha256": image_id.removeprefix("sha256:")})
    else:
        current_events = journal_events()
        if not any(event.get("event") == "image_removed" for event in current_events):
            started = [event for event in current_events if event.get("event") == "image_remove_started"]
            if len(started) != 1:
                fail("unattested_image_absence")
            append({"event": "image_removed", "image_sha256": started[0]["image_sha256"], "adopted_after_response_loss": True})
    verify_archives(manifest, manifest_hash, True, True)
    verify_containers(manifest, manifest_hash, True, True)
    for change in plan["file_renames"]:
        if any(Path(path).exists() or Path(path).is_symlink() for path in (change["from"], change["to"])):
            fail("terminal_file_retained")
    for change in plan["container_renames"]:
        if any(subprocess.run(["docker", "inspect", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0 for name in (change["from"], change["to"])):
            fail("terminal_container_retained")
    for expected in manifest["local"]["protected_directories"]:
        if Path(expected["path"]).exists():
            fail("protected_directory_retained")
    if subprocess.run(["docker", "image", "inspect", image], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        fail("offen_image_retained")
    terminal_events = journal_events()
    removed_files = {item.get("path") for item in terminal_events if item.get("event") == "file_unlinked"}
    removed_containers = {item.get("service") for item in terminal_events if item.get("event") == "container_removed"}
    removed_directories = {item.get("path") for item in terminal_events if item.get("event") == "protected_directory_removed"}
    if (removed_files != {item["path"] for item in retirement_files(manifest)}
            or removed_containers != set(manifest["compose"]["services"])
            or removed_directories != {item["path"] for item in manifest["local"]["protected_directories"]}):
        fail("terminal_removal_counts_differ")
    write_final_result(manifest, manifest_hash, evidence_hash, plan_hash, owner_hash)
    if not any(item.get("event") == "finalize_complete" for item in journal_events()):
        append({"event": "finalize_complete", "evidence_sha256": evidence_hash, "final_result_sha256": sha256(FINAL_RESULT)})
    if len([item for item in journal_events() if item.get("event") == "finalize_complete"]) != 1:
        fail("terminal_finalize_event_invalid")
    print(f"offen_retirement_local=finalized final_result_sha256={sha256(FINAL_RESULT)}")


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=("plan", "apply", "resume", "rollback", "finalize"))
    parser.add_argument("--manifest-sha256", required=True)
    parser.add_argument("--evidence-sha256", default="")
    args = parser.parse_args()
    if os.geteuid() != 0:
        fail("root_required")
    manifest, manifest_hash = load_manifest(args.manifest_sha256)
    # The runner's status command takes this same mutex non-blockingly, so prove
    # status immediately before acquisition and re-check its files after locking.
    verify_status()
    MUTEX.parent.mkdir(parents=True, exist_ok=True)
    with MUTEX.open("a+") as mutex:
        fcntl.flock(mutex, fcntl.LOCK_EX)
        verify_status_under_lock(manifest)
        if args.action == "plan":
            verify_mounts(manifest); verify_archives(manifest, manifest_hash, False); verify_containers(manifest, manifest_hash, False)
            plan_hash = hashlib.sha256(canonical(action_plan(manifest, manifest_hash))).hexdigest()
            print(f"offen_retirement_local=planned action_plan_sha256={plan_hash}")
        elif args.action in ("apply", "resume"):
            mutate_apply(manifest, manifest_hash)
        elif args.action == "rollback":
            rollback(manifest, manifest_hash)
        else:
            finalize(manifest, manifest_hash, args.evidence_sha256)


if __name__ == "__main__":
    try:
        main()
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError, KeyError, ValueError):
        fail("controlled_failure")
