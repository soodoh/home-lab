#!/usr/bin/env python3
"""Build two distinct encrypted current Restic recovery bundles."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
from typing import Any

RECIPIENT = "age1ddk0qtwjclc2za5afrz5pl4j5kley02rqv2vh0s07c27a8t5u58sph58qm"
CONFIRMATION = "build-two-current-encrypted-restic-recovery-bundles"
HEX = re.compile(r"^[0-9a-f]{64}$")
SECRET_INPUTS = {
    "RECOVERY_BUNDLE_RESTIC_PASSWORD": "RESTIC_PROTON_PASSWORD",
    "RECOVERY_BUNDLE_PROTON_USERNAME": "PROTON_BACKUP_USERNAME",
    "RECOVERY_BUNDLE_PROTON_LOGIN_PASSWORD": "PROTON_BACKUP_PASSWORD",
    "RECOVERY_BUNDLE_PROTON_TOTP_SECRET": "PROTON_BACKUP_TOTP_SECRET",
}
METADATA_KEYS = {
    "artifact_sha256", "first_run_evidence_sha256", "original_snapshot_id",
    "policy_sha256", "qualification_evidence_sha256", "rclone_sha256",
    "repository", "repository_id", "restic_sha256", "restore_runner_sha256",
    "snapshot_id", "version",
}


class BuildFailure(Exception):
    def __init__(self, reason: str, stderr: bytes = b"") -> None:
        super().__init__(reason)
        self.reason = reason
        self.stderr = stderr


def fail(reason: str, stderr: bytes = b"") -> None:
    raise BuildFailure(reason, stderr)


def digest(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def duplicate_free_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    value: dict[str, Any] = {}
    for key, item in pairs:
        if key in value:
            fail("json")
        value[key] = item
    return value


def protected(path: Path, *, directory: bool = False, executable: bool = False) -> os.stat_result:
    try:
        metadata = path.lstat()
    except OSError:
        fail("protected_path")
    expected = stat.S_ISDIR if directory else stat.S_ISREG
    if (
        path.is_symlink()
        or not expected(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or (not directory and metadata.st_nlink != 1)
        or stat.S_IMODE(metadata.st_mode) & 0o022
        or (executable and not metadata.st_mode & stat.S_IXUSR)
    ):
        fail("protected_path")
    return metadata


def load_metadata(path: Path) -> bytes:
    metadata = protected(path)
    if stat.S_IMODE(metadata.st_mode) not in {0o400, 0o600}:
        fail("metadata_mode")
    try:
        raw = path.read_bytes()
        value = json.loads(raw, object_pairs_hook=duplicate_free_object)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        fail("metadata_json")
    if not isinstance(value, dict) or set(value) != METADATA_KEYS or value.get("version") != 1:
        fail("metadata_shape")
    if value.get("repository") != "rclone:proton_backup:Backups/home-lab-restic":
        fail("metadata_repository")
    for key in METADATA_KEYS - {"repository", "version"}:
        if not isinstance(value.get(key), str) or HEX.fullmatch(value[key]) is None:
            fail("metadata_identity")
    return raw


def binary(name: str, fallback: str) -> Path:
    value = os.environ.get(name) or shutil.which(fallback)
    if not value:
        fail("operator_binary")
    path = Path(value)
    metadata = protected(path, executable=True)
    if stat.S_IMODE(metadata.st_mode) != 0o755:
        fail("operator_binary")
    return path


def write_json(path: Path, value: dict[str, Any]) -> None:
    content = (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
    try:
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
    except OSError:
        fail("result_write")


def main() -> None:
    os.umask(0o077)
    parser = argparse.ArgumentParser()
    parser.add_argument("--metadata", required=True)
    parser.add_argument("--output-root", required=True)
    arguments = parser.parse_args()
    if os.environ.get("RECOVERY_BUNDLE_BUILD_CONFIRMED") != CONFIRMATION:
        fail("confirmation_required")
    unexpected = {
        key for key in os.environ
        if key.startswith("RECOVERY_BUNDLE_") and key != "RECOVERY_BUNDLE_BUILD_CONFIRMED"
    }
    if unexpected:
        fail("ambient_bundle_environment")
    if any(not os.environ.get(source) for source in SECRET_INPUTS.values()):
        fail("credential_shape")

    metadata_path = Path(arguments.metadata)
    metadata_raw = load_metadata(metadata_path)
    source_root = Path(__file__).resolve().parent
    generic = source_root / "build-restic-recovery-bundle"
    runner = source_root / "restore-critical-backup"
    scope_resolver = source_root / "recovery-scope.py"
    scope_config = source_root.parent / "recovery/groups.json"
    if not scope_config.exists():
        scope_config = source_root / "recovery-groups.json"
    protected(generic, executable=True)
    protected(runner, executable=True)
    protected(scope_resolver, executable=True)
    protected(scope_config)
    restic = binary("HOME_LAB_RESTIC_BINARY", "restic")
    rclone = binary("HOME_LAB_RCLONE_BINARY", "rclone")
    age = binary("HOME_LAB_AGE_BINARY", "age")
    age_sha256 = digest(age.read_bytes())

    output = Path(arguments.output_root)
    parent_metadata = protected(output.parent, directory=True)
    if stat.S_IMODE(parent_metadata.st_mode) != 0o700 or output.exists() or output.is_symlink():
        fail("output_root")
    try:
        output.mkdir(mode=0o700)
    except OSError:
        fail("output_root")

    runtime = output / ".runtime"
    runtime.mkdir(mode=0o700)
    child_environment = {
        "HOME": str(runtime),
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        **{target: os.environ[source] for target, source in SECRET_INPUTS.items()},
    }
    common = [
        str(generic), "--metadata", str(metadata_path), "--restic", str(restic),
        "--rclone", str(rclone), "--restore-runner", str(runner),
        "--scope-resolver", str(scope_resolver), "--scope-config", str(scope_config),
        "--age", str(age),
        "--age-sha256", age_sha256, "--recipient", RECIPIENT,
    ]
    results = []
    try:
        for label in ("a", "b"):
            bundle = output / f"bundle-{label}.age"
            try:
                completed = subprocess.run(
                    [*common, "--output", str(bundle)], stdin=subprocess.DEVNULL,
                    stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=child_environment,
                    timeout=600, check=False,
                )
            except (OSError, subprocess.TimeoutExpired):
                fail("builder_execution")
            if completed.returncode != 0:
                fail("builder_failed", completed.stderr)
            if len(completed.stdout) > 16 * 1024:
                fail("builder_output")
            try:
                result = json.loads(completed.stdout, object_pairs_hook=duplicate_free_object)
            except (UnicodeDecodeError, json.JSONDecodeError):
                fail("builder_output")
            required = {"ciphertext_sha256", "plaintext_sha256", "recipient_sha256", "state", "version"}
            if (
                not isinstance(result, dict)
                or set(result) != required
                or result.get("state") != "encrypted"
                or result.get("version") != 1
                or any(not isinstance(result.get(key), str) or HEX.fullmatch(result[key]) is None for key in (
                    "ciphertext_sha256", "plaintext_sha256", "recipient_sha256",
                ))
                or result["recipient_sha256"] != digest(RECIPIENT.encode())
            ):
                fail("builder_output")
            bundle_metadata = protected(bundle)
            if (
                stat.S_IMODE(bundle_metadata.st_mode) != 0o600
                or bundle_metadata.st_size <= 0
                or digest(bundle.read_bytes()) != result["ciphertext_sha256"]
            ):
                fail("bundle_identity")
            write_json(output / f"bundle-{label}-result.json", result)
            results.append(result)
        if results[0]["plaintext_sha256"] != results[1]["plaintext_sha256"]:
            fail("plaintext_identity")
        if results[0]["ciphertext_sha256"] == results[1]["ciphertext_sha256"]:
            fail("ciphertext_independence")
        shutil.rmtree(runtime)
        if runtime.exists() or runtime.is_symlink():
            fail("runtime_cleanup")
        summary = {
            "bundle_a_ciphertext_sha256": results[0]["ciphertext_sha256"],
            "bundle_b_ciphertext_sha256": results[1]["ciphertext_sha256"],
            "metadata_sha256": digest(metadata_raw),
            "plaintext_sha256": results[0]["plaintext_sha256"],
            "recipient_sha256": results[0]["recipient_sha256"],
            "state": "built-encrypted-distinct",
            "version": 1,
        }
    except Exception:
        shutil.rmtree(output, ignore_errors=True)
        raise
    print(json.dumps(summary, sort_keys=True, separators=(",", ":")))


if __name__ == "__main__":
    try:
        main()
    except BuildFailure as error:
        suffix = f" stderr_sha256={digest(error.stderr)}" if error.stderr else ""
        print(f"current_restic_recovery_bundles=failed reason={error.reason}{suffix}", file=sys.stderr)
        raise SystemExit(1)
