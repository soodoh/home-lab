#!/usr/bin/env node
"use strict";

const fs = require("node:fs");
const crypto = require("node:crypto");
const path = require("node:path");
const { spawnSync } = require("node:child_process");
const { load } = require("js-yaml");
const Ajv2020 = require("ajv/dist/2020");
const { validateVmArtifactReferences } = require("./controller/validate-vm-artifact-references");

const root = path.resolve(__dirname, "..");
const contractPath = path.join(root, "infrastructure/contract/home-lab.yml");
const schemaPath = path.join(root, "infrastructure/contract/schema.json");
const qualificationEvidencePath = path.join(root, "infrastructure/evidence/proxmox-lxc-qualification.json");
const qualificationEvidenceSchemaPath = path.join(root, "infrastructure/evidence/proxmox-lxc-qualification.schema.json");
const qualificationValidatorPath = path.join(root, "scripts/controller/validate-lxc-qualification-evidence.py");
const operational = process.argv.includes("--operational");

const contract = load(fs.readFileSync(contractPath, "utf8"));
const schema = JSON.parse(fs.readFileSync(schemaPath, "utf8"));
const qualificationEvidenceSchema = JSON.parse(fs.readFileSync(qualificationEvidenceSchemaPath, "utf8"));
const ajv = new Ajv2020({ allErrors: true, strict: true });
const validate = ajv.compile(schema);
const validateQualificationEvidence = ajv.compile(qualificationEvidenceSchema);

if (!validate(contract)) {
  for (const error of validate.errors || []) {
    console.error(`${error.instancePath || "/"}: ${error.message}`);
  }
  process.exit(1);
}

const failures = [];
const proxmoxTofuRoot = path.join(root, "infrastructure/tofu/proxmox");
const proxmoxSource = fs.readdirSync(proxmoxTofuRoot)
  .filter((name) => name.endsWith(".tf"))
  .sort()
  .map((name) => fs.readFileSync(path.join(proxmoxTofuRoot, name), "utf8"))
  .join("\n");
failures.push(...validateVmArtifactReferences(contract, proxmoxSource));
const coralRoot = path.join(root, "recovery/coral");
const coralFiles = fs.readdirSync(coralRoot, { recursive: true })
  .filter((name) => fs.statSync(path.join(coralRoot, name)).isFile())
  .sort();
const coralHash = crypto.createHash("sha256");
for (const name of coralFiles) {
  coralHash.update(name);
  coralHash.update("\0");
  coralHash.update(fs.readFileSync(path.join(coralRoot, name)));
}
if (coralHash.digest("hex") !== contract.arch.coral.source_tree_sha256) {
  failures.push("arch.coral.source_tree_sha256 does not match recovery/coral");
}
const coralPkgbuild = fs.readFileSync(path.join(coralRoot, "PKGBUILD"), "utf8");
if (!coralPkgbuild.includes(`pkgver=${contract.arch.coral.dkms_version}`)) failures.push("Coral PKGBUILD pkgver differs from contract");
if (!coralPkgbuild.includes(`_commit=${contract.arch.coral.source_commit}`)) failures.push("Coral PKGBUILD source commit differs from contract");
const refs = contract.storage.zfs.members.map((member) => member.secret_ref);
if (new Set(refs).size !== refs.length) failures.push("ZFS member secret references must be unique");
for (let mirror = 0; mirror < 6; mirror += 1) {
  if (contract.storage.zfs.members.filter((member) => member.mirror === mirror).length !== 2) {
    failures.push(`ZFS mirror ${mirror} must contain exactly two members`);
  }
}
const expectedVfioIds = [
  contract.proxmox.vm.pci.coral.vendor_device,
  contract.proxmox.vm.pci.gpu.vendor_device,
  contract.proxmox.vm.pci.gpu_audio.vendor_device,
];
if (JSON.stringify(contract.proxmox.vfio.device_ids) !== JSON.stringify(expectedVfioIds)) {
  failures.push("canonical VFIO IDs must match Coral and discrete GPU contract devices");
}
for (const key of ["coral", "gpu", "gpu_audio"]) {
  if (contract.proxmox.vm.pci[key].required_driver !== "vfio-pci") {
    failures.push(`proxmox.vm.pci.${key}.required_driver must be vfio-pci`);
  }
}
const usbSerialRefs = ["zigbee", "zwave"].map((key) => contract.proxmox.vm.usb[key].serial_secret_ref);
if (new Set(usbSerialRefs).size !== usbSerialRefs.length) failures.push("USB serial secret references must be unique");
const repositoryNames = contract.proxmox.apt.repositories.map((repository) => repository.name);
const repositoryFiles = contract.proxmox.apt.repositories.map((repository) => repository.file);
if (new Set(repositoryNames).size !== repositoryNames.length) failures.push("APT repository names must be unique");
if (new Set(repositoryFiles).size !== repositoryFiles.length) failures.push("APT repository files must be unique");
for (const repository of contract.proxmox.apt.repositories) {
  if (!contract.proxmox.apt.permitted_keyrings.includes(repository.signed_by)) {
    failures.push(`APT repository ${repository.name} uses an unapproved signing key`);
  }
}
const requiredPackages = new Set(contract.proxmox.packages.required);
const prohibitedPackages = new Set(contract.proxmox.packages.prohibited);
const permittedManualPackages = new Set(contract.proxmox.packages.permitted_manual);
for (const packageName of requiredPackages) {
  if (prohibitedPackages.has(packageName)) failures.push(`required package ${packageName} is also prohibited`);
}
for (const packageName of permittedManualPackages) {
  if (prohibitedPackages.has(packageName)) failures.push(`permitted manual package ${packageName} is also prohibited`);
}
const distinctFallback = contract.proxmox.kernels.current !== contract.proxmox.kernels.fallback;
const expectedRetentionCount = distinctFallback ? 2 : 1;
if (contract.proxmox.kernels.retention_count !== expectedRetentionCount) {
  failures.push(`kernel retention count must be ${expectedRetentionCount} for the selected current/fallback policy`);
}
if (contract.proxmox.kernels.require_boot_history_proof !== distinctFallback) {
  failures.push("boot-history proof must be enabled exactly when a distinct fallback kernel is retained");
}
const archHostAddress = contract.network.arch.ipv4.split("/")[0];
if (contract.storage.nfs.client !== `${archHostAddress}/32`) failures.push("NFS client must be the Arch VM /32 address");
if (contract.storage.nfs.client_vmid !== contract.proxmox.vm.vmid) failures.push("NFS client VMID must identify VM 100");
const pveStorage = contract.storage.zfs.pve_storage;
if (pveStorage.pool !== contract.storage.zfs.pool || pveStorage.nodes[0] !== contract.proxmox.node) {
  failures.push("PVE storage registration must reference the protected ZFS pool and Proxmox node");
}
const preservedRootPaths = new Set(contract.proxmox.root_cleanup.preserve_paths);
for (const removablePath of contract.proxmox.root_cleanup.remove_paths) {
  if (preservedRootPaths.has(removablePath)) failures.push(`root cleanup path ${removablePath} is also preserved`);
}
if (contract.network.proxmox.ipv4 === contract.network.arch.ipv4) failures.push("host addresses must differ");
if (contract.network.proxmox.mac === contract.network.arch.mac) failures.push("host MAC addresses must differ");

if (!fs.existsSync(qualificationEvidencePath)) {
  failures.push("retired CT 101 requires infrastructure/evidence/proxmox-lxc-qualification.json");
} else {
  const evidence = JSON.parse(fs.readFileSync(qualificationEvidencePath, "utf8"));
  if (!validateQualificationEvidence(evidence)) failures.push("LXC qualification evidence does not match its schema");
  const result = spawnSync(
    "python3",
    [qualificationValidatorPath, "--evidence-json", qualificationEvidencePath],
    { cwd: root, encoding: "utf8" },
  );
  if (result.status !== 0) failures.push("LXC qualification evidence validator rejected the tracked evidence");
}

if (operational) {
  const required = [
    [contract.aws.state_bucket, "aws.state_bucket"],
    [contract.aws.recovery_bucket, "aws.recovery_bucket"],
    [contract.arch.coral.build_image, "arch.coral.build_image"],
    [contract.arch.coral.package_sha256, "arch.coral.package_sha256"],
  ];
  for (const [value, name] of required) if (!value) failures.push(`${name} is required for operational recovery`);
}

if (failures.length) {
  for (const failure of failures) console.error(`contract: ${failure}`);
  process.exit(1);
}
console.log(`contract valid${operational ? " and operationally complete" : ""}`);
