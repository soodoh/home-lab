#!/usr/bin/env node
"use strict";

const fs = require("node:fs");
const path = require("node:path");
const { spawnSync } = require("node:child_process");
const { load } = require("js-yaml");
const Ajv2020 = require("ajv/dist/2020");
const { validateVmArtifactReferences } = require("./controller/validate-vm-artifact-references");
const { validateProxmoxHostPolicy } = require("./controller/validate-proxmox-host-policy");
const { validateResticPolicy } = require("./controller/validate-restic-policy");
const {
  validateProxmoxPackageArtifactBinding,
  validateProxmoxPackagePolicy,
} = require("./controller/validate-proxmox-package-policy");

const root = path.resolve(__dirname, "..");
const contractPath = path.join(root, "infrastructure/contract/home-lab.yml");
const schemaPath = path.join(root, "infrastructure/contract/schema.json");
const packageManifestPath = path.join(root, "nix/proxmox/package-manifest.json");
const packageManifestSchemaPath = path.join(root, "nix/proxmox/package-manifest.schema.json");
const qualificationEvidencePath = path.join(root, "infrastructure/evidence/proxmox-lxc-qualification.json");
const qualificationEvidenceSchemaPath = path.join(root, "infrastructure/evidence/proxmox-lxc-qualification.schema.json");
const qualificationValidatorPath = path.join(root, "scripts/controller/validate-lxc-qualification-evidence.py");
const operational = process.argv.includes("--operational");

const contract = load(fs.readFileSync(contractPath, "utf8"));
const schema = JSON.parse(fs.readFileSync(schemaPath, "utf8"));
const packageManifestRaw = fs.readFileSync(packageManifestPath, "utf8");
const packageManifest = JSON.parse(packageManifestRaw);
const packageManifestSchema = JSON.parse(fs.readFileSync(packageManifestSchemaPath, "utf8"));
const qualificationEvidenceSchema = JSON.parse(fs.readFileSync(qualificationEvidenceSchemaPath, "utf8"));
const ajv = new Ajv2020({ allErrors: true, strict: true });
const validate = ajv.compile(schema);
const validatePackageManifest = ajv.compile(packageManifestSchema);
const validateQualificationEvidence = ajv.compile(qualificationEvidenceSchema);

if (!validate(contract)) {
  for (const error of validate.errors || []) {
    console.error(`${error.instancePath || "/"}: ${error.message}`);
  }
  process.exit(1);
}

const failures = [];
const proxmoxTofuRoot = path.join(root, "infrastructure/tofu/proxmox");
const proxmoxSource = fs.readdirSync(proxmoxTofuRoot)
  .filter((name) => name.endsWith(".tf"))
  .sort()
  .map((name) => fs.readFileSync(path.join(proxmoxTofuRoot, name), "utf8"))
  .join("\n");
failures.push(...validateVmArtifactReferences(contract, proxmoxSource));
const refs = contract.storage.zfs.members.map((member) => member.secret_ref);
if (new Set(refs).size !== refs.length) failures.push("ZFS member secret references must be unique");
for (let mirror = 0; mirror < contract.storage.zfs.mirror_topology.count; mirror += 1) {
  if (contract.storage.zfs.members.filter((member) => member.mirror === mirror).length !== contract.storage.zfs.mirror_topology.width) {
    failures.push(`ZFS mirror ${mirror} must contain exactly ${contract.storage.zfs.mirror_topology.width} members`);
  }
}
const expectedVfioIds = [
  contract.proxmox.vm.pci.gpu.vendor_device,
  contract.proxmox.vm.pci.gpu_audio.vendor_device,
];
if (JSON.stringify(contract.proxmox.vfio.device_ids) !== JSON.stringify(expectedVfioIds)) {
  failures.push("canonical VFIO IDs must match discrete GPU contract devices");
}
for (const key of ["gpu", "gpu_audio"]) {
  if (contract.proxmox.vm.pci[key].required_driver !== "vfio-pci") {
    failures.push(`proxmox.vm.pci.${key}.required_driver must be vfio-pci`);
  }
}
const usbSerialRefs = ["zigbee", "zwave"].map((key) => contract.proxmox.vm.usb[key].serial_secret_ref);
if (new Set(usbSerialRefs).size !== usbSerialRefs.length) failures.push("USB serial secret references must be unique");
failures.push(...validateProxmoxHostPolicy(contract));
if (!validatePackageManifest(packageManifest)) {
  failures.push(`Proxmox package manifest schema failed: ${JSON.stringify(validatePackageManifest.errors)}`);
} else {
  failures.push(...validateProxmoxPackagePolicy(contract, packageManifest));
  failures.push(...validateProxmoxPackageArtifactBinding(
    contract,
    packageManifest,
    packageManifestRaw,
    path.relative(root, packageManifestPath),
  ));
}
const distinctFallback = contract.proxmox.kernels.current !== contract.proxmox.kernels.fallback;
const expectedRetentionCount = distinctFallback ? 2 : 1;
if (contract.proxmox.kernels.retention_count !== expectedRetentionCount) {
  failures.push(`kernel retention count must be ${expectedRetentionCount} for the selected current/fallback policy`);
}
if (contract.proxmox.kernels.require_boot_history_proof !== distinctFallback) {
  failures.push("boot-history proof must be enabled exactly when a distinct fallback kernel is retained");
}
const dockerHostAddress = contract.network.docker_host.ipv4.split("/")[0];
if (contract.storage.nfs.client !== `${dockerHostAddress}/32`) failures.push("NFS client must be the Arch VM /32 address");
if (contract.storage.nfs.client_vmid !== contract.proxmox.vm.vmid) failures.push("NFS client VMID must identify VM 100");
const pveStorage = contract.storage.zfs.pve_storage;
if (pveStorage.pool !== contract.storage.zfs.pool || pveStorage.nodes[0] !== contract.proxmox.node) {
  failures.push("PVE storage registration must reference the protected ZFS pool and Proxmox node");
}
const preservedRootPaths = new Set(contract.proxmox.root_cleanup.preserve_paths);
for (const removablePath of contract.proxmox.root_cleanup.remove_paths) {
  if (preservedRootPaths.has(removablePath)) failures.push(`root cleanup path ${removablePath} is also preserved`);
}
if (contract.network.proxmox.ipv4 === contract.network.docker_host.ipv4) failures.push("host addresses must differ");
if (contract.network.proxmox.mac === contract.network.docker_host.mac) failures.push("host MAC addresses must differ");
const nextcloudPaths = Object.values(contract.nextcloud.paths);
const nextcloudTargets = nextcloudPaths.map((entry) => entry.target);
if (new Set(nextcloudTargets).size !== nextcloudTargets.length) failures.push("Nextcloud mount targets must be unique");
const nextcloudData = contract.nextcloud.paths.data;
if (nextcloudData.resolved_source === contract.nextcloud.managed_state_root
    || nextcloudData.resolved_source.startsWith(`${contract.nextcloud.managed_state_root}/`)) {
  failures.push("external Nextcloud data cannot be under the managed-state root");
}
const nextcloudSecretDestinations = Object.values(contract.nextcloud.secrets).map((entry) => entry.destination);
const nextcloudSecretNames = Object.values(contract.nextcloud.secrets).map((entry) => entry.compose_name);
if (new Set(nextcloudSecretDestinations).size !== nextcloudSecretDestinations.length) {
  failures.push("Nextcloud secret destinations must be unique");
}
if (new Set(nextcloudSecretNames).size !== nextcloudSecretNames.length) {
  failures.push("Nextcloud Compose secret names must be unique");
}
const resticPolicy = contract.backups.restic;
const stoppedApplications = resticPolicy.stop_groups.applications;
if (contract.nextcloud.writer_stop_order[0] !== contract.nextcloud.cron_service
    || contract.nextcloud.writer_stop_order[1] !== contract.nextcloud.web_service
    || !stoppedApplications.includes(contract.nextcloud.cron_service)) {
  failures.push("Nextcloud writer stop order and Restic stop set must include cron before web");
}
failures.push(...validateResticPolicy(resticPolicy));
const sourcePaths = resticPolicy.sources.map((entry) => entry.path);
const renderedFilesFrom = `${sourcePaths.join("\n")}\n`;
const renderedExcludes = `${resticPolicy.excludes.join("\n")}\n`;
const filesFromPath = path.join(root, "services/data/restic/files-from");
const excludesPath = path.join(root, "services/data/restic/excludes");
if (!fs.existsSync(filesFromPath) || fs.readFileSync(filesFromPath, "utf8") !== renderedFilesFrom) {
  failures.push("generated Restic files-from differs from the contract");
}
if (!fs.existsSync(excludesPath) || fs.readFileSync(excludesPath, "utf8") !== renderedExcludes) {
  failures.push("generated Restic excludes differs from the contract");
}

if (!fs.existsSync(qualificationEvidencePath)) {
  failures.push("retired CT 101 requires infrastructure/evidence/proxmox-lxc-qualification.json");
} else {
  const evidence = JSON.parse(fs.readFileSync(qualificationEvidencePath, "utf8"));
  if (!validateQualificationEvidence(evidence)) failures.push("LXC qualification evidence does not match its schema");
  const result = spawnSync(
    "python3",
    [qualificationValidatorPath, "--evidence-json", qualificationEvidencePath],
    { cwd: root, encoding: "utf8" },
  );
  if (result.status !== 0) failures.push("LXC qualification evidence validator rejected the tracked evidence");
}

if (operational) {
  const required = [
    [contract.aws.state_bucket, "aws.state_bucket"],
    [contract.aws.recovery_bucket, "aws.recovery_bucket"],
  ];
  for (const [value, name] of required) if (!value) failures.push(`${name} is required for operational recovery`);
}

if (failures.length) {
  for (const failure of failures) console.error(`contract: ${failure}`);
  process.exit(1);
}
console.log(`contract valid${operational ? " and operationally complete" : ""}`);
