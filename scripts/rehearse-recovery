#!/usr/bin/env bash
set -euo pipefail

mode=${1:---static}
[[ $mode == --static ]] || {
  echo "Only the non-mutating static rehearsal is implemented here; live recovery requires an isolated qualified environment." >&2
  exit 64
}

for command in ansible-playbook python3; do
  command -v "$command" >/dev/null || { echo "missing command: $command" >&2; exit 69; }
done

scripts/validate-contract
scripts/validate-provider-locks
scripts/test-restic-recovery-bundle
scripts/test-restic-recovery-vm
(
  cd ansible
  ansible-playbook --syntax-check -i inventory/arch-recovery.yml playbooks/recover-compose.yml
)


echo "recovery_rehearsal=static-only status=passed live_restore=not_qualified"
