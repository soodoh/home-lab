#!/bin/bash
set -euo pipefail

readonly CONFIRMATION=cutover-reviewed-vm-100-debian-production

[[ $# -eq 0 ]] || { echo "usage: scripts/run-debian-production-cutover" >&2; exit 1; }
[[ -t 0 ]] || { echo "Debian production cutover requires an interactive physical console" >&2; exit 1; }
printf 'Type the exact confirmation to run the reviewed Debian production cutover:\n%s\n' "$CONFIRMATION" >&2
IFS= read -r confirmation
[[ $confirmation == "$CONFIRMATION" ]] || { echo "exact Debian production-cutover confirmation is required" >&2; exit 1; }
export HOME_LAB_DEBIAN_QUALIFICATION_CONFIRMED=$CONFIRMATION
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
exec "$root/scripts/qualify-debian-inert"
