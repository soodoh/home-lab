  [[ $(config_value "$before_current" cicustom) == "$CURRENT_CICUSTOM" ]] || { fail "current package-preparation cloud-init baseline differs"; exit 1; }
  [[ ! -e $PREPARE_PENDING_LOG && ! -L $PREPARE_PENDING_LOG ]] || { fail "pending package evidence requires finalization or reconciliation"; exit 1; }
  [[ ! -e $PREPARE_LOG && ! -L $PREPARE_LOG ]] || { fail "Debian package preparation is already finalized"; exit 1; }
fi

