      del(.state) + {archConfigSha256:$archConfigSha256,archRestore:"verified",finalizedAt:$finalizedAt,hostBootIdAfter:$hostBootIdAfter,recoveryContinuation:$recoveryContinuation,stateStorage:$stateStorage,transitionCommit:$transitionCommit,transitionState:"complete"}
    ' <<< "$pending_evidence" > "$finalize_evidence"
