  [[ -f $CREDENTIALS_PENDING_LOG && ! -L $CREDENTIALS_PENDING_LOG ]] || { fail "pending credential staging evidence is absent or unsafe"; exit 1; }
  [[ $(stat -c %U:%G:%a "$CREDENTIALS_PENDING_LOG") == root:root:600 ]] || { fail "pending credential staging evidence metadata differs"; exit 1; }
  [[ ! -e $CREDENTIALS_LOG && ! -L $CREDENTIALS_LOG ]] || { fail "final credential staging evidence already exists or is unsafe"; exit 1; }
  pending_evidence=$(cat "$CREDENTIALS_PENDING_LOG")
  jq -e --arg archBoot "$ARCH_BOOT" --arg candidateScsi3 "$DEBIAN_SCSI3" --arg sourceCommit "$(git rev-parse HEAD)" '
    .evidenceFormat == "home-lab-debian-credentials-transition-v1" and
    .format == "home-lab-debian-credentials-compose-staged-v1" and
    .transitionState == "awaiting-host-reboot" and .vmid == 100 and
