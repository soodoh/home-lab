    .composeValidation == "quiet-pass" and .dockerServices == "docker-disabled-containerd-masked-inactive" and
    .privateIdentityExported == false and .protectedMountsActivated == false and
    .runtimeEnvironmentInstalled == false and .tailscaleEnrolled == false and
    .recipientCount == 3 and .serviceCount == 41 and .variableCount == 90 and
    .archBoot == $archBoot and .candidateScsi3 == $candidateScsi3 and .sourceCommit == $sourceCommit and
    (.hostBootIdBefore | test("^[0-9a-f-]{36}$")) and (.archConfigSha256 | test("^[0-9a-f]{64}$")) and
    (.modelInventorySha256 | test("^[0-9a-f]{64}$"))
  ' <<< "$pending_evidence" >/dev/null || { fail "pending credential staging evidence differs"; exit 1; }
  created_epoch=$(date -d "$(jq -er .createdAt <<< "$pending_evidence")" +%s)
  now_epoch=$(date +%s)
  evidence_age=$((now_epoch - created_epoch))
  [[ $evidence_age -ge -300 && $evidence_age -le 86400 ]] || { fail "pending credential staging evidence is stale or future-dated"; exit 1; }
  host_boot_id_after=$(cat /proc/sys/kernel/random/boot_id)
  [[ $host_boot_id_after != $(jq -er .hostBootIdBefore <<< "$pending_evidence") ]] || { fail "the required physical host reboot has not occurred"; exit 1; }
  finalize_pending=$(mktemp --tmpdir=/run home-lab-credentials-finalize-pending.XXXXXX)
  finalize_current=$(mktemp --tmpdir=/run home-lab-credentials-finalize-current.XXXXXX)
