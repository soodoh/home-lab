  [[ -f $CANARY_LOG && ! -L $CANARY_LOG && $(stat -c %U:%G:%a "$CANARY_LOG") == root:root:600 ]] || { fail "final canary host evidence is absent or unsafe"; exit 1; }
  [[ $(jq -cS . "$CANARY_LOG") == $(jq -cS .canaryEvidence infrastructure/evidence/vm-100-debian-production-canary.json) ]] || { fail "host and repository canary evidence diverge"; exit 1; }
  [[ $(python3 scripts/compose-artifact.py hash) == d23478a665cfc668efc8bf1296783f05b75a8c84080758c33eb264f45f1e3d5c ]] || { fail "Compose artifact hash differs"; exit 1; }
  [[ $(sha256sum infrastructure/debian/production-image-lock.json | awk '{print $1}') == c74199885009f0082cc7b5956eeb526ad895d1cab1605df15998767185aec726 ]] || { fail "production image lock differs"; exit 1; }
  [[ -f infrastructure/debian/production-tailscale-authkey.age && ! -L infrastructure/debian/production-tailscale-authkey.age && -f infrastructure/debian/production-tailscale-authkey.json && ! -L infrastructure/debian/production-tailscale-authkey.json ]] || { fail "encrypted production Tailscale key is absent or unsafe"; exit 1; }
  jq -e --arg sha "$(sha256sum infrastructure/debian/production-tailscale-authkey.age | awk '{print $1}')" '.format == "home-lab-debian-production-tailscale-key-v1" and .encryptedSha256 == $sha and .reusable == false and .ephemeral == false and .preauthorized == true and .tags == ["tag:docker-host"] and .recipient == "age1atumjua6hxyls6z8v20tsgy72304x72lqjstwmwzqy5ma4txyfsse7xakv" and .plaintextRetained == false' infrastructure/debian/production-tailscale-authkey.json >/dev/null || { fail "production Tailscale key metadata differs"; exit 1; }
  key_expires_epoch=$(date -d "$(jq -er .expires infrastructure/debian/production-tailscale-authkey.json)" +%s)
  [[ $key_expires_epoch -gt $(($(date +%s) + 14400)) ]] || { fail "production Tailscale key expires too soon for the bounded cutover"; exit 1; }
  [[ ! -e $PRODUCTION_PENDING_LOG && ! -L $PRODUCTION_PENDING_LOG && ! -e $PRODUCTION_LOG && ! -L $PRODUCTION_LOG ]] || { fail "production evidence requires reconciliation"; exit 1; }
  guest_exec_ok 30 /bin/bash -lc '[[ ! -e /srv/home-lab-state/.debian-production-images.tar && ! -e /srv/home-lab-state/.debian-production-images.json && ! -e /srv/home-lab-state/.debian-tailscale-1.98.4-amd64.tgz ]]' || { fail "a prior production transfer exists on Arch"; exit 1; }
fi

