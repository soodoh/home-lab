     (.transitionState == "rehearsal-verified" and (.state | type) == "object" and .state.uuid == "d4a19647-7879-4079-9fc9-b3e79711b449") or
     (.transitionState == null and .state == "rehearsal-verified")) and
    .readOnly == true and .unmounted == true and .kernelStorageErrors == 0 and .vmid == 100 and
    .dockerServices == "docker-disabled-containerd-masked-inactive" and .workloadIdentity == "1000:1000" and
    .games.uuid == "31602ce7-0054-498a-9f24-f51ca491e7b3" and .games.availableBytes >= 2000000000000 and ((.games.options | contains("noload")) or (.games.options | contains("norecovery"))) and
    .nfs.source == "192.168.0.123:/storage/docker" and .nfs.availableBytes >= 10000000000000 and (.nfs.options | contains("ro")) and
