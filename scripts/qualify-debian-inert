  mv -T "$temporary" "$PRODUCTION_PENDING_LOG"
}

write_production_pending_evidence() {
  local marker=$1 host_boot_id temporary
  host_boot_id=$(jq -er .hostBootIdBefore "$PRODUCTION_PENDING_LOG")
  temporary=$(mktemp --tmpdir="$DIAGNOSTIC_ROOT" .production-pending.XXXXXX)
  jq -c --arg archBoot "$ARCH_BOOT" --arg candidateScsi3 "$DEBIAN_SCSI3" \
    --arg createdAt "$(jq -er .createdAt "$PRODUCTION_PENDING_LOG")" --arg hostBootIdBefore "$host_boot_id" \
    --arg sourceCommit "$(git rev-parse HEAD)" \
    '. + {archBoot:$archBoot,candidateScsi3:$candidateScsi3,createdAt:$createdAt,evidenceFormat:"home-lab-debian-production-transition-v1",hostBootIdBefore:$hostBootIdBefore,sourceCommit:$sourceCommit,transitionState:"production-verified",vmid:100}' \
    <<< "$marker" > "$temporary"
  chmod 0600 "$temporary"
  chown root:root "$temporary"
  mv -T "$temporary" "$PRODUCTION_PENDING_LOG"
}

mark_production_evidence_awaiting_reboot() {
  local config_sha=$1 temporary
  temporary=$(mktemp --tmpdir="$DIAGNOSTIC_ROOT" .production-pending.XXXXXX)
  jq -c --arg configSha256 "$config_sha" '. + {configSha256:$configSha256,transitionState:"awaiting-host-reboot"}' "$PRODUCTION_PENDING_LOG" > "$temporary"
  chmod 0600 "$temporary"
