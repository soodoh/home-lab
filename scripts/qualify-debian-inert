  chmod 0600 "$finalize_evidence"
  mv -T "$finalize_evidence" "$REHEARSAL_LOG"
  rm -f -- "$REHEARSAL_PENDING_LOG"
  write_diagnostic_json "$RESTORE_LOG" arch-restored complete reachable reachable ready empty
  trap - EXIT
  rm -f -- "$finalize_pending" "$finalize_current"
  echo "Debian storage rehearsal finalized after physical reboot and complete Arch verification" >&2
  exit 0
fi
