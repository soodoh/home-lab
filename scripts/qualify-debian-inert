  qm config "$VMID" --current 1 > "$finalize_current"
  verify_exact_arch_configuration "$finalize_pending" "$finalize_current" || { fail "post-reboot Arch configuration differs"; exit 1; }
  [[ $(arch_config_sha256 "$finalize_pending") == $(jq -er .archConfigSha256 <<< "$pending_evidence") ]] || { fail "post-reboot Arch configuration digest differs"; exit 1; }
  wait_for_agent 600 || { fail "post-reboot Arch QEMU guest agent is unavailable"; exit 1; }
  [[ $(os_id) == arch ]] || { fail "post-reboot VM 100 is not Arch"; exit 1; }
  verify_arch_post_restore || { fail "post-reboot Arch workload health differs"; exit 1; }
  [[ $(systemctl --failed --no-legend | wc -l) -eq 0 ]] || { fail "the Proxmox host has failed units"; exit 1; }
  pve-firewall status | grep -Fxq 'Status: enabled/running' || { fail "Proxmox firewall status differs"; exit 1; }
  jq -c --arg finalizedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg hostBootIdAfter "$host_boot_id_after" \
    '. + {archRestore:"verified",finalizedAt:$finalizedAt,hostBootIdAfter:$hostBootIdAfter,transitionState:"complete"}' \
    <<< "$pending_evidence" > "$finalize_evidence"
  chown root:root "$finalize_evidence"
  chmod 0600 "$finalize_evidence"
  mv -T "$finalize_evidence" "$CREDENTIALS_LOG"
  rm -f -- "$CREDENTIALS_PENDING_LOG"
  trap - EXIT
  rm -f -- "$finalize_pending" "$finalize_current"
  echo "Debian credential and Compose staging finalized after physical reboot and complete Arch verification" >&2
  exit 0
