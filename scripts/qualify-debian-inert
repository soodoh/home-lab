  [[ $(systemctl --failed --no-legend | wc -l) -eq 0 ]] || { fail "the Proxmox host has failed units"; exit 1; }
  [[ $(systemctl is-active pve-firewall) == active && $(systemctl is-active proxmox-firewall) == active ]] || { fail "Proxmox firewall services are inactive"; exit 1; }
