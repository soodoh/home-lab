handle_failure() {
  local result=$1 reason=$2
  trap - ERR INT TERM HUP
  set +e
  echo "error: Debian inert transition $reason at stage: $stage" >&2
  if [[ ${locks_held:-false} != true ]] && ! acquire_transition_locks; then
    echo "critical: transition locks could not be reacquired; remain at the physical console" >&2
    stop_console_capture || true
    exit "$result"
  fi
  if [[ $canary_mode == true && -n ${canary_operation_pid:-} && $(vm_status) == running ]]; then
    cancel_guest_operation "$canary_operation_pid" || true
    canary_operation_pid=
  fi
  if [[ $production_mode == true && -n ${production_operation_pid:-} && $(vm_status) == running ]]; then
    cancel_guest_operation "$production_operation_pid" || true
    production_operation_pid=
  fi
  if [[ $production_mode == true && $production_prepare_invoked == true && $transition_started == false && $(vm_status) == running ]]; then
    guest_exec_ok 30 /bin/rm -f /srv/home-lab-state/.debian-production-images.tar /srv/home-lab-state/.debian-production-images.json /srv/home-lab-state/.debian-tailscale-1.98.4-amd64.tgz /run/home-lab-debian-production-transfer.json /run/home-lab-arch-production-prepare.result /run/home-lab-arch-production-prepare.result.pending /run/home-lab-arch-production-prepare.runner /run/home-lab-prepare-production /run/home-lab-production-image-lock.json || true
    if verify_arch_post_restore; then rm -f -- "$PRODUCTION_PENDING_LOG"; else echo "critical: Arch workloads differ after interrupted production preparation" >&2; fi
  fi
  if [[ $canary_mode == true && $canary_prepare_invoked == true && $transition_started == false && $(vm_status) == running ]]; then
    guest_exec_ok 30 /bin/rm -f /srv/home-lab-state/.debian-openfit-canary-image.tar /srv/home-lab-state/.debian-openfit-canary-transfer.json /run/home-lab-openfit-canary-transfer.json /run/home-lab-arch-canary-prepare.result /run/home-lab-arch-canary-prepare.result.pending /run/home-lab-arch-canary-prepare.runner /run/home-lab-prepare-openfit-canary || true
    for ((recovery_attempt = 0; recovery_attempt < 60; recovery_attempt += 1)); do
      if verify_arch_post_restore; then break; fi
      sleep 5
    done
    if verify_arch_post_restore; then
      rm -f -- "$CANARY_PENDING_LOG"
    else
      echo "critical: Arch workloads did not recover after interrupted canary preparation" >&2
    fi
  fi
  if [[ $transition_started == true ]]; then
    candidate_diagnostics || echo "warning: candidate diagnostics could not be persisted" >&2
    if [[ $production_mode == true ]]; then capture_failed_production_activation || true; fi
    stop_console_capture || true
  fi
  if [[ ($prepare_mode == true || $rehearsal_mode == true || $identity_mode == true || $credentials_mode == true || $canary_mode == true || $production_mode == true) && $transition_started == true ]]; then
    if prepare_arch_host_reboot_path; then
      if [[ $prepare_mode == true && -f $PREPARE_PENDING_LOG ]] && jq -e '.state == "package-verified"' "$PREPARE_PENDING_LOG" >/dev/null 2>&1; then
        mark_package_evidence_awaiting_reboot "$arch_reboot_config_sha" || true
      fi
      if [[ $rehearsal_mode == true && -f $REHEARSAL_PENDING_LOG ]] && jq -e '.transitionState == "rehearsal-verified"' "$REHEARSAL_PENDING_LOG" >/dev/null 2>&1; then
        mark_rehearsal_evidence_awaiting_reboot "$arch_reboot_config_sha" || true
      fi
      if [[ $identity_mode == true && -f $IDENTITY_PENDING_LOG ]] && jq -e '.transitionState == "identity-verified"' "$IDENTITY_PENDING_LOG" >/dev/null 2>&1; then
        mark_identity_evidence_awaiting_reboot "$arch_reboot_config_sha" || true
      fi
      if [[ $credentials_mode == true && -f $CREDENTIALS_PENDING_LOG ]] && jq -e '.transitionState == "credentials-verified"' "$CREDENTIALS_PENDING_LOG" >/dev/null 2>&1; then
        mark_credentials_evidence_awaiting_reboot "$arch_reboot_config_sha" || true
      fi
      if [[ $canary_mode == true && -f $CANARY_PENDING_LOG ]]; then
        if jq -e '.transitionState == "canary-verified"' "$CANARY_PENDING_LOG" >/dev/null 2>&1; then
          mark_canary_evidence_awaiting_reboot "$arch_reboot_config_sha" || true
        elif jq -e '.transitionState == "transfer-prepared"' "$CANARY_PENDING_LOG" >/dev/null 2>&1; then
          mark_failed_canary_evidence_awaiting_reboot "$arch_reboot_config_sha" || true
          echo "After reboot, run /root/home-lab/scripts/finalize-debian-production-canary to complete failed-attempt recovery" >&2
        fi
      fi
      if [[ $production_mode == true && -f $PRODUCTION_PENDING_LOG ]] && jq -e '.transitionState == "transfer-prepared" or .transitionState == "production-verified"' "$PRODUCTION_PENDING_LOG" >/dev/null 2>&1; then
        mark_failed_production_evidence_awaiting_reboot "$arch_reboot_config_sha" || true
        echo "After reboot, run /root/home-lab/scripts/finalize-debian-production-cutover to complete failed-attempt recovery" >&2
      fi
      echo "Arch boot configuration prepared; a physical Proxmox host reboot is required" >&2
    else
      echo "critical: exact Arch host-reboot preparation remains incomplete; stay at the physical console" >&2
    fi
    exit "$result"
  fi
  if [[ $transition_started == true || $(vm_status) == stopped ]]; then
    restore_arch || echo "critical: Arch restoration remains incomplete; stay at the physical console" >&2
  fi
  exit "$result"
}
on_error() {
  handle_failure "$?" failed
}
trap on_error ERR
trap 'handle_failure 130 interrupted' INT
trap 'handle_failure 143 terminated' TERM
trap 'handle_failure 129 disconnected' HUP
