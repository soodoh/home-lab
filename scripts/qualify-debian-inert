  temporary=$(mktemp --tmpdir="$DIAGNOSTIC_ROOT" .openfit-canary-pending.XXXXXX)
  jq -c --arg archBoot "$ARCH_BOOT" --arg candidateScsi3 "$DEBIAN_SCSI3" \
    --arg createdAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg hostBootIdBefore "$host_boot_id" \
    --arg sourceCommit "$(git rev-parse HEAD)" \
    '. + {archBoot:$archBoot,candidateScsi3:$candidateScsi3,createdAt:$createdAt,evidenceFormat:"home-lab-debian-canary-transition-v1",hostBootIdBefore:$hostBootIdBefore,sourceCommit:$sourceCommit,transitionState:"canary-verified",vmid:100}' \
    <<< "$marker" > "$temporary"
  chmod 0600 "$temporary"
  chown root:root "$temporary"
  mv -T "$temporary" "$CANARY_PENDING_LOG"
}

