guest_exec_ok 30 /bin/bash -lc "[[ \$(basename \"\$(readlink -f /sys/bus/pci/devices/0000:02:00.0/driver)\") == amdgpu ]]"
guest_exec_ok 30 /usr/bin/test -c /dev/dri/renderD128
guest_exec_ok 60 /bin/bash -lc 'LIBVA_DRIVER_NAME=radeonsi vainfo --display drm --device /dev/dri/renderD128 >/dev/null'
guest_exec_ok 30 /bin/bash -lc 'lspci -Dnns 03:00.0 | grep -Fq "1002:ab30"'
stage=verify-debian-usb
guest_exec_ok 30 /bin/bash -lc 'lsusb -d 0bda:a729 | grep -q .'
guest_exec_ok 30 /bin/bash -lc "[[ \$(lsusb -d 10c4:ea60 | wc -l) -eq 2 ]]"
stage=verify-debian-inert
guest_exec_ok 30 /usr/bin/test ! -e /etc/home-lab/allow-storage-activation
guest_exec_ok 30 /bin/bash -lc "for target in /srv/home-lab-state /mnt/games /mnt/storage; do ! findmnt -rn --mountpoint \"\$target\" >/dev/null || exit 1; done"
guest_exec_ok 30 /bin/bash -lc "[[ \$(blkid -t LABEL=home-lab-state -s UUID -o value | sort -u) == d4a19647-7879-4079-9fc9-b3e79711b449 ]]"
guest_exec_ok 30 /bin/bash -lc "[[ \$(blkid -t LABEL=games -s UUID -o value | sort -u) == 31602ce7-0054-498a-9f24-f51ca491e7b3 ]]"
for unit in 'srv-home\x2dlab\x2dstate.mount' mnt-games.mount mnt-storage.mount; do
  guest_exec_ok 30 /bin/bash -lc "[[ \$(systemctl is-enabled '$unit' 2>/dev/null || true) == disabled ]] && [[ \$(systemctl is-active '$unit' 2>/dev/null || true) == inactive ]]"
done
guest_exec_ok 30 /bin/bash -lc '! command -v docker && ! systemctl list-unit-files --no-legend | grep -q "^home-lab-compose.service"'
stage=verify-debian-updates
guest_exec_ok 30 /bin/bash -lc 'grep -Fq '\''Unattended-Upgrade::Automatic-Reboot "false";'\'' /etc/apt/apt.conf.d/52home-lab-unattended-upgrades'
stage=verify-debian-failed-units
guest_exec_ok 30 /bin/bash -lc "[[ \$(systemctl --failed --no-legend | wc -l) -eq 0 ]]"
stage=verify-debian-boot-order
[[ $(qm config "$VMID" | awk -F ': ' '$1 == "boot" { print $2 }') == "$DEBIAN_BOOT" ]]
stop_console_capture
console_sha=empty
if [[ -s $CONSOLE_LOG ]]; then
  console_sha=$(sha256sum "$CONSOLE_LOG" | awk '{print $1}')
fi
write_diagnostic_json "$ATTEMPT_LOG" candidate-ready complete reachable reachable ready "$console_sha"
trap - ERR
echo "Debian inert qualification passed; protected mounts, Docker, and Compose remain inactive"
