  rm -f -- "$PRODUCTION_PENDING_LOG"
  trap - EXIT
  rm -f -- "$finalize_pending" "$finalize_current"
  echo "Debian production finalized after physical reboot with full Compose and Tailscale verification" >&2
  exit 0
