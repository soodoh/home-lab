config_value() {
  local file=$1 key=$2
  awk -F ': ' -v key="$key" '$1 == key { sub(/^[^:]+: /, ""); print; found=1 } END { if (!found) exit 1 }' "$file"
}

verify_plan_attestation() {
  local attestation commit created_at created_epoch now_epoch age
  git fetch --quiet origin "+refs/heads/main:refs/remotes/origin/main" "+$PLAN_NOTES_REF:$PLAN_NOTES_REF"
  commit=$(git rev-parse HEAD)
  attestation=$(git notes --ref="$PLAN_NOTES_REF" show "$commit")
  jq -e --arg commit "$commit" '
    .schemaVersion == 1 and
    .commit == $commit and
    .phase == "steady" and
    .stage == "converge" and
    .proxmoxHostActions == 0 and
    .allActionsZero == true and
    (.manifestSha256 | test("^[0-9a-f]{64}$")) and
    (.roots | length) == 5 and
    all(.roots[]; .changed == false and (.sha256 | test("^[0-9a-f]{64}$"))) and
    ([.roots[].root] | sort) == ["aws-foundation", "omada", "proxmox", "proxmox-legacy", "tailscale"]
  ' <<< "$attestation" >/dev/null
  created_at=$(jq -er .createdAt <<< "$attestation")
  created_epoch=$(date -d "$created_at" +%s)
  now_epoch=$(date +%s)
  age=$((now_epoch - created_epoch))
  [[ $age -ge -300 && $age -le 86400 ]]
}

stage_image() {
  local pending=$IMAGE_PATH.pending actual digest_valid=true
  digest_temporary=$(mktemp --tmpdir=/run home-lab-debian-digests.XXXXXX)
  chmod 0600 "$digest_temporary"
  curl --fail --location --proto '=https' --tlsv1.2 --connect-timeout 15 --max-time 120 --retry 3 --retry-all-errors --silent --show-error "$IMAGE_DIGEST_URL" --output "$digest_temporary" || digest_valid=false
  grep -Fxq "$IMAGE_SHA512  $IMAGE_FILENAME" "$digest_temporary" || digest_valid=false
  rm -f -- "$digest_temporary"
  digest_temporary=
  [[ $digest_valid == true ]] || fail "official Debian image digest metadata differs"
  install -d -o root -g root -m 0755 "$(dirname "$IMAGE_PATH")"
  [[ ! -e $pending && ! -L $pending ]] || fail "a pending Debian image requires manual reconciliation"
  if [[ -e $IMAGE_PATH || -L $IMAGE_PATH ]]; then
    [[ -f $IMAGE_PATH && ! -L $IMAGE_PATH ]] || fail "Debian image target is not a regular non-symlink file"
    actual=$(sha512sum "$IMAGE_PATH" | awk '{print $1}')
    [[ $actual == "$IMAGE_SHA512" ]] || fail "staged Debian image digest differs"
    [[ $(stat -c %U:%G:%a "$IMAGE_PATH") == root:root:600 ]] || fail "staged Debian image metadata differs"
    return
  fi
  umask 077
  curl --fail --location --proto '=https' --tlsv1.2 --connect-timeout 15 --max-time 1800 --retry 3 --retry-all-errors --silent --show-error "$IMAGE_URL" --output "$pending"
  actual=$(sha512sum "$pending" | awk '{print $1}')
  [[ $actual == "$IMAGE_SHA512" ]] || fail "downloaded Debian image digest differs"
  chown root:root "$pending"
  chmod 0600 "$pending"
  ln "$pending" "$IMAGE_PATH"
  rm -f -- "$pending"
}

stage_snippet() {
  local source=$1 target=$2 expected_sha=$3 expected_size=$4 previous_sha=${5:-} previous_size=${6:-} pending actual metadata
  pending=$(dirname "$target")/.$(basename "$target").pending
  [[ -f $source && ! -L $source ]] || fail "cloud-init source is absent or unsafe: $source"
  [[ $(stat -c %s "$source") -eq $expected_size ]] || fail "cloud-init source size differs: $source"
  actual=$(sha256sum "$source" | awk '{print $1}')
  [[ $actual == "$expected_sha" ]] || fail "cloud-init source digest differs: $source"
  [[ ! -e $pending && ! -L $pending ]] || fail "a pending cloud-init snippet requires manual reconciliation: $pending"
  if [[ -e $target || -L $target ]]; then
    [[ -f $target && ! -L $target ]] || fail "cloud-init target is absent or unsafe: $target"
    metadata=$(stat -c %U:%G:%a:%s "$target")
    actual=$(sha256sum "$target" | awk '{print $1}')
    if [[ $metadata == root:root:600:$expected_size && $actual == "$expected_sha" ]]; then
      return
    fi
    [[ -n $previous_sha && $metadata == root:root:600:$previous_size && $actual == "$previous_sha" ]] || fail "cloud-init target differs from the exact current and previous revisions: $target"
    install -o root -g root -m 0600 "$source" "$pending"
    mv -T "$pending" "$target"
    return
  fi
  install -d -o root -g root -m 0755 "$(dirname "$target")"
  install -o root -g root -m 0600 "$source" "$pending"
  ln "$pending" "$target"
  rm -f -- "$pending"
}

verify_iso_entry() {
  local iso=$1 entry=$2 expected_sha=$3 expected_size=$4 temporary actual valid=true
  temporary=$(mktemp --tmpdir=/run home-lab-debian-cloudinit.XXXXXX)
  chmod 0600 "$temporary"
  isoinfo -i "$iso" -x "$entry" > "$temporary" || valid=false
  [[ $(stat -c %s "$temporary") -eq $expected_size ]] || valid=false
  actual=$(sha256sum "$temporary" | awk '{print $1}')
  [[ $actual == "$expected_sha" ]] || valid=false
  rm -f -- "$temporary"
  [[ $valid == true ]]
}

prepare_arch_restore() {
  local cloudinit_path
  scripts/stage-flatcar-ignition check >/dev/null
  qm set "$VMID" --cicustom "$CURRENT_CICUSTOM"
  qm cloudinit update "$VMID"
  cloudinit_path=$(pvesm path local-lvm:vm-100-cloudinit)
  verify_iso_entry "$cloudinit_path" '/USER_DATA.;1' "$CURRENT_IGNITION_SHA256" "$CURRENT_IGNITION_SIZE"
}

guest_exec_json() {
  local timeout_seconds=$1
  shift
  qm guest exec "$VMID" --timeout "$timeout_seconds" -- "$@"
}

guest_exec_ok() {
  local timeout_seconds=$1 result temporary
  shift
  result=$(guest_exec_json "$timeout_seconds" "$@")
  if jq -e '.exited == 1 and .exitcode == 0' <<< "$result" >/dev/null; then
    return 0
  fi
  install -d -o root -g root -m 0700 "$DIAGNOSTIC_ROOT"
  temporary=$(mktemp --tmpdir="$DIAGNOSTIC_ROOT" .guest-exec-failure.XXXXXX)
  jq -c --arg stage "${stage:-unknown}" '{stage:$stage,response:.}' <<< "$result" > "$temporary"
  chmod 0600 "$temporary"
  chown root:root "$temporary"
  mv -T "$temporary" "$GUEST_FAILURE_LOG"
  jq -r '(."out-data" // "") + (."err-data" // "")' <<< "$result" >&2
  return 1
}

wait_for_guest_operation() {
  local result_path=$1 timeout_seconds=$2 elapsed=0 response status
  [[ $result_path =~ ^/run/home-lab-(arch|debian)-(canary|production)(-[a-z-]+)?\.result$ ]] || return 1
  while [[ $elapsed -lt $timeout_seconds ]]; do
    [[ $(vm_status) == running ]] || return 1
    response=$(guest_exec_json 30 /bin/bash -lc "if [[ -f '$result_path' && ! -L '$result_path' ]]; then cat '$result_path'; else printf pending; fi") || return 1
    status=$(jq -er '."out-data"' <<< "$response") || return 1
    if [[ $status != pending ]]; then
      [[ $status =~ ^[0-9]+$ ]] || return 1
      [[ $status -eq 0 ]]
      return
    fi
    sleep 10
    elapsed=$((elapsed + 10))
  done
  return 1
}

cancel_guest_operation() {
  local pid=$1 response
  [[ $pid =~ ^[1-9][0-9]*$ ]] || return 1
  guest_exec_ok 30 /bin/kill -TERM -- "-$pid" || true
  for ((attempt = 0; attempt < 300; attempt += 1)); do
    response=$(guest_exec_json 30 /bin/bash -lc "if ps -eo pgid= | grep -Eq '^[[:space:]]*$pid[[:space:]]*$'; then exit 1; fi") || return 1
    if jq -e '.exited == 1 and .exitcode == 0' <<< "$response" >/dev/null; then return 0; fi
    sleep 2
  done
  guest_exec_ok 30 /bin/kill -KILL -- "-$pid" || true
  response=$(guest_exec_json 30 /bin/bash -lc "if ps -eo pgid= | grep -Eq '^[[:space:]]*$pid[[:space:]]*$'; then exit 1; fi") || return 1
  jq -e '.exited == 1 and .exitcode == 0' <<< "$response" >/dev/null
}

verify_arch_post_restore() {
  guest_exec_ok 60 /bin/bash -lc "[[ \$(docker ps -q | wc -l) -eq 41 ]]" || return 1
  guest_exec_ok 60 /bin/bash -lc "[[ -z \$(docker ps --filter health=unhealthy -q) ]]" || return 1
  guest_exec_ok 60 /bin/bash -lc "docker inspect \$(docker ps -aq) | jq -e '[.[].Mounts[] | select(.Type == \"volume\")] | length == 0' >/dev/null" || return 1
  guest_exec_ok 60 /bin/bash -lc "docker inspect \$(docker ps -aq) | jq -e '[.[].Mounts[] | select(.Type == \"bind\" and (.Source | startswith(\"/srv/home-lab-state/\")))] | length == 115' >/dev/null" || return 1
  guest_exec_ok 30 /bin/bash -lc "source=\$(findmnt -rn -o SOURCE -T /srv/home-lab-state); [[ \$(blkid -s UUID -o value \"\$source\") == d4a19647-7879-4079-9fc9-b3e79711b449 ]]" || return 1
}

verify_exact_arch_configuration() {
  local pending=$1 current=$2 config key
  for config in "$pending" "$current"; do
    [[ $(config_value "$config" boot) == "$ARCH_BOOT" ]] || return 1
    [[ $(config_value "$config" scsi0) == "$EFFECTIVE_SCSI0" ]] || return 1
    [[ $(config_value "$config" scsi1) == "$EFFECTIVE_SCSI1" ]] || return 1
    [[ $(config_value "$config" scsi2) == "$EFFECTIVE_SCSI2" ]] || return 1
    [[ $(config_value "$config" scsi3) == "$DEBIAN_SCSI3" ]] || return 1
    [[ $(config_value "$config" ide2) == "$EFFECTIVE_IDE2" ]] || return 1
    [[ $(config_value "$config" cicustom) == "$CURRENT_CICUSTOM" ]] || return 1
    [[ $(config_value "$config" hostpci1) == "$EFFECTIVE_HOSTPCI1" ]] || return 1
    [[ $(config_value "$config" hostpci2) == "$EFFECTIVE_HOSTPCI2" ]] || return 1
    [[ $(config_value "$config" usb0) == "$EFFECTIVE_USB0" ]] || return 1
    [[ $(config_value "$config" usb1) == "$EFFECTIVE_USB1" ]] || return 1
    [[ $(config_value "$config" usb2) == "$EFFECTIVE_USB2" ]] || return 1
    [[ $(config_value "$config" onboot) == 1 ]] || return 1
    [[ $(config_value "$config" protection) == 1 ]] || return 1
    [[ $(config_value "$config" vga) == none ]] || return 1
    ! config_value "$config" lock >/dev/null 2>&1 || return 1
    ! grep -Eq '^unused[0-9]+:' "$config" || return 1
  done
  for key in boot scsi0 scsi1 scsi2 scsi3 ide2 cicustom hostpci1 hostpci2 usb0 usb1 usb2 onboot protection vga; do
    [[ $(config_value "$pending" "$key") == $(config_value "$current" "$key") ]] || return 1
  done
  return 0
}

arch_config_sha256() {
  grep -E '^(boot|cicustom|hostpci1|hostpci2|ide2|onboot|protection|scsi0|scsi1|scsi2|scsi3|usb0|usb1|usb2|vga): ' "$1" \
    | LC_ALL=C sort | sha256sum | awk '{print $1}'
}

write_package_pending_evidence() {
  local marker=$1 host_boot_id temporary
  host_boot_id=$(cat /proc/sys/kernel/random/boot_id)
  temporary=$(mktemp --tmpdir="$DIAGNOSTIC_ROOT" .packages-prepared-pending.XXXXXX)
  jq -c --arg archBoot "$ARCH_BOOT" --arg candidateScsi3 "$DEBIAN_SCSI3" \
    --arg createdAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg hostBootIdBefore "$host_boot_id" \
    --arg sourceCommit "$(git rev-parse HEAD)" \
    '. + {archBoot:$archBoot,candidateScsi3:$candidateScsi3,createdAt:$createdAt,evidenceFormat:"home-lab-debian-package-transition-v1",hostBootIdBefore:$hostBootIdBefore,sourceCommit:$sourceCommit,state:"package-verified",vmid:100}' \
    <<< "$marker" > "$temporary"
  chmod 0600 "$temporary"
  chown root:root "$temporary"
  mv -T "$temporary" "$PREPARE_PENDING_LOG"
}

mark_package_evidence_awaiting_reboot() {
  local config_sha=$1 temporary
  temporary=$(mktemp --tmpdir="$DIAGNOSTIC_ROOT" .packages-prepared-pending.XXXXXX)
  jq -c --arg archConfigSha256 "$config_sha" '. + {archConfigSha256:$archConfigSha256,state:"awaiting-host-reboot"}' \
    "$PREPARE_PENDING_LOG" > "$temporary"
  chmod 0600 "$temporary"
  chown root:root "$temporary"
  mv -T "$temporary" "$PREPARE_PENDING_LOG"
}

