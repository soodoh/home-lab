#!/bin/bash
set -Eeuo pipefail

readonly VMID=100
readonly CANDIDATE_IP=192.168.0.100
readonly ARCH_BOOT='order=scsi0;net0'
readonly DEBIAN_BOOT='order=scsi3;scsi0;net0'
readonly CURRENT_SCSI3='local-lvm:vm-100-disk-2,backup=1,cache=none,discard=ignore,iothread=1,replicate=1,serial=HOME-LAB-FLATCAR-64G,size=64G,ssd=0'
readonly DEBIAN_SCSI3='local-lvm:vm-100-disk-2,backup=1,cache=none,discard=ignore,iothread=1,replicate=1,serial=HOME-LAB-DEBIAN-64G,size=64G,ssd=0'
readonly EFFECTIVE_SCSI0='local-lvm:vm-100-disk-0,iothread=1,size=550G'
readonly EFFECTIVE_SCSI1='/dev/disk/by-id/nvme-CT4000P3PSSD8_2412E8A04266,backup=0,discard=on,iothread=1,size=3907018584K,ssd=1'
readonly EFFECTIVE_SCSI2='local-lvm:vm-100-disk-1,backup=1,cache=none,discard=ignore,iothread=1,replicate=1,serial=QUAL-NIXOS-128G,size=128G,ssd=0'
readonly EFFECTIVE_IDE2='local-lvm:vm-100-cloudinit,media=cdrom'
readonly CURRENT_CICUSTOM='user=local:snippets/vm-100-flatcar.ign'
readonly CURRENT_IGNITION_SHA256=d60808452116247828f749517a66ec29d4656c4978d2997ab22e938d8cb4bc6d
readonly CURRENT_IGNITION_SIZE=76685
readonly DEBIAN_CICUSTOM='meta=local:snippets/vm-100-debian-meta.yaml,network=local:snippets/vm-100-debian-network.yaml,user=local:snippets/vm-100-debian-user.yaml'
readonly GPU_VENDOR_DEVICE=1002:744c
readonly EFFECTIVE_HOSTPCI1='mapping=rx-7900-xtx,pcie=1,rombar=1,x-vga=1'
readonly EFFECTIVE_HOSTPCI2='mapping=rx-7900-xtx-audio,pcie=1,rombar=1'
readonly EFFECTIVE_USB0='mapping=zigbee-cp210x'
readonly EFFECTIVE_USB1='mapping=zwave-cp210x'
readonly EFFECTIVE_USB2='mapping=realtek-bluetooth,usb3=1'
readonly KERNEL_RELEASE=6.12.101+deb13-amd64
readonly IMAGE_URL=https://cloud.debian.org/images/cloud/trixie/20260810-2566/debian-13-generic-amd64-20260810-2566.qcow2
readonly IMAGE_DIGEST_URL=https://cloud.debian.org/images/cloud/trixie/20260810-2566/SHA512SUMS
readonly IMAGE_FILENAME=debian-13-generic-amd64-20260810-2566.qcow2
readonly IMAGE_SHA512=f6978100d8031c266d55d7815ceea7fcdeacf28e1e5834fdb9c94ac96880a054a6e6f8681c2d3b0584e0057eaf3ef7353856b85212d04134744faa9b3bb1f24f
readonly IMAGE_PATH=/var/lib/vz/import/debian-13-generic-amd64-20260810-2566.qcow2
readonly USER_SOURCE=infrastructure/debian/cloud-init/user-data
readonly USER_TARGET=/var/lib/vz/snippets/vm-100-debian-user.yaml
readonly USER_SHA256=a93c27b74c55f2caf649dc2413070115e459e2bfd3885967b4aa6d376c7d694e
readonly USER_SIZE=4350
readonly PREVIOUS_USER_SHA256=e1808e86931397e98bec1a780ee8d80c0293edfb0115314be7e48c433c83ae87
readonly PREVIOUS_USER_SIZE=4401
readonly NETWORK_SOURCE=infrastructure/debian/cloud-init/network-data
readonly NETWORK_TARGET=/var/lib/vz/snippets/vm-100-debian-network.yaml
readonly NETWORK_SHA256=9fd8205499f8cbb692099c72579b3e15280c7c42c21678cef1c6c43117855d95
readonly NETWORK_SIZE=281
readonly META_SOURCE=infrastructure/debian/cloud-init/meta-data
readonly META_TARGET=/var/lib/vz/snippets/vm-100-debian-meta.yaml
readonly META_SHA256=e9a68afeaa0e3071a22a01f7b1cd5cf92f88eb9d23b20fd6a9b07a826546c8a7
readonly META_SIZE=75
readonly CONFIRMATION=qualify-reviewed-vm-100-debian-13-inert
readonly RESTORE_CONFIRMATION=restore-reviewed-vm-100-arch-after-debian-inert
readonly PREPARE_CONFIRMATION=prepare-reviewed-vm-100-debian-packages
readonly FINALIZE_CONFIRMATION=finalize-reviewed-vm-100-debian-packages-after-reboot
readonly PLAN_NOTES_REF=refs/notes/debian-qualification
readonly VFIO_CONFIRMATION=recover-vm-100-vfio-group-14
readonly RECONCILIATION_ROOT=/var/lib/home-lab/reconciliation
readonly DIAGNOSTIC_ROOT=/var/lib/home-lab/debian
readonly CONSOLE_LOG=$DIAGNOSTIC_ROOT/inert-console.log
readonly ATTEMPT_LOG=$DIAGNOSTIC_ROOT/inert-attempt.json
readonly RESTORE_LOG=$DIAGNOSTIC_ROOT/inert-restore.json
readonly PREPARE_LOG=$DIAGNOSTIC_ROOT/packages-prepared.json
readonly PREPARE_PENDING_LOG=$DIAGNOSTIC_ROOT/packages-prepared.pending.json
readonly SERIAL_SOCKET=/var/run/qemu-server/100.serial0
readonly PATH=/usr/sbin:/usr/bin:/sbin:/bin

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
source scripts/lib/vm-100-os-transition

config_value() {
  local file=$1 key=$2
  awk -F ': ' -v key="$key" '$1 == key { sub(/^[^:]+: /, ""); print; found=1 } END { if (!found) exit 1 }' "$file"
}

verify_plan_attestation() {
  local attestation commit created_at created_epoch now_epoch age
  git fetch --quiet origin "+refs/heads/main:refs/remotes/origin/main" "+$PLAN_NOTES_REF:$PLAN_NOTES_REF"
  commit=$(git rev-parse HEAD)
  attestation=$(git notes --ref="$PLAN_NOTES_REF" show "$commit")
  jq -e --arg commit "$commit" '
    .schemaVersion == 1 and
    .commit == $commit and
    .phase == "steady" and
    .stage == "converge" and
    .proxmoxHostActions == 0 and
    .allActionsZero == true and
    (.manifestSha256 | test("^[0-9a-f]{64}$")) and
    (.roots | length) == 5 and
    all(.roots[]; .changed == false and (.sha256 | test("^[0-9a-f]{64}$"))) and
    ([.roots[].root] | sort) == ["aws-foundation", "omada", "proxmox", "proxmox-legacy", "tailscale"]
  ' <<< "$attestation" >/dev/null
  created_at=$(jq -er .createdAt <<< "$attestation")
  created_epoch=$(date -d "$created_at" +%s)
  now_epoch=$(date +%s)
  age=$((now_epoch - created_epoch))
  [[ $age -ge -300 && $age -le 86400 ]]
}

stage_image() {
  local pending=$IMAGE_PATH.pending actual digest_valid=true
  digest_temporary=$(mktemp --tmpdir=/run home-lab-debian-digests.XXXXXX)
  chmod 0600 "$digest_temporary"
  curl --fail --location --proto '=https' --tlsv1.2 --connect-timeout 15 --max-time 120 --retry 3 --retry-all-errors --silent --show-error "$IMAGE_DIGEST_URL" --output "$digest_temporary" || digest_valid=false
  grep -Fxq "$IMAGE_SHA512  $IMAGE_FILENAME" "$digest_temporary" || digest_valid=false
  rm -f -- "$digest_temporary"
  digest_temporary=
  [[ $digest_valid == true ]] || fail "official Debian image digest metadata differs"
  install -d -o root -g root -m 0755 "$(dirname "$IMAGE_PATH")"
  [[ ! -e $pending && ! -L $pending ]] || fail "a pending Debian image requires manual reconciliation"
  if [[ -e $IMAGE_PATH || -L $IMAGE_PATH ]]; then
    [[ -f $IMAGE_PATH && ! -L $IMAGE_PATH ]] || fail "Debian image target is not a regular non-symlink file"
    actual=$(sha512sum "$IMAGE_PATH" | awk '{print $1}')
    [[ $actual == "$IMAGE_SHA512" ]] || fail "staged Debian image digest differs"
    [[ $(stat -c %U:%G:%a "$IMAGE_PATH") == root:root:600 ]] || fail "staged Debian image metadata differs"
    return
  fi
  umask 077
  curl --fail --location --proto '=https' --tlsv1.2 --connect-timeout 15 --max-time 1800 --retry 3 --retry-all-errors --silent --show-error "$IMAGE_URL" --output "$pending"
  actual=$(sha512sum "$pending" | awk '{print $1}')
  [[ $actual == "$IMAGE_SHA512" ]] || fail "downloaded Debian image digest differs"
  chown root:root "$pending"
  chmod 0600 "$pending"
  ln "$pending" "$IMAGE_PATH"
  rm -f -- "$pending"
}

stage_snippet() {
  local source=$1 target=$2 expected_sha=$3 expected_size=$4 previous_sha=${5:-} previous_size=${6:-} pending actual metadata
  pending=$(dirname "$target")/.$(basename "$target").pending
  [[ -f $source && ! -L $source ]] || fail "cloud-init source is absent or unsafe: $source"
  [[ $(stat -c %s "$source") -eq $expected_size ]] || fail "cloud-init source size differs: $source"
  actual=$(sha256sum "$source" | awk '{print $1}')
  [[ $actual == "$expected_sha" ]] || fail "cloud-init source digest differs: $source"
  [[ ! -e $pending && ! -L $pending ]] || fail "a pending cloud-init snippet requires manual reconciliation: $pending"
  if [[ -e $target || -L $target ]]; then
    [[ -f $target && ! -L $target ]] || fail "cloud-init target is absent or unsafe: $target"
    metadata=$(stat -c %U:%G:%a:%s "$target")
    actual=$(sha256sum "$target" | awk '{print $1}')
    if [[ $metadata == root:root:600:$expected_size && $actual == "$expected_sha" ]]; then
      return
    fi
    [[ -n $previous_sha && $metadata == root:root:600:$previous_size && $actual == "$previous_sha" ]] || fail "cloud-init target differs from the exact current and previous revisions: $target"
    install -o root -g root -m 0600 "$source" "$pending"
    mv -T "$pending" "$target"
    return
  fi
  install -d -o root -g root -m 0755 "$(dirname "$target")"
  install -o root -g root -m 0600 "$source" "$pending"
  ln "$pending" "$target"
  rm -f -- "$pending"
}

verify_iso_entry() {
  local iso=$1 entry=$2 expected_sha=$3 expected_size=$4 temporary actual valid=true
  temporary=$(mktemp --tmpdir=/run home-lab-debian-cloudinit.XXXXXX)
  chmod 0600 "$temporary"
  isoinfo -i "$iso" -x "$entry" > "$temporary" || valid=false
  [[ $(stat -c %s "$temporary") -eq $expected_size ]] || valid=false
  actual=$(sha256sum "$temporary" | awk '{print $1}')
  [[ $actual == "$expected_sha" ]] || valid=false
  rm -f -- "$temporary"
  [[ $valid == true ]]
}

prepare_arch_restore() {
  local cloudinit_path
  scripts/stage-flatcar-ignition check >/dev/null
  qm set "$VMID" --cicustom "$CURRENT_CICUSTOM"
  qm cloudinit update "$VMID"
  cloudinit_path=$(pvesm path local-lvm:vm-100-cloudinit)
  verify_iso_entry "$cloudinit_path" '/USER_DATA.;1' "$CURRENT_IGNITION_SHA256" "$CURRENT_IGNITION_SIZE"
}

guest_exec_json() {
  local timeout_seconds=$1
  shift
  qm guest exec "$VMID" --timeout "$timeout_seconds" -- "$@"
}

guest_exec_ok() {
  local timeout_seconds=$1 result
  shift
  result=$(guest_exec_json "$timeout_seconds" "$@")
  jq -e '.exited == 1 and .exitcode == 0' <<< "$result" >/dev/null
}

verify_arch_post_restore() {
  guest_exec_ok 60 /bin/bash -lc "[[ \$(docker ps -q | wc -l) -eq 41 ]]" || return 1
  guest_exec_ok 60 /bin/bash -lc "[[ -z \$(docker ps --filter health=unhealthy -q) ]]" || return 1
  guest_exec_ok 60 /bin/bash -lc "docker inspect \$(docker ps -aq) | jq -e '[.[].Mounts[] | select(.Type == \"volume\")] | length == 0' >/dev/null" || return 1
  guest_exec_ok 60 /bin/bash -lc "docker inspect \$(docker ps -aq) | jq -e '[.[].Mounts[] | select(.Type == \"bind\" and (.Source | startswith(\"/srv/home-lab-state/\")))] | length == 115' >/dev/null" || return 1
  guest_exec_ok 30 /bin/bash -lc "source=\$(findmnt -rn -o SOURCE -T /srv/home-lab-state); [[ \$(blkid -s UUID -o value \"\$source\") == d4a19647-7879-4079-9fc9-b3e79711b449 ]]" || return 1
}

verify_exact_arch_configuration() {
  local pending=$1 current=$2 config key
  for config in "$pending" "$current"; do
    [[ $(config_value "$config" boot) == "$ARCH_BOOT" ]] || return 1
    [[ $(config_value "$config" scsi0) == "$EFFECTIVE_SCSI0" ]] || return 1
    [[ $(config_value "$config" scsi1) == "$EFFECTIVE_SCSI1" ]] || return 1
    [[ $(config_value "$config" scsi2) == "$EFFECTIVE_SCSI2" ]] || return 1
    [[ $(config_value "$config" scsi3) == "$DEBIAN_SCSI3" ]] || return 1
    [[ $(config_value "$config" ide2) == "$EFFECTIVE_IDE2" ]] || return 1
    [[ $(config_value "$config" cicustom) == "$CURRENT_CICUSTOM" ]] || return 1
    [[ $(config_value "$config" hostpci1) == "$EFFECTIVE_HOSTPCI1" ]] || return 1
    [[ $(config_value "$config" hostpci2) == "$EFFECTIVE_HOSTPCI2" ]] || return 1
    [[ $(config_value "$config" usb0) == "$EFFECTIVE_USB0" ]] || return 1
    [[ $(config_value "$config" usb1) == "$EFFECTIVE_USB1" ]] || return 1
    [[ $(config_value "$config" usb2) == "$EFFECTIVE_USB2" ]] || return 1
    [[ $(config_value "$config" onboot) == 1 ]] || return 1
    [[ $(config_value "$config" protection) == 1 ]] || return 1
    [[ $(config_value "$config" vga) == none ]] || return 1
    ! config_value "$config" lock >/dev/null 2>&1 || return 1
    ! grep -Eq '^unused[0-9]+:' "$config" || return 1
  done
  for key in boot scsi0 scsi1 scsi2 scsi3 ide2 cicustom hostpci1 hostpci2 usb0 usb1 usb2 onboot protection vga; do
    [[ $(config_value "$pending" "$key") == $(config_value "$current" "$key") ]] || return 1
  done
  return 0
}

arch_config_sha256() {
  grep -E '^(boot|cicustom|hostpci1|hostpci2|ide2|onboot|protection|scsi0|scsi1|scsi2|scsi3|usb0|usb1|usb2|vga): ' "$1" \
    | LC_ALL=C sort | sha256sum | awk '{print $1}'
}

write_package_pending_evidence() {
  local marker=$1 host_boot_id temporary
  host_boot_id=$(cat /proc/sys/kernel/random/boot_id)
  temporary=$(mktemp --tmpdir="$DIAGNOSTIC_ROOT" .packages-prepared-pending.XXXXXX)
  jq -c --arg archBoot "$ARCH_BOOT" --arg candidateScsi3 "$DEBIAN_SCSI3" \
    --arg createdAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg hostBootIdBefore "$host_boot_id" \
    --arg sourceCommit "$(git rev-parse HEAD)" \
    '. + {archBoot:$archBoot,candidateScsi3:$candidateScsi3,createdAt:$createdAt,evidenceFormat:"home-lab-debian-package-transition-v1",hostBootIdBefore:$hostBootIdBefore,sourceCommit:$sourceCommit,state:"package-verified",vmid:100}' \
    <<< "$marker" > "$temporary"
  chmod 0600 "$temporary"
  chown root:root "$temporary"
  mv -T "$temporary" "$PREPARE_PENDING_LOG"
}

mark_package_evidence_awaiting_reboot() {
  local config_sha=$1 temporary
  temporary=$(mktemp --tmpdir="$DIAGNOSTIC_ROOT" .packages-prepared-pending.XXXXXX)
  jq -c --arg archConfigSha256 "$config_sha" '. + {archConfigSha256:$archConfigSha256,state:"awaiting-host-reboot"}' \
    "$PREPARE_PENDING_LOG" > "$temporary"
  chmod 0600 "$temporary"
  chown root:root "$temporary"
  mv -T "$temporary" "$PREPARE_PENDING_LOG"
}

prepare_arch_host_reboot_path() {
  local pending current
  if [[ $(vm_status) != stopped ]]; then
    stage=shutdown-debian-for-host-reboot
    qm guest cmd "$VMID" shutdown >/dev/null 2>&1 || qm shutdown "$VMID" --timeout 60 || true
    if ! wait_for_status stopped 180; then
      stage=force-stop-debian-for-host-reboot
      qm stop "$VMID" || return 1
      wait_for_status stopped 30 || return 1
    fi
  fi
  stage=prepare-arch-host-reboot
  prepare_arch_restore || return 1
  qm set "$VMID" --boot "$ARCH_BOOT" --vga none || return 1
  pending=$(mktemp --tmpdir=/run home-lab-arch-reboot-pending.XXXXXX)
  current=$(mktemp --tmpdir=/run home-lab-arch-reboot-current.XXXXXX)
  chmod 0600 "$pending" "$current"
  qm config "$VMID" > "$pending"
  qm config "$VMID" --current 1 > "$current"
  if ! verify_exact_arch_configuration "$pending" "$current"; then
    rm -f -- "$pending" "$current"
    return 1
  fi
  arch_reboot_config_sha=$(arch_config_sha256 "$pending")
  rm -f -- "$pending" "$current"
  return 0
}

wait_for_ping() {
  local timeout_seconds=$1
  for ((second = 0; second < timeout_seconds; second += 3)); do
    ping -c 1 -W 2 "$CANDIDATE_IP" >/dev/null 2>&1 && return 0
    sleep 3
  done
  return 1
}

ssh_port_reachable() {
  timeout 3 bash -c "exec 3<>/dev/tcp/$CANDIDATE_IP/22" >/dev/null 2>&1
}

wait_for_ssh_port() {
  local timeout_seconds=$1
  for ((second = 0; second < timeout_seconds; second += 3)); do
    ssh_port_reachable && return 0
    sleep 3
  done
  return 1
}

candidate_diagnostics() {
  local ping_state=unreachable ssh_state=unreachable agent_state=unavailable console_sha=empty
  ping -c 1 -W 2 "$CANDIDATE_IP" >/dev/null 2>&1 && ping_state=reachable
  ssh_port_reachable && ssh_state=reachable
  qm guest cmd "$VMID" ping >/dev/null 2>&1 && agent_state=ready
  if [[ -s $CONSOLE_LOG ]]; then
    console_sha=$(sha256sum "$CONSOLE_LOG" | awk '{print $1}')
  fi
  write_diagnostic_json "$ATTEMPT_LOG" candidate-failed "$stage" "$ping_state" "$ssh_state" "$agent_state" "$console_sha"
  printf 'Debian diagnostics: stage=%s ping=%s ssh=%s agent=%s console_log=%s console_sha256=%s\n' \
    "$stage" "$ping_state" "$ssh_state" "$agent_state" "$CONSOLE_LOG" "$console_sha" >&2
  if [[ -s $CONSOLE_LOG ]]; then
    grep -Eai 'cloud-init|failed|failure|error|emergency|dependency|firmware|amdgpu' "$CONSOLE_LOG" | tail -60 >&2 || true
  fi
}

[[ $# -eq 0 ]] || { fail "usage: scripts/qualify-debian-inert"; exit 1; }
[[ $(id -u) -eq 0 ]] || { fail "Debian qualification requires root"; exit 1; }
restore_mode=false
prepare_mode=false
finalize_mode=false
case ${HOME_LAB_DEBIAN_QUALIFICATION_CONFIRMED:-} in
  "$CONFIRMATION") ;;
  "$RESTORE_CONFIRMATION") restore_mode=true ;;
  "$PREPARE_CONFIRMATION") prepare_mode=true ;;
  "$FINALIZE_CONFIRMATION") finalize_mode=true ;;
  *) fail "exact Debian qualification, package preparation, package finalization, or Arch restore confirmation is required"; exit 1 ;;
esac
[[ $(ps -o tty= -p "$$" | tr -d ' ') =~ ^tty[0-9]+$ ]] || { fail "Debian qualification requires a physical Proxmox console"; exit 1; }
[[ -d $RECONCILIATION_ROOT && ! -L $RECONCILIATION_ROOT ]] || { fail "reconciliation lock root is absent or unsafe"; exit 1; }
[[ ! -e $RECONCILIATION_ROOT/apply.lock ]] || { fail "a protected Proxmox apply is active"; exit 1; }
[[ ! -e /var/lib/iac-ansible-production.lock ]] || { fail "Ansible host ownership is active"; exit 1; }
locks_held=false
acquire_transition_locks || { fail "another protected Proxmox operation holds a transition lock"; exit 1; }

[[ $(git branch --show-current) == main ]] || { fail "repository is not on main"; exit 1; }
[[ -z $(git status --porcelain) ]] || { fail "repository is not clean"; exit 1; }
if [[ $restore_mode == true ]]; then
  git fetch --quiet origin "+refs/heads/main:refs/remotes/origin/main"
else
  verify_plan_attestation || { fail "fresh zero-action controller plan attestation is unavailable"; exit 1; }
fi
[[ $(git rev-parse HEAD) == $(git rev-parse origin/main) ]] || { fail "repository is not at origin/main"; exit 1; }
[[ $(vm_status) == running ]] || { fail "VM 100 is not running"; exit 1; }
if [[ $finalize_mode == true ]]; then
  [[ -f $PREPARE_PENDING_LOG && ! -L $PREPARE_PENDING_LOG ]] || { fail "pending package evidence is absent or unsafe"; exit 1; }
  [[ $(stat -c %U:%G:%a "$PREPARE_PENDING_LOG") == root:root:600 ]] || { fail "pending package evidence metadata differs"; exit 1; }
  [[ ! -e $PREPARE_LOG && ! -L $PREPARE_LOG ]] || { fail "final package evidence already exists or is unsafe"; exit 1; }
  pending_evidence=$(cat "$PREPARE_PENDING_LOG")
  jq -e --arg archBoot "$ARCH_BOOT" --arg candidateScsi3 "$DEBIAN_SCSI3" --arg sourceCommit "$(git rev-parse HEAD)" '
    .evidenceFormat == "home-lab-debian-package-transition-v1" and
    .format == "home-lab-debian-packages-prepared-v1" and
    .state == "awaiting-host-reboot" and .services == "disabled-inactive" and .vmid == 100 and
    .archBoot == $archBoot and .candidateScsi3 == $candidateScsi3 and .sourceCommit == $sourceCommit and
    (.hostBootIdBefore | test("^[0-9a-f-]{36}$")) and (.archConfigSha256 | test("^[0-9a-f]{64}$")) and
    (.dockerPackageVersion | length > 0) and (.composePackageVersion | length > 0) and (.composeVersion | length > 0)
  ' <<< "$pending_evidence" >/dev/null || { fail "pending package evidence differs"; exit 1; }
  created_epoch=$(date -d "$(jq -er .createdAt <<< "$pending_evidence")" +%s)
  now_epoch=$(date +%s)
  evidence_age=$((now_epoch - created_epoch))
  [[ $evidence_age -ge -300 && $evidence_age -le 86400 ]] || { fail "pending package evidence is stale or future-dated"; exit 1; }
  host_boot_id_after=$(cat /proc/sys/kernel/random/boot_id)
  [[ $host_boot_id_after != $(jq -er .hostBootIdBefore <<< "$pending_evidence") ]] || { fail "the required physical host reboot has not occurred"; exit 1; }
  finalize_pending=$(mktemp --tmpdir=/run home-lab-debian-finalize-pending.XXXXXX)
  finalize_current=$(mktemp --tmpdir=/run home-lab-debian-finalize-current.XXXXXX)
  finalize_evidence=$(mktemp --tmpdir="$DIAGNOSTIC_ROOT" .packages-prepared-final.XXXXXX)
  trap 'rm -f -- "$finalize_pending" "$finalize_current" "$finalize_evidence"' EXIT
  chmod 0600 "$finalize_pending" "$finalize_current" "$finalize_evidence"
  qm config "$VMID" > "$finalize_pending"
  qm config "$VMID" --current 1 > "$finalize_current"
  verify_exact_arch_configuration "$finalize_pending" "$finalize_current" || { fail "post-reboot Arch configuration differs"; exit 1; }
  [[ $(arch_config_sha256 "$finalize_pending") == $(jq -er .archConfigSha256 <<< "$pending_evidence") ]] || { fail "post-reboot Arch configuration digest differs"; exit 1; }
  wait_for_agent 600 || { fail "post-reboot Arch QEMU guest agent is unavailable"; exit 1; }
  [[ $(os_id) == arch ]] || { fail "post-reboot VM 100 is not Arch"; exit 1; }
  verify_arch_post_restore || { fail "post-reboot Arch workload health differs"; exit 1; }
  [[ $(systemctl --failed --no-legend | wc -l) -eq 0 ]] || { fail "the Proxmox host has failed units"; exit 1; }
  [[ $(systemctl is-active pve-firewall) == active && $(systemctl is-active proxmox-firewall) == active ]] || { fail "Proxmox firewall services are inactive"; exit 1; }
  pve-firewall status | grep -Fxq 'Status: enabled/running' || { fail "Proxmox firewall status differs"; exit 1; }
  jq -c --arg completedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg hostBootIdAfter "$host_boot_id_after" \
    '. + {archRestore:"verified",completedAt:$completedAt,hostBootIdAfter:$hostBootIdAfter,state:"complete"}' \
    <<< "$pending_evidence" > "$finalize_evidence"
  chown root:root "$finalize_evidence"
  chmod 0600 "$finalize_evidence"
  mv -T "$finalize_evidence" "$PREPARE_LOG"
  rm -f -- "$PREPARE_PENDING_LOG"
  write_diagnostic_json "$RESTORE_LOG" arch-restored complete reachable reachable ready empty
  trap - EXIT
  rm -f -- "$finalize_pending" "$finalize_current"
  echo "Debian package preparation finalized after physical reboot and complete Arch verification" >&2
  exit 0
fi
if [[ $restore_mode == true ]]; then
  wait_for_agent 30 || { fail "Debian QEMU guest agent is unavailable"; exit 1; }
  [[ $(os_id) == debian ]] || { fail "VM 100 is not running inert Debian"; exit 1; }
  restore_pending=$(mktemp --tmpdir=/run home-lab-debian-restore-pending.XXXXXX)
  restore_current=$(mktemp --tmpdir=/run home-lab-debian-restore-current.XXXXXX)
  trap 'rm -f -- "$restore_pending" "$restore_current"' EXIT
  chmod 0600 "$restore_pending" "$restore_current"
  qm config "$VMID" > "$restore_pending"
  qm config "$VMID" --current 1 > "$restore_current"
  for config in "$restore_pending" "$restore_current"; do
    [[ $(config_value "$config" boot) == "$DEBIAN_BOOT" ]] || { fail "Debian boot order differs"; exit 1; }
    [[ $(config_value "$config" scsi0) == "$EFFECTIVE_SCSI0" ]] || { fail "effective scsi0 differs"; exit 1; }
    [[ $(config_value "$config" scsi1) == "$EFFECTIVE_SCSI1" ]] || { fail "effective scsi1 differs"; exit 1; }
    [[ $(config_value "$config" scsi2) == "$EFFECTIVE_SCSI2" ]] || { fail "effective scsi2 differs"; exit 1; }
    [[ $(config_value "$config" scsi3) == "$DEBIAN_SCSI3" ]] || { fail "effective scsi3 differs"; exit 1; }
    [[ $(config_value "$config" ide2) == "$EFFECTIVE_IDE2" ]] || { fail "effective ide2 differs"; exit 1; }
    [[ $(config_value "$config" cicustom) == "$DEBIAN_CICUSTOM" ]] || { fail "effective Debian cicustom differs"; exit 1; }
    [[ $(config_value "$config" vga) == none ]] || { fail "VM 100 VGA configuration differs"; exit 1; }
  done
  [[ $(config_value "$restore_pending" protection) == 1 ]] || { fail "VM 100 protection differs"; exit 1; }
  ! config_value "$restore_pending" lock >/dev/null 2>&1 || { fail "VM 100 has an active Proxmox configuration lock"; exit 1; }
  ! grep -Eq '^unused[0-9]+:' "$restore_pending" || { fail "an unused disk requires reconciliation"; exit 1; }
  install -d -o root -g root -m 0700 "$DIAGNOSTIC_ROOT"
  restore_arch
  exit 0
fi
wait_for_agent 30 || { fail "Arch QEMU guest agent is unavailable"; exit 1; }
[[ $(os_id) == arch ]] || { fail "VM 100 is not running Arch"; exit 1; }
verify_arch_post_restore || { fail "Arch workload health differs"; exit 1; }

