  jq -c --arg archConfigSha256 "$config_sha" '. + {archConfigSha256:$archConfigSha256,attemptOutcome:"failed",transitionState:"failed-awaiting-host-reboot"}' "$PRODUCTION_PENDING_LOG" > "$temporary"
  chmod 0600 "$temporary"
  chown root:root "$temporary"
  mv -T "$temporary" "$PRODUCTION_PENDING_LOG"
}

capture_failed_production_activation() {
  local response activation temporary
  [[ -f $PRODUCTION_PENDING_LOG && $(vm_status) == running ]] || return 0
  response=$(guest_exec_json 30 /bin/bash -lc 'for file in /var/lib/home-lab/debian-production-failed.json /var/lib/home-lab/debian-production-activation.json; do if [[ -f $file && ! -L $file ]]; then cat "$file"; exit 0; fi; done; exit 1') || return 0
  activation=$(jq -er '."out-data" | fromjson' <<< "$response") || return 0
  temporary=$(mktemp --tmpdir="$DIAGNOSTIC_ROOT" .production-pending.XXXXXX)
  jq -c --argjson activation "$activation" '. + {activationJournal:$activation}' "$PRODUCTION_PENDING_LOG" > "$temporary" || { rm -f -- "$temporary"; return 0; }
  chmod 0600 "$temporary"
  chown root:root "$temporary"
  mv -T "$temporary" "$PRODUCTION_PENDING_LOG"
}

prepare_arch_host_reboot_path() {
  local pending current
  if [[ $(vm_status) != stopped ]]; then
    stage=shutdown-debian-for-host-reboot
    timeout 15 qm guest cmd "$VMID" shutdown >/dev/null 2>&1 || timeout 75 qm shutdown "$VMID" --timeout 60 || true
    if ! wait_for_status stopped 30; then
      stage=force-stop-debian-for-host-reboot
      qm stop "$VMID" || return 1
      wait_for_status stopped 30 || return 1
    fi
  fi
  stage=prepare-arch-host-reboot
  prepare_arch_restore || return 1
  qm set "$VMID" --boot "$ARCH_BOOT" --vga none || return 1
  pending=$(mktemp --tmpdir=/run home-lab-arch-reboot-pending.XXXXXX)
  current=$(mktemp --tmpdir=/run home-lab-arch-reboot-current.XXXXXX)
  chmod 0600 "$pending" "$current"
  qm config "$VMID" > "$pending"
  qm config "$VMID" --current 1 > "$current"
  if ! verify_exact_arch_configuration "$pending" "$current"; then
    rm -f -- "$pending" "$current"
    return 1
  fi
  arch_reboot_config_sha=$(arch_config_sha256 "$pending")
  rm -f -- "$pending" "$current"
  return 0
}

wait_for_ping() {
  local timeout_seconds=$1
  for ((second = 0; second < timeout_seconds; second += 3)); do
    ping -c 1 -W 2 "$CANDIDATE_IP" >/dev/null 2>&1 && return 0
    sleep 3
  done
  return 1
}

ssh_port_reachable() {
  timeout 3 bash -c "exec 3<>/dev/tcp/$CANDIDATE_IP/22" >/dev/null 2>&1
}

wait_for_ssh_port() {
  local timeout_seconds=$1
  for ((second = 0; second < timeout_seconds; second += 3)); do
    ssh_port_reachable && return 0
    sleep 3
  done
  return 1
}

candidate_diagnostics() {
  local ping_state=unreachable ssh_state=unreachable agent_state=unavailable console_sha=empty
  ping -c 1 -W 2 "$CANDIDATE_IP" >/dev/null 2>&1 && ping_state=reachable
  ssh_port_reachable && ssh_state=reachable
  qm guest cmd "$VMID" ping >/dev/null 2>&1 && agent_state=ready
  if [[ -s $CONSOLE_LOG ]]; then
    console_sha=$(sha256sum "$CONSOLE_LOG" | awk '{print $1}')
  fi
  write_diagnostic_json "$ATTEMPT_LOG" candidate-failed "$stage" "$ping_state" "$ssh_state" "$agent_state" "$console_sha"
  printf 'Debian diagnostics: stage=%s ping=%s ssh=%s agent=%s console_log=%s console_sha256=%s\n' \
    "$stage" "$ping_state" "$ssh_state" "$agent_state" "$CONSOLE_LOG" "$console_sha" >&2
  if [[ -s $CONSOLE_LOG ]]; then
    grep -Eai 'cloud-init|failed|failure|error|emergency|dependency|firmware|amdgpu' "$CONSOLE_LOG" | tail -60 >&2 || true
  fi
}

[[ $# -eq 0 ]] || { fail "usage: scripts/qualify-debian-inert"; exit 1; }
[[ $(id -u) -eq 0 ]] || { fail "Debian qualification requires root"; exit 1; }
restore_mode=false
prepare_mode=false
finalize_mode=false
rehearsal_mode=false
finalize_rehearsal_mode=false
identity_mode=false
finalize_identity_mode=false
credentials_mode=false
finalize_credentials_mode=false
canary_mode=false
finalize_canary_mode=false
promote_canary_mode=false
production_mode=false
finalize_production_mode=false
case ${HOME_LAB_DEBIAN_QUALIFICATION_CONFIRMED:-} in
  "$CONFIRMATION") ;;
  "$RESTORE_CONFIRMATION") restore_mode=true ;;
  "$PREPARE_CONFIRMATION") prepare_mode=true ;;
  "$FINALIZE_CONFIRMATION") finalize_mode=true ;;
  "$REHEARSAL_CONFIRMATION") rehearsal_mode=true ;;
  "$FINALIZE_REHEARSAL_CONFIRMATION") finalize_rehearsal_mode=true ;;
  "$IDENTITY_CONFIRMATION") identity_mode=true ;;
  "$FINALIZE_IDENTITY_CONFIRMATION") finalize_identity_mode=true ;;
  "$CREDENTIALS_CONFIRMATION") credentials_mode=true ;;
  "$FINALIZE_CREDENTIALS_CONFIRMATION") finalize_credentials_mode=true ;;
  "$CANARY_CONFIRMATION") canary_mode=true ;;
  "$FINALIZE_CANARY_CONFIRMATION") finalize_canary_mode=true ;;
  "$PROMOTE_CANARY_CONFIRMATION") promote_canary_mode=true ;;
  "$PRODUCTION_CONFIRMATION") production_mode=true ;;
  "$FINALIZE_PRODUCTION_CONFIRMATION") finalize_production_mode=true ;;
  *) fail "exact Debian qualification or staged transition confirmation is required"; exit 1 ;;
esac
[[ $(ps -o tty= -p "$$" | tr -d ' ') =~ ^tty[0-9]+$ ]] || { fail "Debian qualification requires a physical Proxmox console"; exit 1; }
[[ -d $RECONCILIATION_ROOT && ! -L $RECONCILIATION_ROOT ]] || { fail "reconciliation lock root is absent or unsafe"; exit 1; }
[[ ! -e $RECONCILIATION_ROOT/apply.lock ]] || { fail "a protected Proxmox apply is active"; exit 1; }
[[ ! -e /var/lib/iac-ansible-production.lock ]] || { fail "Ansible host ownership is active"; exit 1; }
locks_held=false
acquire_transition_locks || { fail "another protected Proxmox operation holds a transition lock"; exit 1; }

[[ $(git branch --show-current) == main ]] || { fail "repository is not on main"; exit 1; }
[[ -z $(git status --porcelain) ]] || { fail "repository is not clean"; exit 1; }
if [[ $restore_mode == true ]]; then
  git fetch --quiet origin "+refs/heads/main:refs/remotes/origin/main"
else
  verify_plan_attestation || { fail "fresh zero-action controller plan attestation is unavailable"; exit 1; }
fi
[[ $(git rev-parse HEAD) == $(git rev-parse origin/main) ]] || { fail "repository is not at origin/main"; exit 1; }
[[ $(vm_status) == running ]] || { fail "VM 100 is not running"; exit 1; }
if [[ $finalize_production_mode == true ]]; then
  [[ -f $PRODUCTION_PENDING_LOG && ! -L $PRODUCTION_PENDING_LOG && $(stat -c %U:%G:%a "$PRODUCTION_PENDING_LOG") == root:root:600 ]] || { fail "pending production evidence is absent or unsafe"; exit 1; }
  [[ ! -e $PRODUCTION_LOG && ! -L $PRODUCTION_LOG ]] || { fail "final production evidence already exists or is unsafe"; exit 1; }
  pending_evidence=$(cat "$PRODUCTION_PENDING_LOG")
  pending_source_commit=$(jq -er '.sourceCommit | select(test("^[0-9a-f]{40}$"))' <<< "$pending_evidence") || { fail "pending production source commit differs"; exit 1; }
  git cat-file -e "$pending_source_commit^{commit}" || { fail "pending production source commit is unavailable"; exit 1; }
  git merge-base --is-ancestor "$pending_source_commit" HEAD || { fail "pending production source commit is not an ancestor of recovery HEAD"; exit 1; }
  jq -e '.evidenceFormat == "home-lab-debian-production-transition-v1" and .vmid == 100 and .archBoot == "order=scsi0;net0" and .candidateScsi3 == "local-lvm:vm-100-disk-2,backup=1,cache=none,discard=ignore,iothread=1,replicate=1,serial=HOME-LAB-DEBIAN-64G,size=64G,ssd=0" and (.hostBootIdBefore | test("^[0-9a-f-]{36}$"))' <<< "$pending_evidence" >/dev/null || { fail "pending production transition evidence differs"; exit 1; }
  host_boot_id_after=$(cat /proc/sys/kernel/random/boot_id)
  [[ $host_boot_id_after != $(jq -er .hostBootIdBefore <<< "$pending_evidence") ]] || { fail "the required physical host reboot has not occurred"; exit 1; }
  finalize_pending=$(mktemp --tmpdir=/run home-lab-production-finalize-pending.XXXXXX)
  finalize_current=$(mktemp --tmpdir=/run home-lab-production-finalize-current.XXXXXX)
  finalize_evidence=$(mktemp --tmpdir="$DIAGNOSTIC_ROOT" .production-final.XXXXXX)
  trap 'rm -f -- "$finalize_pending" "$finalize_current" "$finalize_evidence"' EXIT
  chmod 0600 "$finalize_pending" "$finalize_current" "$finalize_evidence"
  qm config "$VMID" > "$finalize_pending"
  qm config "$VMID" --current 1 > "$finalize_current"
  if jq -e '.transitionState == "transfer-prepared"' <<< "$pending_evidence" >/dev/null 2>&1; then
    wait_for_agent 120 || { fail "crash-reconciliation guest agent is unavailable"; exit 1; }
    crash_os=$(os_id)
    if [[ $crash_os == debian ]]; then
      production_marker_response=$(guest_exec_json 30 /bin/bash -lc 'set -e; jq -e '\''.format == "home-lab-debian-production-v1"'\'' /var/lib/home-lab/debian-production.json >/dev/null; jq -e '\''.format == "home-lab-debian-production-activation-v1" and .phase == "committed"'\'' /var/lib/home-lab/debian-production-activation.json >/dev/null; cat /var/lib/home-lab/debian-production.json' || true)
      if production_marker=$(jq -er '."out-data" | fromjson' <<< "$production_marker_response" 2>/dev/null); then
        write_production_pending_evidence "$production_marker"
        mark_production_evidence_awaiting_reboot "$(arch_config_sha256 "$finalize_pending")"
        pending_evidence=$(cat "$PRODUCTION_PENDING_LOG")
      else
        capture_failed_production_activation || true
        prepare_arch_host_reboot_path || { fail "crash-reconciliation Arch reboot preparation failed"; exit 1; }
        mark_failed_production_evidence_awaiting_reboot "$arch_reboot_config_sha"
        trap - EXIT
        rm -f -- "$finalize_pending" "$finalize_current" "$finalize_evidence"
        echo "Incomplete Debian production activation was fail-closed; perform another physical host reboot, then rerun this finalizer" >&2
        exit 0
      fi
    elif [[ $crash_os == arch ]]; then
      verify_exact_arch_configuration "$finalize_pending" "$finalize_current" || { fail "crash-reconciliation Arch configuration differs"; exit 1; }
      verify_arch_post_restore || { fail "crash-reconciliation Arch workloads differ"; exit 1; }
      guest_exec_ok 30 /bin/rm -f /srv/home-lab-state/.debian-production-images.tar /srv/home-lab-state/.debian-production-images.json /srv/home-lab-state/.debian-tailscale-1.98.4-amd64.tgz || { fail "crash-reconciliation transfer cleanup failed"; exit 1; }
      jq -c --arg hostBootIdAfter "$host_boot_id_after" --arg recoveredAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '. + {archRestore:"verified",attemptOutcome:"interrupted",hostBootIdAfter:$hostBootIdAfter,recoveredAt:$recoveredAt,transitionState:"aborted"}' <<< "$pending_evidence" > "$finalize_evidence"
      chown root:root "$finalize_evidence"
      chmod 0600 "$finalize_evidence"
      mv -T "$finalize_evidence" "$PRODUCTION_ABORTED_LOG"
      rm -f -- "$PRODUCTION_PENDING_LOG"
      trap - EXIT
      rm -f -- "$finalize_pending" "$finalize_current"
      echo "Interrupted production preparation recovered on Arch; production remains on Arch" >&2
      exit 0
    else
      fail "crash-reconciliation guest identity differs"
      exit 1
    fi
  fi
  if jq -e '.transitionState == "failed-awaiting-host-reboot" and .attemptOutcome == "failed"' <<< "$pending_evidence" >/dev/null 2>&1; then
    verify_exact_arch_configuration "$finalize_pending" "$finalize_current" || { fail "failed production recovery Arch configuration differs"; exit 1; }
    [[ $(arch_config_sha256 "$finalize_pending") == $(jq -er .archConfigSha256 <<< "$pending_evidence") ]] || { fail "failed production recovery configuration digest differs"; exit 1; }
    wait_for_agent 600 || { fail "failed production recovery Arch agent is unavailable"; exit 1; }
    [[ $(os_id) == arch ]] || { fail "failed production recovery guest is not Arch"; exit 1; }
    verify_arch_post_restore || { fail "failed production recovery Arch workloads differ"; exit 1; }
    guest_exec_ok 30 /bin/rm -f /srv/home-lab-state/.debian-production-images.tar /srv/home-lab-state/.debian-production-images.json /srv/home-lab-state/.debian-tailscale-1.98.4-amd64.tgz || { fail "failed production transfer cleanup failed"; exit 1; }
    [[ $(systemctl --failed --no-legend | wc -l) -eq 0 ]] || { fail "the Proxmox host has failed units"; exit 1; }
    pve-firewall status | grep -Fxq 'Status: enabled/running' || { fail "Proxmox firewall status differs"; exit 1; }
    jq -c --arg hostBootIdAfter "$host_boot_id_after" --arg recoveredAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '. + {archRestore:"verified",hostBootIdAfter:$hostBootIdAfter,recoveredAt:$recoveredAt,transitionState:"aborted"}' <<< "$pending_evidence" > "$finalize_evidence"
    chown root:root "$finalize_evidence"
    chmod 0600 "$finalize_evidence"
    mv -T "$finalize_evidence" "$PRODUCTION_ABORTED_LOG"
    rm -f -- "$PRODUCTION_PENDING_LOG"
    trap - EXIT
    rm -f -- "$finalize_pending" "$finalize_current"
    echo "Failed Debian production attempt recovered after physical reboot; production remains on Arch" >&2
    failed_tailscale_node=$(jq -r '.activationJournal.tailscale.nodeId // empty' <<< "$pending_evidence")
    if [[ -n $failed_tailscale_node ]]; then echo "Revoke stale Tailscale node from the controller: scripts/controller/revoke-debian-production-tailscale-device.py --device-id $failed_tailscale_node" >&2; else echo "If Tailscale partially enrolled, delete it from the controller: scripts/controller/revoke-debian-production-tailscale-device.py" >&2; fi
    exit 0
  fi
  jq -e --arg sourceCommit "$(git rev-parse HEAD)" '.format == "home-lab-debian-production-v1" and .evidenceFormat == "home-lab-debian-production-transition-v1" and .sourceCommit == $sourceCommit and .transitionState == "awaiting-host-reboot" and .containerCount == 41 and .unhealthyContainerCount == 0 and .stateBindCount == 115 and .dockerVolumeMountCount == 0 and .dockerRuntime == "enabled-active" and .gpuRuntimePmNextBoot == "disabled" and .protectedMounts == "enabled-mounted-rw" and .pulls == "disabled" and .runtimeEnvironmentInstalled == true and .tailscale.enrolled == true and .tailscale.hostname == "docker-host-debian" and .tailscale.tag == "tag:docker-host"' <<< "$pending_evidence" >/dev/null || { fail "pending production evidence differs"; exit 1; }
  for config in "$finalize_pending" "$finalize_current"; do
    [[ $(config_value "$config" boot) == "$DEBIAN_BOOT" && $(config_value "$config" scsi0) == "$EFFECTIVE_SCSI0" && $(config_value "$config" scsi1) == "$EFFECTIVE_SCSI1" && $(config_value "$config" scsi2) == "$EFFECTIVE_SCSI2" && $(config_value "$config" scsi3) == "$DEBIAN_SCSI3" && $(config_value "$config" cicustom) == "$DEBIAN_CICUSTOM" && $(config_value "$config" vga) == none ]] || { fail "persistent Debian production configuration differs"; exit 1; }
  done
  [[ $(arch_config_sha256 "$finalize_pending") == $(jq -er .configSha256 <<< "$pending_evidence") ]] || { fail "persistent Debian production configuration digest differs"; exit 1; }
  wait_for_agent 600 || { fail "post-reboot Debian production agent is unavailable"; exit 1; }
  [[ $(os_id) == debian ]] || { fail "post-reboot production guest is not Debian"; exit 1; }
  production_marker=$(guest_exec_json 30 /usr/bin/cat /var/lib/home-lab/debian-production.json | jq -er '."out-data"')
  [[ $(jq -cS '. | del(.archBoot,.candidateScsi3,.createdAt,.evidenceFormat,.hostBootIdBefore,.sourceCommit,.transitionState,.vmid,.configSha256)' <<< "$pending_evidence") == $(jq -cS . <<< "$production_marker") ]] || { fail "post-reboot Debian production marker differs"; exit 1; }
  fail_post_reboot_production_to_arch() {
    local reason=$1 rejection_script
    read -r -d '' rejection_script <<'GUEST' || true
set -Eeuo pipefail
journal=/var/lib/home-lab/debian-production-activation.json
output=/var/lib/home-lab/debian-production.json
failed=/var/lib/home-lab/debian-production-failed.json
[[ -f $journal && ! -L $journal && -f $output && ! -L $output && ! -e $failed && ! -L $failed ]]
jq -e '.format == "home-lab-debian-production-activation-v1" and .phase == "committed"' "$journal" >/dev/null
jq -e '.format == "home-lab-debian-production-v1" and .containerCount == 41 and .unhealthyContainerCount == 0' "$output" >/dev/null
temporary=$(mktemp /var/lib/home-lab/.debian-production-failed.XXXXXX)
trap 'rm -f -- "$temporary"' EXIT
jq -c --arg failedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '. + {failedAt:$failedAt,phase:"failed",rejection:"post-reboot-health"}' "$journal" > "$temporary"
chown root:root "$temporary"
chmod 0600 "$temporary"
mv -T "$temporary" "$failed"
rm -f -- "$output"
GUEST
    guest_exec_ok 30 /bin/bash -lc "$rejection_script" || { fail "$reason; committed candidate rejection journaling failed"; exit 1; }
    guest_exec_ok 30 /bin/rm -f /run/home-lab-finalize-production-health || true
    capture_failed_production_activation || true
    prepare_arch_host_reboot_path || { fail "$reason; Arch reboot preparation failed"; exit 1; }
    mark_failed_production_evidence_awaiting_reboot "$arch_reboot_config_sha"
    trap - EXIT
    rm -f -- "$finalize_pending" "$finalize_current" "$finalize_evidence"
    echo "$reason; failed closed to Arch boot authority. Physically reboot the host, then rerun this finalizer" >&2
    exit 0
  }
  finalize_health_source=infrastructure/debian/finalize-production-health.sh
  finalize_health_sha=5f72397f8a02b098bf69b46eeb842c905bb10df40eb2b74da3985f1458f494ca
  [[ $(sha256sum "$finalize_health_source" | awk '{print $1}') == "$finalize_health_sha" ]] || fail_post_reboot_production_to_arch "post-reboot production health helper differs"
  finalize_health_payload=$(base64 -w 0 "$finalize_health_source")
  guest_exec_ok 60 /bin/bash -lc "set -Eeuo pipefail; umask 077; printf %s '$finalize_health_payload' | base64 -d > /run/home-lab-finalize-production-health; [[ \$(sha256sum /run/home-lab-finalize-production-health | awk '{print \$1}') == '$finalize_health_sha' ]]" || fail_post_reboot_production_to_arch "post-reboot production health helper staging failed"
  stage=verify-post-reboot-debian-production-health
  guest_exec_ok 3300 /usr/bin/timeout --kill-after=10 3000 /bin/bash /run/home-lab-finalize-production-health || fail_post_reboot_production_to_arch "post-reboot Debian production health differs"
  guest_exec_ok 30 /bin/rm -f /run/home-lab-finalize-production-health || fail_post_reboot_production_to_arch "post-reboot production health helper cleanup failed"
  [[ $(systemctl --failed --no-legend | wc -l) -eq 0 ]] || fail_post_reboot_production_to_arch "the Proxmox host has failed units"
  pve-firewall status | grep -Fxq 'Status: enabled/running' || fail_post_reboot_production_to_arch "Proxmox firewall status differs"
  jq -c --arg finalizedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg hostBootIdAfter "$host_boot_id_after" '. + {finalizedAt:$finalizedAt,hostBootIdAfter:$hostBootIdAfter,transitionState:"complete"}' <<< "$pending_evidence" > "$finalize_evidence"
