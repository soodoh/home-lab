#!/bin/bash
set -euo pipefail

readonly CONFIRMATION=run-reviewed-vm-100-debian-openfit-canary

[[ $# -eq 0 ]] || { echo "usage: scripts/run-debian-production-canary" >&2; exit 1; }
[[ -t 0 ]] || { echo "Debian production canary requires an interactive physical console" >&2; exit 1; }
printf 'Type the exact confirmation to create a fresh encrypted backup and run only the Openfit canary:\n%s\n' "$CONFIRMATION" >&2
IFS= read -r confirmation
[[ $confirmation == "$CONFIRMATION" ]] || { echo "exact Debian production-canary confirmation is required" >&2; exit 1; }
export HOME_LAB_DEBIAN_QUALIFICATION_CONFIRMED=$CONFIRMATION
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
exec "$root/scripts/qualify-debian-inert"
