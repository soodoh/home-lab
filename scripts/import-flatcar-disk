#!/bin/bash
set -euo pipefail

readonly VMID=100
readonly IMAGE=/var/lib/vz/import/flatcar-4593.2.5-proxmoxve.img
readonly STORAGE=local-lvm
readonly INTERFACE=scsi3
readonly SERIAL=HOME-LAB-FLATCAR-64G
readonly SIZE=64G
readonly MINIMUM_FREE_BYTES=68719476736
readonly CONFIRMATION=import-reviewed-vm-100-flatcar-scsi3
readonly RECONCILIATION_ROOT=/var/lib/home-lab/reconciliation
readonly PATH=/usr/sbin:/usr/bin:/sbin:/bin

fail() {
  echo "error: $*" >&2
  exit 1
}

config_value() {
  local file=$1 key=$2
  awk -F ': ' -v key="$key" '$1 == key { sub(/^[^:]+: /, ""); print; found=1 } END { if (!found) exit 1 }' "$file"
}

protected_hash() {
  grep -Ev '^(digest|scsi3):' "$1" | sha256sum | awk '{print $1}'
}

disk_volume() {
  config_value "$1" "$INTERFACE" | cut -d, -f1
}

verify_desired_scsi3() {
  local file=$1 value
  value=$(config_value "$file" "$INTERFACE") || return 1
  [[ $value =~ ^local-lvm:vm-100-disk-[0-9]+, ]]
  for field in backup=1 cache=none discard=ignore iothread=1 replicate=1 serial=$SERIAL size=$SIZE ssd=0; do
    [[ ,$value, == *,$field,* ]] || return 1
  done
}

verify_running_scsi3() {
  local file=$1 value volume
  value=$(config_value "$file" "$INTERFACE") || return 1
  volume=${value%%,*}
  [[ $volume =~ ^local-lvm:vm-100-disk-[0-9]+$ ]] || return 1
  verify_desired_scsi3 "$file" || [[ $value == "$volume,size=$SIZE" ]]
}

verify_reconcilable_scsi3() {
  local effective=$1 current=$2 effective_value current_value volume
  effective_value=$(config_value "$effective" "$INTERFACE") || return 1
  current_value=$(config_value "$current" "$INTERFACE") || return 1
  volume=${effective_value%%,*}
  [[ $volume =~ ^local-lvm:vm-100-disk-[0-9]+$ ]] || return 1
  [[ ${current_value%%,*} == "$volume" ]] || return 1
  for field in backup=1 cache=none discard=ignore iothread=1 replicate=1 serial=$SERIAL ssd=0; do
    [[ ,$effective_value, == *,$field,* ]] || return 1
  done
  [[ ,$effective_value, == *,size=12600M,* || ,$effective_value, == *,size=$SIZE,* ]] || return 1
  verify_running_scsi3 "$current"
}

[[ $# -eq 0 ]] || fail "usage: scripts/import-flatcar-disk"
[[ $(id -u) -eq 0 ]] || fail "Flatcar disk import requires root"
[[ ${HOME_LAB_FLATCAR_DISK_IMPORT_CONFIRMED:-} == "$CONFIRMATION" ]] || fail "exact Flatcar disk import confirmation is required"
[[ $(ps -o tty= -p "$$" | tr -d ' ') =~ ^tty[0-9]+$ ]] || fail "Flatcar disk import requires a physical Proxmox console"
[[ -d $RECONCILIATION_ROOT && ! -L $RECONCILIATION_ROOT ]] || fail "reconciliation lock root is absent or unsafe"
[[ ! -e $RECONCILIATION_ROOT/apply.lock ]] || fail "a protected Proxmox apply is active"
[[ ! -e /var/lib/iac-ansible-production.lock ]] || fail "Ansible host ownership is active"
exec 9>"$RECONCILIATION_ROOT/operation.lock"
flock -n 9 || fail "another protected Proxmox operation holds the lock"
exec 8>/run/lock/home-lab-flatcar-disk-import.lock
flock -n 8 || fail "another Flatcar disk import holds the lock"
exec 7>/run/lock/home-lab-vfio-recovery.lock
flock -n 7 || fail "VFIO recovery is active"

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
[[ $(git branch --show-current) == main ]] || fail "repository is not on main"
[[ -z $(git status --porcelain) ]] || fail "repository is not clean"
scripts/stage-flatcar-image check >/dev/null
scripts/stage-flatcar-ignition check >/dev/null
[[ $(qm status "$VMID") == "status: running" ]] || fail "VM 100 is not running"

before=$(mktemp --tmpdir=/run home-lab-flatcar-before.XXXXXX)
before_current=$(mktemp --tmpdir=/run home-lab-flatcar-before-current.XXXXXX)
after=$(mktemp --tmpdir=/run home-lab-flatcar-after.XXXXXX)
after_current=$(mktemp --tmpdir=/run home-lab-flatcar-after-current.XXXXXX)
cleanup() {
  rm -f -- "$before" "$before_current" "$after" "$after_current"
}
trap cleanup EXIT
chmod 0600 "$before" "$before_current" "$after" "$after_current"
qm config "$VMID" > "$before"
qm config "$VMID" --current 1 > "$before_current"

for key in scsi0 scsi1 scsi2; do
  config_value "$before" "$key" >/dev/null || fail "$key is absent"
  [[ $(config_value "$before" "$key") == $(config_value "$before_current" "$key") ]] || fail "$key has a pending change"
done
[[ $(config_value "$before" boot) == "order=scsi0;net0" ]] || fail "Arch boot order differs"
[[ $(config_value "$before" protection) == 1 ]] || fail "VM 100 protection differs"
! config_value "$before" lock >/dev/null 2>&1 || fail "VM 100 has an active Proxmox configuration lock"
! config_value "$before" ide2 >/dev/null 2>&1 || fail "ide2 already exists"
! grep -Eq '^unused[0-9]+:' "$before" || fail "an unused disk requires reconciliation"
[[ $(protected_hash "$before") == $(protected_hash "$before_current") ]] || fail "VM 100 has pending protected configuration"

existing=false
if config_value "$before" "$INTERFACE" >/dev/null 2>&1; then
  verify_reconcilable_scsi3 "$before" "$before_current" || fail "existing scsi3 is not the exact reconcilable Flatcar disk"
  existing=true
  volume=$(disk_volume "$before")
else
  storage_status=$(pvesh get "/nodes/proxmox/storage/$STORAGE/status" --output-format json)
  jq -e --argjson minimum "$MINIMUM_FREE_BYTES" \
    '.active == 1 and .enabled == 1 and .type == "lvmthin" and .avail >= $minimum' \
    <<< "$storage_status" >/dev/null || fail "local-lvm is unavailable or has insufficient free space"
fi

mutation_started=false
on_error() {
  result=$?
  if [[ $mutation_started == true ]]; then
    echo "error: Flatcar disk import is incomplete; the new disk is preserved for explicit reconciliation" >&2
  fi
  exit "$result"
}
trap on_error ERR

mutation_started=true
if [[ $existing == false ]]; then
  qm disk import "$VMID" "$IMAGE" "$STORAGE" --format raw --target-disk "$INTERFACE"
  qm config "$VMID" > "$after"
  volume=$(disk_volume "$after")
  [[ $volume =~ ^local-lvm:vm-100-disk-[0-9]+$ ]] || fail "imported scsi3 volume identity differs"
  qm set "$VMID" --scsi3 "$volume,backup=1,cache=none,discard=ignore,iothread=1,replicate=1,serial=$SERIAL,ssd=0"
  qm disk resize "$VMID" "$INTERFACE" "$SIZE"
fi
qm disk rescan --vmid "$VMID"
qm set "$VMID" --scsi3 "$volume,backup=1,cache=none,discard=ignore,iothread=1,replicate=1,serial=$SERIAL,ssd=0"
qm config "$VMID" > "$after"
qm config "$VMID" --current 1 > "$after_current"

verify_desired_scsi3 "$after" || fail "effective scsi3 configuration differs"
verify_running_scsi3 "$after_current" || fail "running scsi3 configuration differs"
[[ $(disk_volume "$after") == $(disk_volume "$after_current") ]] || fail "running scsi3 volume identity differs"
[[ $(protected_hash "$before") == $(protected_hash "$after") ]] || fail "protected VM configuration changed"
[[ $(protected_hash "$before_current") == $(protected_hash "$after_current") ]] || fail "running protected VM configuration changed"
! grep -Eq '^unused[0-9]+:' "$after" || fail "an unexpected unused disk remains"
[[ $(qm status "$VMID") == "status: running" ]] || fail "VM 100 stopped during disk import"
activation=active
[[ $(config_value "$after" "$INTERFACE") == $(config_value "$after_current" "$INTERFACE") ]] || activation=pending-reboot
mutation_started=false
trap - ERR

printf '{"bootOrder":"scsi0;net0","configurationActivation":"%s","interface":"%s","serial":"%s","size":"%s","state":"verified","storage":"%s","vmStatus":"running","vmid":%s,"volume":"%s"}\n' \
  "$activation" "$INTERFACE" "$SERIAL" "$SIZE" "$STORAGE" "$VMID" "$volume"
