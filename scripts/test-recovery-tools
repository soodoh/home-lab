cmp "$replication_primary/$replication_id" "$replication_games/$replication_id"
cmp "$replication_primary/$replication_id.sha256" "$replication_games/$replication_id.sha256"

WORK="$work" REPO_ROOT="$repo_root" python3 - <<'PY'
import importlib.util
import os
from pathlib import Path
import sys

repo = Path(os.environ["REPO_ROOT"])
root = Path(os.environ["WORK"], "cleanup-fixtures")
sys.path.insert(0, str(repo / "scripts"))


def load(name: str, path: Path):
    spec = importlib.util.spec_from_file_location(name, path)
    module = importlib.util.module_from_spec(spec)
    assert spec.loader is not None
    spec.loader.exec_module(module)
    return module


local_cleanup = load("cleanup_local_backups", repo / "scripts/cleanup-local-backups.py")
s3_cleanup = load("cleanup_s3_backups", repo / "scripts/cleanup-s3-backups.py")
from s3_backup_api import S3BackupClient, S3Version

keep = "daily-local-backup-2026-08-20T05-00-00.tar.gz.gpg"
roots = [root / "local-a", root / "local-b"]
for destination in roots:
    destination.mkdir(parents=True)
    (destination / keep).write_bytes(b"keep")
    (destination / f"{keep}.sha256").write_text("keep sidecar")
    for name in (
        "backup-2026-07-01T05-00-00.tar.gz.gpg",
        "daily-backup-2026-07-02T05-00-00.tar.gz.gpg.sha256",
        "daily-local-backup-2026-07-03T05-00-00.tar.gz.gpg",
        ".daily-local-backup-2026-07-04T05-00-00.tar.gz.gpg.partial.123",
    ):
        (destination / name).write_bytes(b"delete")
    (destination / "vikunja-data-pre-restore-2026-06-12T15-50-28.tar.gz").write_bytes(b"keep")
    (destination / "weekly-backup-2026-07-01T05-00-00.tar.gz.gpg").write_bytes(b"unrelated")
manifest = local_cleanup.build_manifest(roots, keep)
assert len(manifest["entries"]) == 8
assert all("vikunja" not in entry["name"] and not entry["name"].startswith("weekly-") for entry in manifest["entries"])
manifest_path = (root / "local-manifest.json").absolute()
local_cleanup.write_manifest(manifest_path, manifest)
assert manifest_path.stat().st_mode & 0o777 == 0o600
local_cleanup.apply_manifest(manifest, roots, keep)
for destination in roots:
    assert (destination / keep).is_file()
    assert (destination / f"{keep}.sha256").is_file()
    assert (destination / "vikunja-data-pre-restore-2026-06-12T15-50-28.tar.gz").is_file()
    assert (destination / "weekly-backup-2026-07-01T05-00-00.tar.gz.gpg").is_file()

versions = [
    S3Version("weekly-backup-2026-08-16T06-00-00.tar.gz.gpg", "v1", "Version", True, "2026-08-16T13:40:33Z", 100, "etag"),
    S3Version("daily-remote-backup-2026-08-08T06-00-00.tar.gz.gpg", "v2", "Version", False, "2026-08-08T13:34:24Z", 90, "etag"),
    S3Version("daily-remote-backup-2026-08-08T06-00-00.tar.gz.gpg", "m1", "DeleteMarker", True, "2026-08-21T00:00:00Z", 0, ""),
    S3Version("weekly-backup-not-a-timestamp.tar.gz.gpg", "u1", "Version", True, "2026-08-01T00:00:00Z", 10, "etag"),
    S3Version("recovery/weekly-backup-2026-08-01T06-00-00.tar.gz.gpg", "u2", "Version", True, "2026-08-01T00:00:00Z", 20, "etag"),
    S3Version("unrelated-recovery-object", "u3", "Version", True, "2026-08-01T00:00:00Z", 30, "etag"),
]
client = S3BackupClient("bucket", "us-west-2", "access", "secret")
prefixes = s3_cleanup.checked_prefixes([])
s3_manifest = s3_cleanup.build_manifest(client, versions, prefixes)
assert s3_manifest["recognized_counts"] == {
    "current_objects": 1,
    "noncurrent_versions": 1,
    "delete_markers": 1,
    "all_entries": 3,
}
assert s3_manifest["recognized_aggregate_version_bytes"] == 190
assert s3_manifest["unrelated"]["count"] == 3
assert all(entry["identity_sha256"] for entry in s3_manifest["entries"])
assert s3_cleanup.checked_prefixes(["legacy-backup-"])[-1] == "legacy-backup-"
