PY
cat >"$test_repo/bin/gpg" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
output=
last=
for argument in "$@"; do last=$argument; done
while (($#)); do
  if [[ $1 == --output ]]; then
    output=$2
    shift 2
  else
    shift
  fi
done
if [[ -n $output ]]; then
  cp "$last" "$output"
fi
SH
cat >"$test_repo/bin/curl" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
printf 'download\n' >>"$CURL_LOG"
output=
while (($#)); do
  if [[ $1 == --output ]]; then
    output=$2
    shift 2
  else
    shift
  fi
done
cp "$REMOTE_FIXTURE" "$output"
SH
cat >"$test_repo/bin/sha256sum" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
if (($# == 1)) && [[ $1 != -* ]]; then
  shasum -a 256 "$1"
  exit
fi
IFS=' ' read -r expected file
actual=$(shasum -a 256 "$file" | awk '{print $1}')
[[ $actual == "$expected" ]]
SH
chmod +x "$test_repo/bin/gpg" "$test_repo/bin/curl" "$test_repo/bin/sha256sum"
older_backup_id=daily-local-backup-2026-08-05T05-00-00.tar.gz.gpg
