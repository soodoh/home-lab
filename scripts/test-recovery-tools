#!/usr/bin/env bash
set -euo pipefail
repo_root=$(cd "$(dirname "$0")/.." && pwd -P)
# Generic recovery surfaces remain executable after service-specific retirement.
python3 -m py_compile "$repo_root/scripts/recovery-scope.py" "$repo_root/scripts/compose-model-inventory.py"
python3 -B "$repo_root/scripts/test-recovery-scope.py"
python3 -B "$repo_root/scripts/controller/test-aws-recovery-bundle-access.py"
python3 -B "$repo_root/scripts/controller/test-current-restic-recovery-bundles.py"
python3 -B "$repo_root/scripts/controller/test-current-restic-recovery-controller.py"
node "$repo_root/scripts/controller/test-current-restic-recovery-bundle-evidence.js"
"$repo_root/scripts/test-nextcloud-config"
"$repo_root/scripts/test-compose-secret-files"
"$repo_root/scripts/test-restic-restore-branch"
"$repo_root/scripts/test-restic-recovery-bundle"
"$repo_root/scripts/test-restic-activation-fixture"
grep -q '^recovery_restic_snapshot_id:' "$repo_root/recovery/extra-vars.example.yml"
echo "recovery tool safety fixtures passed"
