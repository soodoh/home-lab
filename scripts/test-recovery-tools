  [[ -f $destination/$replication_id && -f $destination/$replication_id.sha256 ]]
  expected=$(awk '{print $1}' "$destination/$replication_id.sha256")
  actual=$(sha256sum "$destination/$replication_id" | awk '{print $1}')
  [[ $expected == "$actual" ]]
  [[ ! -e $destination/$old_replication_id && ! -e $destination/$old_replication_id.sha256 ]]
  [[ -f $destination/backup-2020-01-01T05-00-00.tar.gz.gpg ]]
  [[ -f $destination/daily-backup-2020-01-01T05-00-00.tar.gz.gpg ]]
  [[ -f $destination/vikunja-data-pre-restore-2026-06-12T15-50-28.tar.gz ]]
