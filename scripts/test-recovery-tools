PY
rm -f "$games_backup_root"/* "$storage_backup_root"/*
env "${common_env[@]}" RECOVERY_TARGET="$recovery_root/remote" \
  RECOVERY_EXPECTED_BACKUP_IDENTITY_SHA256="$remote_identity_sha" \
  RECOVERY_BACKUP_URL="https://example.invalid/$remote_backup_id?versionId=version-1" \
  RECOVERY_BACKUP_VERSION_ID=version-1 RECOVERY_REMOTE_BACKUP_SHA256="$older_sha" \
