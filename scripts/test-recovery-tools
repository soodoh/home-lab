cp "$work/valid.tar.gz" "$storage_backup_root/$older_backup_id"
cp "$work/safe-symlink.tar.gz" "$games_backup_root/$newer_backup_id"
older_sha=$(sha256sum "$work/valid.tar.gz" | awk '{print $1}')
newer_sha=$(sha256sum "$work/safe-symlink.tar.gz" | awk '{print $1}')
backup_identity_hash() {
  SOURCE=$1 BACKUP_ID=$2 CIPHERTEXT_SHA256=$3 VERSION_ID=${4:-} python3 - <<'PY'
import hashlib
import json
import os

source = os.environ["SOURCE"]
version = os.environ["VERSION_ID"]
identity = {
    "backup_id_sha256": hashlib.sha256(os.environ["BACKUP_ID"].encode()).hexdigest(),
    "ciphertext_sha256": os.environ["CIPHERTEXT_SHA256"],
    "remote_version_id_sha256": hashlib.sha256(version.encode()).hexdigest() if source == "remote" else None,
    "source": source,
    "version": 1,
}
encoded = json.dumps(identity, sort_keys=True, separators=(",", ":"))
print(hashlib.sha256(encoded.encode()).hexdigest())
PY
}
newer_identity_sha=$(backup_identity_hash local "$newer_backup_id" "$newer_sha")
games_priority_identity_sha=$(backup_identity_hash local "$newer_backup_id" "$older_sha")
remote_identity_sha=$(backup_identity_hash remote "$remote_backup_id" "$older_sha" version-1)
cat >"$work/reviewed-backup.json" <<JSON
{"source":"local","backup_id":"$newer_backup_id","ciphertext_sha256":"$newer_sha"}
JSON
chmod 0600 "$work/reviewed-backup.json"
[[ $("$repo_root/scripts/derive-recovery-backup-identity.py" --input "$work/reviewed-backup.json") == \
  "recovery_backup_identity_sha256=$newer_identity_sha" ]]
printf '%s  %s\n' "$older_sha" "$older_backup_id" >"$storage_backup_root/$older_backup_id.sha256"
printf '%s  %s\n' "$newer_sha" "$newer_backup_id" >"$games_backup_root/$newer_backup_id.sha256"
touch "$work/recovery-key.asc"
mkdir "$recovery_root/local" "$recovery_root/mismatch" "$recovery_root/tie" "$recovery_root/remote" "$recovery_root/reject"
common_env=(
  "PATH=$test_repo/bin:$PATH"
