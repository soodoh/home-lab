#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

readonly VMID=100
readonly CONFIRMATION=delete-reviewed-quarantined-arch-volume
readonly OPERATION_LOCK=/var/lib/home-lab/reconciliation/operation.lock
readonly APPLY_LOCK=/var/lib/home-lab/reconciliation/apply.lock
readonly ANSIBLE_LOCK=/var/lib/iac-ansible-production.lock
readonly RETIREMENT_LOCK=/run/lock/home-lab-vm-100-arch-retirement.lock
readonly EVIDENCE_ROOT=/var/lib/home-lab/retirement
readonly EXPECTED_BOOT='order=scsi3;net0'
readonly RETIRED_VOLUME='local-lvm:vm-100-disk-0'
readonly EXPECTED_SCSI3='local-lvm:vm-100-disk-2,backup=1,cache=none,discard=ignore,iothread=1,replicate=1,serial=HOME-LAB-DEBIAN-64G,size=64G,ssd=0'

fail() { echo "arch_disk_deletion=failed reason=$*" >&2; exit 1; }
config_value() { qm config "$VMID" | awk -F': ' -v key="$1" '$1 == key {print $2}'; }
guest_exec() {
  local output
  output=$(qm guest exec "$VMID" -- /bin/bash -lc "$1") || fail "guest_agent_command_failed"
  jq -e '.exitcode == 0' <<<"$output" >/dev/null || fail "guest_health_failed"
}
require_confirmation() {
  local value
  [[ -c /dev/tty ]] || fail "physical_console_tty_required"
  printf 'This permanently deletes %s. Type the exact confirmation:\n%s\n' "$RETIRED_VOLUME" "$CONFIRMATION" >/dev/tty
  IFS= read -r value </dev/tty
  [[ $value == "$CONFIRMATION" ]] || fail "confirmation_invalid"
}

[[ $(id -u) -eq 0 ]] || fail "root_required"
for command in awk flock jq pvesm qm sha256sum stat; do command -v "$command" >/dev/null || fail "missing_command_$command"; done
[[ -f $OPERATION_LOCK && ! -L $OPERATION_LOCK ]] || fail "operation_lock_unsafe"
[[ $(stat -c '%U:%G:%a' "$OPERATION_LOCK") == root:root:600 ]] || fail "operation_lock_metadata"
[[ ! -e $APPLY_LOCK && ! -e $ANSIBLE_LOCK ]] || fail "another_apply_lock_exists"
exec 9>>"$OPERATION_LOCK"
[[ $(stat -Lc '%d:%i' "$OPERATION_LOCK") == $(stat -Lc '%d:%i' /proc/$$/fd/9) ]] || fail "operation_lock_identity_changed"
flock -n 9 || fail "operation_lock_held"
exec 8>"$RETIREMENT_LOCK"
flock -n 8 || fail "retirement_lock_held"

[[ $(qm status "$VMID" | awk '{print $2}') == running ]] || fail "vm_not_running"
[[ $(config_value boot) == "$EXPECTED_BOOT" ]] || fail "boot_order_differs"
[[ $(config_value protection) == 1 ]] || fail "vm_protection_differs"
[[ -z $(config_value scsi0) ]] || fail "scsi0_is_attached"
[[ $(config_value unused0) == "$RETIRED_VOLUME" ]] || fail "unused0_identity_differs"
[[ -n $(config_value scsi1) && -n $(config_value scsi2) ]] || fail "protected_disk_missing"
[[ $(config_value scsi3) == "$EXPECTED_SCSI3" ]] || fail "debian_disk_differs"
[[ $(pvesm list local-lvm --vmid "$VMID" --content images | awk -v volume="$RETIRED_VOLUME" '$1 == volume {count++} END {print count+0}') == 1 ]] || fail "retired_volume_storage_identity_differs"

guest_exec "test \"\$(docker ps -q | wc -l)\" -eq 41 && test \"\$(docker ps --filter health=unhealthy -q | wc -l)\" -eq 0"
guest_exec 'findmnt -rn -S UUID=d4a19647-7879-4079-9fc9-b3e79711b449 -T /srv/home-lab-state -o TARGET,FSTYPE,OPTIONS | grep -Eq "^/srv/home-lab-state ext4 (rw|.*,rw)(,|$)"'
require_confirmation

install -d -o root -g root -m 0700 "$EVIDENCE_ROOT"
before=$(mktemp "$EVIDENCE_ROOT/.vm-100-pre-arch-disk-delete.XXXXXX")
qm config "$VMID" >"$before"
chown root:root "$before"
chmod 0600 "$before"
before_sha=$(sha256sum "$before" | awk '{print $1}')
scsi1_before=$(config_value scsi1)
scsi2_before=$(config_value scsi2)
scsi3_before=$(config_value scsi3)

restore_protection=true
restore() {
  local status=$?
  if [[ $restore_protection == true ]]; then qm set "$VMID" --protection 1 >/dev/null || true; fi
  exit "$status"
}
trap restore ERR INT TERM
qm set "$VMID" --protection 0 >/dev/null
qm set "$VMID" --delete unused0 >/dev/null
qm set "$VMID" --protection 1 >/dev/null
restore_protection=false
trap - ERR INT TERM

[[ -z $(config_value unused0) ]] || fail "unused0_still_present"
[[ -z $(pvesm list local-lvm --vmid "$VMID" --content images | awk -v volume="$RETIRED_VOLUME" '$1 == volume {print}') ]] || fail "retired_volume_still_exists"
[[ $(config_value protection) == 1 ]] || fail "vm_protection_not_restored"
[[ $(config_value boot) == "$EXPECTED_BOOT" ]] || fail "boot_order_changed"
[[ $(config_value scsi1) == "$scsi1_before" ]] || fail "games_disk_changed"
[[ $(config_value scsi2) == "$scsi2_before" ]] || fail "state_disk_changed"
[[ $(config_value scsi3) == "$scsi3_before" ]] || fail "debian_disk_changed"
guest_exec "test \"\$(docker ps -q | wc -l)\" -eq 41 && test \"\$(docker ps --filter health=unhealthy -q | wc -l)\" -eq 0"

evidence=$(mktemp "$EVIDENCE_ROOT/.vm-100-arch-disk-deleted.XXXXXX")
jq -n --arg observedAt "$(date -u +%FT%TZ)" --arg beforeConfig "$before" --arg beforeSha256 "$before_sha" --arg volume "$RETIRED_VOLUME" '{schemaVersion:1,observedAt:$observedAt,vmid:100,status:"deleted",volume:$volume,beforeConfig:$beforeConfig,beforeConfigSha256:$beforeSha256,scsi1Changed:false,scsi2Changed:false,scsi3Changed:false,protectionRestored:true,containers:41,unhealthy:0}' >"$evidence"
chown root:root "$evidence"
chmod 0600 "$evidence"
mv "$evidence" "$EVIDENCE_ROOT/vm-100-arch-disk-deleted.json"
echo "arch_disk_deletion=complete volume=$RETIRED_VOLUME"
