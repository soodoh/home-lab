#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
required_tofu_version=1.12.5
actual=$(tofu version -json | python3 -c 'import json,sys; print(json.load(sys.stdin)["terraform_version"])')
if [[ $actual != "$required_tofu_version" ]]; then
  echo "OpenTofu $required_tofu_version is required; found $actual" >&2
  exit 1
fi

roots=(aws-foundation authentik media-apps proxmox proxmox-legacy proxmox-lxc-qualification omada tailscale)
for name in "${roots[@]}"; do
  root="$repo_root/infrastructure/tofu/$name"
  test -s "$root/.terraform.lock.hcl"
  tofu -chdir="$root" providers lock \
    -platform=darwin_arm64 \
    -platform=linux_amd64 \
    -platform=linux_arm64 >/dev/null
done

git -C "$repo_root" diff --exit-code -- 'infrastructure/tofu/**/.terraform.lock.hcl'
echo "provider locks verified for darwin_arm64, linux_amd64, and linux_arm64"
