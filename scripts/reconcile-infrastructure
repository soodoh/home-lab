export TF_IN_AUTOMATION=1
export TF_INPUT=0

contract_value() {
  local expression=$1
  EXPRESSION="$expression" node --input-type=module - <<'NODE'
import fs from "node:fs";
import { load } from "js-yaml";
const document = load(fs.readFileSync("infrastructure/contract/home-lab.yml", "utf8"));
let value = document;
for (const segment of process.env.EXPRESSION.split(".")) value = value?.[segment];
if (value === null || value === undefined || value === "") process.exit(1);
process.stdout.write(String(value));
NODE
}

offen_retirement_operation() {
  [[ $(contract_value backups.legacy_offen.retirement.state) == retired ]] || {
    echo 'non-terminal Offen retirement is no longer supported' >&2
    return 1
  }
  printf '\n'
}

require_protected_regular_file() {
  python3 scripts/controller/validate-protected-file.py "$1" --label "$2"
}

recovery_expected_backup_identity_sha256() {
  printf '\n'
}

ansible_extra_vars_sha256() {
  if [[ -z ${RECONCILE_ANSIBLE_EXTRA_VARS_FILE:-} ]]; then
    printf '\n'
    return
  fi
  require_protected_regular_file "$RECONCILE_ANSIBLE_EXTRA_VARS_FILE" "Ansible extra-vars file"
  sha256_file "$RECONCILE_ANSIBLE_EXTRA_VARS_FILE"
}

backend_bucket=${TF_BACKEND_BUCKET:-}
if [[ -z $backend_bucket ]]; then
  backend_bucket=$(contract_value aws.state_bucket) || {
    echo "TF_BACKEND_BUCKET is required until aws.state_bucket is populated." >&2
    exit 65
  }
fi
aws_region=${AWS_REGION:-$(contract_value aws.region)}
commit=$(git rev-parse HEAD)

roots=(aws-foundation proxmox omada tailscale)
if [[ $phase == steady ]]; then
  roots=(aws-foundation proxmox omada tailscale authentik)
fi
enabled_roots=()
for root in "${roots[@]}"; do
  case "$root" in
    omada) [[ ${TF_VAR_omada_enable_management:-false} == true ]] || continue ;;
    tailscale) [[ ${TF_VAR_tailscale_enable_management:-false} == true ]] || continue ;;
    authentik) [[ ${TF_VAR_authentik_enable_management:-false} == true ]] || continue ;;
  esac
  enabled_roots+=("$root")
done
roots=("${enabled_roots[@]}")
unset enabled_roots

sha256_file() {
  if command -v sha256sum >/dev/null; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

