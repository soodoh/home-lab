#!/usr/bin/env bash
set -euo pipefail
umask 077

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

usage() {
  cat >&2 <<'EOF'
usage: scripts/reconcile-infrastructure <validate|plan|apply|verify> [options]

Options:
  --phase <steady|recovery>           Desired reconciliation phase (default: steady)
  --plan-dir <path>                   Protected saved-plan directory
  --proxmox-inventory <path>          Proxmox Ansible inventory
  --arch-inventory <path>             Arch Ansible inventory
  --arch-bootstrap-inventory <path>   Temporary Arch recovery inventory

Required environment:
  TF_BACKEND_BUCKET                   Existing encrypted OpenTofu state bucket
  AWS credentials and provider TF_VAR_* credentials for every enabled root

Apply requires a clean checkout at the exact manifest commit. Per-root OpenTofu S3 locks and
an atomic controller-wide local lock serialize mutation. Recovery gates are supplied only through
RECONCILE_ANSIBLE_EXTRA_VARS_FILE (an ignored mode-0600 YAML file); they are never accepted as
shell text. Proxmox host bootstrap must already have been run locally with console/LAN fallback
before recovery apply.
EOF
  exit 64
}

(($# >= 1)) || usage
action=$1
shift
case "$action" in validate|plan|apply|verify) ;; *) usage ;; esac
phase=steady
plan_dir="$repo_root/.reconcile/plans"
proxmox_inventory=inventory/infrastructure.yml
arch_inventory=inventory/production.yml
arch_bootstrap_inventory=inventory/arch-recovery.yml

while (($#)); do
  case "$1" in
    --phase)
      (($# >= 2)) || usage
      phase=$2
      shift 2
      ;;
    --plan-dir)
      (($# >= 2)) || usage
      plan_dir=$2
      shift 2
      ;;
    --proxmox-inventory)
      (($# >= 2)) || usage
      proxmox_inventory=$2
      shift 2
      ;;
    --arch-inventory)
      (($# >= 2)) || usage
      arch_inventory=$2
      shift 2
      ;;
    --arch-bootstrap-inventory)
      (($# >= 2)) || usage
      arch_bootstrap_inventory=$2
      shift 2
      ;;
    *) usage ;;
  esac
done

case "$phase" in steady|recovery) ;; *) usage ;; esac
case "$plan_dir" in
  "$repo_root/.reconcile/"*) ;;
  *) echo "plan directory must remain under $repo_root/.reconcile" >&2; exit 64 ;;
esac
[[ $plan_dir != *"/../"* && $plan_dir != */.. ]] || exit 64

if [[ $action == validate ]]; then
  for command in tofu node jq python3 shellcheck ansible-lint ansible-playbook docker nix nix-store; do
    command -v "$command" >/dev/null || {
      echo "required validation command is unavailable: $command" >&2
      exit 69
    }
  done
  scripts/validate-contract
  scripts/validate-provider-locks
  infrastructure/policy/test-policy.sh
  node scripts/controller/test-contract-schema.js
  node scripts/controller/test-proxmox-package-manifest.js
  node scripts/controller/test-proxmox-nix-projection.js
  [[ ! -e flake.nix && ! -e flake.lock ]] || {
    echo "the Nix flake must remain isolated under the sanitized nix/ source root" >&2
    exit 1
  }
  proxmox_nix_source=$(nix flake archive 'path:./nix' --json | jq -er .path)
  PROXMOX_NIX_SOURCE_STORE_PATH=$proxmox_nix_source \
    python3 scripts/controller/test-proxmox-nix-foundation.py
  python3 scripts/controller/test-proxmox-nix-plan.py
  node scripts/controller/test-proxmox-nix-projection.js --scan-path "$proxmox_nix_source"
  for source_candidate in /nix/store/*-source; do
    if [[ -e $source_candidate/secrets/production.sops.env && \
          -e $source_candidate/infrastructure/contract/home-lab.yml ]]; then
      echo "repository-root Nix source leak exists: $source_candidate" >&2
      exit 1
    fi
  done
  nix flake check 'path:./nix' --print-build-logs
  proxmox_bundle_output=$(nix build 'path:./nix#proxmox-host-bundle' --no-link --print-out-paths)
  python3 nix/proxmox/bundle.py verify \
    --bundle "$proxmox_bundle_output/bundle" \
    --hash-file "$proxmox_bundle_output/bundle.sha256"
  proxmox_bundle_derivation=$(nix path-info --derivation 'path:./nix#proxmox-host-bundle')
  while IFS= read -r input_source; do
    node scripts/controller/test-proxmox-nix-projection.js --scan-path "$input_source"
  done < <(nix derivation show "$proxmox_bundle_derivation" | jq -r '
    (.derivations // .)[] |
    ((.inputs.srcs // .inputSrcs) // [])[] |
    if startswith("/") then . else "/nix/store/" + . end
  ')
  while IFS= read -r closure_path; do
    node scripts/controller/test-proxmox-nix-projection.js --scan-path "$closure_path"
  done < <(nix-store --query --requisites "$proxmox_bundle_output")
  echo "proxmox_nix_sanitized_source=$proxmox_nix_source"
  python3 ansible/roles/proxmox_host/files/test-check-apt-availability.py
  python3 scripts/controller/test-zpool-status-parser.py
  python3 scripts/controller/test-root-local-audit.py
  python3 scripts/controller/test-lxc-qualification-evidence.py
  python3 scripts/controller/test-protected-file.py
  python3 scripts/controller/test-reconcile-manifest.py
  python3 scripts/controller/test-reconcile-security.py
  scripts/test-recovery-tools
  python3 -m py_compile scripts/*.py scripts/controller/*.py
  shellcheck scripts/reconcile-infrastructure scripts/local-controller \
    scripts/bootstrap-proxmox-host scripts/build-recovery-bundle scripts/configure-local-controller-aws \
    scripts/configure-local-provider-credentials \
    scripts/collect-proxmox-protected-inputs scripts/migrate-proxmox-zfs-stack \
    scripts/prepare-omada-plan-input scripts/rehearse-recovery \
    scripts/restore-critical-backup scripts/test-recovery-tools recovery/coral/build-package
  tofu fmt -check -recursive infrastructure/tofu
  for root in aws-foundation proxmox-legacy proxmox proxmox-lxc-qualification omada tailscale; do
    (
      validation_data=$(mktemp -d)
      trap 'rm -rf "$validation_data"' EXIT
      export TF_DATA_DIR=$validation_data
      tofu -chdir="infrastructure/tofu/$root" init -backend=false -input=false >/dev/null
      tofu -chdir="infrastructure/tofu/$root" validate
    )
  done
  (
    cd ansible
    ansible-lint -c ../.ansible-lint playbooks roles
    for playbook in playbooks/*.yml; do
      ansible-playbook -i inventory/infrastructure.yml --syntax-check "$playbook"
    done
  )
  docker compose config --no-interpolate --quiet
  scripts/check-compose-image-pins.py
  git diff --check
  echo "infrastructure_validation=passed"
  exit 0
fi

for command in tofu node python3 jq git ansible ansible-playbook curl cmp; do
  command -v "$command" >/dev/null || {
    echo "required command is unavailable: $command" >&2
    exit 69
  }
done

export TF_IN_AUTOMATION=1
export TF_INPUT=0

contract_value() {
  local expression=$1
  EXPRESSION="$expression" node --input-type=module - <<'NODE'
import fs from "node:fs";
import { load } from "js-yaml";
const document = load(fs.readFileSync("infrastructure/contract/home-lab.yml", "utf8"));
let value = document;
for (const segment of process.env.EXPRESSION.split(".")) value = value?.[segment];
if (value === null || value === undefined || value === "") process.exit(1);
process.stdout.write(String(value));
NODE
}

require_protected_regular_file() {
  python3 scripts/controller/validate-protected-file.py "$1" --label "$2"
}

recovery_expected_backup_identity_sha256() {
  if [[ $phase != recovery ]]; then
    printf '\n'
    return
  fi
  [[ -n ${RECONCILE_ANSIBLE_EXTRA_VARS_FILE:-} && -f $RECONCILE_ANSIBLE_EXTRA_VARS_FILE ]] || {
    echo "Recovery planning requires the protected Ansible extra-vars file." >&2
    return 1
  }
  require_protected_regular_file "$RECONCILE_ANSIBLE_EXTRA_VARS_FILE" "recovery Ansible extra-vars file"
  EXTRA_VARS_FILE="$RECONCILE_ANSIBLE_EXTRA_VARS_FILE" node --input-type=module - <<'NODE'
import fs from "node:fs";
import { load } from "js-yaml";
const document = load(fs.readFileSync(process.env.EXTRA_VARS_FILE, "utf8"));
const value = document?.recovery_expected_backup_identity_sha256;
if (typeof value !== "string" || !/^[0-9a-f]{64}$/.test(value)) process.exit(1);
process.stdout.write(value);
NODE
}

ansible_extra_vars_sha256() {
  if [[ -z ${RECONCILE_ANSIBLE_EXTRA_VARS_FILE:-} ]]; then
    printf '\n'
    return
  fi
  require_protected_regular_file "$RECONCILE_ANSIBLE_EXTRA_VARS_FILE" "Ansible extra-vars file"
  sha256_file "$RECONCILE_ANSIBLE_EXTRA_VARS_FILE"
}

backend_bucket=${TF_BACKEND_BUCKET:-}
if [[ -z $backend_bucket ]]; then
  backend_bucket=$(contract_value aws.state_bucket) || {
    echo "TF_BACKEND_BUCKET is required until aws.state_bucket is populated." >&2
    exit 65
  }
fi
aws_region=${AWS_REGION:-$(contract_value aws.region)}
commit=$(git rev-parse HEAD)

roots=(aws-foundation proxmox omada tailscale)
if [[ $phase == steady ]]; then
  roots=(aws-foundation proxmox-legacy proxmox omada tailscale)
fi
enabled_roots=()
for root in "${roots[@]}"; do
  case "$root" in
    omada) [[ ${TF_VAR_omada_enable_management:-false} == true ]] || continue ;;
    tailscale) [[ ${TF_VAR_tailscale_enable_management:-false} == true ]] || continue ;;
  esac
  enabled_roots+=("$root")
done
roots=("${enabled_roots[@]}")
unset enabled_roots

sha256_file() {
  if command -v sha256sum >/dev/null; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}


tailscale_access_token() (
  local token_request="" token_response exit_code
  trap '[[ -z $token_request ]] || rm -f "$token_request"' EXIT
  : "${TAILSCALE_OAUTH_CLIENT_ID:?TAILSCALE_OAUTH_CLIENT_ID is required}"
  : "${TAILSCALE_OAUTH_CLIENT_SECRET:?TAILSCALE_OAUTH_CLIENT_SECRET is required}"
  token_request=$(mktemp "${TMPDIR:-/tmp}/tailscale-oauth-request.XXXXXX")
  chmod 0600 "$token_request"
  TAILSCALE_CLIENT_ID="$TAILSCALE_OAUTH_CLIENT_ID" \
    TAILSCALE_CLIENT_SECRET="$TAILSCALE_OAUTH_CLIENT_SECRET" \
    python3 - <<'PY' >"$token_request"
import os
from urllib.parse import urlencode

print(urlencode({
    "client_id": os.environ["TAILSCALE_CLIENT_ID"],
    "client_secret": os.environ["TAILSCALE_CLIENT_SECRET"],
}), end="")
PY
  set +e
  token_response=$(curl --fail --silent --show-error \
    -H 'Content-Type: application/x-www-form-urlencoded' \
    --data-binary @"$token_request" \
    https://api.tailscale.com/api/v2/oauth/token)
  exit_code=$?
  set -e
  rm -f "$token_request"
  token_request=
  [[ $exit_code == 0 ]] || return "$exit_code"
  jq -er '.access_token' <<<"$token_response"
)

tailscale_policy_identity() {
  local access_token headers body canonical etag identity
  : "${TAILSCALE_OAUTH_CLIENT_ID:?TAILSCALE_OAUTH_CLIENT_ID is required}"
  access_token=$(tailscale_access_token)
  headers=$(mktemp "${TMPDIR:-/tmp}/tailscale-policy-headers.XXXXXX")
  body=$(mktemp "${TMPDIR:-/tmp}/tailscale-policy-body.XXXXXX")
  canonical=$(mktemp "${TMPDIR:-/tmp}/tailscale-policy-canonical.XXXXXX")
  chmod 0600 "$headers" "$body" "$canonical"
  curl --fail --silent --show-error \
    -D "$headers" \
    -H "Authorization: Bearer $access_token" \
    -H 'Accept: application/json' \
    "https://api.tailscale.com/api/v2/tailnet/${TAILSCALE_TAILNET:--}/acl" \
    -o "$body"
  python3 scripts/controller/tailscale-gateway-policy.py canonicalize-policy \
    --policy "$body" >"$canonical"
  etag=$(awk 'tolower($1) == "etag:" {gsub(/\r/, ""); sub(/^[^:]+:[[:space:]]*/, ""); print; exit}' "$headers")
  [[ $etag =~ ^(W/)?\"[^\"[:cntrl:]]+\"$ ]] || {
    echo "The Tailscale policy response is missing a valid ETag." >&2
    rm -f "$headers" "$body" "$canonical"
    return 1
  }
  identity="$(sha256_file "$canonical")"$'\t'"$etag"
  rm -f "$headers" "$body" "$canonical"
  unset access_token
  printf '%s\n' "$identity"
}

tailscale_planned_policy() {
  local plan=$1 side=$2 destination=$3
  tofu -chdir=infrastructure/tofu/tailscale show -json "$plan" |
    python3 scripts/controller/tailscale-gateway-policy.py extract-plan-policy \
      --plan-json - --side "$side" >"$destination"
}

tailscale_verify_planned_policy_hashes() {
  local plan=$1 expected_before_sha=$2 expected_after_sha=$3
  local planned_before planned_after planned_before_sha planned_after_sha
  planned_before=$(mktemp "${TMPDIR:-/tmp}/tailscale-planned-before.XXXXXX")
  planned_after=$(mktemp "${TMPDIR:-/tmp}/tailscale-planned-after.XXXXXX")
  chmod 0600 "$planned_before" "$planned_after"
  tailscale_planned_policy "$plan" before "$planned_before"
  tailscale_planned_policy "$plan" after "$planned_after"
  planned_before_sha=$(sha256_file "$planned_before")
  planned_after_sha=$(sha256_file "$planned_after")
  rm -f "$planned_before" "$planned_after"
  [[ $planned_before_sha == "$expected_before_sha" && $planned_after_sha == "$expected_after_sha" ]] || {
    echo "The saved Tailscale plan policies differ from the manifest." >&2
    return 1
  }
}

tailscale_apply_planned_policy() {
  local plan=$1 expected_before_sha=$2 expected_after_sha=$3 expected_etag=$4
  local desired current_sha current_etag desired_sha access_token response after_sha after_etag disposition
  desired=$(mktemp "${TMPDIR:-/tmp}/tailscale-policy-desired.XXXXXX")
  response=$(mktemp "${TMPDIR:-/tmp}/tailscale-policy-response.XXXXXX")
  chmod 0600 "$desired" "$response"
  tailscale_verify_planned_policy_hashes "$plan" "$expected_before_sha" "$expected_after_sha"
  tailscale_planned_policy "$plan" after "$desired"
  desired_sha=$(sha256_file "$desired")
  [[ $expected_before_sha =~ ^[0-9a-f]{64}$ && $expected_after_sha =~ ^[0-9a-f]{64}$ ]]
  [[ $expected_etag =~ ^(W/)?\"[^\"[:cntrl:]]+\"$ ]]
  [[ $desired_sha == "$expected_after_sha" && $expected_before_sha != "$expected_after_sha" ]]
  IFS=$'\t' read -r current_sha current_etag < <(tailscale_policy_identity)
  disposition=$(python3 scripts/controller/tailscale-gateway-policy.py apply-disposition \
    --current-sha "$current_sha" \
    --current-etag "$current_etag" \
    --planned-before-sha "$expected_before_sha" \
    --planned-after-sha "$expected_after_sha" \
    --planned-etag "$expected_etag")
  if [[ $disposition == post ]]; then
    access_token=$(tailscale_access_token)
    curl --fail --silent --show-error \
      -H "Authorization: Bearer $access_token" \
      -H 'Content-Type: application/json' \
      --data-binary @"$desired" \
      "https://api.tailscale.com/api/v2/tailnet/${TAILSCALE_TAILNET:--}/acl/validate" \
      -o "$response"
    jq -e '((.errors // []) | length) == 0 and ((.warnings // []) | length) == 0' "$response" >/dev/null
    IFS=$'\t' read -r current_sha current_etag < <(tailscale_policy_identity)
    disposition=$(python3 scripts/controller/tailscale-gateway-policy.py apply-disposition \
      --current-sha "$current_sha" \
      --current-etag "$current_etag" \
      --planned-before-sha "$expected_before_sha" \
      --planned-after-sha "$expected_after_sha" \
      --planned-etag "$expected_etag")
    [[ $disposition == post ]] || {
      echo "The live Tailscale policy changed during validation; refusing POST." >&2
      rm -f "$desired" "$response"
      exit 1
    }
    curl --fail --silent --show-error -X POST \
      -H "Authorization: Bearer $access_token" \
      -H 'Content-Type: application/json' \
      -H "If-Match: $expected_etag" \
      --data-binary @"$desired" \
      "https://api.tailscale.com/api/v2/tailnet/${TAILSCALE_TAILNET:--}/acl" \
      -o "$response"
    unset access_token
  else
    # Recovery is idempotent only for a saved plan that proves a distinct before
    # policy and whose live policy already equals that plan's exact after hash.
    [[ $disposition == recovered && $expected_before_sha != "$desired_sha" ]]
  fi
  IFS=$'\t' read -r after_sha after_etag < <(tailscale_policy_identity)
  [[ $after_sha == "$desired_sha" && -n $after_etag ]]
  rm -f "$desired" "$response"
}

tailscale_verify_state_policy() {
  local expected current_sha current_etag expected_sha
  expected=$(mktemp "${TMPDIR:-/tmp}/tailscale-state-policy.XXXXXX")
  chmod 0600 "$expected"
  tofu -chdir=infrastructure/tofu/tailscale state pull | jq -er '
    .resources[] |
    select(.type == "terraform_data" and .name == "tailscale_policy") |
    .instances[].attributes.input.value.policy_json |
    fromjson
  ' | jq -cS . >"$expected"
  expected_sha=$(sha256_file "$expected")
  IFS=$'\t' read -r current_sha current_etag < <(tailscale_policy_identity)
  [[ $current_sha == "$expected_sha" && -n $current_etag ]]
  rm -f "$expected"
}

assert_plan_excludes_credentials() {
  local plan=$1 variable value
  for variable in AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN PROXMOX_VE_API_TOKEN \
    OMADA_PASSWORD TAILSCALE_OAUTH_CLIENT_SECRET; do
    value=${!variable:-}
    [[ -z $value ]] && continue
    PLAN_FILE="$plan" SECRET_VALUE="$value" python3 - <<'PY'
import os
from pathlib import Path

if os.environ["SECRET_VALUE"].encode() in Path(os.environ["PLAN_FILE"]).read_bytes():
    raise SystemExit("saved plan contains a provider credential")
PY
  done
}

backend_init() {
  local root=$1
  tofu -chdir="infrastructure/tofu/$root" init -input=false -reconfigure \
    -backend-config="bucket=$backend_bucket" \
    -backend-config="region=$aws_region" \
    -backend-config="encrypt=true" \
    -backend-config="use_lockfile=true" >/dev/null
}

policy_args() {
  local root=$1 mode=normal
  if [[ $phase == recovery && $root == proxmox ]]; then
    mode=recovery
  fi
  printf '%s\0' --mode "$mode"
  if [[ $mode == recovery ]]; then
    printf '%s\0' --recovery-expectations "$plan_dir/recovery-expectations.json"
  fi
  if [[ -f infrastructure/policy/allow/$root.txt ]]; then
    printf '%s\0' --allow-change-file "$repo_root/infrastructure/policy/allow/$root.txt"
  fi
}

root_plan_args() {
  local root=$1
  if [[ $root == proxmox ]]; then
    printf '%s\0' -var="phase=$phase"
  fi
  if [[ $root == omada && ${TF_VAR_omada_enable_management:-false} == true ]]; then
    printf '%s\0' -var="omada_export_path=$repo_root/.local/omada/export.json"
  fi
}

plan_all() {
  rm -rf "$plan_dir"
  mkdir -p "$plan_dir"
  chmod 0700 "$plan_dir"
  local records="$plan_dir/records.ndjson"
  : >"$records"

  ./scripts/validate-contract
  if [[ $phase == recovery ]]; then
    node scripts/controller/build-recovery-expectations.js \
      --output "$plan_dir/recovery-expectations.json"
  fi
  ./scripts/validate-provider-locks

  local root plan plan_log exit_code tailscale_live_policy_sha256 tailscale_policy_before_sha256 tailscale_policy_after_sha256 tailscale_policy_etag tailscale_policy_changed
  local planned_before_policy planned_after_policy compose_hash recovery_backup_identity_sha256 recovery_expectations_sha256 ansible_extra_vars_file_sha256
  for root in "${roots[@]}"; do
    echo "Planning OpenTofu root: $root"
    backend_init "$root"
    tailscale_live_policy_sha256=""
    tailscale_policy_before_sha256=""
    tailscale_policy_after_sha256=""
    tailscale_policy_etag=""
    if [[ $root == tailscale && ${TF_VAR_tailscale_enable_management:-false} == true ]]; then
      IFS=$'\t' read -r tailscale_live_policy_sha256 tailscale_policy_etag < <(tailscale_policy_identity)
    fi
    plan="$plan_dir/$root.tfplan"
    mapfile -d '' -t plan_args < <(root_plan_args "$root")
    plan_log="$plan_dir/$root.plan.log"
    : >"$plan_log"
    chmod 0600 "$plan_log"
    set +e
    tofu -chdir="infrastructure/tofu/$root" plan -input=false -lock-timeout=5m -no-color \
      -parallelism=1 -detailed-exitcode -out="$plan" "${plan_args[@]}" >"$plan_log" 2>&1
    exit_code=$?
    set -e
    [[ $exit_code == 0 || $exit_code == 2 ]] || {
      echo "OpenTofu planning failed for $root; inspect the protected local plan log." >&2
      exit "$exit_code"
    }
    assert_plan_excludes_credentials "$plan"
    tailscale_policy_changed=false
    if [[ $root == tailscale && ${TF_VAR_tailscale_enable_management:-false} == true ]]; then
      planned_before_policy=$(mktemp "${TMPDIR:-/tmp}/tailscale-planned-before.XXXXXX")
      planned_after_policy=$(mktemp "${TMPDIR:-/tmp}/tailscale-planned-after.XXXXXX")
      chmod 0600 "$planned_before_policy" "$planned_after_policy"
      tailscale_planned_policy "$plan" before "$planned_before_policy"
      tailscale_planned_policy "$plan" after "$planned_after_policy"
      tailscale_policy_before_sha256=$(sha256_file "$planned_before_policy")
      tailscale_policy_after_sha256=$(sha256_file "$planned_after_policy")
      rm -f "$planned_before_policy" "$planned_after_policy"
      python3 scripts/controller/tailscale-gateway-policy.py validate-before-identity \
        --planned-before-sha "$tailscale_policy_before_sha256" \
        --live-before-sha "$tailscale_live_policy_sha256"
      [[ $tailscale_policy_after_sha256 == "$tailscale_policy_before_sha256" ]] || tailscale_policy_changed=true
    fi

    mapfile -d '' -t inspect_args < <(policy_args "$root")
    TOFU_PLAN_CHDIR="infrastructure/tofu/$root" ./scripts/inspect-tofu-plan "$plan" "${inspect_args[@]}"
    jq -cn \
      --arg root "$root" \
      --arg file "$(basename "$plan")" \
      --arg sha256 "$(sha256_file "$plan")" \
      --arg tailscale_policy_before_sha256 "$tailscale_policy_before_sha256" \
      --arg tailscale_policy_after_sha256 "$tailscale_policy_after_sha256" \
      --arg tailscale_policy_etag "$tailscale_policy_etag" \
      --argjson changed "$([[ $exit_code == 2 || $tailscale_policy_changed == true ]] && echo true || echo false)" \
      '{root: $root, file: $file, sha256: $sha256, changed: $changed,
        tailscale_policy_before_sha256: $tailscale_policy_before_sha256,
        tailscale_policy_after_sha256: $tailscale_policy_after_sha256,
        tailscale_policy_etag: $tailscale_policy_etag}' >>"$records"
  done

  compose_hash=$(python3 scripts/compose-artifact.py hash)
  recovery_backup_identity_sha256=$(recovery_expected_backup_identity_sha256)
  ansible_extra_vars_file_sha256=$(ansible_extra_vars_sha256)
  recovery_expectations_sha256=""
  if [[ $phase == recovery ]]; then
    recovery_expectations_sha256=$(sha256_file "$plan_dir/recovery-expectations.json")
  fi
  jq -s \
    --arg commit "$commit" \
    --arg phase "$phase" \
    --arg backend_bucket "$backend_bucket" \
    --arg compose_hash "$compose_hash" \
    --arg recovery_backup_identity_sha256 "$recovery_backup_identity_sha256" \
    --arg recovery_expectations_sha256 "$recovery_expectations_sha256" \
    --arg ansible_extra_vars_file_sha256 "$ansible_extra_vars_file_sha256" \
    '{version: 3, commit: $commit, phase: $phase,
      backend_bucket: $backend_bucket,
      ansible_extra_vars_file_sha256: $ansible_extra_vars_file_sha256,
      recovery_backup_identity_sha256: $recovery_backup_identity_sha256,
      recovery_expectations_sha256: $recovery_expectations_sha256,
      compose_artifact_sha256: $compose_hash, plans: .}' \
    "$records" >"$plan_dir/manifest.json"
  rm -f "$records"
  chmod 0600 "$plan_dir"/*
  echo "Saved reviewed plans and manifest under $plan_dir"
}

trap 'exit 130' INT
trap 'exit 143' TERM

verify_manifest() {
  local manifest="$plan_dir/manifest.json"
  [[ -f $manifest ]] || { echo "saved-plan manifest is missing" >&2; exit 66; }
  jq -e '
    .version == 3 and
    (.commit | test("^[0-9a-f]{40}$")) and
    (.phase == "steady" or .phase == "recovery") and
    (.backend_bucket | type) == "string" and
    (.compose_artifact_sha256 | test("^[0-9a-f]{64}$")) and
    (.ansible_extra_vars_file_sha256 | type) == "string" and
    (.recovery_backup_identity_sha256 | type) == "string" and
    (.recovery_expectations_sha256 | type) == "string" and
    (if .phase == "recovery" then
      (.ansible_extra_vars_file_sha256 | test("^[0-9a-f]{64}$")) and
      (.recovery_expectations_sha256 | test("^[0-9a-f]{64}$"))
    else
      ((.ansible_extra_vars_file_sha256 == "") or (.ansible_extra_vars_file_sha256 | test("^[0-9a-f]{64}$"))) and
      .recovery_expectations_sha256 == ""
    end) and
    ((keys | sort) == (["ansible_extra_vars_file_sha256", "backend_bucket", "commit", "compose_artifact_sha256", "phase", "plans", "recovery_backup_identity_sha256", "recovery_expectations_sha256", "version"] | sort))
  ' "$manifest" >/dev/null || {
    echo "saved-plan manifest metadata is invalid" >&2
    exit 66
  }
  [[ $(jq -r .commit "$manifest") == "$commit" ]]
  [[ $(jq -r .phase "$manifest") == "$phase" ]]
  [[ $(jq -r .backend_bucket "$manifest") == "$backend_bucket" ]]
  [[ $(jq -r .compose_artifact_sha256 "$manifest") == "$(python3 scripts/compose-artifact.py hash)" ]]
  if [[ $(jq -r .ansible_extra_vars_file_sha256 "$manifest") != "$(ansible_extra_vars_sha256)" ]]; then
    echo "protected Ansible extra-vars file is missing or changed since planning" >&2
    exit 66
  fi
  [[ $(jq -r .recovery_backup_identity_sha256 "$manifest") == "$(recovery_expected_backup_identity_sha256)" ]]
  if [[ $phase == recovery ]]; then
    local regenerated_expectations
    regenerated_expectations=$(mktemp "${TMPDIR:-/tmp}/recovery-expectations.XXXXXX")
    node scripts/controller/build-recovery-expectations.js --output "$regenerated_expectations"
    if [[ ! -f $plan_dir/recovery-expectations.json ]] || \
      [[ $(sha256_file "$plan_dir/recovery-expectations.json") != "$(jq -r .recovery_expectations_sha256 "$manifest")" ]] || \
      ! cmp -s "$regenerated_expectations" "$plan_dir/recovery-expectations.json"; then
      rm -f "$regenerated_expectations"
      echo "saved recovery expectations are missing, modified, or differ from protected inputs" >&2
      exit 66
    fi
    rm -f "$regenerated_expectations"
  fi

  local expected_roots
  expected_roots=$(printf '%s\n' "${roots[@]}" | jq -R . | jq -s 'sort')
  jq -e --argjson expected "$expected_roots" '
    ([.plans[].root] | sort) == $expected and
    ([.plans[].root] | length) == ([.plans[].root] | unique | length) and
    all(.plans[];
      .file == (.root + ".tfplan") and
      (.sha256 | test("^[0-9a-f]{64}$")) and
      (.changed | type) == "boolean" and
      if .root == "tailscale" then
        (.tailscale_policy_before_sha256 | test("^[0-9a-f]{64}$")) and
        (.tailscale_policy_after_sha256 | test("^[0-9a-f]{64}$")) and
        (.tailscale_policy_etag | test("^(W/)?\\\"[^\\\"[:cntrl:]]+\\\"$"))
      else
        .tailscale_policy_before_sha256 == "" and
        .tailscale_policy_after_sha256 == "" and
        .tailscale_policy_etag == ""
      end)
  ' "$manifest" >/dev/null || {
    echo "saved-plan manifest root set, paths, or hashes are invalid" >&2
    exit 66
  }

  local root file expected expected_policy_before_sha256 expected_policy_after_sha256
  while IFS=$'\t' read -r root file expected; do
    [[ -f $plan_dir/$file ]]
    [[ $(sha256_file "$plan_dir/$file") == "$expected" ]]
    backend_init "$root"
    if [[ $root == tailscale ]]; then
      expected_policy_before_sha256=$(jq -r '.plans[] | select(.root == "tailscale") | .tailscale_policy_before_sha256' "$manifest")
      expected_policy_after_sha256=$(jq -r '.plans[] | select(.root == "tailscale") | .tailscale_policy_after_sha256' "$manifest")
      tailscale_verify_planned_policy_hashes "$plan_dir/$file" \
        "$expected_policy_before_sha256" "$expected_policy_after_sha256"
    fi
    mapfile -d '' -t inspect_args < <(policy_args "$root")
    TOFU_PLAN_CHDIR="infrastructure/tofu/$root" ./scripts/inspect-tofu-plan "$plan_dir/$file" "${inspect_args[@]}"
  done < <(jq -r '.plans[] | [.root, .file, .sha256] | @tsv' "$manifest")
}


apply_root() {
  local root=$1
  if ! jq -e --arg root "$root" 'any(.plans[]; .root == $root)' "$plan_dir/manifest.json" >/dev/null; then
    echo "Skipping disabled OpenTofu root: $root"
    return
  fi
  local plan_file changed expected_policy_before_sha256 expected_policy_after_sha256 expected_policy_etag apply_log exit_code
  local old_proxmox=${PROXMOX_VE_API_TOKEN:-}
  plan_file=$(jq -r --arg root "$root" '.plans[] | select(.root == $root) | .file' "$plan_dir/manifest.json")
  changed=$(jq -r --arg root "$root" '.plans[] | select(.root == $root) | .changed' "$plan_dir/manifest.json")
  backend_init "$root"
  case "$root" in
    proxmox|proxmox-legacy)
      [[ $changed == false || -n ${PROXMOX_APPLY_API_TOKEN:-} ]] || {
        echo "The separated Proxmox apply API token is required." >&2
        exit 66
      }
      [[ -z ${PROXMOX_APPLY_API_TOKEN:-} ]] || export PROXMOX_VE_API_TOKEN=$PROXMOX_APPLY_API_TOKEN
      ;;
    omada)
      [[ $changed == false || (-n ${OMADA_USERNAME:-} && -n ${OMADA_PASSWORD:-}) ]] || {
        echo "The local Omada apply credential is required." >&2
        exit 66
      }
      ;;
    tailscale)
      [[ $changed == false || (-n ${TAILSCALE_OAUTH_CLIENT_ID:-} && -n ${TAILSCALE_OAUTH_CLIENT_SECRET:-}) ]] || {
        echo "The local Tailscale apply OAuth client is required." >&2
        exit 66
      }
      ;;
  esac
  if [[ $root == tailscale ]]; then
    expected_policy_before_sha256=$(jq -r --arg root "$root" '.plans[] | select(.root == $root) | .tailscale_policy_before_sha256' "$plan_dir/manifest.json")
    expected_policy_after_sha256=$(jq -r --arg root "$root" '.plans[] | select(.root == $root) | .tailscale_policy_after_sha256' "$plan_dir/manifest.json")
    expected_policy_etag=$(jq -r --arg root "$root" '.plans[] | select(.root == $root) | .tailscale_policy_etag' "$plan_dir/manifest.json")
    if [[ $expected_policy_before_sha256 != "$expected_policy_after_sha256" ]]; then
      tailscale_apply_planned_policy "$plan_dir/$plan_file" \
        "$expected_policy_before_sha256" "$expected_policy_after_sha256" "$expected_policy_etag"
    fi
  fi
  echo "Applying exact saved OpenTofu plan: $root"
  apply_log="$plan_dir/$root.apply.log"
  : >"$apply_log"
  chmod 0600 "$apply_log"
  set +e
  tofu -chdir="infrastructure/tofu/$root" apply -input=false -lock-timeout=5m -no-color \
    -parallelism=1 -auto-approve "$plan_dir/$plan_file" >"$apply_log" 2>&1
  exit_code=$?
  set -e
  [[ $exit_code == 0 ]] || {
    echo "OpenTofu apply failed for $root; inspect the protected local apply log." >&2
    exit "$exit_code"
  }
  if [[ $root == tailscale && ${TF_VAR_tailscale_enable_management:-false} == true ]]; then
    tailscale_verify_state_policy
  fi
  export PROXMOX_VE_API_TOKEN=$old_proxmox
}

ansible_extra_args=()
if [[ -n ${RECONCILE_ANSIBLE_EXTRA_VARS_FILE:-} ]]; then
  if [[ $RECONCILE_ANSIBLE_EXTRA_VARS_FILE != /* ]]; then
    RECONCILE_ANSIBLE_EXTRA_VARS_FILE="$repo_root/$RECONCILE_ANSIBLE_EXTRA_VARS_FILE"
  fi
  [[ -f $RECONCILE_ANSIBLE_EXTRA_VARS_FILE ]] || {
    echo "RECONCILE_ANSIBLE_EXTRA_VARS_FILE does not exist" >&2
    exit 66
  }
  require_protected_regular_file "$RECONCILE_ANSIBLE_EXTRA_VARS_FILE" "Ansible extra-vars file"
  ansible_extra_args+=(--extra-vars "@$RECONCILE_ANSIBLE_EXTRA_VARS_FILE")
fi

if [[ $phase == recovery ]]; then
  [[ -n ${RECONCILE_ANSIBLE_EXTRA_VARS_FILE:-} ]] || {
    echo "recovery requires RECONCILE_ANSIBLE_EXTRA_VARS_FILE" >&2
    exit 66
  }
fi

ansible_checked_apply() {
  local inventory=$1 playbook=$2 label=$3 host=$4
  shift 4
  local first second first_normalized second_normalized postcheck planned_changes
  first=$(mktemp)
  second=$(mktemp)
  first_normalized=$(mktemp)
  second_normalized=$(mktemp)
  ansible-inventory -i "$inventory" --list | jq -e --arg host "$host" '._meta.hostvars | has($host)' >/dev/null
  ansible-playbook -i "$inventory" "$playbook" --check --diff "${ansible_extra_args[@]}" "$@" 2>&1 | tee "$first"
  ansible-playbook -i "$inventory" "$playbook" --check --diff "${ansible_extra_args[@]}" "$@" 2>&1 | tee "$second"
  python3 "$repo_root/scripts/controller/normalize-ansible-plan.py" "$first" >"$first_normalized"
  python3 "$repo_root/scripts/controller/normalize-ansible-plan.py" "$second" >"$second_normalized"
  if [[ $(sha256_file "$first_normalized") != "$(sha256_file "$second_normalized")" ]]; then
    rm -f "$first" "$second" "$first_normalized" "$second_normalized"
    echo "$label Ansible plan was not reproducible; refusing apply." >&2
    exit 1
  fi
  planned_changes=$(python3 "$repo_root/scripts/controller/parse-ansible-recap.py" "$first" "$host" \
    | jq -er 'select(.unreachable == 0 and .failed == 0) | .changed')
  rm -f "$first" "$second" "$first_normalized" "$second_normalized"
  if [[ $planned_changes == 0 ]]; then
    echo "$label Ansible plan is already a no-op; skipping normal apply."
    return
  fi
  ansible-playbook -i "$inventory" "$playbook" "${ansible_extra_args[@]}" "$@"
  postcheck=$(mktemp)
  ansible-playbook -i "$inventory" "$playbook" --check --diff "${ansible_extra_args[@]}" "$@" 2>&1 | tee "$postcheck"
  python3 "$repo_root/scripts/controller/parse-ansible-recap.py" "$postcheck" "$host" \
    | jq -e '.changed == 0 and .unreachable == 0 and .failed == 0' >/dev/null
  rm -f "$postcheck"
}

ansible_require_noop() {
  local inventory=$1 playbook=$2 host=$3
  shift 3
  local check_log
  check_log=$(mktemp)
  ansible-inventory -i "$inventory" --list | jq -e --arg host "$host" '._meta.hostvars | has($host)' >/dev/null
  echo "Auditing Ansible no-op: $playbook host=$host"
  ansible-playbook -i "$inventory" "$playbook" --check --diff "${ansible_extra_args[@]}" "$@" 2>&1 | tee "$check_log"
  python3 "$repo_root/scripts/controller/parse-ansible-recap.py" "$check_log" "$host" \
    | jq -e '.changed == 0 and .unreachable == 0 and .failed == 0' >/dev/null
  rm -f "$check_log"
}

apply_arch_steady() {
  local tag
  echo "Deferring the separately gated Arch network migration and unpublished Coral artifact during routine steady convergence."
  for tag in base tailscale ssh storage docker sops_age hardware host_files compose; do
    ansible_checked_apply "$arch_inventory" playbooks/site.yml "Arch/$tag" docker-host-production \
      --tags "$tag" -e iac_apply_confirmed=true -e "iac_apply_tag=$tag" \
      -e arch_ssh_access_proven=true
  done
}

compose_apply() {
  local artifact_root artifact_hash plan_log plan_hash repeat_log repeat_hash postcheck_log
  artifact_root=$(mktemp -d)
  artifact_hash=$(python3 scripts/compose-artifact.py copy "$artifact_root")
  pushd ansible >/dev/null
  ansible-playbook -i "$arch_inventory" playbooks/stage-compose.yml \
    "${ansible_extra_args[@]}" \
    -e "compose_artifact_hash=$artifact_hash" \
    -e "compose_artifact_controller_dir=$artifact_root" \
    -e compose_stage_confirmed=true
  plan_log=$(mktemp)
  repeat_log=$(mktemp)
  postcheck_log=$(mktemp)
  ansible-playbook -i "$arch_inventory" playbooks/deploy-compose.yml --check --diff \
    "${ansible_extra_args[@]}" -e "compose_artifact_hash=$artifact_hash" | tee "$plan_log"
  plan_hash=$(grep -oE 'compose_deploy_plan_sha256=[0-9a-f]{64}' "$plan_log" | cut -d= -f2 | sort -u)
  ansible-playbook -i "$arch_inventory" playbooks/deploy-compose.yml --check --diff \
    "${ansible_extra_args[@]}" -e "compose_artifact_hash=$artifact_hash" | tee "$repeat_log"
  repeat_hash=$(grep -oE 'compose_deploy_plan_sha256=[0-9a-f]{64}' "$repeat_log" | cut -d= -f2 | sort -u)
  [[ $plan_hash =~ ^[0-9a-f]{64}$ && $plan_hash == "$repeat_hash" ]]
  ansible-playbook -i "$arch_inventory" playbooks/deploy-compose.yml \
    "${ansible_extra_args[@]}" \
    -e "compose_artifact_hash=$artifact_hash" \
    -e compose_deploy_confirmed=true
  ansible-playbook -i "$arch_inventory" playbooks/deploy-compose.yml --check --diff \
    "${ansible_extra_args[@]}" -e "compose_artifact_hash=$artifact_hash" | tee "$postcheck_log"
  python3 "$repo_root/scripts/controller/parse-ansible-recap.py" "$postcheck_log" docker-host-production \
    | jq -e '.changed == 0 and .unreachable == 0 and .failed == 0' >/dev/null
  popd >/dev/null
  rm -rf "$artifact_root" "$plan_log" "$repeat_log" "$postcheck_log"
}

compose_recovery_apply() {
  local artifact_root artifact_hash first_log second_log first_hash second_hash
  artifact_root=$(mktemp -d)
  first_log=$(mktemp)
  second_log=$(mktemp)
  artifact_hash=$(python3 scripts/compose-artifact.py copy "$artifact_root")
  pushd ansible >/dev/null
  ansible-playbook -i "$arch_inventory" playbooks/stage-compose.yml \
    "${ansible_extra_args[@]}" \
    -e "compose_artifact_hash=$artifact_hash" \
    -e "compose_artifact_controller_dir=$artifact_root" \
    -e compose_stage_confirmed=true \
    -e compose_stage_fresh_recovery=true
  ansible-playbook -i "$arch_inventory" playbooks/disaster-recovery.yml \
    "${ansible_extra_args[@]}"
  ansible-playbook -i "$arch_inventory" playbooks/plan-compose-recovery.yml \
    "${ansible_extra_args[@]}" -e "compose_artifact_hash=$artifact_hash" | tee "$first_log"
  ansible-playbook -i "$arch_inventory" playbooks/plan-compose-recovery.yml \
    "${ansible_extra_args[@]}" -e "compose_artifact_hash=$artifact_hash" | tee "$second_log"
  first_hash=$(grep -oE 'compose_recovery_plan_sha256=[0-9a-f]{64}' "$first_log" | cut -d= -f2 | sort -u)
  second_hash=$(grep -oE 'compose_recovery_plan_sha256=[0-9a-f]{64}' "$second_log" | cut -d= -f2 | sort -u)
  [[ $first_hash =~ ^[0-9a-f]{64}$ && $first_hash == "$second_hash" ]]
  ansible-playbook -i "$arch_inventory" playbooks/recover-compose.yml \
    "${ansible_extra_args[@]}" \
    -e "compose_artifact_hash=$artifact_hash" \
    -e "compose_recovery_expected_plan_sha256=$first_hash" \
    -e compose_recovery_confirmed=true
  postcheck_log=$(mktemp)
  ansible-playbook -i "$arch_inventory" playbooks/deploy-compose.yml --check --diff \
    "${ansible_extra_args[@]}" -e "compose_artifact_hash=$artifact_hash" | tee "$postcheck_log"
  python3 "$repo_root/scripts/controller/parse-ansible-recap.py" "$postcheck_log" docker-host-production \
    | jq -e '.changed == 0 and .unreachable == 0 and .failed == 0' >/dev/null
  rm -f "$postcheck_log"
  popd >/dev/null
  rm -rf "$artifact_root" "$first_log" "$second_log"
}

verify_all() {
  local root exit_code verify_log
  for root in "${roots[@]}"; do
    backend_init "$root"
    mapfile -d '' -t plan_args < <(root_plan_args "$root")
    verify_log="$plan_dir/$root.verify.log"
    : >"$verify_log"
    chmod 0600 "$verify_log"
    set +e
    tofu -chdir="infrastructure/tofu/$root" plan -input=false -lock-timeout=5m -no-color \
      -parallelism=1 -detailed-exitcode "${plan_args[@]}" >"$verify_log" 2>&1
    exit_code=$?
    set -e
    [[ $exit_code == 0 ]] || {
      echo "OpenTofu root is not converged: $root; inspect the protected local verification log." >&2
      exit 1
    }
    if [[ $root == tailscale && ${TF_VAR_tailscale_enable_management:-false} == true ]]; then
      tailscale_verify_state_policy
    fi
  done
  pushd ansible >/dev/null
  ansible_require_noop "$proxmox_inventory" playbooks/proxmox-site.yml proxmox \
    -e proxmox_ssh_access_proven=true
  ansible_require_noop "$arch_inventory" playbooks/audit.yml docker-host-production
  if [[ $phase == recovery ]]; then
    ansible_require_noop "$arch_inventory" playbooks/arch-bootstrap.yml docker-host-production
  fi
  popd >/dev/null
}


apply_lock_dir="$repo_root/.reconcile/controller-apply.lock"
apply_lock_acquired=false

cleanup_apply_lock() {
  if [[ $apply_lock_acquired == true ]]; then
    rm -f "$apply_lock_dir/owner"
    rmdir "$apply_lock_dir" 2>/dev/null || true
    apply_lock_acquired=false
  fi
}

acquire_apply_lock() {
  mkdir -p "$repo_root/.reconcile"
  if ! mkdir "$apply_lock_dir" 2>/dev/null; then
    echo "another controller apply holds $apply_lock_dir" >&2
    exit 75
  fi
  chmod 0700 "$apply_lock_dir"
  printf 'pid=%s commit=%s phase=%s\n' "$$" "$commit" "$phase" >"$apply_lock_dir/owner"
  chmod 0600 "$apply_lock_dir/owner"
  apply_lock_acquired=true
}

trap cleanup_apply_lock EXIT
case "$action" in
  plan)
    plan_all
    ;;
  apply)
    if [[ -n $(git status --porcelain --untracked-files=all) ]]; then
      echo "apply requires a clean checkout" >&2
      exit 65
    fi
    acquire_apply_lock
    verify_manifest
    apply_root aws-foundation
    if [[ $phase == recovery ]]; then
      apply_root tailscale
      pushd ansible >/dev/null
      ansible -i "$proxmox_inventory" proxmox_hosts -m ansible.builtin.ping
      ansible_checked_apply "$proxmox_inventory" playbooks/proxmox-site.yml Proxmox proxmox \
        -e proxmox_ssh_access_proven=true \
        -e proxmox_health_require_vm=false
      popd >/dev/null
      apply_root proxmox
      pushd ansible >/dev/null
      ansible_checked_apply "$arch_bootstrap_inventory" playbooks/arch-bootstrap.yml Arch-bootstrap docker-host-recovery
      ansible -i "$arch_inventory" docker_host -m ansible.builtin.ping
      ansible_checked_apply "$arch_inventory" playbooks/site.yml Arch/ssh docker-host-production \
        --tags ssh -e iac_apply_confirmed=true -e iac_apply_tag=ssh \
        -e arch_ssh_access_proven=true
      popd >/dev/null
    else
      apply_root proxmox-legacy
      apply_root proxmox
      pushd ansible >/dev/null
      ansible_checked_apply "$proxmox_inventory" playbooks/proxmox-site.yml Proxmox proxmox -e proxmox_ssh_access_proven=true
      apply_arch_steady
      popd >/dev/null
    fi

    apply_root omada
    if [[ $phase != recovery ]]; then apply_root tailscale; fi
    if [[ $phase == recovery ]]; then compose_recovery_apply; else compose_apply; fi
    pushd ansible >/dev/null
    if [[ $phase == recovery ]]; then
      ansible_checked_apply "$arch_inventory" playbooks/site.yml Arch/coral docker-host-production \
        --tags coral -e iac_apply_confirmed=true -e iac_apply_tag=coral
    fi
    ansible_checked_apply "$arch_inventory" playbooks/site.yml Arch/maintenance docker-host-production \
      --tags maintenance -e iac_apply_confirmed=true -e iac_apply_tag=maintenance
    popd >/dev/null
    verify_all
    ;;
  verify)
    verify_all
    ;;
esac
