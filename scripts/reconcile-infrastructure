#!/usr/bin/env bash
set -euo pipefail
umask 077
export PYTHONDONTWRITEBYTECODE=1

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

usage() {
  cat >&2 <<'EOF'
usage: scripts/reconcile-infrastructure <validate|plan|apply|apply-tailnet|verify> [options]

Options:
  --phase steady                       Desired reconciliation phase (default: steady)
  --plan-dir <path>                    Protected saved-plan directory
  --boundary-manifest <absolute-path>  Required non-secret controller boundary manifest

Required environment:
  TF_BACKEND_BUCKET                    Existing encrypted OpenTofu state bucket
  AWS credentials and provider TF_VAR_* credentials for every enabled root

Apply requires a clean checkout at the exact manifest commit. Per-root OpenTofu S3 locks and
a controller descriptor lock serialize mutation. Proxmox requires the exact neutral locked
read-only observation capability and independently verified host trust; host mutations are
separate exact transactions, never ordinary convergence.
EOF
  exit 64
}

(($# >= 1)) || usage
reconcile_original_args=("$@")
action=$1
shift
case "$action" in validate|plan|apply|apply-tailnet|verify) ;; *) usage ;; esac
phase=steady
plan_dir="$repo_root/.reconcile/plans"
production_inventory=inventory/production.yml
boundary_manifest=

while (($#)); do
  case "$1" in
    --boundary-manifest)
      (($# >= 2)) || usage
      [[ -z $boundary_manifest ]] || usage
      boundary_manifest=$2
      shift 2
      ;;
    --phase)
      (($# >= 2)) || usage
      phase=$2
      shift 2
      ;;
    --plan-dir)
      (($# >= 2)) || usage
      plan_dir=$2
      shift 2
      ;;
    *) usage ;;
  esac
done

[[ $phase == steady ]] || usage
case "$plan_dir" in
  "$repo_root/.reconcile/"*) ;;
