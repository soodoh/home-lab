#!/usr/bin/env bash
set -euo pipefail

if [[ $(id -u) -ne 0 ]]; then
  echo "must run directly as root" >&2
  exit 77
fi
case "$(tty)" in
  /dev/tty[0-9]*) ;;
  *) echo "physical /dev/ttyN console required" >&2; exit 77 ;;
esac
if [[ $# -ne 5 ]]; then
  echo "usage: $0 PLAN_SHA256 AUTHORIZATION_SHA256 COMMIT OLD_OBSERVER_SHA256 NEW_OBSERVER_SHA256" >&2
  exit 64
fi
plan_sha256=$1
authorization_sha256=$2
commit=$3
old_observer_sha256=$4
new_observer_sha256=$5
for value in "$plan_sha256" "$authorization_sha256" "$old_observer_sha256" "$new_observer_sha256"; do
  [[ $value =~ ^[0-9a-f]{64}$ ]] || exit 64
done
[[ $commit =~ ^[0-9a-f]{40}$ ]] || exit 64

repo=/root/home-lab
helper_root=/usr/local/libexec/home-lab
observer=$helper_root/proxmox-observer
plan_transport=$helper_root/proxmox-ansible-plan-transport
transaction_root=/var/lib/home-lab/observer-upgrade-transactions/$plan_sha256
lock=/run/lock/home-lab-proxmox-observer-upgrade.lock

exec 9>"$lock"
flock -n 9 || { echo "observer upgrade lock is active" >&2; exit 75; }
for active in /var/lib/home-lab/reconciliation/apply.lock /var/lib/iac-ansible-production.lock /var/lib/home-lab/firewall-transaction/active.json; do
  [[ ! -e $active ]] || { echo "conflicting lifecycle lock is active: $active" >&2; exit 75; }
done
[[ -d $repo/.git && ! -L $repo ]] || exit 77
[[ -z $(git -C "$repo" status --porcelain=v1 --untracked-files=all) ]] || { echo "repository is dirty" >&2; exit 65; }
git -C "$repo" fetch --quiet origin main
[[ $(git -C "$repo" rev-parse origin/main) == "$commit" ]] || { echo "origin/main differs" >&2; exit 65; }
git -C "$repo" merge --ff-only "$commit"
[[ $(git -C "$repo" rev-parse HEAD) == "$commit" ]] || exit 65
[[ $(sha256sum "$observer" | cut -d' ' -f1) == "$old_observer_sha256" ]] || { echo "installed observer differs" >&2; exit 65; }

umask 077
mkdir -p "$transaction_root"
chmod 0700 "$transaction_root"
[[ ! -e $transaction_root/committed.json ]] || { echo "transaction already committed" >&2; exit 73; }
cp --preserve=mode,ownership,timestamps "$observer" "$transaction_root/observer.before"
chmod 0600 "$transaction_root/observer.before"
expected=$transaction_root/observer.expected
python3 - "$repo" "$expected" <<'PY'
import importlib.util, json, os, pathlib, sys
repo, target = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
spec = importlib.util.spec_from_file_location("proxmox_bundle_observer_upgrade", repo / "nix/proxmox/bundle.py")
if spec is None or spec.loader is None:
    raise SystemExit("bundle loader differs")
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
projection = json.loads((repo / "nix/proxmox/projection.json").read_bytes())
raw = module.expected_helper_content("proxmox-observer", projection)
fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
with os.fdopen(fd, "wb") as handle:
    handle.write(raw)
    handle.flush()
    os.fsync(handle.fileno())
PY
[[ $(sha256sum "$expected" | cut -d' ' -f1) == "$new_observer_sha256" ]] || { echo "generated observer differs" >&2; exit 65; }

changed=false
rollback() {
  if [[ $changed == true ]]; then
    install -o root -g root -m 0755 "$transaction_root/observer.before" "$observer"
    sync -f "$helper_root"
  fi
}
trap rollback ERR HUP INT TERM
install -o root -g root -m 0755 "$expected" "$observer.new"
sync "$observer.new"
changed=true
mv -T "$observer.new" "$observer"
sync -f "$helper_root"
[[ $(sha256sum "$observer" | cut -d' ' -f1) == "$new_observer_sha256" ]]
[[ $(stat -c '%u:%g:%a:%h' "$observer") == 0:0:755:1 ]]
observation=$(runuser -u ansible-plan -- "$plan_transport" -c observe)
printf '%s' "$observation" | EXPECTED_SHA256=$new_observer_sha256 python3 -c 'import json,os,sys; v=json.load(sys.stdin); assert v["format"] == "home-lab-proxmox-observation-v1" and v["protocolVersion"] == 4 and v["observerSha256"] == os.environ["EXPECTED_SHA256"]'

PLAN_SHA256=$plan_sha256 AUTHORIZATION_SHA256=$authorization_sha256 COMMIT=$commit OBSERVER_SHA256=$new_observer_sha256 \
python3 - "$transaction_root/committed.json" <<'PY'
import json, os, pathlib, sys
path = pathlib.Path(sys.argv[1])
value = {
    "authorization_sha256": os.environ["AUTHORIZATION_SHA256"],
    "changed": True,
    "commit": os.environ["COMMIT"],
    "format": "home-lab-proxmox-observer-upgrade-install-v1",
    "observer_sha256": os.environ["OBSERVER_SHA256"],
    "plan_sha256": os.environ["PLAN_SHA256"],
}
raw = (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
with os.fdopen(fd, "wb") as handle:
    handle.write(raw)
    handle.flush()
    os.fsync(handle.fileno())
directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
try:
    os.fsync(directory)
finally:
    os.close(directory)
print(json.dumps(value, sort_keys=True))
PY
trap - ERR HUP INT TERM
