#!/bin/bash
set -euo pipefail

readonly CONFIRMATION=qualify-reviewed-vm-100-debian-13-inert

[[ $# -eq 0 ]] || { echo "usage: scripts/run-debian-inert-qualification" >&2; exit 1; }
[[ -t 0 ]] || { echo "Debian qualification requires confirmation from an interactive physical console" >&2; exit 1; }
printf 'Type the exact confirmation to image scsi3 and qualify inert Debian:\n%s\n' "$CONFIRMATION" >&2
IFS= read -r confirmation
[[ $confirmation == "$CONFIRMATION" ]] || { echo "exact Debian qualification confirmation is required" >&2; exit 1; }
export HOME_LAB_DEBIAN_QUALIFICATION_CONFIRMED=$CONFIRMATION
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
exec "$root/scripts/qualify-debian-inert"
