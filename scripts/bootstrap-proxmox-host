#!/usr/bin/env bash
set -euo pipefail
umask 077

[[ $EUID -eq 0 ]]
mode=
repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"
[[ -z $(git status --porcelain --untracked-files=all) ]]

extra_vars=
hardware_env=
while (($#)); do
  case "$1" in
    --extra-vars) extra_vars=${2:?}; shift 2 ;;
    --hardware-env) hardware_env=${2:?}; shift 2 ;;
    --mode) mode=${2:?}; shift 2 ;;
    *) exit 64 ;;
  esac
done
[[ -f $extra_vars && -f $hardware_env ]]
case "$mode" in check|apply) ;; *) exit 64 ;; esac
for file in "$extra_vars" "$hardware_env"; do
  [[ $(stat -c %u "$file") == 0 ]]
  permissions=$(stat -c %a "$file")
  (( (8#$permissions & 8#077) == 0 ))
done
extra_vars=$(realpath "$extra_vars")
hardware_env=$(realpath "$hardware_env")

while IFS='=' read -r key value; do
  [[ $key =~ ^HOMELAB_(GAMES_DISK_BY_ID|ZFS_POOL_GUID|ZFS_MEMBER_[0-9]{2}_BY_ID|(ZIGBEE|ZWAVE)_USB_(SERIAL|PORT))$ ]]
  [[ -n $value ]]
  export "$key=$value"
done <"$hardware_env"
: "${HOMELAB_GAMES_DISK_BY_ID:?missing protected games disk identity}"
: "${HOMELAB_ZFS_POOL_GUID:?missing protected ZFS pool identity}"
: "${HOMELAB_ZIGBEE_USB_SERIAL:?missing protected Zigbee identity}"
: "${HOMELAB_ZWAVE_USB_SERIAL:?missing protected Z-Wave identity}"
: "${HOMELAB_ZIGBEE_USB_PORT:?missing resolved Zigbee physical USB port}"
: "${HOMELAB_ZWAVE_USB_PORT:?missing resolved Z-Wave physical USB port}"

venv=/root/.cache/home-lab-proxmox-bootstrap-venv
rm -rf "$venv"
cleanup() { rm -rf "$venv"; }
trap cleanup EXIT INT TERM
python3 -m venv "$venv"
"$venv/bin/python" -m pip install --disable-pip-version-check --no-cache-dir \
  --only-binary=:all: --require-hashes \
  --requirement controller/requirements-ansible-controller.lock

playbook=(
  "$venv/bin/ansible-playbook"
  -i inventory/proxmox-local.yml
  playbooks/proxmox-bootstrap.yml
  --extra-vars "@$extra_vars"
)
run_playbook() {
  (
    cd "$repo_root/ansible"
    ANSIBLE_ROLES_PATH="$repo_root/ansible/roles" "${playbook[@]}" "$@"
  )
}
run_playbook --check --diff
if [[ $mode == check ]]; then
  printf 'proxmox_bootstrap=check-only\n'
  exit 0
fi
[[ ${PROXMOX_BOOTSTRAP_EXECUTION_CONFIRMED:-} == run-reviewed-proxmox-bootstrap-with-console ]]
export TAILSCALE_AUTH_KEY=${TAILSCALE_AUTH_KEY:-}
scripts/validate-proxmox-bootstrap-keys >/dev/null
lock_path=/var/lib/iac-ansible-production.lock
if [[ -e $lock_path ]]; then
  [[ ${PROXMOX_BOOTSTRAP_RESUME_CONFIRMED:-} == resume-matching-failed-proxmox-bootstrap ]]
  [[ -d $lock_path && $(stat -c %u "$lock_path") == 0 && $(stat -c %a "$lock_path") == 700 ]]
  owner_file="$lock_path/owner"
  [[ -f $owner_file && $(stat -c %u "$owner_file") == 0 && $(stat -c %a "$owner_file") == 600 ]]
  [[ $(find "$lock_path" -mindepth 1 -maxdepth 1 | wc -l) == 1 ]]
  grep -Eq '^controller=(root|unknown)$' "$owner_file"
  grep -qx 'operation=proxmox-bootstrap' "$owner_file"
  [[ $(grep -c '^started=' "$owner_file") == 1 ]]
  rm "$owner_file"
  rmdir "$lock_path"
  printf 'proxmox_bootstrap=matching-failed-lock-released-for-resume\n'
fi
run_playbook

for token in \
  /root/.config/home-lab/proxmox-plan-token.env \
  /root/.config/home-lab/proxmox-apply-token.env; do
  [[ -f $token && $(stat -c %a "$token") == 600 ]]
done
printf 'proxmox_bootstrap=completed token_files=root-only\n'
