#!/usr/bin/env python3
"""Materialize protected Restic credentials and bootstrap an absent rclone config."""

from configparser import ConfigParser, Error as ConfigError
import os
from pathlib import Path
import subprocess
import sys
import tempfile


REQUIRED = {
    "RESTIC_LOCAL_PASSWORD",
    "RESTIC_PROTON_PASSWORD",
    "PROTON_BACKUP_USERNAME",
    "PROTON_BACKUP_PASSWORD",
}
OPTIONAL = {"PROTON_BACKUP_MAILBOX_PASSWORD"}


def fail(reason: str) -> None:
    print(f"restic_credentials=failed reason={reason}", file=sys.stderr)
    raise SystemExit(1)




def parse_dotenv(raw: str) -> dict[str, str]:
    values: dict[str, str] = {}
    for line in raw.splitlines():
        if not line or line.lstrip().startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        if key == "PROTON_BACKUP_TOTP_SEED":
            fail("proton_totp_seed_forbidden")
        if key not in REQUIRED | OPTIONAL:
            continue
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
            value = value[1:-1]
        if not value or "\x00" in value or "\n" in value:
            fail("credential_value")
        values[key] = value
    if not REQUIRED <= values.keys():
        fail("required_sops_keys_absent")
    if any(len(values[key].encode("utf-8")) < 32 for key in ("RESTIC_LOCAL_PASSWORD", "RESTIC_PROTON_PASSWORD")):
        fail("restic_password_minimum_length")
    if values["RESTIC_LOCAL_PASSWORD"] == values["RESTIC_PROTON_PASSWORD"]:
        fail("restic_passwords_not_distinct")
    proton_password = values["PROTON_BACKUP_PASSWORD"]
    if len(proton_password.encode("utf-8")) < 40 or not proton_password.isascii() or not proton_password.isalnum():
        fail("proton_login_password_policy")
    if proton_password in {values["RESTIC_LOCAL_PASSWORD"], values["RESTIC_PROTON_PASSWORD"]}:
        fail("proton_login_password_not_distinct")
    return values


def safe_directory(path: Path, uid: int, gid: int, mode: int) -> None:
    metadata = path.lstat()
    if path.is_symlink() or not path.is_dir():
        fail("protected_directory_type")
    if metadata.st_uid != uid or metadata.st_gid != gid or metadata.st_mode & 0o7777 != mode:
        fail("protected_directory_metadata")


def safe_existing(path: Path, uid: int, gid: int, mode: int) -> None:
    metadata = path.lstat()
    if path.is_symlink() or not path.is_file() or metadata.st_nlink != 1:
        fail("protected_file_type")
    if metadata.st_uid != uid or metadata.st_gid != gid or metadata.st_mode & 0o777 != mode:
        fail("protected_file_metadata")


def require_credential_contents(contents: dict[Path, str], uid: int, gid: int, mode: int) -> None:
    for path, expected in contents.items():
        safe_existing(path, uid, gid, mode)
        if path.read_text(encoding="utf-8") != expected:
            fail("credential_drift")


def atomic_write(path: Path, content: str, uid: int, gid: int, mode: int) -> bool:
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        safe_existing(path, uid, gid, mode)
        if path.read_text(encoding="utf-8") == content:
            return False
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, mode)
        os.fchown(descriptor, uid, gid)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        temporary.replace(path)
    finally:
        if temporary.exists():
            temporary.unlink()
    return True


def obscure(value: str) -> str:
    result = subprocess.run(
        ["/usr/local/bin/rclone", "obscure", "-"],
        input=value + "\n",
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        env={"PATH": "/usr/local/bin:/usr/bin:/bin", "HOME": "/var/empty"},
    )
    if result.returncode != 0 or not result.stdout.strip():
        fail("rclone_obscure")
    return result.stdout.strip()


def main() -> None:
    if os.geteuid() != 0 or len(sys.argv) not in {3, 4}:
        fail("usage")
    check_only = len(sys.argv) == 4
    if check_only and sys.argv[3] != "--check":
        fail("usage")
    proton_uid = int(sys.argv[1])
    proton_gid = int(sys.argv[2])
    values = parse_dotenv(sys.stdin.read())
    credential_dir = Path("/etc/home-lab/restic/credentials")
    safe_directory(credential_dir, 0, proton_gid, 0o750)
    credential_contents = {
        credential_dir / "local-password": values["RESTIC_LOCAL_PASSWORD"] + "\n",
        credential_dir / "proton-password": values["RESTIC_PROTON_PASSWORD"] + "\n",
    }
    if check_only:
        require_credential_contents(credential_contents, 0, proton_gid, 0o440)
        changed = False
    else:
        changed = False
        for path, content in credential_contents.items():
            changed = atomic_write(path, content, 0, proton_gid, 0o440) or changed

    config_path = Path("/var/lib/restic-proton/rclone.conf")
    safe_directory(config_path.parent, proton_uid, proton_gid, 0o700)
    if config_path.exists():
        safe_existing(config_path, proton_uid, proton_gid, 0o600)
        config = ConfigParser(interpolation=None)
        try:
            config.read(config_path, encoding="utf-8")
        except (ConfigError, OSError):
            fail("rclone_config_invalid")
        mailbox_required = "PROTON_BACKUP_MAILBOX_PASSWORD" in values
        if config.sections() != ["proton-backup"]:
            fail("rclone_static_identity")
        remote = config["proton-backup"]
        static_fields = {
            "type",
            "username",
            "password",
            "replace_existing_draft",
            "enable_caching",
            "original_file_size",
        }
        cache_fields = {
            "client_uid",
            "client_access_token",
            "client_refresh_token",
            "client_salted_key_pass",
        }
        allowed_fields = static_fields | cache_fields | ({"mailbox_password"} if mailbox_required else set())
        mailbox_present = bool(remote.get("mailbox_password"))
        if (
            not set(remote) <= allowed_fields
            or not static_fields <= set(remote)
            or remote.get("type") != "protondrive"
            or remote.get("username") != values["PROTON_BACKUP_USERNAME"]
            or remote.get("replace_existing_draft") != "true"
            or remote.get("enable_caching") != "true"
            or remote.get("original_file_size") != "true"
            or not remote.get("password")
            or mailbox_present != mailbox_required
        ):
            fail("rclone_static_identity")
    else:
        if check_only:
            fail("rclone_config_absent")
        fields = {
            "type": "protondrive",
            "username": values["PROTON_BACKUP_USERNAME"],
            "password": obscure(values["PROTON_BACKUP_PASSWORD"]),
            "replace_existing_draft": "true",
            "enable_caching": "true",
            "original_file_size": "true",
        }
        mailbox = values.get("PROTON_BACKUP_MAILBOX_PASSWORD")
        if mailbox:
            fields["mailbox_password"] = obscure(mailbox)
        content = "[proton-backup]\n" + "".join(f"{key} = {value}\n" for key, value in fields.items())
        changed = atomic_write(config_path, content, proton_uid, proton_gid, 0o600) or changed
    operation = "validated" if check_only else "materialized"
    print(f"restic_credentials={operation} state={'changed' if changed else 'noop'}")


if __name__ == "__main__":
    main()
