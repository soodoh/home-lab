#!/usr/bin/env bash
set -euo pipefail
umask 077

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

usage() {
  cat >&2 <<'EOF'
usage: scripts/local-controller <plan|apply> <steady|recovery> [options]

Options:
  --config-dir <protected-controller-config-directory>

The controller accepts any clean committed revision. Both commands run validation. Plan uses
read-only credentials, saves the exact plans under .reconcile/plans/<commit>/<operation>, and
displays them after policy checks pass. Apply verifies those saved plans, requires an interactive
confirmation, and only then loads separate mutation credentials. Apply never replans.
EOF
  exit 64
}

(($# >= 2)) || usage
action=$1
operation=$2
shift 2
case "$action" in plan|apply) ;; *) usage ;; esac

config_dir=${HOME_LAB_CONTROLLER_CONFIG_DIR:-$HOME/.config/home-lab/controller}
while (($#)); do
  case "$1" in
    --config-dir)
      (($# >= 2)) || usage
      config_dir=$2
      shift 2
      ;;
    *) usage ;;
  esac
done

case "$operation" in steady|recovery) ;; *) usage ;; esac
operation_args=(--phase "$operation")
expected_confirmation=

commit=$(git rev-parse HEAD)
[[ $commit =~ ^[0-9a-f]{40}$ ]]
[[ -z $(git status --porcelain --untracked-files=all) ]] || {
  echo "local_controller=failed reason=working_tree_not_clean" >&2
  exit 65
}
plan_dir="$repo_root/.reconcile/plans/$commit/$operation"
manifest="$plan_dir/manifest.json"
application_tunnel_socket=

load_credentials() {
  local capability=$1 file="$config_dir/$1-credentials.json" key value encoded
  encoded=$(mktemp "${TMPDIR:-/tmp}/home-lab-controller-credentials.XXXXXX")
  if ! CAPABILITY="$capability" CREDENTIAL_FILE="$file" CONFIG_DIR="$config_dir" python3 - <<'PY' >"$encoded"
import json
import os
from pathlib import Path
import re
import stat
import sys

config_dir = Path(os.environ["CONFIG_DIR"])
path = Path(os.environ["CREDENTIAL_FILE"])
if not config_dir.is_dir() or stat.S_IMODE(config_dir.stat().st_mode) != 0o700:
    raise SystemExit("controller config directory must exist with mode 0700")
if not path.is_file() or path.is_symlink() or stat.S_IMODE(path.stat().st_mode) != 0o600:
    raise SystemExit(f"{os.environ['CAPABILITY']} credential file must be a regular mode-0600 file")
try:
    values = json.loads(path.read_text())
except json.JSONDecodeError as error:
    raise SystemExit("controller credential JSON is invalid") from error
if not isinstance(values, dict) or not values:
    raise SystemExit("controller credential JSON must be a non-empty object")
allowed = re.compile(r"^(AWS|TF|PROXMOX|OMADA|TAILSCALE|RECONCILE|ANSIBLE|SOPS|AGE|HOMELAB)_[A-Za-z0-9_]+$")
blocked = {"BASH_ENV", "ENV", "PATH", "HOME", "SHELLOPTS"}
for key, value in sorted(values.items()):
    if not isinstance(key, str) or allowed.fullmatch(key) is None or key in blocked:
        raise SystemExit("controller credential name is not allowed")
    if not isinstance(value, str) or "\x00" in value:
        raise SystemExit("controller credential value must be a string without NUL bytes")
    sys.stdout.buffer.write(key.encode() + b"\0" + value.encode() + b"\0")
PY
  then
    rm -f "$encoded"
    return 1
  fi
  while IFS= read -r -d '' key && IFS= read -r -d '' value; do
    export "$key=$value"
  done <"$encoded"
  rm -f "$encoded"
}

prepare_provider_tls() {
  scripts/prepare-provider-ca-bundle
  export SSL_CERT_FILE="$repo_root/.local/provider-ca/bundle.pem"
}

use_prepared_provider_tls() {
  local bundle="$repo_root/.local/provider-ca/bundle.pem"
  PROVIDER_CA_BUNDLE="$bundle" python3 - <<'PY'
import os
from pathlib import Path
import stat

path = Path(os.environ["PROVIDER_CA_BUNDLE"])
if not path.is_file() or path.is_symlink():
    raise SystemExit("prepared provider CA bundle must be a regular file")
metadata = path.stat()
if metadata.st_uid != os.getuid() or stat.S_IMODE(metadata.st_mode) != 0o600:
    raise SystemExit("prepared provider CA bundle must be owned by the controller user with mode 0600")
if metadata.st_size == 0:
    raise SystemExit("prepared provider CA bundle must not be empty")
PY
  export SSL_CERT_FILE="$bundle"
}

run_validation() {
  scripts/reconcile-infrastructure validate
}

require_ordinary_mutation_authority() {
  node scripts/controller/check-vm-100-authority.js --require-ordinary-mutation
}

manifest_sha256() {
  shasum -a 256 "$manifest" | awk '{print $1}'
}

prepare_steady_omada_input() {
  if [[ $operation == steady ]]; then
    scripts/prepare-omada-plan-input prepare
  fi
}

stop_application_tunnels() {
  if [[ -n $application_tunnel_socket ]]; then
    scripts/controller/application-api-tunnels stop "$application_tunnel_socket" >/dev/null 2>&1 || true
    application_tunnel_socket=
  fi
}

start_application_tunnels() {
  if [[ ${TF_VAR_media_apps_enable_management:-false} == true ]]; then
    application_tunnel_socket="$repo_root/.reconcile/application-api-tunnels.$$.sock"
    scripts/controller/application-api-tunnels start "$application_tunnel_socket"
    trap stop_application_tunnels EXIT
  fi
}

verify_proxmox_host_plan() {
  local relative path expected_file_sha expected_plan_sha expected_actions actual_file_sha
  relative=$(jq -er '.proxmox_host_plan.file' "$manifest")
  expected_file_sha=$(jq -er '.proxmox_host_plan.file_sha256' "$manifest")
  expected_plan_sha=$(jq -er '.proxmox_host_plan.plan_sha256' "$manifest")
  expected_actions=$(jq -er '.proxmox_host_plan.actions' "$manifest")
  [[ $relative == ".reconcile/plans/$expected_plan_sha.json" && $expected_file_sha =~ ^[0-9a-f]{64}$ &&
     $expected_plan_sha =~ ^[0-9a-f]{64}$ && $expected_actions =~ ^[0-9]+$ ]] || {
    echo "local_controller=failed reason=proxmox_host_manifest_binding_invalid" >&2
    exit 66
  }
  path="$repo_root/$relative"
  [[ -f $path && ! -L $path ]] || {
    echo "local_controller=failed reason=proxmox_host_plan_missing" >&2
    exit 66
  }
  actual_file_sha=$(shasum -a 256 "$path" | awk '{print $1}')
  [[ $actual_file_sha == "$expected_file_sha" ]] || {
    echo "local_controller=failed reason=proxmox_host_plan_hash_mismatch" >&2
    exit 66
  }
  python3 - "$path" "$expected_plan_sha" "$expected_actions" "$(jq -r .stage "$manifest")" <<'PY'
import hashlib
import json
import datetime as dt
import sys
from pathlib import Path
path = Path(sys.argv[1])
repo = Path.cwd()
sys.path.insert(0, str(repo / "nix/proxmox"))
import planner
raw = path.read_bytes()
try:
    value = json.loads(raw)
except json.JSONDecodeError as error:
    raise SystemExit("Proxmox Nix plan JSON is invalid") from error
canonical = (json.dumps(value, ensure_ascii=False, separators=(",", ":"), sort_keys=True) + "\n").encode()
if raw != canonical or not isinstance(value, dict):
    raise SystemExit("Proxmox Nix plan is not canonical")
required = {"actions", "applyEligible", "bindings", "blockers", "findings", "format", "freshness", "mode",
            "observedState", "planSha256", "privatePreconditionsRequired", "status"}
stage = sys.argv[4]
ready = value.get("status") == "ready" and value.get("applyEligible") is True and value.get("blockers") == []
blockers = value.get("blockers")
findings = value.get("findings")
external = value.get("status") == "blocked" and value.get("applyEligible") is False and value.get("actions") == [] and \
    isinstance(blockers, list) and len(blockers) > 0 and all(
        item.get("domain") == "opentofu" and item.get("code") == "opentofu-owner-required" for item in blockers)
vm_start = value.get("status") == "blocked" and value.get("applyEligible") is False and value.get("actions") == [] and \
    isinstance(blockers, list) and isinstance(findings, list) and len(blockers) == 2 and len(findings) == 2 and \
    sum(item.get("domain") == "opentofu" and item.get("code") == "opentofu-owner-required" and item.get("target") == "vm-100" for item in blockers) == 1 and \
    sum(item.get("domain") == "health" and item.get("code") == "review-required" and item.get("target") == "health" for item in blockers) == 1 and \
    sum(item.get("domain") == "opentofu" and item.get("code") == "opentofu-drift" and item.get("target") == "vm-100" for item in findings) == 1 and \
    sum(item.get("domain") == "health" and item.get("code") == "desired-state-drift" and item.get("target") == "health" for item in findings) == 1
stage_valid = ready if stage == "converge" else vm_start if stage == "vm-start-prerequisite" else external
if set(value) != required or value.get("format") != "home-lab-proxmox-plan-v1" or value.get("mode") != "steady" or \
        not stage_valid or value.get("planSha256") != sys.argv[2] or \
        not isinstance(value.get("actions"), list) or len(value["actions"]) != int(sys.argv[3]):
    raise SystemExit("Proxmox Nix plan structure or manifest binding differs")
projection = {key: item for key, item in value.items() if key != "planSha256"}
if hashlib.sha256((json.dumps(projection, ensure_ascii=False, separators=(",", ":"), sort_keys=True) + "\n").encode()).hexdigest() != value["planSha256"]:
    raise SystemExit("Proxmox Nix plan internal digest differs")
try:
    planner.validate_plan(value, json.loads((repo / "nix/proxmox/projection.json").read_bytes()),
                          json.loads((repo / "nix/proxmox/package-manifest.json").read_bytes()))
except (KeyError, TypeError, ValueError) as error:
    raise SystemExit("Proxmox Nix plan semantic validation failed") from error
if dt.datetime.now(dt.timezone.utc) > dt.datetime.fromisoformat(value["freshness"]["validUntil"].replace("Z", "+00:00")):
    raise SystemExit("Proxmox Nix plan has expired")
PY
}

verify_saved_plans() {
  [[ -f $manifest ]] || {
    echo "local_controller=failed reason=manifest_missing" >&2
    exit 66
  }
  jq -e --arg commit "$commit" --arg phase "$operation" '
    .version == 5 and .commit == $commit and .phase == $phase and
    (.stage == "converge" or ($phase == "recovery" and .stage == "external-owner-prerequisite") or ($phase == "steady" and .stage == "vm-start-prerequisite"))
  ' "$manifest" >/dev/null || {
    echo "local_controller=failed reason=manifest_mismatch" >&2
    exit 66
  }
  while IFS=$'\t' read -r file expected; do
    actual=$(shasum -a 256 "$plan_dir/$file" | awk '{print $1}')
    [[ $actual == "$expected" ]] || {
      echo "local_controller=failed reason=plan_hash_mismatch file=$file" >&2
      exit 66
    }
  done < <(jq -r '.plans[] | [.file,.sha256] | @tsv' "$manifest")
  verify_proxmox_host_plan
}

show_saved_plans() {
  local recovery_stage
  verify_saved_plans
  recovery_stage=$(jq -r .stage "$manifest")
  printf '\n[controller-manifest] operation=%s recovery_stage=%s\n' "$operation" "$recovery_stage"
  while IFS=$'\t' read -r root file; do
    printf '\n[%s]\n' "$root"
    tofu -chdir="infrastructure/tofu/$root" show -no-color "$plan_dir/$file"
  done < <(jq -r '.plans[] | [.root,.file] | @tsv' "$manifest")
  printf '\n[proxmox-host-nix]\n'
  jq . "$repo_root/$(jq -r .proxmox_host_plan.file "$manifest")"
}

confirm_apply() {
  local confirmation recovery_stage
  verify_saved_plans
  recovery_stage=$(jq -r .stage "$manifest")
  expected_confirmation="apply-reviewed-$operation-$recovery_stage"
  [[ -t 0 ]] || {
    echo "local_controller=failed reason=interactive_confirmation_required" >&2
    exit 66
  }
  printf 'Ready to apply operation=%s recovery_stage=%s commit=%s manifest_sha256=%s\n' \
    "$operation" "$recovery_stage" "$commit" "$(manifest_sha256)"
  printf 'Type %s to continue: ' "$expected_confirmation" >&2
  IFS= read -r confirmation
  [[ $confirmation == "$expected_confirmation" ]] || {
    echo "local_controller=failed reason=confirmation_invalid" >&2
    exit 66
  }
}

case "$action" in
  plan)
    load_credentials plan
    start_application_tunnels
    prepare_provider_tls
    run_validation
    prepare_steady_omada_input
    scripts/reconcile-infrastructure plan --plan-dir "$plan_dir" "${operation_args[@]}"
    show_saved_plans
    printf 'local_controller=planned operation=%s recovery_stage=%s commit=%s manifest_sha256=%s\n' \
      "$operation" "$(jq -r .stage "$manifest")" "$commit" "$(manifest_sha256)"
    ;;
  apply)
    require_ordinary_mutation_authority
    use_prepared_provider_tls
    run_validation
    confirm_apply
    load_credentials apply
    start_application_tunnels
    prepare_provider_tls
    prepare_steady_omada_input
    scripts/reconcile-infrastructure apply --plan-dir "$plan_dir" "${operation_args[@]}"
    printf 'local_controller=applied operation=%s recovery_stage=%s commit=%s\n' \
      "$operation" "$(jq -r .stage "$manifest")" "$commit"
    ;;
esac
