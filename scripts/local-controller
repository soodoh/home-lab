#!/usr/bin/env bash
set -euo pipefail
umask 077

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

usage() {
  cat >&2 <<'EOF'
usage: scripts/local-controller <plan|apply> <steady|recovery> [options]

Options:
  --config-dir <protected-controller-config-directory>

The controller accepts any clean committed revision. Both commands run validation. Plan uses
read-only credentials, saves the exact plans under .reconcile/plans/<commit>/<operation>, and
displays them after policy checks pass. Apply verifies those saved plans, requires an interactive
confirmation, and only then loads separate mutation credentials. Apply never replans.
EOF
  exit 64
}

(($# >= 2)) || usage
action=$1
operation=$2
shift 2
case "$action" in plan|apply) ;; *) usage ;; esac

config_dir=${HOME_LAB_CONTROLLER_CONFIG_DIR:-$HOME/.config/home-lab/controller}
while (($#)); do
  case "$1" in
    --config-dir)
      (($# >= 2)) || usage
      config_dir=$2
      shift 2
      ;;
    *) usage ;;
  esac
done

case "$operation" in steady|recovery) ;; *) usage ;; esac
operation_args=(--phase "$operation")
expected_confirmation="apply-reviewed-$operation"

commit=$(git rev-parse HEAD)
[[ $commit =~ ^[0-9a-f]{40}$ ]]
[[ -z $(git status --porcelain --untracked-files=all) ]] || {
  echo "local_controller=failed reason=working_tree_not_clean" >&2
  exit 65
}
plan_dir="$repo_root/.reconcile/plans/$commit/$operation"
manifest="$plan_dir/manifest.json"

load_credentials() {
  local capability=$1 file="$config_dir/$1-credentials.json" key value encoded
  encoded=$(mktemp "${TMPDIR:-/tmp}/home-lab-controller-credentials.XXXXXX")
  if ! CAPABILITY="$capability" CREDENTIAL_FILE="$file" CONFIG_DIR="$config_dir" python3 - <<'PY' >"$encoded"
import json
import os
from pathlib import Path
import re
import stat
import sys

config_dir = Path(os.environ["CONFIG_DIR"])
path = Path(os.environ["CREDENTIAL_FILE"])
if not config_dir.is_dir() or stat.S_IMODE(config_dir.stat().st_mode) != 0o700:
    raise SystemExit("controller config directory must exist with mode 0700")
if not path.is_file() or path.is_symlink() or stat.S_IMODE(path.stat().st_mode) != 0o600:
    raise SystemExit(f"{os.environ['CAPABILITY']} credential file must be a regular mode-0600 file")
try:
    values = json.loads(path.read_text())
except json.JSONDecodeError as error:
    raise SystemExit("controller credential JSON is invalid") from error
if not isinstance(values, dict) or not values:
    raise SystemExit("controller credential JSON must be a non-empty object")
allowed = re.compile(r"^(AWS|TF|PROXMOX|OMADA|TAILSCALE|RECONCILE|ANSIBLE|SOPS|AGE|HOMELAB)_[A-Za-z0-9_]+$")
blocked = {"BASH_ENV", "ENV", "PATH", "HOME", "SHELLOPTS"}
for key, value in sorted(values.items()):
    if not isinstance(key, str) or allowed.fullmatch(key) is None or key in blocked:
        raise SystemExit("controller credential name is not allowed")
    if not isinstance(value, str) or "\x00" in value:
        raise SystemExit("controller credential value must be a string without NUL bytes")
    sys.stdout.buffer.write(key.encode() + b"\0" + value.encode() + b"\0")
PY
  then
    rm -f "$encoded"
    return 1
  fi
  while IFS= read -r -d '' key && IFS= read -r -d '' value; do
    export "$key=$value"
  done <"$encoded"
  rm -f "$encoded"
}

prepare_provider_tls() {
  scripts/prepare-provider-ca-bundle
  export SSL_CERT_FILE="$repo_root/.local/provider-ca/bundle.pem"
}

run_validation() {
  scripts/reconcile-infrastructure validate
}

manifest_sha256() {
  shasum -a 256 "$manifest" | awk '{print $1}'
}

prepare_steady_omada_input() {
  if [[ $operation == steady ]]; then
    scripts/prepare-omada-plan-input prepare
  fi
}

verify_saved_plans() {
  [[ -f $manifest ]] || {
    echo "local_controller=failed reason=manifest_missing" >&2
    exit 66
  }
  jq -e --arg commit "$commit" --arg phase "$operation" '
    .version == 3 and .commit == $commit and .phase == $phase
  ' "$manifest" >/dev/null || {
    echo "local_controller=failed reason=manifest_mismatch" >&2
    exit 66
  }
  while IFS=$'\t' read -r file expected; do
    actual=$(shasum -a 256 "$plan_dir/$file" | awk '{print $1}')
    [[ $actual == "$expected" ]] || {
      echo "local_controller=failed reason=plan_hash_mismatch file=$file" >&2
      exit 66
    }
  done < <(jq -r '.plans[] | [.file,.sha256] | @tsv' "$manifest")
}

show_saved_plans() {
  verify_saved_plans
  while IFS=$'\t' read -r root file; do
    printf '\n[%s]\n' "$root"
    tofu -chdir="infrastructure/tofu/$root" show -no-color "$plan_dir/$file"
  done < <(jq -r '.plans[] | [.root,.file] | @tsv' "$manifest")
}

confirm_apply() {
  local confirmation
  verify_saved_plans
  [[ -t 0 ]] || {
    echo "local_controller=failed reason=interactive_confirmation_required" >&2
    exit 66
  }
  printf 'Ready to apply operation=%s commit=%s manifest_sha256=%s\n' \
    "$operation" "$commit" "$(manifest_sha256)"
  printf 'Type %s to continue: ' "$expected_confirmation" >&2
  IFS= read -r confirmation
  [[ $confirmation == "$expected_confirmation" ]] || {
    echo "local_controller=failed reason=confirmation_invalid" >&2
    exit 66
  }
}

case "$action" in
  plan)
    load_credentials plan
    prepare_provider_tls
    run_validation
    prepare_steady_omada_input
    scripts/reconcile-infrastructure plan --plan-dir "$plan_dir" "${operation_args[@]}"
    show_saved_plans
    shadow_result=$(python3 scripts/controller/proxmox-nix-shadow.py capture --phase "$operation")
    [[ $shadow_result =~ ^shadow_state=(pre-bootstrap|shadow-required)\ status=(disabled|ready|blocked)\ evidence_sha256=(none|[0-9a-f]{64})\ evidence_path=([^[:space:]]+)$ ]] || {
      echo "local_controller=failed reason=proxmox_shadow_result_invalid" >&2
      exit 66
    }
    printf '\n%s\n' "$shadow_result"
    shadow_state=${BASH_REMATCH[1]}
    shadow_evidence_sha256=${BASH_REMATCH[3]}
    printf 'local_controller=planned operation=%s commit=%s manifest_sha256=%s shadow_state=%s shadow_evidence_sha256=%s\n' \
      "$operation" "$commit" "$(manifest_sha256)" "$shadow_state" "$shadow_evidence_sha256"
    ;;
  apply)
    run_validation
    confirm_apply
    load_credentials apply
    prepare_provider_tls
    prepare_steady_omada_input
    scripts/reconcile-infrastructure apply --plan-dir "$plan_dir" "${operation_args[@]}"
    printf 'local_controller=applied operation=%s commit=%s\n' "$operation" "$commit"
    ;;
esac
