#!/usr/bin/env bash
set -euo pipefail
umask 077

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

usage() {
  cat >&2 <<'EOF'
usage: scripts/local-controller <validate|plan|review|approve|apply> [operation] [options]

Operations:
  controller-bootstrap | github-state-detach | steady | disk-growth | ct-unprotect | ct-delete
  tailscale-controller-retirement | tailscale-detach | tailscale-retire | recovery

Options:
  --confirmation <non-secret-review-phrase>
  --config-dir <protected-controller-config-directory>

The controller accepts any clean committed revision. Plan and apply load separate mode-0600
JSON credential files from the mode-0700 config directory. Apply consumes only the exact saved
plans under .reconcile/plans/<commit>/<operation> and never replans.
EOF
  exit 64
}

(($# >= 1)) || usage
action=$1
shift
case "$action" in
  validate) operation=validate ;;
  plan|review|approve|apply)
    (($# >= 1)) || usage
    operation=$1
    shift
    ;;
  *) usage ;;
esac

config_dir=${HOME_LAB_CONTROLLER_CONFIG_DIR:-$HOME/.config/home-lab/controller}
confirmation=
while (($#)); do
  case "$1" in
    --confirmation)
      (($# >= 2)) || usage
      confirmation=$2
      shift 2
      ;;
    --config-dir)
      (($# >= 2)) || usage
      config_dir=$2
      shift 2
      ;;
    *) usage ;;
  esac
done

operation_args=()
expected_confirmation=
case "$operation" in
  validate) ;;
  controller-bootstrap)
    operation_args=(--phase steady --controller-bootstrap)
    expected_confirmation=bootstrap-reviewed-local-controller
    ;;
  github-state-detach)
    expected_confirmation=detach-reviewed-github-state
    ;;
  steady)
    operation_args=(--phase steady)
    expected_confirmation=apply-reviewed-steady
    ;;
  disk-growth)
    operation_args=(--phase steady --disk-growth)
    expected_confirmation=grow-reviewed-docker-root-disk
    ;;
  ct-unprotect)
    operation_args=(--phase steady --ct-operation unprotect)
    expected_confirmation=unprotect-reviewed-ct-101
    ;;
  ct-delete)
    operation_args=(--phase steady --ct-operation delete)
    expected_confirmation=delete-reviewed-ct-101
    ;;
  tailscale-controller-retirement)
    operation_args=(--phase steady --tailscale-controller-retirement)
    expected_confirmation=retire-reviewed-tailscale-ci-identities
    ;;
  tailscale-detach)
    operation_args=(--phase steady --tailscale-gateway-operation detach)
    expected_confirmation=detach-reviewed-tailscale-gateway
    ;;
  tailscale-retire)
    operation_args=(--phase steady --tailscale-gateway-operation retire)
    expected_confirmation=retire-reviewed-tailscale-gateway
    ;;
  recovery)
    operation_args=(--phase recovery)
    expected_confirmation=apply-reviewed-recovery
    ;;
  *) usage ;;
esac

if [[ $action == validate ]]; then
  exec scripts/reconcile-infrastructure validate
fi

commit=$(git rev-parse HEAD)
[[ $commit =~ ^[0-9a-f]{40}$ ]]
[[ -z $(git status --porcelain --untracked-files=all) ]] || {
  echo "local_controller=failed reason=working_tree_not_clean" >&2
  exit 65
}
plan_dir="$repo_root/.reconcile/plans/$commit/$operation"
manifest="$plan_dir/manifest.json"
approval="$plan_dir/approval.json"

load_credentials() {
  local capability=$1 file="$config_dir/$1-credentials.json" key value
  while IFS= read -r -d '' key && IFS= read -r -d '' value; do
    export "$key=$value"
  done < <(CAPABILITY="$capability" CREDENTIAL_FILE="$file" CONFIG_DIR="$config_dir" python3 - <<'PY'
import json
import os
from pathlib import Path
import re
import stat
import sys

config_dir = Path(os.environ["CONFIG_DIR"])
path = Path(os.environ["CREDENTIAL_FILE"])
if not config_dir.is_dir() or stat.S_IMODE(config_dir.stat().st_mode) != 0o700:
    raise SystemExit("controller config directory must exist with mode 0700")
if not path.is_file() or path.is_symlink() or stat.S_IMODE(path.stat().st_mode) != 0o600:
    raise SystemExit(f"{os.environ['CAPABILITY']} credential file must be a regular mode-0600 file")
try:
    values = json.loads(path.read_text())
except json.JSONDecodeError as error:
    raise SystemExit("controller credential JSON is invalid") from error
if not isinstance(values, dict) or not values:
    raise SystemExit("controller credential JSON must be a non-empty object")
allowed = re.compile(r"^(AWS|TF|PROXMOX|OMADA|TAILSCALE|RECONCILE|ANSIBLE|SOPS|AGE)_[A-Z0-9_]+$")
blocked = {"BASH_ENV", "ENV", "PATH", "HOME", "SHELLOPTS"}
for key, value in sorted(values.items()):
    if not isinstance(key, str) or allowed.fullmatch(key) is None or key in blocked:
        raise SystemExit("controller credential name is not allowed")
    if not isinstance(value, str) or "\x00" in value:
        raise SystemExit("controller credential value must be a string without NUL bytes")
    sys.stdout.buffer.write(key.encode() + b"\0" + value.encode() + b"\0")
PY
  )
}

prepare_provider_tls() {
  scripts/prepare-provider-ca-bundle
  export SSL_CERT_FILE="$repo_root/.local/provider-ca/bundle.pem"
}

manifest_sha256() {
  shasum -a 256 "$manifest" | awk '{print $1}'
}

case "$action" in
  plan)
    load_credentials plan
    if [[ $operation == controller-bootstrap || $operation == github-state-detach ]]; then export AWS_PROFILE=default; fi
    if [[ $operation == github-state-detach ]]; then
      scripts/detach-github-state plan --plan-dir "$plan_dir"
    else
      prepare_provider_tls
      scripts/reconcile-infrastructure plan --plan-dir "$plan_dir" "${operation_args[@]}"
    fi
    printf 'local_controller=planned operation=%s commit=%s manifest_sha256=%s\n' \
      "$operation" "$commit" "$(manifest_sha256)"
    ;;
  review)
    [[ -f $manifest ]] || { echo "local_controller=failed reason=manifest_missing" >&2; exit 66; }
    jq -e --arg commit "$commit" '.version == 2 and .commit == $commit' "$manifest" >/dev/null
    if [[ $operation == github-state-detach ]]; then
      load_credentials plan
      export AWS_PROFILE=default
      scripts/detach-github-state review --plan-dir "$plan_dir"
    else
      while IFS=$'\t' read -r root file expected; do
        actual=$(shasum -a 256 "$plan_dir/$file" | awk '{print $1}')
        [[ $actual == "$expected" ]]
        printf '\n[%s]\n' "$root"
        tofu -chdir="infrastructure/tofu/$root" show -json "$plan_dir/$file" | jq -r '
          [.resource_changes[]? | select(.change.actions != ["no-op"]) |
            {address, actions: .change.actions}]'
      done < <(jq -r '.plans[] | [.root,.file,.sha256] | @tsv' "$manifest")
    fi
    printf '\nlocal_controller=reviewed operation=%s commit=%s manifest_sha256=%s\n' \
      "$operation" "$commit" "$(manifest_sha256)"
    ;;
  approve)
    [[ -f $manifest ]] || { echo "local_controller=failed reason=manifest_missing" >&2; exit 66; }
    [[ $confirmation == "$expected_confirmation" ]] || {
      echo "local_controller=failed reason=confirmation_invalid" >&2
      exit 66
    }
    MANIFEST_SHA256=$(manifest_sha256) COMMIT="$commit" OPERATION="$operation" \
      APPROVAL_FILE="$approval" python3 - <<'PY'
import json
import os
from pathlib import Path
import tempfile
from datetime import datetime, timezone

value = {
    "version": 1,
    "commit": os.environ["COMMIT"],
    "operation": os.environ["OPERATION"],
    "manifest_sha256": os.environ["MANIFEST_SHA256"],
    "approved_at": datetime.now(timezone.utc).isoformat(),
    "consumed": False,
}
target = Path(os.environ["APPROVAL_FILE"])
with tempfile.NamedTemporaryFile(mode="w", dir=target.parent, prefix=".approval.", delete=False) as stream:
    json.dump(value, stream, sort_keys=True, separators=(",", ":"))
    stream.write("\n")
    temporary = Path(stream.name)
temporary.chmod(0o600)
temporary.replace(target)
PY
    printf 'local_controller=approved operation=%s commit=%s manifest_sha256=%s\n' \
      "$operation" "$commit" "$(manifest_sha256)"
    ;;
  apply)
    [[ -f $manifest && -f $approval ]] || {
      echo "local_controller=failed reason=manifest_or_approval_missing" >&2
      exit 66
    }
    jq -e --arg commit "$commit" --arg operation "$operation" --arg sha "$(manifest_sha256)" '
      .version == 1 and .commit == $commit and .operation == $operation and
      .manifest_sha256 == $sha and .consumed == false
    ' "$approval" >/dev/null
    load_credentials apply
    if [[ $operation == controller-bootstrap || $operation == github-state-detach ]]; then export AWS_PROFILE=default; fi
    if [[ $operation == github-state-detach ]]; then
      scripts/detach-github-state apply --plan-dir "$plan_dir"
    else
      prepare_provider_tls
      scripts/reconcile-infrastructure apply --plan-dir "$plan_dir" "${operation_args[@]}"
    fi
    rm -f -- "$approval"
    printf 'local_controller=applied operation=%s commit=%s\n' "$operation" "$commit"
    ;;
esac
