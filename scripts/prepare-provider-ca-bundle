#!/usr/bin/env bash
set -euo pipefail
umask 077

: "${PROXMOX_CA_PEM:?PROXMOX_CA_PEM is required}"
: "${HOME_LAB_PROVIDER_CA_DIR:?HOME_LAB_PROVIDER_CA_DIR is required}"
[[ $HOME_LAB_PROVIDER_CA_DIR = /* ]]
[[ ! -e $HOME_LAB_PROVIDER_CA_DIR && ! -L $HOME_LAB_PROVIDER_CA_DIR ]]
command -v openssl >/dev/null || { echo "missing command: openssl" >&2; exit 69; }
install -d -m 0700 "$HOME_LAB_PROVIDER_CA_DIR"
proxmox_ca=$HOME_LAB_PROVIDER_CA_DIR/proxmox.pem
bundle=$HOME_LAB_PROVIDER_CA_DIR/bundle.pem
printf '%s' "$PROXMOX_CA_PEM" >"$proxmox_ca"
openssl verify -CAfile "$proxmox_ca" "$proxmox_ca" >/dev/null

: >"$bundle"
if [[ -n ${NIX_SSL_CERT_FILE:-} && -r $NIX_SSL_CERT_FILE ]]; then
  cat "$NIX_SSL_CERT_FILE" >>"$bundle"
  printf '\n' >>"$bundle"
elif [[ -f /etc/ssl/certs/ca-certificates.crt ]]; then
  cat /etc/ssl/certs/ca-certificates.crt >>"$bundle"
  printf '\n' >>"$bundle"
elif [[ $(uname -s) == Darwin ]]; then
  command -v security >/dev/null || { echo "missing command: security" >&2; exit 69; }
  for keychain in \
    /System/Library/Keychains/SystemRootCertificates.keychain \
    /Library/Keychains/System.keychain \
    "$HOME/Library/Keychains/login.keychain-db"; do
    [[ -r $keychain ]] || continue
    security find-certificate -a -p "$keychain" >>"$bundle"
  done
  printf '\n' >>"$bundle"
fi
cat "$proxmox_ca" >>"$bundle"
printf '\n' >>"$bundle"
openssl verify -CAfile "$bundle" "$proxmox_ca" >/dev/null
chmod 0600 "$HOME_LAB_PROVIDER_CA_DIR"/*.pem
printf 'provider_ca_bundle=prepared directory=%s\n' "$HOME_LAB_PROVIDER_CA_DIR"
