#!/usr/bin/env bash
set -euo pipefail
umask 077

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
config_dir=${HOME_LAB_CONTROLLER_CONFIG_DIR:-$HOME/.config/home-lab/controller}
[[ -d $config_dir && ! -L $config_dir ]]
[[ $(stat -f '%Lp' "$config_dir" 2>/dev/null || stat -c '%a' "$config_dir") == 700 ]]
for capability in plan apply; do
  target="$config_dir/$capability-credentials.json"
  [[ -f $target && ! -L $target ]]
  [[ $(stat -f '%Lp' "$target" 2>/dev/null || stat -c '%a' "$target") == 600 ]]
done

omada_url=$(awk '$1 == "endpoint:" {print $2; exit}' "$repo_root/infrastructure/contract/home-lab.yml")
[[ $omada_url == https://* ]]
omada_ca_file="$repo_root/.local/omada/controller-ca.pem"
[[ -f $omada_ca_file && ! -L $omada_ca_file ]]
hardware_file="$repo_root/.local/live-inventory/hardware.env"
[[ -f $hardware_file && ! -L $hardware_file ]]
[[ $(stat -f '%Lp' "$hardware_file" 2>/dev/null || stat -c '%a' "$hardware_file") == 600 ]]
set -a
# shellcheck disable=SC1090
source "$hardware_file"
set +a

read -r -p 'Tailscale plan OAuth client ID: ' tailscale_plan_id </dev/tty
read -r -s -p 'Tailscale plan OAuth client secret: ' tailscale_plan_secret </dev/tty
printf '\n' >/dev/tty
read -r -p 'Tailscale apply OAuth client ID: ' tailscale_apply_id </dev/tty
read -r -s -p 'Tailscale apply OAuth client secret: ' tailscale_apply_secret </dev/tty
printf '\n' >/dev/tty
read -r -p 'Omada plan viewer username: ' omada_plan_username </dev/tty
read -r -s -p 'Omada plan viewer password: ' omada_plan_password </dev/tty
printf '\n' >/dev/tty
read -r -p 'Omada apply administrator username: ' omada_apply_username </dev/tty
read -r -s -p 'Omada apply administrator password: ' omada_apply_password </dev/tty
printf '\n' >/dev/tty

for value in "$tailscale_plan_id" "$tailscale_plan_secret" "$tailscale_apply_id" "$tailscale_apply_secret" \
  "$omada_plan_username" "$omada_plan_password" "$omada_apply_username" "$omada_apply_password"; do
  [[ -n $value && $value != *$'\n'* ]]
done
[[ $tailscale_plan_id != "$tailscale_apply_id" && $tailscale_plan_secret != "$tailscale_apply_secret" ]]
[[ $omada_plan_username != "$omada_apply_username" && $omada_plan_password != "$omada_apply_password" ]]

CONTROLLER_CONFIG="$config_dir" OMADA_URL_VALUE="$omada_url" OMADA_CA_FILE="$omada_ca_file" \
TAILSCALE_PLAN_ID="$tailscale_plan_id" TAILSCALE_PLAN_SECRET="$tailscale_plan_secret" \
TAILSCALE_APPLY_ID="$tailscale_apply_id" TAILSCALE_APPLY_SECRET="$tailscale_apply_secret" \
OMADA_PLAN_USERNAME="$omada_plan_username" OMADA_PLAN_PASSWORD="$omada_plan_password" \
OMADA_APPLY_USERNAME="$omada_apply_username" OMADA_APPLY_PASSWORD="$omada_apply_password" \
python3 - <<'PY'
import json
import os
from pathlib import Path

config = Path(os.environ["CONTROLLER_CONFIG"])
omada_ca = Path(os.environ["OMADA_CA_FILE"]).read_text()
if "-----BEGIN CERTIFICATE-----" not in omada_ca or "-----END CERTIFICATE-----" not in omada_ca:
    raise SystemExit("Omada controller CA is invalid")
hardware = {key: value for key, value in os.environ.items() if key.startswith("HOMELAB_")}
if len(hardware) < 18:
    raise SystemExit("protected hardware identity set is incomplete")
hardware["TF_VAR_games_disk_by_id"] = hardware["HOMELAB_GAMES_DISK_BY_ID"]
hardware["TF_VAR_serial_usb_paths"] = json.dumps({
    "zigbee": hardware["HOMELAB_ZIGBEE_USB_PORT"],
    "zwave": hardware["HOMELAB_ZWAVE_USB_PORT"],
}, separators=(",", ":"), sort_keys=True)
values = {
    "plan": {
        "TAILSCALE_OAUTH_CLIENT_ID": os.environ["TAILSCALE_PLAN_ID"],
        "TAILSCALE_OAUTH_CLIENT_SECRET": os.environ["TAILSCALE_PLAN_SECRET"],
        "TAILSCALE_TAILNET": "-",
        "TF_VAR_tailscale_enable_management": "true",
        "OMADA_URL": os.environ["OMADA_URL_VALUE"],
        "OMADA_CA_PEM": omada_ca,
        "OMADA_USERNAME": os.environ["OMADA_PLAN_USERNAME"],
        "OMADA_PASSWORD": os.environ["OMADA_PLAN_PASSWORD"],
        "TF_VAR_omada_enable_management": "true",
    },
    "apply": {
        "TAILSCALE_OAUTH_CLIENT_ID": os.environ["TAILSCALE_APPLY_ID"],
        "TAILSCALE_OAUTH_CLIENT_SECRET": os.environ["TAILSCALE_APPLY_SECRET"],
        "TAILSCALE_TAILNET": "-",
        "TF_VAR_tailscale_enable_management": "true",
        "OMADA_URL": os.environ["OMADA_URL_VALUE"],
        "OMADA_CA_PEM": omada_ca,
        "OMADA_USERNAME": os.environ["OMADA_APPLY_USERNAME"],
        "OMADA_PASSWORD": os.environ["OMADA_APPLY_PASSWORD"],
        "TF_VAR_omada_enable_management": "true",
    },
}
for capability, additions in values.items():
    target = config / f"{capability}-credentials.json"
    current = json.loads(target.read_text())
    if not isinstance(current, dict):
        raise SystemExit("controller credential file must contain an object")
    current.update(additions)
    current.update(hardware)
    target.write_text(json.dumps(current, indent=2, sort_keys=True) + "\n")
    target.chmod(0o600)
PY

unset tailscale_plan_id tailscale_plan_secret tailscale_apply_id tailscale_apply_secret
unset omada_plan_username omada_plan_password omada_apply_username omada_apply_password
printf 'local_provider_credentials=configured\n'
