#!/usr/bin/env bash
set -euo pipefail
umask 077

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
: "${HOME_LAB_PROVIDER_SESSION_DIR:?HOME_LAB_PROVIDER_SESSION_DIR must be the current run private temporary directory}"
config_dir=$HOME_LAB_PROVIDER_SESSION_DIR
[[ $config_dir = /* ]] || exit 1
[[ -d $config_dir && ! -L $config_dir ]] || exit 1
[[ $(stat -c '%u' "$config_dir" 2>/dev/null || stat -f '%u' "$config_dir") == "$(id -u)" ]] || exit 1
[[ $(stat -c '%a' "$config_dir" 2>/dev/null || stat -f '%Lp' "$config_dir") == 700 ]] || exit 1
python3 - "$config_dir" <<'PY'
import os
from pathlib import Path
import sys
import time

metadata = Path(sys.argv[1]).stat()
if not 0 <= time.time() - metadata.st_mtime <= 3600:
    raise SystemExit("provider session directory is not current")
PY
omada_input="$repo_root/infrastructure/tofu/omada/domain.auto.tfvars.json"
omada_url=$(python3 - "$omada_input" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    value = json.load(stream)
endpoint = value.get("omada_domain", {}).get("endpoint")
if not isinstance(endpoint, str) or not endpoint.startswith("https://"):
    raise SystemExit("Omada domain input lacks an HTTPS endpoint")
print(endpoint)
PY
)
CONTROLLER_CONFIG="$config_dir" OMADA_URL_VALUE="$omada_url" python3 - <<'PY'
import json
import os
from pathlib import Path

config = Path(os.environ["CONTROLLER_CONFIG"])
credential_names = (
    "AUTHENTIK_PLAN_TOKEN", "AUTHENTIK_APPLY_TOKEN",
    "TAILSCALE_PLAN_ID", "TAILSCALE_PLAN_SECRET", "TAILSCALE_APPLY_ID", "TAILSCALE_APPLY_SECRET",
    "OMADA_PLAN_USERNAME", "OMADA_PLAN_PASSWORD", "OMADA_APPLY_USERNAME", "OMADA_APPLY_PASSWORD",
)
for name in credential_names:
    value = os.environ.get(name, "")
    if not value or "\n" in value or "\r" in value:
        raise SystemExit(f"missing or invalid provider environment variable: {name}")
for plan, apply in (
    ("AUTHENTIK_PLAN_TOKEN", "AUTHENTIK_APPLY_TOKEN"),
    ("TAILSCALE_PLAN_ID", "TAILSCALE_APPLY_ID"),
    ("TAILSCALE_PLAN_SECRET", "TAILSCALE_APPLY_SECRET"),
    ("OMADA_PLAN_USERNAME", "OMADA_APPLY_USERNAME"),
    ("OMADA_PLAN_PASSWORD", "OMADA_APPLY_PASSWORD"),
):
    if os.environ[plan] == os.environ[apply]:
        raise SystemExit(f"provider plan and apply identities must be distinct: {plan}, {apply}")
values = {
    "plan": {
        "AUTHENTIK_URL": "https://auth.diloreto.com",
        "AUTHENTIK_TOKEN": os.environ["AUTHENTIK_PLAN_TOKEN"],
        "TF_VAR_authentik_enable_management": "true",
        "TAILSCALE_OAUTH_CLIENT_ID": os.environ["TAILSCALE_PLAN_ID"],
        "TAILSCALE_OAUTH_CLIENT_SECRET": os.environ["TAILSCALE_PLAN_SECRET"],
        "TAILSCALE_TAILNET": "-",
        "TF_VAR_tailscale_enable_management": "true",
        "OMADA_URL": os.environ["OMADA_URL_VALUE"],
        "OMADA_USERNAME": os.environ["OMADA_PLAN_USERNAME"],
        "OMADA_PASSWORD": os.environ["OMADA_PLAN_PASSWORD"],
        "TF_VAR_omada_enable_management": "true",
    },
    "apply": {
        "AUTHENTIK_URL": "https://auth.diloreto.com",
        "AUTHENTIK_TOKEN": os.environ["AUTHENTIK_APPLY_TOKEN"],
        "TF_VAR_authentik_enable_management": "true",
        "TAILSCALE_OAUTH_CLIENT_ID": os.environ["TAILSCALE_APPLY_ID"],
        "TAILSCALE_OAUTH_CLIENT_SECRET": os.environ["TAILSCALE_APPLY_SECRET"],
        "TAILSCALE_TAILNET": "-",
        "TF_VAR_tailscale_enable_management": "true",
        "OMADA_URL": os.environ["OMADA_URL_VALUE"],
        "OMADA_USERNAME": os.environ["OMADA_APPLY_USERNAME"],
        "OMADA_PASSWORD": os.environ["OMADA_APPLY_PASSWORD"],
        "TF_VAR_omada_enable_management": "true",
    },
}
targets = [config / f"{capability}-credentials.json" for capability in values]
if any(target.exists() or target.is_symlink() for target in targets):
    raise SystemExit("provider session target already exists")
for capability, additions in values.items():
    target = config / f"{capability}-credentials.json"
    with target.open("x") as stream:
        json.dump(additions, stream, indent=2, sort_keys=True)
        stream.write("\n")
    target.chmod(0o600)
PY

printf 'local_provider_credentials=session_configured\n'
